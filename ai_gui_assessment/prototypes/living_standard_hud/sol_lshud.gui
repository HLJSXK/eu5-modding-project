widget = {
	name = "sol_lshud_root"
	size = { 100% 100% }
	layer = topbar
	alwaystransparent = yes
	visible = "[And(IsPlayerValid, Not(And(IsLateralViewBlockingMapRendering, IsLateralViewFullScreen)))]"

	widget = {
		name = "sol_lshud_badge"
		size = { 132 100 }
		position = { 636 34 }
		alwaystransparent = yes
		allow_outside = yes

		widget = {
			name = "sol_lshud_plate"
			size = { 132 30 }
			position = { 0 60 }
			alwaystransparent = no
			tooltipwidget = { using = SOL_LSHUD_tooltip }
			background = { using = color_intense_bg_blue_texture alpha = 0.92 margin = { -3 -3 } }
			background = { texture = "gfx/interface/graphical_cultures/european_gfx/pause_label_frame.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 26 0 } }
			hbox = { size = { 132 30 } margin = { 16 0 } spacing = 4 visible = "[Player.MakeScope.GetVariable('sol_ls_pci').IsSet]"
				expand = {}
				text_single = { fontsize = 17 using = Font_Type_Headers align = left|nobaseline default_format = "#high" raw_text = "[Player.MakeScope.GetVariable('sol_ls_pci').GetValue|2]" }
				text_single = { fontsize = 14 align = left|nobaseline text = "[SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_pci_yoy_class').GetValue, '(CFixedPoint)1.5'), 'SOL_LSHUD_TREND_ICON_BIG_UP', SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_pci_yoy_class').GetValue, '(CFixedPoint)0'), 'SOL_LSHUD_TREND_ICON_UP', SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_pci_yoy_class').GetValue, '(CFixedPoint)-1.5'), 'SOL_LSHUD_TREND_ICON_DOWN', 'SOL_LSHUD_TREND_ICON_BIG_DOWN')))]" }
				text_single = { fontsize = 12 align = left|nobaseline raw_text = "[Player.MakeScope.GetVariable('sol_ls_pci_yoy').GetValue|+=1%]" }
				expand = {}
			}
			hbox = { size = { 132 30 } visible = "[Not(Player.MakeScope.GetVariable('sol_ls_pci').IsSet)]"
				expand = {}
				text_single = { fontsize = 14 align = left|nobaseline default_format = "#weak" text = "SOL_LSHUD_PENDING_SHORT" }
				expand = {}
			}
		}

		widget = {
			name = "sol_lshud_medallion"
			size = { 66 66 }
			parentanchor = top|hcenter
			alwaystransparent = no
			tooltipwidget = { using = SOL_LSHUD_tooltip }
			widget = {
	size = { 66 66 }
	background = { texture = "gfx/interface/component_tiles/hud_corners/circle_background.dds" texture_density = 2 modify_texture = { using = color_intense_bg_blue_texture } }
	widget = {
		size = { 46 46 }
		parentanchor = center
		widget = { size = { 100% 100% } visible = "[Player.MakeScope.GetVariable('sol_ls_pci').IsSet]"
			icon = { size = { 100% 100% } texture = "gfx/interface/sol_proto/tier_need.dds" texture_density = 2 visible = "[LessThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)0.5')]" alwaystransparent = yes }
			icon = { size = { 100% 100% } texture = "gfx/interface/sol_proto/tier_daily.dds" texture_density = 2 visible = "[And(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)0.5'), LessThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)1.5'))]" alwaystransparent = yes }
			icon = { size = { 100% 100% } texture = "gfx/interface/sol_proto/tier_lux.dds" texture_density = 2 visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)1.5')]" alwaystransparent = yes }
