				widget = { size = { 22 22 } parentanchor = center
					widget = { size = { 100% 100% } visible = "[And(Player.MakeScope.GetVariable('sol_ls_pci').IsSet, Player.MakeScope.GetVariable('sol_ls_tier').IsSet)]"
					icon = { size = { 100% 100% } texture = "gfx/interface/sol_proto/tier_need.dds" texture_density = 2 visible = "[LessThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)0.5')]" alwaystransparent = yes }
					icon = { size = { 100% 100% } texture = "gfx/interface/sol_proto/tier_daily.dds" texture_density = 2 visible = "[And(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)0.5'), LessThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)1.5'))]" alwaystransparent = yes }
					icon = { size = { 100% 100% } texture = "gfx/interface/sol_proto/tier_lux.dds" texture_density = 2 visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_tier').GetValue, '(CFixedPoint)1.5')]" alwaystransparent = yes }
