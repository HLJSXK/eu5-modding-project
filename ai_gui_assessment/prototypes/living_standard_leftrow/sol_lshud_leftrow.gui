			text_single = { size = { 18 22 } autoresize = no fontsize = 14 align = center|nobaseline text = "[SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_pci_yoy_class').GetValue, '(CFixedPoint)1.5'), 'SOL_LSHUD_TREND_ICON_BIG_UP', SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_pci_yoy_class').GetValue, '(CFixedPoint)0'), 'SOL_LSHUD_TREND_ICON_UP', SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('sol_ls_pci_yoy_class').GetValue, '(CFixedPoint)-1.5'), 'SOL_LSHUD_TREND_ICON_DOWN', 'SOL_LSHUD_TREND_ICON_BIG_DOWN')))]" }
			text_single = { size = { 56 22 } autoresize = no fontsize = 15 align = left|nobaseline raw_text = "[Player.MakeScope.GetVariable('sol_ls_pci_yoy').GetValue|+=1%]" }
			widget = { size = { 1 22 } background = { using = color_gold_texture alpha = 0.35 } }
			text_single = { size = { 120 22 } autoresize = no fontsize = 14 align = left|nobaseline visible = "[And(Player.MakeScope.GetVariable('sol_ls_rank').IsSet, GetGlobalVariable('sol_ls_rank_count').IsSet)]" text = "SOL_LSHUD_ROW_RANK" }
			text_single = { size = { 120 22 } autoresize = no fontsize = 13 align = left|nobaseline default_format = "#weak" visible = "[Not(And(Player.MakeScope.GetVariable('sol_ls_rank').IsSet, GetGlobalVariable('sol_ls_rank_count').IsSet))]" text = "SOL_LSHUD_ROW_RANK_PENDING" }
