			text_single = { size = { 30 22 } autoresize = no fontsize = 13 align = left|nobaseline default_format = "#weak" visible = "[Not(And(Player.MakeScope.GetVariable('sol_ls_pci').IsSet, Player.MakeScope.GetVariable('sol_ls_tier').IsSet))]" text = "SOL_LSHUD_ROW_TIER_PENDING" }
			widget = { size = { 1 22 } background = { using = color_gold_texture alpha = 0.35 } }
