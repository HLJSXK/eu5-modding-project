widget = {
	name = "sol_lshud_leftrow_root"
	size = { 100% 100% }
	layer = bottom
	alwaystransparent = yes
	visible = "[And(And(IsPlayerValid, Not(Or(LeftView.IsShown, LeftView.IsSideAttached))), GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('sol_ls_hud_enabled'), '(CFixedPoint)0'))]"

