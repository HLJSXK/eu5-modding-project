template flexible_interaction_target_entry_setup {
	set_parent_size_to_minimum = yes
	minimumsize = { 530 -1 }
	maximumsize = { 530 -1 }
}

template select_interaction_target_map_tooltip {
	container = {
		visible = "[IsSelectInteractionTargetValid]"
		ContextualTooltipType = {
			datacontext = "[GetLastSelectInteractionTargetGlue(Location.Self)]"
			blockoverride "title_text" { text = "[SelectInteractionTargetGlue.GetUIActionTitle]" }
			blockoverride "title_icon_texture" { texture = "[SelectInteractionTargetGlue.GetObject.GetIconTexture]" }
			blockoverride "concept_link" { text = "[SelectInteractionTargetGlue.GetObject.GetGameConceptName|e]" }
			blockoverride "tooltip_content" {
				TooltipContentSection = {
					visible = "[LastSelectInteractionTargetGlueWasTarget(Location.Self)]"
					using = action_tooltip_inner_content_select_interaction_target_map

					TooltipScrolledStringPairList = {
						ontextcontextchanged = "[SetStringPairListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
						visible = "[SelectInteractionTargetGlue.GetParentView.RequiresAcceptance]"
						blockoverride "block_scrollarea" { maximumsize = { -1 200 }}
						textcontext = "[SelectInteractionTargetGlue.GetUIActionAcceptance]"
					}

					TooltipTextBlock = {
						visible = "[SelectInteractionTargetGlue.GetParentView.RequiresAcceptance]"
						blockoverride "text" {
							text = "GOOD_BAD_RATIO_T"
						}
					}

					TooltipTableHeader = {
						visible = "[SelectInteractionTargetGlue.GetParentView.RequiresAcceptance]"
						blockoverride "tableheader_text" {
							raw_text = "[SelectLocalization( SelectInteractionTargetGlue.GetUIActionWillAIAccept, '@trigger_yes!', '@trigger_no!' )]  [SelectLocalization( SelectInteractionTargetGlue.GetUIActionWillAIAccept, 'DIPLOMACY_WILL_ACCEPT', 'DIPLOMACY_WILL_NOT_ACCEPT' )]"
						}
					}
				}
				TooltipContentSection = {
					visible = "[Not(LastSelectInteractionTargetGlueWasTarget(Location.Self))]"
					TooltipTextBlock = {
						blockoverride "text" { text = "INVALID_TARGET" }
					}
				}
			}

		}
	}
}

types SelectInteractionTargetTypes
{
	type interaction_target_table_entry = widget {
		tooltipmeta = {
			texture = "[SelectInteractionTargetGlue.GetObject.GetIconTexture]"
			game_concept = "[SelectInteractionTargetGlue.GetObject.GetGameConceptName|e]"
		}

		card_list_button = {
			ignore_layout = yes
			size = { 100% 100% }
			visible = "[Not(SelectInteractionTargetView.HasSelectTarget)]"
			using = select_interaction_target_action_provider
			using = snd_UI_confirm

			onmousehierarchyenter = "[SelectInteractionTargetGlue.OnMouseEnter(PdxGuiWidget.AccessSelf, SelectInteractionTargetGlue.GetObject)]"
			onmousehierarchyleave = "[SelectInteractionTargetGlue.OnMouseLeave(PdxGuiWidget.AccessSelf)]"
			
			onpressed = "[SelectInteractionTargetGlue.OnMouseDown]"
			onreleased = "[SelectInteractionTargetGlue.OnMouseUp]"
			onrightpressed = "[SelectInteractionTargetGlue.OnMouseDown]"
			onrightreleased = "[SelectInteractionTargetGlue.OnMouseUp]"

			icon = {
				visible = "[And(SelectInteractionTargetGlue.IsHovered, Not(SelectInteractionTargetGlue.IsDown))]"
				size =  { 100% 100% }
				using = color_white_texture
				alpha = 0.1
			}

			icon = {
				visible = "[SelectInteractionTargetGlue.IsDown]"
				size =  { 100% 100% }
				using = color_black_texture
				alpha = 0.2
			}
			icon = {
				visible = "[Or(SelectInteractionTargetGlue.IsAlreadySelected,SelectInteractionTargetGlue.IsCurrentlySelected)]"
				size =  { 100% 100% }
				using = color_black_texture
				alpha = 0.5
			}
		}
	}
}

template select_interaction_target_header {
	window_header_alt = {
		using = bg_main_inner_alt
		blockoverride "window_header_alt_color_texture"{
			using = color_default_brown_texture
		}

		blockoverride "header_text" {
			maximumsize = { 500 -1 }
			autoresize = yes
			text = "[SelectInteractionTargetView.GetTitle]"
		}
	}
}

template select_interaction_target {
	vbox = {
		using = layoutpolicy_expanding
		using = bg_secondary_inner_alt
		using = window_main_tabs_margin_alt
		allow_outside = yes

		subheader_A = {
			visible = "[SelectInteractionTargetView.IsTopVisible]"
			# Left Data
			blockoverride "left_1liner_text_visible" {
				visible = "[Not(SelectInteractionTargetView.IsLeftMultiline)]"
			}
			blockoverride "left_1liner_text" {
				text = "[SelectInteractionTargetView.GetTopLeftTitle]"
			}
			blockoverride "left_2liner_text_1_visible" {
				visible = "[SelectInteractionTargetView.IsLeftMultiline]"
			}
			blockoverride "left_2liner_text_1" {
				text = "[SelectInteractionTargetView.GetTopLeftTitle]"
			}
			blockoverride "left_2liner_text_2_visible" {
				visible = "[SelectInteractionTargetView.IsLeftMultiline]"
			}
			blockoverride "left_2liner_text_2" {
				text = "[SelectInteractionTargetView.GetTopLeftDesc]"
			}
			blockoverride "left_icon_visible" {
				visible = yes
			}
			blockoverride "left_icon_gfx" {
				texture = "[SelectInteractionTargetView.GetTopLeftTexture]"
				texture_density = 2

			}

			# Right Data
			blockoverride "right_icon_visible" {
				visible = yes
			}
			blockoverride "right_icon_gfx" {
				texture = "[SelectInteractionTargetView.GetTopRightTexture]"
				texture_density = 2

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
			blockoverride "right_1liner_text_visible" {
				visible = "[Not(SelectInteractionTargetView.IsRightMultiline)]"
			}
			blockoverride "right_1liner_text" {
				text = "[SelectInteractionTargetView.GetTopRightTitle]"
			}
			blockoverride "right_2liner_text_1_visible" {
				visible = "[SelectInteractionTargetView.IsRightMultiline]"
			}
			blockoverride "right_2liner_text_1" {
				text = "[SelectInteractionTargetView.GetTopRightTitle]"
			}
			blockoverride "right_2liner_text_2_visible" {
				visible = "[SelectInteractionTargetView.IsRightMultiline]"
			}
			blockoverride "right_2liner_text_2" {
				text = "[SelectInteractionTargetView.GetTopRightDesc]"
			}
		}

		# top widget (specifyable in script with top_widget)
		vbox = {
			layoutpolicy_vertical = fixed
			layoutpolicy_horizontal = expanding
			name = "top_widget_container"
		}

		# select a number
		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			visible = "[SelectInteractionTargetView.IsValue]"

			select_value_widget = {
				datacontext = "[SelectInteractionTargetView.GetCurrentValueGlue]"
			}

			expand = {}
		}

		# select from a list
		filtered_sorted_list = {
			using = layoutpolicy_expanding
			allow_outside = yes

			visible = "[Not(SelectInteractionTargetView.IsValue)]"
			datacontext = "[SelectInteractionTargetView.GetTargetObjectSortSearch]"

			blockoverride "searchbar_extra_pre_content" {
				hbox = {
					visible = "[SelectInteractionTargetView.IsCharacter]"
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin = { 5 5 }
					margin_top = 0
					datacontext = "[SelectInteractionTargetView.GetTargetObjectSortSearch.GetSearchBar]"
					datamodel = "[Player.GetGovernment.GetEstates]"
					item = {
						goods_quickfilter_button = {
							visible = "[Not(StringIsEmpty(GetCharacterEstateSearchFilterKey(Estate.GetType)))]"
							layoutpolicy_horizontal = expanding
							blockoverride "goods_quickfilter_button_size" {
								size = { -1 30 }
							}
							blockoverride "goods_quickfilter_button_background" {
								background = {
									using = paper_card_texture
									margin = {-3 -3}

									modify_texture = {
										using = color_paper_texture
									}

									modify_texture = {
										using = overlay_paper_03
									}
								}
								background = {
									using = color_grey_texture
									margin = {-3 -3}

									modify_texture = {
										texture = "[GetGraphicalCultureTexture('header_pattern')]"
										texture_density = 2
										spriteType = corneredtiled
										blend_mode = overlay
										alpha = 0.6
									}

									modify_texture = {
										color = "[Estate.GetType.GetMapColor]"
										alpha = 0.7
										blend_mode = overlay
									}
								}
							}
							blockoverride "goods_quickfilter_button_highlight" {
								visible = "[SearchBar.IsFilterEnabledByKey(GetCharacterEstateSearchFilterKey(Estate.GetType))]"
							}
							blockoverride "goods_quickfilter_button_title" {
								title = "[Estate.GetType.GetName]"
							}
							blockoverride "goods_quickfilter_button_on_action" {
								on_action = "[SearchBar.ToggleFilterByKey(GetCharacterEstateSearchFilterKey(Estate.GetType))]"
							}
							blockoverride "goods_quickfilter_button_tooltip" {
								tooltipwidget = { BasicFunctionalTooltip = {} }
							}
							blockoverride "goods_quickfilter_button_icon" {
								texture = "[GetEstateIcon(Estate.GetType)]"
							}
							blockoverride "goods_quickfilter_button_icon_size" { size = { 28 28 } }
						}
					}
				}

				hbox = {
					visible = "[SelectInteractionTargetView.IsTownRightsType]"
					layoutpolicy_horizontal = expanding
					spacing = 3
					margin = { 10 5 }
					margin_top = 0
					datacontext = "[SelectInteractionTargetView.GetTargetObjectSortSearch.GetSearchBar]"

					goods_quickfilter_button = {
						layoutpolicy_horizontal = expanding

						datacontext = "[SearchBar.FindFilterByKey('specialization')]"
						blockoverride "goods_quickfilter_button_highlight" {
							visible = "[SearchBar.IsFilterEnabledByKey('specialization')]"
						}
						blockoverride "goods_quickfilter_button_icon" {
							texture = "gfx/interface/icons/flat_icons/produced_goods.dds"
						}
						blockoverride "goods_quickfilter_button_label" {
							text = "TOWN_RIGHTS_FILTER_SPECIALIZATION"
						}
						blockoverride "goods_quickfilter_button_on_action" {
							on_action = "[SearchBar.ToggleFilterByKey('specialization')]"
						}
					}

					goods_quickfilter_button = {
						layoutpolicy_horizontal = expanding

						datacontext = "[SearchBar.FindFilterByKey('not_specialization')]"
						blockoverride "goods_quickfilter_button_highlight" {
							visible = "[SearchBar.IsFilterEnabledByKey('not_specialization')]"
						}
						blockoverride "goods_quickfilter_button_icon" {
							texture = "gfx/interface/icons/town_rights/_default.dds"
						}
						blockoverride "goods_quickfilter_button_label" {
							text = "TOWN_RIGHTS_FILTER_NOT_SPECIALIZATION"
						}
						blockoverride "goods_quickfilter_button_on_action" {
							on_action = "[SearchBar.ToggleFilterByKey('not_specialization')]"
						}
					}
				}
			}

			blockoverride "scroll_list_vbox" {
				vbox = {
					using = layoutpolicy_expanding
					allow_outside = yes
					margin = { -10 0 }
					margin_bottom = 5
					scroll_list = {}
				}
			}

			blockoverride "scroll_list_is_empty" {
				visible = "[Not(GreaterThan_int32(GetDataModelSize(SelectInteractionTargetView.GetTargetObjects), '(int32)0'))]"
			}

			blockoverride "scroll_list_is_empty_text" {
				text = "[SelectInteractionTargetView.GetNoneAvailableTextOnlyHeader]"
			}

			blockoverride "subheader_upper_divider" {
				hbox = {
					visible = "[SelectInteractionTargetView.IsCabinetAction]"
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin = { 2 5 }

					# ADM filter toggle
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }
						using = bg_building_card_colors
						blockoverride "building_color" {
							using = color_yellow_texture
							alpha = 0.8
							blend_mode = overlay
						}
						card_header_button_04 = {
							allow_outside = yes
							size = { 100% 100% }

							action_tooltip = {
								click_type = left
								click_mode = single
								on_action = "[SelectInteractionTargetView.ToggleCabinetActionAbilityFilter('adm')]"
								title = "CABINET_ACTION_FILTER_ADM_TITLE"
								description = "CABINET_ACTION_FILTER_ADM_DESC"
							}
							tooltipwidget = { BasicFunctionalTooltip = {} }

							icon = {
								visible = "[SelectInteractionTargetView.IsAbilityFilterActive('adm')]"
								size = { 100% 100% }
								using = color_white_texture
								alpha = 0.15
							}

							hbox = {
								margin = { 3 0 }
								spacing = 4
								parentanchor = vcenter

								widget = {
									size = { 20 20 }
									using = bg_circle_piechart
									icon = {
										size = { 92% 92% }
										parentanchor = center
										texture = "gfx/interface/icons/abilities/adm.dds"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = { 0.0 0.0 0.0 1.0 }
											alpha = 0.3
										}
									}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									using = Font_Type_Headers
									fontsize = 13
									text = "CABINET_ACTION_FILTER_ADM"
								}

								widget = {
									layoutpolicy_horizontal = fixed
									layoutpolicy_vertical = fixed
									size = { 55 26 }
									datacontext = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('cabinet').GetCabinet]"
									visible = "[Cabinet.IsCharacterSet]"
									tooltipwidget = {
										using = effective_skill_tooltip_adm
									}
									text_single = {
										align = right|nobaseline
										widgetanchor = right|vcenter
										parentanchor = right|vcenter
										margin = { 3 2 }
										using = Font_Type_Headers
										fontsize = 12
										text = "[Cabinet.GetEffectiveSkillByAbilityType('adm')|2%+=]"
									}
								}
							}
						}
					}

					# DIP filter toggle
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }
						using = bg_building_card_colors
						blockoverride "building_color" {
							using = color_blue_texture
							alpha = 0.8
							blend_mode = overlay
						}
						card_header_button_04 = {
							allow_outside = yes
							size = { 100% 100% }

							action_tooltip = {
								click_type = left
								click_mode = single
								on_action = "[SelectInteractionTargetView.ToggleCabinetActionAbilityFilter('dip')]"
								title = "CABINET_ACTION_FILTER_DIP_TITLE"
								description = "CABINET_ACTION_FILTER_DIP_DESC"
							}
							tooltipwidget = { BasicFunctionalTooltip = {} }

							icon = {
								visible = "[SelectInteractionTargetView.IsAbilityFilterActive('dip')]"
								size = { 100% 100% }
								using = color_white_texture
								alpha = 0.15
							}

							hbox = {
								margin = { 3 0 }
								spacing = 4
								parentanchor = vcenter

								widget = {
									size = { 20 20 }
									using = bg_circle_piechart
									icon = {
										size = { 92% 92% }
										parentanchor = center
										texture = "gfx/interface/icons/abilities/dip.dds"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = { 0.0 0.0 0.0 1.0 }
											alpha = 0.3
										}
									}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									using = Font_Type_Headers
									fontsize = 13
									text = "CABINET_ACTION_FILTER_DIP"
								}

								widget = {
									layoutpolicy_horizontal = fixed
									layoutpolicy_vertical = fixed
									size = { 55 26 }
									datacontext = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('cabinet').GetCabinet]"
									visible = "[Cabinet.IsCharacterSet]"
									tooltipwidget = {
										using = effective_skill_tooltip_dip
									}
									text_single = {
										align = right|nobaseline
										widgetanchor = right|vcenter
										parentanchor = right|vcenter
										margin = { 3 2 }
										using = Font_Type_Headers
										fontsize = 12
										text = "[Cabinet.GetEffectiveSkillByAbilityType('dip')|2%+=]"
									}
								}
							}
						}
					}

					# MIL filter toggle
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }
						using = bg_building_card_colors
						blockoverride "building_color" {
							using = color_red_texture
							alpha = 0.8
							blend_mode = overlay
						}
						card_header_button_04 = {
							allow_outside = yes
							size = { 100% 100% }

							action_tooltip = {
								click_type = left
								click_mode = single
								on_action = "[SelectInteractionTargetView.ToggleCabinetActionAbilityFilter('mil')]"
								title = "CABINET_ACTION_FILTER_MIL_TITLE"
								description = "CABINET_ACTION_FILTER_MIL_DESC"
							}
							tooltipwidget = { BasicFunctionalTooltip = {} }

							icon = {
								visible = "[SelectInteractionTargetView.IsAbilityFilterActive('mil')]"
								size = { 100% 100% }
								using = color_white_texture
								alpha = 0.15
							}

							hbox = {
								margin = { 3 0 }
								spacing = 4
								parentanchor = vcenter

								widget = {
									size = { 20 20 }
									using = bg_circle_piechart
									icon = {
										size = { 92% 92% }
										parentanchor = center
										texture = "gfx/interface/icons/abilities/mil.dds"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = { 0.0 0.0 0.0 1.0 }
											alpha = 0.3
										}
									}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									using = Font_Type_Headers
									fontsize = 13
									text = "CABINET_ACTION_FILTER_MIL"
								}

								widget = {
									layoutpolicy_horizontal = fixed
									layoutpolicy_vertical = fixed
									size = { 55 26 }
									datacontext = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('cabinet').GetCabinet]"
									visible = "[Cabinet.IsCharacterSet]"
									tooltipwidget = {
										using = effective_skill_tooltip_mil
									}
									text_single = {
										align = right|nobaseline
										widgetanchor = right|vcenter
										parentanchor = right|vcenter
										margin = { 3 2 }
										using = Font_Type_Headers
										fontsize = 12
										text = "[Cabinet.GetEffectiveSkillByAbilityType('mil')|2%+=]"
									}
								}
							}
						}
					}
				}
			}

			blockoverride "sort_buttons_filtered_list" {
				datamodel = "[FilteredSortedList.GetSortKeys]"
				item = {
					sort_by_key_button = {
						blockoverride "sort_by_key_button_datacontext" {}
						size = "[SortKey.GetSize]"
						visible = "[SortKey.IsVisible]"
					}
				}
			}

			blockoverride "scroll_list_layout" {
				table = {
					name = "selection_table"
					size = { 540 100% }
					margin = { 0 5 }
					margin_left = 10
					spacing = 7

					# data model is set from code
					even_row_widget = {
						interaction_target_table_entry = {
							size = { -1 30 }
						}
					}
					odd_row_widget = {
						interaction_target_table_entry = {
							size = { -1 30 }
						}
					}
				}
			}
		}

		# bottom widget (specifyable in script with bottom_widget)
		vbox = {
			layoutpolicy_vertical = fixed
			layoutpolicy_horizontal = expanding
			name = "bottom_widget_container"
		}
	}
}

lateralview = {
	name = "select_interaction_target_left"

	# SOUND - Select Interaction Target (Left Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_selectInteractionTarget_show" }
	blockoverride "panel_header" {
		using = select_interaction_target_header
	}

	blockoverride "panel_content" {
		using = select_interaction_target
	}
}

lateralview = {
	name = "select_interaction_target_right"

	# SOUND - Select Interaction Target (Right Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_selectInteractionTarget_show" }
	blockoverride "panel_header" {
		using = select_interaction_target_header
	}

	blockoverride "panel_content" {
		using = select_interaction_target
	}
}
