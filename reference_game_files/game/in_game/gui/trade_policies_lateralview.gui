template trade_policy_contribution_goods_tooltip {
	ContextualTooltipType = {
		datacontext = "[GoodsTradeContributionItem.GetGoods]"

		blockoverride "title_icon" {
			button = {
				visible = "[GoodsTradeContributionItem.HasGoods]"
				using = tooltip_title_icon_size
				texture = "[GetGoodsIcon(Goods.Self)]"
				action_tooltip = {
					title = "OPEN_GOOD_PANEL"
					on_action = "[ShowGoods(Goods.Self)]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}

		blockoverride "title_text" {
			text = "[GoodsTradeContributionItem.GetName]"
		}

		blockoverride "concept_link" {
			text = [goods|E]
		}

		blockoverride "tooltip_content" {
			vbox = {
				visible = "[And(GoodsTradeContributionItem.HasGoods, Not(GoodsTradeContributionItem.HasMarket))]"
				using = goods_details
				spacing = 8
			}

			vbox = {
				spacing = 8
				visible = "[And(GoodsTradeContributionItem.HasGoods, GoodsTradeContributionItem.HasMarket)]"
				using = layoutpolicy_expanding
				datacontext = "[GoodsTradeContributionItem.GetMarket]"
				using = goods_details

				vbox = {
					visible = "[GoodsTradeContributionItem.HasMarket]"
					datacontext = "[Market.GetMarketEntry(Goods.Self)]"
					using = SpecificGoodsFromMarketContent
				}
			}

			TooltipFlavorTextBlock = {
				visible = "[GoodsTradeContributionItem.HasGoods]"
				textcontext = "[Goods.GetFlavorText]"
			}

			TooltipTextBlock = {
				visible = "[Not(GoodsTradeContributionItem.HasGoods)]"
				blockoverride "text" {
					text = "[GoodsTradeContributionItem.GetVolumeText]"
				}
			}

			TooltipListScrollArea = {
				visible = "[And(Not(GoodsTradeContributionItem.HasGoods), DataModelHasItems(GoodsTradeContributionItem.GetOtherBreakdown))]"
				margin_top = 6

				blockoverride "block_scrollarea" {
					maximumsize = { -1 312 }
				}

				blockoverride "scrollarea_content" {
					vbox = {
						layoutpolicy_horizontal = expanding

						datamodel = "[GoodsTradeContributionItem.GetOtherBreakdown]"
						item = {
							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 5 2 }
								spacing = 10
								datacontext = "[GoodsTradeContributionItem.GetGoods]"

								background = {
									visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
									using = tooltip_table_field_texture
								}

								icon = {
									size = { 22 22 }
									texture = "[GetGoodsIcon(Goods.Self)]"
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									size = { -1 24 }
									align = left|nobaseline
									fontsize = 16
									text = "[GoodsTradeContributionItem.GetName]"
								}
								text_single = {
									align = right|nobaseline
									autoresize = yes
									fontsize = 16
									text = "[GoodsTradeContributionItem.GetVolumeText]"
								}
							}
						}
					}
				}
			}
		}
	}
}

types TradePoliciesTypes
{
	type trade_policy_goods_row = widget {
		size = { 100% 90 }
		layoutpolicy_horizontal = expanding

		using = bg_loans_card_texture
		
		using = bg_loans_card_frame

		vbox = {
			margin = { 12 6 }
			spacing = 2
			layoutpolicy_horizontal = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				datacontext = "[GoodsTradePolicyItem.GetGoods]"

				using = bg_loans_item
				blockoverride "bg_loans_item_extra" {
					margin = {5 5}
				}

				button = {
					visible = "[Not(TradePoliciesLateralView.IsMarketFilterActive)]"
					tooltipwidget = { using = Goods_tooltip }
					size = { 24 24 }
					texture = "[GetGoodsIcon(GoodsTradePolicyItem.GetGoods)]"
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "OPEN_GOOD_PANEL"
						on_action = "[ShowGoods(GoodsTradePolicyItem.GetGoods)]"
					}
					action_tooltip = {
						click_type = right
						click_mode = single
						title = "GOODS_MARKET_CTXMENU_OPEN"
						on_action = "[PdxGuiWidget.ToggleContextMenu]"
					}

					contextmenu_widget = {
						GoodsContextMenu = {}
					}
				}

				button = {
					visible = "[TradePoliciesLateralView.IsMarketFilterActive]"
					datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
					tooltipwidget = { using = SpecificGoodsMarket_tooltip }
					size = { 24 24 }
					texture = "[GetGoodsIcon(GoodsTradePolicyItem.GetGoods)]"
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "OPEN_GOOD_PANEL"
						on_action = "[ShowGoods(GoodsTradePolicyItem.GetGoods)]"
					}
					action_tooltip = {
						click_type = right
						click_mode = single
						title = "GOODS_MARKET_CTXMENU_OPEN"
						on_action = "[PdxGuiWidget.ToggleContextMenu]"
					}

					contextmenu_widget = {
						GoodsMarketContextMenu = {}
					}
				}

				widget = {
					visible = "[Not(TradePoliciesLateralView.IsMarketFilterActive)]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					sort_by_small_highlight = {
						name = "name"
					}
					text_single = {
						size = { 100% 100% }
						autoresize = no
						align = left|nobaseline
						fontsize = 18
						text = "[GoodsTradePolicyItem.GetGoods.GetName]"
					}
				}
				widget = {
					visible = "[TradePoliciesLateralView.IsMarketFilterActive]"
					using = layoutpolicy_expanding
					sort_by_small_highlight = {
						name = "name"
					}
					text_single = {
						size = { 100% 20 }
						autoresize = no
						align = left|nobaseline
						fontsize = 16
						datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
						datacontext = "[GoodsTradePolicyItem.GetGoods]"
						text = "TRADE_POLICIES_GOOD_IN_MARKET"
						tooltipwidget = { using = SpecificGoodsMarket_tooltip }
						default_format = "#L"
					}
				}

				widget = {
					visible = "[TradePoliciesLateralView.IsMarketFilterActive]"
					size = { 62 20 }
					widget = {
						size = { 100% 100% }
						datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
						datacontext = "[TradePoliciesLateralView.GetSelectedMarket.GetMarketEntry(Goods.Self)]"
						sort_by_small_highlight = {
							name = "goods_balance"
						}
						tooltipwidget = {
							using = goods_market_balance_tooltip
						}
						hbox = {
							expand = {}
							hbox = {
								spacing = 3
								text_single = {
									maximumsize = { 42 20 }
									align = center|nobaseline
									using = Font_Size_Small
									text = "[Market.GetSurplus(Goods.Self)|+=2]"
								}
								icon = {
									size = { 18 18 }
									texture = "gfx/interface/icons/flat_icons/trade_market/goods_balance.dds"
									glow = {
										name = "drop_shadow"
										glow_radius = 3
										color = {0.0 0.0 0.0 1.0}
										alpha = 0.3
									}
								}
							}
						}
					}
				}

				widget = {
					visible = "[TradePoliciesLateralView.IsMarketFilterActive]"
					size = { 50 20 }
					widget = {
						size = { 100% 100% }
						datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
						datacontext = "[TradePoliciesLateralView.GetSelectedMarket.GetMarketEntry(Goods.Self)]"
						sort_by_small_highlight = {
							name = "market_price"
						}
						tooltipmeta = {
							texture = "[GetGoodsIcon(Goods.Self)]"
						}
						tooltipwidget = {
							using = goods_market_price_tooltip
						}
						hbox = {
							expand = {}
							hbox = {
								spacing = 2
								text_single = {
									maximumsize = { 30 20 }
									align = center|nobaseline
									using = Font_Size_Small
									text = "[GoodsMarketEntry.GetPrice|2]"
								}
								text_single = {
									maximumsize = { 20 20 }
									align = right|nobaseline
									using = Font_Size_Small
									raw_text = "@[Goods.GetPriceDifferenceIconName(GoodsMarketEntry.GetPrice)]!"
								}
							}
						}
					}
				}

				widget = {
					visible = "[Not(TradePoliciesLateralView.IsMarketFilterActive)]"
					size = { 70 -1 }
					layoutpolicy_vertical = expanding
					sort_by_small_highlight = {
						name = "domestic_production"
					}
					text_single = {
						size = { 100% 100% }
						autoresize = no
						align = right|nobaseline
						fontsize = 14
						raw_text = "[GoodsTradePolicyItem.GetDomesticProductionText|L] @good!"
						tooltipwidget = {
							SimpleContextualStringPairTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/trade_market/supply.dds"
									}
								}
								blockoverride "concept_link" {
									text = "[output|e]"
								}
								lowpriotextcontext = "[GoodsTradePolicyItem.GetDomesticProductionTooltip]"
							}
						}
					}
				}
			}

			# Import row
			hbox = {
				using = bg_loans_item
				blockoverride "bg_loans_item_extra" {
					margin = {5 5}
				}
				layoutpolicy_horizontal = expanding
				spacing = 6

				alwaystransparent = no
				onmousehierarchyenter = "[GoodsTradePolicyItem.PushImportTradeLinesOverride(PdxGuiWidget.AccessSelf)]"

				icon = {
					size = { 24 24 }
					texture = "[GetConceptTexture('import')]"
					tagtooltip_enabled = yes
					tooltip = "[import]"
				}

				widget = {
					size = { 60 20 }
					sort_by_small_highlight = {
						name = "trade_volume"
					}
					text_single = {
						size = { 100% 100% }
						autoresize = no
						align = left|nobaseline
						fontsize = 13
						text = "[GoodsTradePolicyItem.GetTradeVolumeText]"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
									}
								}
								blockoverride "title_text" {
									text = "[SelectLocalization(TradePoliciesLateralView.IsMarketFilterActive, 'GOODS_TRADE_POLICY_IMPORT_VOLUME_HEADER_MARKET', 'GOODS_TRADE_POLICY_IMPORT_VOLUME_HEADER')]"
								}
								blockoverride "concept_link" {
									text = "[import|e]"
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										visible = "[Not(DataModelHasItems(GoodsTradePolicyItem.GetImportTrades))]"
										blockoverride "text" {
											text = "GOODS_TRADE_POLICY_VOLUME_NONE"
										}
									}
									TooltipListBase = {
										visible = "[DataModelHasItems(GoodsTradePolicyItem.GetImportTrades)]"
										TooltipScrolledContentSection = {
											blockoverride "block_scrollarea" { maximumsize = { -1 240 } }
											blockoverride "section_content" {
												TooltipListColumnContent = {
													TooltipTableColumn = {
														blockoverride "field_text" {
															align = left|nobaseline
															raw_text = "[Trade.GetName]"
														}
														blockoverride "field_right" { expand = {} }
													}

													TooltipTableColumn = {
														blockoverride "field_left" { expand = {} }
														blockoverride "field_text" {
															raw_text = "[Trade.GetProfitPerMerchantCapacity|+=2]@profit_trade!"
															tooltipwidget = {
																ExistingTradeProfitPerCapacityTooltip = {}
															}
														}
													}

													TooltipTableColumn = {
														blockoverride "field_left" { expand = {} }
														blockoverride "field_text" {
															raw_text = "[Trade.GetDesiredGoodsShipped|V2] @good!"
															tooltipwidget = {
																ContextualTooltipType = {
																	datacontext = "[Trade.GetGoods]"
																	blockoverride "title_icon" {
																		button = {
																			using = tooltip_title_icon_size
																			size = { 48 48 }
																			texture = "[GetGoodsIcon(Goods.Self)]"
																			onclick = "[ShowGoods(Goods.Self)]"
																			tooltipwidget = { using = Goods_tooltip	}
																		}
																	}
																	
																	blockoverride "title_text" {
																		text = "[Goods.GetNameWithNoTooltip]"
																	}
															
																	blockoverride "concept_link" {
																		text = [trade|E]
																	}
																	
																	blockoverride "tooltip_content" {			
																		using = trade_details
																	}
																}
															}
														}
													}

													TooltipTableColumn = {
														blockoverride "field_left" { expand = {} }
														blockoverride "field_text" {
															raw_text = "[Trade.GetActuallyUsedOrAssignedMerchantCapacity|2]@trade_capacity!"
															tooltipwidget = {
																ContextualTooltipType = {
																	datacontext = "[Trade.GetGoods]"
																	blockoverride "title_icon" {
																		button = {
																			using = tooltip_title_icon_size
																			size = { 48 48 }
																			texture = "[GetGoodsIcon(Goods.Self)]"
																			onclick = "[ShowGoods(Goods.Self)]"
																			tooltipwidget = { using = Goods_tooltip	}
																		}
																	}
																	
																	blockoverride "title_text" {
																		text = "[Goods.GetNameWithNoTooltip]"
																	}
															
																	blockoverride "concept_link" {
																		text = [trade|E]
																	}
																	
																	blockoverride "tooltip_content" {			
																		using = trade_details
																	}
																}
															}
														}
													}

													blockoverride "column_datamodel" { datamodel = "[GoodsTradePolicyItem.GetImportTrades]" }
												}
											}
										}
									}
								}
							}
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					sort_by_small_highlight = {
						name = "top_foreign_earner"
					}
					overlappingitembox = {
						size = { 100% 100% }
						datamodel = "[GoodsTradePolicyItem.GetTopImportForeignEarners]"
						spacing = 2
						item = {
							widget = {
								size = { 36 24 }
								datacontext = "[Country]"

								country_flag_small = {
									blockoverride "tooltip" {
										tooltipwidget = {
											SimpleContextualStringPairTooltipType = {
												blockoverride "concept_link" {
													visible = no
												}
												blockoverride "title_icon" {
													icon = {
														using = tooltip_title_icon_size
														texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
													}
												}
												lowpriotextcontext = "[GoodsTradePolicyItem.GetImportForeignEarnersTooltip]"
											}
										}
									}
									blockoverride "contextmenu" {
										contextmenu_enabled = "[Country.IsValid]"
										contextmenu_widget = {
											CountryContextMenu = {
												blockoverride "extra_country_contextmenu_entries" {
													hbox = {
														layoutpolicy_horizontal = expanding
														margin = { 10 5 }
														spacing = 2

														using = bg_paper_card

														blockoverride "card_texture_extra" {
															modify_texture = {
																using = color_black_texture
																blend_mode = multiply
																alpha = 0.3
															}
														}

														icon = {
															size = { 30 30 }
															texture = "[GetConceptTexture('trade')]"
														}

														text_single = {
															layoutpolicy_horizontal = expanding
															size = { -1 30 }
															fontsize_min = 10
															autoresize = no
															text = "TRADE_POLICIES_TRADE_ACTIONS_HEADER"
														}
													}
													ContextMenuEntry = {
														visible = "[And(Not(Country.IsPlayer), Not(Country.GetDiplomacy.GetRelation(GetPlayer.Self).IsEmbargoed))]"
														
														blockoverride "onclick" {
															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "scripted_relation"
																actor = "[Player]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[Country.MakeScope]"
																}
																parameter = {
																	parameter_name = "scripted_relation_type"
																	parameter_value = "[GetScriptedRelationType('embargo_nation')]"
																}
																action_direction = "offer"
															}
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_icon" {
																		icon = {
																			using = tooltip_title_icon_size
																			texture = "[GetConceptTexture('embargo')]"
																		}
																	}
																	blockoverride "title_text" {
																		text = "offer_embargo_nation"
																	}
																	blockoverride "concept_link_obj" {}
																	blockoverride "tooltip_content" {
																		using = action_tooltip_inner_content
																	}
																}
															}
														}
														blockoverride "entry_icon_texture" {
															texture = "[GetConceptTexture('embargo')]"
														}
														blockoverride "entry_text" {
															text = "TRADE_OVERVIEW_BTN_EMBARGO"
														}
													}

													ContextMenuEntry = {
														visible = "[And(Not(Country.IsPlayer), Country.GetDiplomacy.GetRelation(GetPlayer.Self).IsEmbargoed)]"
														
														blockoverride "onclick" {
															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "scripted_relation"
																actor = "[Player]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[Country.MakeScope]"
																}
																parameter = {
																	parameter_name = "scripted_relation_type"
																	parameter_value = "[GetScriptedRelationType('embargo_nation')]"
																}
																action_direction = "cancellation"
															}
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_icon" {
																		icon = {
																			using = tooltip_title_icon_size
																			texture = "[GetConceptTexture('embargo')]"
																		}
																	}
																	blockoverride "title_text" {
																		text = "cancel_embargo_nation"
																	}
																	blockoverride "concept_link_obj" {}
																	blockoverride "tooltip_content" {
																		using = action_tooltip_inner_content
																	}
																}
															}
														}
														blockoverride "entry_icon_texture" {
															texture = "[GetConceptTexture('embargo')]"
														}
														blockoverride "entry_text" {
															text = "cancel_embargo_nation"
														}
													}

													ContextMenuEntry = {
														visible = "[And(Not(Country.IsPlayer), Not(Country.GetDiplomacy.GetRelation(GetPlayer.Self).IsReceivingImportTariffExemption))]"
														
														blockoverride "onclick" {
															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "scripted_relation"
																actor = "[Player]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[Country.MakeScope]"
																}
																parameter = {
																	parameter_name = "scripted_relation_type"
																	parameter_value = "[GetScriptedRelationType('tariff_exemption')]"
																}
																action_direction = "offer"
															}
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_icon" {
																		icon = {
																			using = tooltip_title_icon_size
																			texture = "[GetConceptTexture('tariff_exemption')]"
																		}
																	}
																	blockoverride "title_text" {
																		text = "offer_tariff_exemption"
																	}
																	blockoverride "concept_link_obj" {}
																	blockoverride "tooltip_content" {
																		using = action_tooltip_inner_content
																	}
																}
															}
														}
														blockoverride "entry_icon_texture" {
															texture = "[GetConceptTexture('tariff_exemption')]"
														}
														blockoverride "entry_text" {
															text = "TRADE_OVERVIEW_BTN_LIFT_TARIFFS"
														}
													}

													ContextMenuEntry = {
														visible = "[And(Not(Country.IsPlayer), Country.GetDiplomacy.GetRelation(GetPlayer.Self).IsReceivingImportTariffExemption)]"
														
														blockoverride "onclick" {
															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "scripted_relation"
																actor = "[Player]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[Country.MakeScope]"
																}
																parameter = {
																	parameter_name = "scripted_relation_type"
																	parameter_value = "[GetScriptedRelationType('tariff_exemption')]"
																}
																action_direction = "cancellation"
															}
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_icon" {
																		icon = {
																			using = tooltip_title_icon_size
																			texture = "[GetConceptTexture('tariff_exemption')]"
																		}
																	}
																	blockoverride "title_text" {
																		text = "cancel_tariff_exemption"
																	}
																	blockoverride "concept_link_obj" {}
																	blockoverride "tooltip_content" {
																		using = action_tooltip_inner_content
																	}
																}
															}
														}
														blockoverride "entry_icon_texture" {
															texture = "[GetConceptTexture('tariff_exemption')]"
														}
														blockoverride "entry_text" {
															text = "cancel_tariff_exemption"
														}
													}
												}
											}
										}
									}
								}
								icon = {
									visible = "[TradePoliciesLateralView.IsCountryTariffExempt(Country.Self)]"
									parentanchor = bottom|left
									size = { 14 14 }
									position = { -1 1 }
									texture = "gfx/interface/icons/flat_icons/special_conditions.dds"
									tooltipwidget = {
										SimpleContextualStringPairTooltipType = {
											blockoverride "title_icon" {
												icon = {
													using = tooltip_title_icon_size
													texture = "[GetConceptTexture('tariff_exemption')]"
												}
											}
											blockoverride "concept_link" {
												text = "[tariff_exemption|e]"
											}
											lowpriotextcontext = "[TradePoliciesLateralView.GetCountryTariffExemptTooltip(Country.Self)]"
										}
