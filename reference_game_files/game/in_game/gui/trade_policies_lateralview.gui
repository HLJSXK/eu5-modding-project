							layoutpolicy_vertical = expanding
							size = { 40 -1 }
							blockoverride "sort_by_key_button_texture"{
								texture = "gfx/interface/icons/sort/profit_import.dds"
							}
						}
						sort_by_key_button = {
							name = "export_monthly_gold"
							layoutpolicy_vertical = expanding
							size = { 40 -1 }
							blockoverride "sort_by_key_button_texture"{
								texture = "gfx/interface/icons/sort/profit_export.dds"
							}
						}
						sort_by_key_button = {
							name = "total_monthly_gold"
							layoutpolicy_vertical = expanding
							size = { 40 -1 }
							blockoverride "sort_by_key_button_texture"{
								texture = "gfx/interface/icons/sort/income.dds"
							}
						}
					}
	
					blockoverride "scroll_list_layout" {
						vbox = {
							spacing = 2
							vbox = {
								layoutpolicy_horizontal = expanding
								margin = { -6 0 }
								fixedgridbox = {
									addcolumn = 100%
									addrow = 120
									setitemsizefromcell = yes
									datamodel_reuse_widgets = yes
									datamodel = "[TradePoliciesLateralView.GetPolicyRows]"
			
									item = {
										trade_policy_goods_row = {}
									}
								}
							}

							vbox = {
								visible = "[TradePoliciesLateralView.IsGoodFilterActive]"
								datacontext = "[TradePoliciesLateralView.GetFilterGoods]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								layoutstretchfactor_vertical = 2
								spacing = 4
								margin_top = 1
			
								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 32 }
			
									using = bg_card_header_01_economy
			
									hbox = {
										margin = { 8 0 }
										spacing = 6
			
										icon = { 
											size = { 24 24 }
											texture = "[GetConceptTexture('trade')]"
											tagtooltip_enabled = yes
											tooltip = "[trade]"
										}
			
										text_single = {
											datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
											layoutpolicy_horizontal = expanding
											size = { -1 26 }
											autoresize = no
											align = left|nobaseline
											fontsize = 14
											text = "TRADE_POLICIES_GOOD_TRADES_HEADER"
										}
			
										button = {
											using = market_filter_button
											blockoverride "functional_tooltip" {
												tooltipwidget = { BasicFunctionalTooltip = {} }
												action_tooltip = {
													click_type = left
													click_mode = single
													title = "TRADE_POLICIES_CLEAR_GOOD_FILTER"
													on_action = "[TradePoliciesLateralView.ClearGoodFilter]"
												}
											}
										}
									}
								}
			
								widget = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
			
									using = bg_paper_card
									using = bg_cabinet_card_frame
			
									hbox = {
										margin = { 5 5 }
			
										scroll_list = {
											blockoverride "scroll_list_layout" {
												fixedgridbox = {
													addcolumn = 100%
													addrow = 42
													datamodel_reuse_widgets = yes
													datamodel = "[TradePoliciesLateralView.GetFilteredGoodTrades]"
			
													item = {
														widget = {
															size = { 100% 40 }
															parentanchor = hcenter
			
															ExistingTradeCard = {
																datacontext = "[Trade]"
																datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
			
																blockoverride "trade_ui_actions" {
																	action_tooltip = {
																		click_type = left
																		click_mode = single
																		title = "OPEN_TRADE_DETAILS"
																		on_action = "[ShowTradeDetails(Trade.Self)]"
																	}
																}
															}
														}
													}
												}
											}
			
											blockoverride "scroll_list_is_empty" {
												visible = "[Not(TradePoliciesLateralView.HasFilteredGoodTrades)]"
											}
			
											blockoverride "scroll_list_is_empty_text" {
												text = "[SelectLocalization(TradePoliciesLateralView.HasGoodTradesInScope, 'TRADE_POLICIES_GOOD_TRADES_NEEDS_MARKET', 'TRADE_POLICIES_GOOD_TRADES_EMPTY')]"
											}
										}
									}
								}
							}
							expand = {}
						}
					}
				}

			}
	
			AutomatedSection = {
				datacontext = "[GetAutomatedSystemItem('TradePolicies')]"
				blockoverride "glow_anim_automation_visible" {
					visible = "[AutomatedSystemsItem.IsEnabled]"
				}
			}
		}
	}
}

select_menu_left = {
	blockoverride "menu_setup" {
		name = "trade_policies_select_market"
	}

	blockoverride "close_on_action" { on_action = "[TradePoliciesSelectMarket.OnClose]" }

	blockoverride "select_header_text" {
		text = "SELECT_MARKET_HEADER"
	}

	blockoverride "select_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10

			datamodel = "[TradePoliciesSelectMarket.Parent.GetOwnedMarkets]"
			item = {
				widget = {
					size = { 485 70 }

					hbox = {
						using = bg_market_card
						using = bg_cabinet_card_frame

						market_card = {
							blockoverride "market_card_title_action" {
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TOGGLE_MARKET_SELECTION"
									on_action = "[TradePoliciesSelectMarket.Parent.SetMarketFilter(Market.Self)]"
									on_action = "[TradePoliciesSelectMarket.OnClose]"
								}

								onmousehierarchyenter = "[PdxGuiWidget.SetHighlightMarket(Market.Self)]"
								ondoubleclick = "[PanToLocation(Market.GetCenterLocation)]"
							}
						}
					}
				}
			}
		}
	}
}
