														blockoverride "entry_text" {
															text = "TRADE_OVERVIEW_BTN_LIFT_TARIFFS"
														}
													}

													ContextMenuEntry = {
														visible = "[And(Not(Country.IsPlayer), Country.GetDiplomacy.GetRelation(GetPlayer.Self).IsReceivingImportTariffExemption)]"
														
														blockoverride "onclick" {
															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "scripted_relation"
																actor = "[Player]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[Country.MakeScope]"
																}
																parameter = {
																	parameter_name = "scripted_relation_type"
																	parameter_value = "[GetScriptedRelationType('tariff_exemption')]"
																}
																action_direction = "cancellation"
															}
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_icon" {
																		icon = {
																			using = tooltip_title_icon_size
																			texture = "[GetConceptTexture('tariff_exemption')]"
																		}
																	}
																	blockoverride "title_text" {
																		text = "cancel_tariff_exemption"
																	}
																	blockoverride "concept_link_obj" {}
																	blockoverride "tooltip_content" {
																		using = action_tooltip_inner_content
																	}
																}
															}
														}
														blockoverride "entry_icon_texture" {
															texture = "[GetConceptTexture('tariff_exemption')]"
														}
														blockoverride "entry_text" {
															text = "cancel_tariff_exemption"
														}
													}
												}
											}
										}
									}
								}

								icon = {
									visible = "[TradePoliciesLateralView.IsCountryTariffExempt(Country.Self)]"
									parentanchor = bottom|left
									size = { 14 14 }
									position = { -1 1 }
									texture = "gfx/interface/icons/flat_icons/special_conditions.dds"
									tooltipwidget = {
										SimpleContextualStringPairTooltipType = {
											blockoverride "title_icon" {
												icon = {
													using = tooltip_title_icon_size
													texture = "[GetConceptTexture('tariff_exemption')]"
												}
											}
											blockoverride "concept_link" {
												text = "[tariff_exemption|e]"
											}
											lowpriotextcontext = "[TradePoliciesLateralView.GetCountryTariffExemptTooltip(Country.Self)]"
										}
									}
								}
							}
						}
					}
				}

				widget = {
					size = { 44 20 }
					layoutpolicy_vertical = expanding
					sort_by_small_highlight = {
						name = "export_tariff"
					}
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "[GetConceptTexture('export_tariff')]"
								}
							}
							blockoverride "title_text" {
								text = "game_concept_export_tariffs"
							}
							blockoverride "concept_link" {
								text = "[export_tariff|e]"
							}
							blockoverride "tooltip_content" {
								TooltipTextBlock = {
									blockoverride "text" {
										text = "TRADE_POLICIES_TARIFF_SLIDER_CURRENT_EXPORT_TT"
									}
								}
								TooltipStringPairList = {
									textcontext = "TRADE_POLICIES_TARIFF_MAX_EXPORT_TT"
								}
								TooltipScrolledStringPairList = {
									blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
									visible = "[Not(StringIsEmpty(GoodsTradePolicyItem.GetExportModifierTooltip))]"
									textcontext = "[GoodsTradePolicyItem.GetExportModifierTooltip]"
								}
							}
						}
					}
					text_single = {
						size = { 100% 100% }
						autoresize = no
						align = right|nobaseline
						fontsize = 14
						visible = "[EqualTo_CFixedPoint(ShowGoodsTariff(GoodsTradePolicyItem.GetGoods, '(bool)no'), '(CFixedPoint)0')]"
						default_format = "#medium"
						text = "[ShowGoodsTariff(GoodsTradePolicyItem.GetGoods, '(bool)no')|0%]"
					}
					text_single = {
						size = { 100% 100% }
						autoresize = no
						align = right|nobaseline
						fontsize = 14
						visible = "[Not(EqualTo_CFixedPoint(ShowGoodsTariff(GoodsTradePolicyItem.GetGoods, '(bool)no'), '(CFixedPoint)0'))]"
						text = "[ShowGoodsTariff(GoodsTradePolicyItem.GetGoods, '(bool)no')|0%]"
					}
				}

				widget = {
					size = { 120 20 }

					hbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding
						spacing = 2
						
						button_square_minus = {
							size = { 15 15 }
							using = snd_UI_minus
							blockoverride "economy_slider_dec_button_config" {}
							enabled = "[And(Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets)), GoodsTradePolicyItem.CanLowerExportTariff)]"
							tooltipwidget = { BasicFunctionalTooltip = {} }
							action_tooltip = {
								enabled = "[And(Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets)), GoodsTradePolicyItem.CanLowerExportTariff)]"
								click_type = left
								click_mode = single
								click_modifier = default
								conditions = "[MakeItFailIfLoc(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets), 'TRADE_POLICIES_TARIFF_SLIDER_FILTER_LOCKED_TT')]"
								conditions = "[MakeItFailIfLoc(Not(GoodsTradePolicyItem.CanLowerExportTariff), 'TRADE_POLICIES_TARIFF_AT_MIN_TT')]"
								title = "TARIFF_BTN_LOWER_1"
								on_action = "[AdjustExportTariff(GoodsTradePolicyItem.GetGoods, '(float)-1')]"
							}
							action_tooltip = {
								click_type = left
								click_mode = single
								click_modifier = ctrl
								title = "TARIFF_BTN_LOWER_5"
								on_action = "[AdjustExportTariff(GoodsTradePolicyItem.GetGoods, '(float)-5')]"
							}
							action_tooltip = {
								click_type = left
								click_mode = single
								click_modifier = shift
								title = "TARIFF_BTN_LOWER_MIN"
								on_action = "[SetExportTariffToMin(GoodsTradePolicyItem.GetGoods)]"
							}
							action_tooltip = {
								click_type = right
								click_mode = single
								title = "TARIFF_BTN_RESET"
								on_action = "[ResetExportTariff(GoodsTradePolicyItem.GetGoods)]"
							}
						}

						economy_slider = {
							visible = "[And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets)]"
							layoutpolicy_horizontal = expanding
							size = { -1 10 }
							#set value first or setting the min/max/mincap/maxcap changes the existing value from 0 to something inside the min/max/mincap/maxcap values
							value = "[GoodsTradePolicyItem.GetExportSliderValue]"
							min = "[GoodsTradePolicyItem.GetSliderMin]"
							max = "[GoodsTradePolicyItem.GetSliderMax]"
							mincap = "[GoodsTradePolicyItem.GetSliderMinCap]"
							maxcap = "[GoodsTradePolicyItem.GetSliderMaxCap]"
							enabled = "[Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets))]"
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[GetConceptTexture('export_tariff')]"
										}
									}
									blockoverride "title_text" {
										text = "game_concept_export_tariffs"
									}
									blockoverride "concept_link" {
										text = "[export_tariff|e]"
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												text = "TRADE_POLICIES_TARIFF_SLIDER_CURRENT_EXPORT_TT"
											}
										}
										TooltipStringPairList = {
											textcontext = "TRADE_POLICIES_TARIFF_MAX_EXPORT_TT"
										}
										TooltipScrolledStringPairList = {
											blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
											visible = "[Not(StringIsEmpty(GoodsTradePolicyItem.GetExportModifierTooltip))]"
											textcontext = "[GoodsTradePolicyItem.GetExportModifierTooltip]"
										}
									}
								}
							}
							inc_button = { button = {} }
							dec_button = { button = {} }
							onvaluechanged = "[GoodsTradePolicyItem.OnExportChanged]"
							onchangefinish = "[GoodsTradePolicyItem.PostExport]"
						}

						economy_slider = {
							layoutpolicy_horizontal = expanding
							size = { -1 10 }
							visible = "[Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets))]"
							#set value first or setting the min/max/mincap/maxcap changes the existing value from 0 to something inside the min/max/mincap/maxcap values
							value = "[GoodsTradePolicyItem.GetExportSliderValue]"
							min = "[GoodsTradePolicyItem.GetSliderMin]"
							max = "[GoodsTradePolicyItem.GetSliderMax]"
							mincap = "[GoodsTradePolicyItem.GetSliderMinCap]"
							maxcap = "[GoodsTradePolicyItem.GetSliderMaxCap]"
							enabled = "[Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets))]"
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[GetConceptTexture('export_tariff')]"
										}
									}
									blockoverride "title_text" {
										text = "game_concept_export_tariffs"
									}
									blockoverride "concept_link" {
										text = "[export_tariff|e]"
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												text = "TRADE_POLICIES_TARIFF_SLIDER_CURRENT_EXPORT_TT"
											}
										}
										TooltipStringPairList = {
											textcontext = "TRADE_POLICIES_TARIFF_MAX_EXPORT_TT"
										}
										TooltipScrolledStringPairList = {
											blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
											visible = "[Not(StringIsEmpty(GoodsTradePolicyItem.GetExportModifierTooltip))]"
											textcontext = "[GoodsTradePolicyItem.GetExportModifierTooltip]"
										}
									}
								}
							}
							inc_button = { button = {} }
							dec_button = { button = {} }
							onvaluechanged = "[GoodsTradePolicyItem.OnExportChanged]"
							onchangefinish = "[GoodsTradePolicyItem.PostExport]"
						}

						button_square_plus = {
							size = { 15 15 }
							using = snd_UI_plus
							blockoverride "economy_slider_inc_button_config" {}
							enabled = "[And(Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets)), GoodsTradePolicyItem.CanRaiseExportTariff)]"
							tooltipwidget = { BasicFunctionalTooltip = {} }
							action_tooltip = {
								enabled = "[And(Not(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets)), GoodsTradePolicyItem.CanRaiseExportTariff)]"
								click_type = left
								click_mode = single
								click_modifier = default
								conditions = "[MakeItFailIfLoc(And(TradePoliciesLateralView.IsMarketFilterActive, TradePoliciesLateralView.OwnsMultipleMarkets), 'TRADE_POLICIES_TARIFF_SLIDER_FILTER_LOCKED_TT')]"
								conditions = "[MakeItFailIfLoc(Not(GoodsTradePolicyItem.CanRaiseExportTariff), 'TRADE_POLICIES_TARIFF_AT_MAX_TT')]"
								title = "TARIFF_BTN_RAISE_1"
								on_action = "[AdjustExportTariff(GoodsTradePolicyItem.GetGoods, '(float)1')]"
							}
							action_tooltip = {
								click_type = left
								click_mode = single
								click_modifier = ctrl
								title = "TARIFF_BTN_RAISE_5"
								on_action = "[AdjustExportTariff(GoodsTradePolicyItem.GetGoods, '(float)5')]"
							}
							action_tooltip = {
								click_type = left
								click_mode = single
								click_modifier = shift
								title = "TARIFF_BTN_RAISE_MAX"
								on_action = "[SetExportTariffToMax(GoodsTradePolicyItem.GetGoods)]"
							}
							action_tooltip = {
								click_type = right
								click_mode = single
								title = "TARIFF_BTN_RESET"
								on_action = "[ResetExportTariff(GoodsTradePolicyItem.GetGoods)]"
							}
						}
					}
				}

				widget = {
					datacontext = "[GoodsTradePolicyItem.GetGoods]"
					size = { 80 20 }
					sort_by_small_highlight = {
						name = "export_monthly_gold"
					}
					sort_by_small_highlight = {
						name = "total_monthly_gold"
					}
					icon = {
						visible = "[GreaterThan_CFixedPoint(ShowGoodsTariff(Goods.Self, '(bool)no'), '(CFixedPoint)0')]"
						size = { 16 16 }
						texture = "gfx/interface/icons/flat_icons/trade_market/tariff_small.dds"
						parentanchor = vcenter|left
						tooltip = "[tariff]"
						tagtooltip_enabled = yes
					}
					icon = {
						visible = "[LessThan_CFixedPoint(ShowGoodsTariff(Goods.Self, '(bool)no'), '(CFixedPoint)0')]"
						size = { 16 16 }
						texture = "gfx/interface/icons/flat_icons/trade_market/subvention_small.dds"
						parentanchor = vcenter|left
						tooltip = "[subvention]"
						tagtooltip_enabled = yes
					}
					text_single = {
						parentanchor = vcenter|right
						size = { 80% 100% }
						autoresize = no
						align = right|nobaseline
						fontsize = 14
						text = "[GoodsTradePolicyItem.GetExportMonthlyGoldText]"
						tooltipwidget = {
							SimpleContextualStringPairTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetConceptTexture('income')]"
									}
								}
								blockoverride "concept_link" {
									text = "[export_tariff|e]"
								}
								lowpriotextcontext = "[GoodsTradePolicyItem.GetExportGoldTooltip]"
							}
						}
					}
				}
			}
		}
	}
}

lateralview = {
	name = "trade_policies_lateralview"
	widgetid = "trade_policies_lateralview"

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }
			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }
				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_economy')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "THE_ECONOMY_OVERVIEW_TITLE"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_economy_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = economy_main_tabs
			}
		}
		widget = {
			using = layoutpolicy_expanding
			AutomatedSection = {
				datacontext = "[GetAutomatedSystemItem('TradePolicies')]"

				blockoverride "glow_anim_automation_visible" {
					visible = "[AutomatedSystemsItem.IsEnabled]"
				}
			}

			vbox = {
				widgetid = "markets_policies_tab_content"
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt
				spacing = 4
				margin_top = 10
	
				vbox = {
					name = "trade_policies_filter_anchor"
					layoutpolicy_horizontal = expanding
	
					widget = {
						visible = "[TradePoliciesLateralView.IsMarketFilterEnabled]"
						layoutpolicy_horizontal = expanding
						size = { -1 70 }
	
						hbox = {
							datacontext = "[TradePoliciesLateralView.GetSelectedMarket]"
							using = bg_market_card
							using = bg_cabinet_card_frame
	
							market_card = {
								blockoverride "market_card_margins" {
									margin = { 5 5 }
									margin_right = 0
								}
							}
	
							market_card_right_buttons = {
								blockoverride "market_scroll_buttons" {
									vbox = {
										layoutpolicy_vertical = expanding
										spacing = 3
										visible = "[TradePoliciesLateralView.IsMarketFilterEnabled]"
	
										button = {
											size = { 23 23 }
											texture = "gfx/interface/buttons/up_button_alt.dds"
											texture_density = 2
											enabled = "[TradePoliciesLateralView.CanSelectPrevOwnedMarket]"
	
											modify_texture = {
												using = color_new_gold_texture
												blend_mode = add
												alpha = 1
											}
											modify_texture = {
												using = overlay_stone_texture
												blend_mode = overlay
												alpha = 1
											}
											background = {
												texture = "gfx/interface/buttons/bg_button_light.dds"
												texture_density = 2
												modify_texture = {
													using = color_intense_brown_texture
													blend_mode = add
												}
												modify_texture = {
													using = color_dark_brown_texture
													blend_mode = multiply
													alpha = 0.8
												}
											}
											tooltipwidget = { BasicFunctionalTooltip = {} }
	
											action_tooltip = {
												click_type = left
												click_mode = single
												enabled = "[TradePoliciesLateralView.CanSelectPrevOwnedMarket]"
												conditions = "[MakeItFailIfLoc(Not(TradePoliciesLateralView.CanSelectPrevOwnedMarket), 'CANNOT_SCROLL_UP_MARKET_FILTER')]"
												title = "SCROLL_UP_MARKET_FILTER"
												on_action = "[TradePoliciesLateralView.SelectPrevOwnedMarket]"
											}
										}
	
										button = {
											size = { 23 23 }
											texture = "gfx/interface/buttons/up_button_alt.dds"
											mirror = vertical
											texture_density = 2
											enabled = "[TradePoliciesLateralView.CanSelectNextOwnedMarket]"
	
											modify_texture = {
												using = color_new_gold_texture
												blend_mode = add
												alpha = 1
											}
											modify_texture = {
												using = overlay_stone_texture
												blend_mode = overlay
												alpha = 1
											}
											background = {
												texture = "gfx/interface/buttons/bg_button_light.dds"
												texture_density = 2
												modify_texture = {
													using = color_intense_brown_texture
													blend_mode = add
												}
												modify_texture = {
													using = color_dark_brown_texture
													blend_mode = multiply
													alpha = 0.8
												}
											}
											tooltipwidget = { BasicFunctionalTooltip = {} }
	
											action_tooltip = {
												click_type = left
												click_mode = single
												enabled = "[TradePoliciesLateralView.CanSelectNextOwnedMarket]"
												conditions = "[MakeItFailIfLoc(Not(TradePoliciesLateralView.CanSelectNextOwnedMarket), 'CANNOT_SCROLL_DOWN_MARKET_FILTER')]"
												title = "SCROLL_DOWN_MARKET_FILTER"
												on_action = "[TradePoliciesLateralView.SelectNextOwnedMarket]"
											}
										}
									}
								}
								blockoverride "market_filter_buttons" {
									vbox = {
										layoutpolicy_vertical = expanding
										spacing = 3
	
										filter_button_alt = {
											size = { 23 23 }
											blockoverride "filter_button_action" {
												action_tooltip = {
													click_type = left
													click_mode = single
													title = "TOGGLE_MARKET_SELECTION"
													on_action = "[TradePoliciesLateralView.ToggleTradePoliciesSelectMarket(PdxGuiWidget.FindParent('trade_policies_filter_anchor').Self)]"
												}
											}
											tooltipwidget = { BasicFunctionalTooltip = {} }
											blockoverride "glow_visible" {
												visible = "[TradePoliciesLateralView.IsTradePoliciesSelectMarketOpened(PdxGuiWidget.FindParent('trade_policies_filter_anchor').Self)]"
											}
										}
	
										button = {
											using = market_filter_button
											enabled = "[TradePoliciesLateralView.IsMarketFilterEnabled]"
											blockoverride "functional_tooltip" {
												tooltipwidget = { BasicFunctionalTooltip = {} }
												action_tooltip = {
													click_type = left
													click_mode = single
													enabled = "[TradePoliciesLateralView.IsMarketFilterEnabled]"
													title = "REMOVE_MARKET_FILTER"
													on_action = "[TradePoliciesLateralView.RemoveMarketFilter]"
												}
											}
										}
									}
								}
							}
						}
					}
	
					widget = {
						visible = "[Not(TradePoliciesLateralView.IsMarketFilterEnabled)]"
						layoutpolicy_horizontal = expanding
						size = { -1 40 }
	
						button_regular = {
							size = { 100% 40 }
	
							action_tooltip = {
								click_type = left
								click_mode = single
								title = "TOGGLE_MARKET_SELECTION"
								on_action = "[TradePoliciesLateralView.ToggleTradePoliciesSelectMarket(PdxGuiWidget.FindParent('trade_policies_filter_anchor').Self)]"
							}
	
							tooltipwidget = { BasicFunctionalTooltip = {} }
	
							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 5
								margin_left = 8
								margin_right = 5
	
								icon = {
									size = { 22 22 }
									texture = "[GetConceptTexture('market')]"
								}
	
								text_single = {
									align = center|nobaseline
									layoutpolicy_horizontal = expanding
									autoresize = no
									fontsize_min = 11
									text = "TRADE_POLICIES_SHOWING_ALL_MARKETS"
								}
							}
	
							filter_button_alt = {
								parentanchor = right|vcenter
								position = { -10 0 }
								size = { 25 25 }
								blockoverride "filter_button_action" {
									action_tooltip = {
										click_type = left
										click_mode = single
										title = "TOGGLE_MARKET_SELECTION"
										on_action = "[TradePoliciesLateralView.ToggleTradePoliciesSelectMarket(PdxGuiWidget.FindParent('trade_policies_filter_anchor').Self)]"
									}
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
								blockoverride "glow_visible" {
									visible = "[TradePoliciesLateralView.IsTradePoliciesSelectMarketOpened(PdxGuiWidget.FindParent('trade_policies_filter_anchor').Self)]"
								}
							}
						}
					}
				}
	
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 135 }
					name = "tariffs_piecharts_placeholder"
					visible = "[Or(TradePoliciesLateralView.HasImportContributions, TradePoliciesLateralView.HasExportContributions)]"
	
					background = {
						using = bg_scroll_card
					}
	
					hbox = {
