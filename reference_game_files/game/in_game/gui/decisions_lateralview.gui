template content_main_tabs {
	button_main_tab_alt = {
		widget = {
			visible = "[Not(IsLateralViewOpened('missions'))]"
			size = { 100% 100% }
			name = "tab_missions"
		}
		using = layoutpolicy_expanding
		blockoverride "tab_text"{
			text = "MISSIONS_TEXT"
		}
		tooltipwidget = {
			using = TabMissionsTooltip
		}
		visible = "[IsMissionsEnabled]"
		onclick = "[OpenLateralView('missions')]"
		down = "[IsLateralViewOpened('missions')]"
	}

	button_main_tab_alt = {
		widget = {
			visible = "[Not(IsLateralViewOpened('decisions'))]"
			size = { 100% 100% }
			name = "tab_decisions"
		}
		using = layoutpolicy_expanding
		blockoverride "tab_text"{
			text = "DECISIONS_TAB"
		}
		tooltipwidget = {
			using = TabDecisionsTooltip
		}
		onclick = "[OpenLateralView('decisions')]"
		down = "[IsLateralViewOpened('decisions')]"
	}

	button_main_tab_alt = {
		widget = {
			visible = "[Not(IsLateralViewOpened('form_new_country'))]"
			size = { 100% 100% }
			name = "tab_form_new_country"
		}
		using = layoutpolicy_expanding
		blockoverride "tab_text"{
			text = "game_concept_formables"
		}
		onclick = "[OpenLateralView('form_new_country')]"
		down = "[IsLateralViewOpened('form_new_country')]"

		tooltipwidget = {
			using = TabFormablesTooltip
		}
	}

	button_main_tab_alt = {
		visible = "[IsInmersionModeDisabled]"
		widget = {
			visible = "[Not(IsLateralViewOpened('country_dhe'))]"
			size = { 100% 100% }
			name = "tab_events"
		}
		using = layoutpolicy_expanding
		blockoverride "tab_text"{
			text = "SUBTAB_COUNTRY_DHE"
		}
		onclick = "[ShowDHEHistoryForCountry(Player.Self)]"
		down = "[IsLateralViewOpened('country_dhe')]"

		tooltipwidget = {
			using = TabEventsTooltip
		}
	}

	button_main_tab_alt = {
		visible = "[AmbitionsEnabled]"
		widget = {
			visible = "[Not(IsLateralViewOpened('ambitions'))]"
			size = { 100% 100% }
			name = "tab_ambitions"
		}
		using = layoutpolicy_expanding
		blockoverride "tab_text"{
			text = "AMBITIONS_TEXT"
		}
		onclick = "[OpenLateralView('ambitions')]"
		down = "[IsLateralViewOpened('ambitions')]"

		tooltipwidget = {
			using = TabAmbitionsTooltip
		}
	}
}

template content_topbuttons_extra {
	widget = {
		parentanchor = vcenter
		size = { 40 40 }
		position = { 30 0 }

		button_round_shortcut = {
			parentanchor = vcenter
			size = { 25 25 }

			visible = "[IsInmersionModeDisabled]"
			enabled = "[HasDHEEvents(Player.Self)]"

			blockoverride "button_texture" {
				texture = "gfx/interface/buttons/flats/rulinghistory.dds"
				texture_density = 2
			}

			action_tooltip = {
				enabled = "[HasDHEEvents(Player.Self)]"
				title = "DHE_HISTORICAL_EVENTS_BUTTON"
				on_action = "[ShowDHEHistoryForCountry(Player.Self)]"
			}
		}
	}

	widget = {
		parentanchor = vcenter
		size = { 40 40 }
		position = { 60 0 }

		button_round_shortcut = {
			parentanchor = vcenter
			size = { 25 25 }

			blockoverride "button_texture" {
				texture = "gfx/interface/buttons/flats/historical_events.dds"
				texture_density = 2
			}

			action_tooltip = {
				title = "RULING_HISTORY"
				on_action = "[ShowRulingHistoryForCountry(Player.Self)]"
			}
		}
	}
}

template decision_item_tooltip {
	ContextualTooltipType ={
		blockoverride "title_text" {
			text = "[DecisionItem.GetName]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/action.dds"
			}
		}
		blockoverride "tooltip_content" {
			TooltipScrolledRequirementsList = {
				textcontext = "[DecisionItem.GetAllowDescription]"
				blockoverride "block_title" {
					text = "[SelectLocalization(DecisionItem.IsAllowed, 'REQUIREMENT_ARE_MET', 'REQUIREMENT_ARE_NOT_MET')]"
					background = {
						visible = "[DecisionItem.IsAllowed]"
						using = color_mid_light_green_texture
						alpha = 0.9
					}
					background = {
						visible = "[Not(DecisionItem.IsAllowed)]"
						using = color_mid_red_texture
						alpha = 0.7
					}
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 450 }}
			}

			TooltipScrolledRequirementsList = {
				visible = "[DecisionItem.IsInProgress]"
				textcontext = "[UIAction.GetConditions]"
				blockoverride "block_title" {
					text = "game_concept_conditions"
					background = {
						using = color_mid_red_texture
						alpha = 0.7
					}
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 150 }}
			}

			TooltipScrolledGroupedRowList = {
				textcontext = "[DecisionItem.GetOutcomesList]"
				tooltipmeta = {
					texture = "[GetConceptTexture('event_option')]"
					game_concept = "[event_option|e]"
				}
				blockoverride "block_title" {
					text = "DECISION_TT_OUTCOMES"
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 300 }}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[DecisionItem.GetDesc]"
				}
			}
		}
		blockoverride "tooltip_ui_action_block" {
			vbox = {
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes

				TooltipFunctionalBlock = {
					using = tooltip_left_click_template
					blockoverride "action_left_text" {
						text = "DECISION_LEFT_CLICK_PERFORM"
					}
				}
			}
		}
	}
}

template decision_button_props {
	enabled = "[DecisionItem.IsEnabled]"

	action_tooltip = {
		click_type = left
		click_mode = single
		title = "DECISION_LEFT_CLICK_PERFORM"
		enabled = "[DecisionItem.IsEnabled]"
		conditions = "[MakeItFailIfLoc(DecisionItem.IsInProgress, 'DECISION_ALREADY_IN_PROGRESS')]"
		on_action = "[DecisionItem.OpenWindow]"
	}

	tooltipwidget = {
		using = decision_item_tooltip
	}
}

types DecisionsTypes {
	type decision_category_color_strip = widget {
		parentanchor = vcenter|left
		position = {-2 0}
		size = { 10 29 }

		state = {
			name = decision_strip_rest
			duration = 0.15
			scale = 1
			using = Animation_Curve_Default
		}
		state = {
			name = decision_strip_hover
			duration = 0.15
			scale = 1.01
			using = Animation_Curve_Default
		}

		icon = {
			parentanchor = center
			size = {8 31}
			texture = "gfx/interface/component_tiles/decisions/decisions_stab.dds"
			texture_density = 2
		}
		icon = {
			parentanchor = center
			size = {8 22}
			texture = "gfx/interface/component_tiles/decisions/decisions_scroll.dds"
			texture_density = 2
			spritetype = corneredstretched
			spriteborder = {0 15}

			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)0')]" using = color_diplomacy_texture blend_mode = overlay
			}
			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)1')]" using = color_geopolitics_texture blend_mode = overlay
			}
			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)2')]" using = color_government_texture blend_mode = overlay
			}
			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)3')]" using = color_society_texture blend_mode = overlay
			}
			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)4')]" using = color_economy_texture blend_mode = overlay
			}
			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)5')]" using = color_advances_texture blend_mode = overlay
			}
			modify_texture = {
				visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)6')]" using = color_production_texture blend_mode = overlay
			}
		}

		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)0')]" using = color_diplomacy_texture }
		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)1')]" using = color_geopolitics_texture }
		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)2')]" using = color_government_texture }
		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)3')]" using = color_society_texture }
		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)4')]" using = color_economy_texture }
		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)5')]" using = color_advances_texture }
		# background = { visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)6')]" using = color_production_texture }
	}

	type decisions_flat_list_item = widget {
		name = "decision_row"

		widget = {
			layoutpolicy_horizontal = expanding
			size = { 100% 28 }

			widget = {
				size = { 100% 100% }
				visible = "[Not(DecisionItem.IsCDecision)]"
				datacontext = "[DecisionItem.GetDecision]"

				targetted_button_regular = {
					parentanchor = hcenter
					size = { 98% 27 }

					visible = "[PdxGuiWidget.IsUberButtonVisible]"
					enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
					text = "[GenericAction.GetNameWithNoTooltip]"

					scripted_action_tooltip = {
						click_type = left
						click_mode = single
						action_name = "[GenericAction.GetLeftClickKey]"
						actor = "[Player]"
					}
					scripted_action_tooltip = {
						click_type = left
						click_mode = confirm
						action_name = "[GenericAction.GetLeftClickAndHoldKey]"
						actor = "[Player]"
					}

					blockoverride "tooltip" {
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "[GenericAction.GetNameWithNoTooltip]"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/action.dds"
									}
								}
								blockoverride "tooltip_content" {
									using = action_tooltip_inner_content
								}
							}
						}
					}
				}
			}

			widget = {
				size = { 100% 27 }
				visible = "[DecisionItem.IsCDecision]"
				
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)0')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_country.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)1')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_expansion.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)2')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_government.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)3')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_society.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)4')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_economy.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)5')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_other.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}
				decision_button_anim = {
					visible = "[EqualTo_int32(DecisionItem.GetCategorySortOrder, '(int32)6')]"
					size = { 100% 27 }

					blockoverride "decision_button_anim_text" {
						text = "[DecisionItem.GetName]"
					}
					blockoverride "decision_button_color_texture" {
						texture = "gfx/interface/buttons/decisions/button_banner_01_anim_production.dds"
					}
					blockoverride "decision_button_anim_button_props" {
						using = decision_button_props
					}
					onmousehierarchyenter = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_hover')]"
					onmousehierarchyleave = "[PdxGuiWidget.FindParent('decision_row').FindChild('decision_strip').TriggerAnimation('decision_strip_rest')]"
				}

				hbox = {
					margin = { 10 0 }
					margin_right = 20
					spacing = 8

					icon = {
						size = { 18 18 }
						alwaystransparent = no
						visible = "[DecisionItem.HasAge]"
						datacontext = "[DecisionItem.GetAge]"
						texture = "[GetAgeIcon(DecisionItem.GetAge)]"
						texture_density = 2

						tooltipwidget = {
							using = Age_tooltip
						}
					}

					icon = {
						size = { 16 16 }
						alwaystransparent = no
						visible = "[Not(Or(DecisionItem.GetDecisionTemplate.IsOnlyOnce, DecisionItem.GetDecisionTemplate.HideRepeatableTag))]"
						texture = "gfx/interface/icons/international_organizations/change.dds"
						texture_density = 2
	
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "DECISION_REPEATABLE_TITLE"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/international_organizations/change.dds"
									}
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" {
											text = "DECISION_REPEATABLE_TT"
										}
									}
								}
							}
						}
					}

					country_flag_very_small = {
						visible = "[DecisionItem.GetMatchingTagCountry.IsValid]"
						datacontext = "[DecisionItem.GetMatchingTagCountry]"
						blockoverride "show_as_button" { visible = no }
						blockoverride "show_as_icon" { visible = yes }
						blockoverride "tooltip" {}
						blockoverride "contextmenu" {}
						blockoverride "click" {}
						blockoverride "double_click" {}
					}

					expand = {}

					widget = {
						size = { 40 6 }
						visible = "[GreaterThan_int32(DecisionItem.GetTriggerTotal, '(int32)0')]"

						progressbar_framed = {
							size = { 100% 100% }
							using = progress_bar_green_red_alt
							min = 0
							max = "[DecisionItem.GetTriggerTotal]"
							value = "[DecisionItem.GetTriggerProgress]"
						}
					}

					widget = {
						size = { 23 23 }
						datacontext = "[DecisionItem.GetDecisionTemplate]"
						button_notification = {
							size = { 100% 100% }
							action_tooltip = {
								title = "[SelectLocalization(IsDecisionAlertHidden(Decision.Self), 'DECISION_UNHIDE_FROM_ALERT', 'DECISION_HIDE_FROM_ALERT')]"
								on_action = "[ToggleDecisionAlertHidden(Decision.Self)]"
							}
							tooltipwidget = { BasicFunctionalTooltip = {} }
							down = "[IsDecisionAlertHidden(Decision.Self)]"
						}
					}
				}
			}
		}

		decision_category_color_strip = {
			name = "decision_strip"
		}
	}
}

lateralview = {
	name = "decisions_lateralview"
	widgetid = "decisions_lateralview"

	blockoverride "lateralview_topbuttons_extra" {
		using = content_topbuttons_extra
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "TAB_TOOLTIP_CONTENT_TITLE"
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_decisions_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = content_main_tabs
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 5
			margin_top = 2

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 45 }

				hbox = {
					header_button_left = {
						using = timeline_button_actions
	
						blockoverride "adjust_to_content" {
							minimumsize = { 150 40 }
							set_parent_size_to_minimum = yes
						}
	
						blockoverride "bg_color" {
							modify_texture = {
								using = color_dark_brown_texture
								blend_mode = multiply
							}
						}
	
						blockoverride "text_top" {
							text = "TOGGLE_TIMELINE_MODE"
							default_format = "#L"
							maximumsize = { 120 -1 }
							minimumsize = { 120 -1 }
							fontsize = 15
						}
	
						blockoverride "icon_overlay" {}

						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/situations/_default.dds"
						}
					}

					expand = {}

					hbox = {
						margin = { 25 0 }
						minimumsize = { -1 40 }
						spacing = 10

						datacontext = "[DecisionsLateralView.GetUniqueContentDescription]"

						background = {
							using = bg_lobby_banner_gold_texture
						}

						hbox = {
							datamodel = "[DecisionsLateralView.GetRelatedDLC]"
							spacing = 5
							item = {
								short_dlc_banner = {
									size = { 29 39 }
								}
							}
						}

						hbox = {
							spacing = 5

							text_single = {
								autoresize = yes
								text = "[UniqueContentDescription.GetAmountUniqueContentFlavor|L]"
							}

							text_single = {
								autoresize = yes
								text = "COUNTRY_SPECIFIC_LOBBY_DESCRIPTION_TT"
							}

							widget = {
								size = { 24 24 }
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/icons/flat_icons/country_bonus.dds"
								}

								tooltipwidget = {
									using = country_specific_description_tooltip
									blockoverride "country_specific_bonuses_datamodel" {
										datamodel = "[DecisionsLateralView.GetUniqueCountryBonuses]"
									}
									blockoverride "country_culture_datacontext" {}
								}
							}
						}
					}
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				using = bg_age_event_frame
				size = { -1 220 }

				ecs_scene_viewer_widget = {
					size = { 100% 100% }
					name = "event_window_scene_viewer"
					datacontext = "[Player]"
					scene = "[Country.GetGovernment.GetRulerOrRegent.GenerateThroneRoomSceneDesc]"
				}
			}

			vbox = {
				using = layoutpolicy_expanding

				header_secondary_tabs = {
					blockoverride "content" {
						button_secondary_tab_alt = {
							using = layoutpolicy_expanding

							tooltipwidget = { BasicFunctionalTooltip = {} }

							text = "DECISIONS_TAB"
							down = "[LateralView.Vars.NotExistOrHasValue('subtab','decisions')]"

							action_tooltip = {
								title = "OPEN_TAB"
								on_action = "[LateralView.Vars.Set('subtab','decisions')]"
							}
						}

						button_secondary_tab_alt = {
							using = layoutpolicy_expanding

							tooltipwidget = { BasicFunctionalTooltip = {} }

							text = "CONTENT"
							down = "[LateralView.Vars.HasValue('subtab', 'content')]"

							action_tooltip = {
								title = "OPEN_TAB"
								on_action = "[LateralView.Vars.Set('subtab','content')]"
							}
						}
					}
				}

				vbox = {
					visible = "[LateralView.Vars.NotExistOrHasValue('subtab','decisions')]"
					using = layoutpolicy_expanding
					using = bg_secondary_inner_alt
					using = bg_secondary_inner_image_alt
					
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 45 }
						hbox = {
							subheader_unified_icon = {

								datacontext = "[Player]"
								datacontext = "[Player.GetCulture]"
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_text" {
											text = "DECISIONS_DONE_HEADER"
										}
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/decisions/done_decisions.dds"
											}
										}
										blockoverride "tooltip_content" {
											TooltipTextBlock = {
												blockoverride "text" {
													text = "DECISIONS_DONE_TOOLTIP_DESC"
												}
											}
											TooltipBlockList = {
												textcontext = "[DecisionsLateralView.GetDoneDecisionsList]"
											}
										}
									}
								}
								blockoverride "subheader_unified_icon" {
									icon = {
										size = { 40 40 }						
										texture = "gfx/interface/icons/decisions/done_decisions.dds"
									}
								}
								blockoverride "subheader_unified_top_text" {
									text = "DECISIONS_DONE_HEADER"
									align = nobaseline
								}
								blockoverride "subheader_unified_bottom_text" {
									text = "[DecisionsLateralView.GetDoneDecisionsCount]"
									align = nobaseline
								}
							}

							expand = {}
							
							subheader_unified_icon = {
								blockoverride "mirror_layout" { righttoleft = yes }

								datacontext = "[Player]"
								datacontext = "[Player.GetCommonLanguage]"
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_text" {
											text = "DECISIONS_UNIQUE_HEADER"
										}
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/decisions/unique_decisions.dds"
											}
										}
										blockoverride "tooltip_content" {
											TooltipBlockList = {
												textcontext = "[DecisionsLateralView.GetUniqueDecisionsList]"
											}
										}
									}
								}
								blockoverride "subheader_unified_icon_texture" {
									texture = "gfx/interface/icons/decisions/unique_decisions.dds"
								}
								blockoverride "subheader_unified_top_text" {
									text = "DECISIONS_UNIQUE_HEADER"
									align = right|nobaseline
								}
								blockoverride "subheader_unified_bottom_text" {
									text = "[DecisionsLateralView.GetUniqueDecisionsCount]"
									align = right|nobaseline
								}
							}
						}
					}

					filtered_sorted_list = {
						datacontext = "[DecisionsLateralView.GetDecisionsSortSearch]"

						blockoverride "scroll_list_is_empty_text" {
							text = "DECISIONS_LIST_EMPTY"
						}

						blockoverride "searchbar_extra_pre_content" {
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 2
								margin = { 5 5 }
								margin_top = 0

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { 
											using = color_diplomacy_texture
										}
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('country_specific_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_COUNTRY_SPECIFIC"
											on_action = "[SearchBar.ToggleFilterByKey('country_specific_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										country_flag_very_small = {
											parentanchor = center
											datacontext = "[Player]"
											blockoverride "show_as_button" { visible = no }
											blockoverride "show_as_icon" { visible = yes }
											blockoverride "tooltip" {}
											blockoverride "contextmenu" {}
											blockoverride "click" {}
											blockoverride "double_click" {}
										}
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { using = color_geopolitics_texture }
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('expansion_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_EXPANSION"
											on_action = "[SearchBar.ToggleFilterByKey('expansion_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										widget = {
											size = { 22 22 }
											parentanchor = center
											ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/geography_flat_icon.dds" texture_density = 2 }
										}
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { using = color_government_texture }
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('government_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_GOVERNMENT"
											on_action = "[SearchBar.ToggleFilterByKey('government_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										widget = {
											size = { 22 22 }
											parentanchor = center
											ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/government.dds" texture_density = 2 }
										}
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { using = color_society_texture }
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('religious_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_RELIGIOUS"
											on_action = "[SearchBar.ToggleFilterByKey('religious_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										widget = {
											size = { 22 22 }
											parentanchor = center
											ConceptIcon = { texture = "gfx/interface/icons/flat_icons/religion_primary.dds" texture_density = 2 }
										}
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { using = color_economy_texture }
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('economy_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_ECONOMY"
											on_action = "[SearchBar.ToggleFilterByKey('economy_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										widget = {
											size = { 22 22 }
											parentanchor = center
											ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/economy.dds" texture_density = 2 }
										}
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { using = color_production_texture }
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('infrastructure_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_INFRASTRUCTURE"
											on_action = "[SearchBar.ToggleFilterByKey('infrastructure_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										widget = {
											size = { 22 22 }
											parentanchor = center
											ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/production.dds" texture_density = 2 }
										}
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 30 }
									background = {
										using = bg_card_header_01_default
										blockoverride "header_color" { using = color_advances_texture }
									}
									card_header_button_04 = {
										size = { 100% 100% }
										down = "[SearchBar.IsFilterEnabledByKey('other_decisions')]"
										action_tooltip = {
											title = "DECISION_CATEGORY_OTHER"
											on_action = "[SearchBar.ToggleFilterByKey('other_decisions')]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										widget = {
											size = { 22 22 }
											parentanchor = center
											ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/agenda.dds" texture_density = 2 }
										}
									}
								}
							}
						}

						blockoverride "scroll_list_is_empty" {
							visible = "[IsDataModelEmpty(DecisionsLateralView.GetAllDecisions)]"
						}

						blockoverride "scroll_list_layout" {
							fixedgridbox = {
								layoutpolicy_horizontal = expanding
								datamodel_reuse_widgets = yes
								setitemsizefromcell = yes
								addcolumn = 100%
								addrow = 35

								datamodel = "[DecisionsLateralView.GetAllDecisions]"
								item = {
									widget = {
										hbox = {
											margin_left = 5
											margin_right = 20
											margin_top = 2
											margin_bottom = 7

											decisions_flat_list_item = {
												layoutpolicy_horizontal = expanding
												size = { -1 28 }
											}
										}
									}
								}
							}
						}
					}
				}

				vbox = {
					visible = "[LateralView.Vars.HasValue('subtab','content')]"
					using = layoutpolicy_expanding
					using = bg_secondary_inner_alt
					using = bg_secondary_inner_image_alt

					scrollarea = {
						
						using = layoutpolicy_expanding
						autoresizescrollarea = no
						scrollbarpolicy_horizontal = always_off
	
						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}
	
						scrollwidget = {
							vbox = {
								using = layoutpolicy_expanding
	
								filtered_sorted_list = {
									datacontext = "[DecisionsLateralView.GetUniqueContentCategoriesSortSearch]"
	
									blockoverride "scroll_list_setup" {
										using = layoutpolicy_expanding
										scrollbarpolicy_horizontal = always_off
	
										scrollbar_vertical = {
											using = Scrollbar_Vertical
										}
									}
	
									blockoverride "scroll_list_is_empty" {
										visible = "[IsDataModelEmpty(DecisionsLateralView.GetUniqueContentCategories)]"
									}
	
									blockoverride "scroll_list_is_empty_text" {
										text = "UNIQUE_CONTENT_LIST_EMPTY"
									}
	
									blockoverride "scroll_list_layout" {
										vbox = {
											layoutpolicy_horizontal = expanding
											spacing = 10
											margin = { 7 10 }
	
											vbox = {
												layoutpolicy_horizontal = expanding
												spacing = 10
												datamodel = "[DecisionsLateralView.GetUniqueContentCategories]"
												item = {
													laws_list_item = {
														datacontext = "[Player]"
														visible = "[Not(IsDataModelEmpty(UniqueContentCategory.GetUniqueContentItems))]"
														blockoverride "graphical_culture_pattern_texture" {
															texture = "[GetGraphicalCultureTextureForCountry('header_pattern', Country.Self)]"
														}
														blockoverride "law_type_button" {
															action_tooltip = {
																title = "TOGGLE_UNIQUE_CONTENT_CATEGORY"
																on_action = "[LateralView.Vars.SetOrToggle( 'category', UniqueContentCategory.GetName )]"
															}
	
															tooltipwidget = { BasicFunctionalTooltip = {} }
														}
	
														blockoverride "law_icon" {
															texture = "[UniqueContentCategory.GetIcon]"
														}
														blockoverride "law_type_button_text" {
															text = "[UniqueContentCategory.GetName]"
														}
														blockoverride "laws_amount" {
															text = "[GetDataModelSize(UniqueContentCategory.GetUniqueContentItems)]"
														}
														blockoverride "law_arrow_expanded" {
															visible = "[LateralView.Vars.HasValue( 'category', UniqueContentCategory.GetName )]"
														}
														blockoverride "law_arrow_not_expanded" {
															visible = "[Not(LateralView.Vars.HasValue( 'category', UniqueContentCategory.GetName ))]"
														}
														blockoverride "laws_list_datamodel" {
															visible = "[LateralView.Vars.HasValue( 'category', UniqueContentCategory.GetName )]"
															datamodel = "[UniqueContentCategory.GetUniqueContentItems]"
														}
														blockoverride "law_unique_flavor_visible" {
															visible = no
														}
														blockoverride "laws_list_inner_item" {
															unique_content_item = {}
														}
														blockoverride "law_category_color" {
															using = color_mid_blue_texture
														}
													}
												}
											}
											expand = {}
										}
									}
								}
	
								expand = {}
							}
						}
					}
				}	
			}
		}
	}
}
