
template production_method_simple {
	hbox = {
		layoutpolicy_horizontal = expanding
		block "tooltip" {}
		margin = { 0 4 }

		block "production_method_simple_bg" {
			background = {
				using = color_turquoise_texture
				alpha = 0.2
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			margin = {9 0}

			# Prod
			block "production_method_simple_icon" {
				icon = {
					size = { 20 20 }
					texture = "[GetProductionMethodIcon(ProductionMethod.Self)]"
				}
			}

			# Inputs
			hbox = {
				layoutpolicy_horizontal = expanding
				hbox = {
					spacing = 4
					datamodel = "[ProductionMethod.GetGoodsDemand.GetEntries]"
					item = {
						production_method_good_small = {
							datacontext = "[GoodsDemandEntry.GetGoods]"
							using = bg_input_good
							blockoverride "production_method_good_unused_color" {
								visible = yes
							}
							blockoverride "production_method_good_value" {
								text = "[GoodsDemandEntry.GetValue|2]"
							}
							blockoverride "production_method_good_value_tooltip" {
								block "production_method_simple_good_tooltip" {
									tooltipwidget = { using = Goods_tooltip }
								}
							}
							blockoverride "production_method_good_button_tooltip" {
								block "production_method_simple_good_tooltip" {
									tooltipwidget = { using = Goods_tooltip }
								}
							}
							blockoverride "production_method_good_text_card_background" {}
						}
					}
				}
				expand = {}
			}

			expand = {}

			widget = {
				size = { 30 20 }

				icon = {
					parentanchor = right
					size = { 20 20 }
					visible = "[ProductionMethod.IsProducing]"					
					texture = "gfx/interface/buttons/flats/button_simple.dds"						
					modify_texture = {
						using = color_bone_texture
						blend_mode = normal
					}
				}
			}


			# Outputs
			widget = {
				visible = "[ProductionMethod.IsProducing]"	
				size = { 73 27}

				production_method_good = {
					parentanchor = right
					datacontext = "[ProductionMethod.GetProduced]"
					using = bg_output_good
					blockoverride "production_method_good_unused_color" {
						visible = yes
					}
					blockoverride "production_method_good_value" {
						text = "[ProductionMethod.GetOutput]"
					}
					blockoverride "production_method_good_value_tooltip" {
						block "production_method_simple_good_tooltip" {
							tooltipwidget = { using = Goods_tooltip }
						}
					}
					blockoverride "production_method_good_text_card_background" {}
					blockoverride "production_method_good_button_tooltip" {
						block "production_method_simple_good_tooltip" {
							tooltipwidget = { using = Goods_tooltip }
						}
					}
				}
			}

			block "production_method_simple_extra" {}
		}
	}
}

template production_method_active {
	layoutpolicy_horizontal = expanding
	tooltipwidget = { using = ProductionMethod_tooltip }
	margin = { 0 4 }

	block "production_method_active_bg" {
		background = {
			using = color_turquoise_texture
			alpha = 0.2
		}
	}

	hbox = {
		using = layoutpolicy_expanding
		spacing = 5
		margin = {9 0}

		# Prod
		block "production_method_active_icon" {
			icon = {
				size = { 20 20 }
				texture = "[GetProductionMethodIcon(ProductionMethod.Self)]"
			}
		}

		# Inputs
		hbox = {
			layoutpolicy_horizontal = expanding
			hbox = {
				spacing = 4
				datamodel = "[ProductionMethod.GetGoodsDemand.GetEntries]"
				item = {
					production_method_good = {
						datacontext = "[GoodsDemandEntry.GetGoods]"
						datacontext = "[Market.GetMarketEntry(GoodsDemandEntry.GetGoods)]"
						onmousehierarchyenter = "[PdxGuiWidget.SetHighlightGoods(GoodsDemandEntry.GetGoods)]"
						using = bg_input_good
						blockoverride "production_method_good_size" {
							size = "[ToVector2f(Select_float(LessThanOrEqualTo_int32(GetDataModelSize(ProductionMethod.GetGoodsDemand.GetEntries), '(int32)5'), '(float)70', '(float)50'), '(float)27')]"
						}
						blockoverride "production_method_good_active_color" {
							visible = "[Not(Building.IsMissingGood(GoodsDemandEntry.GetGoods.Self))]"
						}
						blockoverride "production_method_good_shortage_color" {
							visible = "[Building.IsMissingGood(GoodsDemandEntry.GetGoods.Self)]"
						}
						blockoverride "production_method_good_value" {
							visible = "[Not(GreaterThan_CFixedPoint(Multiply_CFixedPoint(GoodsDemandEntry.GetValue, ProductionMethod.GetInputScale(Building.Self)), '(CFixedPoint)99.5'))]"
							text = "[Multiply_CFixedPoint(GoodsDemandEntry.GetValue, ProductionMethod.GetInputScale(Building.Self))|~]"
						}
						blockoverride "production_method_good_extra_value" {
							text_single = {
								autoresize = no
								parentanchor = center
								align = center|nobaseline
								size = {20 20}
								visible = "[GreaterThan_CFixedPoint(Multiply_CFixedPoint(GoodsDemandEntry.GetValue, ProductionMethod.GetInputScale(Building.Self)), '(CFixedPoint)99.5')]"
								text = "[Multiply_CFixedPoint(GoodsDemandEntry.GetValue, ProductionMethod.GetInputScale(Building.Self))|~]"
							}
						}
						blockoverride "production_method_good_value_tooltip" {
							tooltipwidget = {
								SimpleContextualStringPairTooltipType = {
									blockoverride "title_icon_texture" {
										texture = "[GetGoodsIcon(GoodsDemandEntry.GetGoods.Self)]"
									}
									textcontext = "[ProductionMethod.GetInputDemandInfo(GoodsDemandEntry.Self, Building.Self)]"
								}
							}
						}
						blockoverride "production_method_good_button_tooltip" {
							tooltipwidget = {
								using = SpecificGoodsMarket_tooltip
							}
							action_tooltip = {
								click_type = right
								click_mode = single
								title = "GOODS_MARKET_CTXMENU_OPEN"
								on_action = "[PdxGuiWidget.ToggleContextMenu]"
							}

							contextmenu_widget = {
								GoodsMarketContextMenu = {}
							}
						}

						blockoverride "PM_price_icon_visible" {
							visible = "[LessThanOrEqualTo_int32(GetDataModelSize(ProductionMethod.GetGoodsDemand.GetEntries), '(int32)5')]"
						}

						blockoverride "container_color" {
							modify_texture = {
								using = color_bg_brown_texture
								blend_mode = multiply
							}
							alpha = 0.8
						}
					}
				}
			}
			expand = {}
		}

		expand = {}

		icon = {
			size = { 20 20 }
			visible = "[ProductionMethod.IsProducing]"					
			texture = "gfx/interface/buttons/flats/button_simple.dds"						
			modify_texture = {
				using = color_bone_texture
				blend_mode = normal
			}
		}

		# Outputs
		widget = {
			size = { 73 27}
			visible = "[ProductionMethod.IsProducing]"	

			production_method_good = {
				parentanchor = right
				datacontext = "[ProductionMethod.GetProduced]"
				using = bg_output_good
				blockoverride "production_method_good_size" {
					size = {73 27}
				}
				blockoverride "production_method_good_active_color" {
					visible = yes
				}
				blockoverride "production_method_good_value" {
					visible = "[Not(GreaterThan_CFixedPoint(Building.GetEffectiveOutput(ProductionMethod.Self), '(CFixedPoint)99.5'))]"
					text = "[Building.GetEffectiveOutput(ProductionMethod.Self)|~L]"
				}
				blockoverride "production_method_good_extra_value" {
					text_single = {
						autoresize = no
						parentanchor = center
						align = center|nobaseline
						size = {20 20}
						visible = "[GreaterThan_CFixedPoint(Building.GetEffectiveOutput(ProductionMethod.Self), '(CFixedPoint)99.5')]"
						text = "[Building.GetEffectiveOutput(ProductionMethod.Self)|~L]"
					}
				}
				blockoverride "production_method_good_value_tooltip" {
					tooltipwidget = {
						SimpleContextualStringPairTooltipType = {
							blockoverride "title_icon_texture" {
								texture = "[GetGoodsIcon(ProductionMethod.GetProduced)]"
							}
							textcontext = "[Building.GetEffectiveOutputInfo(ProductionMethod.Self)]"
						}
					}
				}
				blockoverride "production_method_good_button_tooltip" {
					datacontext = "[Market.GetMarketEntry(Goods.Self)]"
					tooltipwidget = {
						using = SpecificGoodsMarket_tooltip
					}
				}

				blockoverride "PM_price_icon_visible" {
					visible = yes
				}
				blockoverride "container_color" {
					modify_texture = {
						using = color_bg_brown_texture
						blend_mode = multiply
					}
					alpha = 0.8
				}
			}
		}

		block "production_method_active_extra" {}
	}
}

types production_method_types {
	type production_method_good = icon {
		block "production_method_good_size" {
			size = {50 27}
		}

		production_method_good_frame = {
			blockoverride "active_color" {
				block "production_method_good_active_color" {
					visible = no
				}
			}
			blockoverride "shortage_color" {
				block "production_method_good_shortage_color" {
					visible = no
				}
			}
			blockoverride "unused_color" {
				block "production_method_good_unused_color" {
					visible = no
				}
			}
		}

		hbox = {
			margin = {1 0}

			widget = {
				size = {23 20}
				
				block "production_method_good_text_card_background" {
					# using = bg_square_tile
					using = bg_text_mask_container_brown
				}

				text_single = {
					autoresize = no
					parentanchor = center
					align = center|nobaseline
					size = {20 20}
					block "production_method_good_value" {
						raw_text = "default"
					}
				}

				block "production_method_good_extra_value" {}
				block "production_method_good_value_tooltip" {}
			}

			button = {
				size = { 20 20 }
				texture = "[GetGoodsIcon(Goods.Self)]"
				onclick = "[ShowGoods(Goods.Self)]"
				onmousehierarchyenter = "[PdxGuiWidget.SetHighlightGoods(Goods.Self)]"

				block "production_method_good_button_tooltip" {}
			}

			widget = {
				block "PM_price_icon_visible" {
					visible = no
				}
				size = {20 20}

				text_single = {
					autoresize = no
					parentanchor = center
					align = left|nobaseline
					size = {20 20}
					fontsize = 18
					raw_text = "@[Goods.GetPriceDifferenceIconName(Building.GetLocation.GetMarket.GetPrice(Goods.Self))]!"
					datacontext = "[Market.GetMarketEntry(Goods.Self)]"
					datacontext = "[Building.GetLocation.GetMarket]"
					tooltipwidget = { using = SpecificGoodsMarket_tooltip }
				}
			}
		}
	}

	type production_method_good_small = icon {
		block "production_method_good_size" {
			size = {50 27}
		}

		production_method_good_frame = {
			blockoverride "active_color" {
				block "production_method_good_active_color" {
					visible = no
				}
			}
			blockoverride "shortage_color" {
				block "production_method_good_shortage_color" {
					visible = no
				}
			}
			blockoverride "unused_color" {
				block "production_method_good_unused_color" {
					visible = no
				}
			}
		}

		hbox = {
			margin = {1 0}

			widget = {
				size = {23 20}
				
				block "production_method_good_text_card_background" {
					# using = bg_square_tile
					using = bg_text_mask_container_brown
				}

				text_single = {
					autoresize = no
					parentanchor = center
					align = center|nobaseline
					size = {22 22}
					block "production_method_good_value" {
						raw_text = "default"
					}
				}

				block "production_method_good_extra_value" {}
				block "production_method_good_value_tooltip" {}
			}

			button = {
				size = { 20 20 }
				texture = "[GetGoodsIcon(Goods.Self)]"
				onclick = "[ShowGoods(Goods.Self)]"
				onmousehierarchyenter = "[PdxGuiWidget.SetHighlightGoods(Goods.Self)]"

				block "production_method_good_button_tooltip" {}
			}

			widget = {
				block "PM_price_icon_visible" {
					visible = no
				}
				size = {20 20}

				text_single = {
					autoresize = no
					parentanchor = center
					align = left|nobaseline
					size = {20 20}
					fontsize = 18
					raw_text = "@[Goods.GetPriceDifferenceIconName(Building.GetLocation.GetMarket.GetPrice(Goods.Self))]!"
					datacontext = "[Market.GetMarketEntry(Goods.Self)]"
					tooltipwidget = {
						using = goods_market_price_tooltip
					}
				}
			}
		}
	}
}

# Per-row, per-slot production-method circles used on the build-in-location list ("Barcelona row").
# datacontext = LocationBuildingSlot (one per production-method slot of the row's building);
# LocationToBuildItem is inherited from the row.
types production_method_slot_types {
	type production_method_slot_circle = widget {
		size = { 24 24 }

		# affordance distinguishing it from a static slot (hover-only, by design). Left-click opens
		# the floating chooser popup, anchored to the circle and auto-dismissed on outside-click.
		icon_button_small_round = {
			size = { 100% 100% }
			parentanchor = center
			datacontext = "[LocationToBuildItem.GetBuilding]"
			datacontext = "[LocationBuildingSlot.GetActiveMethod]"
			tooltipwidget = { using = ProductionMethod_tooltip }

			# Hover hint telling the player the circle is clickable, plus the click that opens the chooser.
			action_tooltip = {
				click_type = left
				click_mode = single
				title = "CHANGE_PRODUCTION_METHOD"
				on_action = "[PdxGuiWidget.ToggleContextMenu]"
			}
			# Right-click toggles whether automation may change this building's production methods.
			action_tooltip = {
				visible = "[LocationBuildingSlot.HasMultipleMethods]"
				click_type = right
				click_mode = single
				title = "[SelectLocalization(Building.IsProductionMethodsLocked, 'PM_UNLOCK_ACTION', 'PM_LOCK_ACTION')]"
				description = "[SelectLocalization(Building.IsProductionMethodsLocked, 'PM_IS_LOCKED', 'PM_IS_UNLOCKED')]"
				on_action = "[LockProductionMethods(Building.Self)]"
			}
			contextmenu_widget = {
				production_method_chooser_menu = {}
			}

			icon = {
				parentanchor = center
				size = { 20 20 }
				texture = "[GetProductionMethodIcon(LocationBuildingSlot.GetActiveMethod)]"
			}
		}

		# Lock indicator: production methods are locked against automation for this building.
		icon = {
			visible = "[LocationToBuildItem.GetBuilding.IsProductionMethodsLocked]"
			parentanchor = top|left
			position = { -3 -3 }
			size = { 12 12 }
			texture = "gfx/interface/icons/achievements/padlock.dds"
			glow = {
				name = "drop_shadow"
				glow_radius = 2
				color = { 0.0 0.0 0.0 1.0 }
				alpha = 0.6
			}
		}
	}

	# Floating popup to pick a different production method for one building's slot.
	# Inherits LocationBuildingSlot + LocationToBuildItem from the circle button that opens it.
	type production_method_chooser_menu = ContextMenuBase {
		blockoverride "contextmenu_content" {
			ContextMenuSection = {
				blockoverride "title_icon" {
					icon = {
						using = tooltip_title_icon_size
						texture = "[GetProductionMethodIcon(LocationBuildingSlot.GetActiveMethod)]"
					}
				}

				# A single-slot building type has no meaningful per-slot name (the key is auto-generated),
				# so fall back to the building's name; multi-slot types keep the slot/group name.
				blockoverride "title_text" {
					text = "[SelectLocalization(GreaterThan_int32(GetDataModelSize(LocationToBuildItem.GetBuildingType.GetPossibleProductionMethods), '(int32)1'), 'PRODUCTION_METHOD_CHOOSER_TITLE_SLOT', 'PRODUCTION_METHOD_CHOOSER_TITLE_BUILDING')]"
				}

				blockoverride "contextmenu_entries" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						datacontext = "[LocationToBuildItem.GetBuilding]"
						datamodel = "[LocationBuildingSlot.GetPossibleMethods.GetMethods]"
						item = {
							widget = {
								# Wide enough to hold the worst realistic case (4-5 inputs + output + profit)
								# without clipping the right-hand profit indicator.
								size = { 470 40 }
								card_list_button = {
									size = { 100% 100% }
									enabled = "[CanChangeToProductionMethod(LocationToBuildItem.GetBuilding.Self, ProductionMethod.Self, LocationBuildingSlot.GetSlot)]"
									onclick = "[ChangeBuildingProductionMethod(LocationToBuildItem.GetBuilding.Self, ProductionMethod.Self, LocationBuildingSlot.GetSlot)]"
									onclick = "[ExtraTooltipInfo.CloseContextMenu]"

									tooltipwidget = { using = ProductionMethod_tooltip }

									hbox = {
										layoutpolicy_horizontal = expanding
										margin_right = 8
										using = production_method_simple
										blockoverride "production_method_simple_good_tooltip" {
											datacontext = "[Building.GetLocation.GetMarket]"
											tooltipwidget = { using = SpecificGoodsMarket_tooltip }
										}
										blockoverride "production_method_simple_bg" {
											background = {
												using = color_turquoise_texture
												alpha = 0.2
												visible = "[BuildingHasProductionMethodActive(LocationToBuildItem.GetBuilding.Self, ProductionMethod.Self, LocationBuildingSlot.GetSlot)]"
											}
										}
										# Profit + availability indicators, same data as the building panel.
										blockoverride "production_method_simple_extra" {
											text_single = {
												visible = "[Building.GetType.IsProducing]"
												raw_text = "[ProductionMethod.GetProfit(Building.Self)|+=2]@wealth!"
												size = { 56 24 }
												autoresize = no
												align = center
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "PRODUCTION_METHOD_PROFIT"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/resources/gold.dds"
															}
														}
														blockoverride "concept_link" {
															text = "[production_method|E]"
														}
														blockoverride "tooltip_content" {
															TooltipStringPairList = {
																textcontext = "[ProductionMethod.GetProfitInfo(Building.Self)]"
															}
														}
													}
												}

												using = bg_number_container_bckg
												blockoverride "number_container_alpha" {
													alpha = 0.5
												}
												blockoverride "number_container_color" {
													modify_texture = {
														using = color_bg_blue_texture
														blend_mode = multiply
													}
												}
											}

											widget = {
												size = { 18 24 }
												icon = {
													parentanchor = center
													size = { 16 16 }
													visible = "[Not(ProductionMethod.IsAvailable(Building.Self))]"
													using = warning_icon_texture
													TooltipWidget = {
														SimpleContextualTooltipType = {
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	using = warning_icon_texture
																}
															}
															blockoverride "concept_link" {
																text = "[goods|E]"
															}
															lowpriotextcontext = "[ProductionMethod.GetAvailableInfo(Building.Self)]"
														}
													}
												}

												icon = {
													parentanchor = center
													visible = "[And(ProductionMethod.IsAvailable(Building.Self), Building.HasBuildingRGOBonus(ProductionMethod.Self))]"
													size = { 16 16 }
													texture = "gfx/interface/icons/sort/rgo.dds"
													glow = {
														name = "drop_shadow"
														glow_radius = 3
														color = {0.0 0.0 0.0 1.0}
														alpha = 0.3
													}
													using = bg_circle

													modify_texture = {
														using = color_muztard_texture
													}

													tooltipwidget = {
														SimpleContextualStringPairTooltipType = {
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	texture = "gfx/interface/icons/flat_icons/building_panel/production_efficiency.dds"
																}
															}
															blockoverride "concept_link" {
																text = "[production_efficiency|e]"
															}
															blockoverride "tooltip_textcontext" {
																textcontext = "[Building.GetBuildingProductionEfficiencyInfo(ProductionMethod.Self)]"
															}
														}
													}

													modify_texture = {
														using = color_mid_yellow_texture
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
