template ParliamentIssueWithContext_tooltip {
	ContextualTooltipType = {	
		blockoverride "title_text" {
			text = "[ParliamentIssueWithContextWrap.GetParliamentIssue.GetNameWithNoTooltip]"
		}
		blockoverride "concept_link" {
			block "concept_link" {
				text = [parliament_issue|E]
			}
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('parliament_issue')]"
			}
		}
		
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				visible = "[ParliamentIssueWithContextWrap.GetParliamentIssue.HasDebateInfo]"
				textcontext = "[ParliamentIssueWithContextWrap.GetParliamentIssue.GetDebateInfo]"
			}

			TooltipListScrollArea = {
				visible = "[ParliamentIssueWithContextWrap.GetParliamentIssue.HasPassedInfo]"

				blockoverride "block_scrollarea" {
					maximumsize = { -1 500 }
				}

				blockoverride "scrollarea_content" {
					TooltipTextBlock = {
						set_parent_dimension_to_minimum = height
						layoutpolicy_horizontal = expanding
						
						blockoverride "text" {
							text = "[ParliamentIssueWithContextWrap.GetParliamentIssue.GetPassedInfo]"
						}
					}
				}
			}

			TooltipRowList = {
				visible = "[ParliamentIssueWithContextWrap.GetParliamentIssue.HasFailInfo]"
				textcontext = "[ParliamentIssueWithContextWrap.GetParliamentIssue.GetFailInfo]"
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[ParliamentIssueWithContextWrap.GetParliamentIssue.GetDescription]"
				}
			}
		}
	}
}

