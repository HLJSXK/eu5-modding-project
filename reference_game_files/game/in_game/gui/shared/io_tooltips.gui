template ImperialCircle_members_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			widget = {
				size = {45 45}

				circular_country_flag_small = {
					parentanchor = center
					datacontext = "[ImperialCircle.GetNameArea.GetCapital.GetOwner]"
					blockoverride "show_as_button" { visible = no }
					blockoverride "show_as_icon" { visible = yes }
					blockoverride "tooltip" {}
					blockoverride "contextmenu" {}
					blockoverride "click" {}
					blockoverride "double_click" {}

					size = { 60 40 }
				}

				icon = {
					parentanchor = center
					size = {100% 100%}
					texture_density = 2
					texture = "gfx/interface/icons/imperial_circles/imperial_circles_frame.dds"
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.8
					}
				}
			}
		}
		blockoverride "title_text" {
			text = "HRE_CIRCLE_MEMBERS_TOOLTIP_TITLE"
		}
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "HRE_CIRCLE_MEMBERS_TOOLTIP_COUNT"
				}
			}
			TooltipListScrollArea = {
				blockoverride "section_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_right = 6
						spacing = 2
						datamodel = "[ImperialCircle.GetActiveMembers]"
						item = {
							hbox = {
								layoutpolicy_horizontal = expanding
								using = bg_paper_card
								using = bg_cabinet_card_frame
								spacing = 6
								margin = { 4 4 }
								country_flag_small = {
									size = { 30 20 }
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									align = left|nobaseline
									text = "[Country.GetLongName]"
									tagtooltip_enabled = yes
								}
							}
						}
					}
				}
			}
		}
	}
}

template ImperialCircle_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[ImperialCircle.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			widget = {
				size = {45 45}

				circular_country_flag_small = {
					parentanchor = center
					datacontext = "[ImperialCircle.GetNameArea.GetCapital.GetOwner]"
					blockoverride "show_as_button" { visible = no }
					blockoverride "show_as_icon" { visible = yes }
					blockoverride "tooltip" {}
					blockoverride "contextmenu" {}
					blockoverride "click" {}
					blockoverride "double_click" {}

					size = { 60 40 }
				}

				icon = {
					parentanchor = center
					size = {100% 100%}
					texture_density = 2
					texture = "gfx/interface/icons/imperial_circles/imperial_circles_frame.dds"
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.8
					}
				}
			}
		}

		blockoverride "concept_link" {
			text = [imperial_circle|E]
		}

		blockoverride "tooltip_content" {
			TooltipListScrollArea = {
				blockoverride "section_content" {
					TooltipTextBlock = {
						visible = "[ImperialCircle.IsMember(GetPlayer.Self)]"
						textcontext = "IMPERIAL_CIRCLE_TT_MEMBER"
					}
					TooltipTextBlock = {
						visible = "[ImperialCircle.HasLeader]"
						textcontext = "IMPERIAL_CIRCLE_TT_LEADER"
					}

					TooltipTextBlock = {
						textcontext = "IMPERIAL_CIRCLE_TT_SATISFACTION"
					}

					TooltipTextBlock = {
						textcontext = "IMPERIAL_CIRCLE_TT_SAT_EFFECTS"
					}

					TooltipTextBlock = {
						visible = "[ImperialCircle.IsDormant]"
						textcontext = "IMPERIAL_CIRCLE_TT_DORMANT"
					}

					# Members list — styled like the IO policies list.
					TooltipRowList = {
						visible = "[Not(IsDataModelEmpty(ImperialCircle.GetActiveMembers))]"
						blockoverride "block_title" {
							raw_text = "[ImperialCircle.GetMemberCount] [Localize('IMPERIAL_CIRCLE_TT_MEMBERS_HEADER')]"
						}
						blockoverride "rowlist_datamodel_is_empty" {
							visible = "[IsDataModelEmpty(ImperialCircle.GetActiveMembers)]"
						}
						blockoverride "rowlist_datamodel_has_items" {
							visible = "[DataModelHasItems(ImperialCircle.GetActiveMembers)]"
						}
						blockoverride "rowlist_datamodel" {
							datamodel = "[DataModelFirst(ImperialCircle.GetActiveMembers, '(int32)8')]"
						}
						blockoverride "rowlist_item" {
							text = "[Country.GetLongName]"
						}
						TooltipTableField = {
							visible = "[GreaterThan_int32(GetDataModelSize(ImperialCircle.GetActiveMembers), '(int32)8')]"
							blockoverride "field_content" {
								text_single = {
									margin = { 10 5 }
									align = nobaseline
									autoresize = yes
									elide = right
									using = tooltip_max_width_title_wide
									text = "IMPERIAL_CIRCLE_TT_MEMBERS_OVERFLOW"
								}
								expand = {}
							}
							blockoverride "field_background" {}
						}
					}
				}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "IMPERIAL_CIRCLE_TT_FLAVOR"
				}
			}
		}
	}
}

template HreCircleSatisfaction_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "CIRCLE_SATISFACTION"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/happy.dds"
			}
		}

		blockoverride "tooltip_content" {
			TooltipListScrollArea = {
				blockoverride "section_content" {
					TooltipTextBlock = {
						textcontext = "HRE_CIRCLE_SATISFACTION_TT_VALUE"
					}

					TooltipTextBlock = {
						textcontext = "HRE_CIRCLE_SATISFACTION_TT_IMPACT"
					}

					TooltipStringPairList = {
						visible = "[Not( StringIsEmpty( ImperialCircleItem.GetCircleLeaderModifierText ) )]"
						textcontext = "[ImperialCircleItem.GetCircleLeaderModifierText]"
					}
				}
			}
		}
	}
}
