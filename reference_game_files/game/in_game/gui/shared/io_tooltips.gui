                    alpha = 0.3
                }
            }
        }

        blockoverride "title_text" {
            text = "IO_VOTES_FOR_CANDIDATE"
        }

        blockoverride "concept_link" {
            text = "[vote|e]"
        }

        blockoverride "tooltip_content" {
            TooltipStringPairList = {
                datacontext = "[StringToStringPairList(LeaderCandidate.GetVotedCountries)]"
            }
        }
    }
}

