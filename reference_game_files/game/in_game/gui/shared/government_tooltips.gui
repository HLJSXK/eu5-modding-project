				textcontext = "[EstatePrivilege.GetRevokeDescription]"
			}

			TooltipBlockList = {
				name = "Description_2"
				visible = "[And(Not(StringIsEmpty(UIAction.GetDescription)), UIAction.IsEnabled)]"
