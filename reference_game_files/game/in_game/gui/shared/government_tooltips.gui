				blockoverride "block_title" {
					text = "[modifiers|e]"
				}
				visible = "[Not(StringIsEmpty(EstatePrivilege.GetPrunedModifiers))]"
				textcontext = "[EstatePrivilege.GetPrunedModifiers]"
			}

			TooltipBlockList = {
				blockoverride "block_title" {
					text = "WHEN_IMPLEMENTED"
