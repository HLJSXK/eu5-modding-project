			}

			TooltipRowList = {
				visible = "[And3(IsPlayerValid, Not(Country.IsLocalPlayer), Not(StringIsEmpty(Country.GetObjectivesDisplayText)))]"
				lowpriotextcontext = "[Country.GetObjectivesDisplayText]"
			}
		}
	}
}

template disposition_pair_tooltip {
	ContextualTooltipType = {
		blockoverride "concept_link" {
			text = "[country_disposition|e]"
		}

		blockoverride "title_text" {
			text = "[DispositionPairWrap.GetTitle]"
		}

		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 420 } }
				lowpriotextcontext = "[DispositionPairWrap.GetTooltip]"
			}
		}
	}
}

template notable_disposition_tooltip {
	ContextualTooltipType = {
		blockoverride "concept_link" {
			text = "[country_disposition|e]"
		}

		blockoverride "title_icon_texture" {
			texture = "[QuickNotableDispositions.GetDispositionIcon(Country.Self)]"
		}

		blockoverride "title_text" {
			text = "[QuickNotableDispositions.GetTitle(Country.Self)]"
		}

		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 420 } }
				textcontext = "[QuickNotableDispositions.GetTooltip(Country.Self)]"
			}
		}
	}
}

