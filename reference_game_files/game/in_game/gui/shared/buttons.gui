	type anim_button_1 = widget {
		size = { 240 100 }

		button = {
			parentanchor = center
			widgetanchor = center
			using = button_regular_diamond_texture
			using = button_common_template
			fontsize = 13
			size = { 200 40 }

			alwaystransparent = no
			onmousehierarchyenter = "[PdxGuiInterruptThenTriggerAllAnimations('anim_button_1_rest', 'anim_button_1_hover')]"
			onmousehierarchyleave = "[PdxGuiInterruptThenTriggerAllAnimations('anim_button_1_hover', 'anim_button_1_rest')]"
			onclick = "[PdxGuiTriggerAllAnimations('anim_button_1_click')]"

			block "anim_button_1_text" {}

			state = {
				name = anim_button_1_hover
				duration = 0.195
				scale = 1.08
				using = Animation_Curve_Default
			}
			state = {
				name = anim_button_1_rest
				duration = 0.195
				scale = 1
				using = Animation_Curve_Default
			}
			state = {
				name = anim_button_1_click
				duration = 0.104
				scale = 1.112
				next = anim_button_1_click_return
				using = Animation_Curve_Default
			}
			state = {
				name = anim_button_1_click_return
				duration = 0.234
				scale = 1.08
				using = Animation_Curve_Default
			}

			background = {
				using = button_regular_diamond_shadow_texture
				margin = {1 0}
				margin_bottom = 3
			}

			icon = {
				name = "anim_button_1_side_left"
