				mirror = horizontal

				state = {
					name = anim_button_1_hover
					duration = 0.195
					position_x = -8
					scale = 1.16
					using = Animation_Curve_Default
				}
				state = {
					name = anim_button_1_rest
					duration = 0.195
					position_x = 0
					scale = 1
					using = Animation_Curve_Default
				}
				state = {
					name = anim_button_1_click
					duration = 0.104
					scale = 1.24
					next = anim_button_1_click_return
					using = Animation_Curve_Default
				}
				state = {
					name = anim_button_1_click_return
					duration = 0.234
					scale = 1.16
					using = Animation_Curve_Default
				}
			}

			icon = {
				name = "anim_button_1_side_right"
