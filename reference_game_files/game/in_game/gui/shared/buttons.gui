### TEMPLATES ###

template button_tab_toggle_properties_template {
	gfxtype = togglepushbuttongfx
	effectname = "NoHighlight"

	upframe = 1
	uphoverframe = 2
	uppressedframe = 3
	downframe = 2
	downhoverframe = 2
	downpressedframe = 3
	disableframe = 4
}

template button_down_toggle_properties_template
{
	gfxtype = togglepushbuttongfx
	effectname = "NoHighlight"
	
	upframe = 1
	uphoverframe = 2
	uppressedframe = 3
	downframe = 3
	downhoverframe = 3
	downpressedframe = 3
	disableframe = 4
}

template button_regular_icon_color {
	using = color_new_gold
	modify_texture = {
		using = mask_scratches_texture
		alpha = 0.1
	}

	modify_texture = {
		using = overlay_stone_texture
		blend_mode = alphamultiply
		alpha = 0.2
	}
}

template targetted_action_button_regular {
	block "button_texture" {
		using = button_regular_texture
	}
	using = button_common_textobj_template
	block "tooltip" {
		tooltipwidget = { using = action_tooltip_pop_out }
	}
}

template targetted_header_action_button_regular {
	block "button_texture" {
		using = header_button_texture
	}
	using = button_common_textobj_template
	block "tooltip" {
		tooltipwidget = { using = action_tooltip_pop_out }
	}
}

template targetted_action_button_default {
	size = { 120 30 }
	alpha = 0.9
	default_format = "#color_white"
	tooltipwidget = { using = action_tooltip_pop_out }

	block  "texture"
	{
		texture = "gfx/interface/buttons/button_default.dds"
		texture_density = 2
		spriteType = corneredtiled
		spriteborder = { 30 30 }
		framesize = { 126 40 }
	}
}

template button_notification_template {
	texture = "gfx/interface/buttons/notification_alert.dds"
	texture_density = 2
	frame_grid = { 2 1 }
	size = { 30 30 }
}

template button_visibility_template {
	texture = "gfx/interface/buttons/checkbox_visibility.dds"
	texture_density = 2
	frame_grid = { 2 1 }
	size = { 30 30 }

	blockoverride "master_color_frame" {
		frame = 1
	}
}

template checkbox_round_texture {
	texture = "gfx/interface/buttons/checkbox_round.dds"
	texture_density = 2
	framesize = { 40 40 }

	using = Master_Button_Modify_Texture
	blockoverride "master_color_frame" {
		frame = 1
	}

	background = {
		texture = "gfx/interface/buttons/checkbox_round_bg.dds"
		texture_density = 2
		using = color_dark_blue
		shaderfile = "gfx/FX/pdxgui_default.shader"
	}
}

template button_checkbox_template_alt {
	block "color" {
		texture = "gfx/interface/buttons/checkbox_alt.dds"
	}

	texture_density = 2
	framesize = { 40 40 }
	size = { 30 30 }

	background = {
		texture = "gfx/interface/buttons/checkbox_bg.dds"
		texture_density = 2
		using = color_dark_blue
		margin = { 3 3 }
		shaderfile = "gfx/FX/pdxgui_default.shader"
	}
}

template button_checkbox_square_template_alt {
	block "color" {
		texture = "gfx/interface/buttons/checkbox_small_square.dds"
	}

	texture_density = 2
	framesize = { 40 40 }
	size = { 30 30 }
	block "color_checkbox_background" {
		background = {
			texture = "gfx/interface/buttons/checkbox_small_square_bg.dds"
			texture_density = 2
			using = color_dark_blue
			margin = { 3 3 }
			shaderfile = "gfx/FX/pdxgui_default.shader"
		}
	}
}

template checkbox_round_alt_template {
	texture = "gfx/interface/buttons/checkbox_round.dds"
	texture_density = 2
	frame_grid = { 2 1 }
	size = { 30 30 }

	using = overlay_stone
	using = snd_UI_checkbutton_round

	block "checkbox_round_alt_color" {
		modify_texture = {
			using = color_new_gold_texture
		}
	}

	background = {
		texture = "gfx/interface/buttons/checkbox_bg_round.dds"
		texture_density = 2
		using = color_dark_blue
	}
}

template button_action_base {
	visible = "[UIAction.IsVisible]"
	enabled = "[UIAction.IsEnabled]"
}

template button_action {
	using = button_action_base
	tooltipwidget = { using = action_tooltip_pop_out }
}

template button_action_provider_base {
	visible = "[UIActionProvider.IsVisible]"
	enabled = "[UIActionProvider.IsEnabled]"

	button_tooltip_override = {
		title = "[UIActionProvider.GetTitle]"
		description = "[UIActionProvider.GetDescription]"
		acceptance = "[UIActionProvider.GetAcceptance]"
		conditions = "[UIActionProvider.GetConditions]"
		effects = "[UIActionProvider.GetEffects]"
	}

	action_tooltip = {
		click_type = left
		click_mode = single
		visible = "[UIActionProvider.IsLeftClickVisible]"
		enabled = "[UIActionProvider.IsLeftClickEnabled]"
		title = "[UIActionProvider.GetLeftClickTitle]"
		cost = "[UIActionProvider.GetLeftClickCost]"
		description = "[UIActionProvider.GetLeftClickDescription]"
		acceptance = "[UIActionProvider.GetLeftClickAcceptance]"
		conditions = "[UIActionProvider.GetLeftClickConditions]"
		on_action_with_params = "[UIActionProvider.OnLeftClick]"
	}

	action_tooltip = {
		click_type = left
		click_mode = confirm
		visible = "[UIActionProvider.IsLeftClickAndConfirmVisible]"
		enabled = "[UIActionProvider.IsLeftClickAndConfirmEnabled]"
		title = "[UIActionProvider.GetLeftClickAndConfirmTitle]"
		cost = "[UIActionProvider.GetLeftClickAndConfirmCost]"
		description = "[UIActionProvider.GetLeftClickAndConfirmDescription]"
		acceptance = "[UIActionProvider.GetLeftClickAndConfirmAcceptance]"
		confirmation = "[UIActionProvider.GetConfirmation]"
		conditions = "[UIActionProvider.GetLeftClickAndConfirmConditions]"
		on_action_with_params = "[UIActionProvider.OnLeftClickAndConfirm]"
		block "left_confirm_tooltip_setup" {}
	}

	action_tooltip = {
		click_type = right
		click_mode = single
		visible = "[UIActionProvider.IsRightClickVisible]"
		enabled = "[UIActionProvider.IsRightClickEnabled]"
		title = "[UIActionProvider.GetRightClickTitle]"
		cost = "[UIActionProvider.GetRightClickCost]"
		description = "[UIActionProvider.GetRightClickDescription]"
		acceptance = "[UIActionProvider.GetRightClickAcceptance]"
		conditions = "[UIActionProvider.GetRightClickConditions]"
		on_action_with_params = "[UIActionProvider.OnRightClick]"
	}

	block "right_confirm_tooltip" {
		action_tooltip = {
			click_type = right
			click_mode = confirm
			visible = "[UIActionProvider.IsRightClickAndConfirmVisible]"
			enabled = "[UIActionProvider.IsRightClickAndConfirmEnabled]"
			title = "[UIActionProvider.GetRightClickAndConfirmTitle]"
			cost = "[UIActionProvider.GetRightClickAndConfirmCost]"
			description = "[UIActionProvider.GetRightClickAndConfirmDescription]"
			acceptance = "[UIActionProvider.GetRightClickAndConfirmAcceptance]"
			conditions = "[UIActionProvider.GetRightClickAndConfirmConditions]"
			on_action_with_params = "[UIActionProvider.OnRightClickAndConfirm]"
		}
	}
}

template button_action_provider {
	using = button_action_provider_base
	block "button_action_provider_tooltipwidget" { tooltipwidget = { using = action_tooltip_pop_out } }
}

template filter_button_round {
	texture = "gfx/interface/buttons/flats/close_button_alt.dds"
	texture_density = 2

	using = bg_button_round_dark_blue

	using = ui_direction_button_overlay

	block "functional_tooltip" {}
}

template market_filter_button {
	using = filter_button_round
	size = { 23 23 }
}

template country_filter_button {
	using = filter_button_round
	size = { 19 19 }
}

template button_regular_diamond_texture {
	block "button_regular_diamond_texture" {
		texture = "gfx/interface/buttons/button_diamond.dds"
	}
	texture_density = 2
	alpha = 1
	spriteType = corneredstretched
	spriteborder = { 14 0 }
	frame_grid = {4 1}

	modify_texture = {
		using = overlay_stone_texture
		blend_mode = overlay
		alpha = 0.5
	}
}

template button_event_special_diamond_texture {
	texture = "gfx/interface/buttons/button_event_special_diamond.dds"
	texture_density = 2
	alpha = 1
	spriteType = corneredstretched
	spriteborder = { 14 0 }
	frame_grid = {4 1}

	modify_texture = {
		using = overlay_stone_texture
		blend_mode = overlay
		alpha = 0.5
	}
}

template button_regular_diamond_shadow_texture {
	texture = "gfx/interface/buttons/diamond_button_shadow.dds"
	texture_density = 2
	alpha = 0.5
	spriteType = corneredstretched
	spriteborder = { 14 0 }

	modify_texture = {
		using = color_black_texture
	}
}

template gc_action_banner_button_properties {
	gfxtype = framedbuttongfx
	texture_density = 2
	spriteType = corneredstretched
	spriteborder = { 40 0 }
	frame_grid = { 1 1 }
	upframe = 1
	overframe = 1
	downframe = 1
	disableframe = 1
}

types Buttons
{

	type button_inner_tab = button {
		size = { 50 16 }
		texture = "gfx/interface/buttons/inner_tab_fade.dds"
		spriteType = stretched
		spriteborder = { 0 0 }
		framesize = { 50 50 }
		texture_density = 2

		default_format = "#color_white"

		gfxtype = togglepushbuttongfx
		effectname = "NoHighlight"

		upframe = 1
		uphoverframe = 3
		uppressedframe = 3
		downframe = 2
		downhoverframe = 2
		downpressedframe = 3
		disableframe = 4
	}

	type progress_arrow_flavor = button {
		size = { 20 20 }
		texture = "gfx/interface/icons/government_society/progress_arrow_flavor.dds"
		spriteType = stretched
		spriteborder = { 0 0 }
		framesize = { 32 32 }
		texture_density = 2

		gfxtype = togglepushbuttongfx
		effectname = "NoHighlight"
		tooltip_enabled = no

		upframe = 1
		uphoverframe = 1
		uppressedframe = 1
		downframe = 2
		downhoverframe = 2
		downpressedframe = 2
		disableframe = 1
	}

	type button_main_tab = button {
		size = { 50 16 }
		texture = "gfx/interface/buttons/inner_tab_fade_vertical.dds"
		spriteType = stretched
		spriteborder = { 0 0 }
		framesize = { 50 50 }
		texture_density = 2
		alpha = 1

		buttonText = {
			textbox = {
				size = { 100% 100% }
				using = Font_Type_Headers
				using = Font_Size_Medium
				elide = right
				fontsize_min = 10

				default_format = "#high"

				align = center|nobaseline
				margin = { 10 0 }
			}
		}

		gfxtype = togglepushbuttongfx
		effectname = "NoHighlight"

		upframe = 1
		uphoverframe = 3
		uppressedframe = 3
		downframe = 2
		downhoverframe = 2
		downpressedframe = 3
		disableframe = 4
	}

	type button_round_shortcut = ui_direction_button_alt {
		block "button_texture" {}

		using = bg_button_round_dark_blue

		tooltipwidget = { BasicFunctionalTooltip = {} }
	}

	type button_minimize = ui_direction_button_alt {
		block "button_texture" {
			using = min_button_alt_texture
		}

		using = bg_button_round_dark_blue

		tooltipwidget = { BasicFunctionalTooltip = {} }
		using = snd_UI_backward
	}

	type button_automation_shortcut = ui_direction_button_alt {
		block "button_texture" {
			using = automation_cog_button_texture
		}

		using = bg_button_round_dark_blue

		tooltipwidget = { BasicFunctionalTooltip = {} }
	}

	type button_back_alt = ui_direction_button_alt {
		block "button_texture" {
			using = back_button_alt_texture
		}

		using = bg_button_round_dark_blue

		block "back_properties" {
			parentanchor = vcenter|left
		}

		block "back_onclick" {
			action_tooltip = {
				click_type = left
				title = "BACK"
				enabled = "[LateralView.CanGoBack]"
				on_action = "[LateralView.GoBack]"
			}

			action_tooltip = {
				visible = "[Not(LateralView.IsFullscreen)]"
				click_type = right
				title = "SHOW_HISTORY"
				on_action = "[LateralView.ToggleSelectLateralViewHistory(PdxGuiWidget.Self)]"
			}

			action_tooltip = {
				visible = "[LateralView.IsFullscreen]"
				click_type = right
				title = "SHOW_HISTORY"
				on_action = "[PdxGuiWidget.ToggleContextMenu]"
			}

			input_action = "[Select_CString(LateralView.IsLeftPanel,'previous_window_left', 'previous_window_right')]"
		}

		tooltipwidget = {
			BasicFunctionalTooltip = {}
		}

		contextmenu_widget = {
			ContextMenuBase = {
				blockoverride "contextmenu_content" {
					using = select_lateralview_history_content
				}
			}
		}

		using = snd_UI_backward
	}

	type button_back = ui_direction_button {
		block "button_texture" {
			texture = "gfx/interface/buttons/flats/back_button.dds"
			texture_density = 2
		}
		block "back_properties" {
			layoutpolicy_horizontal = expanding
			parentanchor = left|top
			position = { -5 -6 }
			size = { 23 23 }
		}

		block "back_onclick" {
			action_tooltip = {
				click_type = left
				title = "BACK"
				enabled = "[LateralView.CanGoBack]"
				on_action = "[LateralView.GoBack]"
			}

			action_tooltip = {
				click_type = right
				title = "SHOW_HISTORY"
				on_action = "[LateralView.ToggleSelectLateralViewHistory(PdxGuiWidget.Self)]"
			}
		}

		tooltipwidget = {
			BasicFunctionalTooltip = {}
		}

		using = bg_circle
		using = snd_UI_backward
	}

	type button_list = button_icon {
		size = { 22 22 }
		texture = "gfx/interface/buttons/flats/list_button.dds"
		texture_density = 2

		using = bg_circle
		using = snd_UI_open

		using = overlay_texture_overlay
	}

	type button_goto = button_icon {
		size = { 22 22 }
		texture = "gfx/interface/buttons/flats/goto_button.dds"
		texture_density = 2

		using = bg_circle
		using = snd_UI_goto

		using = overlay_texture_overlay
	}

	### MAIN BUTTONS ###

	type button_regular_diamond = button {
		block "button_regular_diamond_texture" {
			using = button_regular_diamond_texture
		}
		using = button_common_template
		fontsize = 13
		size = { -1 30 }
		background = {
			margin = {1 0}
			margin_top = 0
			margin_bottom = 3
			using = button_regular_diamond_shadow_texture
		}
	}

	type button_regular_icon = button {
		using = button_regular_texture
		using = button_common_properties_template
		fontsize = 13
		size = { -1 30 }

		widget = {
			size = { 100% 100% }
			parentanchor = center
			hbox = {
				margin = { 10 0 }
				spacing = 3

				block "pre_content_extra" {
					set_parent_size_to_minimum = yes
				}

				block "button_icon_obj" {
					icon = {
						block "button_icon" {
							visible = no
						}

						using = button_regular_icon_color
					}
				}

				textbox = {
					using = button_common_textobj_font
					autoresize = yes
					align = center|nobaseline
					fontsize = 13

					block "button_text_properties" {
						default_format = "#color_white"
					}

					block "button_text" {
						visible = no
					}
				}

			}
			block "widget_extra" {}
		}

		background = {
			using = button_regular_shadow_texture
			margin = {1 0}
			margin_bottom = 3
		}
	}

	type targetted_button_default = button {
		using = targetted_action_button_default
	}

	type targetted_button_regular = button {
		using = targetted_action_button_regular
	}
	type targetted_header_button_regular = button {
		using = targetted_header_action_button_regular
	}

	type button_advances_tree = button {
		gfxtype = framedbuttongfx
		effectname = "NoHighlight"
		upframe = 1
		overframe = 2
		downframe = 3
		disableframe = 4
		texture = "gfx/interface/buttons/advances_buttons_frame.dds"
		frame_grid = {4 1}

		using = button_common_textobj_template
	}

	type button_advances_inprogress_tree = button {
		gfxtype = framedbuttongfx
		effectname = "NoHighlight"
		upframe = 1
		overframe = 2
		downframe = 3
		disableframe = 4
		texture = "gfx/interface/buttons/advances_buttons_inprogress_frame.dds"
		frame_grid = {4 1}

		using = button_common_textobj_template
	}

	type advances_card_button = button {
		gfxtype = framedbuttongfx
		effectname = "NoHighlight"
		upframe = 1
		overframe = 2
		downframe = 3
		disableframe = 3
		texture = "gfx/interface/buttons/advance_card_button.dds"
		frame_grid = {3 1}
		spriteType = Corneredstretched
		spriteborder = { 27 27 }

		using = button_common_textobj_template
	}

	type mission_task_card_button = button {
		gfxtype = framedbuttongfx
		effectname = "NoHighlight"
		upframe = 1
		overframe = 2
		downframe = 3
		disableframe = 4
		
		using = button_mission_square_frame_texture
		blockoverride "button_mission_square_frame_texture_extra"{
			modify_texture = {
				using = color_gold_texture
				alpha = 0.3
			}
		}

		using = button_common_textobj_template
	}

	type button_messages = button {
		texture = "gfx/interface/buttons/paper_messages_button.dds"
		texture_density = 2
		mirror = horizontal
		spriteType = corneredstretched
		spriteborder = { 20 20 }
		framesize = { 55 40 }

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.1
		}

		block "messages_bg" {}

		using = button_common_template
	}

	#####################################################

	type icon_button_small_round = button {
		gfxtype = framedbuttongfx
		effectname = "NoHighlight"
		upframe = 1
		overframe = 2
		downframe = 3
		disableframe = 4
		texture = "gfx/interface/buttons/button_small_round.dds"
		framesize = { 42 42 }
	}

