				}
			}

			masked_icon = {
				parentanchor = center
				widgetanchor = center
				size = { 100% 100% }
				texture = "gfx/interface/buttons/base_test.dds"
				mask = "gfx/interface/buttons/base_test.dds"
				alpha = 0

				state = {
					name = decisions_button_anim_rest
					duration = 0.1
					alpha = 0
					using = Animation_Curve_Default
				}
				state = {
					name = decisions_button_anim_hover
					duration = 0.1
					alpha = 1
					using = Animation_Curve_Default
				}

				masked_icon = {
					parentanchor = vcenter|left
					widgetanchor = vcenter|left
					size = { 50 50 }
					position = { 0 0 }
					texture = "gfx/interface/buttons/shadow_test.dds"
					inherit_mask = yes

					state = {
						name = decisions_button_anim_rest
						duration = 0.1
						position_x = -50
						using = Animation_Curve_Default
					}
					state = {
						name = decisions_button_anim_hover
						duration = 0.8
						position_x = 280
						next = decisions_button_anim_loop_reset
						using = Animation_Curve_Default
					}
					state = {
						name = decisions_button_anim_loop_reset
						position_x = -50
						next = decisions_button_anim_hover
					}
				}
			}
		}
	}

	type decision_button_anim = widget {
		block "decision_button_anim_size" {
			size = { 280 40 }
		}

		masked_button = {
			using = button_common_template
			blockoverride "button_push_properties" {
				gfxtype = maskedbuttongfx
			}
			parentanchor = vcenter|left
			widgetanchor = vcenter|left
			fontsize = 13
			size = { 100% 100% }
			mask = "gfx/interface/buttons/button_banner_01_anim_mask.dds"
			spriteType = corneredstretched
			spriteborder = { 30 0 }
			alwaystransparent = no
			onmousehierarchyenter = "[PdxGuiWidget.InterruptThenTriggerAnimation('decision_button_anim_rest', 'decision_button_anim_hover')]"
			onmousehierarchyenter = "[PdxGuiWidget.TriggerAllChildrenAnimation('decision_button_anim_hover')]"
			onmousehierarchyleave = "[PdxGuiWidget.InterruptThenTriggerAnimation('decision_button_anim_hover', 'decision_button_anim_rest')]"
			onmousehierarchyleave = "[PdxGuiWidget.TriggerAllChildrenAnimation('decision_button_anim_rest')]"

			block "decision_button_anim_button_props" {}

			block "decision_button_anim_text" {}

			state = {
				name = decision_button_anim_rest
				duration = 0.15
				scale = 1
				using = Animation_Curve_Default
			}
			state = {
				name = decision_button_anim_hover
