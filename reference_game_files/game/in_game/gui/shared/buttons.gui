	type law_card_header_button = button {
		size = { 97% 44 }
		using = color_black_texture
		texture_density = 2
		spriteType = corneredstretched
		spriteBorder = { 40 0 }
		block "law_header_button_color" {
			modify_texture = {
				texture = "[GetLawBgCategoryColor(Law.Self)]"
				blend_mode = add
				alpha = 0.7
			}
			modify_texture = {
				texture = "gfx/interface/component_overlay/cloth_texture.dds"
				texture_density = 2
				spriteType = Corneredtiled
				spriteborder = { 0 0 }
				blend_mode = overlay
				alpha = 0.9
			}
		}
		
		button = {
			size = { 100% 100% }
			parentanchor = bottom|hcenter
			texture = "gfx/interface/cards/laws/golden_frame_card.dds"
			spriteType = corneredstretched
			spriteborder = { 5 5 }
			texture_density = 2

			block "law_header_button_properties" {}
		}

		block "law_header_button_properties" {}
		block "law_header_button_content" {}
	}

	type law_card_header = widget {
		size = { 100% 60 }
		background = {
			texture = "gfx/interface/cards/laws/header_container.dds"
			texture_density = 2
			spriteType = corneredstretched
			spriteBorder = { 40 20 }
		}
		law_card_header_button = {
			size = { 97% 44 }
			parentanchor = bottom|hcenter
			position = { 0 -4 }
		}
	}

