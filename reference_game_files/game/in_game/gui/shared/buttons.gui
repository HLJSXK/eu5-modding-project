	type decisions_button_anim2 = widget {
		size = { 280 40 }

		masked_button = {
			size = { 100% 100% }
			gfxtype = maskedbuttongfx
			texture = "gfx/interface/buttons/decisions/decisions_button.dds"
			frame_grid = { 4 1 }
			upframe = 1
			overframe = 2
			downframe = 3
			disableframe = 4
			spriteType = corneredstretched
			spriteborder = { 30 0 }
			mask = "gfx/interface/buttons/decisions/decisions_button_mask.dds"
			texture_density = 2

			modify_texture = {
				using = color_dark_brown_texture
			}

			state = {
				name = _mouse_enter
				on_start = "[PdxGuiWidget.TriggerAllChildrenAnimation('hover')]"
			}

			state = {
				name = _mouse_leave
				on_start = "[PdxGuiWidget.TriggerAllChildrenAnimation('up')]"
			}

			widget = {
				position = { 0 0 }
				parentanchor = left|vcenter
				size = { 0 0 }
				
				state = {
					name = up
					duration = 0.45
					position = { 0 0 }
					using = Animation_Curve_Default
				}

				state = {
					name = hover
					duration = 0.45
					position = { 400 0 }
					using = Animation_Curve_Default
				}
				masked_icon = {
					size = { 40 40 }
					parentanchor = center
					alwaystransparent = yes
					inherit_mask = yes
					alpha = 0.5

					texture = "gfx/interface/buttons/decisions/decisions_button_fold.dds"
