template DHEEvent_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[DHEEventEntry.GetTitle]"
		}

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size

				texture = "[GetAgeIcon(DHEEventEntry.GetAge)]"
				datacontext = "[DHEEventEntry.GetAge]"
				tooltipwidget = {
					using = Age_tooltip
				}
			}
		}
		
		blockoverride "concept_link" {
			text = [dynamic_historical_event|e]
		}

		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[DHEEventEntry.GetDebugInfo]"
				}
			}

			TooltipListBase = {
				blockoverride "block_title" {
					text = "LIST_TITLE_CHRONOLOGY"
				}

				TooltipManualTableField = {
					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						raw_text = "[DHEEventEntry.GetDateRange]"
					}
					text_single = {
						autoresize = yes
						text = "DHE_MONTHLY_CHANCE"
					}
				}
			}

			TooltipListBase = {
				TooltipManualTableField = {
					background = {
						visible = "[IsEven_int32(PdxGuiWidget.GetIndexInParent)]"
						using = color_new_gold_texture
						alpha = 0.2
					}
			
					background = {
						visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInParent)]"
						using = color_gold_texture
						alpha = 0.3
					}

					icon = {
						size = { 25 25 }
						texture = "gfx/interface/icons/text_icons/dhe_status_has_happened.dds"
						visible = "[DHEEventEntry.IsStatusHasHappened]"
					}
					icon = {
						size = { 25 25 }
						texture = "gfx/interface/icons/text_icons/dhe_status_has_not_happened_yet.dds"
						visible = "[DHEEventEntry.IsStatusNotYet]"
					}
					icon = {
						size = { 25 25 }
						texture = "gfx/interface/icons/text_icons/dhe_status_time_has_passed.dds"
						visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "[DHEEventEntry.GetStatusLabel]"
					}
				}
			}
			
			TooltipScrolledRequirementsList = {
				textcontext = "[DHEEventEntry.GetTrigger]"

				blockoverride "block_title" {
					text = "[SelectLocalization(Or(DHEEventEntry.IsTriggerTrue, Not(DHEEventEntry.HasTrigger)), 'REQUIREMENT_ARE_MET', 'REQUIREMENT_ARE_NOT_MET')]"

					background = {
						visible = "[Or(DHEEventEntry.IsTriggerTrue, Not(DHEEventEntry.HasTrigger))]"
						using = color_mid_light_green_texture
						alpha = 0.9
					}

					background = {
						visible = "[And(Not(DHEEventEntry.IsTriggerTrue), DHEEventEntry.HasTrigger)]"
						using = color_mid_red_texture
						alpha = 0.7
					}
				}

				blockoverride "block_scrollarea" { maximumsize = { -1 450 }}
			}

			TooltipRowList = {
				textcontext = "[DHEEventEntry.GetEffects]"

				tooltipmeta = {
					texture = "[GetConceptTexture('event_option')]"
					game_concept = "[event_option|e]"
				}

				blockoverride "block_title" {
					text = "EVENT_POSSIBLE_OPTIONS"
				}
			}

			TooltipFlavorTextBlock = {
				visible = "[DHEEventEntry.HasHistoricalInfo]"
				blockoverride "text" {
					text = "[DHEEventEntry.GetHistoricalInfo]"
				}
			}
		}
	}
}
