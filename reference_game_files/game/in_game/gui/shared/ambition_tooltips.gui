
template Ambition_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[Ambition.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = [ambition|E]
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetAmbitionDefinitionIcon(Ambition.GetAmbitionDefinition)]"
			}
		}

		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[Ambition.GetDebugText]"
				}
			}

			TooltipTextBlock = {
				blockoverride "text" {
					text = "[GetAmbitionRankName(Ambition.GetAmbitionDefinition)]"
				}
			}

			TooltipRequirementsList = {
				blockoverride "block_title" {
					text = "AMBITION_TT_COMPLETION_CRITERIA"
				}
				visible = "[Not(StringIsEmpty(Ambition.GetCompletionCriteria))]"
				textcontext = "[Ambition.GetCompletionCriteria]"
			}

			TooltipTextBlock = {
				blockoverride "block_title" {
					text = "AMBITION_TT_END_DATE"
				}
				visible = "[Not(StringIsEmpty(Ambition.GetEndDateText))]"
				textcontext = "[Ambition.GetEndDateText]"
			}

			TooltipTextBlock = {
				blockoverride "block_title" {
					text = "AMBITION_TT_ONGOING_MODIFIERS"
				}
				visible = "[Not(StringIsEmpty(Ambition.GetOngoingModifierSummary))]"
				textcontext = "[Ambition.GetOngoingModifierSummary]"
			}

			TooltipTextBlock = {
				blockoverride "block_title" {
					text = "AMBITION_TT_REWARD_MODIFIERS"
				}
				visible = "[Not(StringIsEmpty(Ambition.GetCompleteModifierSummary))]"
				textcontext = "[Ambition.GetCompleteModifierSummary]"
			}

			TooltipRowList = {
				ontextcontextchanged = "[SetRowListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				blockoverride "block_title" {
					text = "AMBITION_TT_REWARDS"
				}
				visible = "[Not(StringIsEmpty(Ambition.GetRewardEffectText))]"
				textcontext = "[Ambition.GetRewardEffectText]"
			}

			TooltipRowList = {
				ontextcontextchanged = "[SetRowListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				blockoverride "block_title" {
					text = "AMBITION_TT_ON_FAILURE"
				}
				visible = "[Not(StringIsEmpty(Ambition.GetFailureEffectText))]"
				textcontext = "[Ambition.GetFailureEffectText]"
			}

			TooltipFlavorTextBlock = {
				visible = "[Not(StringIsEmpty(Ambition.GetAmbitionDefinition.GetDesc))]"
				blockoverride "text" {
					text = "[Ambition.GetAmbitionDefinition.GetDesc]"
				}
			}
		}
	}
}

template AmbitionDefinition_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[AmbitionDefinition.GetNameWithNoTooltip]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetAmbitionDefinitionIcon(AmbitionDefinition.Self)]"
			}
		}

		blockoverride "concept_link" {
			text = [ambition_definition|E]
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[GetAmbitionRankName(AmbitionDefinition.Self)]"
				}
			}

			TooltipRequirementsList = {
				blockoverride "block_title" {
					text = "AMBITION_POTENTIAL_TOOLTIP_HEADING"
				}
				visible = "[And(AmbitionDefinition.HasEnabledTooltip, Not(StringIsEmpty(AmbitionDefinition.GetEnabledTooltip)))]"
				textcontext = "[AmbitionDefinition.GetEnabledTooltip]"
			}

			TooltipRequirementsList = {
				blockoverride "block_title" {
					text = "AMBITION_TT_COMPLETION_CRITERIA"
				}
				visible = "[Not(StringIsEmpty(GetAmbitionGoalRequirements(AmbitionDefinition.Self)))]"
				textcontext = "[GetAmbitionGoalRequirements(AmbitionDefinition.Self)]"
			}

			TooltipTextBlock = {
				blockoverride "block_title" {
					text = "AMBITION_TT_ONGOING_MODIFIERS"
				}
				visible = "[Not(StringIsEmpty(GetAmbitionOngoingModifiers(AmbitionDefinition.Self)))]"
				textcontext = "[GetAmbitionOngoingModifiers(AmbitionDefinition.Self)]"
			}

			TooltipTextBlock = {
				blockoverride "block_title" {
					text = "AMBITION_TT_REWARD_MODIFIERS"
				}
				visible = "[Not(StringIsEmpty(GetAmbitionCompleteModifiers(AmbitionDefinition.Self)))]"
				textcontext = "[GetAmbitionCompleteModifiers(AmbitionDefinition.Self)]"
			}

			TooltipRowList = {
				ontextcontextchanged = "[SetRowListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				blockoverride "block_title" {
					text = "AMBITION_TT_REWARDS"
				}
				visible = "[Not(StringIsEmpty(GetAmbitionRewardEffect(AmbitionDefinition.Self)))]"
				textcontext = "[GetAmbitionRewardEffect(AmbitionDefinition.Self)]"
			}

			TooltipRowList = {
				ontextcontextchanged = "[SetRowListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				blockoverride "block_title" {
					text = "AMBITION_TT_ON_FAILURE"
				}
				visible = "[Not(StringIsEmpty(GetAmbitionFailureEffect(AmbitionDefinition.Self)))]"
				textcontext = "[GetAmbitionFailureEffect(AmbitionDefinition.Self)]"
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[AmbitionDefinition.GetDesc]"
				}
			}
		}
	}
}

template AmbitionModifier_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[AmbitionModifierWrap.GetIcon]"
			}
		}

		blockoverride "title_text" {
			text = "[AmbitionModifierWrap.GetName]"
		}

		blockoverride "concept_link" {
			text = "[ambition_modifier|e]"
		}
		
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				datacontext = "[StringToStringPairList(AmbitionModifierWrap.GetTooltip)]"
			}
		}
	}
}