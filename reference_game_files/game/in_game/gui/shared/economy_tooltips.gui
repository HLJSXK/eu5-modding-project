template CreditworthinessTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('creditworthiness')]"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "creditworthiness"
		}

		blockoverride "concept_link" {
			text = "[creditworthiness|e]"
		}

		blockoverride "tooltip_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				### Base Rating
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { -1 22 }
					tooltipwidget = { using = CreditworthinessBaseRatingHoverTooltip }
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 4 0 }
						text_single = {
							autoresize = yes
							text = "CREDITWORTHINESS_RATING_LABEL"
							default_format = "#explanation_link"
							align = left|nobaseline
						}
						expand = {}
						text_single = {
							autoresize = yes
							raw_text = "[Country.GetCreditworthinessBaseRating|0Y]"
							align = right|nobaseline
						}
					}
				}

				### Equilibrium Target
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { -1 22 }
					tooltipwidget = { using = CreditworthinessTargetHoverTooltip }
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 4 0 }
						text_single = {
							autoresize = yes
							text = "CREDITWORTHINESS_TARGET_LABEL"
							default_format = "#explanation_link"
							align = left|nobaseline
						}
						expand = {}
						text_single = {
							autoresize = yes
							raw_text = "[Country.GetCreditworthinessTarget|0Y]"
							align = right|nobaseline
						}
					}
				}

				### Monthly Pull
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { -1 22 }
					tooltipwidget = { using = CreditworthinessMonthlyPullHoverTooltip }
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 4 0 }
						text_single = {
							autoresize = yes
							text = "CREDITWORTHINESS_MONTHLY_CHANGE_LABEL"
							default_format = "#explanation_link"
							align = left|nobaseline
						}
						expand = {}
						text_single = {
							autoresize = yes
							raw_text = "[Country.GetCreditworthinessMonthlyPull|2+=]"
							align = right|nobaseline
						}
					}
				}

				### Bankruptcy Penalty (only visible when active)
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { -1 22 }
					visible = "[Country.IsBankruptcyDrainActive]"
					tooltipwidget = { using = CreditworthinessBankruptcyDrainHoverTooltip }
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 4 0 }
						text_single = {
							autoresize = yes
							text = "CREDITWORTHINESS_DRAIN_LABEL"
							default_format = "#explanation_link"
							align = left|nobaseline
						}
						expand = {}
						text_single = {
							autoresize = yes
							raw_text = "[Country.GetCreditworthinessBankruptcyDrain|0R]"
							align = right|nobaseline
						}
					}
				}

				### Effective Rating
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { -1 22 }
					tooltipwidget = { using = CreditworthinessEffectiveRatingHoverTooltip }
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 4 0 }
						text_single = {
							autoresize = yes
							text = "CREDITWORTHINESS_EFFECTIVE_LABEL"
							default_format = "#explanation_link"
							align = left|nobaseline
						}
						expand = {}
						text_single = {
							autoresize = yes
							raw_text = "[Country.GetCreditworthinessEffectiveRating|0Y]"
							align = right|nobaseline
						}
					}
				}
			}

			TooltipStringPairList = {
				blockoverride "block_title" {
					text = "CREDITWORTHINESS_CURRENT_EFFECTS"
				}
				textcontext = "[Country.GetCreditworthinessImpactInfo]"
			}
		}
	}
}

