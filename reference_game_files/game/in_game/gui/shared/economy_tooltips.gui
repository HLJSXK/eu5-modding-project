template MintingMaitenanceTooltip {	
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "MINTING_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/balance/minting_coins.dds"
			}
		}

		blockoverride "concept_link" {
			text = "[minting|e]"
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				visible = "[Not(Player.IsMintingInefficient)]"

				textcontext = "[EconomyView.GetIncomeFromMintingInfo]"
			}
			TooltipStringPairList = {
				textcontext = "[EconomyView.GetInflationFromMintingInfo]"
			}
			TooltipStringPairList = {
				textcontext = "[EconomyView.GetInflationGoodDemand]"
			}
			TooltipTextBlock = {
				visible = "[Player.IsMintingInefficient]"

				blockoverride "text" {
					text = "[EconomyView.GetInefficientMintingInfo]"
				}

				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}
			TooltipTextBlock = {
				visible = "[And(Player.IsMintingInefficient, GreaterThan_CFixedPoint(EconomyView.GetCoinMinting, '(CFixedPoint)0'))]"

				blockoverride "text" {
					text = "[EconomyView.GetFullEfficiencyMintingIncome]"
				}

				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_purple_texture
					}
				}
			}
		}
	}	
}

