template God_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[God.GetNameWithNoTooltip]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetGodIcon(God.Self)]"
			}
		}

		blockoverride "concept_link" {
			text = "[God.GetGodOrGoddess]"
		}
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[God.GetDebugText]"
				}
			}

			TooltipTextBlock = {
				visible = "[And(God.HasMonarchPower, HasDlc('d008_fate_of_the_phoenix'))]"
				blockoverride "text" {
					text = "[God.GetMonarchPowerTooltip]"
				}
			}

			TooltipListBase = {
				visible = "[And(God.HasOmens, HasDlc('d008_fate_of_the_phoenix'))]"
				blockoverride "block_title" {
					text = "god_omens_desc"
				}

				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 310 }
					}
					blockoverride "section_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							set_parent_dimension_to_minimum = height

							fixedgridbox = {
								addcolumn = 100%
								addrow = 30
								datamodel = "[God.GetOmens]"
								item = {
									widget = {
										size = { 100% 30 }
										background = {
											visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
											using = tooltip_table_field_texture
										}

										hbox = {
											using = layoutpolicy_expanding
											margin = { 10 0 }
											spacing = 5
											icon = {
												size = { 20 20 }
												texture = "[GetOmenIcon(Omen.Self)]"
											}
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = left
												text = "[Omen.GetName]"
											}
										}
									}
								}
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				visible = "[Not(StringIsEmpty(God.GetActiveEffects))]"
				textcontext = "[God.GetActiveEffects]"
			}

			TooltipStringPairList = {
				visible = "[God.HasInactiveConditionalEffects]"
				textcontext = "[God.GetInactiveConditionalEffects]"
			}
			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[God.GetDesc]"
				}
			}
		}
	}
}

