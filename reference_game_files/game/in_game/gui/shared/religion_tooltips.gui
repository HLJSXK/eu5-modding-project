template Available_omens_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "AVAILABLE_OMENS"
		}

		blockoverride "concept_link" {
			text = [omen|E]
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('omen')]"
			}
		}
		
		blockoverride "tooltip_content" {

			TooltipStringPairList = {
				blockoverride "block_title" {
					raw_text = "[Localize('MODIFIER_TYPE_NAME_omens_offered')] [Country.GetModifierValueNoFormat('omens_offered')]"
				}
				textcontext = "[Country.GetDescriptionFor('omens_offered')]"
			}

			TooltipListBase = {
				blockoverride "block_title" {
					text = "ACTIVE_OMENS"
				}

				TooltipListScrollArea = {
					visible = "[DataModelHasItems(Player.GetActiveOmens)]"
					blockoverride "block_scrollarea" {
						maximumsize = { -1 210 }
					}
					blockoverride "scrollarea_content" {
						fixedgridbox = {
							addcolumn = 230
							addrow = 30

							datamodel = "[Player.GetActiveOmens]"
							item = {
								widget = {
									size = { 100% 30 }
									hbox = {
										using = layoutpolicy_expanding
										margin = { 10 0 }
										spacing = 5
										icon = {
											size = { 20 20 }
											texture = "[GetOmenIcon(Omen.Self)]"
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = left
											text = "[Omen.GetName]"
										}
									}
								}
							}
						}
					}
				}
		
				TooltipListEmptyContent = {
					visible = "[IsDataModelEmpty(Player.GetActiveOmens)]"
				}
			}
		}
	}
}

