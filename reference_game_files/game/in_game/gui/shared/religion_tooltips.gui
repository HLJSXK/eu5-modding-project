		blockoverride "title_text" {
			text = "[HolySite.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = "[holy_site|e]"
		}

		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[HolySite.GetDebugText]"
				}
			}
			using = HolySite_tooltip_content
		}
	}
}

