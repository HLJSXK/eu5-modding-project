template HolySite_tooltip_content {
	TooltipListBase = {
		visible = "[HolySite.GetLocation.IsPossibleToOwn]"
		ignoreinvisible = yes
		TooltipManualTableField = {
			hbox = {
				margin = { 5 0 }

				text_single = {
					autoresize = yes
					align = right
					text = "LOCATION_OWNER_TT"
				}
			}
			
			expand = {}
			
			hbox = {
				margin = { 5 0 }
				spacing = 5

				country_flag_mini = {
					datacontext = "[HolySite.GetLocation.GetOwner]"
				}

				text_single = {
					autoresize = yes
					align = right
					raw_text = "[HolySite.GetLocation.GetOwner.GetLongName]"
				}
			}
		}
	}
	
	TooltipStringPairList = {
		textcontext = "[HolySite.GetTooltip]"
	}
	
	TooltipStringPairList = {
		visible = "[HolySite.HasReligionModifiers]"
		textcontext = "[HolySite.GetReligionModifierInfo]"
	}
	TooltipStringPairList = {
		visible = "[HolySite.HasCountryModifiers]"
		textcontext = "[HolySite.GetCountryModifierInfo]"
	}
	TooltipStringPairList = {
		visible = "[HolySite.HasLocationModifiers]"
		textcontext = "[HolySite.GetLocationModifierInfo]"
	}
	
	TooltipFlavorTextBlock = {
		visible = "[HolySite.HasDesc]"
		blockoverride "text" {
			text = "[HolySite.GetDesc]"
		}
	}

}

