template religion_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetReligionIcon(Religion.Self)]"
		}

		blockoverride "title_text" {
			text = "[Religion.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = [religion|E]
		}
		
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[Religion.GetDebugText]"
				}
			}

			TooltipScrolledBlockList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 450 } }
				textcontext = "[Religion.GetTooltip]"
			}
		
			TooltipTextBlock = {
				blockoverride "text" {
					datacontext = "[Religion]"
					text = "RELIGION_TOTAL_WORSHIPPERS"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 0 5 }
				visible = "[DataModelHasItems(Religion.GetCountriesList.GetContributions)]"

				icon_pie = {
					blockoverride "PieSize" { size = { 120 120 } }

					blockoverride "pie_datamodel" {
						datamodel = "[Religion.GetCountriesList.GetContributions]"
					}

					blockoverride "SliceTooltip" {
						tooltip = "[PopsByCountryContribution.GetName]"
						tooltipwidget = {
							visible = "[Not(PopsByCountryContribution.IsOther)]"
							datacontext = "[PopsByCountryContribution.GetCountry]"
							using = CountryTooltip
						}
					}
					blockoverride "SliceValue"   { value = "[PopsByCountryContribution.GetPercentage]" }
					blockoverride "SliceColor"   { color = "[PopsByCountryContribution.GetColor]" }

					blockoverride "Icon" {
						texture = "gfx/interface/icons/flat_icons/country.dds"
						modify_texture = {
							using = color_gold_texture
							texture_density = 2
							blend_mode = alphamultiply
							alpha = 1
						}
					}

					blockoverride "datamodel" {
						datamodel = "[Religion.GetCountriesList.GetAllContributions]"
					}
					blockoverride "color"          { color = "[PopsByCountryContribution.GetColor]" }
					blockoverride "leftside_info"  {
						datacontext = "[PopsByCountryContribution.GetCountry]"
						text = "[PopsByCountryContribution.GetName]"
						filter_mouse = all
						tooltipwidget = {
							using = CountryTooltip
						}
					}
					blockoverride "rightside_info" {
						raw_text = "[PopsByCountryContribution.GetPercentage|%1] ([PopsByCountryContribution.GetDisplayValue]@population!)"
					}
				}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[Religion.GetFlavorText]"
				}
			}
		}
	}
}

template religion_group_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[ReligionGroup.GetNameWithNoTooltip]"
		}
		
		blockoverride "title_icon" {
			icon = {
				visible = "[Not(EqualTo_string(ReligionGroup.GetNameWithNoTooltip, 'Christianity'))]"
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/location_icons/main_religion.dds"
			}
			icon = {
				visible = "[EqualTo_string(ReligionGroup.GetNameWithNoTooltip, 'Christianity')]"
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/international_organizations/christianity.dds"
			}
		}

		blockoverride "concept_link" {
			text = [religion_group|E]
		}
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[ReligionGroup.GetDebugText]"
				}
			}

			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 225 } }
				textcontext = "[ReligionGroup.GetActiveReligions]"
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 225 } }
				textcontext = "[ReligionGroup.GetInactiveReligions]"
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 0 5 }
				visible = "[DataModelHasItems(ReligionGroup.GetReligionsPieChart.GetContributions)]"

				icon_pie = {
					blockoverride "PieSize" { size = { 120 120 } }

					blockoverride "pie_datamodel" {
						datamodel = "[ReligionGroup.GetReligionsPieChart.GetContributions]"
					}

					blockoverride "SliceTooltip" {
						tooltip = "[PopsByReligionContribution.GetName]"
						tooltipwidget = {
							visible = "[Not(PopsByReligionContribution.IsOther)]"
							datacontext = "[PopsByReligionContribution.GetReligion]"
							using = religion_tooltip
						}
					}
					blockoverride "SliceValue"   { value = "[PopsByReligionContribution.GetPercentage]" }
					blockoverride "SliceColor"   { color = "[PopsByReligionContribution.GetColor]" }

					blockoverride "Icon" {
						texture = "gfx/interface/icons/location_icons/main_religion.dds"
						modify_texture = {
							using = color_gold_texture
							texture_density = 2
							blend_mode = alphamultiply
							alpha = 1
						}
					}

					blockoverride "datamodel" {
						datamodel = "[ReligionGroup.GetReligionsPieChart.GetAllContributions]"
					}
					blockoverride "color"          { color = "[PopsByReligionContribution.GetColor]" }
					blockoverride "leftside_info"  {
						datacontext = "[PopsByReligionContribution.GetReligion]"
						text = "[PopsByReligionContribution.GetName]"
						filter_mouse = all
						tooltipwidget = {
							using = religion_tooltip
						}
					}
					blockoverride "rightside_info" {
						raw_text = "[PopsByReligionContribution.GetPercentage|%1] ([PopsByReligionContribution.GetDisplayValue]@population!)"
					}
				}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[ReligionGroup.GetDesc]"
				}
			}
		}
	}
}

template karma_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/religious_doctrines/theravada/karma.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "karma"
		}

		blockoverride "concept_link" {
			text = "[karma|e]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "KARMA_TT_TEXT"
				}
			}
			TooltipScrolledStringPairList = {
				visible = "[And(LessThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)33.001'), GreaterThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)-33.001'))]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "KARMA_TT_CURRENT_TEXT"
				}
				textcontext = "[Localize(GetAutoModifier('neutral_karma').GetDesc)]"
			}
			TooltipScrolledStringPairList = {
				visible = "[GreaterThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)33.001')]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "KARMA_TT_CURRENT_TEXT"
				}
				textcontext = "[Localize(GetAutoModifier('high_karma').GetDesc)]"
			}
			TooltipScrolledStringPairList = {
				visible = "[LessThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)-33.001')]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "KARMA_TT_CURRENT_TEXT"
				}
				textcontext = "[Localize(GetAutoModifier('low_karma').GetDesc)]"
			}
			TooltipScrolledStringPairList = {
				visible = "[Not(And(LessThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)33.001'), GreaterThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)-33.001')))]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "KARMA_TT_IF_NEUTRAL_T"
				}
				textcontext = "[Localize(GetAutoModifier('neutral_karma').GetDesc)]"
			}
			TooltipScrolledStringPairList = {
				visible = "[LessThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)33.001')]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "KARMA_TT_IF_HIGH_T"
				}
				textcontext = "[Localize(GetAutoModifier('high_karma').GetDesc)]"
			}
			TooltipScrolledStringPairList = {
				visible = "[GreaterThan_CFixedPoint(Country.GetFixedPointCurrencyValue('karma'), '(CFixedPoint)-33.001')]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "KARMA_TT_IF_LOW_T"
