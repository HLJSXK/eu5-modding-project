template TradeProfitDetails {
	TooltipListBase = { ### TC
		TooltipListRowContent = {
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = {
						text = "TOTAL_PROFIT"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetProfit|+=2]@gold!"
					}
				}
			}

			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = {
						text = "TRADE_CAPACITY_USED"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetAssignedMerchantCapacityModifiedPlayer] [merchant_capacity_icon]"
					}
				}
			}

			TooltipManualTableField = {
				visible = "[Not(Trade.HasTradeHappened)]"
				blockoverride "field_content" {
					text_single = {
						text = "PROFIT_TRADE_PREFIX_TT"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetProfitPerMerchantCapacity|2]@profit_trade!"
					}
				}
			}

			TooltipManualTableField = {
				visible = "[Trade.HasTradeHappened]"
				blockoverride "field_content" {
					text_single = {
						text = "PROFIT_TRADE_PREFIX_TT"
					}
					expand = {}
					text_single = {
						raw_text = "[Trade.GetProfitPerMerchantCapacity|+=2]@profit_trade!"
					}
				}
			}
		}
	}

	TooltipListBase = {
		visible = "[Trade.HasTradeHappened]"
		TooltipListRowContent = {
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = {
						text = "TRADE_TT_TOTAL_INCOME"
					}
					expand = {}
					text_single = {
						raw_text = "[Multiply_CFixedPoint(Trade.GetProfitPerMerchantCapacity, Trade.GetOwner.GetModifier('trade_income'))|2+=]@income!"
					}
					tagtooltip_enabled = yes
					tooltip = "[trade_income|e]"
				}
			}
		}
	}
}