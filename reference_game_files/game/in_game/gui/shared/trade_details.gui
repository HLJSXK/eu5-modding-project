						text = "[sound_toll|e]"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetSoundTollFee|2]@gold!"
						default_format = "#R"
					}
				}
			}

			TooltipManualTableField = {
				datacontext = "[Trade.GetToMarket.GetMarketEntry(Trade.GetGoods)]"
				datacontext = "[Trade.GetToMarket]"
				blockoverride "field_content" {
					text_single = {
						tooltipwidget = { using = goods_market_price_tooltip }
						text = "TRADE_MERCHANT_SELLING_SUMMARY"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetSell|+=2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "TRADE_PROFIT_SELLING_LABEL"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetConceptTexture('trade')]"
									}
								}
								blockoverride "concept_link" {
									text = "[trade_profit|e]"
								}
								blockoverride "tooltip_content" { 
									TooltipScrolledStringPairList = {
										blockoverride "block_title" { text = "TRADE_PROFIT_SELLING_LABEL" }
										blockoverride "block_scrollarea" { maximumsize = { -1 480 } }
										textcontext = "[Trade.GetSellInfo]"
									}
								}
							}
						}
					}
				}
			}
		}
