template from_market_price {
	raw_text = "#R -[Trade.GetBuy|2]#!@gold!"
	datacontext = "[Trade.GetGoods]"
	datacontext = "[Trade.GetFromMarket]"
	datacontext = "[Trade.GetOwner]"
	tooltipwidget = {
		using = SpecificGoodsMarket_tooltip
	}
}
template to_market_price {
	raw_text = "#G +[Trade.GetSell|2]#!@gold!"
	datacontext = "[Trade.GetGoods]"
	datacontext = "[Trade.GetToMarket]"
	datacontext = "[Trade.GetOwner]"
	tooltipwidget = {
		using = SpecificGoodsMarket_tooltip
	}
}
template trade_details {
	
	TooltipTextBlock = {
		blockoverride "text" {
			text = "TRADE_OWNER_LABEL"
			default_format = "#flavor"
		}
		datacontext = "[Trade.GetOwner]"
		tooltipwidget = {
			using = CountryTooltip
		}
	}
	TooltipTextBlock = {
		visible = "[IsOutCompeted(Trade.Self)]"
		blockoverride "textblock_background_tint"  {
			modify_texture = {
				visible = "[And(Trade.HasTradeHappened, Trade.IsTradeInefficient)]"
				using = color_yellow_texture
			}
		}
		blockoverride "text" {
			text = "[GetOutCompetedInfo(Trade.Self)]"
		}
	}

	TooltipListBase = { 
		TooltipListRowContent = {
			TooltipManualTableField = {
				visible = "[Trade.GetGoods.IsFood]"
				blockoverride "field_content" {
					text_single = {
						text = "FOOD_VOLUME"
						default_format = "#subtle_name"
					}
					expand = {}									
					text_single = {
						raw_text = "[Multiply_CFixedPoint(Trade.GetQuantityOfGoodsActuallyMoved, Trade.GetGoods.GetFoodOutput)|2]@food!"
					}
				}
			}
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = {
						text = "SHIPPING_VOLUME"
						default_format = "#subtle_name"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetQuantityOfGoodsActuallyMoved|V2]@good!"
					}
				}
			}

			TooltipManualTableField = {
				background = {
					visible = "[And(Trade.HasTradeHappened, Trade.IsTradeInefficient)]"
					using = color_mid_red_texture
					alpha = 0.5
				}
				blockoverride "field_content" {
					text_single = {
						text = "DESIRED_VOLUME"
						default_format = "#subtle_name"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetDesiredGoodsShipped|V2]@good!"
						tooltipwidget = {
							container = {
								container = {						
									visible = "[And(Trade.HasTradeHappened, Trade.IsTradeInefficient)]"
									ContextualTooltipType = {
										blockoverride "title_text" {
											datacontext = "[Trade]"
											text = "TRADE_INEFFICIENT_HEADER"
										}
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/flat_icons/trade_maintenance.dds"
											}
										}
										blockoverride "concept_link" {
											text = [merchant_maintenance|E]
										}
										blockoverride "tooltip_content" {
											TooltipTextBlock = {							
												blockoverride "text" {
													datacontext = "[Trade]"
													text = "TRADE_INEFFICIENT_TT_TEXT"
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			TooltipManualTableField = {
				visible = "[And(Trade.HasTradeHappened, Trade.HasTradeQueuedCapacity)]"
				blockoverride "field_content" {
					text_single = {
						text = "SHIPPING_VOLUME_NEXT"
						default_format = "#subtle_name"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetDesiredGoodsToShip|V2]@good!"
					}
				}
			}
		}
	}

	TooltipListBase = { #FROM_MARKET
		TooltipListRowContent = {
			TooltipTableField = {
				blockoverride "field_background" {
					background = {
						using = tile_background_squared_texture
						modify_texture = {
							using = color_turquoise_texture
						}
						alpha = 0.5
					}
				}

				blockoverride "field_content" {
					datacontext = "[Trade.GetFromMarket]"
					datacontext = "[Trade.GetFromMarket.GetMarketEntry(Trade.GetGoods)]"
					hbox = {
						layoutpolicy_horizontal = expanding

						spacing = 5

						country_flag_small = {
							datacontext = "[Market.GetCenterLocation.GetOwner]"
						}
						text_single = {
							text = "[Market.GetName]"
							fontsize = 16
						}
						text_single = {
							tooltipwidget = {
								using = goods_market_balance_tooltip
							}
							raw_text = "([Subtract_CFixedPoint(Add_CFixedPoint(Trade.GetFromMarket.GetSupply(GoodsMarketEntry.GetGoods), Trade.GetFromMarket.GetExtraTradeSupplyFromStockpile(Trade.GetGoods)), Trade.GetFromMarket.GetDemand(GoodsMarketEntry.GetGoods))|+=2]@balance!)"
						}
						expand = {}
					}
				}
			}
			TooltipManualTableField = {
				blockoverride "field_content" {
					datacontext = "[Trade.GetFromPort]"
					text_single = {
						text = "EXPORTING_THROUGH"
						default_format = "#flavor"
					}
					expand = {}									
				}
			}
			TooltipManualTableField = {
				datacontext = "[Trade.GetFromMarket.GetMarketEntry(Trade.GetGoods)]"
				datacontext = "[Trade.GetFromMarket]"
				blockoverride "field_content" {
					text_single = {
						tooltipwidget = { using = goods_market_price_tooltip }
						text = "TRADE_MERCHANT_BUYING"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetBuy|2]@gold!"
						default_format = "#R"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "TRADE_PROFIT_BUY_LABEL"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetConceptTexture('trade')]"
									}
								}
								blockoverride "concept_link" {
									text = "[trade_profit|e]"
								}
								blockoverride "tooltip_content" { 
									TooltipScrolledStringPairList = {
										blockoverride "block_title" { text = "TRADE_PROFIT_BUY_LABEL" }
										blockoverride "block_scrollarea" { maximumsize = { -1 480 } }
										textcontext = "[Trade.GetBuyInfo]"
									}
								}
							}
						}
					}
				}
			}

			TooltipManualTableField = {
				visible = "[Trade.IsExport]"
				blockoverride "field_content" {
					text_single = {
						text = "TRADE_MERCHANT_VALUE_TOOLTIP"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetMaintenance|2]@gold!"
						default_format = "#R"
						tooltipwidget = {
							using = trade_maintenance_tooltip
						}
					}
				}
			}

			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Trade.GetSoundTollFee,'(CFixedPoint)0')]"
				blockoverride "field_content" {
					text_single = {
						text = "TRADE_TT_SOUND_TOLL"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetSoundTollFee|2]@gold!"
						default_format = "#R"
					}
				}
			}
		}
	}

	TooltipListBase = { #TO_MARKET
		TooltipListRowContent = {
			TooltipTableField = {
				blockoverride "field_background" {
					background = {
						using = tile_background_squared_texture
						modify_texture = {
							using = color_turquoise_texture
						}
						alpha = 0.5
					}
				}

				blockoverride "field_content" {
					datacontext = "[Trade.GetToMarket]"
					datacontext = "[Trade.GetToMarket.GetMarketEntry(Trade.GetGoods)]"
					hbox = {
						layoutpolicy_horizontal = expanding

						spacing = 5

						country_flag_small = {
							datacontext = "[Market.GetCenterLocation.GetOwner]"
						}
						text_single = {
							text = "[Market.GetName]"
							fontsize = 16
						}
						text_single = {
							tooltipwidget = {
								using = goods_market_balance_tooltip
							}
							raw_text = "([Subtract_CFixedPoint(Add_CFixedPoint(Trade.GetToMarket.GetSupply(GoodsMarketEntry.GetGoods), Trade.GetToMarket.GetExtraTradeSupplyFromStockpile(Trade.GetGoods)), Trade.GetToMarket.GetDemand(GoodsMarketEntry.GetGoods))|+=2]@balance!)"
						}
						expand = {}
					}
				}
			}
			TooltipManualTableField = {
				blockoverride "field_content" {
					datacontext = "[Trade.GetToPort]"
					text_single = {
						text = "IMPORTING_THROUGH"
						default_format = "#flavor"
					}
					expand = {}									
				}
			}

			TooltipManualTableField = {
				visible = "[Not(Trade.IsExport)]"
				blockoverride "field_content" {
					text_single = {
						text = "TRADE_MERCHANT_VALUE_TOOLTIP"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetMaintenance|2]@gold!"
						default_format = "#R"
						tooltipwidget = {
							using = trade_maintenance_tooltip
						}
					}
				}
			}

			TooltipManualTableField = {
				visible = "[And(Not(Trade.IsExport), GreaterThan_CFixedPoint(Trade.GetSoundTollFee,'(CFixedPoint)0'))]"
				# visible = "[Not(Trade.IsExport)]"
				blockoverride "field_content" {
					text_single = {
						text = "TRADE_TT_SOUND_TOLL"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetSoundTollFee|2]@gold!"
						default_format = "#R"
					}
				}
			}

			TooltipManualTableField = {
				datacontext = "[Trade.GetToMarket.GetMarketEntry(Trade.GetGoods)]"
				datacontext = "[Trade.GetToMarket]"
				blockoverride "field_content" {
					text_single = {
						tooltipwidget = { using = goods_market_price_tooltip }
						text = "TRADE_MERCHANT_SELLING"
					}
					expand = {}									
					text_single = {
						raw_text = "[Trade.GetSell|+=2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "TRADE_PROFIT_SELLING_LABEL"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetConceptTexture('trade')]"
									}
								}
								blockoverride "concept_link" {
									text = "[trade_profit|e]"
								}
								blockoverride "tooltip_content" { 
									TooltipScrolledStringPairList = {
										blockoverride "block_title" { text = "TRADE_PROFIT_SELLING_LABEL" }
										blockoverride "block_scrollarea" { maximumsize = { -1 480 } }
										textcontext = "[Trade.GetSellInfo]"
									}
								}
							}
						}
					}
				}
			}
		}
	}

	TooltipContentSection = {
		using = TradeProfitDetails
	}

	TooltipTextBlock = {
		visible = "[Not(Trade.HasTradeHappened)]"
		blockoverride "textblock_background_tint"  {
			modify_texture = {
				using = color_yellow_texture
			}
		}
		blockoverride "text" {
			text = "TRADE_NOT_YET_ACTIVE"
		}
	}
}
template trade_maintenance_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			datacontext = "[Trade]"
			text = "TRADE_MAINTENANCE_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/trade_maintenance.dds"
			}
		}
		blockoverride "concept_link" {
			text = [merchant_maintenance|E]
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[Trade.GetMaintenanceInfo]"
			}
		}
	}
}
template PossibleTrade_maintenance_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			datacontext = "[PossibleTrade]"
			text = "POSSIBLE_TRADE_MAINTENANCE_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/trade_maintenance.dds"
			}
		}
		blockoverride "concept_link" {
			text = [merchant_maintenance|E]
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[PossibleTrade.GetMaintenanceInfo]"
			}
		}
	}
}

template TradeProfitSummary {
	TooltipListBase = { ### TC
		visible = "[Trade.HasTradeHappened]"
		TooltipListRowContent = {
			TooltipManualTableField = {
				datacontext = "[Trade.GetFromMarket.GetMarketEntry(Trade.GetGoods)]"
				datacontext = "[Trade.GetFromMarket]"
				blockoverride "field_content" {
					text_single = {
						tooltipwidget = { using = goods_market_price_tooltip }
						text = "TRADE_MERCHANT_BUYING_SUMMARY"
					}
					expand = {}									
					text_single = {
						raw_text = "-[Trade.GetBuy|2]@gold!"
						default_format = "#R"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "TRADE_PROFIT_BUY_LABEL"
								}
								blockoverride "title_icon" {
