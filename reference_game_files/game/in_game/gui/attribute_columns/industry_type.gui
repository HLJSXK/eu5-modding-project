types IndustryTypeColumns
{
	type industry_type = clickable_header_card {
		blockoverride "layout_setup" {
			using = flexible_interaction_target_entry_setup
		}

		blockoverride "header_size" {
			size = { -1 40 }
		}
		blockoverride "header_color" {
			using = color_government_texture
		}

		blockoverride "header_content" {
			using = select_interaction_target_action_provider
			datacontext = "[InteractionTarget.GetIndustryType]"

			tooltipwidget = {
				using = IndustryType_tooltip
			}

			hbox = {
				margin_right = 4
				spacing = 10
				layoutpolicy_horizontal = expanding

				estate_privilege_action_button_alt = {
					size = { 40 40 }
					blockoverride "icon_texture" {
						texture = "[InteractionTarget.GetIndustryType.GetIcon]"
					}
					blockoverride "estate_privilege_button_action" {
						tooltip_enabled = no
						using = select_interaction_target_action_provider
					}
				}

				text_single = {
					using = layoutpolicy_expanding
					using = Font_Size_Medium
					default_format = "#yellow_titles"
					autoresize = no
					size = { 200 18 }
					multiline = yes
					align = nobaseline
					text = "[InteractionTarget.GetIndustryType.GetNameWithNoTooltip]"

					sort_by_left_fade_highlight = {
						name = "name"
					}
				}

				subheader_unified_icon = {
					margin = { 2 0 }
					visible = "[HasIndustryBestCandidateArea(InteractionTarget.GetIndustryType)]"
					datacontext = "[GetIndustryBestCandidateArea(InteractionTarget.GetIndustryType)]"
					datacontext = "[GetQuickIndustryBuildings(GetIndustryBestCandidateArea(InteractionTarget.GetIndustryType), InteractionTarget.GetIndustryType)]"
					blockoverride "mirror_layout" { righttoleft = yes }

					tooltipwidget = {
						using = IndustryStatBuildings_tooltip

						blockoverride "title_icon_texture" {
							texture = "[GetConceptTexture('area')]"
						}

						blockoverride "title_text" {
							text = "BEST_CANDIDATE"
						}

						blockoverride "concept_link" {
							text = [area|E]
						}

						blockoverride "industry_stat_text" {
							text = "BEST_CANDIDATE_DESC"
						}
					}

					blockoverride "subheader_unified_icon_texture" {
						texture = "[GetConceptTexture('area')]"
					}

					blockoverride "subheader_unified_text_maxsize" { maximumsize = { 220 20 } }

					blockoverride "subheader_unified_top_text" {
						text = "BEST_CANDIDATE"
						align = right|nobaseline
					}

					blockoverride "unified_icon_bottom_content" {
						hbox = {
							spacing = 8
							margin_top = -4

							text_single = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "[GetAreaIndustryTaxBase(GetIndustryBestCandidateArea(InteractionTarget.GetIndustryType), InteractionTarget.GetIndustryType)|+=2]@tax_base!"
								sort_by_small_highlight = {
									name = "industry_tax_base"
								}
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "[GetAreaIndustryIncome(GetIndustryBestCandidateArea(InteractionTarget.GetIndustryType), InteractionTarget.GetIndustryType)|+=2]@income!"
								sort_by_small_highlight = {
									name = "industry_income"
								}
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "[GetAreaIndustryLevels(GetIndustryBestCandidateArea(InteractionTarget.GetIndustryType), InteractionTarget.GetIndustryType)|0]@building!"
								tooltip_enabled = no
								tagtooltip_enabled = no
								sort_by_small_highlight = {
									name = "industry_building_levels"
								}
							}
						}
					}
				}
			}
		}

		blockoverride "bottom_content_layout" {
			vbox = {
				using = bg_paper_card

				layoutpolicy_horizontal = expanding
				spacing = 5
				margin = { 5 5 }

				# Show the industry's location + country modifiers directly on the card.
				card_block_list = {
					textcontext = "[InteractionTarget.GetIndustryType.GetTooltip]"
				}
			}
		}
	}
}
