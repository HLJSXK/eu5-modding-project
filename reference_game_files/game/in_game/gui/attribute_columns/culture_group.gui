types CultureGroupColumns
{
	type expected_assimilation = select_cell_default {
		size = { 140 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "expected_assimilation"
		}

		hbox = {
			margin = { 10 0 }
			spacing = 5

			text_single = {
				using = layoutpolicy_expanding
				autoresize = no
				align = right|nobaseline
				text = "[SelectInteractionTargetView.GetCurrentParams.GetActor.GetExpectedAssimilationForGroup(InteractionTarget.GetCultureGroup)|%]"
			}
		}

		tooltip = "EXPECTED_ASSIMILATION_TT"
	}
}
