types BureaucracyTypeColumns
{
	type bureaucracy_type = select_cell_default {
		size = { 150 32 }

		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out

				blockoverride "title_icon_texture" {
					texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
				}

				blockoverride "concept_link" {
					text = "[bureaucracy|e]"
				}

				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
						blockoverride "text" { text = "[UIAction.GetDescription]" }
					}

					TooltipStringPairList = {
						blockoverride "block_title" {
							text = "positive_modifier_effects_TT"
						}
						textcontext = "[InteractionTarget.GetBureaucracyType.GetPositiveEffects]"
					}

					TooltipStringPairList = {
						blockoverride "block_title" {
							text = "neutral_modifier_effects_TT"
						}
						textcontext = "[InteractionTarget.GetBureaucracyType.GetNeutralEffects]"
					}

					TooltipStringPairList = {
						blockoverride "block_title" {
							text = "negative_modifier_effects_TT"
						}
						textcontext = "[InteractionTarget.GetBureaucracyType.GetNegativeEffects]"
					}

					TooltipStringPairList = {
						textcontext = "[InteractionTarget.GetBureaucracyType.GetEstatesThatLikeTooltip]"
					}

					TooltipStringPairList = {
						textcontext = "[InteractionTarget.GetBureaucracyType.GetEstatesThatDislikeTooltip]"
					}

					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "[InteractionTarget.GetBureaucracyType.GetDesc]"
						}
					}
				}
			}
		}

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding

			icon = {
				size = { 28 28 }
				texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetBureaucracyType.GetNameWithNoTooltip]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetBureaucracyType.GetName]"
	}
}
