types BureaucracyTypeColumns
{
	type bureaucracy_type = select_cell_default {
		size = { 150 44 }

		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out

				blockoverride "title_icon_texture" {
					texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
				}

				blockoverride "concept_link" {
					text = "[bureaucracy|e]"
				}

				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
						blockoverride "text" { text = "[UIAction.GetDescription]" }
					}

					TooltipStringPairList = {
						blockoverride "block_title" {
							text = "negative_modifier_effects_TT"
						}
						textcontext = "[InteractionTarget.GetBureaucracyType.GetNegativeEffects]"
					}

					TooltipStringPairList = {
						blockoverride "block_title" {
							text = "neutral_modifier_effects_TT"
						}
						textcontext = "[InteractionTarget.GetBureaucracyType.GetNeutralEffects]"
					}

					TooltipStringPairList = {
						blockoverride "block_title" {
							text = "positive_modifier_effects_TT"
						}
						textcontext = "[InteractionTarget.GetBureaucracyType.GetPositiveEffects]"
					}

					TooltipStringPairList = {
						textcontext = "[InteractionTarget.GetBureaucracyType.GetEstatesThatLikeTooltip]"
					}

					TooltipStringPairList = {
						textcontext = "[InteractionTarget.GetBureaucracyType.GetEstatesThatDislikeTooltip]"
					}

					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "[InteractionTarget.GetBureaucracyType.GetDesc]"
						}
					}
				}
			}
		}

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding

			icon = {
				size = { 28 28 }
				texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetBureaucracyType.GetNameWithNoTooltip]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetBureaucracyType.GetName]"
	}

	type bureaucracy_positive_modifiers = select_cell_default {
		size = { 110 44 }

		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" { text = "positive_modifier_effects_TT" }
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
						}
					}
					blockoverride "concept_link" { text = "[bureaucracy|e]" }
					blockoverride "tooltip_content" {
						TooltipStringPairList = {
							textcontext = "[InteractionTarget.GetBureaucracyType.GetPositiveEffects]"
						}
					}
				}
			}
		}

		widget = {
			size = { 100% 32 }
			position = { 0 6 }

			background = {
				using = bureaucracies_color_texture
				blockoverride "bureaucracies_color" {
					modify_texture = {
						blend_mode = overlay
						alpha = 0.4
						using = color_light_green_texture
					}
				}
			}

			text_single = {
				size = { 100% 100% }
				align = center|nobaseline
				autoresize = no
				text = "[InteractionTarget.GetBureaucracyType.GetPositiveModifierIcons]"
			}
		}
	}

	type bureaucracy_constant_modifiers = select_cell_default {
		size = { 110 44 }

		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" { text = "neutral_modifier_effects_TT" }
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
						}
					}
					blockoverride "concept_link" { text = "[bureaucracy|e]" }
					blockoverride "tooltip_content" {
						TooltipStringPairList = {
							textcontext = "[InteractionTarget.GetBureaucracyType.GetNeutralEffects]"
						}
					}
				}
			}
		}

		widget = {
			size = { 100% 32 }
			position = { 0 6 }

			background = {
				using = bureaucracies_color_texture
				blockoverride "bureaucracies_color" {
					modify_texture = {
						blend_mode = overlay
						alpha = 0.5
						using = color_yellow_texture
					}
				}
			}

			text_single = {
				size = { 100% 100% }
				align = center|nobaseline
				autoresize = no
				text = "[InteractionTarget.GetBureaucracyType.GetNeutralModifierIcons]"
			}
		}
	}

	type bureaucracy_negative_modifiers = select_cell_default {
		size = { 110 44 }

		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" { text = "negative_modifier_effects_TT" }
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[GetBureaucracyIcon(InteractionTarget.GetBureaucracyType)]"
						}
					}
					blockoverride "concept_link" { text = "[bureaucracy|e]" }
					blockoverride "tooltip_content" {
						TooltipStringPairList = {
							textcontext = "[InteractionTarget.GetBureaucracyType.GetNegativeEffects]"
						}
					}
				}
			}
		}

		widget = {
			size = { 100% 32 }
			position = { 0 6 }

			background = {
				using = bureaucracies_color_texture
				blockoverride "bureaucracies_color" {
					modify_texture = {
						blend_mode = overlay
						alpha = 0.7
						using = color_red_texture
					}
				}
			}

			text_single = {
				size = { 100% 100% }
				align = center|nobaseline
