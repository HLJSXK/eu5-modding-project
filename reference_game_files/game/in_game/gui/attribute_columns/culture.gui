types CultureColumns
{
	type culture_name = select_cell_default {
		size = { 150 32 }
		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out
				blockoverride "title_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/culture/culture.dds"
				}
				blockoverride "concept_link" {
					text = "[culture|e]"
				}
			}
		}

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding

			icon = {
				texture = "gfx/interface/icons/culture/primary_culture.dds"
				size = { 32 32 }
				visible = "[InteractionTarget.GetCulture.IsPrimary(SelectInteractionTargetView.GetCurrentParams.GetActor)]"
			}

			icon = {
				texture = "gfx/interface/icons/culture/accepted_culture.dds"
				size = { 32 32 }
				visible = "[And(InteractionTarget.GetCulture.IsAccepted(SelectInteractionTargetView.GetCurrentParams.GetActor), Not(InteractionTarget.GetCulture.IsPrimary(SelectInteractionTargetView.GetCurrentParams.GetActor)))]"
			}

			icon = {
				texture = "gfx/interface/icons/culture/tolerated_culture.dds"
				size = { 32 32 }
				visible = "[InteractionTarget.GetCulture.IsTolerated(SelectInteractionTargetView.GetCurrentParams.GetActor)]"
			}

			icon = {
				texture = "gfx/interface/icons/culture/discriminated_culture.dds"
				size = { 32 32 }
				visible = "[InteractionTarget.GetCulture.IsNonTolerated(SelectInteractionTargetView.GetCurrentParams.GetActor)]"
			}
			
			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetCulture.GetNameWithNoTooltip|L]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetCulture.GetName]"
	}

	type culture_percentage_in_country = select_cell_default {
		size = { 100 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "culture_percentage_in_country"
		}

		hbox = {
			margin = { 10 0 }
			spacing = 5
			icon = {
				visible = no
				size = { 28 28 }
				texture = "gfx/interface/icons/location_icons/new/population.dds"
			}

			text_single = {
				using = layoutpolicy_expanding
				autoresize = no
				align = right|nobaseline
				text = "[SelectInteractionTargetView.GetCurrentParams.GetActor.GetCulturePercentage(InteractionTarget.GetCulture)|%]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetCulture.GetName]"
	}
}