types ColonialCharterGoalColumns
{
	type colonial_charter_goal_name = select_cell_default {
		size = { 150 40 }

		tooltipmeta = {
			texture = "gfx/interface/mapitems/colonial_charter.dds"
			game_concept = "[colonial_charter_goal|e]"
		}

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			visible = "[Not(InteractionTarget.GetColonialCharterGoal.IsAuto)]"
			text = "[InteractionTarget.GetColonialCharterGoal.GetName]"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			visible = "[InteractionTarget.GetColonialCharterGoal.IsAuto]"
			text = "CHARTER_GOAL_AUTO_NAME"
		}
	}
}