types ReligiousOrderTypeColumns
{
	type religious_order_type_name = select_cell_default {
		size = { 150 32 }

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			icon = {
				size = { 28 28 }
				texture = "[GetReligiousOrderTypeIcon(InteractionTarget.GetReligiousOrderType)]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetReligiousOrderType.GetNameWithNoTooltip]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetReligiousOrderType.GetName]"
	}
}

widget = {
	visible = no
	religious_order_type_name = {}
}
