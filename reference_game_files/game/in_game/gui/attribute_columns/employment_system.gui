types EmploymentSystemColumns
{
	type employment_system = select_cell_default {
		size = { 150 32 }

		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out

				blockoverride "title_icon_texture" {
					texture = "[InteractionTarget.GetEmploymentSystem.GetIcon]"
				}

				blockoverride "concept_link" {
					text = "[employment_system|e]"
				}
			}
		}

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding

			icon = {
				size = { 28 28 }
				texture = "[InteractionTarget.GetEmploymentSystem.GetIcon]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetEmploymentSystem.GetNameWithNoTooltip]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetEmploymentSystem.GetName]"
	}
}
