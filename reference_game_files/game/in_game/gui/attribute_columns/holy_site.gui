types HolySiteColumns
{
	type holy_site_name = select_cell_default {
		size = { 110 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			text = "[InteractionTarget.GetHolySite.GetName]"
		}
	}

	type holy_site_owner_flag = widget {
		size = { 40 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "owner_flag"
		}

		country_flag_small = {
			visible = "[InteractionTarget.GetHolySite.GetLocation.GetOwner.IsValid]"
			parentanchor = center
			layoutpolicy_vertical = fixed
			layoutpolicy_horizontal = fixed
			size = { 35 24 }
			datacontext = "[InteractionTarget.GetHolySite.GetLocation.GetOwner]"
			blockoverride "hover_leave" {
				onmousehierarchyleave = "[SelectInteractionTargetGlue.OnMouseLeave(PdxGuiWidget.AccessSelf)]"
			}
		}
	}

	type holy_site_time = select_cell_default {
		size = { 110 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "time"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			text = "[InteractionTarget.GetHolySite.GetPilgrimageTravelMonths]"
		}
	}

	type holy_site_gold = select_cell_default {
		size = { 100 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "gold"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			text = "[InteractionTarget.GetHolySite.GetPilgrimageGoldCost]"
		}
	}

	type holy_site_influence = select_cell_default {
		size = { 110 32 }

		sort_by_highlight = {
			size = { 100% 100% }
			name = "influence"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			text = "[InteractionTarget.GetHolySite.GetPilgrimageInfluenceGain]"
		}
	}
}

widget = {
	visible = no
	holy_site_name = {}
	holy_site_owner_flag = {}
	holy_site_time = {}
	holy_site_gold = {}
	holy_site_influence = {}
}
