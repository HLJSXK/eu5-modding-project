types CallingColumns
{
	type calling_name = select_cell_default {
		size = { 150 32 }

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			icon = {
				size = { 28 28 }
				texture = "[GetCallingIcon(InteractionTarget.GetCalling)]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetCalling.GetNameWithNoTooltip]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetCalling.GetName]"
	}
}

widget = {
	visible = no
	calling_name = {}
}
