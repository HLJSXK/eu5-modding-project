types ReligiousOrderColumns
{
	type religious_order_name = select_cell_default {
		size = { 150 32 }

		hbox = {
			margin = { 10 0 }
			spacing = 5
			layoutpolicy_horizontal = expanding
			icon = {
				size = { 28 28 }
				texture = "[GetReligiousOrderIcon(InteractionTarget.GetReligiousOrder)]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				align = nobaseline
				default_format = "#yellow_titles"
				text = "[InteractionTarget.GetReligiousOrder.GetNameWithNoTooltip]"
			}
		}

		tagtooltip_enabled = yes
		tooltip = "[InteractionTarget.GetReligiousOrder.GetName]"
	}

	type religious_order_zeal = select_cell_default {
		size = { 60 32 }

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			raw_text = "[InteractionTarget.GetReligiousOrder.GetZeal|0]%"
			tagtooltip_enabled = yes
			tooltip = "[InteractionTarget.GetReligiousOrder.GetName]"
		}
	}
}

widget = {
	visible = no
	religious_order_name = {}
	religious_order_zeal = {}
}
