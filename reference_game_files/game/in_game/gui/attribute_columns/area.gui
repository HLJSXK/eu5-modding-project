types AreaColumns
{
	# Promote Industry area picker card: area name + per-good building-level counts for the selected industry.
	type area_industry_promotion = clickable_header_card {
		blockoverride "layout_setup" {
			using = flexible_interaction_target_entry_setup
		}

		datacontext = "[InteractionTarget.GetArea]"

		blockoverride "header_content" {
			using = select_interaction_target_action_provider

			tooltipwidget = {
				using = Area_tooltip
			}

			hbox = {
				using = layoutpolicy_expanding
				margin = { 10 0 }

				text_single = {
					using = layoutpolicy_expanding
					using = Font_Size_Medium
					default_format = "#yellow_titles"
					autoresize = no
					align = nobaseline
					raw_text = "@area! [Area.GetNameWithNoTooltip]"
					sort_by_left_fade_highlight = {
						name = "name"
					}
				}

				hbox = {
					autoresize = yes
					spacing = 10
					margin_right = 12
					datacontext = "[GetQuickIndustryBuildings(InteractionTarget.GetArea, SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType)]"

					tooltipwidget = {
						using = IndustryStatBuildings_tooltip

						blockoverride "title_icon_texture" {
							texture = "[GetConceptTexture('industry_promotion')]"
						}

						blockoverride "title_text" {
							text = "INDUSTRY_STAT_AREA_TT_TITLE"
						}

						blockoverride "concept_link" {
							text = [industry_promotion|E]
						}
					}

					text_single = {
						autoresize = yes
						align = right|nobaseline
						raw_text = "[GetAreaIndustryTaxBase(InteractionTarget.GetArea, SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType)|+=2]@tax_base!"
						sort_by_small_highlight = {
							name = "industry_tax_base"
						}
					}

					text_single = {
						autoresize = yes
						align = right|nobaseline
						raw_text = "[GetAreaIndustryIncome(InteractionTarget.GetArea, SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType)|+=2]@income!"
						sort_by_small_highlight = {
							name = "industry_income"
						}
					}

					text_single = {
						autoresize = yes
						align = right|nobaseline
						raw_text = "[GetAreaIndustryLevels(InteractionTarget.GetArea, SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType)|0]@building!"
						tooltip_enabled = no
						tagtooltip_enabled = no
						sort_by_small_highlight = {
							name = "industry_building_levels"
						}
					}
				}
			}
		}

		blockoverride "bottom_content_layout" {
			vbox = {
				using = bg_paper_card
				using = layoutpolicy_expanding
				spacing = 5
				margin = { 5 5 }

				card_block_list = {
					textcontext = "[GetAreaIndustryGoodsSummary(InteractionTarget.GetArea, SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType)]"
					tooltipwidget = {
						SimpleContextualStringPairTooltipType = {
							lowpriotextcontext = "[GetAreaIndustryBuildingsTooltip(InteractionTarget.GetArea, SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType)]"
						}
					}

					sort_by_right_fade_highlight = {
						name = "industry_building_levels"
					}
				}
			}
		}
	}

	type area_name = select_cell_default {
		size = { 150 32 }
		blockoverride "interaction_target_action_provider_tooltip" {
			tooltipwidget = {
				using = action_tooltip_pop_out
				blockoverride "title_icon_texture" {
					texture = "gfx/interface/icons/map_modes/area.dds"
				}
				blockoverride "concept_link" {
					text = "[area|e]"
				}
			}
		}

		sort_by_highlight = {
			size = { 100% 100% }
			name = "name"
		}

		text_single = {
			size = { 100% 100% }
			margin = { 10 0 }
			autoresize = no
			align = nobaseline
			default_format = "#yellow_titles"
			text = "[InteractionTarget.GetArea.GetNameWithNoTooltip]"
		}
	}
	

	type area_exploration = clickable_header_card {
		size = { -1 72 }

		datacontext = "[InteractionTarget.GetArea]"

		blockoverride "header_content" {
			using = select_interaction_target_action_provider

			tooltipwidget = {
				using = Area_tooltip
			}

			hbox = {
				using = layoutpolicy_expanding
				widget = {
					size = { 90 -1 }
				}

				text_single = {
					using = layoutpolicy_expanding
					using = Font_Size_Medium
					default_format = "#yellow_titles"
					autoresize = no
					align = nobaseline
					text = "[Area.GetNameWithNoTooltip]"
					sort_by_left_fade_highlight = {
						name = "name"
					}
				}

				widget = {
					size = { 30 -1 }
				}
			}
		}

		blockoverride "bottom_content" {
			hbox = {
				using = layoutpolicy_expanding
				margin = { 20 0 }

				hbox = {
					using = layoutpolicy_expanding
					text_single = {
						using = layoutpolicy_expanding
						autoresize = no
						size = { 60 -1 }
						align = center|nobaseline

						text = "EXPLORATION_TIME_ESTIMATE"
						tooltipwidget = {
							using = exploration_time_estimate_tt
						}

						sort_by_left_fade_highlight = {
							name = "time"
						}
					}
					
					divider_flavor_01 = {
						size = {15 37}
					}
					
					text_single = {
						using = layoutpolicy_expanding
						autoresize = no
						size = { 60 -1 }
						align = center|nobaseline

						text = "EXPLORATION_COST_ESTIMATE"
						tooltipwidget = {
							using = exploration_cost_estimate_tt
						}

						sort_by_left_fade_highlight = {
							name = "cost"
						}
					}
				}
			}
		}
	}

	type area_integration = widget {
		size = { 100 32 }
		tooltipwidget = {
			SimpleContextualStringPairTooltipType = {
				blockoverride "title_icon" {
					icon = {
						using = tooltip_title_icon_size
						texture = "gfx/interface/icons/cabinet_actions/integrate_area.dds"
					}
				}
				blockoverride "concept_link" {
					text = "[area|e]"
				}
				lowpriotextcontext = "[InteractionTarget.GetArea.GetAverageIntegrationInfo(SelectInteractionTargetView.GetPlayer.Self)]"
			}
		}
		# tooltip = "[InteractionTarget.GetArea.GetAverageIntegrationInfo(SelectInteractionTargetView.GetPlayer.Self)]"

		hbox = {
			margin = { 5 0 }
			spacing = 5
			icon = {
				visible = no
				size = { 28 28 }
				texture = "gfx/interface/icons/location_icons/new/population.dds"
			}

			text_single = {
				using = layoutpolicy_expanding
				autoresize = no
				align = nobaseline
				text = "[InteractionTarget.GetArea.GetAverageIntegration(SelectInteractionTargetView.GetPlayer.Self)|%]"
			}
		}
	}
	
	type area_population = widget {
		size = { 100 32 }
		
		hbox = {
			margin = { 5 0 }
			spacing = 5
			icon = {
				visible = no
				size = { 28 28 }
				texture = "gfx/interface/icons/location_icons/new/population.dds"
			}

			text_single = {
				margin_left = 8
				sort_by_small_highlight = {
				name = "population"
				}
				using = layoutpolicy_expanding
				autoresize = no
				align = nobaseline
				text = "[InteractionTarget.GetArea.GetPopulation(SelectInteractionTargetView.GetPlayer.Self)]"
			}
		}
	}
	
	type area_primary_culture_percentage = widget {
		size = { 100 32 }
		tooltip = "[InteractionTarget.GetArea.GetPrimaryCulturePercentageInfo(SelectInteractionTargetView.GetPlayer.Self)]"

		hbox = {
			margin = { 5 0 }
			spacing = 5
			icon = {
				visible = no
				size = { 28 28 }
				texture = "gfx/interface/icons/location_icons/new/population.dds"
			}

			text_single = {
				using = layoutpolicy_expanding
				autoresize = no
				align = nobaseline
				text = "[InteractionTarget.GetArea.GetPrimaryCulturePercentage(SelectInteractionTargetView.GetPlayer.Self)|%]"
			}
		}
	}
}