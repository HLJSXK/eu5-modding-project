template town_rights_conquest_indicator_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "TOWN_RIGHTS_CONQUEST_HEADER"
		}
		blockoverride "title_icon" {
			widget = {
				using = tooltip_title_icon_size
				icon = {
					visible = "[InteractionTarget.GetTownRightsType.IsKeptAtConquest]"
					using = tooltip_title_icon_size
					parentanchor = center
					texture = "gfx/interface/icons/integration_levels/conquered.dds"
				}
				icon = {
					visible = "[Not(InteractionTarget.GetTownRightsType.IsKeptAtConquest)]"
					using = tooltip_title_icon_size
					parentanchor = center
					texture = "gfx/interface/icons/integration_levels/conquered.dds"
				}
			}
		}
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[InteractionTarget.GetTownRightsType.GetConquestTooltip]"
				}
			}
		}
	}
}

template town_rights_upgrade_indicator_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[InteractionTarget.GetTownRightsType.GetUpgradeHeader]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[TownRightsType.GetIcon]"
			}
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[TownRightsType.GetTooltip]"
			}
		}
	}
}

template town_rights_country_modifier_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "TOWN_RIGHTS_FOR_COUNTRY"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('country')]"
			}
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[InteractionTarget.GetTownRightsType.GetCountryModifierSummary]"
			}
		}
	}
}

types TownRightsTypes
{
	type town_rights_type = clickable_header_card {
		blockoverride "layout_setup" {
			using = flexible_interaction_target_entry_setup
		}

		blockoverride "header_size" {
			size = { -1 40 }
		}
		blockoverride "header_color" {
			using = color_government_texture
		}

		blockoverride "header_content" {
			using = select_interaction_target_action_provider
			datacontext = "[InteractionTarget.GetTownRightsType]"
			tooltipwidget = {
				using = TownRightsTypeSelectInteractionTargetGlue_tooltip
			}

			hbox = {
				margin_right = 10
				spacing = 10
				layoutpolicy_horizontal = expanding

				estate_privilege_action_button_alt = {
					size = { 40 40 }
					blockoverride "icon_texture" {
						texture = "[InteractionTarget.GetTownRightsType.GetIcon]"
					}
					blockoverride "estate_privilege_button_action" {
						tooltip_enabled = no
						using = select_interaction_target_action_provider
					}
				}

				text_single = {
					using = layoutpolicy_expanding
					using = Font_Size_Medium
					default_format = "#yellow_titles"
					autoresize = no
					size = { 200 18 }
					multiline = yes
					align = nobaseline
					text = "[InteractionTarget.GetTownRightsType.GetNameWithNoTooltip]"

					sort_by_left_fade_highlight = {
						name = "name"
					}
				}

				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 6

					icon = {
						visible = "[InteractionTarget.GetTownRightsType.HasCountryModifier]"
						size = { 24 24 }
						texture = "[GetConceptTexture('country')]"
						tooltipwidget = {
							using = town_rights_country_modifier_tooltip
						}
					}

					icon = {
						visible = "[InteractionTarget.GetTownRightsType.HasUpgradesTo]"
						datacontext = "[InteractionTarget.GetTownRightsType.GetUpgradesTo]"
						size = { 24 24 }
						texture = "[TownRightsType.GetIcon]"
						tooltipwidget = {
							using = town_rights_upgrade_indicator_tooltip
						}
					}

					widget = {
						size = { 24 24 }

						icon = {
							visible = "[InteractionTarget.GetTownRightsType.IsKeptAtConquest]"
							parentanchor = center
							size = { 24 24 }
							texture = "gfx/interface/icons/integration_levels/conquered.dds"
							tooltipwidget = {
								using = town_rights_conquest_indicator_tooltip
							}
						}

						icon = {
							visible = "[Not(InteractionTarget.GetTownRightsType.IsKeptAtConquest)]"
							parentanchor = center
							size = { 24 24 }
							texture = "gfx/interface/icons/integration_levels/conquered.dds"
							tooltipwidget = {
								using = town_rights_conquest_indicator_tooltip
							}
						}
					}
				}
			}
		}

		blockoverride "bottom_content_layout" {
			vbox = {
				using = bg_paper_card

				
				layoutpolicy_horizontal = expanding
				spacing = 5
				margin = { 5 5 }

				card_block_list = {
					textcontext =  "[InteractionTarget.GetTownRightsType.GetLocationModifierSummary][InteractionTarget.GetTownRightsType.GetDebugTooltip(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('location').GetLocation)]"
				}
			}
		}
	}
}