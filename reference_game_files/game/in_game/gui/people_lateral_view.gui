types SocietyView
{
	type CharacterNameDefault = hbox {
		# visible = "[Character.IsNameOrderDefault]"
		layoutpolicy_vertical = expanding
		block "character_name_default_extra"{}

		text_single = {
			using = layoutpolicy_expanding
			align = left
			margin = { 10 2 }

			block "charactername_size" {
				minimumsize = { 200 -1 }
				maximumsize = { 500 -1 }
			}

			# raw_text = "#prefix_name [Character.GetCharacterPrefixWithNoTooltip]#! #character_name [Character.GetFirstNameWithNoTooltip]#! #regnal_name [Character.GetCharacterRegnalNumWithNoTooltip]#! #nickname [Character.GetAdultNicknameWithNoTooltip]#! #lastname [Character.GetLastNameWithNoTooltip]#!#suffix_name , [Character.GetAge]#!"
			block "character_name_text" {
				text = "[Character.GetNameToFit('(int32)-1', '(bool)yes')|U], [Character.GetAge|T]"
			}
			block "name_highlight" {
				sort_by_left_fade_highlight = {
					name = "name"
				}
			}
		}
	}

	type PresentMovements = icon {
		texture = "gfx/interface/component_tiles/regular_banner.dds"
		texture_density = 2
		size = { 66 48 }
		visible = "[Player.HasAnyMovementPresent]"

		flowcontainer = {
			parentanchor = center
			position = { 3 -5}
			spacing = 2

			text_single = {
				minimumsize = { -1 26 }
				align = nobaseline|hcenter
				text = "[GetDataModelSize(GetAllMovements)]"
			}
			icon = {
				size = { 26 26 }
				texture = "[GetConceptTexture('movements')]"
				texture_density = 2

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						using = tooltip_title_icon_size
						texture = "[GetConceptTexture('movements')]"

						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.3
						}
					}
				}
				blockoverride "title_text" {
					raw_text = "game_concept_movements"
				}
				blockoverride "concept_link" {
					text = "[movements|e]"
				}
					
				blockoverride "tooltip_content" {
					TooltipScrolledRowList = {
						blockoverride "block_title" { visible = no }
						blockoverride "rowlist_datamodel_is_empty" { visible = "[IsDataModelEmpty(GetAllMovements)]"}
						blockoverride "rowlist_datamodel_has_items" { visible = "[DataModelHasItems(GetAllMovements)]"}
						blockoverride "rowlist_datamodel" { datamodel = "[GetAllMovements]" }
						blockoverride "visibility" { visible = "[Movement.IsCountryAffected(Player.Self)]" }
						blockoverride "rowlist_content" {
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 10
								text_single = {
									margin_left = 20
									text = "[Movement.GetName]"
								}
								widget = { 
									size = { 25 25 }
									piechart = {
										visible = "[Movement.IsCulture]"
										size = { 100% 100% }
										using = piechart_angles
										using = bg_circle_piechart
	
										pieslice = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
											value = "[FixedPointToFloat(Player.GetCulturePercentage(Movement.GetCulture))]"
											color = { 1 1 1 1 }
										}
	
										pieslice = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
											value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetCulturePercentage(Movement.GetCulture)))]"
											color = { 1 1 1 0 }
										}

										icon = {
											size = {65% 65%}
											parentanchor = center
											using = culture_icon
										}
									}
									piechart = {
										visible = "[Movement.IsReligion]"
										size = { 100% 100% }
										using = piechart_angles
										using = bg_circle_piechart
	
										pieslice = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
											value = "[FixedPointToFloat(Player.GetReligionPercentage(Movement.GetReligion))]"
											color = { 1 1 1 1 }
										}
	
										pieslice = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
											value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetReligionPercentage(Movement.GetReligion)))]"
											color = { 1 1 1 0 }
										}
										icon = {
											size = {65% 65%}
											parentanchor = center
											texture = "[GetReligionIcon(Movement.GetReligion)]"
										}
									}
									tooltipwidget = {
										using = movement_spread_tooltip
									}
								}

								expand = {}
							}
						}
		
						blockoverride "block_scrollarea" {
							maximumsize = { -1 210 }
						}
		
						blockoverride "row_size" {
							maximumsize = { -1 40 }
							minimumsize = { -1 40 }
						}
					}
				}
			}
		}
	}

