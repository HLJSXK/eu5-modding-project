													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	texture = "gfx/interface/icons/flat_icons/dynasty/head_of_dynasty.dds"
																}
															}
	
															blockoverride "title_text" {
																text = "game_concept_dynasty_head"
															}
	
															blockoverride "concept_link" {
																text = [dynasty_head|E]
															}
	
															blockoverride "tooltip_content" {
																TooltipTextBlock = {
																	blockoverride "text" {
																		text = "[Character.GetDynastyHeadTooltip]"
																	}
																}
															}
														}
													}
												}
											}
										}
										character_frame_small = {
											parentanchor = right|vcenter
											size = {67 79}
											visible = "[And(Not(Dynasty.GetDynastyHead.IsValid), Dynasty.GetDynastyFounder.IsValid)]"
											
											blockoverride "portrait_datacontext" {
												datacontext = "[Dynasty.GetDynastyFounder]"	
											}
											blockoverride "portrait_position" {position = { 0 -1 }}
											blockoverride "portrait_size" { size = { 85% 90% } }
	
											allow_outside = yes
											
											blockoverride "estate_icon" {
												visible = no
											}
											blockoverride "dynasty_shield" {}
	
											blockoverride "character_frame_texture" {
												texture = "gfx/interface/component_decoration/character_frames/character_non_stretchable_frame_2.dds"
											}
											blockoverride "character_portrait_visible" {
												visible = yes
											}
											blockoverride "character_portrait_ani_visible" {
												visible = no
											}
											blockoverride "character_frame_estate_visible" {
												visible = no
											}
	
											blockoverride "character_ribbon" {
												character_ribbon_1 = {
													visible = "[Character.HasRebel]"
													blockoverride "stretchable" {}
													blockoverride "ribbon color" {
														modify_texture = {
															using = color_black_texture
															blend_mode = overlay
														}
													}
												}
												character_ribbon_3 = {
													visible = "[And(Character.IsCivilWarRuler, Not(Character.HasRebel))]"
													blockoverride "stretchable" {}
													blockoverride "ribbon color" {
														modify_texture = {
															using = color_black_texture
															blend_mode = overlay
														}
													}
												}
												character_ribbon_3 = {
													visible = "[And3(Character.IsRuler, Not(Character.HasRebel), Not(Character.IsCivilWarRuler))]"
													blockoverride "stretchable" {}
												}
											}
											
											widget = {
												size = { 15 15 }
												parentanchor = hcenter|top
												position = {0 0}
	
												using = bg_circle_piechart
	
												icon = {
													size = {15 15}
													parentanchor = center
													texture = "gfx/interface/icons/flat_icons/dynasty/founder_of_dynasty.dds"
													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	texture = "gfx/interface/icons/flat_icons/dynasty/founder_of_dynasty.dds"
																}
															}
	
															blockoverride "title_text" {
																text = "game_concept_dynasty_founder"
															}
	
															blockoverride "concept_link" {
																text = [dynasty_founder|E]
															}
	
															blockoverride "tooltip_content" {
																TooltipTextBlock = {
																	blockoverride "text" {
																		text = "[Character.GetDynasty.GetDynastyFounder.GetUITooltip]"
																	}
																}
															}
														}
													}
												}
											}
										}
									}

								}
							}
						}
					}
				}
			}

			# MOVEMENTS
			vbox = {
				visible = "[CountryPeopleLateralView.Vars.HasValue('subtab','movements')]"
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				filtered_sorted_list = {
					datacontext = "[CountryPeopleLateralView.GetMovementsSortSearch]"

					using = bg_secondary_inner_image_alt
					blockoverride "image" {
						texture = "gfx/interface/illustrations/bg/bg_geopolitics.dds"
					}

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(CountryPeopleLateralView.GetMovements)]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "MOVEMENTS_LIST_EMPTY"
					}

					blockoverride "scroll_list_layout" {
						dynamicgridbox = {
							layoutpolicy_horizontal = expanding
							datamodel_reuse_widgets = yes
							resizetofit = yes
							datamodel = "[CountryPeopleLateralView.GetMovements]"
							item = {
								widget = {
									layoutpolicy_horizontal = expanding
									hbox = {
										layoutpolicy_horizontal = expanding
										set_parent_size_to_minimum = yes
										minimumsize = { 527 -1 }
										margin_left = 3
										margin_bottom = 10

										vbox = {
											layoutpolicy_horizontal = expanding
											bottomtotop = yes

											using = bg_paper_card

											background = {
												texture = "gfx/interface/component_overlay/disease_stains.dds"
												texture_density = 2
												alpha = 0.2
												modify_texture = {
													using = color_dark_brown_texture
												}
											}

											# BOTTOM CONTENT - Environmental movement when expanded
											widget = {
												visible = "[And(PeopleMovementItem.IsExpanded, PeopleMovementItem.IsEnvironmental)]"
												layoutpolicy_horizontal = expanding
												size = { -1 45 }
												using = environmental_movement_item
											}

											# BOTTOM CONTENT - Outbreaks list when expanded
											fixedgridbox =  {
												visible = "[And(PeopleMovementItem.IsExpanded, Not(PeopleMovementItem.IsEnvironmental))]"
												layoutpolicy_horizontal = expanding
												size = { -1 -1 }
												addcolumn = 100%
												addrow = 100
												datamodel_reuse_widgets = yes
												resizetofit = yes
												datamodel = "[PeopleMovementItem.GetOutbreaks]"
												item = {
													widget = {
														size = { 100% 80 }
														layoutpolicy_horizontal = expanding
														datacontext = "[Movement]"
														using = movement_entry_card
													}
												}
											}

											# TOP CONTENT - Clickable header
											widget = {
												layoutpolicy_horizontal = expanding
												size = { -1 40 }

												clickable_header_card = {
													using = bg_card_header_01
													blockoverride "bg_card_header_01_bg" {
														background = {
															using = bg_card_header_01_default
															alpha = 0.6
														}
													}
													blockoverride "header_color" {
														using = color_society_texture
													}
													using = bg_movement_header
													blockoverride "header_bg" {}
													blockoverride "clickable_header_card_size"{
														size = { 100% 40 }
													}
													blockoverride "header_size" {
														size = {-1 40 }
													}
													blockoverride "header_content" {
														enabled = "[Or(GreaterThan_int32(PeopleMovementItem.GetNumOutbreaks, '(int32)0'), And(PeopleMovementItem.IsEnvironmental, PeopleMovementItem.IsCountryAffected))]"
														action_tooltip = {
															title = "TOGGLE_MOVEMENT"
															conditions = "[AddLocalizationIf(Not(Or(GreaterThan_int32(PeopleMovementItem.GetNumOutbreaks, '(int32)0'), And(PeopleMovementItem.IsEnvironmental, PeopleMovementItem.IsCountryAffected))), 'NO_MOVEMENT_OUTBREAK')]"
															enabled = "[Or(GreaterThan_int32(PeopleMovementItem.GetNumOutbreaks, '(int32)0'), And(PeopleMovementItem.IsEnvironmental, PeopleMovementItem.IsCountryAffected))]"
															on_action = "[PeopleMovementItem.Toggle]"
														}

														tooltipwidget = { BasicFunctionalTooltip = {} }

														widget = {
															size = {100% 100%}
															hbox = {
																margin_left = 1
																margin_right = 10
																spacing = 10
																widget = {
																	using = bg_movement_icon
																	size = { 38 38 }
																	icon = {
																		parentanchor = center
																		position = {0 -1}
																		size = { 32 32}
																		texture = "[GetMovementDefinitionIcon(PeopleMovementItem.GetMovement)]"

																		background = {
																			texture = "[GetMovementDefinitionIcon(PeopleMovementItem.GetMovement)]"
																			texture_density = 2
																			margin = { 2 2 }
																			margin_bottom = 3
																			alpha = 0.4
																			modify_texture = {
																				using = color_black_texture
																				blend_mode = multiply
																			}
																		}
																	}
																}

																text_single = {
																	maximumsize = {150 20}
																	align = left|nobaseline
																	using = Font_Type_Headers
																	using = Font_Size_Small
																	alwaystransparent = no
																	margin_left = 12
																	text = "[PeopleMovementItem.GetName]"

																	sort_by_highlight = {
																		name = "name"
																	}
																}

																expand = {}

																text_single = {
																	maximumsize = { 40 20 }
																	align = center|nobaseline
																	text = "[PeopleMovementItem.GetNumOutbreaks]"
																	fontsize = 14

																	sort_by_highlight = {
																		name = "outbreaks_amount"
																	}
																}

																icon = {
																	size = { 18 18 }
																	visible = "[Not(PeopleMovementItem.IsExpanded)]"
																	texture = "gfx/interface/buttons/flats/button_simple_right.dds"
																	using = button_regular_icon_color
																}

																icon = {
																	size = { 18 18 }
																	visible = "[PeopleMovementItem.IsExpanded]"
																	texture = "gfx/interface/buttons/flats/button_simple_down.dds"
																	using = button_regular_icon_color
																}
															}
														}
													}
													blockoverride "bottom_content" {}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

template movement_entry_card {
	widget = {
		size = { 100% 100% }
		using = bg_paper_card

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin = { 8 6 }

			widget = {
				size = { 38 38 }
				icon = {
					size = { 100% 100% }
					texture = "[GetMovementDefinitionIcon(Movement.GetMovementDefinition)]"
					texture_density = 2

					sort_by_highlight = {
						name = "name"
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				text_single = {
					layoutpolicy_horizontal = expanding
					align = left|nobaseline
					using = Font_Type_Headers
					using = Font_Size_Small
					text = "[Movement.GetName]"

					sort_by_highlight = {
						name = "name"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[Movement.IsCountryAffected(Player.Self)]"
					spacing = 8

					widget = {
						size = { 25 25 }
						piechart = {
							visible = "[Movement.IsCulture]"
							size = { 100% 100% }
							using = piechart_angles
							using = bg_circle_piechart

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
								value = "[FixedPointToFloat(Player.GetCulturePercentage(Movement.GetCulture))]"
								color = { 1 1 1 1 }
							}
							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetCulturePercentage(Movement.GetCulture)))]"
								color = { 1 1 1 0 }
							}
							icon = {
								size = {65% 65%}
								parentanchor = center
								using = culture_icon
							}
						}
						piechart = {
							visible = "[Movement.IsReligion]"
							size = { 100% 100% }
							using = piechart_angles
							using = bg_circle_piechart

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
								value = "[FixedPointToFloat(Player.GetReligionPercentage(Movement.GetReligion))]"
								color = { 1 1 1 1 }
							}
							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetReligionPercentage(Movement.GetReligion)))]"
								color = { 1 1 1 0 }
							}
							icon = {
								size = {65% 65%}
								parentanchor = center
								texture = "[GetReligionIcon(Movement.GetReligion)]"
							}
						}
						tooltipwidget = {
							using = movement_spread_tooltip
						}
					}

					text_single = {
						visible = "[Movement.IsCountryAffected(Player.Self)]"
						align = left|nobaseline
						text = "MOVEMENT_SPREAD"
						default_format = "#subtle_name"
					}

					expand = {}
				}
			}

			expand = {}

			country_flag_small = {
				visible = "[Movement.IsCountryAffected(Player.Self)]"
				datacontext = "[Player]"
			}
		}

		tooltipwidget = {
			using = movement_spread_tooltip
		}
	}
}

template movement_outbreaks_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetConceptTexture('movements')]"
		}


		blockoverride "title_text" {
			text = "MOVEMENT_OUTBREAK_COUNTRY_AMOUNT_TITLE"
		}

		blockoverride "concept_link" {
			text = [movement|E]
		}
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[Not(GreaterThan_int32(GetDataModelSize(PeopleMovementItem.GetCountryOutbreaks), '(int32)0'))]"
				blockoverride "text" {
					text = "NO_MOVEMENT_OUTBREAK_IN_COUNTRY"
				}
			}

			TooltipListBase = {
				TooltipListScrollArea = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 400 }
					}
					blockoverride "scrollarea_content" {
						fixedgridbox = {
							addcolumn = 420
							addrow = 80
							setitemsizefromcell = yes
							datamodel = "[PeopleMovementItem.GetCountryOutbreaks]"
							item = {
								widget = {
									size = { 100% 80 }
									layoutpolicy_horizontal = expanding
									using = movement_entry_card
								}
							}
						}
					}
				}
			}
		}
	}
}

template environmental_movement_item {
	vbox = {
		bottomtotop = yes
		margin = {5 0}

		# BOTTOM INFO
		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 35 }

			blockoverride "card_texture_extra" {}

			hbox = {

				hbox = {
					layoutpolicy_vertical = expanding
					visible = "[Not(GreaterThan_int32(PeopleMovementItem.GetAffectedCountryLocations, '(int32)0'))]"
					using = disease_card_rotten_tile
					blockoverride "disease_card_tile_color" {
						modify_texture = {
							using = color_geopolitics_texture
						}
						modify_texture = {
							using = overlay_cloth_texture
							blend_mode = overlay
							alpha = 0.1
						}
					}
					using = bg_square_fade_horizontal
					blockoverride "square_fade_extra" {
						alpha = 0.2
					}
					margin_left = 5

					text_single = {
						text = "NO_DISEASE_OUTBREAK_IN_COUNTRY"
						align = left|nobaseline
						maximumsize = {200 20}
					}
				}

				expand = {}

				hbox = {
					visible = "[GreaterThan_int32(PeopleMovementItem.GetAffectedCountryLocations, '(int32)0')]"
					layoutpolicy_horizontal = expanding
					spacing = 5

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin_left = 8
						using = bg_movement_spec

						text_single = {
							text = "[PeopleMovementItem.GetAffectedCountryLocationsInfo]"
							maximumsize = {200 20}
							align = left|nobaseline
						}

						tooltipwidget = {
							using = movement_outbreaks_tooltip
						}
						expand = {}
					}


					widget = { 
						size = { 25 25 }
						datacontext = "[PeopleMovementItem.GetMovement]"
						piechart = {
							visible = "[MovementDefinition.IsCulture]"
							size = { 100% 100% }
							using = piechart_angles
							using = bg_circle_piechart

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
								value = "[FixedPointToFloat(Player.GetCulturePercentage(MovementDefinition.GetCulture))]"
								color = { 1 1 1 1 }
							}

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetCulturePercentage(MovementDefinition.GetCulture)))]"
								color = { 1 1 1 0 }
							}

							icon = {
								size = {65% 65%}
								parentanchor = center
								using = culture_icon
							}
						}
						piechart = {
							visible = "[MovementDefinition.IsReligion]"
							size = { 100% 100% }
							using = piechart_angles
							using = bg_circle_piechart

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
								value = "[FixedPointToFloat(Player.GetReligionPercentage(MovementDefinition.GetReligion))]"
								color = { 1 1 1 1 }
							}

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetReligionPercentage(MovementDefinition.GetReligion)))]"
								color = { 1 1 1 0 }
							}
							icon = {
								size = {65% 65%}
								parentanchor = center
								texture = "[GetReligionIcon(MovementDefinition.GetReligion)]"
							}
						}
						tooltipwidget = {
							using = movement_definition_spread_tooltip
						}
					}

				}
			}
		}

		# # TOP INFO
