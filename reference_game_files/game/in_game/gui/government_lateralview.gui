	type law_item_icon = widget {
		size = { 36 36 }
		using = bg_law_category_frame

		icon = {
			size = { 90% 90% }
			parentanchor = center
			block "law_list_icon" {
				# texture = "[GetLawIcon(Law.Self)]"
