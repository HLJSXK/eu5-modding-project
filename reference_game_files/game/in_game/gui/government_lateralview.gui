			size = { 100% 100% }
			name = "tab_bureaucracies"
		}
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabBureaucraciesTooltip
		}
		visible = "[PlayerHasBureaucracies]"

		down = "[IsLateralViewOpened('bureaucracies')]"
		datacontext = "[GetAutomatedSystemItem('bureaucracy')]"
