template disease_banner_small {
	icon = {
		visible = "[GreaterThan_int32(PossibleDisease.GetCountryNumOutbreaks, '(int32)0')]"
		size = { 36 62 }
		texture = "gfx/interface/alerts/alert_red.dds"
		alwaystransparent = no

		tooltipwidget = {
			using = disease_banner_tooltip
		}

		vbox = {
			alwaystransparent = yes
			size = { 100% 100% }
			margin_top = 6
			margin_bottom = 12

			hbox = {
				layoutpolicy_horizontal = expanding

				expand = {}

				icon = {
					size = { 18 18 }
					texture = "[GetDiseaseIcon(PossibleDisease.GetDisease)]"
					texture_density = 2
				}

				expand = {}
			}

			expand = {}

			text_single = {
				text = "[PossibleDisease.GetPlayerDeathsInfo]"
				layoutpolicy_horizontal = expanding
				size = { -1 20 }
				autoresize = no
				align = center
				using = Font_Type_Headers
				fontsize = 16
				default_format = "#color_white"
			}
		}
	}
}

template disease_banner_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetDiseaseIcon(PossibleDisease.GetDisease)]"
		}

		blockoverride "title_text" {
			text = "OUTBREAK_AMOUNT_COUNTRY_POPULATION_DEATH_TITLE"
		}

		blockoverride "concept_link" {
			text = [disease|E]
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "DISEASE_BANNER_TT_DESC"
				}
			}

			TooltipStringPairList = {
				textcontext = "DISEASE_BANNER_TT_BODY"
			}
		}
	}
}

society_view = {
	name = "turmoils_lateral_view"
	widgetid = "turmoils_lateral_view"

	blockoverride "lateral_view_content" {
		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 52 }
			hbox = {
				datacontext = "[Player]"

				subheader_unified_icon = {
					margin_left = 10
					blockoverride "subheader_unified_icon_texture" {
						texture = "gfx/interface/icons/military_objectives/rebels.dds"
					}
					blockoverride "subheader_unified_top_text" {
						text = "PEOPLE_LATERAL_VIEW_REBELS"
						align = nobaseline
					}
					blockoverride "subheader_unified_bottom_text" {
						text = "[GetDataModelSize(CountryTurmoilsLateralView.GetRebels)]"
						align = nobaseline
					}
					datacontext = "[GC('rebels')]"
					tooltipwidget = {
						using = game_concept_tooltip
					}
				}

				expand = {}

				subheader_unified_icon = {
					blockoverride "mirror_layout" { righttoleft = yes }
					blockoverride "subheader_unified_icon_texture" {
						texture = "[GetConceptTexture('movements')]"
					}
					blockoverride "subheader_unified_top_text" {
						text = "game_concept_movements"
						align = right|nobaseline
					}
					blockoverride "subheader_unified_bottom_text" {
						text = "[GetDataModelSize(CountryTurmoilsLateralView.GetMovements)]"
						align = right|nobaseline
					}
					datacontext = "[GC('movements')]"
					tooltipwidget = {
						using = game_concept_tooltip
					}
				}
			}
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 220 }

			hbox = {
				ecs_scene_viewer_widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					name = "balance_overview_scene"
					scene = "[CountryTurmoilsLateralView.GenerateSceneDesc]"
					alpha = 1

					using = scene_fade_horizontal
				}
			}

			using = bg_age_event_frame

			hbox = {
				margin = { 8 0 }

				vbox = {
					using = layoutpolicy_expanding

					icon_text_2rows = {
						blockoverride "icon_setup" {
							texture = "gfx/interface/icons/flat_icons/geography/rebels_growth.dds"
							texture_density = 2
						}
						blockoverride "top_text_setup" {
							text = "MODIFIER_TYPE_NAME_monthly_rebel_growth"
							default_format = "#explanation_link_overview"
						}
						blockoverride "bottom_text_setup" {
							raw_text = "[Player.GetModifierValueNoFormat('monthly_rebel_growth')]"
						}
						datacontext = "[Player]"
						tooltipwidget = {
							using = rebel_growth_tooltip
						}
					}

					icon_text_2rows = {
						blockoverride "icon_setup" {
							texture = "gfx/interface/icons/flat_icons/geography/separatism.dds"
							glow = {
								name = "drop_shadow"
								glow_radius = 3
								color = {0.0 0.0 0.0 1.0}
								alpha = 0.3
							}
						}
						blockoverride "top_text_setup" {
							text = "game_concept_separatism"
							default_format = "#explanation_link_overview"
						}
						blockoverride "bottom_text_setup" {
							raw_text = "[Player.GetModifierValueNoFormat('global_separatism')]"
						}
						datacontext = "[Player]"
						tooltipwidget = {
							using = global_separatism_tooltip
						}
					}
				}

				expand = {}

				vbox = {
					using = layoutpolicy_expanding

					icon_text_2rows = {
						blockoverride "base_setup" {
							righttoleft = yes
						}
						blockoverride "icon_setup" {
							texture = "gfx/interface/icons/situations/black_death.dds"
							texture_density = 2
						}
						blockoverride "top_text_setup" {
							align = right|nobaseline
							text = "DISEASES_TAB"
							default_format = "#explanation_link_overview"
						}
						blockoverride "bottom_text_setup" {
							align = right|nobaseline
							text = "[CountryTurmoilsLateralView.GetAmountAffectingDiseases]"
						}
						datacontext = "[GC('disease_outbreaks')]"
						tooltipwidget = {
							using = game_concept_tooltip
						}
					}

					icon_text_2rows = {
						blockoverride "base_setup" {
							righttoleft = yes
						}
						blockoverride "icon_setup" {
							texture = "gfx/interface/icons/flat_icons/geopolitics/disease_resistance.dds"
							texture_density = 2
						}
						blockoverride "top_text_setup" {
							align = right|nobaseline
							text = "game_concept_disease_resistance"
							default_format = "#explanation_link_overview"
						}
						blockoverride "bottom_text_setup" {
							align = right|nobaseline
							raw_text = "[Player.GetModifierValueNoFormat('global_disease_resistance')]"
						}
						datacontext = "[Player]"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "DISEASE_RESISTANCE_TT_HEADER"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/geopolitics/disease_resistance.dds"
									}
								}
								blockoverride "concept_link" {
									text = [disease_resistance|e]
								}
								blockoverride "tooltip_content" {
									TooltipStringPairList = {
										textcontext = "[Player.GetDescriptionFor('global_disease_resistance')]"
									}
								}
							}
						}
					}

					icon_text_2rows = {
						blockoverride "base_setup" {
							righttoleft = yes
						}
						blockoverride "icon_setup" {
							texture = "gfx/interface/icons/flat_icons/geopolitics/privateer.dds"
							texture_density = 2
						}
						blockoverride "top_text_setup" {
							align = right|nobaseline
							text = "TOTAL_DEATHS"
							default_format = "#explanation_link_overview"
						}
						blockoverride "bottom_text_setup" {
							align = right|nobaseline
							text = "[CountryTurmoilsLateralView.GetTotalDeathsLabel]"
							default_format = "#color_red"
						}
						datacontext = "[Player]"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "TOTAL_DEATH_TT_HEADER"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/geopolitics/privateer.dds"
									}
								}
								blockoverride "concept_link" {
									text = [disease|e]
								}
								blockoverride "tooltip_content" {
									TooltipStringPairList = {
										textcontext = "[CountryTurmoilsLateralView.GetTotalDeathsInfo]"
									}
								}
							}
						}
					}
				}
			}

			flowcontainer = {
				parentanchor = top|hcenter
				margin_top = 0
				spacing = 2
				ignoreinvisible = yes
				datamodel = "[CountryTurmoilsLateralView.GetPossibleDiseases]"
				item = {
					using = disease_banner_small
				}
			}
		}

		header_secondary_tabs = {
			blockoverride "content" {
				button_secondary_tab_alt = {
					using = layoutpolicy_expanding
					blockoverride "tab_text"{
						text = "PEOPLE_LATERAL_VIEW_REBELS"
					}
					action_tooltip = {
						title = "OPEN_TAB"
						on_action = "[CountryTurmoilsLateralView.Vars.Set('subtab','rebels')]"
					}
					down = "[CountryTurmoilsLateralView.Vars.NotExistOrHasValue('subtab', 'rebels')]"
					tooltipwidget = {
						using = TabPeopleRebelsTooltip
					}
				}

				button_secondary_tab_alt = {
					using = layoutpolicy_expanding
					visible = "[HasAnyVisibleMovementDefinitions]"
					blockoverride "tab_text"{
						text = "PEOPLE_LATERAL_VIEW_MOVEMENTS"
					}
					action_tooltip = {
						title = "OPEN_TAB"
						on_action = "[CountryTurmoilsLateralView.Vars.Set('subtab','movements')]"
					}
					down = "[CountryTurmoilsLateralView.Vars.HasValue('subtab','movements')]"
					tooltipwidget = {
						using = TabPeopleMovementsTooltip
					}
				}

				button_secondary_tab_alt = {
					using = layoutpolicy_expanding
					blockoverride "tab_text"{
						text = "DISEASES_TAB"
					}
					action_tooltip = {
						title = "OPEN_TAB"
						on_action = "[CountryTurmoilsLateralView.Vars.Set('subtab','outbreaks')]"
					}
					down = "[CountryTurmoilsLateralView.Vars.HasValue('subtab','outbreaks')]"
					tooltipwidget = {
						using = TabDiseasesTooltip
					}
				}
			}
		}

		vbox = {
			visible = "[CountryTurmoilsLateralView.Vars.NotExistOrHasValue('subtab','rebels')]"
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = bg_secondary_inner_alt
			using = bg_secondary_inner_image_alt

			filtered_sorted_list = {
				datacontext = "[CountryTurmoilsLateralView.GetRebelsSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(CountryTurmoilsLateralView.GetRebels)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "REBELS_LIST_EMPTY"
				}

				blockoverride "scroll_list_content" {
					datamodel = "[CountryTurmoilsLateralView.GetRebels]"
					addcolumn = 100%
					addrow = 60
					datamodel_reuse_widgets = yes
					item = {
						widget = {
							size = { 100% 60 }

							alwaystransparent = no
							datacontext = "[PeopleRebelItem.GetRebel]"
							onmousehierarchyenter = "[PdxGuiWidget.SetHighlightRebel(PeopleRebelItem.GetRebel.Self)]"

							widget = {
								parentanchor = center
								size = { 98% 55 }
								background = {
									texture = "gfx/interface/buttons/card_list_action_button.dds"
									frame_grid = { 4 1 }
									spriteType = Corneredstretched
									texture_density = 2
									spriteborder = { 40 40 }
									frame = 3
									modify_texture = {
										using = overlay_cloth_texture
										blend_mode = overlay
										alpha = 0.1
									}
									modify_texture = {
										using = overlay_paper_03
										blend_mode = overlay
										alpha = 0.2
									}
								}

								button = {
									name = "rebel_button"
									size = { 100% 100% }

									visible = "[PdxGuiWidget.IsUberButtonVisible]"
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

									gfxtype = framedbuttongfx
									effectname = "NoHighlight"
									upframe = 1
									overframe = 2
									downframe = 3
									disableframe = 4
									texture = "gfx/interface/buttons/card_list_action_button.dds"
									frame_grid = {4 1}
									spriteType = Corneredstretched
									texture_density = 2
									spriteborder = { 40 40 }

									modify_texture = {
										using = overlay_cloth_texture
										blend_mode = overlay
										alpha = 0.1
									}
									modify_texture = {
										using = overlay_paper_03
										blend_mode = overlay
										alpha = 0.2
									}

									tooltipwidget = {
										using = Rebel_tooltip
									}

									action_tooltip = {
										click_type = left
										click_mode = single
										title = "OUTLINER_ITEM_SOCIETY_REBELS_TOOLTIP"
										on_action = "[ShowRebel(PeopleRebelItem.GetRebel.Self)]"
									}
									scripted_action_tooltip = {
										click_type = right
										click_mode = confirm
										action_name = "provoke_rebels"
										actor = "[CountryTurmoilsLateralView.GetPlayer]"
										parameter = {
											parameter_name = "target"
											parameter_value = "[PeopleRebelItem.GetRebel]"
										}
									}

									hbox = {
										parentanchor = center
										using = layoutpolicy_expanding
										datacontext = "[PeopleRebelItem.GetRebel]"

										alwaystransparent = yes
										margin = { 16 4 }
										margin_right = 13
										spacing = 10

										icon = {
											size = { 32 32 }
											texture = "[GetRebelsIcon(PeopleRebelItem.GetRebel.Self)]"

											sort_by_highlight = {
												name = "category"
											}
										}

										divider_flavor_03 = {
											size = { 8 -1 }
										}

										vbox = {
											using = layoutpolicy_expanding
											text_single = {
												using = layoutpolicy_expanding
												autoresize = no
												align = left|nobaseline
												text = "[PeopleRebelItem.GetRebel.GetNameWithNoTooltip]"

												default_format = "#yellow_titles"

												sort_by_left_fade_highlight = {
													name = "name"
												}
											}

											hbox = {
												using = layoutpolicy_expanding
												country_flag_very_small = {
													datacontext = "[PeopleRebelItem.GetRebel.GetOwner]"
												}
												text_single = {
													using = layoutpolicy_expanding
													autoresize = no
													align = left|nobaseline
													using = Font_Size_Very_Small
													raw_text = "@population! [PeopleRebelItem.GetRebel.GetPopulationSupportTotal|V]"

													sort_by_left_fade_highlight = {
														name = "size"
													}
												}
											}
										}

										divider_flavor_03 = {
											size = { 8 -1 }
										}

										hbox = {
											minimumsize = { 35 35 }
											using = bg_number_container_bckg
											icon = {
												visible = "[And(Not(PeopleRebelItem.GetRebel.IsTiny('(bool)no')), Not(PeopleRebelItem.GetRebel.WantsCivilWar))]"
												size = { 28 28 }
												texture = "gfx/interface/icons/alerts_icons/imminent_revolt.dds"

												datacontext = "[GC('revolt')]"
												tooltipwidget = {
													using = game_concept_tooltip
												}

												sort_by_highlight = {
													name = "objective"
												}
											}
											icon = {
												visible = "[And(Not(PeopleRebelItem.GetRebel.IsTiny('(bool)no')), PeopleRebelItem.GetRebel.WantsCivilWar)]"
												size = { 28 28 }
												texture = "gfx/interface/icons/diplomatic_status/civil_war.dds"

												datacontext = "[GC('civil_war')]"
												tooltipwidget = {
													using = game_concept_tooltip
												}

												sort_by_highlight = {
													name = "objective"
												}
											}
											icon = {
												visible = "[PeopleRebelItem.GetRebel.IsTiny('(bool)no')]"
												size = { 20 20 }
												texture = "[GetConceptTexture('minor_revolt')]"

												datacontext = "[GC('minor_revolt')]"
												tooltipwidget = {
													using = game_concept_tooltip
												}

												sort_by_highlight = {
													name = "objective"
												}
											}
										}

										divider_flavor_03 = {
											size = { 8 -1 }
										}

										hbox = {
											using = bg_number_container_bckg

											blockoverride "number_container_extra" {
												margin = { 6 5 }
											}

											text_single = {
												size = { 30 30 }
												autoresize = no
												align = center|nobaseline
												text = "[PeopleRebelItem.GetRebel.GetSupportersCount]"

												tooltipwidget = {
													using = RebelSupporters_tooltip
												}

												sort_by_highlight = {
													name = "country"
												}
											}
										}

										divider_flavor_03 = {
											size = { 8 -1 }
										}

										vbox = {
											text_single = {
												size = { 60 30 }
												autoresize = no
												align = center|nobaseline
												text = "[PeopleRebelItem.GetRebel.GetProgress|2%R]"

												sort_by_highlight = {
													name = "current_progress"
												}
											}

											progressbar = {
												size = { 60 10 }
												using = morale_progressbar_bar
												value = "[Multiply_float(FixedPointToFloat(PeopleRebelItem.GetRebel.GetProgress), '(float)100')]"

												sort_by_highlight = {
													name = "current_progress"
												}
											}
										}

										expand = {}

										hbox = {
											using = bg_number_container_bckg

											blockoverride "number_container_extra" {
												margin = { 6 5 }
											}

											text_single = {
												size = { 60 30 }
												autoresize = no
												align = center|nobaseline
												text = "[PeopleRebelItem.GetRebel.GetMonthlyChange|-=2%]"

												datacontext = "[PeopleRebelItem.GetRebel]"

												tooltipwidget = {
													using = RebelMonthly_tooltip
												}

												sort_by_highlight = {
													name = "change"
												}
											}
										}

										divider_flavor_03 = {
											size = { 8 -1 }
										}

										button_checkbox = {
											name = "suppress_priority_button"
											size = { 30 30 }
											down = "[PeopleRebelItem.GetSuppressPriority]"
											enabled = "[PeopleRebelItem.CanSuppressPriority]"
											action_tooltip = {
												enabled = "[PeopleRebelItem.CanSuppressPriority]"
												title = "[SelectLocalization(Rebel.IsSuppressPriority, 'REBEL_SUPPRESS_PRIORITY_UNMARK', 'REBEL_SUPPRESS_PRIORITY_MARK')]"
												on_action = "[PeopleRebelItem.ToggleSuppressPriority]"
											}
											tooltipwidget = {
												using = RebelSuppressPriority_tooltip
											}
										}
									}
								}

								country_flag_small = {
									alwaystransparent = no

									size = { 24 16 }
									position = { 5 33 }
									visible = "[PeopleRebelItem.GetRebel.HasSupportersInfo]"
									datacontext = "[PeopleRebelItem.GetRebel.GetMostPowerfulSupporter]"
								}
							}
						}
					}
				}
			}
		}

		vbox = {
			visible = "[CountryTurmoilsLateralView.Vars.HasValue('subtab','movements')]"
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = bg_secondary_inner_alt
			using = bg_secondary_inner_image_alt

			filtered_sorted_list = {
				datacontext = "[CountryTurmoilsLateralView.GetMovementsSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(CountryTurmoilsLateralView.GetMovements)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MOVEMENTS_LIST_EMPTY"
				}

				blockoverride "scroll_list_layout" {
					dynamicgridbox = {
						layoutpolicy_horizontal = expanding
						datamodel_reuse_widgets = yes
						resizetofit = yes
						datamodel = "[CountryTurmoilsLateralView.GetMovements]"
						item = {
							widget = {
								layoutpolicy_horizontal = expanding
								hbox = {
									layoutpolicy_horizontal = expanding
									set_parent_size_to_minimum = yes
									minimumsize = { 527 -1 }
									margin_left = 3
									margin_bottom = 10

									vbox = {
										layoutpolicy_horizontal = expanding
										bottomtotop = yes

										using = bg_paper_card

										background = {
											texture = "gfx/interface/component_overlay/disease_stains.dds"
											texture_density = 2
											alpha = 0.2
											modify_texture = {
												using = color_dark_brown_texture
											}
										}

										widget = {
											visible = "[And(PeopleMovementItem.IsExpanded, PeopleMovementItem.IsEnvironmental)]"
											layoutpolicy_horizontal = expanding
											size = { -1 45 }
											using = environmental_movement_item
										}

										fixedgridbox =  {
											visible = "[And(PeopleMovementItem.IsExpanded, Not(PeopleMovementItem.IsEnvironmental))]"
											layoutpolicy_horizontal = expanding
											size = { -1 -1 }
											addcolumn = 100%
											addrow = 100
											datamodel_reuse_widgets = yes
											resizetofit = yes
											datamodel = "[PeopleMovementItem.GetOutbreaks]"
											item = {
												widget = {
													size = { 100% 80 }
													layoutpolicy_horizontal = expanding
													datacontext = "[Movement]"
													using = movement_entry_card
												}
											}
										}

										widget = {
											layoutpolicy_horizontal = expanding
											size = { -1 40 }

											clickable_header_card = {
												using = bg_card_header_01
												blockoverride "bg_card_header_01_bg" {
													background = {
														using = bg_card_header_01_default
														alpha = 0.6
													}
												}
												blockoverride "header_color" {
													using = color_society_texture
												}
												using = bg_movement_header
												blockoverride "header_bg" {}
												blockoverride "clickable_header_card_size"{
													size = { 100% 40 }
												}
												blockoverride "header_size" {
													size = {-1 40 }
												}
												blockoverride "header_content" {
													enabled = "[Or(GreaterThan_int32(PeopleMovementItem.GetNumOutbreaks, '(int32)0'), And(PeopleMovementItem.IsEnvironmental, PeopleMovementItem.IsCountryAffected))]"
													action_tooltip = {
														title = "TOGGLE_MOVEMENT"
														conditions = "[AddLocalizationIf(Not(Or(GreaterThan_int32(PeopleMovementItem.GetNumOutbreaks, '(int32)0'), And(PeopleMovementItem.IsEnvironmental, PeopleMovementItem.IsCountryAffected))), 'NO_MOVEMENT_OUTBREAK')]"
														enabled = "[Or(GreaterThan_int32(PeopleMovementItem.GetNumOutbreaks, '(int32)0'), And(PeopleMovementItem.IsEnvironmental, PeopleMovementItem.IsCountryAffected))]"
														on_action = "[PeopleMovementItem.Toggle]"
													}

													tooltipwidget = { BasicFunctionalTooltip = {} }

													widget = {
														size = {100% 100%}
														hbox = {
															margin_left = 1
															margin_right = 10
															spacing = 10
															widget = {
																using = bg_movement_icon
																size = { 38 38 }
																icon = {
																	parentanchor = center
																	position = {0 -1}
																	size = { 32 32}
																	texture = "[GetMovementDefinitionIcon(PeopleMovementItem.GetMovement)]"

																	background = {
																		texture = "[GetMovementDefinitionIcon(PeopleMovementItem.GetMovement)]"
																		texture_density = 2
																		margin = { 2 2 }
																		margin_bottom = 3
																		alpha = 0.4
																		modify_texture = {
																			using = color_black_texture
																			blend_mode = multiply
																		}
																	}
																}
															}

															text_single = {
																maximumsize = {150 20}
																align = left|nobaseline
																using = Font_Type_Headers
																using = Font_Size_Small
																alwaystransparent = no
																margin_left = 12
																text = "[PeopleMovementItem.GetName]"

																sort_by_highlight = {
																	name = "name"
																}
															}

															expand = {}

															text_single = {
																maximumsize = { 40 20 }
																align = center|nobaseline
																text = "[PeopleMovementItem.GetNumOutbreaks]"
																fontsize = 14

																sort_by_highlight = {
																	name = "outbreaks_amount"
																}
															}

															icon = {
																size = { 18 18 }
																visible = "[Not(PeopleMovementItem.IsExpanded)]"
																texture = "gfx/interface/buttons/flats/button_simple_right.dds"
																using = button_regular_icon_color
															}

															icon = {
																size = { 18 18 }
																visible = "[PeopleMovementItem.IsExpanded]"
																texture = "gfx/interface/buttons/flats/button_simple_down.dds"
																using = button_regular_icon_color
															}
														}
													}
												}
												blockoverride "bottom_content" {}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}

		vbox = {
			visible = "[CountryTurmoilsLateralView.Vars.HasValue('subtab','outbreaks')]"
			using = layoutpolicy_expanding
			using = bg_secondary_inner_alt
			using = bg_secondary_inner_image_alt

			widget = {
				using = layoutpolicy_expanding
				vbox = {
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 5 10 }
						button_regular = {
							layoutpolicy_horizontal = expanding
							size = { -1 30 }

							text = "BUILD_PLAGUE_BUILDINS"

							action_tooltip = {
								click_type = left
								click_mode = single
								title = "BUILD_PLAGUE_BUILDINS"
								on_action = "[OpenLateralViewWithFilter('production', 'local_disease_resistance')]"
							}

							tooltipwidget = { BasicFunctionalTooltip = {} }

							icon = {
								size = { 22 22 }
								parentanchor = left|vcenter
								position = { 10 0 }
								texture = "gfx/interface/icons/modifier_types/local_disease_resistance.dds"
								texture_density = 2
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.3
								}
							}
						}
					}

					filtered_sorted_list = {
						datacontext = "[CountryTurmoilsLateralView.GetPossibleDiseasesSortSearch]"

						blockoverride "scroll_list_is_empty" {
							visible = no
						}

						blockoverride "scroll_list_layout" {
							dynamicgridbox = {
								layoutpolicy_horizontal = expanding
								datamodel_reuse_widgets = yes
								resizetofit = yes
								datamodel = "[CountryTurmoilsLateralView.GetPossibleDiseases]"
								item = {
									widget = {
										layoutpolicy_horizontal = expanding
										hbox = {
											layoutpolicy_horizontal = expanding
											set_parent_size_to_minimum = yes
											minimumsize = { 527 -1 }
											margin_left = 3
											margin_bottom = 10

											vbox = {
												layoutpolicy_horizontal = expanding
												bottomtotop = yes

												using = bg_paper_card

												background = {
													texture = "gfx/interface/component_overlay/disease_stains.dds"
													texture_density = 2
													alpha = 0.2
													modify_texture = {
														using = color_dark_brown_texture
													}
												}

												widget = {
													visible = "[And(PossibleDisease.IsExpanded, PossibleDisease.IsEnvironmental)]"
													layoutpolicy_horizontal = expanding
													size = { -1 85 }
													using = environmental_disease_item
												}

												fixedgridbox = {
													visible = "[And(PossibleDisease.IsExpanded, Not(PossibleDisease.IsEnvironmental))]"
													layoutpolicy_horizontal = expanding
													size = { -1 -1 }
													addcolumn = 100%
													addrow = 100
													datamodel_reuse_widgets = yes
													resizetofit = yes
													datamodel = "[PossibleDisease.GetOutbreakItems]"
													item = {
														using = disease_outbreak_item
													}
												}

												widget = {
													layoutpolicy_horizontal = expanding
													size = { -1 40 }

													clickable_header_card = {
														using = card_header_disease
														blockoverride "card_disease_color" {
															using = color_society_texture
														}
														blockoverride "header_bg" {}
														blockoverride "clickable_header_card_size"{
															size = { 100% 40 }
														}
														blockoverride "header_size" {
															size = {-1 40 }
														}
														blockoverride "header_content" {
															enabled = "[Or(GreaterThan_int32(PossibleDisease.GetNumOutbreaks, '(int32)0'), And(PossibleDisease.IsEnvironmental, PossibleDisease.IsCountryAffected))]"
															action_tooltip = {
																title = "TOGGLE_DISEASE"
																conditions = "[AddLocalizationIf(Not(Or(GreaterThan_int32(PossibleDisease.GetNumOutbreaks, '(int32)0'), And(PossibleDisease.IsEnvironmental, PossibleDisease.IsCountryAffected))), 'NO_DISEASE_OUTBREAK')]"
																enabled = "[Or(GreaterThan_int32(PossibleDisease.GetNumOutbreaks, '(int32)0'), And(PossibleDisease.IsEnvironmental, PossibleDisease.IsCountryAffected))]"
																on_action = "[PossibleDisease.Toggle]"
															}

															tooltipwidget = { BasicFunctionalTooltip = {} }

															widget = {
																size = {100% 100%}
																hbox = {
																	margin_left = 4
																	margin_right = 10
																	spacing = 10
																	widget = {
																		size = { 35 35 }
																		icon = {
																			parentanchor = center
																			position = {0 -1}
																			size = { 34 34 }
																			texture = "[GetDiseaseIcon(PossibleDisease.GetDisease)]"
																		}
																	}

																	text_single = {
																		maximumsize = {150 20}
																		align = left|nobaseline
																		using = Font_Type_Headers
																		using = Font_Size_Small
																		alwaystransparent = no
																		text = "[PossibleDisease.GetName]"

																		sort_by_highlight = {
																			name = "name"
																		}
																	}

																	expand = {}

																	text_single = {
																		visible = "[Or(Not(PossibleDisease.IsEnvironmental),And(PossibleDisease.IsEnvironmental,Not(PossibleDisease.IsCountryAffected)))]"
																		maximumsize = { 40 20 }
																		align = center|nobaseline
																		text = "[PossibleDisease.GetNumOutbreaks]"
																		fontsize = 14

																		sort_by_highlight = {
																			name = "outbreaks_amount"
																		}
																	}

																	text_single = {
																		visible = "[And(PossibleDisease.IsEnvironmental, PossibleDisease.IsCountryAffected)]"
																		maximumsize = { 40 20 }
																		align = center|nobaseline
																		raw_text = "1"
																		fontsize = 14

																		sort_by_highlight = {
																			name = "outbreaks_amount"
																		}
																	}

																	icon = {
																		size = { 18 18 }
																		visible = "[Not(PossibleDisease.IsExpanded)]"
																		texture = "gfx/interface/buttons/flats/button_simple_right.dds"
																		using = button_regular_icon_color
																	}

																	icon = {
																		size = { 18 18 }
																		visible = "[PossibleDisease.IsExpanded]"
																		texture = "gfx/interface/buttons/flats/button_simple_down.dds"
																		using = button_regular_icon_color
																	}
																}
															}
														}

														blockoverride "bottom_content" {}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
