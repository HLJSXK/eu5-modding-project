lateralview = {
	name = "government_reforms"

	# SOUND - Government Reforms (Left Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_government_reform_show" }
	blockoverride "panel_header" {
		window_header_alt = {
			using = bg_main_inner_alt
			blockoverride "header_text" {
				text = "ADD_REFORM_TT_TITLE"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
		}
	}

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = left|vcenter
			size = { 40 40 }
			position = { 30 0 }

			button_minimize = {
				parentanchor = left|vcenter

				blockoverride "button_texture" {
					using = max_button_alt_texture
				}

				action_tooltip = {
					title = "TOGGLE_GOVERNMENT_REFORMS_EXPANDED_VIEW"
					on_action = "[GovernmentReformsLateralView.ToggleExpand]"
				}
		
				input_action = "toggle_window_collapse"
			}
		}
	}
	
	blockoverride "panel_content" {
		### RESEARCH CONTENT
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_notabs_alt
			using = window_main_tabs_margin_alt

			margin_top = 5

			widget = { ### TITLE
				layoutpolicy_horizontal = expanding
				size = { -1 40 }
				
				card_header_button_04 = {
					size = { 101% 40 }
					parentanchor = center

					using = bg_card_header_01
					blockoverride "header_color" {
						using = color_purple_texture
					}

					blockoverride "header_pattern_texture_density" {texture_density = 1.6}
					
					action_tooltip = {
						title = "TOGGLE_GOVERNMENT_REFORMS_EXPANDED_VIEW"
						on_action = "[GovernmentReformsLateralView.ToggleExpand]"
					}

					tooltipwidget = { BasicFunctionalTooltip = {}}
				}

				hbox = {
					spacing = 8
					margin = { 10 0 }

					text_single = {
						autoresize = yes
						text = "TOGGLE_GOVERNMENT_REFORMS_EXPANDED_VIEW"
					}

					expand = {}

					icon_text_2rows = {
						visible = "[GovernmentReformsLateralView.HasReformSelectedToChange]"
						datacontext = "[GovernmentReformsLateralView.GetChangingReform]"
						blockoverride "base_setup" {
							righttoleft = yes
						}
						blockoverride "icon_obj" {
							estate_reform_action_button_alt = {
								size = { 20 30 }
								blockoverride "reform_action" {
									alwaystransparent = yes
									tooltip_enabled = no
								}
								blockoverride "icon_texture" {
									texture = "[GetGovernmentReformIllustration(GovernmentReform.Self)]"
								}
								blockoverride "reform_item_normal_visibility" {
									visible = "[And(Not(GovernmentReform.IsUnique),Not(GovernmentReform.IsMajor))]"
								}
								blockoverride "reform_item_unique_visibility" {
									visible = "[GovernmentReform.IsUnique]"
								}
								blockoverride "reform_item_major_visibility" {
									visible = "[And(Not(GovernmentReform.IsUnique),GovernmentReform.IsMajor)]"
								}
								blockoverride "estate_reform_button_visible" {
									visible = no
								}
								blockoverride "estate_reform_icon_visible" {
									visible = yes
								}
							}
						}
						blockoverride "icon_setup" {}
						blockoverride "top_text_setup" {
							text = "CHANGE_REFORM_TITLE"
							default_format = "#explanation_link"
							align = right
						}
						blockoverride "bottom_text_setup" {
							text = "[GovernmentReform.GetNameWithNoTooltip]"
							align = right
						}
					}

					icon_text_2rows = {
						visible = "[Not(GovernmentReformsLateralView.HasReformSelectedToChange)]"
						blockoverride "base_setup" {
							righttoleft = yes
						}
						blockoverride "icon_setup" {
							texture = "gfx/interface/icons/flat_icons/reforms.dds"
						}

						blockoverride "top_text_setup" {
							text = "game_concept_reforms"
							default_format = "#explanation_link"
							align = right
						}
						blockoverride "bottom_text_setup" {
							raw_text = "[GovernmentReformsLateralView.GetImplementedReforms] / [GovernmentReformsLateralView.GetPossibleReformsAmount]"
							align = right
						}
					}
				}
			}

			filtered_sorted_list = {
				datacontext = "[GovernmentReformsLateralView.GetReformsSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(GovernmentReformsLateralView.GetAllReforms)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "REFORMS_SCROLL_LIST_EMPTY"
				}

				blockoverride "scroll_list_layout" {
					vbox = {
						margin = { 5 0 }
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10
							
							datamodel = "[GovernmentReformsLateralView.GetAllReforms]"
							item = { government_reforms_item = {} }
						}

						expand = {}
					}
				}
			}
		}
	}
}

types government_reform_items {
	type government_reforms_base_item = vbox {
		layoutpolicy_horizontal = expanding
		using = bg_paper_card

		vbox = {
			layoutpolicy_horizontal = expanding
			using = bg_card_header_01

			block "item_header_enabled_bg" {
				blockoverride "bg_card_header_01_bg" {
					background = {
						visible = "[GovernmentReformItem.IsEnabled]"
						using = bg_card_header_01_default
						alpha = 0.3
					}
				}
			}

			blockoverride "bg_card_header_01_bg_disabled" {
				background = {
					visible = "[Not(GovernmentReformItem.IsEnabled)]"
					using = bg_card_header_01_default
					alpha = 0.3
					blockoverride "header_color" {
						using = color_grey_texture
					}
				}
			}

			background = {
				visible = "[And(GovernmentReformItem.IsEnabled, Or(GovernmentReformItem.IsCountryExclusive, Or(GovernmentReformItem.IsCultureExclusive, GovernmentReformItem.IsReligionExclusive)))]"
				using = bg_card_header_01_default
				alpha = 0.3
				blockoverride "header_color" {
					using = color_purple_texture
				}
			}

			card_header_button_01 = {
				size = { 100% 100%}
				ignore_layout = yes
				using = government_reform_action_provider

				datacontext = "[GovernmentReformItem.GetReform]"
				tooltipwidget = {
					using = GovernmentReform_tooltip
					blockoverride "time_to_reform" {
						block "time_to_reform_content" {
							TooltipTextBlock = {
								blockoverride "text" {
									text = "TIME_TO_REFORM"
								}
							}
						}
					}
					blockoverride "UIActionDescription" {
						TooltipTextBlock = {
							visible = "[GovernmentReformItem.IsCountryExclusive]"
							datacontext = "[Player]"
							blockoverride "text" {
								text = "GOVERNMENT_REFORM_EXCLUSIVE_FOR_COUNTRY"
							}
						}
						TooltipTextBlock = {
							visible = "[And(GovernmentReformItem.IsCultureExclusive, Not(GovernmentReformItem.IsCountryExclusive))]"
							datacontext = "[Player]"
							blockoverride "text" {
								text = "GOVERNMENT_REFORM_EXCLUSIVE_FOR_CULTURE"
							}
						}
						TooltipTextBlock = {
							visible = "[And(GovernmentReformItem.IsReligionExclusive, And(Not(GovernmentReformItem.IsCountryExclusive), Not(GovernmentReformItem.IsCultureExclusive)))]"
							datacontext = "[Player]"
							blockoverride "text" {
								text = "GOVERNMENT_REFORM_EXCLUSIVE_FOR_RELIGION"
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				estate_reform_action_button_alt = {
					enabled = "[GovernmentReformItem.IsEnabled]"
					datacontext = "[GovernmentReformItem.GetReform]"
					size = { 52 75 }
					blockoverride "reform_action" {
						alwaystransparent = yes
						tooltip_enabled = no
					}
					blockoverride "icon_texture" {
						texture = "[GetGovernmentReformIllustration(GovernmentReform.Self)]"
					}
					blockoverride "reform_item_normal_visibility" {
						visible = "[And(Not(GovernmentReform.IsUnique),Not(GovernmentReform.IsMajor))]"
					}
					blockoverride "reform_item_unique_visibility" {
						visible = "[GovernmentReform.IsUnique]"
					}
					blockoverride "reform_item_major_visibility" {
						visible = "[And(Not(GovernmentReform.IsUnique),GovernmentReform.IsMajor)]"
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						margin_right = 10
						text_single = {
							layoutpolicy_horizontal = expanding
							default_format = "#yellow_titles"
							autoresize = yes
							multiline = yes
							align = nobaseline
							text = "[GovernmentReformItem.GetReform.GetNameWithNoTooltip]"
						}

						expand = {}

						widget = {
							visible = "[Or(GovernmentReformItem.IsCountryExclusive, Or(GovernmentReformItem.IsCultureExclusive, GovernmentReformItem.IsReligionExclusive))]"
							size = { 46 46 }

							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_frame.dds"
								texture_density = 2
								using = color_gold
							}

							circular_country_flag_small = {
								parentanchor = center
								datacontext = "[Player]"
								visible = "[GovernmentReformItem.IsCountryExclusive]"
								blockoverride "show_as_button" { visible = no }
								blockoverride "show_as_icon" { visible = yes }
								blockoverride "tooltip" {}
								blockoverride "contextmenu" {}
								blockoverride "click" {}
								blockoverride "double_click" {}

								size = { 54 36 }
							}

							icon = {
								parentanchor = center
								visible = "[And(GovernmentReformItem.IsCultureExclusive, Not(GovernmentReformItem.IsCountryExclusive))]"
								size = { 36 36 }
								texture = "gfx/interface/icons/culture/primary_culture.dds"
							}

							icon = {
								parentanchor = center
								visible = "[And(GovernmentReformItem.IsReligionExclusive, And(Not(GovernmentReformItem.IsCountryExclusive), Not(GovernmentReformItem.IsCultureExclusive)))]"
								size = { 36 36 }
								texture = "[GetReligionIcon(Player.GetReligion)]"
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						hbox = {
							visible = "[GovernmentReformItem.GetReform.RequiresSocietalValues]"
							datamodel = "[GovernmentReformItem.GetReform.GetSocietalValueRequirement]"
							item = {
								block "societal_value_item" {
									icon = {
										size = { 35 35 }
										texture = "gfx/interface/buttons/button_societal_values.dds"
										icon = {
											parentanchor = center
											size = { 80% 80% }
											visible = "[SocietalValueRequirement.IsLeft]"
											texture = "[SocietalValueRequirement.GetSocietalValue.GetLeftIcon]"
										}
										icon = {
											parentanchor = center
											size = { 80% 80% }
											visible = "[Not(SocietalValueRequirement.IsLeft)]"
											texture = "[SocietalValueRequirement.GetSocietalValue.GetRightIcon]"
										}

										tooltipwidget = {
											SimpleContextualRowTooltipType = {
												blockoverride "title_icon" {
													icon = {
														visible = "[SocietalValueRequirement.IsLeft]"
														using = tooltip_title_icon_size
														texture = "[SocietalValueRequirement.GetSocietalValue.GetLeftIcon]"
													}
													icon = {
														visible = "[Not(SocietalValueRequirement.IsLeft)]"
														texture = "[SocietalValueRequirement.GetSocietalValue.GetRightIcon]"
														using = tooltip_title_icon_size
													}
												}
												blockoverride "concept_link" {
													text = "[societal_value|e]"
												}

												lowpriotextcontext = "[GovernmentReformItem.GetSocietalValueRequirementInfo]"
											}
										}
									}
								}
							}
						}

						expand = {}
					}
				}
			}
		}

		block "reform_bottom_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				margin = { 5 5 }

				background = {
					visible = "[Not(GovernmentReformItem.IsEnabled)]"
					using = color_grey_texture
				}

				card_block_list = {
					visible = "[Not(StringIsEmpty(GovernmentReformItem.GetEffectText))]"
					textcontext = "[GovernmentReformItem.GetEffectText]"
					blockoverride "row_size" {}
				}

				card_block_list = {
					visible = "[Not(StringIsEmpty(GovernmentReformItem.GetModifiersText))]"
					textcontext =  "[GovernmentReformItem.GetModifiersText]"
					blockoverride "row_size" {}
				}
			}
		}
	}

	type government_reforms_item = government_reforms_base_item {
		blockoverride "item_header_enabled_bg" {
			blockoverride "bg_card_header_01_bg" {
				background = {
					visible = "[GovernmentReformItem.IsEnabled]"
					using = bg_card_header_01_default
					alpha = 0.3
					blockoverride "header_color" {
						texture = "[Select_CString(GovernmentReformItem.IsCountryExclusive, 'gfx/interface/colors/purple.dds', 'gfx/interface/colors/government.dds')]"
					}
				}
			}
		}

		blockoverride "time_to_reform_content" {
			TooltipTextBlock = {
				visible = "[Not(StringIsEmpty(GovernmentReformItem.GetTimeToImplementText))]"
				blockoverride "text" {
					text = "TIME_TO_REFORM"
				}
			}
		}
	}
}
