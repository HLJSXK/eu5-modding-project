select_menu_left = {
	blockoverride "menu_setup" {
		name = "select_holy_site"
	}

	blockoverride "close_on_action" { on_action = "[SelectHolySite.OnClose]" }
	blockoverride "select_content" {

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			datamodel = "[Player.GetHolySites]"
			item = {
				select_card = {
					blockoverride "button_setup" {
						onclick = "[SelectHolySite.OnClick(HolySite.Self)]"
					}

					blockoverride "button_icon_obj" {
						country_flag_very_small = {
							visible = "[HolySite.GetLocation.GetOwner.IsValid]"
							datacontext = "[HolySite.GetLocation.GetOwner]"
						}
					}

					blockoverride "button_text" {
						text = "[HolySite.GetName]"
					}

					blockoverride "effect_text_layout" {
						hbox = {
							layoutpolicy_horizontal = expanding
							margin = { 5 3 }
							spacing = 10

							text_single = {
								autoresize = yes
								align = left|nobaseline
								text = "[HolySite.GetPilgrimageTravelMonths]"
							}

							text_single = {
								autoresize = yes
								align = left|nobaseline
								text = "[HolySite.GetPilgrimageGoldCost]"
							}

							text_single = {
								autoresize = yes
								align = left|nobaseline
								text = "[HolySite.GetPilgrimageInfluenceGain]"
							}

							expand = {}
						}
					}
				}
			}
		}
	}
}
