OmensEventWindow = {
	name = "omens_event_window"
	parentanchor = center
	position = { 0 10 }
	movable = yes
	layer = top

	blockoverride "title_text" {
		visible = "[Player.IsInvokingOmen]"
		default_format = "#yellow_titles"
		text = "invoke_omen_with_god"
		tooltip = "[EventWindow.GetDebugInfo]"
	}

	blockoverride "illustration" {
		icon = {
			size = { 100% 100% }
			visible = "[EventWindow.HasUniqueImage]"
			texture = "[EventWindow.GetUniqueImage]"
			texture_density = 2
		}
	}

	blockoverride "description_text" {
		visible = "[Player.IsInvokingOmen]"
		text = "invoke_omen_with_god_desc"
	}

	blockoverride "banners" {
		visible = "[Player.IsInvokingOmen]"
		datamodel = "[Player.GetOmensHand]"
		allow_outside = yes
		item = {
			OmenSelector = {
				size = { @banner_wide @banner_height }
	
				blockoverride "banner_color" {
					modify_texture = {
						using = color_yellow_texture
						blend_mode = overlay
					}
				}
	
				blockoverride "banner_texture" {
					texture = "gfx/interface/illustrations/advances/focus/adm_focus.dds"
	
					modify_texture = {
						using = color_bg_blue_texture
						blend_mode = multiply
						alpha = 0.4
					}
				}
				
				vbox = {
					margin = { 5 20 }
					visible = "[Player.IsInvokingOmen]"
	
					widget = {
						size = { 45 45 }
						icon = {
							parentanchor = center
							texture = "[GetOmenIcon(Omen.Self)]"
							size = {150% 150%}
						}
						tagtooltip_enabled = yes
						tooltip = "[Omen.GetName]"
	
						using = bg_circle_alt_brown
					}

					button_wax = {
						layoutpolicy_horizontal = expanding
						blockoverride "button_texture" {
							texture = "gfx/interface/buttons/button_wax_yellow.dds"
						}

						size = { -1 55 }
						fontsize = 14

						align = center|nobaseline
						using = Font_Type_Headers
						using = Font_Size_Small
						using = snd_UI_event_age_option_administrative

						visible = "[PdxGuiWidget.IsUberButtonVisible]"
						enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

						text_single = {
							text = "[Omen.GetNameWithNoTooltip]"
							size = { 90% 100% }
							parentanchor = center
							autoresize = no
							align = center
						}

						scripted_action_tooltip = {
							click_type = left
							click_mode = single
							action_name = "select_omen"
							actor = "[Player]"
							parameter = {
								parameter_name = "target"
								parameter_value = "[Player.GetGodInvokingOmen]"
							}
							parameter = {
								parameter_name = "recipient"
								parameter_value = "[Player.GetReligion]"
							}
							parameter = {
								parameter_name = "target_2"
								parameter_value = "[Omen.MakeScope]"
							}
						}

						tooltipwidget = {
							using = action_tooltip_pop_out

							blockoverride "title_icon_texture" {
								texture = "[GetConceptTexture('omen')]"
							}
						}
					}
	
					ModifiersList = {
						layoutpolicy_horizontal = expanding
						margin = { 8 0 }
						blockoverride "datamodel" {
							datamodel = "[StringToRowList(Omen.GetIconEffects).GetRows]"
						}
					}

					expand = {}
				}
			}
		}
	}

	vbox = {
		visible = "[Not(Player.IsInvokingOmen)]"
	
		state = {
			name = _show
			on_finish = "[EventWindow.SelectDefaultOption]"
		}
	}
}

