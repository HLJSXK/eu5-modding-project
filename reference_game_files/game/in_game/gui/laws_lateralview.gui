lateralview = {
	name = "laws_lateralview"
	widgetid = "laws_lateralview"

	blockoverride "lateralview_topbuttons_extra" {
		using = government_topbuttons_extra
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "GOV_TAB"
			}

			blockoverride "window_header_alt_color_texture"{
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = government_main_tabs
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 5
			margin_top = 2

			### POLITICS AREA
			widget = {
				name = "laws_tab_area"
				widgetid = "laws_tab_area"
				using = layoutpolicy_expanding

				vbox = {
					#using = bg_secondary_inner_image_alt

					vbox = {
						margin = { 8 10 }
						spacing = 15
						layoutpolicy_horizontal = expanding

						# Remaining laws row (header buttons: concept on top, current assigned on bottom)
						hbox = {
							spacing = 4
							layoutpolicy_horizontal = expanding
							size = { -1 40 }

							# Succession Law
							widget = {
								layoutpolicy_horizontal = expanding
								layoutstretchfactor_horizontal = 1
								size = { -1 45 }

								header_button_left = {
									size = { 100% 100% }

									title = "NEW_SUCCESSION_LAW"
									datacontext = "[Player.GetGovernment.GetHeirSelection]"
									tooltipwidget = { using = HeirSelection_tooltip }
									action_tooltip = {
										click_type = left
										title = "NEW_SUCCESSION_LAW"
										on_action = "[ShowSelectSuccessionLaw]"
									}

									blockoverride "icon_overlay" {
										texture = "[GetConceptTexture('succession_law')]"
									}
									blockoverride "text_top" {
										layoutpolicy_horizontal = expanding
										text = "game_concept_succession_law"
										default_format = "#explanation_link"
									}
									blockoverride "text_bottom" {
										layoutpolicy_horizontal = expanding
										text = "[Player.GetGovernment.GetHeirSelection.GetNameWithNoTooltip|L]"
									}
								}
							}

							# Employment System
							widget = {
								layoutpolicy_horizontal = expanding
								layoutstretchfactor_horizontal = 1
								size = { -1 45 }

								header_action_button_left_uber = {
									datacontext = "[GetGenericAction('change_employment_system')]"
									tooltipwidget = { using = generic_action_tooltip }
									size = { 100% 100% }

									blockoverride "icon_overlay" {
										texture = "[GetConceptTexture('employment_system')]"
									}
									blockoverride "text_top" {
										text = "game_concept_employment_system"
										layoutpolicy_horizontal = expanding
										default_format = "#explanation_link"
									}
									blockoverride "text_bottom" {
										text = "[Player.GetEmploymentSystem.GetName]"
										layoutpolicy_horizontal = expanding
									}

									name = "change employment system button"
									title = "change_employment_system"
									visible = "[PdxGuiWidget.IsUberButtonVisible]"
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "change_employment_system"
										actor = "[Player]"
									}
								}
							}

							# Parliament Type
							widget = {
								layoutpolicy_horizontal = expanding
								layoutstretchfactor_horizontal = 1
								size = { -1 45 }

								header_action_button_left_uber = {
									datacontext = "[GetGenericAction('change_parliament_type')]"
									tooltipwidget = { using = generic_action_tooltip }
									size = { 100% 100% }

									blockoverride "icon_overlay" {
										texture = "[GetConceptTexture('parliament')]"
									}
									blockoverride "text_top" {
										text = "game_concept_parliament_type"
										layoutpolicy_horizontal = expanding
										default_format = "#explanation_link"
									}
									blockoverride "text_bottom" {
										text = "[Player.GetGovernment.GetParliament.GetParliamentType.GetName]"
										layoutpolicy_horizontal = expanding
									}

									name = "change parliament type button"
									title = "change_parliament_type"
									visible = "[PdxGuiWidget.IsUberButtonVisible]"
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "change_parliament_type"
										actor = "[Player]"
									}
								}
							}
						}

						# Languages row (same display as religion primary/liturgical buttons)
						hbox = {
							layoutpolicy_horizontal = expanding
							size = { -1 40 }
							spacing = 50

							# Court Language
							widget = {
								layoutpolicy_horizontal = expanding
								layoutstretchfactor_horizontal = 1
								size = { -1 40 }

								header_action_button_left_uber = {
									size = { 100% 100% }
									datacontext = "[Player]"
									datacontext = "[Player.GetCourtLanguage]"
									tooltipwidget = {
										using = court_language_tooltip
									}

									blockoverride "icon_overlay" {
										texture = "[GetConceptTexture('court_language')]"
									}

									blockoverride "text_top" {
										layoutpolicy_horizontal = expanding
										text = "game_concept_court_language"
										default_format = "#explanation_link"
									}

									blockoverride "text_bottom" {
										layoutpolicy_horizontal = expanding
										text = "[Player.GetCourtLanguage.GetNameWithNoTooltip]"
									}

									name = "change court language button"
									title = "change_court_language"
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "change_court_language"
										actor = "[Player]"
									}
								}
							}

							# Liturgical Language
							widget = {
								layoutpolicy_horizontal = expanding
								layoutstretchfactor_horizontal = 1
								size = { -1 40 }

								header_action_button_right_uber = {
									size = { 100% 100% }
									datacontext = "[Player]"
									datacontext = "[Player.GetLiturgicalLanguage]"
									tooltipwidget = {
										using = liturgical_language_tooltip
									}

									blockoverride "icon_overlay" {
										texture = "gfx/interface/icons/flat_icons/language.dds"

										modify_texture = {
											using = color_white_texture
											alpha = 0.1
										}
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.3
										}
									}

									blockoverride "text_top" {
										layoutpolicy_horizontal = expanding
										text = "game_concept_liturgical_language"
										default_format = "#explanation_link"
									}

									blockoverride "text_bottom" {
										layoutpolicy_horizontal = expanding
										text = "[Player.GetLiturgicalLanguage.GetNameWithNoTooltip]"
									}

									name = "change liturgical language button"
									title = "change_liturgical_language"
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "change_liturgical_language"
										actor = "[Player]"
									}
								}
							}
						}
					}
					blockoverride "searchbar_extra_pre_content" {
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							margin_bottom = 4
							datamodel = "[LawsView.GetFilterCategories]"
							item = {
								goods_quickfilter_button = {
									layoutpolicy_horizontal = expanding
									blockoverride "goods_quickfilter_button_size" {
										size = { -1 32 }
									}
									blockoverride "goods_quickfilter_button_background" {
										background = {
											using = paper_card_texture
											margin = {-3 -3}

											modify_texture = {
												using = color_paper_texture
											}

											modify_texture = {
												using = overlay_paper_03
											}
										}
										background = {
											using = color_grey_texture
											margin = {-3 -3}

											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay
												alpha = 0.6
											}

											modify_texture = {
												texture = "[LawCategory.GetBgCategoryColor]"
												blend_mode = multiply
												alpha = 0.8
											}
										}
									}
									blockoverride "goods_quickfilter_button_highlight" {
										visible = "[LawCategory.IsFilterActive]"
									}
									blockoverride "goods_quickfilter_button_title" {
										title = "[LawCategory.GetName]"
									}
									blockoverride "goods_quickfilter_button_on_action" {
										on_action = "[LawCategory.ToggleFilter]"
									}
									blockoverride "goods_quickfilter_button_tooltip" {
										tooltipwidget = { BasicFunctionalTooltip = {} }
									}
									blockoverride "goods_quickfilter_button_icon" {
										texture = "[LawCategory.GetCategoryIcon]"
									}
								}
							}
						}
					}

					# LAW CATEGORIES
					filtered_sorted_list = {
						datacontext = "[LawsView.GetLawCategoriesSortSearch]"

						blockoverride "filtered_sorted_list_sorts_visible" {
							visible = no
						}

						blockoverride "scroll_list_is_empty" {
							visible = "[IsDataModelEmpty(LawsView.GetLawCategories)]"
						}
						blockoverride "searchbar_top_extra" {
							header_button_right = {
								visible = "[Not(LawsView.Vars.Exists( 'laws_old_style' ))]"
								size = { 30 30 }
								blockoverride "button_icon_stretch_sprite" {}
								blockoverride "header_button_frame_inner" { visible = no }
								blockoverride "header_button_icon_size" { size = { 30 30 } }
								blockoverride "header_button_text_layout" {}
								blockoverride "icon_texture" {
									texture =  "gfx/interface/icons/flat_icons/menu_icon.dds"
									texture_density = 2
								}
								action_tooltip = {
									title = "LAWS_VIEW_TOGGLE_TO_LIST"
									on_action = "[LawsView.Vars.Toggle( 'laws_old_style' )]"
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
							}
							header_button_right = {
								visible = "[LawsView.Vars.Exists( 'laws_old_style' )]"
								size = { 30 30 }
								blockoverride "button_icon_stretch_sprite" {}
								blockoverride "header_button_frame_inner" { visible = no }
								blockoverride "header_button_icon_size" { size = { 30 30 } }
								blockoverride "header_button_text_layout" {}
								blockoverride "icon_texture" {
									texture =  "gfx/interface/icons/flat_icons/menu_icon_square.dds"
									texture_density = 2
								}
								action_tooltip = {
									title = "LAWS_VIEW_TOGGLE_TO_CARDS"
									on_action = "[LawsView.Vars.Toggle( 'laws_old_style' )]"
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
							}
						}

						blockoverride "scroll_list_is_empty_text" {
							text = "LAWS_SCROLL_LIST_EMPTY"
						}

						blockoverride "scroll_list_layout" {
							vbox = {
								vbox = {
									visible = "[Not(LawsView.Vars.Exists( 'laws_old_style' ))]"
									spacing = 8
									layoutpolicy_horizontal = expanding
									datamodel = "[LawsView.GetLawCategories]"
									item = {
										vbox = {
											layoutpolicy_horizontal = expanding
											spacing = 4
											datamodel = "[LawCategory.GetLaws]"
											item = {
												vbox = {
													layoutpolicy_horizontal = expanding

													law_card_header = {
														layoutpolicy_horizontal = expanding
														size = { -1 60 }

														blockoverride "law_header_button_properties" {
															enabled = "[LawsView.IsLawEnabled(Law.Self)]"
															tooltipwidget = { using = Law_tooltip }
															action_tooltip = {
																click_type = left
																click_mode = single
																title = "[LawsView.GetLawEnabledInfo(Law.Self)]"
																on_action = "[ShowSelectPolicies(Law.Self)]"
															}
														}
														blockoverride "law_header_button_content" {
															hbox = {
																margin = { 4 0 }
																margin_right = 6
																spacing = 10
																layoutpolicy_horizontal = expanding
	
																widget = {
																	size = { 36 36 }
																	background = {
																		texture = "gfx/interface/component_tiles/laws_background_frame.dds"
																		texture_density = 2
																		spriteType = corneredstretched
																		spriteBorder = { 0 0 }
																		modify_texture = {
																			texture = "[GetLawBgCategoryColor(Law.Self)]"
																			blend_mode = multiply
																		}
																		modify_texture = {
																			using = overlay_cloth_texture
																			blend_mode = overlay
																			alpha = 0.2
																		}
																		modify_texture = {
																			using = color_black_texture
																			blend_mode = overlay
																			alpha = 0.3
																		}
																	}
																	icon = {
																		size = { 90% 90% }
																		parentanchor = center
																		texture = "[GetLawIcon(Law.Self)]"
																	}
																}
	
																vbox = {
																	layoutpolicy_horizontal = expanding
																	ignoreinvisible = yes
																	text_single = {
																		layoutpolicy_horizontal = expanding
																		using = Font_Size_Small
																		align = nobaseline|left
																		default_format = "#yellow_titles"
																		text = "[Law.GetNameWithNoTooltip]"
																	}
																	hbox = {
																		layoutpolicy_horizontal = expanding
																		text_single = {
																			autoresize = yes
																			maximumsize = { 200 -1 }
																			align = nobaseline|left
																			fontsize = 13
																			visible = "[Player.GetGovernment.HasPolicyForLaw(Law.Self)]"
																			text = "[Player.GetGovernment.GetPolicyForLaw(Law.Self).GetNameWithNoTooltip]"
																		}
																		text_single = {
																			align = nobaseline|left
																			fontsize = 13
																			visible = "[Not(Player.GetGovernment.HasPolicyForLaw(Law.Self))]"
																			text = "NO_POLICY_SELECTED"
																		}
																		expand = {}
																	}
																}
	
																text_single = {
																	size = {24 24}
																	autoresize = no
																	align = center|nobaseline
																	visible = "[Law.HasLevels]"
																	text = "[Player.GetGovernment.GetPolicyForLaw(Law.Self).GetPolicyLevel]"
																	using = bg_circle_piechart
																	blockoverride "frame_color" {
																		modify_texture = {
																			using = color_new_gold_texture
																			blend_mode = multiply
																		}
																		modify_texture = {
																			using = color_new_gold_texture
																			blend_mode = add
																			alpha = 0.4
																		}
																	}
																	blockoverride "inside_color" {
																		modify_texture = {
																			using = color_dark_brown_texture
																			blend_mode = multiply
																		}
																		alpha = 0.9
																	}
																}
																
																widget = {
																	size = { 31 31 }
																	using = bg_circle
																	visible = "[Player.GetGovernment.ShouldDisplayProgressForLaw(Law.Self)]"
	
																	piechart = {
																		size = { 100% 100% }
																		parentanchor = center
																		using = piechart_angles											
																		icon = {
																			parentanchor = center
																			size = { 70% 70% }
																			texture = "gfx/interface/icons/situations/_default.dds"
																			texture_density = 2
																		}
	
																		pieslice = {
																			texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																			value = "[FixedPointToFloat(Player.GetGovernment.GetPolicyProgressForLaw(Law.Self))]"
																			using = color_value_progress_blue
																		}
	
																		pieslice = {
																			texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																			value = "[Subtract_float('(float)100.0', FixedPointToFloat(Player.GetGovernment.GetPolicyProgressForLaw(Law.Self)))]"
																			using = color_value_progress_gray
																		}
																		using = bg_circle_piechart
																	}
																}
															}
														}
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														margin = { 0 7 }
														margin_bottom = 12
														margin_right = 4
														background = {
															texture = "gfx/interface/cards/laws/header_container_bottom.dds"
															texture_density = 2
															spriteType = corneredstretched
															spriteBorder = { 10 10 }
														}

														expand = {}
														hbox = {
															margin = { 0 2 }
															allow_outside = yes
															ignoreinvisible = yes
															spacing = 10
															datamodel = "[Law.GetPoliciesDataModel]"
															item = {
																widget = {
																	size = { 32 32 }
																	visible = "[LawsView.CanCodifyPolicy(Policy.Self)]"

																	background = {
																		visible = "[And(Player.GetGovernment.HasPolicyForLaw(Law.Self), ObjectsEqual(Player.GetGovernment.GetPolicyForLaw(Law.Self), Policy.Self))]"
																		texture = "gfx/interface/advance/advances_glow/advances_glow_yellow.dds"
																		texture_density = 2
																		alpha = 0.7
																		margin = { 10 10 }
																	}

																	background = {
																		visible = "[And(Player.GetGovernment.HasPolicyForLaw(Law.Self), ObjectsEqual(Player.GetGovernment.GetPolicyForLaw(Law.Self), Policy.Self))]"
																		texture = "gfx/interface/component_effects/effect_tutorial_highlight.dds"
																		texture_density = 2
																		spriteType = Corneredtiled
																		spriteborder = { 15 15 }
																		margin = { 8 8 }
																		alpha = 0.8

																		modify_texture = {
																			using = color_yellow_texture
																			blend_mode = add
																			alpha = 0.3
																		}
																	}

																	background = {
																		visible = "[LawsView.IsPolicyMatchedByActiveModifierFilter(Policy.Self)]"
																		using = color_progress_blue_texture
																		margin = { 3 3 }
																		alpha = 0.7
																	}
																		
																	card_header_button_04 = {
																		size = { 100% 100% }
																		enabled = "[LawsView.CanChangeToPolicy(Policy.Self)]"

																		action_tooltip = {
																			click_type = left
																			click_mode = confirm
																			title = "[Policy.GetNameWithNoTooltip]"
																			enabled = "[LawsView.CanChangeToPolicy(Policy.Self)]"
																			cost = "[LawsView.GetChangePolicyCost(Policy.Self)]"
																			description = "[Policy.GetDesc]"
																			effects = "[Policy.GetModifierText]"
																			conditions = "[LawsView.GetChangePolicyConditions(Policy.Self)]"
																			conditions = "[MakeItFail(LawsView.GetChangePolicyLockConditions(Policy.Self))]"
																			on_action = "[LawsView.ChangeToPolicy(Policy.Self)]"
																		}
																		
																		tooltipwidget = { 
																			using = Policy_tooltip
																			blockoverride "title_icon_texture" {
																				texture = "[GetLawIcon(Policy.GetLaw.Self)]"
																			}
																		}

																		background = {
																			texture = "gfx/interface/buttons/bg_navigational_header_button.dds"
																			texture_density = 2
																			spriteType = corneredstretched
																			spriteborder = { 42 20 }
																			modify_texture = {
																				texture = "[GetLawBgCategoryColor(Policy.GetLaw)]"
																				blend_mode = multiply
																			}
																			modify_texture = {
																				using = overlay_stone_texture
																				blend_mode = overlay
																				alpha = 0.5
																			}
																			modify_texture = {
																				using = overlay_window_texture
																				blend_mode = overlay
																				alpha = 0.5
																			}
																		}

																		background = {
																			visible = "[LawsView.IsPolicyMatchedByActiveModifierFilter(Policy.Self)]"
																			using = color_white_texture
																			alpha = 0.35
																			blend_mode = overlay
																			spriteType = stretched
																			spriteborder = { 11 11 }
																			modify_texture = {
																				using = overlay_cloth_texture
																				blend_mode = overlay
																				alpha = 0.2
																			}
																			modify_texture = {
																				using = color_black_texture
																				blend_mode = overlay
																				alpha = 0.3
																			}
																		}

																		background = {
																			texture = "gfx/interface/component_tiles/laws_background_frame.dds"
																			texture_density = 2
																			spriteType = corneredstretched
																			spriteBorder = { 0 0 }
																			modify_texture = {
																				texture = "[GetLawBgCategoryColor(Law.Self)]"
																				blend_mode = multiply
																			}
																			modify_texture = {
																				using = overlay_cloth_texture
																				blend_mode = overlay
																				alpha = 0.2
																			}
																			modify_texture = {
																				using = color_black_texture
																				blend_mode = overlay
																				alpha = 0.3
																			}
																		}

																		icon = {
																			size = { 85% 85% }
																			parentanchor = center
																			texture = "[GetPolicyEffectIcon(Policy.Self)]"
																		}
																	}
																}
															}
														}
														expand = {}
													}
												}
											}
										}
									}
								}
								
								vbox = {
									visible = "[LawsView.Vars.Exists( 'laws_old_style' )]"
									spacing = 10
									layoutpolicy_horizontal = expanding
									datamodel = "[LawsView.GetLawCategories]"
									item = {
										laws_list_item = {
											blockoverride "law_type_button" {
												action_tooltip = {
													click_type = left
													click_mode = single
													title = "TOGGLE_LAW_CATEGORY"
													on_action = "[LawCategory.Toggle]"
												}
												action_tooltip = {
													click_type = right
													click_mode = single
													title = "TOGGLE_ALL"
													on_action = "[LawCategory.ToggleAll]"
												}
												tooltipwidget = { BasicFunctionalTooltip = {} }
											}
											blockoverride "law_icon" {
												texture = "[LawCategory.GetCategoryIcon]"
											}
											blockoverride "law_type_button_text" {
												text = "[LawCategory.GetName]"
											}
											blockoverride "laws_amount" {
												text = "[GetDataModelSize(LawCategory.GetLaws)]"
											}
											blockoverride "law_arrow_expanded" {
												visible = "[LawCategory.IsExpanded]"
											}
											blockoverride "law_arrow_not_expanded" {
												visible = "[Not(LawCategory.IsExpanded)]"
											}
											blockoverride "laws_list_datamodel" {
												visible = "[LawCategory.IsExpanded]"
												datamodel = "[LawCategory.GetLaws]"
											}
											blockoverride "law_unique_flavor_visible" {
												visible = "[Law.IsUnique]"
											}
											blockoverride "law_action" {
												enabled = "[LawsView.IsLawEnabled(Law.Self)]"
												tooltipwidget = { using = Law_tooltip }
												action_tooltip = {
													click_type = left
													click_mode = single
													title = "[LawsView.GetLawEnabledInfo(Law.Self)]"
													on_action = "[ShowSelectPolicies(Law.Self)]"
												}
											}
											blockoverride "law_category_color" {
												texture = "[LawCategory.GetBgCategoryColor]"
											}
											blockoverride "law_list_icon" {
												texture = "[GetLawIcon(Law.Self)]"
											}
											blockoverride "law_title" {
												text = "[Law.GetNameWithNoTooltip]"
											}
											blockoverride "law_policy_level" {
												visible = "[Law.HasLevels]"
												text = "[Player.GetGovernment.GetPolicyForLaw(Law.Self).GetPolicyLevel]"
											}
											blockoverride "law_policy" {
												visible = "[Player.GetGovernment.HasPolicyForLaw(Law.Self)]"
												text = "[Player.GetGovernment.GetPolicyForLaw(Law.Self).GetNameWithNoTooltip]"
											}
											blockoverride "law_no_policy" {
												visible = "[Not(Player.GetGovernment.HasPolicyForLaw(Law.Self))]"
												text = "NO_POLICY_SELECTED"
											}
											blockoverride "law_unique_icon_visible" {
												visible = "[Player.GetGovernment.GetPolicyForLaw(Law.Self).IsUnique]"
											}
										}
									}
								}
								expand = {}
							}
						}
					}
				}

				AutomatedSection = {
					datacontext = "[GetAutomatedSystemItem('laws')]"

					blockoverride "glow_anim_automation_visible" {
						visible = "[AutomatedSystemsItem.IsEnabled]"
					}
				}
			}
		}
	}
}
