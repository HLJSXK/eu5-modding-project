lateralview = {
	name = "trade_overview"
	widgetid = "trade_overview"

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }
			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }
				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_economy')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "THE_ECONOMY_OVERVIEW_TITLE"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_economy_texture
			}
		}
	}
	
	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = economy_main_tabs
			}
		}

		vbox = {
			widgetid = "markets_tab_content"
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 3
			visible = "[TradeOverview.Vars.NotExistOrHasValue( 'subtab', 'markets' )]"

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 50 }
				hbox = {
					margin = { 10 0 }
					margin_top = 10
					margin_bottom = 15

					targetted_button_regular = {
						using = layoutpolicy_expanding
						name = "create market button"
						datacontext = "[Player]"
						tooltip_enabled = yes

						visible = "[PdxGuiWidget.IsUberButtonVisible]"
						enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

						scripted_action_tooltip = {
							click_type = left
							click_mode = single
							action_name = "create_market"
							actor = "[Player]"
						}

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "LOC_VIEW_CREATE_MARKET"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/location_icons/market.dds"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.3
										}
									}
								}
								blockoverride "concept_link" {
									text = [market|e]
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" {
											text = "create_market_desc"
										}
									}

									TooltipScrolledRequirementsList = {
										datacontext = "[StringToRequirementsList(GetGenericActionTargetRequirements('create_market'))]"
										visible = "[And(Not(CanPlayerDoGenericAction('create_market')), DataModelHasItems(RequirementsList.GetLines))]"
										blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
										blockoverride "block_title" { text = "CREATE_MARKET_LOCATION_REQUIREMENTS" }
									}
								}
							}
						}
						text = "create_market"
						icon = {						
							size = {23 23}
							parentanchor = left|vcenter
							position = {6 0}
							texture = "gfx/interface/icons/location_icons/market.dds"
							texture_density = 2
							glow = {
								name = "drop_shadow"
								glow_radius = 3
								color = {0.0 0.0 0.0 1.0}
								alpha = 0.3
							}
						}
					}
				}
			}

			trade_summary = {
				using = bg_age_event_frame
			}

			vbox = { #WINDOW DATA SPACE
				using = layoutpolicy_expanding

				vbox = {
					using = layoutpolicy_expanding
					using = bg_secondary_inner_alt

					trade_overview_markets = {}
				}
			}
		}

		widget = {
			visible = "[TradeOverview.Vars.HasValue( 'subtab', 'trades' )]"
			using = layoutpolicy_expanding
			widgetid = "trading_tab_content"

			vbox = {
				using = bg_main_inner_alt
				using = bg_main_inner_image_alt
				using = window_main_tabs_margin_alt
				
				blockoverride "image" {
					texture = "gfx/interface/illustrations/bg/bg_markets.dds"
				}

				vbox = {
					using = layoutpolicy_expanding
					trade_overview_possible_trades = {}
				}
			}
		}
	}
}

select_menu_left = {
	datacontext = "[GetQuickVisibleMarkets(Player.Self)]"
	blockoverride "menu_setup" {
		name = "possible_trades_select_market"
	}

	blockoverride "close_on_action" { on_action = "[PossibleTradesSelectMarket.OnClose]" }
	blockoverride "select_header_text" {
		text = "SELECT_MARKET_HEADER"
	}

	blockoverride "select_content" {
		select_menu_header = {
			blockoverride "select_menu_header_extra" {
				button_checkbox_visibility = {
					size = { 32 32 }
					action_tooltip = {
						title = "TOGGLE_INRANGE_MARKETS"
						on_action = "[PossibleTradesSelectMarket.Parent.Vars.Toggle( 'inrange_markets')]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }
					down = "[PossibleTradesSelectMarket.Parent.Vars.Exists( 'inrange_markets')]"
				}

				text_single = {
					using = Font_Type_Headers
					using = Font_Size_Small
					align = nobaseline
					text = "INRANGE_MARKETS"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10

			datamodel = "[QuickVisibleMarkets.GetVisibleMarkets]"
			item = {
				widget = {
					size = { 485 70 }
					visible = "[Or3(GreaterThan_CFixedPoint(Market.GetCountryPopulation(Player.Self),'(CFixedPoint)0'), GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0'), And(PossibleTradesSelectMarket.Parent.Vars.Exists( 'inrange_markets'), IsMarketInRange(Market.Self)))]"
					
					hbox = {
						using = bg_market_card
						using = bg_cabinet_card_frame

						market_card = {
							blockoverride "market_card_title_action"{
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TOGGLE_MARKET_SELECTION"
									on_action = "[PossibleTradesSelectMarket.Parent.FilterByMarket(Market.Self)]"
								}
			
								action_tooltip = {
									click_type = right
									click_mode = single
			
									cursor = "market_menu"
									title = "CLICK_ACTION_MARKET_CONTEXT_MENU"
									on_action = "[PdxGuiWidget.ToggleContextMenu]"
								}
			
								onmousehierarchyenter = "[PdxGuiWidget.SetHighlightMarket(Market.Self)]"
								ondoubleclick = "[PanToLocation(Market.GetCenterLocation)]"
							}
						}
					}
				}
			}
		}
	}
}

select_menu_left = {
	blockoverride "menu_setup" {
		name = "possible_trades_select_good"
	}

	blockoverride "close_on_action" {
		on_action = "[PossibleTradesSelectGood.OnClose]"
	}

	blockoverride "select_header_text" {
		text = "TRADE_ORDER_GOODS_PANEL_TITLE_IMPORT"
	}

	blockoverride "select_content" {
		margin_top = 5
		spacing = 10

		vbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 540 -1 }
			spacing = 4
			margin = { 0 4 }

			trade_order_preset_card = {
				blockoverride "any_good_card_enabled" {
					enabled = "[PossibleTradesSelectGood.Parent.CanCreateAnyImportGood]"
				}
				blockoverride "any_good_card_icon" {
					texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
					texture_density = 2
				}
				blockoverride "any_good_card_label" {
					text = "TRADE_ORDER_ANY_IMPORT"
				}
				blockoverride "any_good_card_tooltip" {
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_text" { text = "TRADE_ORDER_ANY_IMPORT" }
							blockoverride "title_icon" {
								icon = {
									size = { 50 50 }
									texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
								}
							}
							blockoverride "tooltip_content" {
								TooltipTextBlock = {
									blockoverride "text" { text = "TRADE_ORDER_ANY_IMPORT_TT" }
								}
								TooltipListBase = {
									blockoverride "block_title" {
										block "block_title" {
											visible = yes
											text = "TRADE_ORDER_ANY_SETTINGS_HEADER"
										}
									}
									TooltipListRowContent = {
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = {
													layoutpolicy_horizontal = expanding
													autoresize = no
													text = "TRADE_ORDER_TT_MODE_LABEL"
												}
												text_single = {
													autoresize = yes
													text = "TRADE_ORDER_MODE_PROFIT_WITH_ICON"
													default_format = "#l"
													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	size = { 48 48 }
																	texture = "[GetConceptTexture('trade_profit')]"
																}
															}
															blockoverride "title_text" {
																text = "TRADE_ORDER_MODE_PROFIT"
															}
															blockoverride "concept_link" {
																text = "[trade_order|e]"
															}
															blockoverride "tooltip_content" {
																TooltipTextBlock = {
																	blockoverride "text" {
																		text = "TRADE_ORDER_MODE_PROFIT_INFO"
																	}
																}
															}
														}
													}
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = {
													layoutpolicy_horizontal = expanding
													autoresize = no
													text = "TRADE_ORDER_TT_MIN_PROFIT_LABEL"
												}
												text_single = {
													autoresize = yes
													raw_text = "[GetDefine('NCountry','DEFAULT_TRADE_ORDER_MIN_PROFIT')|=+2]@profit_trade!"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = {
													layoutpolicy_horizontal = expanding
													autoresize = no
													text = "TRADE_ORDER_TT_IMPORT_MARKETS_LABEL"
												}
												text_single = {
													autoresize = yes
													text = "TRADE_ORDER_ANY_MARKET"
												}
											}
										}
									}
								}
							}
						}
					}
				}
				blockoverride "any_good_card_action" {
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "TRADE_ORDER_ANY_IMPORT"
						description = "TRADE_ORDER_ANY_IMPORT_TT"
						enabled = "[PossibleTradesSelectGood.Parent.CanCreateAnyImportGood]"
						conditions = "[MakeItFailIfLoc(Not(PossibleTradesSelectGood.Parent.CanCreateAnyImportGood), 'TRADE_ORDER_CREATE_ALREADY_EXISTS_TT')]"
						on_action = "[PossibleTradesSelectGood.Parent.CreateAnyImportGood]"
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				trade_order_preset_card = {
					blockoverride "any_good_card_enabled" {
						enabled = "[PossibleTradesSelectGood.Parent.CanCreateAnyGovernmentNeedGood]"
					}
					blockoverride "any_good_card_icon" {
						texture = "gfx/interface/icons/flat_icons/trade_market/construction_needs_order_2.dds"
						texture_density = 2
					}
					blockoverride "any_good_card_label" {
						text = "TRADE_ORDER_ANY_GOVERNMENT_NEED"
					}
					blockoverride "any_good_card_tooltip" {
						tooltipwidget = {
							SimpleContextualTooltipType = {
								blockoverride "title_text" { text = "TRADE_ORDER_ANY_GOVERNMENT_NEED" }
								blockoverride "title_icon" {
									icon = {
										size = { 50 50 }
										texture = "gfx/interface/icons/flat_icons/trade_market/construction_needs_order_2.dds"
									}
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" { text = "TRADE_ORDER_ANY_GOVERNMENT_NEED_TT" }
									}
									TooltipListBase = {
										blockoverride "block_title" {
											block "block_title" {
												visible = yes
												text = "TRADE_ORDER_ANY_SETTINGS_HEADER"
											}
										}
										TooltipListRowContent = {
											TooltipManualTableField = {
												blockoverride "field_content" {
													text_single = {
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "TRADE_ORDER_TT_MODE_LABEL"
													}
													text_single = {
														autoresize = yes
														text = "TRADE_ORDER_MODE_NEEDS_WITH_ICON"
														default_format = "#l"
														tooltipwidget = {
															ContextualTooltipType = {
																blockoverride "title_icon" {
																	icon = {
																		using = tooltip_title_icon_size
																		size = { 48 48 }
																		texture = "gfx/interface/icons/flat_icons/trade_market/missing_goods.dds"
																	}
																}
																blockoverride "title_text" {
																	text = "TRADE_ORDER_MODE_NEEDS"
																}
																blockoverride "concept_link" {
