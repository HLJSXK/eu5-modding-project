										datacontext = "[GetMarketCountryNeeds(Player.Self, Market.Self)]"
										blockoverride "block_scrollarea" { maximumsize = { -1 420 } }
										textcontext = "[MarketCountryNeeds.GetBuildingsMissingGoodsInfo]"
									}
								}
							}
						}
					}
					blockoverride "any_good_card_action" {
						action_tooltip = {
							click_type = left
							click_mode = single
							title = "TRADE_ORDER_ANY_BUILDING_NEED"
