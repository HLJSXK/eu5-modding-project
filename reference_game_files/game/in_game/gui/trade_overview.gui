							on_action = "[PossibleTradesSelectGood.Parent.CreateAnyBuildingNeedGood]"
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				trade_order_preset_card = {
					blockoverride "any_good_card_enabled" {
						enabled = "[PossibleTradesSelectGood.Parent.CanCreateAnyPopNeedGood]"
