template repay_all_loans_action_provider {
	enabled = "[IsRepayAllLoansEnabledForPlayer]"

	action_tooltip = {
		click_type = left
		click_mode = confirm
		enabled = "[IsRepayAllLoansEnabledForPlayer]"
		title = "REPAY_ALL_LOANS_TITLE"
		cost = "[GetRepayAllLoansCostForPlayer]"
		description = "[GetRepayAllLoansDescriptionForPlayer]"
		conditions = "[GetRepayAllLoansConditionsForPlayer]"
		on_action_with_params = "[OnRepayAllLoansForPlayer]"
	}
}

template declare_bankruptcy_action_provider {
	enabled = "[CreditLateralView.IsDeclareBankruptcyEnabled]"

	action_tooltip = {
		click_type = left
		click_mode = confirm
		enabled = "[CreditLateralView.IsDeclareBankruptcyEnabled]"
		title = "DECLARE_BANKRUPTCY"
		description = "[CreditLateralView.GetDeclareBankruptcyDescription]"
		conditions = "[CreditLateralView.GetDeclareBankruptcyConditions]"
		on_action_with_params = "[CreditLateralView.OnDeclareBankruptcy]"
	}
}

template repay_all_possible_loans_action_provider {
	enabled = "[IsRepayAllPossibleLoansEnabledForPlayer]"

	action_tooltip = {
		click_type = left
		click_mode = confirm
		enabled = "[IsRepayAllPossibleLoansEnabledForPlayer]"
		title = "REPAY_ALL_POSSIBLE_LOANS_TITLE"
		cost = "[GetRepayAllPossibleLoansCostForPlayer]"
		description = "REPAY_ALL_POSSIBLE_LOANS_DESC"
		on_action_with_params = "[OnRepayAllPossibleLoansForPlayer]"
	}
}

template sell_bonds_action_provider {
	enabled = "[CreditLateralView.IsSellBondsEnabled]"

	action_tooltip = {
		click_type = left
		click_mode = confirm
		enabled = "[CreditLateralView.IsSellBondsEnabled]"
		title = "SELL_BONDS_TITLE"
		cost = "[CreditLateralView.GetSellBondsCost]"
		description = "[CreditLateralView.GetSellBondsActionDescription]"
		conditions = "[CreditLateralView.GetSellBondsConditions]"
		on_action_with_params = "[CreditLateralView.OnSellBonds]"
	}
}

template loan_entry_card_action_provider {
	enabled = "[LoanEntry.IsEnabled]"

	action_tooltip = {
		click_type = left
		click_mode = confirm
		visible = "[Not(LoanEntry.IsBond)]"
		enabled = "[LoanEntry.IsRepayLoanEnabled]"
		title = "LOAN_BUTTON_TEXT"
		cost = "[LoanEntry.GetRepayLoanCost]"
		description = "[LoanEntry.GetRepayLoanDescription]"
		conditions = "[LoanEntry.GetRepayLoanConditions]"
		on_action_with_params = "[LoanEntry.OnRepayLoan]"
	}

	action_tooltip = {
		click_type = left
		click_mode = confirm
		visible = "[LoanEntry.IsBond]"
		enabled = "[LoanEntry.IsRedeemBondEnabled]"
		title = "BOND_BUTTON_TEXT"
		cost = "[LoanEntry.GetRedeemBondCost]"
		description = "[LoanEntry.GetRedeemBondDescription]"
		conditions = "[LoanEntry.GetRedeemBondConditions]"
		on_action_with_params = "[LoanEntry.OnRedeemBond]"
	}
}

template loan_entry_content {

	tooltipwidget = { using = loan_tooltip }
	hbox = {
		layoutpolicy_horizontal = expanding
		margin = { 10 5 }
		spacing = 15

		hbox = {
			spacing = 5

			tooltip_enabled = "[And(Not(LoanEntry.IsBond), Not(LoanEntry.GetLoan.IsEstatesLoan))]"
			block "loan_entry_content_country_tooltip_context" {
				datacontext = "[LoanEntry.GetLoan.GetLender]"
			}
			tooltipwidget = {
				using = CountryTooltip
			}

			widget = {
				size = { 30 20 }
				icon = {
					visible = "[LoanEntry.IsBond]"
					size = { 20 20 }
					parentanchor = center
					texture = "gfx/interface/icons/flat_icons/debt.dds"
					tooltip = "LOAN_TYPE_BOND_LABEL"
				}
				icon = {
					visible = "[LoanEntry.GetLoan.IsEstatesLoan]"
					size = { 20 20 }
					parentanchor = center
					texture = "[GetConceptTexture('estates')]"
				}
				country_flag_very_small = {
					visible = "[And(Not(LoanEntry.IsBond), Not(LoanEntry.GetLoan.IsEstatesLoan))]"
					block "loan_entry_content_flag_context" {
						datacontext = "[LoanEntry.GetLoan.GetLender]"
					}
				}
			}

			text_single = {
				autoresize = yes
				block "loan_entry_content_counterparty_text" {
					text = "[LoanEntry.GetShortNameAsBorrowerWithNoFlagWithNoTooltip|L]"
				}
			}
		}

		expand = {}

		### Duration (months left — hidden for perpetual bonds)
		widget = {
			layoutpolicy_vertical = expanding
			size = { 45 -1 }
			text_single = {
				parentanchor = center
				visible = "[Not(LoanEntry.IsBond)]"
				raw_text = "[LoanEntry.GetLoan.GetMonthsLeft]m"
				align = right|nobaseline
			}
		}

		### Remaining debt
		text_single = {
			margin = { 5 5 }
			minimumsize = { 70 -1 }
			raw_text = "[LoanEntry.GetLoan.GetDebt|2V][gold_i]"
			align = center|nobaseline
			using = bg_credit_container_bckg
		}

		### Monthly cost
		text_single = {
			minimumsize = { 70 -1 }
			block "loan_cost_text" {
				raw_text = "[LoanEntry.GetLoan.GetInterest|%] (#R [LoanEntry.GetLoan.GetMonthlyCost|2]#!@expense!)"
			}
			align = right|nobaseline
		}
	}
}

lateralview = {
	name = "credit"

	# SOUND - Current Debt (Left Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_currentDebt_show" }

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }
			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }
				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_economy')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "THE_ECONOMY_OVERVIEW_TITLE"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_economy_texture
			}
		}
	}
	
	blockoverride "panel_content" {
	
		header_main_tabs = {
			blockoverride "content" {
				using = economy_main_tabs
			}
		}
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 3

			AutomatedSection = {
				datacontext = "[GetAutomatedSystemItem('credit')]"

				blockoverride "glow_anim_automation_visible" {
					visible = "[AutomatedSystemsItem.IsEnabled]"
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				size = { -1 65 }

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 8 8 }
					spacing = 8

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetConceptTexture('borrower')]"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = { 0.0 0.0 0.0 1.0 }
											alpha = 0.3
										}
									}
								}
								blockoverride "concept_link" {
									text = [loan|e]
								}
								blockoverride "title_text" { text = "LOANS_TAKEN_TITLE" }
								blockoverride "description_text" {}
								blockoverride "tooltip_content" {
									icon_pie = {
										visible = "[Not(IsDataModelEmpty(CreditLateralView.GetLoansTakenMerged))]"
										blockoverride "PieSize" { size = { 120 120 } }
										blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
										blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetShortNameAsBorrower]" }
										blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
										blockoverride "SliceColor" { color = "[LoanEntry.GetColor]" }
										blockoverride "Icon" { texture = "[GetConceptTexture('borrower')]" }
										blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
										blockoverride "item_bg_color" { using = color_light_paper_texture alpha = 0.1 }
										blockoverride "color" { color = "[LoanEntry.GetColor]" }
										blockoverride "leftside_info" { text = "[LoanEntry.GetShortNameAsBorrower]" }
										blockoverride "rightside_info" { raw_text = "[LoanEntry.GetAmount|2]@gold!" }
									}
									TooltipTextBlock = {
										visible = "[IsDataModelEmpty(CreditLateralView.GetLoansTakenMerged)]"
										blockoverride "text" { text = "NO_LOANS_TAKEN" }
									}
								}
							}
						}

						icon_pie_left = {
							using = bg_circle_piechart_big
							blockoverride "PieSize" { size = { 40 40 } }
							blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansTaken]" }
							blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
							blockoverride "SliceColor" { color = "[LoanEntry.GetColor]" }
							blockoverride "Icon" { texture = "[GetConceptTexture('borrower')]" }
							blockoverride "SliceTooltip" {
								# tooltipwidget = {
								# 	ContextualTooltipType = {
								# 		blockoverride "title_icon" {
								# 			icon = {
								# 				using = tooltip_title_icon_size
