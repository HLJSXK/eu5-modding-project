	# RIGHT PANEL
	widget = {
		visible = "[EndGameView.IsLeftPanelVisible]"
		alwaystransparent = no
		parentanchor = bottom|right
		size = { 410 100% }
		vbox = {
			margin_top = 40
			vbox = {
				using = layoutpolicy_expanding
				using = bg_lateralview

				EndGameViewContentRight = {}
			}
		}
	}

	# DATE DISPLAY
	widget = {
		parentanchor = top|hcenter
		position = { 0 @[timeline_topbar_height -2] }

		hbox = {
			set_parent_size_to_minimum = yes
			minimumsize = { -1 40 }
			using = bg_mapmenu_tab
			

			icon = { 
				using = left_decoration_icon
				mirror = vertical
			}

			hbox = {
				using = layoutpolicy_expanding

				text_single = {
					size = { 350 32 }
					using = Font_Type_Headers
					using = Font_Size_Medium
					align = center
					default_format = "#color_white"
					autoresize = no
					text = "[TimelinePlaybackPanel.GetCursorDateString]"
				}
			}

			icon = { 
				using = right_decoration_icon
				mirror = horizontal|vertical
			}

			blockoverride "bg_mapmenu_texture_setup" { mirror = vertical }
		}
	}

	# TOP BAR
	widget = {
		size = { 100% @timeline_topbar_height }
		parentanchor = top|hcenter
		alwaystransparent = no
		using = top_bar_bg
		filter_mouse = right|left

		using = Animation_Show_Hide_UI_Lobby

		hbox = {
			using = layoutpolicy_expanding
			expand = {}

			button_regular = {
				size = { 400 36 }
				enabled = "[CanToggleTimelineMode]"
				action_tooltip = {
					title = "END_GAME_VIEW_PLAY_TIMELINE"
					description = "TOGGLE_TIMELINE_MODE_DESC"
					on_action = "[ToggleTimelineMode]"
					enabled = "[CanToggleTimelineMode]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
				text = "END_GAME_VIEW_PLAY_TIMELINE"

				icon = {
					alwaystransparent = yes
					texture = "gfx/interface/buttons/timeline_icon.dds"
					texture_density = 2
					size = { 66 30 }
					parentanchor = vcenter|right
					position = { 0 0 }
					mirror = horizontal
				}

				icon = {
					alwaystransparent = yes
					texture = "gfx/interface/icons/messages_settings/play.dds"
					texture_density = 2
					size = { 22 22 }
					parentanchor = vcenter|left
					position = { 10 0 }
				}
			}

			expand = {}
		}

		hbox = {
			header_button_left = {
				size = { -1 32 }

				blockoverride "header_button_icon_size" { size = { 32 32 } }
				blockoverride "header_button_template_minimumsize" {
					minimumsize = { -1 32 }
				}

				action_tooltip = {
					title = "END_GAME_VIEW_QUIT_TOOLTIP"
					on_action = "[EndGameView.OnQuit]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }

				blockoverride "adjust_to_content" {
					set_parent_size_to_minimum = yes
				}

				blockoverride "text_top" {
					text = "EXIT"
					default_format = "#L"
					fontsize = 15
				}

				blockoverride "icon_texture" {
					using = back_button_alt_texture
				}
			}

			header_button_left = {
				size = { -1 32 }

				blockoverride "header_button_icon_size" { size = { 32 32 } }
				blockoverride "header_button_template_minimumsize" {
					minimumsize = { -1 32 }
				}

				visible = "[EndGameView.CanContinuePastEndDate]"
				action_tooltip = {
					title = "CONTINUE_PAST_END_DATE_TOOLTIP"
					on_action = "[EndGameView.OnContinue]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }

				blockoverride "adjust_to_content" {
					set_parent_size_to_minimum = yes
				}

				blockoverride "text_top" {
					text = "CONTINUE_PAST_END_DATE"
					default_format = "#L"
					fontsize = 15
				}

				blockoverride "icon_texture" {
					texture = "gfx/interface/icons/messages_settings/play.dds"
				}
			}

			header_button_left = {
				size = { -1 32 }

				blockoverride "header_button_icon_size" { size = { 32 32 } }
				blockoverride "header_button_template_minimumsize" {
					minimumsize = { -1 32 }
				}

				action_tooltip = {
					title = "END_GAME_VIEW_OBSERVE_TOOLTIP"
					on_action = "[EndGameView.OnObserve]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }

				blockoverride "adjust_to_content" {
					set_parent_size_to_minimum = yes
				}

				blockoverride "text_top" {
					text = "END_GAME_VIEW_OBSERVE"
					default_format = "#L"
					fontsize = 15
				}

				blockoverride "icon_texture" {
					button_checkbox_visibility = {
						alwaystransparent = yes
						size = { 20 20 }
						down = yes
					}
				}
			}

			expand = {}

			# Speed pips
			header_button_left = {
				size = { 410 32 }

				blockoverride "header_button_icon_size" { size = { 32 32 } }
				blockoverride "header_button_template_minimumsize" {
					minimumsize = { -1 32 }
				}

				action_tooltip = {
					title = "TOGGLE_LEFT_PANEL"
					description = "TOGGLE_LEFT_PANEL_DESC"
					on_action = "[EndGameView.ToggleLeftPanel]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }

				blockoverride "text_top" {
					text = "ENDGAME_GREATEST_RULERS"
					default_format = "#L"
					fontsize = 15
				}

				blockoverride "icon_texture" {
					texture = "gfx/interface/icons/character_roles/ruler.dds"
				}

				blockoverride "icon_overlay" {}
			}
		}
	}

	# END GAME POPUP 
	window = {
		parentanchor = center
		movable = no
		layer = top
		allow_outside = yes
		using = snd_UI_event_expedition
	
		datacontext = "[Player]"
	
		vbox = {
			set_parent_size_to_minimum = yes
			bottomtotop = yes
			allow_outside = yes
			spacing = -3

			vbox = {
				margin = { 5 10 }
				layoutpolicy_horizontal = expanding
				using = bg_expedition_event_inner
				allow_outside = yes
	
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 20 15 }
					margin_top = 10
					spacing = 15
					allow_outside = yes
	
					widget = {
						size = { 540 160 }
						allow_outside = yes
	
						widget = {
							size = { 324 132 }
							parentanchor = center
							ecs_scene_viewer_widget = {
								size = { 100% 100% }
								name = "event_window_scene_viewer"
								datacontext = "[Player]"
								scene = "[Country.GetGovernment.GetRulerOrRegent.GenerateCharacterSceneDesc]"
							}

							widget = {
								parentanchor = center
								size = { 324 132 }
								using = bg_expeditions_illustration_frame
							}
						}
	
						widget = {
							ignore_layout = yes
							allow_outside = yes
							parentanchor = left|vcenter
							widgetanchor = left|vcenter
							position = { -90 -35 }
							size = { 200 300 }
							datacontext = "[Country.GetGovernment.GetRulerOrRegent]"
	
							portrait_standard_full_body_center_button = {
								size = { 100% 100% }
								mask = "gfx/portraits/portrait_mask_full_gradient.dds"
								portrait_texture = "[Character.GetAnimatedPortrait( 'full_torso', 'camera_torso_right', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self) )]"
							}
	
							widget = {
								parentanchor = hcenter|bottom
								widgetanchor = hcenter|bottom
								ignore_layout = yes
								allow_outside = yes
								position = { 12 -35 }
	
								hbox = {
									set_parent_size_to_minimum = yes
									
									margin_bottom = 1
									using = bg_name_banner
									datacontext = "[Country.GetGovernment.GetRulerOrRegent]"
									
									text_single = {
										margin = { 25 10 }
										margin_bottom = 12
										maximumsize = { 180 35 }
										text = "[Character.GetNameToFit('(int32)22', '(bool)yes')]"
										using = Font_Type_Headers
										using = Font_Size_Small
										default_format = "#yellow_titles"
										autoresize = yes
									}
								}
							}
						}
	
						country_flag_big = {
							parentanchor = right|vcenter
							widgetanchor = right|vcenter
						}
					}
	
					vbox = {
						bottomtotop = yes
						layoutpolicy_horizontal = expanding
						spacing = -15
						
	
						vbox = {
							layoutpolicy_horizontal = expanding
							margin = { 0 15 }
							alwaystransparent = no
	
							widget = {
								layoutpolicy_horizontal = expanding
		
								AnimatedScrollBackground = {}
		
								scrollvbox = {
									set_parent_dimension_to_minimum = height
									maximumsize = { -1 235 }
									alwaystransparent = no
			
									scrollbar_vertical = {
										ScrollbarVertical = {
											parentanchor = right
											using = AnimatedScrollFadeInOut_template
										}
									}
		
									text_multi = {
										autoresize = yes
										using = Font_Type_Flavor
										minimumsize = { 515 -1 }
										maximumsize = { 515 -1 }
										margin = { 15 6 }
										text = "[EndGameView.GetText]"
	
										using = AnimatedScrollFadeInOut_template
									}
								}
							}
						}
						
	
						widget = {
							layoutpolicy_horizontal = expanding
							size = { -1 42 }
	
							background = {
								using = bg_banner_02_cloth_texture
								blockoverride "button_texture" {
									texture = "gfx/interface/buttons/button_banner_03.dds"
								}
								frame = 1
								margin = { 13 3 }
							}
	
							text_single = {
								margin_top = 6
								parentanchor = hcenter
								using = Font_Size_Medium
								text = "ENDGAME_SCORE"
								default_format = "#yellow_titles"
							}
						}
					}
				}
			}
	
			vbox = {
				#layoutpolicy_horizontal = expanding

				widget = {
					#layoutpolicy_horizontal = expanding
					minimumsize = { 590 40 }
					allow_outside = yes

					hbox = {
						parentanchor = hcenter
						maximumsize = { 400 40 }
						using = bg_mapmenu_tab
						allow_outside = yes

						icon = {
							using = left_decoration_icon
						}

						hbox = {
							using = layoutpolicy_expanding
							ignoreinvisible = yes

							# Great Power
							text_single = {
								visible = "[EndGameView.WonGame]"
								autoresize = yes
								align = center|nobaseline
								using = Font_Type_Headers
								using = Font_Size_Big
								maximumsize = { 250 -1 }
								fontsize_min = 14
								default_format = "#yellow_titles"
								text = "END_GAME_VIEW_GREAT_POWER_TITLE"
							}

							# Surviving
							text_single = {
								visible = "[And(Not(EndGameView.WonGame),Not(EndGameView.LostGame))]"
								autoresize = yes
								align = center|nobaseline
								using = Font_Type_Headers
								using = Font_Size_Big
								maximumsize = { 250 -1 }
								fontsize_min = 14
								default_format = "#yellow_titles"
								text = "END_GAME_VIEW_SURVIVING_TITLE"
							}

							# Losing
							text_single = {
								visible = "[EndGameView.LostGame]"
								autoresize = yes
								align = center|nobaseline
								using = Font_Type_Headers
								using = Font_Size_Big
								maximumsize = { 250 -1 }
								fontsize_min = 14
								default_format = "#yellow_titles"
								text = "END_GAME_VIEW_LOSING_TITLE"
							}
						}

						icon = {
							using = right_decoration_icon
						}
					}
				}
			}
		}
	}
}
