	type game_rules_preset_window = window {
		name = "game_rules_preset"

		parentanchor = top|left
		widgetanchor = top|right

		size = { 365 600 }

		using = bg_sidemenu
		layer = confirmation
		movable = no
		visible_at_creation = no
		alwaystransparent = no
		allow_outside = yes

		visible = "[JominiGameRules.IsPresetWindowShown]"

		vbox = {
			set_parent_size_to_minimum = yes

			vbox = {
				using = bg_message_dialog_title
				blockoverride "fold_margin" { alpha = 0 }
				blockoverride "fold_shadow_margin" { alpha = 0 }
				blockoverride "header_color" { using = color_dark_brown_texture }
				blockoverride "header_pattern" {
					texture = "gfx/interface/component_overlay/scrollwork_texture_01.dds"
					spriteborder = { 0 0 }
					alpha = 0
				}
	
				layoutpolicy_horizontal = expanding
				minimumsize = { -1 42 }
				margin = { 10 5 }
				spacing = 10
	
				text_multi = {
					using = layoutpolicy_expanding
					margin = { 10 0 }
					fontsize = 15
					align = center
					autoresize = yes
					using = Font_Size_Big
	
					default_format = "#header_titles"
					text = "SAVE_PRESET_HEADER"
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				margin = { 20 10 }
				spacing = 10

				editbox_single = {
					layoutpolicy_horizontal = expanding
					tooltipwidget = { BasicFunctionalTooltip = {} }
	
					blockoverride "editbox_label" {
						text = "SAVE_PRESET_SAVE_AS_LABEL"
					}
	
					blockoverride "editbox_properties" {
						name = "preset_name_edit"
						multiline = no
						maxcharacters = 240
						text = "[JominiGameRules.GetPresetSaveName]"
						ontextedited = "[JominiGameRules.OnPresetSaveNameEdit]"
					}
				}
	
				scrollarea = {
					scrollbarpolicy_horizontal = always_off
					alwaystransparent = no
					# autoresizescrollarea = yes
	
					minimumsize = { 360 450 }
					maximumsize = { -1 450 }
	
					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}
	
					scrollwidget = {
						fixedgridbox = {
							datamodel = "[JominiGameRules.GetRulePresets]"
							addcolumn = 100%
							addrow = 70
							datamodel_wrap = 1
							maxhorizontalslots = 1
							flipdirection = yes
	
							item = {
								card_list_button = {
									size = { 100% 60 }
	
									action_tooltip = {
										click_mode = single
										click_type = left
										title = "SELECT_PRESET_BUTTON_TOOLTIP"
										on_action = "[JominiGameRules.OnPresetSaveNameChange( GuiGameRulePreset.GetName )]"
									}

									modify_texture = {
										using = color_bone_texture
										visible = "[EqualTo_string(JominiGameRules.GetPresetSaveName, GuiGameRulePreset.GetName)]"
										alpha = 0.3
									}

									tooltipwidget = { BasicFunctionalTooltip = {} }
	
									hbox = {
										margin = { 10 0 }
										spacing = 10
	
										vbox = {
											layoutpolicy_horizontal = expanding
											text_single = {
												layoutpolicy_horizontal = expanding
												text = "[GuiGameRulePreset.GetName]"
												default_format = "#yellow_titles"
											}
	
											text_single = {
												layoutpolicy_horizontal = expanding
												datacontext = "[GuiGameRulePreset.GetSettingForRule( 'ai_difficulty' )]"
												text = "GAME_RULES_PRESET_AI_BEHAVIOR"
											}
										}
	
										widget = {
											size = { 20 20 }
											icon = {
												visible = "[Not( GuiGameRulePreset.HasRuleWithFlag('blocks_achievements') )]"
												texture = "gfx/interface/icons/text_icons/trigger_yes.dds"
												size = { 20 20 }
											}
	
											icon = {
												visible = "[GuiGameRulePreset.HasRuleWithFlag('blocks_achievements')]"
												texture = "gfx/interface/icons/text_icons/trigger_no.dds"
												size = { 20 20 }
											}
										}
									}
								}
							}
						}
					}
				}
				
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10
	
					button_default = {
						layoutpolicy_horizontal = expanding
						enabled = "[JominiGameRules.HasPresetWithName(JominiGameRules.GetPresetSaveName)]"
						onclick = "[JominiGameRules.DeletePresetWithName( JominiGameRules.GetPresetSaveName )]"
	
						text = "DELETE"
						tooltip_enabled = no
					}
	
					button_default = {
						layoutpolicy_horizontal = expanding
						visible = "[Not(JominiGameRules.HasPresetWithName(JominiGameRules.GetPresetSaveName))]"
						enabled = "[Not(StringIsEmpty(JominiGameRules.GetPresetSaveName))]"
						onclick = "[JominiGameRules.SavePreset]"
						onclick = "[ApplySettingsAndIronman]"
						onclick = "[JominiGameRules.HidePresetWindow]"
	
						text = "SAVE"
						tooltip_enabled = no
					}
	
					button_default = {
						layoutpolicy_horizontal = expanding
						visible = "[JominiGameRules.HasPresetWithName(JominiGameRules.GetPresetSaveName)]"
						onclick = "[JominiGameRules.SavePreset]"
						onclick = "[ApplySettingsAndIronman]"
						onclick = "[JominiGameRules.HidePresetWindow]"
	
						text = "OVERWRITE"
						tooltip_enabled = no
					}
				}
			}
		}

		button_close_alt = {
			parentanchor = right|top
			position = { -10 10 }

			blockoverride "close_title" {
				title = "EDIT_PRESET_NAME"
			}
			
			blockoverride "close_on_action" {
				on_action = "[JominiGameRules.HidePresetWindow]"
			}
		}
	}

	type game_rules_for_tab = vbox {
		datamodel = "[JominiGameRules.GetSettings]"
		# addcolumn = 100%
		# addrow = 160
		# datamodel_wrap = 1
		# maxhorizontalslots = 1
		# flipdirection = yes
		# setitemsizefromcell = yes
		
		item = {
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 160 }
				block "game_rule_type" {
					visible = "[GuiGameRule.GetSetting.HasFlag( 'general_rule' )]"
				}
				datacontext = "[GuiGameRule.GetRule]"
				datacontext = "[GuiGameRule.GetSetting]"
				
				vbox = {
					margin = { 10 0 }
					margin_top = 10
					header_paper_card = {
						blockoverride "header_paper_card_size" {
							using = layoutpolicy_expanding
						}
							
						blockoverride "header_size" {
							size = { -1 65 }
						}
	
						blockoverride "header_content" {
							vbox = {
								spacing = 3
								layoutpolicy_horizontal = expanding
								margin = {5 0}
								margin_top = 9
								text_single = {
									text = "[GameRule.GetName]"
									maximumsize =  { 250 -1 }
									fontsize = 15
								}
	
								expand = {}
	
								widget_game_rule_option = {}
							}
						}
	
						blockoverride "bottom_content" {
							size = { -1 65 }
							text_multi = {
								size = { 100% 100% }
								text = "[GameRuleSetting.GetDescription]"
								margin = { 15 15 }
								margin_right = 7
								fontsize = 13
							}
						}
						widget = {
							size = {100% 100%}
							ignore_layout = yes
							using = bg_cabinet_card_frame
						}
					}
				}
			}
		}
	}
}
