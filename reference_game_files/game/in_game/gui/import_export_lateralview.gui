lateralview = {
	name = "import_export_lateralview"

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }
			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }
				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_economy')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			using = bg_main_inner_alt
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
			
			blockoverride "header_text_object" {
				hbox = {
					using = layoutpolicy_expanding
					spacing = 5

					expand = {}

					icon = {
						visible = "[ImportExportLateralView.IsExport]"
						size = {30 30}
						texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
						texture_density = 2
						glow = {
							name = "drop_shadow"
							glow_radius = 4
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.3
						}
					}

					icon = {
						visible = "[Not(ImportExportLateralView.IsExport)]"
						size = {30 30}
						texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
						texture_density = 2
						glow = {
							name = "drop_shadow"
							glow_radius = 4
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.3
						}
					}

					header_title = {
						layoutpolicy_horizontal = fixed
						layoutpolicy_vertical = fixed
						autoresize = yes
						maximumsize = { 420 -1 }
						text = "[SelectLocalization( ImportExportLateralView.IsExport, 'EXPORTS_TITLE', 'IMPORTS_TITLE' )]"
					}

					expand = {}
				}
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_notabs_alt
			using = window_main_tabs_margin_alt
			spacing = 3
			datacontext = "[ImportExportLateralView.GetMarket]"
			margin_top = 5
				
			hbox = {
				margin = { 10 5 }
				spacing = 6
				datacontext = "[Market.GetMarketEntry(ImportExportLateralView.GetGoods)]"
				layoutpolicy_horizontal = expanding
				size = { -1 60 }
				using = bg_paper_card

				# goods icon
				header_button_left = {
					size = { 40 40 }
					blockoverride "button_icon_stretch_sprite" {}
					blockoverride "header_button_frame_inner" { visible = no }
					blockoverride "header_button_icon_size" { size = { 40 40 } }
					blockoverride "header_button_text_layout" {}
					blockoverride "icon_overlay" {}
					blockoverride "icon_texture" {
						texture = "[GetGoodsIcon(GoodsMarketEntry.GetGoods)]"
						texture_density = 2
					}
					datacontext = "[GoodsMarketEntry.GetGoods]"
					onmousehierarchyenter = "[PdxGuiWidget.SetHighlightGoods(GoodsMarketEntry.GetGoods)]"
					tooltipwidget = {
						using = SpecificGoodsMarket_tooltip
					}
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "OPEN_GOOD_PANEL"
						on_action = "[ShowGoods(GoodsMarketEntry.GetGoods)]"
					}
				}

				# stockpile progress bar
				widget = {
					size = { 15 22 }
					progressbar = {
						parentanchor = center
						size = { 5 22 }
						using = progress_bar_green_alt
						value = "[FixedPointToFloat(Divide_CFixedPoint(GoodsMarketEntry.GetStockpile, GoodsMarketEntry.GetMarket.GetCenterLocation.GetModifierValueFixed('maximum_stockpile_capacity')))]"
						min = 0
						max = 1
						direction = vertical
					}
					tooltipwidget = {
						using = GoodsMarketEntry_template
					}
				}

				# local balance
				widget = {
					size = { 80 20 }
					datacontext = "[GoodsMarketEntry.GetGoods]"
					tooltipwidget = {
						using = goods_market_local_balance_tooltip
					}
					hbox = {
						expand = {}
						hbox = {
							spacing = 3
							text_single = {
								maximumsize = { 45 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[Market.GetBalanceWithoutTrades(Goods.Self)|+=2]"
							}
							icon = {
								size = { 16 16 }
								texture = "[GetConceptTexture('goods')]"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
						}
					}
				}

				# imports
				widget = {
					size = { 80 20 }
					datacontext = "[GoodsMarketEntry.GetGoods]"
					tooltipwidget = {
						using = goods_market_imports_tooltip
					}
					hbox = {
						expand = {}
						hbox = {
							spacing = 3
							text_single = {
								visible = "[GreaterThan_CFixedPoint(Market.GetSupplyImportOnly(Goods.Self),'(CFixedPoint)0')]"
								maximumsize = { 40 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[Market.GetSupplyImportOnly(Goods.Self)|L2]"
							}
							text_single = {
								visible = "[Not(GreaterThan_CFixedPoint(Market.GetSupplyImportOnly(Goods.Self),'(CFixedPoint)0'))]"
								maximumsize = { 40 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[Market.GetSupplyImportOnly(Goods.Self)|2]"
								default_format = "#weak"
							}
							icon = {
								size = { 18 18 }
								texture = "[GetConceptTexture('import')]"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
						}
					}
				}

				# exports
				widget = {
					size = { 80 20 }
					datacontext = "[GoodsMarketEntry.GetGoods]"
					tooltipwidget = {
						using = goods_market_exports_tooltip
					}
					hbox = {
						expand = {}
						hbox = {
							spacing = 3
							text_single = {
								visible = "[GreaterThan_CFixedPoint(Market.GetDemandExportOnly(Goods.Self),'(CFixedPoint)0')]"
								maximumsize = { 40 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[Market.GetDemandExportOnly(Goods.Self)|L2]"
							}
							text_single = {
								visible = "[Not(GreaterThan_CFixedPoint(Market.GetDemandExportOnly(Goods.Self),'(CFixedPoint)0'))]"
								maximumsize = { 40 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[Market.GetDemandExportOnly(Goods.Self)|2]"
								default_format = "#weak"
							}
							icon = {
								size = { 18 18 }
								texture = "[GetConceptTexture('export')]"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
						}
					}
				}

				# divider
				widget = {
					size = { 25 30 }
					icon = {
						parentanchor = center
						size = { 24 30 }
						texture = "gfx/interface/buttons/flats/button_simple.dds"
						modify_texture = {
							using = color_bone_texture
							blend_mode = normal
						}
					}
				}

				# surplus
				widget = {
					size = { 80 20 }
					datacontext = "[GoodsMarketEntry.GetGoods]"
					tooltipwidget = {
						using = goods_market_balance_tooltip
					}
					hbox = {
						expand = {}
						hbox = {
							spacing = 3
							text_single = {
								maximumsize = { 42 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[Market.GetSurplus(Goods.Self)|+=2]"
							}
							icon = {
								size = { 18 18 }
								texture = "gfx/interface/icons/flat_icons/trade_market/goods_balance.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
						}
					}
				}

				# price
				widget = {
					size = { 60 20 }
					tooltipwidget = {
						using = goods_market_price_tooltip
					}
					hbox = {
						expand = {}
						hbox = {
							spacing = 2
							text_single = {
								maximumsize = { 30 20 }
								align = center|nobaseline
								using = Font_Size_Small
								text = "[GoodsMarketEntry.GetPrice|2]"
							}
							text_single = {
								maximumsize = { 20 20 }
								align = right|nobaseline
								using = Font_Size_Small
								raw_text = "@[GoodsMarketEntry.GetGoods.GetPriceDifferenceIconName(GoodsMarketEntry.GetPrice)]!"
							}
						}
					}
				}

				expand = {}
			}

			AutomatedTradeSlider = {
				margin_top = 4
				margin_bottom = 4
			}

			widget = {
				layoutpolicy_horizontal = expanding
				using = bg_paper_card
				using = bg_cabinet_card_frame
				size = { -1 45 }
				TradeOrderCard = {
					datacontext = "[ImportExportLateralView.GetTradeOrderItem]"

					blockoverride "trade_order_card_inner_margin" {
						margin = { 7 5 }
						margin_right = 10
					}

					blockoverride "trade_order_card_actions" {
						action_tooltip = {
							click_type = left
							click_mode = single
							title = "[SelectLocalization( ImportExportLateralView.IsExport, 'TRADE_ORDER_CREATE_IE_TT_EXPORT', 'TRADE_ORDER_CREATE_IE_TT_IMPORT')]"
							enabled = "[And(Not(ImportExportLateralView.HasTradeOrder), ImportExportLateralView.CanIncreaseTradeOrder)]"
							conditions = "[ImportExportLateralView.GetTradeOrderNotPossibleInfo]"
							on_action = "[ImportExportLateralView.IncreaseTradeOrder('(float)1')]"
						}

						action_tooltip = {
							click_type = right
							click_mode = single
							title = "TRADE_ORDER_CANCEL_TT"
							enabled = "[ImportExportLateralView.HasTradeOrder]"
							on_action = "[ImportExportLateralView.CancelTradeOrder]"
						}
					}

					blockoverride "trade_order_card_reorder_column" {
						widget = {
							size = { 0 0 }
							visible = no
						}
					}
				}
			}

			widget = {
				# visible = "[ImportExportLateralView.HasTradeOrder]"
				layoutpolicy_horizontal = expanding
				size = { -1 190 }
				using = bg_paper_card
				using = bg_cabinet_card_frame

				hbox = {
					margin = { 5 5 }
					scroll_list = {
	
						blockoverride "scroll_list_layout" {
							fixedgridbox = {
								addcolumn = 100%
								addrow = 42
								datamodel = "[ImportExportLateralView.GetTradesInMarket]"
	
								item = {
									widget = {
										size = { 100% 40 }
										parentanchor = hcenter
										ExistingTradeCard = {
											datacontext = "[Trade]"
	
											blockoverride "trade_ui_actions" {
												action_tooltip = {
													click_type = left
													click_mode = single
													title = "OPEN_TRADE_DETAILS"
													on_action = "[ShowTradeDetails(Trade.Self)]"
												}
												action_tooltip = {
													enabled = "[ObjectsEqual(Trade.GetOwner, Player.Self)]"
													click_type = right
													click_mode = confirm
													conditions = "CANCEL_TRADE_DISABLED"
													title = "CANCEL_TRADE"
													on_action = "[CancelTrade(Trade.Self)]"
												}
											}
										}
									}
								}
							}
						}
	
						blockoverride "scroll_list_is_empty" {
							visible = "[IsDataModelEmpty(ImportExportLateralView.GetTradesInMarket)]"
						}
	
						blockoverride "scroll_list_is_empty_text" {
							text = "TRADE_ORDER_TRADES_SCROLL_LIST_EMPTY"
						}
					}
				}
			}

			vbox = {
				using = layoutpolicy_expanding

				filtered_sorted_list = {
					datacontext = "[ImportExportLateralView.GetItemsSortSearch]"

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(ImportExportLateralView.GetItems)]"
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							using = layoutpolicy_expanding
						}
						
						sort_by_key_button = {
							name = "market"
							layoutpolicy_vertical = expanding
							size = { 67 -1 }
						}
						
						sort_by_key_button = {
							name = "stockpile"
							layoutpolicy_vertical = expanding
							size = { 35 -1 }
						}
						
						sort_by_key_button = {
							name = "surplus"
							layoutpolicy_vertical = expanding
							size = { 65 -1 }
							blockoverride "sort_by_key_button_texture"{
								texture = "gfx/interface/icons/sort/goods_balance.dds"
							}
						}

						sort_by_key_button = {
							name = "price"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
							blockoverride "sort_by_key_button_texture"{
								texture = "gfx/interface/icons/sort/market_price_diff.dds"
							}
						}
						
						sort_by_key_button = {
							name = "profit"
							layoutpolicy_vertical = expanding
							size = { 65 -1 }
						}
						
						sort_by_key_button = {
							name = "moving_goods_amount"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
							blockoverride "sort_by_key_button_texture"{
								texture = "gfx/interface/icons/sort/quantity_of_goods_moved.dds"
							}
						}

						sort_by_key_button = {
							name = "merchant_power"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
						}

						sort_by_key_padding = {
							layoutpolicy_vertical = expanding
							size = { 75 -1 }
						}
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 50
						datamodel = "[ImportExportLateralView.GetItems]"
						datamodel_reuse_widgets = yes
						item = {
							widget = {
								size = { 100% 45 }
								using = imports_exports_entry
							}
						}
					}
				}
			}
		}
	}
}
