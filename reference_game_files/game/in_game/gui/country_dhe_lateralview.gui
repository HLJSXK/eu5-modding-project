lateralview = {
	name = "country_dhe_lateralview"

	# blockoverride "panel_header" {
	# 	window_header_alt = {
	# 		blockoverride "header_text" {
	# 			max_width = 500
	# 			text = "[CountryDHEView.GetTitle]"
	# 			autoresize = yes
	# 		}
	# 	}

	# 	header_main_tabs = {
	# 		blockoverride "content" {
	# 			using = government_main_tabs
	# 		}
	# 	}
	# }

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "GOV_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = government_main_tabs
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 5
			margin_top = 2

			filtered_sorted_list = {
				datacontext = "[CountryDHEView.GetEntriesSortSearch]"

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "age"
						size = { 75 -1 }
						layoutpolicy_vertical = expanding
					}

					sort_by_key_button = {
						name = "name"
						using = layoutpolicy_expanding
					}

					sort_by_key_button = {
						name = "date"
						using = layoutpolicy_expanding
					}
					
					sort_by_key_button = {
						name = "status"
						size = { 90 -1 }
						layoutpolicy_vertical = expanding
					}
				}

				blockoverride "scroll_list_content" {
					addcolumn = 100%
					addrow = 82
					setitemsizefromcell = yes

					datamodel = "[CountryDHEView.GetEntries]"
					item = {
						widget = {
							hbox = {
								margin = { 0 5 }
								margin_left = 6
								margin_right = 4

								vbox = {
									using = layoutpolicy_expanding
									using = bg_paper_card

									widget = {
										size = { -1 36 }
										layoutpolicy_horizontal = expanding

										# Dark shadow strip at bottom of header
										background = {
											texture = "gfx/interface/colors/black.dds"
											margin = { 1 1 }
											margin_bottom = 2
											texture_density = 2
											alpha = 0.4
										}

										# Color overlay: yellow=happened, grey=expired, pink=pending
										background = {
											texture = "gfx/interface/colors/mid_yellow.dds"
											alpha = 0.45
											visible = "[DHEEventEntry.IsStatusHasHappened]"
											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay
												alpha = 0.35
											}
											modify_texture = {
												texture = "gfx/interface/component_overlay/cloth_texture.dds"
												texture_density = 2
												spriteType = Corneredtiled
												spriteborder = { 0 0 }
												blend_mode = overlay
												alpha = 0.2
											}
										}

										background = {
											texture = "gfx/interface/colors/greyish.dds"
											alpha = 0.45
											visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay
												alpha = 0.35
											}
											modify_texture = {
												texture = "gfx/interface/component_overlay/cloth_texture.dds"
												texture_density = 2
												spriteType = Corneredtiled
												spriteborder = { 0 0 }
												blend_mode = overlay
												alpha = 0.2
											}
										}

										background = {
											texture = "gfx/interface/colors/light_red.dds"
											alpha = 0.45
											visible = "[DHEEventEntry.IsStatusNotYet]"
											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay
												alpha = 0.35
											}

											modify_texture = {
												texture = "gfx/interface/component_overlay/cloth_texture.dds"
												texture_density = 2
												spriteType = Corneredtiled
												spriteborder = { 0 0 }
												blend_mode = overlay
												alpha = 0.2
											}
										}

										hbox = {
											size = { 100% 100% }
											margin = { 6 0 }
											margin_left = 64
											spacing = 5

											# Title text
											text_single = {
												using = layoutpolicy_expanding
												align = left|nobaseline
												text = "[DHEEventEntry.GetTitle]"
												autoresize = no
												default_format = "#yellow_titles"
											}
											
											# Status icon
											icon = {
												size = { 25 25 }
												texture = "gfx/interface/icons/text_icons/dhe_status_has_happened.dds"
												visible = "[DHEEventEntry.IsStatusHasHappened]"
											}
											icon = {
												size = { 25 25 }
												texture = "gfx/interface/icons/text_icons/dhe_status_has_not_happened_yet.dds"
												visible = "[DHEEventEntry.IsStatusNotYet]"
											}
											icon = {
												size = { 25 25 }
												texture = "gfx/interface/icons/text_icons/dhe_status_time_has_passed.dds"
												visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
											}

											# Trigger result icon
											icon = {
												size = { 25 25 }
												texture = "gfx/interface/icons/text_icons/trigger_yes.dds"
												visible = "[DHEEventEntry.IsTriggerTrue]"
											}
											icon = {
												size = { 25 25 }
												texture = "gfx/interface/icons/text_icons/trigger_no.dds"
												visible = "[Not(DHEEventEntry.IsTriggerTrue)]"
											}
										}
									}

									widget = {
										using = layoutpolicy_expanding
										layoutpolicy_horizontal = expanding
										
										hbox = {
											size = { 100% 100% }
											margin = { 5 2 }
											margin_left = 64

											text_single = {
												using = layoutpolicy_expanding
												align = left|nobaseline
												text = "[DHEEventEntry.GetDateRange]"
												autoresize = no
												default_format = "#subtle_name"
											}
										}
									}

									tooltipwidget = {
										using = DHEEvent_tooltip
									}
								}
							}

							# Age icon
							icon = {
								ignore_layout = yes
								size = { 48 48 }
								position = { 15 0 }
								parentanchor = vcenter
								texture = "[GetAgeIcon(DHEEventEntry.GetAge)]"
								visible = "[DHEEventEntry.HasAge]"
								datacontext = "[DHEEventEntry.GetAge]"
								tooltipwidget = {
									using = Age_tooltip
								}
							}
						}
					}
				}
			}
		}
	}
}
