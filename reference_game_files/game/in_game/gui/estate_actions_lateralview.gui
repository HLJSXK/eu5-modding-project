types EstateActionsTypes
{
	type estate_action_button = card_list_button {
		blockoverride "card_list_button_paper_alpha" {
			alpha = 0.2
		}

		visible = "[PdxGuiWidget.IsUberButtonVisible]"
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

		scripted_action_tooltip = {
			click_type = left
			click_mode = confirm
			action_name = "[GenericAction.GetLeftClickAndHoldKey]"
			actor = "[Player]"
			parameter = {
				parameter_name = "target"
				parameter_value = "[EstateActionsLateralView.GetEstate]"
			}
		}

		tooltipwidget = {
			using = generic_action_tooltip
		}

		vbox = {
			set_parent_size_to_minimum = yes
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }

			margin = { 8 6 }
			spacing = 4

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				icon = {
					size = { 32 32 }
					block "action_icon" {
						texture = "[GenericAction.GetIcon]"
					}
					texture_density = 2
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = { 0.0 0.0 0.0 1.0 }
						alpha = 0.4
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = nobaseline|left
					default_format = "#yellow_titles"
					using = Font_Size_Medium
					text = "[GenericAction.GetNameWithNoTooltip]"
				}
			}

			TooltipConditionListContent = {
				datacontext = "[StringToConditionListOnlyPassedAndNeutral(UIAction.GetEffects)]"
				visible = "[ConditionList.HasItems]"
				layoutpolicy_horizontal = expanding
			}
		}
	}
}

lateralview = {
	name = "estate_actions_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "ESTATE_ACTIONS_LATERALVIEW_T"
				default_format = "#yellow_titles"
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 8

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 5 }
				estate_card_top_part = {
					datacontext = "[EstateActionsLateralView.GetEstate]"
				}
			}

			scroll_list = {
				using = layoutpolicy_expanding
				
				blockoverride "scroll_list_layout" {
					vbox = {
						using = layoutpolicy_expanding
						spacing = 4
						estate_action_button = { datacontext = "[GetGenericAction('bribe_estate')]" }
						estate_action_button = { datacontext = "[GetGenericAction('press_estate_private_regiments_action')]" }
						estate_action_button = { datacontext = "[GetGenericAction('ask_for_extra_levies')]" }
						estate_action_button = { datacontext = "[GetGenericAction('extraordinary_taxes')]" }
						estate_action_button = { datacontext = "[GetGenericAction('ask_clergy_for_legitimacy')]" }
						estate_action_button = { datacontext = "[GetGenericAction('ask_nobility_for_diplomats')]" }
						estate_action_button = { datacontext = "[GetGenericAction('ask_burghers_for_loan')]" }
						estate_action_button = { datacontext = "[GetGenericAction('ask_commoners_for_stability')]" }
						estate_action_button = { datacontext = "[GetGenericAction('ask_tribes_for_manpower')]" }
						estate_action_button = { datacontext = "[GetGenericAction('call_emergency_parliament')]" }
						estate_action_button = { datacontext = "[GetGenericAction('perform_reduction')]" }

						expand = {}
					}
				}
			}
		}
	}
}
