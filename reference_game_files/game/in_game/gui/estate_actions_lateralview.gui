template estate_action_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[UIAction.GetTitle]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture_density = 2
				block "tooltip_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/action.dds"
				}
			}
		}
		blockoverride "tooltip_content" {
			using = action_tooltip_inner_content
		}
	}
}

types EstateActionsTypes
{
	type estate_action_button = card_list_action_button {
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		actor = "[Player]"
		parameter = {
			parameter_name = "target"
			parameter_value = "[EstateActionsLateralView.GetEstate]"
		}

		vbox = {
			set_parent_dimension_to_minimum = height
			layoutpolicy_horizontal = expanding
			margin = { 8 6 }
			spacing = 4

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				icon = {
					size = { 32 32 }
					block "action_icon" {
						texture = "gfx/interface/icons/flat_icons/action.dds"
					}
					texture_density = 2
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = { 0.0 0.0 0.0 1.0 }
						alpha = 0.4
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = nobaseline|left
					default_format = "#yellow_titles"
					using = Font_Size_Medium
					text = "[UIAction.GetTitle]"
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				datacontext = "[StringToConditionListOnlyPassedAndNeutral(UIAction.GetEffects)]"
				visible = "[ConditionList.HasItems]"

				TooltipConditionListContent = {
					layoutpolicy_horizontal = expanding
					set_parent_dimension_to_minimum = height
				}
			}
		}
	}
}

lateralview = {
	name = "estate_actions_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "ESTATE_ACTIONS_LATERALVIEW_T"
				default_format = "#yellow_titles"
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 8

			# Estate card header — reuses the full estate card top part from government_lateralview
			estate_card_top_part = {
				datacontext = "[EstateActionsLateralView.GetEstate]"
			}

			# Action buttons — scrollable vertical list
			scrollarea = {
				using = layoutpolicy_expanding
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

					

						estate_action_button = {
							title = "bribe_estate"
							left_click_and_hold_action = { action_name = "bribe_estate" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/bribe.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/resources/bribe.dds"
								}
							}
						}

						estate_action_button = {
							title = "ask_for_extra_levies"
							left_click_and_hold_action = { action_name = "ask_for_extra_levies" }
							blockoverride "action_icon" {
								texture = "[GetConceptTexture('levies')]"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "[GetConceptTexture('levies')]"
								}
							}
						}

						estate_action_button = {
							title = "extraordinary_taxes"
							left_click_and_hold_action = { action_name = "extraordinary_taxes" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/gold.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/resources/gold.dds"
								}
							}
						}

						estate_action_button = {
							title = "ask_clergy_for_legitimacy"
							left_click_and_hold_action = { action_name = "ask_clergy_for_legitimacy" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/legitimacy.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/resources/legitimacy.dds"
								}
							}
						}

						estate_action_button = {
							title = "ask_nobility_for_diplomats"
							left_click_and_hold_action = { action_name = "ask_nobility_for_diplomats" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/flat_icons/diplomatic_actions.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/flat_icons/diplomatic_actions.dds"
								}
							}
						}

						estate_action_button = {
							title = "ask_burghers_for_loan"
							left_click_and_hold_action = { action_name = "ask_burghers_for_loan" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/flat_icons/debt.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/flat_icons/debt.dds"
								}
							}
						}

						estate_action_button = {
							title = "ask_commoners_for_stability"
							left_click_and_hold_action = { action_name = "ask_commoners_for_stability" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/stability.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/resources/stability.dds"
								}
							}
						}

						estate_action_button = {
							title = "ask_tribes_for_manpower"
							left_click_and_hold_action = { action_name = "ask_tribes_for_manpower" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/resources/manpower.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/resources/manpower.dds"
								}
							}
						}

						estate_action_button = {
							title = "call_emergency_parliament"
							left_click_and_hold_action = { action_name = "call_emergency_parliament" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/flat_icons/parliament.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/flat_icons/parliament.dds"
								}
							}
						}
						
						estate_action_button = {
							title = "perform_reduction"
							left_click_and_hold_action = { action_name = "perform_reduction" }
							blockoverride "action_icon" {
								texture = "gfx/interface/icons/modifier_types/estate_building_destruction_satisfaction_impact.dds"
							}
							tooltipwidget = {
								using = estate_action_tooltip
								blockoverride "tooltip_icon_texture" {
									texture = "gfx/interface/icons/modifier_types/estate_building_destruction_satisfaction_impact.dds"
								}
							}
						}
					}
				}
			}
		}
	}
}
}
