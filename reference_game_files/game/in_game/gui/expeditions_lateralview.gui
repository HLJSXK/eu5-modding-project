							name = "name"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "category"
							using = layoutpolicy_expanding
						}
					}

					blockoverride "scroll_list_layout" {
						fixedgridbox = {
							layoutpolicy_horizontal = expanding
							datamodel_reuse_widgets = yes
							resizetofit = no
							addcolumn = 525
							addrow = 132
							datamodel = "[ExpeditionsLateralView.GetAllCategoriesExpeditionItems]"
							item = {
								widget = {
									size = { 100% 120 }

									clickable_header_card = {
										size = { 98% 120 }
										parentanchor = hcenter

										blockoverride "card_bg" {
											using = bg_paper_card
											background = {
												visible = "[ExpeditionItem.IsOngoing]"
												using = bg_expeditions_wood_42_42_texture
											}
											background = {
												using = bg_expeditions_card_frame_42_42_texture
												visible = "[Not(ExpeditionItem.IsOngoing)]"
												margin = { 4 4 }
											}
										}

										blockoverride "header_bg" {
											datacontext = "[ExpeditionItem.GetExpeditionType]"
											using = expedition_card_header_color
											using = expedition_card_header_illustration
										}

										blockoverride "card_bg_extra" {
											widget = {
												ignore_layout = yes
												using = layoutpolicy_expanding
												size = { 102% 103% }
												position = { -4 -2 }
												background = {
													visible = "[ExpeditionItem.IsOngoing]"
													using = bg_expeditions_card_header_frame_1_texture
												}
											}
										}

										blockoverride "header_button" {
											card_header_button_01 = {
												visible = "[Not(ExpeditionItem.IsOngoing)]"
												size = { 100% 100% }
												enabled = "[ExpeditionItem.IsEnabled]"
												button_tooltip_override = {
													title = "start_expedition"
												}

												tooltipwidget = {
													using = expedition_type_tooltip
												}

												scripted_action_tooltip = {
													click_type = left
													click_mode = single
													action_name = "start_expedition"
													actor = "[Player]"
													parameter = {
														parameter_name = "target"
														parameter_value = "[ExpeditionItem.GetExpeditionType]"
													}
												}

												hbox = {
													margin_left = 10
													margin_right = 10
													spacing = 5

													widget = {
														size = { 25 25 }
														datacontext = "[ExpeditionItem.GetExpeditionType]"
														using = expedition_category_icon
													}

													hbox = {
														layoutpolicy_horizontal = expanding

														text_single = {
															layoutpolicy_horizontal = expanding
															text = "[ExpeditionItem.GetExpeditionType.GetNameWithNoTooltip]"
															default_format = "#yellow_titles"
														}
													}

													expand = {}
												}
											}
											size = { -1 40 }
											widget = {
												visible = "[ExpeditionItem.IsOngoing]"
												size = { 100% 100% }

												using = expedition_card_header_illustration

												hbox = {
													margin_left = 70
													margin_right = 5
													margin_top = 5
													spacing = 5

													widget = {
														size = { 25 25 }
														datacontext = "[ExpeditionItem.GetExpeditionType]"
														using = expedition_category_icon
													}

													hbox = {
														layoutpolicy_horizontal = expanding

														text_single = {
															layoutpolicy_horizontal = expanding
															text = "[ExpeditionItem.GetExpedition.GetName]"
															default_format = "#yellow_titles"
														}
													}

													expand = {}
												}
											}
										}

										blockoverride "bottom_content" {
											hbox = {
												visible = "[ExpeditionItem.IsOngoing]"
												using = layoutpolicy_expanding
												margin = { 2 5 }

												vbox = {
													size = { 66 -1 }
													spacing = 2

													portrait_standard_head_button = {
														using = character_portrait_bg
														datacontext = "[ExpeditionItem.GetExpedition.GetLeader]"
														size = { 52 62 }

														icon = {
															block "character_frame_texture" {
																texture = "gfx/interface/component_decoration/character_frames/character_frame_1.dds"
															}
															texture_density = 2
															size = { 100% 100% }
														}

														icon = {
															size = { 20 20 }
															parentanchor = bottom|left
															visible = "[ExpeditionItem.IsLedByRuler]"
															texture = "gfx/interface/icons/character_roles/regent.dds"
															tooltip = "EXPEDITION_REGENCY_WARNING"
														}
													}

													blockoverride "bottom_content" {
														hbox = {
															visible = "[ExpeditionItem.IsOngoing]"
															using = layoutpolicy_expanding
															margin = { 8 5 }
															spacing = 8

															vbox = {
																size = { 66 -1 }
																spacing = 2

																portrait_standard_head_button = {
																	using = character_portrait_bg
																	datacontext = "[ExpeditionItem.GetExpedition.GetLeader]"
																	size = { 52 62 }

																	icon = {
																		block "character_frame_texture" {
																			texture = "gfx/interface/component_decoration/character_frames/character_frame_1.dds"
																		}
																		texture_density = 2
																		size = { 100% 100% }
																	}

																	icon = {
																		size = { 20 20 }
																		parentanchor = bottom|left
																		visible = "[ExpeditionItem.IsLedByRuler]"
																		texture = "gfx/interface/icons/character_roles/regent.dds"
																		tooltip = "EXPEDITION_REGENCY_WARNING"
																	}
																}
															}

															vbox = {
																layoutpolicy_horizontal = expanding
																margin = { 10 0 }
																margin_top = 6
																background = {
																	visible = "[ExpeditionItem.IsOngoing]"
																	using = bg_expeditions_scroll_shadow_bg_42_42_texture
																	margin = { 4 10 }
																}

																background = {
																	visible = "[ExpeditionItem.IsOngoing]"
																	using = bg_expeditions_scroll_bg_42_42_texture
																	margin = { 0 8 }
																}

																hbox = {
																	layoutpolicy_horizontal = expanding
																	spacing = 5
																	visible = "[ExpeditionItem.IsPaused]"
																	datacontext = "[ExpeditionItem.GetExpedition]"

																	expand = {}

																	hbox = {
																		spacing = 5
																		widget = {
																			size = { 22 22 }
	
																			piechart = {
																				parentanchor = center
																				size = { 22 22 }
																				using = piechart_angles
																				alwaystransparent = yes
	
																				pieslice_no_highlight = {
																					texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																					value = "[Multiply_float(ExpeditionItem.GetPauseElapsedFraction, '(float)100.0')]"
																					using = color_value_progress_blue
																					alwaystransparent = yes
																				}
	
																				pieslice_no_highlight = {
																					texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																					value = "[Subtract_float('(float)100.0', Multiply_float(ExpeditionItem.GetPauseElapsedFraction, '(float)100.0'))]"
																					using = color_value_progress_gray
																					alwaystransparent = yes
																				}
	
																				icon = {
																					size = { 60% 60% }
																					parentanchor = center
																					texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																				}
																			}
																		}
																		
																		text_single = {
																			text = "EXPEDITION_STATUS_PAUSED_FOR"
																			using = Font_Size_Small
																		}
	
																		tooltipwidget = {
																			ContextualTooltipType = {
																				blockoverride "title_text" {
																					text = "EXPEDITION_STATUS_PAUSED"
																				}
																				blockoverride "title_icon" {
																					icon = {
																						using = tooltip_title_icon_size
																						texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																					}
																				}
																				blockoverride "tooltip_content" {
																					hbox = {
																						spacing = 3
	
																						text_single = {
																							text = "EXPEDITION_RESUME_ETA_LABEL"
																						}
	
																						text_single = {
																							raw_text = "[Expedition.GetDaysUntilNextWaypoint|V]"
																						}
	
																						text_single = {
																							text = "EXPEDITION_ETA_DAYS"
																						}
																					}
																				}
																			}
																		}
																	}
																	expand = {}
																}

																hbox = {
																	layoutpolicy_horizontal = expanding
																	spacing = 5
																	visible = "[ExpeditionItem.IsWaitingOnConstruction]"
																	datacontext = "[ExpeditionItem.GetExpedition]"

																	expand = {}
																	icon = {
																		size = { 22 22 }
																		texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																		tooltip = "EXPEDITION_STATUS_WAITING_ON_CONSTRUCTION"
																	}

																	text_single = {
																		text = "EXPEDITION_STATUS_WAITING_FOR_CONSTRUCTION_FOR"
																		using = Font_Size_Small
																	}
																	expand = {}
																}

																hbox = {
																	layoutpolicy_horizontal = expanding
																	spacing = 5
																	visible = "[ExpeditionItem.IsStalled]"
																	datacontext = "[ExpeditionItem.GetExpedition]"

																	expand = {}
																	icon = {
																		size = { 22 22 }
																		texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																		tooltip = "EXPEDITION_STATUS_STALLED_TOOLTIP"
																	}

																	text_single = {
																		text = "[Expedition.GetType.GetStalledStatusText]"
																		using = Font_Size_Small
																	}
																	expand = {}
																}

																hbox = {
																	layoutpolicy_horizontal = expanding
																	spacing = 5
																	visible = "[Not(Or(ExpeditionItem.IsPaused, Or(ExpeditionItem.IsWaitingOnConstruction, ExpeditionItem.IsStalled)))]"

																	expand = {}
																	icon = {
																		size = { 22 22 }
																		visible = "[ExpeditionItem.IsReturning]"
																		texture = "gfx/interface/icons/flat_icons/home_market.dds"
																		tooltip = "EXPEDITION_STATUS_RETURNING"
																	}

																	icon = {
																		size = { 22 22 }
																		visible = "[And(Not(ExpeditionItem.IsReturning), ExpeditionItem.IsTraveling)]"
																		texture = "gfx/interface/icons/expedition_types/expeditions_traveling.dds"
																		tooltip = "EXPEDITION_STATUS_TRAVELING"
																	}

																	icon = {
																		size = { 22 22 }
																		visible = "[And(Not(ExpeditionItem.IsReturning), ExpeditionItem.IsInPort)]"
																		texture = "gfx/interface/icons/expedition_types/status_in_port.dds"
																		tooltip = "EXPEDITION_STATUS_IN_PORT"
																	}

																	hbox = {
																		datacontext = "[ExpeditionItem.GetExpedition]"
																		spacing = 3

																		text_single = {
																			text = "EXPEDITION_ETA_LABEL"
																			using = Font_Size_Small
																		}

																		text_single = {
																			raw_text = "[Expedition.GetDaysUntilNextWaypoint|V]"
																			using = Font_Size_Small
																		}

																		text_single = {
																			text = "EXPEDITION_ETA_DAYS"
																			using = Font_Size_Small
																		}
																	}

																	expand = {}
																}

																hbox = {
																	layoutpolicy_horizontal = expanding
																	spacing = 6
																	margin_top = 2
																	datacontext = "[ExpeditionItem.GetExpedition]"
																	visible = "[GreaterThan_int32(GetDataModelSize(Expedition.GetType.GetVariables), '(int32)0')]"

																	expand = {}

																	ExpeditionStatusRow = {}

																	expand = {}
																}

																ExpeditionRouteRow = {}
															}
														}

														icon = {
															size = { 20 20 }
															parentanchor = bottom|left
															visible = "[ExpeditionItem.IsLedByRuler]"
															texture = "gfx/interface/icons/character_roles/regent.dds"
															tooltip = "EXPEDITION_REGENCY_WARNING"
														}
													}
												}

												vbox = {

													using = layoutpolicy_expanding

													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 5
														visible = "[Or3(ExpeditionItem.IsPaused, ExpeditionItem.IsWaitingOnConstruction, ExpeditionItem.IsStalled)]"
														datacontext = "[ExpeditionItem.GetExpedition]"
														margin = { 10 0 }

														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 5

															hbox = {
																spacing = 5
																visible = "[ExpeditionItem.IsPaused]"
																widget = {
																	size = { 22 22 }

																	piechart = {
																		parentanchor = center
																		size = { 22 22 }
																		using = piechart_angles
																		alwaystransparent = yes

																		pieslice_no_highlight = {
																			texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																			value = "[Multiply_float(ExpeditionItem.GetPauseElapsedFraction, '(float)100.0')]"
																			using = color_value_progress_blue
																			alwaystransparent = yes
																		}

																		pieslice_no_highlight = {
																			texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																			value = "[Subtract_float('(float)100.0', Multiply_float(ExpeditionItem.GetPauseElapsedFraction, '(float)100.0'))]"
																			using = color_value_progress_gray
																			alwaystransparent = yes
																		}

																		icon = {
																			size = { 60% 60% }
																			parentanchor = center
																			texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																		}
																	}
																}
																
																text_single = {
																	text = "EXPEDITION_STATUS_PAUSED_FOR"
																	using = Font_Size_Small
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "EXPEDITION_STATUS_PAUSED"
																		}
																		blockoverride "title_icon" {
																			icon = {
																				using = tooltip_title_icon_size
																				texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																			}
																		}
																		blockoverride "tooltip_content" {
																			TooltipContentSection = {
																				hbox = {
																					margin = { 10 10 }
																					using = bg_listbase_template
																					spacing = 3
	
																					text_single = {
																						text = "EXPEDITION_RESUME_ETA_LABEL"
																					}
	
																					text_single = {
																						raw_text = "[Expedition.GetDaysUntilNextWaypoint|V]"
																					}
	
																					text_single = {
																						text = "EXPEDITION_ETA_DAYS"
																					}
																				}
																			}
																		}
																	}
																}
															}
															hbox = {
																visible = "[And(ExpeditionItem.IsStalled, Not(ExpeditionItem.IsPaused))]"
																spacing = 5
																icon = {
																	size = { 22 22 }
																	texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																}

																text_single = {
																	text = "[Expedition.GetType.GetStalledStatusText]"
																	using = Font_Size_Small
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "[Expedition.GetType.GetStalledStatusText]"
																		}
																		blockoverride "title_icon" {
																			icon = {
																				using = tooltip_title_icon_size
																				texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																			}
																		}
																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				blockoverride "text" {
																					text = "EXPEDITION_STATUS_STALLED_TOOLTIP"
																				}
																			}
																		}
																	}
																}
															}
															hbox = {
																visible = "[ExpeditionItem.IsWaitingOnConstruction]"
																spacing = 5
																icon = {
																	size = { 22 22 }
																	texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																}

																text_single = {
																	text = "EXPEDITION_STATUS_WAITING_FOR_CONSTRUCTION_FOR"
																	using = Font_Size_Small
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "EXPEDITION_STATUS_WAITING_FOR_CONSTRUCTION_FOR"
																		}
																		blockoverride "title_icon" {
																			icon = {
																				using = tooltip_title_icon_size
																				texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																			}
																		}
																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				blockoverride "text" {
																					text = "EXPEDITION_STATUS_WAITING_ON_CONSTRUCTION"
																				}
																			}
																		}
																	}
																}
															}

															expand = {}
														}

														hbox = {
															datacontext = "[ExpeditionItem.GetExpedition]"
															spacing = 4
		
															ExpeditionStatusRow = {}
														}
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 5
														visible = "[Not(Or3(ExpeditionItem.IsPaused, ExpeditionItem.IsWaitingOnConstruction, ExpeditionItem.IsStalled))]"
														margin = { 10 0 }

														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 5

															icon = {
																size = { 22 22 }
																visible = "[ExpeditionItem.IsReturning]"
																texture = "gfx/interface/icons/flat_icons/home_market.dds"
																tooltip = "EXPEDITION_STATUS_RETURNING"
															}

															icon = {
																size = { 22 22 }
																visible = "[And(Not(ExpeditionItem.IsReturning), ExpeditionItem.IsTraveling)]"
																texture = "gfx/interface/icons/expedition_types/expeditions_traveling.dds"
																tooltip = "EXPEDITION_STATUS_TRAVELING"
															}

															icon = {
																size = { 22 22 }
																visible = "[And(Not(ExpeditionItem.IsReturning), ExpeditionItem.IsInPort)]"
																texture = "gfx/interface/icons/expedition_types/status_in_port.dds"
																tooltip = "EXPEDITION_STATUS_IN_PORT"
															}

															hbox = {
																datacontext = "[ExpeditionItem.GetExpedition]"
																spacing = 3

																text_single = {
																	text = "EXPEDITION_ETA_LABEL"
																	using = Font_Size_Small
																}

																text_single = {
																	raw_text = "[Expedition.GetDaysUntilNextWaypoint|V]"
																	using = Font_Size_Small
																}

																text_single = {
																	text = "EXPEDITION_ETA_DAYS"
																	using = Font_Size_Small
																}
															}

															expand = {}
														}

														hbox = {
															datacontext = "[ExpeditionItem.GetExpedition]"
															spacing = 4
		
															ExpeditionStatusRow = {}
														}
													}

													vbox = {
														layoutpolicy_horizontal = expanding
														margin = { 15 3 }
														
														background = {
															visible = "[ExpeditionItem.IsOngoing]"
															using = bg_expeditions_scroll_shadow_bg_42_42_texture
															margin = { 4 10 }
														}

														background = {
															visible = "[ExpeditionItem.IsOngoing]"
															using = bg_expeditions_scroll_bg_42_42_texture
															margin = { 0 8 }
														}

														ExpeditionRouteRow = {}
													}
												}
											}

											hbox = {
												visible = "[Not(ExpeditionItem.IsOngoing)]"
												using = layoutpolicy_expanding
												margin = { 8 5 }
												spacing = 8

												text_single = {
													using = layoutpolicy_expanding
													multiline = yes
													autoresize = no
													text = "[ExpeditionItem.GetExpeditionType.GetDesc]"
													using = Font_Size_Very_Small
													default_format = "#flavor"
												}

											}
										}
									}
								}
							}
						}
					}
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				visible = "[ExpeditionsLateralView.Vars.HasValue( 'subtab', 'completed' )]"

				filtered_sorted_list = {
					datacontext = "[ExpeditionsLateralView.GetCompletedExpeditionsSortSearch]"

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(ExpeditionsLateralView.GetCompletedExpeditions)]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "EXPEDITIONS_COMPLETED_SCROLL_LIST_EMPTY"
					}

					blockoverride "scroll_list_layout" {
						fixedgridbox = {
							layoutpolicy_horizontal = expanding
							datamodel_reuse_widgets = yes
							resizetofit = no
							addcolumn = 525
							addrow = 120
							datamodel = "[ExpeditionsLateralView.GetCompletedExpeditions]"

							item = {
								widget = {
									size = { 100% 65 }

									widget = {
										size = { 98% 65 }
										parentanchor = right
										using = bg_paper_card


										vbox = {
											layoutpolicy_horizontal = expanding
											margin = { 10 6 }
											spacing = 5
											background = {
												using = bg_expeditions_card_frame_42_42_texture
												margin_bottom = 4
											}


											hbox = {
												layoutpolicy_horizontal = expanding
												spacing = 8
												margin_left = 40
												background = {
													using = bg_banner_02_cloth_texture
													frame = 1
													margin = { 22 7 }
												}

												icon = {
													ignore_layout = yes
													texture = "[GetGraphicalCultureTexture('circle_frame')]"
													texture_density = 2
													size = { 32 32 }
													position = { 0 -8 }

													icon = {
														size = { 100% 100% }
														texture = "gfx/interface/advance/backgrounds/blue.dds"
														datacontext = "[CompletedExpeditionItem.GetExpeditionType]"
														using = expedition_type_category_icon
													}
												}

												text_single = {
													layoutpolicy_horizontal = expanding
													text = "[CompletedExpeditionItem.GetExpeditionType.GetNameWithNoTooltip]"
													default_format = "#yellow_titles"
													fontsize = 16

													tooltipwidget = {
														using = completed_expedition_tooltip
													}
												}

												text_single = {
													text = "[CompletedExpeditionItem.GetEndDateString]"
													using = Font_Size_Small
												}
											}

											hbox = {
												layoutpolicy_horizontal = expanding
												spacing = 8

												text_single = {
													visible = "[CompletedExpeditionItem.HasLeader]"
													datacontext = "[CompletedExpeditionItem.GetLeader]"
													text = "EXPEDITION_COMPLETED_LED_BY"
													using = Font_Size_Small
												}

												text_single = {
													visible = "[CompletedExpeditionItem.HasFinalLocation]"
													datacontext = "[CompletedExpeditionItem.GetFinalLocation]"
													text = "EXPEDITION_COMPLETED_ENDED_AT"
													using = Font_Size_Small
												}

												expand = {}

												icon = {
													size = { 20 20 }
													visible = "[CompletedExpeditionItem.Succeeded]"
													texture = "gfx/interface/icons/missions/reward.dds"

													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_text" {
																text = "EXPEDITION_RESULT_SUCCEEDED_TITLE"
															}
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	texture = "gfx/interface/icons/missions/reward.dds"
																}
															}
															blockoverride "concept_link" {
																text = "[expedition|E]"
															}
															blockoverride "tooltip_content" {
																TooltipTextBlock = {
																	visible = "[CompletedExpeditionItem.HasOutcome]"
																	blockoverride "text" {
																		raw_text = "[CompletedExpeditionItem.GetOutcome]"
																	}
																}
																TooltipTextBlock = {
																	visible = "[Not(CompletedExpeditionItem.HasOutcome)]"
																	blockoverride "text" {
																		text = "EXPEDITION_ENDED_NO_OUTCOME"
																	}
																}
															}
														}
													}
												}

												icon = {
													size = { 20 20 }
													visible = "[CompletedExpeditionItem.IsFailed]"
													texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"

													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_text" {
																text = "EXPEDITION_RESULT_FAILED_TITLE"
															}
															blockoverride "title_icon" {
																icon = {
																	using = tooltip_title_icon_size
																	texture = "gfx/interface/icons/expedition_types/expeditions_paused.dds"
																}
															}
															blockoverride "concept_link" {
																text = "[expedition|E]"
															}
															blockoverride "tooltip_content" {
																TooltipTextBlock = {
																	visible = "[CompletedExpeditionItem.HasOutcome]"
																	blockoverride "text" {
																		raw_text = "[CompletedExpeditionItem.GetOutcome]"
																	}
																}
																TooltipTextBlock = {
																	visible = "[Not(CompletedExpeditionItem.HasOutcome)]"
																	blockoverride "text" {
																		text = "EXPEDITION_FAILED_NO_OUTCOME"
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
