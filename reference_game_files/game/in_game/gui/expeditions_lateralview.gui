types ExpeditionWaypoints {
	type ExpeditionVariableGauge = widget {
		size = { 28 28 }

		piechart = {
			parentanchor = center
			size = { 26 26 }
			using = piechart_angles
			alwaystransparent = yes

			pieslice_no_highlight = {
				texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
				value = "[FixedPointToFloat(Expedition.GetVariable(MonthlySavedVariable.GetTag))]"
				using = color_value_progress_blue
				alwaystransparent = yes
			}

			pieslice_no_highlight = {
				texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
				value = "[Subtract_float(FixedPointToFloat(MonthlySavedVariable.GetMax), FixedPointToFloat(Expedition.GetVariable(MonthlySavedVariable.GetTag)))]"
				using = color_value_progress_gray
				alwaystransparent = yes
			}

			icon = {
				size = { 70% 70% }
				parentanchor = center
				texture = "[MonthlySavedVariable.GetIcon]"
			}

			using = bg_circle_piechart
		}

		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon_texture" {
					texture = "[MonthlySavedVariable.GetIcon]"
				}
				blockoverride "title_text" {
					text = "[MonthlySavedVariable.GetName]"
				}
				blockoverride "concept_link" {
					text = [expedition|E]
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						blockoverride "text" {
							text = "[MonthlySavedVariable.GetTitle(Expedition.GetBaseClass)]"
						}
					}
					TooltipScrolledStringPairList = {
						visible = "[And(Not(MonthlySavedVariable.IsMonthlyChangeHidden), Not(StringIsEmpty(MonthlySavedVariable.GetMonthlyChangeBreakdown(Expedition.GetBaseClass))))]"
						blockoverride "block_title" {
							text = "EXPEDITION_VARIABLE_MONTHLY_CHANGE_TITLE"
						}
						textcontext = "[MonthlySavedVariable.GetMonthlyChangeBreakdown(Expedition.GetBaseClass)]"
					}
					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "[MonthlySavedVariable.GetDesc]"
						}
					}
				}
			}
		}
	}

	type ExpeditionVariableValue = hbox {
		spacing = 3

		icon = {
			size = { 18 18 }
			texture = "[MonthlySavedVariable.GetIcon]"
		}

		hbox = {
			spacing = 0
			text_single = {
				autoresize = yes
				using = Font_Size_Small
				raw_text = "[Expedition.GetVariable(MonthlySavedVariable.GetTag)|0]"
			}
			text_single = {
				autoresize = yes
				using = Font_Size_Small
				visible = "[EqualTo_string(MonthlySavedVariable.GetDisplay, 'fraction')]"
				raw_text = "/[MonthlySavedVariable.GetMax|0]"
			}
		}

		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon_texture" {
					texture = "[MonthlySavedVariable.GetIcon]"
				}
				blockoverride "title_text" {
					text = "[MonthlySavedVariable.GetName]"
				}
				blockoverride "concept_link" {
					text = [expedition|E]
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						blockoverride "text" {
							text = "[MonthlySavedVariable.GetTitle(Expedition.GetBaseClass)]"
						}
					}
					TooltipScrolledStringPairList = {
						visible = "[And(Not(MonthlySavedVariable.IsMonthlyChangeHidden), Not(StringIsEmpty(MonthlySavedVariable.GetMonthlyChangeBreakdown(Expedition.GetBaseClass))))]"
						blockoverride "block_title" {
							text = "EXPEDITION_VARIABLE_MONTHLY_CHANGE_TITLE"
						}
						textcontext = "[MonthlySavedVariable.GetMonthlyChangeBreakdown(Expedition.GetBaseClass)]"
					}
					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "[MonthlySavedVariable.GetDesc]"
						}
					}
				}
			}
		}
	}

	type ExpeditionStatusRow = hbox {
		datacontext = "[ExpeditionItem.GetExpedition]"
		spacing = 4
		hbox = {
			spacing = 4
			datamodel = "[DataModelFirst(Expedition.GetType.GetVariables, Select_int32(GreaterThan_int32(GetDataModelSize(Expedition.GetType.GetVariables), '(int32)5'), '(int32)4', '(int32)5'))]"
			item = {
				hbox = {
					visible = "[Expedition.HasVariable(MonthlySavedVariable.GetTag)]"
					ExpeditionVariableGauge = {
						visible = "[EqualTo_string(MonthlySavedVariable.GetDisplay, 'piechart')]"
					}
					ExpeditionVariableValue = {
						visible = "[Not(EqualTo_string(MonthlySavedVariable.GetDisplay, 'piechart'))]"
					}
				}
			}
		}

		text_single = {
			visible = "[GreaterThan_int32(GetDataModelSize(Expedition.GetType.GetVariables), '(int32)5')]"
			size = { 22 22 }
			autoresize = no
			align = center|nobaseline
			using = Font_Type_Headers
			raw_text = "+[Subtract_int32(GetDataModelSize(Expedition.GetType.GetVariables), '(int32)4')]"

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "EXPEDITION_VARIABLES_TT_TITLE"
					}
					blockoverride "concept_link" {
						text = [expedition|E]
					}
					blockoverride "tooltip_content" {
						TooltipListBase = {
							TooltipScrolledContentSection = {
								blockoverride "block_scrollarea" {
									maximumsize = { -1 300 }
								}

								blockoverride "section_content" {
									flowcontainer = {
										direction = horizontal
										wrap_count = 4
										ignoreinvisible = yes
										margin = { 5 5 }
										datamodel = "[DataModelSkipFirst(Expedition.GetType.GetVariables, '(int32)4')]"
										item = {
											widget = {
												size = { 110 28 }
												visible = "[Expedition.HasVariable(MonthlySavedVariable.GetTag)]"
												hbox = {
													ExpeditionVariableGauge = {
														visible = "[EqualTo_string(MonthlySavedVariable.GetDisplay, 'piechart')]"
													}
													ExpeditionVariableValue = {
														visible = "[Not(EqualTo_string(MonthlySavedVariable.GetDisplay, 'piechart'))]"
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type ExpeditionRouteRow = hbox {
		layoutpolicy_horizontal = expanding
		visible = "[And(DataModelHasItems(ExpeditionItem.GetRouteSteps), ExpeditionItem.IsExpeditionValid)]"

		ExpeditionRouteStepNode = {
			layoutpolicy_horizontal = expanding
			layoutstretchfactor_horizontal = 1
			visible = "[ExpeditionItem.IsDoneNodesCollapsed]"

			blockoverride "step_line" {
				ExpeditionRouteStepStartLine = {}
			}
			
			blockoverride "step_icon_content" {
				text_single = {
					parentanchor = center
					using = Font_Size_Very_Small
					raw_text = "+[ExpeditionItem.GetDoneNodesNum]"

					margin = { 5 3 }
					margin_right = 6
					using = bg_cabinet_card_frame
					using = bg_listbase_template
				}
			}

			tooltipwidget = { ExpeditionRouteFullRouteTooltip = {} }
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutstretchfactor_horizontal = "[ExpeditionItem.GetRouteStepsSubSpanCount]"
			datamodel = "[DataModelSubSpan(ExpeditionItem.GetRouteSteps, ExpeditionItem.GetRouteStepsSubSpanStart, ExpeditionItem.GetRouteStepsSubSpanCount)]"
			item = {
				ExpeditionRouteStepNode = {
					layoutpolicy_horizontal = expanding
				}
			}
		}

		ExpeditionRouteStepNode = {
			layoutpolicy_horizontal = expanding
			layoutstretchfactor_horizontal = 1
			visible = "[ExpeditionItem.IsTodoNodesCollapsed]"

			blockoverride "step_line" {
				ExpeditionRouteStepThreeDots = {}
			}
			
			blockoverride "step_icon_content" {
				text_single = {
					parentanchor = center
					using = Font_Size_Very_Small
					raw_text = "+[ExpeditionItem.GetTodoNodesNum]"

					margin = { 5 3 }
					margin_right = 6
					using = bg_cabinet_card_frame
					using = bg_listbase_template
				}
			}

			tooltipwidget = { ExpeditionRouteFullRouteTooltip = {} }
		}

		ExpeditionRouteStepNode = {
			layoutpolicy_horizontal = expanding
			layoutstretchfactor_horizontal = 1
			datacontext = "[ExpeditionItem.GetFinalRouteStep]"
		}
	}

	type ExpeditionRouteFullRouteTooltip = ContextualTooltipType {
		blockoverride "title_text" {
			text = "[ExpeditionItem.GetExpedition.GetName]"
		}
		blockoverride "concept_link" {
			text = "[expedition|e]"
		}
		blockoverride "title_icon_texture" {
			texture = "[ExpeditionItem.GetExpeditionType.GetIcon]"
		}
		blockoverride "tooltip_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 20 5 }
				margin_right = 30
				
				background = {
					visible = "[ExpeditionItem.IsOngoing]"
					using = bg_expeditions_scroll_shadow_bg_42_42_texture
					margin = { 4 10 }
				}

				background = {
					visible = "[ExpeditionItem.IsOngoing]"
					using = bg_expeditions_scroll_bg_42_42_texture
					margin = { 0 8 }
				}

				flowcontainer = {
					wrap_count = 10
					datamodel = "[ExpeditionItem.GetRouteSteps]"
					item = {
						widget = {
							size = { 45 35 }
							ExpeditionRouteStepNode = {}
						}
					}
				}
			}
		}
	}

	type ExpeditionRouteStepSolidLine = widget {
		size = { 100% 4 }
		parentanchor = center

		background = {
			using = color_new_gold_texture
		}
	}

	type ExpeditionRouteStepThreeDots = widget {
		size = { 100% 4 }
		parentanchor = center

		widget = {
			parentanchor = center
			size = { 80% 100% }
			hbox = {
				widget = { size = { 3 3 } background = { using = color_new_gold_texture alpha = 0.5 } }
				expand = {}
				widget = { size = { 3 3 } background = { using = color_new_gold_texture alpha = 0.5 } }
				expand = {}
				widget = { size = { 3 3 } background = { using = color_new_gold_texture alpha = 0.5 } }
			}
		}
	}

	type ExpeditionRouteStepStartLine = widget {
		size = { 100% 4 }
		parentanchor = center

		hbox = {
			spacing = 3
			widget = { size = { 3 3 } background = { using = color_new_gold_texture alpha = 0.5 } }
			expand = {}
			widget = { size = { 3 3 } background = { using = color_new_gold_texture alpha = 0.5 } }
			expand = {}
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 3 }
				background = {
					using = color_new_gold_texture alpha = 0.5 }
				}
		}
	}

	type ExpeditionRouteStepNode = hbox {
		visible = "[ExpeditionItem.IsExpeditionValid]"

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 40 }
	
			block "step_line" {
				widget = {
					visible = "[GreaterThan_int32(ExpeditionStepItem.GetStepIndex, '(int32)0')]"
					size = { 100% 100% }
		
					ExpeditionRouteStepSolidLine = {
						visible = "[Or(ExpeditionStepItem.IsPassed, ExpeditionStepItem.IsCurrent)]"
					}
		
					ExpeditionRouteStepThreeDots = {
						visible = "[And(Not(ExpeditionStepItem.IsPassed), Not(ExpeditionStepItem.IsCurrent))]"
					}
				}
		
				ExpeditionRouteStepStartLine = {
					visible = "[EqualTo_int32(ExpeditionStepItem.GetStepIndex, '(int32)0')]"
				}
			}
		}
	
		widget = {
			size = "[ExpeditionItem.GetStepIconSize]"
	
			block "step_icon_content" {

				background = {
					visible = "[Not(ExpeditionStepItem.IsCurrent)]"
					texture = "gfx/interface/progressbars/empty_circle_bg.dds"
				}
				background = {
					visible = "[ExpeditionStepItem.IsCurrent]"
					texture = "gfx/interface/progressbars/green_circle_bg.dds"
				}

				icon = { size = { 70% 70% } parentanchor = center visible = "[And(And(ExpeditionStepItem.IsPassed, Not(ExpeditionStepItem.IsLast)), Not(ExpeditionStepItem.IsHidden))]" texture = "gfx/interface/icons/expedition_types/expeditions_already_visited.dds" }
				icon = { size = { 70% 70% } parentanchor = center visible = "[And(And(ExpeditionStepItem.IsCurrent, Not(ExpeditionStepItem.IsLast)), Not(ExpeditionStepItem.IsHidden))]" texture = "gfx/interface/icons/expedition_types/expeditions_current_position.dds" }
				icon = { size = { 70% 70% } parentanchor = center visible = "[And(And(ExpeditionStepItem.IsFuture, Not(ExpeditionStepItem.IsLast)), Not(ExpeditionStepItem.IsHidden))]" texture = "gfx/interface/icons/expedition_types/expeditions_upcoming.dds" }
				icon = { size = { 70% 70% } parentanchor = center visible = "[ExpeditionStepItem.IsLast]" texture = "gfx/interface/icons/missions/reward.dds" }
				icon = { size = { 70% 70% } parentanchor = center visible = "[And(ExpeditionStepItem.IsHidden, Not(ExpeditionStepItem.IsLast))]" texture = "gfx/interface/icons/unit_view/army_hidden_icon.dds" }
			}
		}
	
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_text" {
					text = "[ExpeditionStepItem.GetDisplayName]"
				}
				blockoverride "title_icon" {
					icon = {
						using = tooltip_title_icon_size
						visible = "[And(And(ExpeditionStepItem.IsPassed, Not(ExpeditionStepItem.IsLast)), Not(ExpeditionStepItem.IsHidden))]"
						texture = "gfx/interface/icons/expedition_types/expeditions_already_visited.dds"
					}
					icon = {
						using = tooltip_title_icon_size
						visible = "[And(And(ExpeditionStepItem.IsCurrent, Not(ExpeditionStepItem.IsLast)), Not(ExpeditionStepItem.IsHidden))]"
						texture = "gfx/interface/icons/expedition_types/expeditions_current_position.dds"
					}
					icon = {
						using = tooltip_title_icon_size
						visible = "[And(And(ExpeditionStepItem.IsFuture, Not(ExpeditionStepItem.IsLast)), Not(ExpeditionStepItem.IsHidden))]"
						texture = "gfx/interface/icons/expedition_types/expeditions_upcoming.dds"
					}
					icon = {
						using = tooltip_title_icon_size
						visible = "[ExpeditionStepItem.IsLast]"
						texture = "gfx/interface/icons/missions/reward.dds"
					}
					icon = {
						using = tooltip_title_icon_size
						visible = "[And(ExpeditionStepItem.IsHidden, Not(ExpeditionStepItem.IsLast))]"
						texture = "gfx/interface/icons/unit_view/army_hidden_icon.dds"
					}
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						visible = "[And(ExpeditionStepItem.IsPassed, Not(ExpeditionStepItem.IsLast))]"
						blockoverride "text" {
							text = "EXPEDITION_WAYPOINT_STATE_PASSED"
						}
					}
					TooltipTextBlock = {
						visible = "[And(ExpeditionStepItem.IsCurrent, Not(ExpeditionStepItem.IsLast))]"
						blockoverride "text" {
							text = "EXPEDITION_WAYPOINT_STATE_CURRENT"
						}
					}
					TooltipTextBlock = {
						visible = "[And(ExpeditionStepItem.IsFuture, Not(ExpeditionStepItem.IsLast))]"
						blockoverride "text" {
							text = "EXPEDITION_WAYPOINT_STATE_FUTURE"
						}
					}
					TooltipTextBlock = {
						visible = "[ExpeditionStepItem.IsLast]"
						blockoverride "text" {
							text = "EXPEDITION_OUTCOME_NODE_TT"
						}
					}
					TooltipTextBlock = {
						datacontext = "[ExpeditionStepItem.GetLocation]"
						visible = "[And(ExpeditionStepItem.IsLast, Not(ExpeditionStepItem.IsHidden))]"
						blockoverride "text" {
							text = "EXPEDITION_OUTCOME_CONCLUDES_AT"
						}
					}
					TooltipTextBlock = {
						visible = "[And(ExpeditionStepItem.IsLast, ExpeditionStepItem.IsHidden)]"
						blockoverride "text" {
							text = "EXPEDITION_OUTCOME_CONCLUDES_AT_UNKNOWN"
						}
					}
				}
			}
		}
	}
}

template expedition_name_and_role_banner {
	datacontext = "[Character.GetRoleMask]"
	datacontext = "[Character.GetCourtCountry]"

	set_parent_size_to_minimum = yes
	margin = { 0 5 }
	margin_bottom = 10

	using = bg_name_banner

	hbox = {
		visible = "[Character.IsAlive]"
		vbox = {
			visible = "[Character.HasCourtCountry]"
			vbox = {
				visible = "[Character.GetCourtCountry.IsReal]"
				vbox = {
					visible = "[Not(ObjectsEqual(Character.GetCourtCountry, Player.GetCountry ))]"
					hbox = {
						margin = {15 1}
						margin_bottom = 0

						text_single = {
							text = "EVENT_CHARACTER_FOREIGN"
							visible = "[Not(EqualTo_string(Character.GetRoleName, ''))]"
							using = Font_Type_Flavor using = Font_Size_Very_Small default_format = "#yellow_titles"
							maximumsize = { 190 -1 }
							autoresize = yes
						}
						text_single = {
							text = "EVENT_CHARACTER_FOREIGN_NO_ROLE"
							visible = "[EqualTo_string(Character.GetRoleName, '')]"
							using = Font_Type_Flavor using = Font_Size_Very_Small default_format = "#yellow_titles"
							maximumsize = { 190 -1 }
							autoresize = yes
						}
					}
				}
				vbox = {
					visible = "[ObjectsEqual(Character.GetCourtCountry, Player.GetCountry )]"
					hbox = {
						margin = {15 1}
						margin_bottom = 0
						visible = "[Not(EqualTo_string(Character.GetRoleName, ''))]"

						text_single = {
							text = "EVENT_CHARACTER_OURS"

							using = Font_Type_Flavor using = Font_Size_Very_Small default_format = "#yellow_titles"
							maximumsize = { 190 -1 }
							autoresize = yes
						}
					}

					text_single = {
						text = "EVENT_CHARACTER_OURS_NO_ROLE"
						visible = "[EqualTo_string(Character.GetRoleName, '')]"
						using = Font_Type_Flavor using = Font_Size_Very_Small default_format = "#yellow_titles"
						maximumsize = { 190 -1 }
						autoresize = yes
					}
				}
			}
		}
	}	

	hbox = {
		visible = no
		ignoreinvisible = yes

		datamodel = "[DataModelRepeatedItem(CharacterRoleMask.GetRolesCount)]"
		item = {
			widget = {
				size = { 30 30 }
				visible = "[CharacterRoleMask.HasRole(PdxGuiWidget.GetIndexInDataModel)]"
				tagtooltip_enabled = yes
				icon = {
					size = { 100% 100% }
					visible ="[Not(CharacterLateralview.GetCharacter.IsArtist)]"
					texture = "[CharacterRoleMask.GetRoleIcon(PdxGuiWidget.GetIndexInDataModel)]"

					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.7
					}
				}
				
				icon = {
					size = { 100% 100% }
					visible = "[CharacterLateralview.GetCharacter.IsArtist]"
					texture = "[GetArtistIcon(CharacterLateralview.GetCharacter.GetArtistType)]"
					
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.7
					}
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_text" {
								text = "[CharacterLateralview.GetCharacter.GetArtistType.GetNameWithNoTooltip]"
							}
					
							blockoverride "concept_link" {
								text = [artist|e]
							}

							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "[GetArtistIcon(CharacterLateralview.GetCharacter.GetArtistType)]"
								}
							}

							blockoverride "tooltip_content" {
								TooltipTextBlock = {
									blockoverride "text" {
										text = "[CharacterLateralview.GetCharacter.GetArtistType.GetTooltip]"
									}
								}
							}
						}
					}									
				}

				tooltip = "[CharacterRoleMask.GetRoleName(PdxGuiWidget.GetIndexInDataModel)]"
			}
		}
	}

	hbox = {
		size = { 5 10 }
		margin = {17 1}
		margin_bottom = 1
		
		text_single = {
			text = "[Character.GetNameToFit('(int32)22', '(bool)yes')]"
			using = Font_Type_Headers
			using = Font_Size_Small
			default_format = "#yellow_titles"
			maximumsize = { 200 -1 }
			autoresize = yes
		}
	}
}

template expedition_category_icon {
	icon = {
		size = { 100% 100% }
		parentanchor = center
		texture = "[ExpeditionType.GetIcon]"
	}
}

template expedition_type_category_icon {
	icon = {
		size = { 100% 100% }
		parentanchor = center
		texture = "[ExpeditionType.GetIcon]"
	}
}

template expedition_card_header_illustration_texture {
	texture = "[GetExpeditionTypeIllustration(ExpeditionItem.GetExpeditionType)]"
	texture_density = 2
	alpha = 0.9
	mirror = horizontal
	fittype = centercrop

	modify_texture = {
		using = overlay_cloth_texture
		blend_mode = overlay
		alpha = 0.3
	}

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_fade_horizontal_textured.dds"
		texture_density = 2
		spriteType = stretched
		spriteBorder = { 0 0 }
		blend_mode = alphamultiply
		alpha = 1
	}
}

template expedition_card_header_color {
	background = {
		using = bg_card_header_01
	}
	background = {
		visible = "[ExpeditionType.IsCategoryKey('exploration')]"
		using = color_mid_green_texture
		alpha = 0.3
	}
	background = {
		visible = "[ExpeditionType.IsCategoryKey('commercial')]"
		using = color_new_gold_texture
		alpha = 0.3
	}
	background = {
		visible = "[ExpeditionType.IsCategoryKey('military')]"
		using = color_mid_red_texture
		alpha = 0.3
	}
	background = {
		visible = "[ExpeditionType.IsCategoryKey('religious')]"
		using = color_purple_texture
		alpha = 0.3
	}
	background = {
		visible = "[ExpeditionType.IsCategoryKey('diplomatic')]"
		using = color_mid_blue_texture
		alpha = 0.3
	}
}

template expedition_card_header_illustration {
	widget = {
		ignore_layout = yes
		alwaystransparent = yes
		parentanchor = right|top
		size = { 148 100% }

		background = {
			visible = "[Or(ExpeditionItem.IsEnabled, ExpeditionItem.IsOngoing)]"
			using = expedition_card_header_illustration_texture
		}

		background = {
			shaderfile = "gfx/FX/pdxgui_grayscale.shader"
			effectname = "PdxGuiGrayscale"
			visible = "[Not(Or(ExpeditionItem.IsEnabled, ExpeditionItem.IsOngoing))]"
			using = expedition_card_header_illustration_texture
		}
	}
}

template completed_expedition_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[CompletedExpeditionItem.GetExpeditionType.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			widget = {
				using = tooltip_title_icon_size
				datacontext = "[CompletedExpeditionItem.GetExpeditionType]"
				using = expedition_type_category_icon
			}
		}
		blockoverride "concept_link" {
			datacontext = "[CompletedExpeditionItem.GetExpeditionType]"
			text = "EXPEDITION_TT_TYPE_CONCEPT"
		}
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "EXPEDITION_COMPLETED_TT_DATES"
				}
			}
			TooltipTextBlock = {
				visible = "[CompletedExpeditionItem.Succeeded]"
				blockoverride "text" {
					text = "EXPEDITION_COMPLETED_TT_SUCCEEDED"
				}
			}
			TooltipTextBlock = {
				visible = "[CompletedExpeditionItem.IsFailed]"
				blockoverride "text" {
					text = "EXPEDITION_COMPLETED_TT_FAILED"
				}
			}
			TooltipTextBlock = {
				visible = "[CompletedExpeditionItem.HasOutcome]"
				blockoverride "text" {
					raw_text = "[CompletedExpeditionItem.GetOutcome]"
				}
			}
			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[CompletedExpeditionItem.GetExpeditionType.GetDesc]"
				}
			}
			TooltipFlavorTextBlock = {
				visible = "[CompletedExpeditionItem.GetExpeditionType.HasHistoricalInfo]"
				blockoverride "block_title" {
					text = "EVENT_HISTORICAL_INFO_TITLE"
				}
				blockoverride "text" {
					text = "[CompletedExpeditionItem.GetExpeditionType.GetHistoricalInfo]"
				}
			}
		}
	}
}

template expedition_type_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[ExpeditionItem.GetExpeditionType.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			widget = {
				using = tooltip_title_icon_size
				datacontext = "[ExpeditionItem.GetExpeditionType]"
				using = expedition_category_icon
			}
		}
		blockoverride "concept_link" {
			datacontext = "[ExpeditionItem.GetExpeditionType]"
			text = "EXPEDITION_TT_TYPE_CONCEPT"
		}
		blockoverride "tooltip_content" {
			TooltipScrolledContentSection = {
				blockoverride "block_scrollarea" { maximumsize = { -1 600 }}
				blockoverride "section_content" {
					TooltipContentSection = {
						set_parent_dimension_to_minimum = height
						layoutpolicy_horizontal = expanding

						TooltipTextBlock = {
							blockoverride "text" {
								text = "[ExpeditionItem.GetExpeditionType.GetDesc]"
							}
						}
						TooltipTextBlock = {
							visible = "[ExpeditionItem.GetExpeditionType.HasOutcomeOverview]"
							blockoverride "text" {
								text = "[ExpeditionItem.GetExpeditionType.GetOutcomeOverview]"
							}
						}
						TooltipTextBlock = {
							visible = "[And(ExpeditionItem.GetExpeditionType.TriggersRegency, ExpeditionItem.GetExpeditionType.RulerCanLead)]"
							blockoverride "text" {
								text = "EXPEDITION_REGENCY_WARNING_AVAILABLE"
							}
						}
						TooltipRequirementsList = {
							visible = "[Not(IsLobbyOpen)]"
							textcontext = "[ExpeditionItem.GetExpeditionType.GetCanStartConditions]"
						}
						TooltipFlavorTextBlock = {
							visible = "[ExpeditionItem.GetExpeditionType.HasHistoricalInfo]"
							blockoverride "block_title" {
								text = "EVENT_HISTORICAL_INFO_TITLE"
							}
							blockoverride "text" {
								text = "[ExpeditionItem.GetExpeditionType.GetHistoricalInfo]"
							}
						}
					}
				}
			}
		}
	}
}

lateralview = {
