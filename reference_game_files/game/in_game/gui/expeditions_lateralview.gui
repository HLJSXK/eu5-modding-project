				visible = "[ExpeditionsLateralView.Vars.NotExistOrHasValue( 'subtab', 'active' )]"

				filtered_sorted_list = {
					datacontext = "[ExpeditionsLateralView.GetExpeditionsSortSearch]"

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(ExpeditionsLateralView.GetAllCategoriesExpeditionItems)]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "EXPEDITIONS_SCROLL_LIST_EMPTY"
					}

