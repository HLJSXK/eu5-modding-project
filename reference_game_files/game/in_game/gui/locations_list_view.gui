lateralview_full = {	
	name = "locations_list_view"
	
	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "LEDGER_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			header_main_tabs = { #
				blockoverride "content" {
					using = ledger_tabs_template
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt

				filtered_sorted_list = {
					margin_top = 10
					datacontext = "[LocationsListView.GetLocationsListSortSearch]"
					
					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "type"
							layoutpolicy_vertical = expanding
							size = { 60 -1 }
							blockoverride "sort_by_key_button_texture" {
								texture = "gfx/interface/icons/sort/quality.dds"
							}
						}
						sort_by_key_button = {
							name = "name"
							layoutpolicy_vertical = expanding
							size = { 160 -1 }
						}

						sort_by_key_button = {
							name = "town_rights"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
						}

						sort_by_key_button = {
							name = "raw_material"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
							blockoverride "sort_by_key_button_texture" {
								texture = "gfx/interface/icons/sort/rgo.dds"
							}
						}

						sort_by_key_button = {
							name = "pop"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "wealth"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "tax"
							using = layoutpolicy_expanding
							blockoverride "sort_by_key_button_texture" {
								texture = "gfx/interface/icons/sort/tax_base.dds"
							}
						}

						sort_by_key_button = {
							name = "control"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "enfranchisement"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "food"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "prosperity"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "development"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "religion"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
						}

						sort_by_key_button = {
							name = "culture"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "migration"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "manpower"
							using = layoutpolicy_expanding
						}
						
						sort_by_key_button = {
							name = "sailors"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "cores"
							layoutpolicy_vertical = expanding
							size = { 155 -1 }
						}
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 45
						setitemsizefromcell = yes

						datamodel = "[LocationsListView.GetLocationsListView]"
						item = {
							using = ledger_item_template
							blockoverride "ledger_item_content" {
								widget = {
									using = layoutpolicy_expanding

									hbox = {
										margin = { 15 0 }
										spacing = 10
										margin_left = 15

										icon = {
											size = { 24 24 }
											texture = "[LocationsListViewItem.GetLocation.GetRankIcon]"
											datacontext = "[LocationsListViewItem.GetLocation]"
											tooltipwidget = {
												using = location_rank_tooltip
											}
											sort_by_highlight = {
												name = "type"
											}
										}

										text_single = {
											layoutpolicy_vertical = expanding
											size = { 150 -1}
											autoresize = no
											align = left|nobaseline

											text = "[LocationsListViewItem.GetLocation.GetNameWithNoTooltip]"
											datacontext = "[LocationsListViewItem.GetLocation]"
											tooltipwidget = {
												using = location_simple_tooltip
											}
											default_format = "#yellow_titles"
											
											sort_by_highlight = {
												name = "name"
											}
										}

										widget = {
											size = { 50 -1 }
											layoutpolicy_vertical = expanding
											datacontext = "[LocationsListViewItem.GetLocation]"
											
											sort_by_highlight = {
												name = "town_rights"
											}

											# One Town Right
											hbox = {
												visible = "[EqualTo_int32(GetDataModelSize(Location.GetTownRights), '(int32)1')]"
												parentanchor = center
												datamodel = "[Location.GetTownRights]"
												item = {
													icon = {
														size = { 20 20 }
														texture = "[TownRights.GetIcon]"
														tooltipwidget = { using = TownRights_tooltip }
													}
												}
											}

											# More Than One Town Right
											hbox = {
												visible = "[GreaterThan_int32(GetDataModelSize(Location.GetTownRights), '(int32)1')]"
												parentanchor = center
												margin = { 2 0 }
												text_single = {
													using = layoutpolicy_expanding
													align = center
													autoresize = no
													text = "[GetDataModelSize(Location.GetTownRights)]"
												}
												icon = {
													size = { 16 16 }
													texture = "[GetConceptTexture('town_rights')]"
												}
												tooltipwidget = { using = location_town_rights_tooltip }
											}
										}

										widget = {
											size = { 40 -1 }
											layoutpolicy_vertical = expanding
											button = {
												parentanchor = center
												size = { 24 24 }
												texture = "[GetGoodsIcon(LocationsListViewItem.GetLocation.GetRawMaterial)]"
												onclick = "[ShowGoods(LocationsListViewItem.GetLocation.GetRawMaterial)]"

												datacontext = "[LocationsListViewItem.GetLocation.GetRawMaterial]"
												datacontext = "[LocationsListViewItem.GetLocation.GetOwner]"
												datacontext = "[LocationsListViewItem.GetLocation.GetMarket]"
												tooltipwidget = { using = SpecificGoodsMarket_tooltip }
												
											}
											sort_by_highlight = {
												name = "raw_material"
											}
										}

										hbox = { #population
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetTotalPopulation]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('population')]"
											}
											tooltipwidget = {
												using = population_location_tooltip
											}
											sort_by_highlight = {
												name = "pop"
											}
										}

										hbox = {
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetTotalPossibleTaxBase|2+=]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('wealth')]"
											}
											tooltipwidget = {
												using = location_tax_base_tooltip
											}
											sort_by_highlight = {
												name = "wealth"
											}
										}

										hbox = { #tax base
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetTotalTaxBase|2+=]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('tax_base')]"
											}
											tooltipwidget = {
												using = location_tax_base_tooltip
											}
											sort_by_highlight = {
												name = "tax"
											}
										}

										hbox = { #control
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetControl|2+=%]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('control')]"
											}
											tooltipwidget = {
												using = location_control_tooltip
											}
											sort_by_highlight = {
												name = "control"
											}
										}

										hbox = {
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetPeasantEnfranchisment|2G%]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('peasant_enfranchisement')]"
											}
											tooltipwidget = {
												using = location_peasant_enfranchisement_tooltip
											}
											sort_by_highlight = {
												name = "enfranchisement"
											}
										}

										hbox = { #food
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetFoodsOutput|+=2]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('food')]"
											}
											tooltipwidget = {
												using = location_food_tooltip
											}
											sort_by_highlight = {
												name = "food"
											}
										}

										hbox = { #prosperity
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetProsperity|2+=]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('prosperity')]"
											}
											tooltipwidget = {
												using = location_prosperity_tooltip
											}
											sort_by_highlight = {
												name = "prosperity"
											}
										}

										hbox = { #development
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetDevelopment|2/%+=]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('development')]"
											}
											tooltipwidget = {
												using = location_development_tooltip
											}
											sort_by_highlight = {
												name = "development"
											}
										}

										widget = { #religion
											size = { 50 -1 }
											layoutpolicy_vertical = expanding
											icon = { 
												parentanchor = center
												texture = "[GetReligionIcon(LocationsListViewItem.GetLocation.GetDominantReligion.Self)]"
												size = { 28 28 }
												datacontext = "[LocationsListViewItem.GetLocation.GetDominantReligion]"
												tooltipwidget = { using = religion_tooltip	}
											}
											sort_by_highlight = {
												name = "religion"
											}
										}

										text_single = { #culture
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = center|nobaseline

											text = "[LocationsListViewItem.GetLocation.GetDominantCulture.GetNameWithNoTooltip|L]"
											
											datacontext = "[LocationsListViewItem.GetLocation.GetDominantCulture]"
											tooltipwidget = {
												using = culture_tooltip
											}
											sort_by_highlight = {
												name = "culture"
											}
										}

										hbox = { #migration attraction
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetLocalMigrationAttraction]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('migration_attraction')]"
											}
											tooltipwidget = {
												using = MigrationAttraction_tooltip
											}
											sort_by_highlight = {
												name = "migration"
											}
										}

										hbox = { #manpower
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetModifierValue('local_manpower')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('manpower')]"
											}
											sort_by_highlight = {
												name = "manpower"
											}
										}

										hbox = { #sailors
											datacontext = "[LocationsListViewItem.GetLocation]"
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Location.GetModifierValue('local_sailors')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('sailors')]"
											}
											sort_by_highlight = {
												name = "sailors"
											}
										}

										widget = { #cores
											size = { 110 32 }

											hbox = {
												visible = "[Not(IsDataModelEmpty(LocationsListViewItem.GetLocation.GetCores))]"
												margin_right = 2

												hbox = {
													using = bg_text_mask_container_brown
													margin = {2 2}
													widget = {
														size = { 30 30 }

														tooltipwidget = {
															ContextualTooltipType = {
																blockoverride "title_text" {
																	text = "[cores]"
																}
																blockoverride "title_icon" {
																	icon = {
																		using = tooltip_title_icon_size
																		texture = "gfx/interface/icons/integration_levels/core.dds"
																	}
																}
																blockoverride "concept_link" {
																	text = "[integration_status|e]"
																}
																blockoverride "tooltip_content" {
																	TooltipRowList = {
																		textcontext = "[LocationsListViewItem.GetLocation.GetCoresList]"
																	}
																}
															}
														}

														hbox = {
															hbox = {
																using = bg_card_header_01
																margin = {2 2}
																icon = {
																	size = { 21 21 }
																	texture = "gfx/interface/icons/integration_levels/core.dds"
																	glow = {
																		name = "drop_shadow"
																		glow_radius = 3
																		color = {0.0 0.0 0.0 1.0}
																		alpha = 0.3
																	}
																}
															}
														}
													}
													flags_with_limit = {
														blockoverride "flags_with_limit_datamodel"{
															datamodel = "[DataModelFirst(LocationsListViewItem.GetLocation.GetCores,'(int32)2')]"
														}
														blockoverride "flags_with_limit_text"{
															raw_text = "+[Subtract_int32(GetDataModelSize(LocationsListViewItem.GetLocation.GetCores), '(int32)2')]"
														}
														blockoverride "flags_with_limit_visible_extra"{
															visible = "[GreaterThan_int32(GetDataModelSize(LocationsListViewItem.GetLocation.GetCores), '(int32)2')]"
														}
													}
												}
												expand = {}
												
											}
											sort_by_highlight = {
												name = "cores"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
