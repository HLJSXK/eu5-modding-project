				datacontext = "[InternationalOrganizationsView.GetInternationalOrganization]"
				blockoverride "text" {
					visible = "[Not(StringIsEmpty(Localize( Concatenate(InternationalOrganization.GetType.GetNameKey, '_desc') )))]"
					text = "[Localize( Concatenate(InternationalOrganization.GetType.GetNameKey, '_desc') )]"
