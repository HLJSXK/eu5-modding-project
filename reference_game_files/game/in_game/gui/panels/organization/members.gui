			TooltipConditionList = {
				visible = "[Not(StringIsEmpty(StringToConditionListOnlyPassedAndNeutral(UIAction.GetConditions).GetOutput))]"
				blockoverride "block_title" {
					text = "LIST_TITLE_REQUIREMENTS"
				}
				textcontext = "[StringToConditionListOnlyPassedAndNeutral(UIAction.GetConditions).GetOutput]"
			}
			TooltipConditionList = {
				visible = "[And3(StringIsEmpty(UIAction.GetEffects), StringIsEmpty(StringToConditionListOnlyPassedAndNeutral(UIAction.GetConditions).GetOutput), Not(StringIsEmpty(InternationalOrganization.GetTargetValidityReason)))]"
				blockoverride "block_title" {
					text = "IO_TARGET_REQUIREMENTS"
