organization_religious_theme = {
	blockoverride "organization_laws_tab_text" {
		text = "TENETS"
	}

    blockoverride "organization_laws_tab_visible" {
        visible = no
    }

    blockoverride "header_title_tooltip"{
        hbox = {
            visible = "[GreaterThan_int32(GetDataModelSize(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables), '(int32)0' )]"
            using = layoutpolicy_expanding
            datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables]"
            item = {
                hbox = {
                    visible = "[EqualTo_string(InternationalOrganizationTypeVariable.GetTag, 'seat')]"
                    using = layoutpolicy_expanding
                    spacing = 5
                    tooltipwidget = {
                        using = IOVariableTooltip
                    }
                }
            }
        }
    }

    blockoverride "ios_information_header_visible" { visible = no }

	blockoverride "card_header_button_header_content" { # Remove leave/join/invite IO icon + add member icon
        margin_left = 18
        icon = {
            size = { 30 30 }
            block "card_header_button_icon_texture" {
                texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
            }
            texture_density = 2
            glow = {
                name = "drop_shadow"
                glow_radius = 3
                color = {0.0 0.0 0.0 1.0}
                alpha = 0.3
            }
        }
        block "card_header_button_text_single" {
            text_single = {
                margin_left = 12
                block "card_header_button_raw_text" {
                    raw_text = "IO or Situation"
                }
            }
        }
        expand = {}
    }

    blockoverride "country_header_character_visible" {
   		visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('patriarch').IsSet]"
    }
   	blockoverride "country_header_character_context" {
        datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('patriarch').GetCharacter]"
    }
    blockoverride "extra_titles_flag_overview" { }
    blockoverride "country_header_character_name" {
        datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('patriarch').GetCharacter]"
        margin = {2 0}
		character_label_name = {
			margin_left = 0
			margin_right = 10
            blockoverride "character_label_name_extra" {
                country_flag_small = {
                    datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
                }
            }
            blockoverride "character_name_text" {
                raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
            }
		}
    }

    blockoverride "io_overview_actions" {
        margin = { 0 5 }

        #Actions
        hbox = {
            layoutpolicy_horizontal = expanding
            margin = { 10 0 }
            widget = { 
                layoutpolicy_horizontal = expanding
                size = { -1 50 }
                header_paper_card_horizontal = {
                    blockoverride "header_paper_card_size"{
                        size = { 100% 100% }
                    }
            
                	using = bg_patriarchate_header
					using = bg_ios_side_flavor
					blockoverride "ios_side_flavor_left" { visible = no }
            
                    blockoverride "bg_card_header_01_bg" {
                        background = {
                            texture = "gfx/interface/component_tiles/square_tile.dds"
                            texture_density = 2
                            spriteType = corneredtiled
                            spriteborder = { 10 10 }
            
                            modify_texture = {
                                using = color_society_texture
                                blend_mode = multiply
                            }
            
                            modify_texture = {
                                texture = "gfx/interface/cards/headers/header_pattern_07.dds"
                                alpha = 0.7
                                texture_density = 2
                                spriteType = corneredtiled
                                blend_mode = overlay
                            }
                        }
            
                        background = {
                            using = color_black_texture
                            alpha = 0.6
                        }
                    }
            
                    blockoverride "header_content" {
                        widget = {
                            size = { 100% 100% }

							icon = {
								ignore_layout = yes
								size = { 48 48 }
								parentanchor = center
								texture = "gfx/interface/component_tiles/ios/patriarchate_icon_container.dds"
								texture_density = 2
							}
							
                            hbox = {
                                expand = {}

                                icon = {
                                    size = { 22 22 }
                                    texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
                                    glow = {
                                        name = "drop_shadow"
                                        glow_radius = 3
                                        color = {0.0 0.0 0.0 1.0}
                                        alpha = 0.3
                                    }
                                }
                                expand = {}
                            }
                        }
                    }

					blockoverride "header_horizontal_bg" {}
            
                    # RIGHT
                    blockoverride "bottom_content" {
                        hbox = {
                            
                            spacing = 4
                            
                            margin = { 10 0 }
                            hbox = {
                                layoutpolicy_vertical = expanding
                                spacing = 4
                                datamodel = "[InternationalOrganizationsView.GetActions]"
                                item = {
                                    navigational_action_button_alt = {
                                        using = bg_circle_alt_brown
                                        using = bg_square_tile
        
                                        blockoverride "button_icon_stretch_sprite" {}

                                        blockoverride "inner_icon" {
                                            icon = {
                                                size = { 65% 65% }
                                                visible = "[GenericAction.HasIcon]"
                                                texture = "[GenericAction.GetIcon]"
                                                modify_texture = {
                                                    using = overlay_stone_texture
                                                    blend_mode = alphamultiply
                                                    alpha = 0.5
                                                }
                                
                                                parentanchor = center
                                                texture_density = 2
                                            }
                                            icon = {
                                                size = { 65% 65% }
                                                visible = "[Not(GenericAction.HasIcon)]"
                                                texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
                                                modify_texture = {
                                                    using = overlay_stone_texture
                                                    blend_mode = alphamultiply
                                                    alpha = 0.5
                                                }
                                
                                                parentanchor = center
                                                texture_density = 2
                                            }
                                        }
        
                                        blockoverride "button_texture" {
                                            texture = "gfx/interface/buttons/navigational_frame.dds"
                                            size = { 35 35 }
                                        }
        
                                        blockoverride "square_extras" {
                                            margin = {1 1}
                                        }
        
                                        visible = "[Not(EqualTo_string(GenericAction.GetKey, 'contribute_to_organization_treasury'))]"
                                        title = "[GenericAction.GetNameWithNoTooltip]"
                                        actor = "[InternationalOrganizationsView.GetPlayer]"
                                        parameter = {
                                            parameter_name = "recipient"
                                            parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                        }
                                        left_action = { action_name = "[GenericAction.GetKey]" }
                                        tooltipwidget = {
                                            using = io_generic_action_button_tooltip
                                        }
                                    }
                                }
                            }
    
                            #invite people
                            navigational_action_button_alt = {
                                using = bg_circle_alt_brown
                                using = bg_square_tile
    
                                blockoverride "button_icon_stretch_sprite" {}
    
                                blockoverride "button_texture" {
                                    texture = "gfx/interface/buttons/navigational_frame.dds"
                                    size = { 35 35 }
                                }
    
                                blockoverride "square_extras" {
                                    margin = {1 1}
                                }
    
                                blockoverride "icon_texture" {
                                    texture = "gfx/interface/icons/generic_actions/invite_to_international_organization.dds"
                                    texture_density = 2
                                    size = { 65% 65% }
                                }
    
                                title = "INT_ORG_MEMBERSHIP_TITLE"
                                actor = "[InternationalOrganizationsView.GetPlayer]"
                                left_action = {
                                    action_name = "invite_to_international_organization"
                                    action_direction = "offer"
                                    parameter = {
                                        parameter_name = "international_organization"
                                        parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                    }
                                }
                                tooltipwidget = {
                                    using = io_invite_button_tooltip
                                    blockoverride "io_invite_title_icon" {
                                        icon = {
                                            using = tooltip_title_icon_size
                                            texture = "gfx/interface/icons/generic_actions/invite_to_international_organization.dds"
                                        }
                                    }
                                }
                            }
                            #leave io
                            navigational_action_button_alt = {
                                using = bg_circle_alt_brown
                                using = bg_square_tile
    
                                blockoverride "button_icon_stretch_sprite" {}
    
                                blockoverride "button_texture" {
                                    texture = "gfx/interface/buttons/navigational_frame.dds"
                                    size = { 35 35 }
                                }
    
                                blockoverride "square_extras" {
                                    margin = {1 1}
                                }
    
                                blockoverride "icon_texture" {
                                    texture = "gfx/interface/icons/generic_actions/leave_international_organization.dds"
                                    texture_density = 2
                                    size = { 65% 65% }
                                }
    
                                title = "INT_ORG_MEMBERSHIP_TITLE"
                                actor = "[InternationalOrganizationsView.GetPlayer]"
                                left_click_and_hold_action = {
                                    action_name = "leave_international_organization"
                                    action_direction = "offer"
                                    parameter = {
                                        parameter_name = "recipient"
                                        parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                    }
                                }
                                tooltipwidget = {
                                    using = io_leave_button_tooltip
                                    blockoverride "io_leave_title_icon" {
                                        icon = {
                                            using = tooltip_title_icon_size
                                            texture = "gfx/interface/icons/generic_actions/leave_international_organization.dds"
                                        }
                                    }
                                }
                            }
                            expand = {}
                        }
                    }
                }
            }
        }

        #Static Tenets
        hbox = {
            layoutpolicy_horizontal = expanding
            margin = { 10 0 }
            hbox = {
                datamodel = "[InternationalOrganizationsView.GetLawCategories]"
                item = {
                    hbox = {
                        visible = "[InternationalOrganizationLawCategory.HasLockedLaws]"
                        datamodel = "[InternationalOrganizationLawCategory.GetLaws]"
                        spacing = 5
                        item = {
                            widget = {
                                size = { 100 120 }
                                datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
                                card_list_action_button = {
                                    size = { 80 120 }
                                    parentanchor = center
                    
                                    blockoverride "texture" {
                                        gfxtype = framedbuttongfx
                                        effectname = "NoHighlight"
                                        upframe = 1
                                        overframe = 1
                                        downframe = 1
                                        disableframe = 1
                                        texture = "gfx/interface/component_tiles/laws/fundamental_laws_top.dds"
                                        frame_grid = {1 1}
                                        spriteType = stretched
                                        texture_density = 2
                                    }
    
                                    enabled = "[UIAction.IsEnabled]"
                                    proposer = "[ResolutionGlue.GetProposer]"
                                    actor = "[InternationalOrganizationsView.GetPlayer]"
    
                                    left_action = {
                                        action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
    
                                        parameter = {
                                            parameter_name = "recipient"
                                            parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                        }
                                        parameter = {
                                            parameter_name = "target"
                                            parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
                                        }
                                    }
    
                                    tooltipwidget = {
                                        using = IO_Law_tooltip
                                    }

                                    # icon = {
                                    #     size = {99% 97%}
                                    #     ignore_layout = yes
                                    #     parentanchor = center
                                    #     texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
                                    #     texture_density = 2
                                    #     mirror = horizontal
                                    #     alpha = 0.1
                    
                                    #     modify_texture = {
                                    #         texture = "[InternationalOrganizationLawCategory.GetBgCategoryColor]"
                                    #         texture_density = 2
                                    #         blend_mode = multiply
                                    #     }
                                    # }
                                }

								 icon = {
                                    size = { 80 80 }
                                    parentanchor = center
                                    widgetanchor = center
                                    position = { 0 -20 }
                                    ignore_layout = yes
                                    texture = "gfx/interface/component_tiles/laws/fundamental_laws_top.dds"
                                    spriteType = stretched
                                    texture_density = 2
                                }

                                icon = {
                                    size = { 60 60 }
                                    parentanchor = center
                                    widgetanchor = center
                                    position = { 0 -23 }
                                    ignore_layout = yes
                                    texture = "gfx/interface/component_tiles/laws/fundamental_laws_decor.dds"
                                    spriteType = stretched
                                    texture_density = 2
                                }

                                law_item_icon = {
                                    parentanchor = center
                                    position = { 0 -23 }
                                    blockoverride "law_category_color" {
                                        texture = "[InternationalOrganizationLawCategory.GetBgCategoryColor]"
                                        blend_mode = multiply
                                    }
                                    blockoverride "law_list_icon" {
                                        texture = "[GetLawIcon(Law.Self)]"
                                    }
                                }

                                widget = {
                                    size = { 100% 50}
                                    parentanchor = bottom|hcenter

                                    background = {
                                        texture = "gfx/interface/component_tiles/laws/fundamental_laws_bottom.dds"
                                        spriteType = Corneredstretched
                                        spriteborder = { 20 20 }
                                        texture_density = 2
                                    }
                                    vbox = {
                                        margin = { 7 5 }
                                        text_single = {
                                            layoutpolicy_horizontal = expanding
                                            autoresize = no
                                            align = center
                                            size = { -1 16 }
                                            default_format = "#yellow_titles"
											fontsize = 14
                                            text = "[ResolutionGlue.GetTarget('target').GetLaw.GetNameWithNoTooltip]"
                                        }
                                        text_single = {
                                            layoutpolicy_horizontal = expanding
                                            autoresize = no
                                            align = center
                                            size = { -1 18 }
                                            visible = "[InternationalOrganizationsView.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
                                            text = "[InternationalOrganizationsView.GetInternationalOrganization.GetPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self).GetNameWithNoTooltip]"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        special_card_header_button = {
            blockoverride "special_card_button_color" {
                using = bg_patriarchate_header
				using = bg_ios_side_flavor
            }
            blockoverride "header_pattern_texture_density" {texture_density = 1.75}

            blockoverride "card_header_button_icon_texture" {
                visible = no
            }
            blockoverride "card_header_button_raw_text" {
                raw_text = "TENETS"
            }
            
            blockoverride "card_header_button_header_extra_content" {}

            blockoverride "bottom_content" {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 10 }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        datamodel = "[InternationalOrganizationsView.GetLawCategories]"
                        item = {
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 5
                                visible = "[Not(InternationalOrganizationLawCategory.HasLockedLaws)]"
                                datamodel = "[InternationalOrganizationLawCategory.GetLaws]"
                                item = {
                                    io_law_item = {
                                        blockoverride "laws_list_datacontext" {
                                            datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
                                        }
                                        blockoverride "law_unique_flavor_visible" {
                                            visible = "[Law.IsUnique]"
                                        }
                                        blockoverride "laws_list_button_visible" {
                                            visible = yes
                                        }
                                        blockoverride "laws_list_action_button_visible" {
                                            visible = yes
                                        }
                                        blockoverride "law_action_button_setup" {
                                            enabled = "[UIAction.IsEnabled]"
                                            proposer = "[ResolutionGlue.GetProposer]"
                                            actor = "[InternationalOrganizationsView.GetPlayer]"
            
                                            left_action = {
                                                action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
            
                                                parameter = {
                                                    parameter_name = "recipient"
                                                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                                }
                                                parameter = {
                                                    parameter_name = "target"
                                                    parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
                                                }
                                            }
            
                                            datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
            
                                            tooltipwidget = {
                                                using = IO_Law_tooltip
                                            }
                                        }
                                        blockoverride "law_category_color" {
                                            texture = "[InternationalOrganizationLawCategory.GetBgCategoryColor]"
                                            blend_mode = multiply
                                        }
                                        blockoverride "law_list_icon" {
                                            texture = "[GetLawIcon(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
                                        }
                                        blockoverride "law_title" {
                                            text = "[ResolutionGlue.GetTarget('target').GetLaw.GetNameWithNoTooltip]"
                                        }
                                        blockoverride "law_policy_level" {
                                            visible = "[ResolutionGlue.GetTarget('target').GetLaw.HasLevels]"
                                            text = "[InternationalOrganizationsView.GetInternationalOrganization.GetPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self).GetPolicyLevel]"
                                        }
                                        blockoverride "law_policy" {
                                            visible = "[InternationalOrganizationsView.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
                                            text = "[InternationalOrganizationsView.GetInternationalOrganization.GetPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self).GetNameWithNoTooltip]"
                                        }
                                        blockoverride "law_no_policy" {
                                            visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self))]"
                                            text = "NO_POLICY_SELECTED"
                                        }
                                    }
                                }
                            }
                        }
                    }
                    expand = {}
                }
            }
        }


        #Members
        vbox = {
            layoutpolicy_horizontal = expanding
            datamodel = "[InternationalOrganizationsView.GetMemberItems]"
            item = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 10
                    using = members_entry
                    visible = "[Not(IsDataModelEmpty(MemberTypeItem.GetCountries))]"
                }
            }
        }
    }

    blockoverride "organization_panel_members_area" {
		vbox = {
			using = layoutpolicy_expanding

			filtered_sorted_list = {
				datacontext = "[InternationalOrganizationsView.GetMembersSortSearch]"
				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(InternationalOrganizationsView.GetMemberItems)]"
				}

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "name"
						layoutpolicy_vertical = expanding
						size = { 180 -1 }
					}

					sort_by_key_button = {
						name = "gp"
						layoutpolicy_vertical = expanding
						size = { 40 -1 }
					}

					sort_by_key_button = {
						name = "opinion"
						layoutpolicy_vertical = expanding
						size = { 60 -1 }
					}

					sort_by_key_button = {
						name = "culture"
						layoutpolicy_vertical = expanding
						size = { 128 -1 }
					}

					sort_by_key_button = {
						name = "religion"
						layoutpolicy_vertical = expanding
						size = { 40 -1 }
					}
					expand = {}
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MEMBERS_SCROLL_LIST_EMPTY"
				}
				blockoverride "scroll_list_layout" {
					vbox = {
						using = layoutpolicy_expanding
						using = bg_secondary_inner_alt
						margin_bottom = 20
                        
                        vbox = {
							layoutpolicy_horizontal = expanding
							datamodel = "[InternationalOrganizationsView.GetMemberItems]"
							item = {
								vbox = {
									visible = "[Not(IsDataModelEmpty(MemberTypeItem.GetCountries))]"
									spacing = 5
									layoutpolicy_horizontal = expanding

									fixedgridbox = {
										addcolumn = 98%
										addrow = 40
										maxhorizontalslots = 1
										datamodel = "[MemberTypeItem.GetCountries]"
										item = {
											widget = {
												size = {100% 35}
												io_member_country_row = {
                                                    blockoverride "io_member_country_row_rank" {}
                                                    blockoverride "io_parliament_vote_member" {}
                                                }
											}
										}
									}
								}
							}
						}
						expand = {}
					}
				}
			}
			expand = {}
		}
	}

