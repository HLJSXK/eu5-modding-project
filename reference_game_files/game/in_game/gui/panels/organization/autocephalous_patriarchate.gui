	blockoverride "ios_information_header_content_extra_2" {
		using = ios_header_content_extra_template
		blockoverride "ios_header_content_extra" {
			text_single = {
				autoresize = yes
				align = right
				raw_text = "[GetPlayer.GetCurrencyValue('religious_influence')|2%]"
			}
	
			widget = {
				size = { 24 24 }
				icon = {
					size = { 100% 100% }
					texture = "gfx/interface/icons/religious_doctrines/religious_influence.dds"
				}
			}
		
			tooltipwidget = { 
				using = religious_influence_tooltip 
				blockoverride "religion_context" {
					datacontext = "[GetReligionByKey('catholic')]"
				}
				blockoverride "country_context" {
					datacontext = "[GetPlayer]"
				}
			}
		}
	}
    blockoverride "io_decoration" {
		allow_outside = yes
		alwaystransparent = yes
        
    	widget = {
			size = {494 92}
            parentanchor = hcenter|top
			position = {-1 -37}
			allow_outside = yes
            
			icon = {
                visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate)]"
				size = {101% 101%}
                parentanchor = hcenter|top
				ignore_layout = yes
				texture = "gfx/interface/component_decoration/ios/patriachate/patriarchate_overview_decor_top.dds"
				texture_density = 2
			}
            icon = {
                visible = "[InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate]"
                size = {118% 118%}
                parentanchor = hcenter|top
                position = {0 -10}
                ignore_layout = yes
                texture = "gfx/interface/component_decoration/ios/patriachate_ecumenical/ecumenical_patriarchate_overview_decor_top.dds"
                texture_density = 2
            }
            icon = {
                visible = "[InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate]"
                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.GetReligion]"
                size = {55 55}
                parentanchor = hcenter|top
                position = {1 23}
                ignore_layout = yes
                texture = "[GetReligionIcon(Religion.Self)]"
                texture_density = 2

                tooltipwidget = {
                    using = religion_tooltip
                }
            }

            religious_influence_card = {
                visible = "[And(InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate, Religion.HasReligiousInfluence)]"
                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.GetReligion]"
                parentanchor = hcenter|bottom
                position = {1 35}
                ignore_layout = yes
            }

            religious_influence_card = {
                visible = "[And(Not(InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate), Religion.HasReligiousInfluence)]"
                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.GetReligion]"
                parentanchor = hcenter|top
                position = {1 35}
                ignore_layout = yes
            }
		}

        icon = { 
            visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate)]"
            size = {573 271}
			parentanchor = hcenter|top
			position = {0 -44}
			alwaystransparent = yes
            texture = "gfx/interface/component_decoration/ios/patriachate/patriarchate_overview_decor.dds"
            texture_density = 2
			spriteType = corneredstretched

            widget = {
                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.GetReligion]"
                size = {60 95}
                parentanchor = left|top
                position = {0 25}
                ignore_layout = yes

                tooltipwidget = {
                    using = religion_tooltip
                }
            }

            widget = {
                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.GetReligion]"
                size = {60 95}
                parentanchor = right|top
                position = {0 25}
                ignore_layout = yes

                tooltipwidget = {
                    using = religion_tooltip
                }
            }
		}

        icon = {
            visible = "[InternationalOrganizationsView.GetInternationalOrganization.IsEcumenicalPatriarchate]"
            size = {560 265}
			parentanchor = hcenter|top
			position = {0 -42}
			alwaystransparent = yes
            texture = "gfx/interface/component_decoration/ios/patriachate_ecumenical/ecumenical_patriarchate_overview_decor.dds"
            texture_density = 2
			spriteType = corneredstretched
		}
	}
    blockoverride "country_header_orientation" {
        margin = {16 0}
    }
    
}
