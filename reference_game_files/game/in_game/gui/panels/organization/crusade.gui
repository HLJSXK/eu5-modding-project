organization_war_theme = {

	blockoverride "card_header_button_header_content" { # Remove leave/join/invite IO icon + add member icon
        margin_left = 18
        icon = {
            size = { 30 30 }
            block "card_header_button_icon_texture" {
                texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
            }
            texture_density = 2
            glow = {
                name = "drop_shadow"
                glow_radius = 3
                color = {0.0 0.0 0.0 1.0}
                alpha = 0.3
            }
        }
        block "card_header_button_text_single" {
            text_single = {
                margin_left = 7
                block "card_header_button_raw_text" {
                    raw_text = "IO or Situation"
                }
            }
        }
        expand = {}
    }

    blockoverride "organization_overview_tab_visible" {}
    blockoverride "organization_panel_overview_visible" {
        visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
    }
    blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}
	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

    blockoverride "scroll_overview_empty_visible" { visible = no }
    
    blockoverride "io_main_actions_icon" {
        texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
    }

	blockoverride "organization_main_actions_extra_visible" {
        visible = yes 
    }

    blockoverride "ios_information_header_visible" {}

    blockoverride "io_decoration" {
		allow_outside = yes
		alwaystransparent = yes
    	widget = {
			size = {460 125}
            parentanchor = hcenter|top
			position = {0 -38}
			allow_outside = yes

			icon = {
                parentanchor = hcenter|top
				size = {101% 101%}
				ignore_layout = yes
				texture = "gfx/interface/component_decoration/ios/crusade/crusade_overview_decor_top.dds"
				texture_density = 2
			}
		}
        icon = {
            size = {563 267}
			alwaystransparent = yes
            texture = "gfx/interface/component_decoration/ios/crusade/crusade_overview_decor.dds"
            texture_density = 2
			spriteType = corneredstretched
			parentanchor = hcenter|top
			position = {1 -40}
		}

        widget = {
            size = { 102 40 }
            parentanchor = left|top
            position = { 28 -39 }
            hbox = {
                spacing = 12
                expand = {}

                widget = {
                    size = { 26 26 }
                    using = bg_circle_piechart

                    icon = {
                        size = { 70% 70% }
                        parentanchor = center
                        widgetanchor = center
                        texture = "gfx/interface/icons/flat_icons/declare_war/army_size.dds"
                        texture_density = 2

                    }
                }
                hbox = {
                    layoutpolicy_horizontal = expanding
                    minimumsize = { -1 22 }
                    maximumsize = { 42 -1 }
                    margin = { 6 0 }
                    using = bg_text_mask_crusade_container
                    blockoverride "crusade_container_mirror" {}

                    text_single = {
                        layoutpolicy_horizontal = expanding
                        maximumsize = { 42 -1 }
                        autoresize = yes
                        align = left
                        default_format = "#yellow_titles"
                        text = "[InternationalOrganizationsView.GetIOLandStrength]"
                    }
                }
                tooltipwidget = {
                    SimpleContextualTooltipType = {
                        blockoverride "title_icon" {
                            icon = {
                                using = tooltip_title_icon_size
                                texture = "gfx/interface/icons/flat_icons/declare_war/army_size.dds"
                            }
                        }

                        blockoverride "concept_link" {
                            text = "[strength|e]"
                        }
                        lowpriotextcontext = "[InternationalOrganizationsView.GetIOLandStrengthTooltip]"

                    }
                }
            }
        }

        widget = {
			size = { 118 36 }
			parentanchor = top|hcenter
			position = { 0 -36 }
			hbox = {
				datamodel = "[DataModelFirst(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables, '(int32)1')]"
				item = {
					vbox = {
                        layoutpolicy_horizontal = expanding
                        using = bg_text_mask_container_brown
                        
                        text_single = {
                            layoutpolicy_horizontal = expanding
                            maximumsize = { -1 8 }
                            margin_right = 5
                            autoresize = yes
                            fontsize = 12
                            align = center
                            text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText(MonthlySavedVariable.Self)]"
                        }
                        
                        progressbar_framed = {
                            layoutpolicy_horizontal = expanding
							size = { -1 8 }
                            using = progress_bar_blue_alt
                            min = "[FixedPointToFloat(MonthlySavedVariable.GetMin)]"
                            max = "[FixedPointToFloat(MonthlySavedVariable.GetMax)]"
                            value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(MonthlySavedVariable.GetTag))]"
                        }

                        tooltipwidget = {
                            using = IOVariableTooltip
                        }
					}
				}
			}
		}

        widget = {
            size = { 102 40 }
            parentanchor = right|top
            position = { -49 -39 }
            hbox = {
                spacing = 12
                expand = {}

                hbox = {
                    layoutpolicy_horizontal = expanding
                    minimumsize = { -1 22 }
                    maximumsize = { 42 22 }
                    margin = { 5 0 }
                    using = bg_text_mask_crusade_container

                    text_single = {
                        layoutpolicy_horizontal = expanding
                        maximumsize = { 42 -1 }
                        autoresize = yes
                        align = right
                        default_format = "#yellow_titles"
                        text = "[InternationalOrganizationsView.GetIONavalStrength]"
                    }
                }
                tooltipwidget = {
                    SimpleContextualTooltipType = {
                        blockoverride "title_icon" {
                            icon = {
                                using = tooltip_title_icon_size
                                texture = "gfx/interface/icons/flat_icons/declare_war/navy_size.dds"
                            }
                        }

                        blockoverride "concept_link" {
                            text = "[strength|e]"
                        }
                        lowpriotextcontext = "[InternationalOrganizationsView.GetIONavalStrengthTooltip]"

                    }
                }
                widget = {
                    size = { 26 26 }
                    using = bg_circle_piechart

                    icon = {
                        size = { 70% 70% }
                        parentanchor = center
                        widgetanchor = center
                        texture = "gfx/interface/icons/flat_icons/declare_war/navy_size.dds"
                        texture_density = 2

                    }
                }
            }
        }
	}

    blockoverride "country_header_orientation" {
		margin = {16 0}
	}

    blockoverride "country_header_character_name" {
        margin = {16 0}
        CharacterNameDefault = {
            blockoverride "name_highlight" {}
            margin = {3 0}
            using = bg_name_banner_left
          
        }
    }
	blockoverride "ios_information_header_content_extra_3" {
		using = ios_header_content_extra_template
		blockoverride "ios_header_content_extra" { #Target of crusade
			visible = "[InternationalOrganizationsView.GetInternationalOrganization.GetTarget.IsValid]"
			datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetTarget]"
			text_single = {
				text = "TARGETTING"
			}
			country_flag_small = {}
		}
	}
    blockoverride "overview_searchbar_visible" { visible = no }

    blockoverride "organization_panel_members_area" {
        vbox = {
            using = layoutpolicy_expanding

            filtered_sorted_list = {
                datacontext = "[InternationalOrganizationsView.GetMembersSortSearch]"
                blockoverride "scroll_list_is_empty" {
                    visible = "[IsDataModelEmpty(InternationalOrganizationsView.GetMemberItems)]"
                }

                blockoverride "sort_buttons_filtered_list" {
                    sort_by_key_button = { name = "rank"     layoutpolicy_vertical = expanding size = { 40 -1 } }
                    sort_by_key_button = { name = "name"     layoutpolicy_vertical = expanding size = { 175 -1 } }
                    sort_by_key_button = { name = "gp"       layoutpolicy_vertical = expanding size = { 40 -1 } }
                    sort_by_key_button = { name = "opinion"  layoutpolicy_vertical = expanding size = { 60 -1 } }
                    sort_by_key_button = { name = "armysize" layoutpolicy_vertical = expanding size = { 128 -1 } }
                    expand = {}
                }

                blockoverride "scroll_list_is_empty_text" { text = "MEMBERS_SCROLL_LIST_EMPTY" }

                blockoverride "searchbar_extra_pre_content" {
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        margin = { 4 4 }

                        hbox = {
                            spacing = 6
                            datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetSpecialStatuses]"
                            item = {
                                card_header_button_04 = {
                                    visible = "[GreaterThan_int32(InternationalOrganizationsView.GetCrusadeMemberTypeCountryCount(SpecialStatus.GetKey), '(int32)0')]"
                                    allow_outside = yes
                                    size = { 38 50 }
                                    background = {
                                        texture = "gfx/interface/buttons/bg_navigational_header_button.dds"
                                        texture_density = 2
                                        spriteType = corneredstretched
                                        spriteborder = { 42 20 }
                                        mirror = horizontal
                                        modify_texture = { color = "[InternationalOrganizationsView.GetColorForCrusadeMemberTypeKey(SpecialStatus.GetKey)]" blend_mode = multiply }
                                        modify_texture = { using = overlay_stone_texture blend_mode = overlay alpha = 0.5 }
                                        modify_texture = { using = overlay_window_texture blend_mode = overlay alpha = 0.5 }
                                    }
                                    tooltipwidget = {
                                        ContextualTooltipType = {
                                            blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[InternationalOrganizationsView.GetIconForCrusadeMemberTypeKey(SpecialStatus.GetKey)]" } }
                                            blockoverride "title_text" { text = "[SpecialStatus.GetNameWithNoTooltip]" }
                                            blockoverride "concept_link" { text = "[international_organization|e]" }
                                            blockoverride "tooltip_content" {
                                                TooltipFlavorTextBlock = { blockoverride "text" { text = "[SpecialStatus.GetDesc]" } }
                                            }
                                        }
                                    }
                                    action_tooltip = {
                                        title = "TOGGLE_FILTER"
                                        on_action = "[InternationalOrganizationsView.ToggleCrusadeMemberTypeFilter(SpecialStatus.GetKey)]"
                                    }
                                    vbox = {
                                        using = layoutpolicy_expanding
                                        icon = { size = { 28 28 } texture = "[InternationalOrganizationsView.GetIconForCrusadeMemberTypeKey(SpecialStatus.GetKey)]" }
                                        text_single = { raw_text = "[InternationalOrganizationsView.GetCrusadeMemberTypeCountryCount(SpecialStatus.GetKey)]" }
                                    }
                                }
                            }
                        }

                        card_header_button_04 = {
                            visible = "[GreaterThan_int32(InternationalOrganizationsView.GetCrusadeMemberTypeCountryCount('normal_members'), '(int32)0')]"
                            allow_outside = yes
                            size = { 38 50 }
                            background = {
                                texture = "gfx/interface/buttons/bg_navigational_header_button.dds"
                                texture_density = 2
                                spriteType = corneredstretched
                                spriteborder = { 42 20 }
                                mirror = horizontal
                                modify_texture = { color = "[InternationalOrganizationsView.GetColorForCrusadeMemberTypeKey('normal_members')]" blend_mode = multiply }
                                modify_texture = { using = overlay_stone_texture blend_mode = overlay alpha = 0.5 }
                                modify_texture = { using = overlay_window_texture blend_mode = overlay alpha = 0.5 }
                            }
                            tooltipwidget = {
                                ContextualTooltipType = {
                                    blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/international_organizations/special_statuses/members.dds" } }
                                    blockoverride "title_text" { text = "CRUSADE_MEMBERS_FILTER" }
                                    blockoverride "concept_link" { text = "[international_organization|e]" }
                                }
                            }
                            action_tooltip = {
                                title = "TOGGLE_FILTER"
                                on_action = "[InternationalOrganizationsView.ToggleCrusadeMemberTypeFilter('normal_members')]"
                            }
                            vbox = {
                                using = layoutpolicy_expanding
                                icon = { size = { 28 28 } texture = "gfx/interface/icons/international_organizations/special_statuses/members.dds" }
                                text_single = { raw_text = "[InternationalOrganizationsView.GetCrusadeMemberTypeCountryCount('normal_members')]" }
                            }
                        }

                        expand = {}
                    }
                }

                blockoverride "searchbar_top_extra" {
                    header_button_right = {
                        visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'crusade_members_view_toggle' ))]"
                        size = { 30 30 }
                        blockoverride "button_icon_stretch_sprite" {}
                        blockoverride "header_button_frame_inner" { visible = no }
                        blockoverride "header_button_icon_size" { size = { 30 30 } }
                        blockoverride "header_button_text_layout" {}
                        blockoverride "icon_texture" { texture = "gfx/interface/icons/flat_icons/menu_icon_square.dds" texture_density = 2 }
                        action_tooltip = { title = "HRE_MEMBERS_VIEW_FLAGS" on_action = "[InternationalOrganizationsView.Vars.Toggle( 'crusade_members_view_toggle' )]" }
                        tooltipwidget = { BasicFunctionalTooltip = {} }
                    }
                    header_button_right = {
                        visible = "[InternationalOrganizationsView.Vars.Exists( 'crusade_members_view_toggle' )]"
                        size = { 30 30 }
                        blockoverride "button_icon_stretch_sprite" {}
                        blockoverride "header_button_frame_inner" { visible = no }
                        blockoverride "header_button_icon_size" { size = { 30 30 } }
                        blockoverride "header_button_text_layout" {}
                        blockoverride "icon_texture" { texture = "gfx/interface/icons/flat_icons/menu_icon.dds" texture_density = 2 }
                        action_tooltip = { title = "HRE_MEMBERS_VIEW_LIST" on_action = "[InternationalOrganizationsView.Vars.Toggle( 'crusade_members_view_toggle' )]" }
                        tooltipwidget = { BasicFunctionalTooltip = {} }
                    }
                }

                blockoverride "scroll_list_layout" {
                    vbox = {
                        using = layoutpolicy_expanding
                        using = bg_secondary_inner_alt
                        margin_bottom = 20

                        vbox = {
                            visible = "[InternationalOrganizationsView.Vars.Exists( 'crusade_members_view_toggle' )]"
                            layoutpolicy_horizontal = expanding
                            datamodel = "[InternationalOrganizationsView.GetMemberItems]"
                            item = {
                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 10
                                    using = members_entry
                                    visible = "[Not(IsDataModelEmpty(MemberTypeItem.GetCountries))]"
                                }
                            }
                        }

                        vbox = {
                            visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'crusade_members_view_toggle' ))]"
                            layoutpolicy_horizontal = expanding
                            datamodel = "[InternationalOrganizationsView.GetMemberItems]"
                            item = {
                                vbox = {
                                    visible = "[Not(IsDataModelEmpty(MemberTypeItem.GetCountries))]"
                                    spacing = 5
                                    layoutpolicy_horizontal = expanding
                                    margin_left = 4

                                    fixedgridbox = {
                                        addcolumn = 100%
                                        addrow = 40
                                        maxhorizontalslots = 1
                                        datamodel = "[MemberTypeItem.GetCountries]"
                                        item = {
                                            widget = {
                                                size = {96% 35}
                                                io_member_country_row = {
                                                    blockoverride "io_member_country_row_rank" {
                                                        widget = {
                                                            size = { 30 30 }
                                                            bookmark_02 = {
                                                                parentanchor = top|hcenter
                                                                position = { 0 6 }
                                                                blockoverride "bookmark_size" { size = { 30 30 } }
                                                                blockoverride "bookmark_texture" { texture = "gfx/interface/component_tiles/bookmark_02.dds" position = {0 -5} }
                                                                blockoverride "bookmark_color" { tintcolor = "[InternationalOrganizationsView.GetCrusadeMemberColorForCountry(Country.Self)]" }
                                                            }
                                                            icon = {
                                                                size = { 20 20 }
                                                                parentanchor = center
                                                                texture = "[InternationalOrganizationsView.GetCrusadeMemberIconForCountry(Country.Self)]"
                                                                tooltipwidget = {
                                                                    ContextualTooltipType = {
                                                                        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[InternationalOrganizationsView.GetCrusadeMemberIconForCountry(Country.Self)]" } }
                                                                        blockoverride "title_text" { text = "[InternationalOrganizationsView.GetCrusadeMemberTypeNameForCountry(Country.Self)]" }
                                                                        blockoverride "concept_link" { text = "[international_organization|e]" }
                                                                    }
                                                                }
                                                            }
                                                            sort_by_highlight = { name = "rank" }
                                                        }
                                                    }
                                                    blockoverride "io_member_country_name_size" {
                                                        minimumsize = { 145 -1 }
                                                        maximumsize = { 145 -1 }
                                                    }
                                                    blockoverride "io_parliament_vote_member" {}
                                                    blockoverride "io_member_country_row_culture_religion" {
                                                        divider_flavor_01 = { size = {8 -1} }
                                                        hbox = {
                                                            minimumsize = { 128 -1 }
                                                            maximumsize = { 128 -1 }
                                                            sort_by_highlight = { name = "armysize" }
                                                            tooltipwidget = { using = ArmyOverview_tooltip }
                                                            spacing = 5
                                                            text_single = {
                                                                visible = "[HasArmySizeIntelOn(Country.Self)]"
                                                                autoresize = yes
                                                                align = right
                                                                raw_text = "[Country.GetRaisedAndPotentialLevyStrength] @levy! / [Country.GetRegularArmySize|0L] @regular!"
                                                            }
                                                            text_single = {
                                                                visible = "[Not(HasArmySizeIntelOn(Country.Self))]"
                                                                tagtooltip_enabled = yes
                                                                text = "INTEL_FOG_ARMY_SIZE_UNKNOWN"
                                                            }
                                                            icon = {
                                                                size = { 24 24 }
                                                                texture = "gfx/interface/icons/flat_icons/declare_war/army_size.dds"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        expand = {}
                    }
                }
            }
            expand = {}
        }
    }

    blockoverride "country_header_margin"{
		margin = { 12 5 }
	}
	blockoverride "ruler_name_font_size" {
		fontsize = 15
	}
	blockoverride "extra_titles_flag_overview" {}
	blockoverride "ruling_history_button" {}

	blockoverride "character_widget" {
		widget = {
			position = { 50 -10 }
			allow_outside = yes

			size = { 170 180 }
			parentanchor = bottom

			portrait_standard_full_body_center_hre_button = {
				visible = yes
				parentanchor = bottom

				size = { 170 180 }
				datacontext = "[Country.GetGovernment.GetRulerOrRegent]"
			}
		}
	}
    blockoverride "ios_information_header_visible" {
		visible = no
	}

    blockoverride "organization_overview_list_custom_top_extra" {
        margin_top = 6
        hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            margin = { 6 2 }
            using = bg_paper_card
            using = bg_cabinet_card_frame

            hbox = {
                layoutpolicy_horizontal = expanding
                margin = { 6 8 }
                maximumsize = { 320 -1 }
                background = {
                    texture = "gfx/interface/component_tiles/military_modifiers_container.dds"
                    texture_density = 2
                    mirror = horizontal
                    spriteType = Corneredstretched
                    spriteborder = { 25 0 }
                }
                
                vbox = {
                    margin = { 12 4 }
                    spacing = 2
                    datacontext = "[InternationalOrganizationsView.GetSpecialStatusCountry('crusade_spiritual_leader')]"
                    country_flag_mid = {
                        tooltipwidget = { using = CountryTooltip }
                    }
                    text_single = {
                        autoresize = yes
                        align = center
                        default_format = "#yellow_titles"
                        text = "crusade_spiritual_leader"
                        tooltipwidget = {
                            ContextualTooltipType = {
                                blockoverride "title_icon" {
                                    icon = {
                                        using = tooltip_title_icon_size
                                        texture = "[GetSpecialStatusIconFromKey('crusade_spiritual_leader')]"
                                    }
                                }
                                blockoverride "title_text" { text = "crusade_spiritual_leader" }
                                blockoverride "concept_link" { text = "[members|e]" }
                                blockoverride "tooltip_content" {
                                    TooltipFlavorTextBlock = {
                                        blockoverride "text" { text = "crusade_spiritual_leader_desc" }
                                    }
                                }
                            }
                        }
                    }
                    text_single = {
                        autoresize = yes
                        align = center
                        text = "[Country.GetName]"
                    }
                }

                vbox = {
                    margin = { 12 4 }
                    spacing = 2

                    vbox = {
                        visible = "[InternationalOrganizationsView.HasSpecialStatusCountry('crusade_temporal_leader')]"
                        spacing = 2
                        datacontext = "[InternationalOrganizationsView.GetSpecialStatusCountry('crusade_temporal_leader')]"
                        country_flag_mid = {
                            tooltipwidget = { using = CountryTooltip }
                        }
                        text_single = {
                            autoresize = yes
                            align = center
                            default_format = "#yellow_titles"
                            text = "crusade_temporal_leader"
                            tooltipwidget = {
                                ContextualTooltipType = {
                                    blockoverride "title_icon" {
                                        icon = {
                                            using = tooltip_title_icon_size
                                            texture = "[GetSpecialStatusIconFromKey('crusade_temporal_leader')]"
                                        }
                                    }
                                    blockoverride "title_text" { text = "crusade_temporal_leader" }
                                    blockoverride "concept_link" { text = "[members|e]" }
                                    blockoverride "tooltip_content" {
                                        TooltipFlavorTextBlock = {
                                            blockoverride "text" { text = "crusade_temporal_leader_desc" }
                                        }
                                    }
                                }
                            }
                        }
                        text_single = {
                            autoresize = yes
                            align = center
                            text = "[Country.GetName]"
                        }
                    }

                    vbox = {
                        visible = "[Not(InternationalOrganizationsView.HasSpecialStatusCountry('crusade_temporal_leader'))]"
                        spacing = 4
                        text_single = {
                            autoresize = yes
                            align = center
                            default_format = "#yellow_titles"
                            text = "crusade_temporal_leader"
                            tooltipwidget = {
                                ContextualTooltipType = {
                                    blockoverride "title_icon" {
                                        icon = {
                                            using = tooltip_title_icon_size
                                            texture = "[GetSpecialStatusIconFromKey('crusade_temporal_leader')]"
                                        }
                                    }
                                    blockoverride "title_text" { text = "crusade_temporal_leader" }
                                    blockoverride "concept_link" { text = "[members|e]" }
                                    blockoverride "tooltip_content" {
                                        TooltipFlavorTextBlock = {
                                            blockoverride "text" { text = "crusade_temporal_leader_desc" }
                                        }
                                    }
                                }
                            }
                        }
                        
                    }

                    button_regular_diamond = {
                        size = { 180 30 }
                        datacontext = "[GetGenericAction('claim_crusade_war_leadership')]"
                        text = "[GenericAction.GetNameWithNoTooltip]"

                        visible = "[PdxGuiWidget.IsUberButtonVisible]"
                        enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

                        scripted_action_tooltip = {
                            click_type = left
                            click_mode = single
                            action_name = "claim_crusade_war_leadership"
                            actor = "[InternationalOrganizationsView.GetPlayer]"
                            parameter = {
                                parameter_name = "recipient"
                                parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                            }
                        }

                        tooltipwidget = {
                            using = io_generic_action_button_tooltip
                        }
                    }
                }
            }

            expand = {}

            vbox = {
                visible = "[InternationalOrganizationsView.GetInternationalOrganization.GetTarget.IsValid]"
                using = bg_text_mask_container_dark_red
                margin = { 12 4 }
                spacing = 2
                datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetTarget]"
                country_flag_mid = {
                    tooltipwidget = { using = CountryTooltip }
                }
                text_single = {
                    autoresize = yes
                    align = center
                    default_format = "#yellow_titles"
                    text = "CRUSADE_TARGET"
                }
                text_single = {
                    autoresize = yes
                    align = center
                    text = "[Country.GetName]"
                }
            }
        }

        card_io_payments_no_header = {
            blockoverride "card_io_payments_header_icon" {
                spacing = 8
                icon = {
                    size = { 25 25 }
                    texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
                    texture_density = 2
                    icon = {
                        parentanchor = bottom|right
                        size = { 12 12 }
                        texture = "gfx/interface/icons/resources/gold.dds"
                        texture_density = 2
                    }
                }
            }
            blockoverride "card_io_payments_header_extra" {
                expand = {}
                text_single = {
                    margin = { 6 0 }
                    autoresize = yes
                    raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetCurrencyValue('gold')][gold_i]"
                    using = bg_number_container_bckg
                }
            }
            
            blockoverride "payment_block" {
                widget = {
                    size = { 100 22 }
                    text_single = {
                        align = center
                        parentanchor = center
                        using = layoutpolicy_expanding
                        text = "[InternationalOrganization.GetTreasuryMonthlyIncome][gold_i]"
                        fontsize = 14
                    }
                }
            }
        }

        vbox = {
            layoutpolicy_horizontal = expanding
            visible = "[LessThan_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.GetVariable('phase'), '(CFixedPoint)2')]"
            using = bg_paper_card_situations
            using = bg_cabinet_card_frame

            hbox = {
                layoutpolicy_horizontal = expanding
                using = bg_scroll_card_header
                margin = { 10 5 }
                spacing = 3

                icon = {
                    size = { 30 30 }
                    texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
                    texture_density = 2
                }

                vbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 3
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
    
                        text_single = {
                            text = "CRUSADE_PREPARATIONS"
                        }
                        expand = {}
                        text_single = {
                            datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableSpec('preparation')]"
                            autoresize = yes
                            default_format = "#yellow_titles"
                            text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText(MonthlySavedVariable.Self)]"

                            tooltipwidget = {
                                using = IOVariableTooltip
                            }
                        }
                    }

                    progressbar = {
                        datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableSpec('preparation')]"
                        layoutpolicy_horizontal = expanding
                        size = { -1 8 }
                        using = progress_bar_blue_alt
                        min = "[FixedPointToFloat(MonthlySavedVariable.GetMin)]"
                        max = "[FixedPointToFloat(MonthlySavedVariable.GetMax)]"
                        value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(MonthlySavedVariable.GetTag))]"

                        tooltipwidget = {
                            using = IOVariableTooltip
                        }
                    }
                }

            }

            hbox = {
                layoutpolicy_horizontal = expanding
                margin = { 15 10 }
                scrollarea = {
                    layoutpolicy_horizontal = expanding
                    maximumsize = { 470 250 }
                    scrollbarpolicy_horizontal = always_off
                    autoresizescrollarea = yes
                    scrollbar_vertical = {
                        using = Scrollbar_Vertical
                    }
                    scrollwidget = {
                        dynamicgridbox = {
                            ignoreinvisible = yes
                            datamodel = "[InternationalOrganizationsView.GetActions]"
                            item = {
                                widget = {
                                    size = { 470 37 }
                                    visible = "[And(Not(EqualTo_string(GenericAction.GetKey, 'contribute_to_organization_treasury')), Not(EqualTo_string(GenericAction.GetKey, 'claim_crusade_war_leadership')))]"
                                    button_regular_diamond = {
                                        parentanchor = center
                                        size = { 470 30 }
                                        text = "[GenericAction.GetNameWithNoTooltip]"

                                        visible = "[PdxGuiWidget.IsUberButtonVisible]"
                                        enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

                                        scripted_action_tooltip = {
                                            click_type = left
                                            click_mode = single
                                            action_name = "[GenericAction.GetKey]"
                                            actor = "[InternationalOrganizationsView.GetPlayer]"
                                            parameter = {
                                                parameter_name = "recipient"
                                                parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                                            }
                                        }

                                        tooltipwidget = {
                                            using = io_generic_action_button_tooltip
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    blockoverride "organization_overview_payments" {}

    blockoverride "organization_overview_special_members" {}

    blockoverride "organization_overview_generic_actions_visible" {
        visible = "[GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.GetVariable('phase'), '(CFixedPoint)2')]"
    }
    blockoverride "organization_main_actions_extra_visible" { visible = "[InternationalOrganizationsView.HasActions]" }

    blockoverride "organization_main_actions_extra" {
        #Join io
        button_regular_diamond = {
            #parentanchor = center
            size = { 470 30 }
            text = "ASK_FOR_IO_MEMBERSHIP"

            visible = "[And(Not(Player.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization)), Not(InternationalOrganizationsView.GetInternationalOrganization.GetTarget.IsPlayer))]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

            scripted_action_tooltip = {
                click_type = left
                click_mode = single
                action_name = "ask_to_join_international_organization"
                action_direction = "request"
                actor = "[InternationalOrganizationsView.GetPlayer]"
                parameter = {
                    parameter_name = "recipient"
                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
                }
                parameter = {
                    parameter_name = "international_organization"
                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                }
            }

            tooltipwidget = {
                using = io_join_button_tooltip
            }
        }
        #invite people
        button_regular_diamond = {
            size = { 470 30 }
            text = "INVITE_FOR_IO_MEMBERSHIP"

            visible = "[Player.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization)]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

            scripted_action_tooltip = {
                click_type = left
                click_mode = single
                action_name = "invite_to_international_organization"
                action_direction = "offer"
                actor = "[InternationalOrganizationsView.GetPlayer]"
                parameter = {
                    parameter_name = "international_organization"
                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                }
            }

            tooltipwidget = {
                using = io_invite_button_tooltip
            }
        }
        #leave io
        button_regular_diamond = {
            size = { 470 30 }
            text = "LEAVE_IO_MEMBERSHIP"

            visible = "[PdxGuiWidget.IsUberButtonVisible]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

            scripted_action_tooltip = {
                click_type = left
                click_mode = confirm
                action_name = "leave_international_organization"
                action_direction = "offer"
                actor = "[InternationalOrganizationsView.GetPlayer]"
                parameter = {
                    parameter_name = "recipient"
                    parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
                }
            }

            tooltipwidget = {
                using = io_leave_button_tooltip
            }
        }
    }

