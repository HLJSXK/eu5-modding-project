organization_panel = {

	blockoverride "common_ios_subheader_select_menu_button" {
		visible = yes
	}
	blockoverride "select_menu_button_text" {
		text_single = {
			margin_bottom = 3
			align = left
			autoresize = yes
			minimumsize = { 150 18 }
			maximumsize = { 150 18 }
			fontsize = 14
			text = "IMPERIAL_CONSTITUTION"
		}
		text_single = {
			align = left
			margin_bottom = 3
			autoresize = yes
			minimumsize = { 150 10 }
			maximumsize = { 150 10 }
			fontsize = 11
			text = "[InternationalOrganizationsView.GetPoliciesBenefitingEmperorText]"
			default_format = "#yellow_titles"
		}
	}
	blockoverride "organization_panel_left_header" {
		# State 1: Golden Bull not active and not being debated – red (button_regular_alt_red look), propose resolution via UIAction with policy parameter
		container = {
			visible = "[And(And(Not(InternationalOrganizationsView.IsGoldenBullPolicyActive), Not(InternationalOrganizationsView.IsGoldenBullBeingDebated)), InternationalOrganizationsView.HasGoldenBullResolutionGlue)]"
			datacontext = "[InternationalOrganizationsView.GetGoldenBullResolutionGlue]"
			paper_card_button_hre = {
				size = { 200 35 }

				title = "golden_bull_policy"
				tooltipwidget = {
					using = action_tooltip_pop_out
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "gfx/interface/icons/laws/golden_bull.dds"
						}
					}
					blockoverride "concept_link" {
						text = "[policy|e]"
					}
				}
				enabled = "[UIAction.IsEnabled]"
				proposer = "[ResolutionGlue.GetProposer]"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_click_and_hold_action = {
					action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
					parameter = {
						parameter_name = "recipient"
						parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
					}
					parameter = {
						parameter_name = "target"
						parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
					}
					parameter = {
						parameter_name = "vote"
						parameter_value = "[InternationalOrganizationsView.GetGoldenBullPolicy]"
					}
				}
				
				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 2

					icon = {
						size = { 35 35 }
						texture = "gfx/interface/icons/laws/golden_bull.dds"
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							margin_bottom = 3
							autoresize = yes
							minimumsize = { 150 18 }
							maximumsize = { 150 18 }
							fontsize = 14
							text = "CALL_IMPERIAL_DIET_TO"
						}
						text_single = {
							margin_bottom = 3
							autoresize = yes
							minimumsize = { 150 10 }
							maximumsize = { 150 10 }
							fontsize = 11
							text = "golden_bull_policy"
							default_format = "#yellow_titles"
						}
					}
					expand = {}
				}
			}
		}
		# State 2: Golden Bull being debated – yellow, "Debating" + policy; click = go to Imperial Diet tab 
		button_regular_paper_card_hre = {
			visible = "[InternationalOrganizationsView.IsGoldenBullBeingDebated]"
			size = { 200 35 }
			datacontext = "[InternationalOrganizationsView.GetGoldenBullResolutionGlue]"

			action_tooltip = {
				click_type = left
				click_mode = single
				title = "OPEN_HRE_DIPLOMACY"
				on_action = "[InternationalOrganizationsView.Vars.Set( 'organizations', 'parliament' )]"
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 2

				icon = {
					size = { 35 35 }
					texture = "gfx/interface/icons/laws/golden_bull.dds"
				}
				vbox = {
					margin_left = 10
					text_single = {
						margin_bottom = 3
						autoresize = yes
						minimumsize = { 120 18 }
						maximumsize = { 120 18 }
						fontsize = 14
						text = "GOLDEN_BULL_DEBATING"
					}
					text_single = {
						margin_bottom = 3
						autoresize = yes
						minimumsize = { 120 10 }
						maximumsize = { 120 10 }
						fontsize = 11
						text = "golden_bull_policy"
						default_format = "#yellow_titles"
					}
				}
				
				hbox = {
					widget = {
						size = { 24 24 }
						using = bg_circle
						visible = "[ResolutionGlue.GetOwner.ShouldDisplayProgressForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
						piechart = {
							size = { 100% 100% }
							parentanchor = center
							using = piechart_angles
							icon = {
								parentanchor = center
								size = { 70% 70% }
								texture = "gfx/interface/icons/situations/_default.dds"
								texture_density = 2
							}
							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[FixedPointToFloat(ResolutionGlue.GetOwner.GetPolicyProgressForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self))]"
								using = color_value_progress_blue
							}
							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[Subtract_float('(float)100.0', FixedPointToFloat(ResolutionGlue.GetOwner.GetPolicyProgressForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)))]"
								using = color_value_progress_gray
							}
							using = bg_circle_piechart
						}
					}
					widget = {
						size = { 24 24 }
						using = bg_circle
						visible = "[Or(ResolutionGlue.EnactResolutionIsActive, ResolutionGlue.RepealResolutionIsActive)]"
						piechart = {
							size = { 100% 100% }
							using = piechart_angles
							parentanchor = center
							icon = {
								visible = "[Not(ResolutionGlue.HasCountryVotedFromPointer(Player.Self))]"
								parentanchor = center
								size = { 70% 70% }
								texture = "gfx/interface/icons/international_organizations/law_voting.dds"
								texture_density = 2
							}
							icon = {
								visible = "[ResolutionGlue.HasCountryVotedFromPointer(Player.Self)]"
								parentanchor = center
								size = { 70% 70% }
								texture = "gfx/interface/icons/international_organizations/law_voting_yes.dds"
								texture_density = 2
							}
							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[FixedPointToFloat(ResolutionGlue.GetProgressToDeadline)]"
								using = color_value_progress_blue
							}
							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[Subtract_float('(float)100.0', FixedPointToFloat(ResolutionGlue.GetProgressToDeadline))]"
								using = color_value_progress_gray
							}
							datacontext = "[ResolutionGlue.GetVoteToEnactAction]"
							tooltipwidget = {
								using = international_organization_resolution_voting_tooltip
							}
						}
					}
				}
				expand = {}
			}
		}
		# State 3: Golden Bull enacted – green, single line "Golden Bull Enacted"; click = no-op
		button_regular_paper_card_hre = {
			visible = "[InternationalOrganizationsView.IsGoldenBullPolicyActive]"
			size = { 200 35 }

			action_tooltip = {
				click_type = left
				click_mode = single
				title = "OPEN_HRE_DIPLOMACY"
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 2
				icon = {
					size = { 35 35 }
					texture = "gfx/interface/icons/laws/golden_bull.dds"
				}
				vbox = {
					text_single = {
						margin_left = 10
						margin_bottom = 3
						autoresize = yes
						minimumsize = { 150 18 }
						maximumsize = { 150 18 }
						fontsize = 14
						text = "GOLDEN_BULL_ENACTED"
						default_format = "#yellow_titles"
					}
				}
				expand = {}
			}
		}
	}

