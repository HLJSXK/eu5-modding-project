	# Imperial Diet:
	blockoverride "parliament_items_extra_top"{
		vbox = {
			visible = "[Not(And(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.HasOngoingParliamentDebate,InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsParliamentActive))]"
			using = bg_paper_card
			using = bg_cabinet_card_frame
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 60 }
			maximumsize = { 500 430 }
			hbox = {
				layoutpolicy_horizontal = expanding
				using = bg_card_header_01_diplomacy
				using = bg_cabinet_card_frame
				size = { 500 45 }
				margin = { 10 6 }
				spacing = 8
				icon = {
					size = { 28 28 }
					texture = "gfx/interface/icons/flat_icons/hre_parliament.dds"
					texture_density = 2
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.3
					}
				}
				text_single = {
					align = left|vcenter
					text = "LAWS_THAT_CAN_BE_DEBATED"
					default_format = "#yellow_titles"
					fontsize = 16
				}
				expand = {}
			}
			scrollarea = {
				layoutpolicy_horizontal = expanding
				maximumsize = { -1 430 }
				minimumsize = { -1 60 }
				scrollbarpolicy_horizontal = always_off
				autoresizescrollarea = yes
				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}
