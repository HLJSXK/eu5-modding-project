					widget = {

						vbox = {
							set_parent_size_to_minimum = yes
							maximumsize = { 500 430 }
							margin = { 6 10 }
							spacing = 6
							ignoreinvisible = yes
							datamodel = "[InternationalOrganizationsView.GetEnabledLaws]"
							item = {
								vbox = {
									# datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
									# visible = "[EqualTo_string(Law.GetNameWithNoTooltip, 'Power of the Holy Roman Emperor')]"
									datacontext = "[ResolutionGlue]"
									visible = "[Not(IsDataModelEmpty(ResolutionGlue.GetEnabledPoliciesForLeaderDataModel))]"
									layoutpolicy_horizontal = expanding
									maximumsize = { 500 430 }
									ignoreinvisible = yes
									spacing = 5
									datamodel = "[ResolutionGlue.GetEnabledPoliciesForLeaderDataModel]"
									item = {
										card_list_action_button = {
											size = { 500 40 }
											visible = "[Not(StringIsEmpty(ResolutionGlue.GetEnactResolution.GetKey))]"
											blockoverride "texture" {
												gfxtype = framedbuttongfx
												effectname = "NoHighlight"
												upframe = 1
												overframe = 2
												downframe = 3
												disableframe = 4
												texture = "gfx/interface/buttons/list_card_button.dds"
												frame_grid = {4 1}
												spriteType = Corneredstretched
												spriteborder = { 0 0 }
												texture_density = 2
											}
											icon = {
												ignore_layout = yes
												size = {99% 97%}
												parentanchor = center
												block "law_unique_flavor_visible" {
													visible = "[Policy.GetLaw.IsUnique]"
												}
												texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
												texture_density = 2
												mirror = horizontal
												alpha = 0.1
												modify_texture = {
													texture = "[ResolutionGlue.GetBgCategoryColor]"
													texture_density = 2
													blend_mode = multiply
												}
											}
											title = "[Policy.GetNameWithNoTooltip]"
											enabled = "[UIAction.IsEnabled]"
											proposer = "[ResolutionGlue.GetProposer]"
											actor = "[InternationalOrganizationsView.GetPlayer]"
											left_click_and_hold_action = {
												action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
												parameter = {
													parameter_name = "recipient"
													parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
												}
												parameter = {
													parameter_name = "target"
													parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
												}
												parameter = {
													parameter_name = "vote"
													parameter_value = "[Policy]"
												}
											}
									datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
									tooltipwidget = { using = IO_Law_tooltip }
											
											hbox = {
												margin = { 4 0 }
												spacing = 10
												layoutpolicy_horizontal = expanding
												widget = {
													size = { 36 36 }
													background = {
														texture = "gfx/interface/component_tiles/laws_background_frame.dds"
														texture_density = 2
														spriteType = corneredstretched
														spriteBorder = { 0 0 }
														modify_texture = {
															texture = "[ResolutionGlue.GetBgCategoryColor]"
															blend_mode = multiply
														}
														modify_texture = {
															using = overlay_cloth_texture
															blend_mode = overlay
															alpha = 0.2
														}
														modify_texture = {
															using = color_black_texture
															blend_mode = overlay
															alpha = 0.3
														}
													}
													icon = {
														size = { 90% 90% }
														parentanchor = center
														texture = "[GetLawIcon(Policy.GetLaw.Self)]"
													}
												}
				
												hbox = {
													layoutpolicy_horizontal = expanding
													ignoreinvisible = yes
													text_single = {
														layoutpolicy_horizontal = expanding
														using = Font_Size_Small
														align = nobaseline|left
														default_format = "#yellow_titles"
														block "law_title" {
															text = "[Policy.GetNameWithNoTooltip]"
														}
													}
												}
											}
										}
									}
								}
							}
							text_single = {
								visible = "[Not(InternationalOrganizationsView.HasPoliciesEnabled)]"
								layoutpolicy_horizontal = expanding
								minimumsize = { 500 43 }
								autoresize = yes
								align = center
								text = "IO_PARLIAMENT_NO_LAWS_CALL_DIET"
							}

							# text_multi = {
							# 	layoutpolicy_horizontal = expanding
							# 	margin = { 16 16 }
							# 	visible = "[And(IsDataModelEmpty(InternationalOrganizationsView.GetEnabledLaws), InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsParliamentActive)]"
							# 	align = center|nobaseline
							# 	default_format = "#subtle_name"
							# 	block "organization_parliament_no_debate_empty_text" {
							# 		text = "NO_POSSIBLE_AGENDAS"
							# 	}
							# }
							# text_multi = {
							# 	layoutpolicy_horizontal = expanding
							# 	margin = { 16 16 }
							# 	visible = "[And(IsDataModelEmpty(InternationalOrganizationsView.GetEnabledLaws), Not(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsParliamentActive))]"
							# 	align = center|nobaseline
							# 	default_format = "#subtle_name"
							# 	block "organization_parliament_no_debate_call_diet_text" {
							# 		text = "IO_PARLIAMENT_NO_LAWS_CALL_DIET"
							# 	}
							# }
						}
					}
				}
			}
		}
		expand = { visible = "[Not(And(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.HasOngoingParliamentDebate,InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsParliamentActive))]" }
		vbox = {
			layoutpolicy_horizontal = expanding
			datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament]"
			visible = "[And3(Parliament.IsLawDebate, InternationalOrganizationsView.GetInternationalOrganization.GetParliament.HasOngoingParliamentDebate,InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsParliamentActive)]"
			margin = { 10 0 }
			subheader = {
				hbox = {
					using = bg_paper_card
					using = bg_card_header_01_hre
					using = bg_cabinet_card_frame
					margin = { 14 0 }
					hbox = {
						layoutpolicy_horizontal = expanding
						size = {-1 43}
						vbox = {
							text_single = {
								layoutpolicy_horizontal = expanding
								align = left
								text = "IO_IF_DEBATE_FAILS"
							}
							text_single = {
								align = left
								maximumsize = {220 18}
								fontsize = 13
								raw_text = "[Parliament.GetLawDebateNotPassPolicy.GetName] [Localize('IO_LAW_DEBATE_POLICY_KEPT')]"
							}
						}
						expand = {}
						vbox = {
							text_single = {
								layoutpolicy_horizontal = expanding
								align = right
								text = "IO_IF_DEBATE_PASSES"
							}
							text_single = {
								align = right
								maximumsize = {220 18}
								fontsize = 13
								raw_text = "[Parliament.GetLawDebatePassPolicy.GetName] [Localize('IO_LAW_DEBATE_POLICY_SET')]"
							}
						}
					}
				}
			}
		}
	}

	blockoverride "organization_parliament_vote_cards_hbox" {
		hbox = {
			spacing = 2
			layoutpolicy_horizontal = expanding
			# No (voted against)
			io_parliament_vote_card = {
				blockoverride "parliament_card_header_icon" {
					header_action_button_left = {
						size = { 30 30}
						blockoverride "header_button_icon_size" { size = { 30 30 } }
						blockoverride "header_button_frame_inner" {visible = no}
						blockoverride "icon_overlay" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/international_organizations/law_voting_no.dds"
						}
						blockoverride "header_button_text_layout" {}
						title = "VOTE_IO_PARLIAMENT"
						description = "vote_in_organization_parliament_desc"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						parameter = {
							parameter_name = "recipient"
							parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
						}
						parameter = {
							parameter_name = "vote"
							parameter_value_bool = no
						}
						left_action = { action_name = "vote_in_organization_parliament" }
						tooltipwidget = {
							using = io_parliament_vote_button_tooltip
						}
					}
				}
				blockoverride "io_parliament_vote_card_row_extra"
				{
					using = io_parliament_vote_card_row
					blockoverride "bribe_left_action" {}
				}
			}
			# Votes left (yet to vote)
			io_parliament_vote_card = {
				visible = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsLawDebate]"
				blockoverride "parliament_card_header_icon" {}
				blockoverride "parliament_card_header" {
					expand = {}
					text_single = {
						align = left
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetNonVotedCountriesCount]"
						default_format = "#yellow_titles"
					}
					text_single = {
						align = left
						text = "IO_PARLIAMENT_VOTES_LEFT"
					}
					expand = {}
					text_single = {
						text = "[InternationalOrganizationsView.GetNonVotedCountriesVoteStrength|0]"
						default_format = "#yellow_titles"
						tagtooltip_enabled = yes
						tooltip = "[special_status_power|e]"
					}
				}
				blockoverride "parliament_card_list_datamodel" {
					datamodel = "[InternationalOrganizationsView.GetParliamentNonVotedCountriesWithPlayerFirst]"
				}
			}
			# Yes (voted in favor)
			io_parliament_vote_card = {
				blockoverride "parliament_card_header" {
					text_single = {
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetVotedCountriesCount]"
						default_format = "#color_green"
						fontsize = 14
					}
					text_single = {
						fontsize = 14
						raw_text = "[Localize('IO_PARLIAMENT_VOTED')] [Localize('YES')]:"
					}
					expand = {}
					text_single = {
						text = "[InternationalOrganizationsView.GetVotedCountriesVoteStrength|0]"
						default_format = "#color_green"
						fontsize = 14
						tagtooltip_enabled = yes
						tooltip = "[special_status_power|e]"
					}
				}

				blockoverride "parliament_card_list_datamodel" {
					datamodel = "[InternationalOrganizationsView.GetParliamentVotedCountriesWithPlayerFirst]"
				}
				blockoverride "io_parliament_vote_card_row_extra"
				{
					using = io_parliament_vote_card_row
					blockoverride "bribe_right_action" {}
				}
			}
		}
	}

	blockoverride "organization_candidates_tab_visible" {
		visible = no
	}

	blockoverride "organization_treasury_tab_visible" {
		visible = yes
		enabled = "[Or(GreaterThan_int32(GetDataModelSize(InternationalOrganizationsView.GetInternationalOrganization.GetPayments), '(int32)0' ), InternationalOrganizationsView.GetInternationalOrganization.IsCurrencyEnabled('gold'))]"
	}

	blockoverride "contribute_treasury_header_bg" {
		using = bg_card_header_situation
		using = bg_card_header_geo_situation

		widget = {
			position = { 0 -2 }
			ignore_layout = yes
			size = {526 45}
			parentanchor = center
			using = wooden_frame_hre_card_frame
			blockoverride "wooden_frame_hre_card_texture"{
				texture = "gfx/interface/component_decoration/ios/hre/wooden_frame_hre_bird.dds"
			}
			blockoverride "wooden_frame_hre_card_shadow"{
				margin = {1 1}
				texture = "gfx/interface/component_decoration/ios/hre/wooden_frame_hre_shadow_bird.dds"
			}
		}
	}
	
