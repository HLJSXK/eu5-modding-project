						using = io_parliament_vote_button_tooltip
					}
				}
			}
			hbox = {
				spacing = 1
				visible = "[Not(Country.IsPlayer)]"
				minimumsize = { 85 25 }
				maximumsize = { 85 25 }
				icon = {
					size = { 14 14 }
					texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
				}
				text_single = {
					maximumsize = { 32 18 }
					fontsize = 13
					text = "[Country.GetDiplomacy.GetOpinionOf(GetPlayer)|+=]"
				}
				##BRIBE BUTTON LAW DEBATE
				hbox = {
					visible = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsLawDebate]"
					layoutpolicy_horizontal = expanding
					action_button_regular = {
						name = "bribe button"
						blockoverride "tooltip" {
							tooltipwidget = { using = action_tooltip_pop_out_no_effects_conditions }
						}
						layoutpolicy_horizontal = expanding
						maximumsize = { 35 25 }
						using = layoutpolicy_expanding
						fontsize = 12
						text = "bribe_voter_short"
						title = "bribe_voter_for_policy"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						# params = "[InternationalOrganizationsView.GetActiveParliamentResolutionGlue.GetSpecificParams]"
						parameter = {
							parameter_name = "recipient"
							parameter_value = "[Country.MakeScope]"
						}
						parameter = {
							parameter_name = "organization"
							parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
						}
						parameter = {
							parameter_name = "law"
							parameter_value = "[InternationalOrganizationsView.GetActiveParliamentResolutionGlue.GetTarget('target')]"
						}
						block "bribe_left_action" {
							left_action = {
								action_name = "bribe_voter_for_policy"
								parameter = {
									parameter_name = "policy"
									parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetLawDebateNotPassPolicy]"
								}
							}
						}
						block "bribe_right_action" {
							right_action = {
								action_name = "bribe_voter_for_policy"
								parameter = {
									parameter_name = "policy"
									parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetLawDebatePassPolicy]"
								}
							}
						}
					}
				}
				expand = {}
			}
			text_single = {
				visible = "[And(Country.IsPlayer, Or(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsCountryInVotedCountries(InternationalOrganizationsView.GetPlayer.Self), 
				InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsCountryInOppositionCountries(InternationalOrganizationsView.GetPlayer.Self)))]"
				minimumsize = { 85 25 }
				maximumsize = { 85 25 }
				align = center
				text = "IO_PARLIAMENT_VOTED"
			}
			expand = { visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsLawDebate)]" }
			text_single = {
				minimumsize = { 40 -1 }
				maximumsize = { 40 -1 }
				align = center
				text = "[InternationalOrganizationsView.GetCountryParliamentVotes(Country.Self)|+=0]"
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" { text = "IMPERIAL_VOTE_TITLE" }
						blockoverride "tooltip_content" {
							TooltipStringPairList = { textcontext = "[InternationalOrganizationsView.GetCountryParliamentVoteBreakdown(Country.Self)]" }
						}
					}
				}
			}
			expand = {}
		}
	}
}

io_subheader_select_menu_left = {}


types hre_types
{
	type hre_top_candidate_entry = vbox {
		allow_outside = yes
		using = bg_secondary_inner_alt

		block "hre_top_frame" {
			using = bg_special_card_frame_decoration
		}
		block "hre_top_candidate_size" {
			minimumsize = { 122 190 }
		}
		margin = { 8 11 }
		margin_top = -12
		bottomtotop = yes
		datacontext = "[LeaderCandidate.GetCandidate]"

		button_regular_icon = {
			layoutpolicy_horizontal = expanding
			maximumsize = { 100 27 }
			enabled = "[InternationalOrganizationsView.IsPlayerElector]"
			action_tooltip = {
				click_type = left
				click_mode = single
				title = "HRE_VOTE_FOR_CANDIDATE"
				enabled = "[InternationalOrganizationsView.IsPlayerElector]"
				on_action = "[InternationalOrganizationsView.OnVoteForCandidate(LeaderCandidate.GetCandidate.Self)]"
			}
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture =  "gfx/interface/icons/international_organizations/law_voting_yes.dds"
						}
					}
					blockoverride "title_text" { text = "FAVOR_VOTES" }
					blockoverride "concept_link" { text = "[vote|e]" }
					blockoverride "tooltip_content" {
						TooltipStringPairList = {
							datacontext = "[StringToStringPairList(LeaderCandidate.GetVotedCountries)]"
						}
					}
				}
			}

			blockoverride "button_icon_obj" {}
			blockoverride "pre_content_extra" {}
			
			blockoverride "widget_extra" {
				hbox = {
					using = layoutpolicy_expanding
					spacing = 3
					text_single = {
						align = right
						minimumsize = { 72 -1 }
						maximumsize = { 72 -1 }
						fontsize = 13
						block "hre_top_candidate_text" { text = "HRE_FIRST_LEADER_CANDIDATE" }
					}

					icon = {
						size = { 20 20 }
						texture =  "gfx/interface/icons/international_organizations/law_voting_yes.dds"
						texture_density = 2
					}
				}
			}
		}
		
		expand = {}	
		country_rank_banner = { size = { 28 25} }
		country_flag_big = { size = { 104 70 } }
		hre_member_type_icon = {
			size = { 23 23 }
			blockoverride "hre_member_type_icon_bg"
			{
				icon = {
					size = { 250% 250% }
					parentanchor = center
					block "hre_top_frame_decoration" {
						texture = "gfx/interface/component_decoration/ios/hre/top_frame_decoration.dds"
					}
				}
			}
		}
	}
	type io_parliament_vote_card = card_common {
		layoutstretchfactor_horizontal = 1
		blockoverride "common_header_margin" { margin = { 5 0 } }
		blockoverride "header_decor_templates" {
			using = bg_card_header_01_hre
			using = bg_generic_side_mask
			using = bg_cabinet_card_frame
		}
		blockoverride "common_header_icon" {
			block "parliament_card_header_icon" {
				header_action_button_left = {
					size = { 30 30}
					blockoverride "header_button_icon_size" { size = { 30 30 } }
					blockoverride "header_button_frame_inner" {visible = no}
					blockoverride "icon_overlay" {}
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/international_organizations/law_voting_yes.dds"
					}
					blockoverride "header_button_text_layout" {}
					title = "VOTE_IO_PARLIAMENT"
					description = "vote_in_organization_parliament_desc"
					actor = "[InternationalOrganizationsView.GetPlayer]"
					parameter = {
						parameter_name = "recipient"
						parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
					}
					parameter = {
						parameter_name = "vote"
						parameter_value_bool = yes
					}
					left_action = { action_name = "vote_in_organization_parliament" }
					tooltipwidget = {
						using = io_parliament_vote_button_tooltip
					}
				}
			}
		}
		blockoverride "common_header_text_full" {
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				block "parliament_card_header" {
					text_single = {
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetOppositionCountriesCount]"
						default_format = "#color_red"
						fontsize = 14
					}
					text_single = {
						raw_text = "[Localize('IO_PARLIAMENT_VOTED')] [Localize('NO')]:"
						fontsize = 14
					}
					expand = {}
					text_single = {
						text = "[InternationalOrganizationsView.GetOppositionCountriesVoteStrength|0]"
						default_format = "#color_red"
						tagtooltip_enabled = yes
						fontsize = 14
						tooltip = "[special_status_power|e]"
					}
				}
			}
		}
		blockoverride "card_common_bottom_margin" { 
			minimumsize = { -1 270 }
			margin = {2 5}
		}
		blockoverride "common_bottom_content" {
			scrollarea = {
				layoutpolicy_horizontal = expanding
				minimumsize = {-1 235}
				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}
				scrollwidget = {
					vbox = {
						layoutpolicy_horizontal = expanding
						fixedgridbox = {
							addcolumn = 100%
							addrow = 32
							flipdirection = yes
							datamodel_wrap = 1
							block "parliament_card_list_datamodel" {
								datamodel = "[InternationalOrganizationsView.GetParliamentOppositionCountriesWithPlayerFirst]"
							}
							item = {
								block "io_parliament_vote_card_row_extra" {
									using = io_parliament_vote_card_row
								}
							}
						}
						expand = {}
					}
				}
			}
		}
	}
	type hre_member_type_icon = widget {
		size = { 33 33 }
		allow_outside = yes
		visible = "[Country.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization)]"
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						using = tooltip_title_icon_size
						texture = "[InternationalOrganizationsView.GetMemberIconForCountry(Country.Self)]"
					}
				}
				blockoverride "title_text" {
					text = "[InternationalOrganizationsView.GetMemberTypeNameForCountry(Country.Self)]"
				}
				blockoverride "concept_link" {
					text = "[international_organization|e]"
				}
				blockoverride "tooltip_content" {
					TooltipStringPairList = {
						visible = "[Not(StringIsEmpty(InternationalOrganizationsView.GetMemberTypeEffectsForCountry(Country.Self)))]"
						textcontext = "[InternationalOrganizationsView.GetMemberTypeEffectsForCountry(Country.Self)]"
					}
					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "[InternationalOrganizationsView.GetMemberTypeDescForCountry(Country.Self)]"
						}
					}
				}
			}
		}
		
		block "hre_member_type_icon_bg" {
			icon = {
				size = { 230% 230% }
				parentanchor = center
				position = {0 -2}
				texture = "gfx/interface/component_decoration/ios/hre/top_frame_decoration_circle_gold.dds"

			}
		}
			
		icon = {
			size = { 100% 100% }
			texture = "[InternationalOrganizationsView.GetMemberIconForCountry(Country.Self)]"
		}
			
	}
}