organization_panel = {

	blockoverride "organization_panel_members_area" {
		vbox = {
			using = layoutpolicy_expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				margin = { 10 0 }
				# ask to join
				header_action_button_left = {
					layoutpolicy_horizontal = expanding
					size = { -1 30 }
					blockoverride "button_icon_stretch_sprite" {}
					blockoverride "header_button_frame_inner" {visible = no}
					blockoverride "header_button_icon_size" { size = { 30 30 } }
					blockoverride "header_button_text_layout" {
						text_single = {
							fontsize = 15
							text = "ASK_FOR_IO_MEMBERSHIP"
						}
						expand = {}
					}
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/international_organizations/ask_to_join.dds"
					}
					blockoverride "icon_overlay" {}
					title = "INT_ORG_MEMBERSHIP_TITLE"
					actor = "[InternationalOrganizationsView.GetPlayer]"
					parameter = {
						parameter_name = "recipient"
						parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
					}
					left_click_and_hold_action = {
						action_name = "ask_to_join_international_organization"
						action_direction = "request"
						parameter = {
							parameter_name = "international_organization"
							parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
						}
					}
					tooltipwidget = {
						using = io_join_button_tooltip
					}
				}
				
				# invite people
				header_action_button_left = {
					layoutpolicy_horizontal = expanding
					size = { -1 30 }
					blockoverride "button_icon_stretch_sprite" {}
					blockoverride "header_button_frame_inner" {visible = no}
					blockoverride "header_button_icon_size" { size = { 30 30 } }
					blockoverride "header_button_text_layout" {
						text_single = {
							fontsize = 15
							text = "INVITE_FOR_IO_MEMBERSHIP"
						}
						expand = {}
					}
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/international_organizations/invite_people.dds"
					}
					blockoverride "icon_overlay" {}
					title = "INT_ORG_MEMBERSHIP_TITLE"
					actor = "[InternationalOrganizationsView.GetPlayer]"
					visible = "[UIAction.IsVisible]"
					left_action = {
						action_name = "invite_to_international_organization"
						action_direction = "offer"
						parameter = {
							parameter_name = "international_organization"
							parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
						}
					}
					tooltipwidget = {
						using = io_invite_button_tooltip
					}
				}
				# leave
				header_action_button_left = {
					layoutpolicy_horizontal = expanding
					size = { -1 30 }
					blockoverride "button_icon_stretch_sprite" {}
					blockoverride "header_button_frame_inner" {visible = no}
					blockoverride "header_button_icon_size" { size = { 30 30 } }
					blockoverride "header_button_text_layout" {
						text_single = {
							fontsize = 15
							text = "LEAVE_IO_MEMBERSHIP"
						}
						expand = {}
					}
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/international_organizations/leave.dds"
					}
					blockoverride "icon_overlay" {}
					title = "INT_ORG_MEMBERSHIP_TITLE"
					actor = "[InternationalOrganizationsView.GetPlayer]"
					left_click_and_hold_action = {
						action_name = "leave_international_organization"
						action_direction = "offer"
						parameter = {
							parameter_name = "recipient"
							parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
						}
					}
					tooltipwidget = {
						using = io_leave_button_tooltip
					}
				}
			}

			filtered_sorted_list = {
				datacontext = "[InternationalOrganizationsView.GetMembersSortSearch]"
				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(InternationalOrganizationsView.GetMemberItems)]"
				}

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "name"
						layoutpolicy_vertical = expanding
						size = { 180 -1 }
					}
					sort_by_key_button = {
						name = "gp"
						layoutpolicy_vertical = expanding
						size = { 40 -1 }
					}
					sort_by_key_button = {
						name = "opinion"
						layoutpolicy_vertical = expanding
						size = { 100 -1 }
					}
					sort_by_key_button = {
						name = "tax_base"
						layoutpolicy_vertical = expanding
						size = { 92 -1 }
					}
					sort_by_key_button = {
						name = "experience"
						layoutpolicy_vertical = expanding
						size = { 110 -1 }
					}
					expand = {}
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MEMBERS_SCROLL_LIST_EMPTY"
				}

				blockoverride "searchbar_top_extra" {
					header_button_right = {
						visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'gag_members_view_toggle' ))]"
						size = { 30 30 }
						blockoverride "button_icon_stretch_sprite" {}
						blockoverride "header_button_frame_inner" { visible = no }
						blockoverride "header_button_icon_size" { size = { 30 30 } }
						blockoverride "header_button_text_layout" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/flat_icons/menu_icon_square.dds"
							texture_density = 2
						}
						action_tooltip = {
							title = "HRE_MEMBERS_VIEW_FLAGS"
							on_action = "[InternationalOrganizationsView.Vars.Toggle( 'gag_members_view_toggle' )]"
						}
						tooltipwidget = { BasicFunctionalTooltip = {} }
					}
					header_button_right = {
						visible = "[InternationalOrganizationsView.Vars.Exists( 'gag_members_view_toggle' )]"
						size = { 30 30 }
						blockoverride "button_icon_stretch_sprite" {}
						blockoverride "header_button_frame_inner" { visible = no }
						blockoverride "header_button_icon_size" { size = { 30 30 } }
						blockoverride "header_button_text_layout" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/flat_icons/menu_icon.dds"
							texture_density = 2
						}
						action_tooltip = {
							title = "HRE_MEMBERS_VIEW_LIST"
							on_action = "[InternationalOrganizationsView.Vars.Toggle( 'gag_members_view_toggle' )]"
						}
						tooltipwidget = { BasicFunctionalTooltip = {} }
					}
				}

				blockoverride "scroll_list_layout" {
					vbox = {
						using = layoutpolicy_expanding
						using = bg_secondary_inner_alt
						margin_bottom = 20

						vbox = {
							visible = "[InternationalOrganizationsView.Vars.Exists( 'gag_members_view_toggle' )]"
							layoutpolicy_horizontal = expanding
							datamodel = "[InternationalOrganizationsView.GetMemberItems]"
							item = {
								block "organization_members_list_item" {
									vbox = {
										layoutpolicy_horizontal = expanding
										spacing = 10
										using = members_entry
										visible = "[Not(IsDataModelEmpty(MemberTypeItem.GetCountries))]"
									}
								}
							}
						}

						vbox = {
							visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'gag_members_view_toggle' ))]"
							layoutpolicy_horizontal = expanding
							datamodel = "[InternationalOrganizationsView.GetMemberItems]"
							item = {
								vbox = {
									visible = "[Not(IsDataModelEmpty(MemberTypeItem.GetCountries))]"
									layoutpolicy_horizontal = expanding

									fixedgridbox = {
										addcolumn = 98%
										addrow = 40
										maxhorizontalslots = 1
										datamodel = "[MemberTypeItem.GetCountries]"
										item = {
											widget = {
												size = { 100% 35 }
												io_member_country_row = {
													blockoverride "io_member_country_row_rank" {}
													blockoverride "io_member_country_row_opinion_text_size" {
														minimumsize = { 65 -1 }
														maximumsize = { 65 -1 }
														align = center|nobaseline
													}
													blockoverride "io_member_country_row_opinion_icon_size" {
														size = { 22 22 }
													}
													blockoverride "io_parliament_vote_member" {}
													blockoverride "io_member_country_row_culture_religion" {}
													blockoverride "io_progress_text" {
														divider_flavor_01 = { size = {8 -1} }
														text_single = {
															minimumsize = { 80 -1 }
															maximumsize = { 80 -1 }
															align = center|nobaseline
															text = "[Country.GetMonthlyCountryGhibellinesProgress|+=3%]"
															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_MONTHLY_TT_TITLE" }
																	blockoverride "title_icon_texture" {
																		texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
																	}
																	blockoverride "tooltip_content" {
																		TooltipTextBlock = {
																			blockoverride "text" {
																				text = "GAG_COUNTRY_PROGRESS_MONTHLY_TT"
																			}
																		}
																	}
																}
															}
														}

														divider_flavor_01 = { size = {8 -1} }
														text_single = {
															minimumsize = { 45 -1 }
															maximumsize = { 45 -1 }
															align = right|nobaseline
															text = "[Country.GetCountryGhibellinesProgress|V3%]"
															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_TT_TITLE" }
																	blockoverride "title_icon_texture" {
																		texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
																	}
																	blockoverride "tooltip_content" {
																		TooltipTextBlock = {
																			blockoverride "text" {
																				text = "GAG_COUNTRY_PROGRESS_TT"
																			}
																		}
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}

						expand = {}
					}
				}
			}
		}
	}
}
