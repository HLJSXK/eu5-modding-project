			#		texture_density = 2
			#	}
#
			#	visible = "[PdxGuiWidget.IsUberButtonVisible]"
			#	enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
#
			#	tooltipmeta = {
			#		title = "found_religious_order"
			#		texture = "gfx/interface/icons/religious_orders/types/_default.dds"
			#	}
#
			#	scripted_action_tooltip = {
			#		click_type = left
			#		click_mode = confirm
			#		action_name = "found_religious_order"
			#		actor = "[GetPlayer]"
			#	}
			#}

			subheader_unified_icon = {
				visible = "[GetPlayer.GetReligion.HasReligiousOrders]"
				datacontext = "[CountryReligionLateralView.GetReligion]"
				tooltipwidget = { using = religious_influence_tooltip }
				blockoverride "subheader_unified_icon_texture" {
					texture = "gfx/interface/icons/religious_aspects/church_power.dds"
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.3
					}
				}
				blockoverride "subheader_unified_top_text" {
					text = "[Religion.GetReligiousInfluenceName]"
					align = nobaseline
				}
				blockoverride "subheader_unified_bottom_text" {
					raw_text = "[GetPlayer.GetShortCurrencyValue('religious_influence')]"
					align = nobaseline
				}
			}

			expand = {}

			hbox = {
				spacing = 3
				visible = "[GetPlayer.GetReligion.HasReligiousOrders]"
				datacontext = "[CountryReligionLateralView.GetReligiousOrdersSortSearch.GetSearchBar]"

				button_regular_icon = {
					size = { 40 32 }
					down = "[SearchBar.IsFilterEnabledByKey('religious_order_present_in_country')]"
					glow = {
						visible = "[SearchBar.IsFilterEnabledByKey('religious_order_present_in_country')]"
						glow_radius = 3
						color = { 1.0 0.85 0.55 1.0 }
						alpha = 0.6
					}
					blockoverride "button_icon_obj" {
						country_flag_very_small = {
							datacontext = "[GetPlayer]"
							blockoverride "show_as_button" { visible = no }
							blockoverride "show_as_icon" { visible = yes }
							blockoverride "tooltip" {}
							blockoverride "contextmenu" {}
							blockoverride "click" {}
							blockoverride "double_click" {}
						}
					}
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "CUSTOM_SEARCH_FILTER_RELIGIOUS_ORDER_PRESENT_IN_COUNTRY_NAME"
						description = "CUSTOM_SEARCH_FILTER_RELIGIOUS_ORDER_PRESENT_IN_COUNTRY_DESC"
						on_action = "[SearchBar.ToggleFilterByKey('religious_order_present_in_country')]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }
				}

				hbox = {
					spacing = 3
					datamodel = "[GetReligiousOrderTypes]"
					item = {
						button_regular_icon = {
							size = { 40 32 }
							down = "[SearchBar.IsFilterEnabledByKey(ReligiousOrderType.GetKey)]"
							blockoverride "button_icon_obj" {
								icon = {
									size = { 22 22 }
									texture = "[ReligiousOrderType.GetIcon]"
								}
							}
							action_tooltip = {
								click_type = left
								click_mode = single
								title = "[ReligiousOrderType.GetName]"
								on_action = "[SearchBar.ToggleFilterByKeyForceExclusive(ReligiousOrderType.GetKey)]"
							}
							tooltipwidget = { using = ReligiousOrderType_tooltip }
						}
					}
				}
			}

			expand = {}

			subheader_unified_icon = {
				visible = "[GetPlayer.GetReligion.HasReligiousOrders]"
				blockoverride "mirror_layout" { righttoleft = yes }
				tooltipwidget = { using = OrderHoldingsCounter_tooltip }
				blockoverride "subheader_unified_icon_texture" {
					texture = "gfx/interface/icons/religious_orders/holdings.dds"
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.3
					}
				}
				blockoverride "subheader_unified_top_text" {
					text = "religious_order_holdings_label"
					align = nobaseline
				}
				blockoverride "subheader_unified_bottom_text" {
					text = "[GetPlayer.GetNumOrderHoldings]"
					align = nobaseline
				}
			}
		}

		filtered_sorted_list = {
			datacontext = "[CountryReligionLateralView.GetReligiousOrdersSortSearch]"

			blockoverride "extra_searchbar_content" {}

			blockoverride "scroll_list_is_empty" {
				visible = "[IsDataModelEmpty(CountryReligionLateralView.GetReligiousOrders)]"
			}

			blockoverride "scroll_list_is_empty_text" {
				text = "[SelectLocalization(CountryReligionLateralView.GetReligion.HasReligiousOrders, 'RELIGIOUS_ORDERS_LIST_NONE_MATCH_FILTERS', 'RELIGIOUS_ORDERS_LIST_EMPTY')]"
			}

			blockoverride "scroll_list_layout" {
				vbox = {
					layoutpolicy_horizontal = expanding

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 12

						datamodel = "[CountryReligionLateralView.GetReligiousOrders]"
						item = {
							religious_order_card = {}
						}
					}

					expand = {}
				}
			}
		}
	}
}
