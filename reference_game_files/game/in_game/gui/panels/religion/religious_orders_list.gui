template ReligiousOrderHoldings_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "RELIGIOUS_ORDER_HOLDINGS_IN"
		}
		blockoverride "tooltip_content" {
			TooltipScrolledRowList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 320 }}
				textcontext = "[ReligiousOrderPresenceRow.GetLocationsTooltip]"
				ontextcontextchanged = "[SetRowListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}
		}
	}
}

template OrderHoldingsCounter_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "ORDER_HOLDINGS_IN_COUNTRY_TOOLTIP_TITLE"
		}
		blockoverride "concept_link" {
			text = [holdings|e]
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/religious_orders/holdings.dds"
			}
		}
		blockoverride "tooltip_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					maximumsize = { 360 -1 }
					text = "ORDER_HOLDINGS_COUNTER_TOOLTIP_INTRO"
				}
			}
		}
	}
}

template ReligiousOrderStanding_tooltip {
	ContextualTooltipType = {
		datacontext = "[ReligiousOrder.GetPlayerCountryEffectsCountry]"
		blockoverride "title_text" {
			text = "RELIGIOUS_ORDER_STANDING_TOOLTIP_TITLE"
		}
		blockoverride "concept_link" {
			text = [religious_order_standing|e]
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/religious_orders/power.dds"
			}
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[ReligiousOrder.GetPlayerStandingBreakdown]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerCountryModifierText]"
				margin_top = 6
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_STANDING_EFFECTS_HEADER" }
				textcontext = "[ReligiousOrder.GetPlayerCountryModifierText]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerLowZealCountryModifierText]"
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_CALLING_LOW_ZEAL_HEADER" }
				textcontext = "[ReligiousOrder.GetPlayerLowZealCountryModifierText]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}
		}
	}
}

types ReligionOverview {

	type religious_order_actions_menu = ContextMenuBase {
		blockoverride "contextmenu_content" {
			ContextMenuSection = {
				blockoverride "title_icon" {
					icon = {
						size = { 24 24 }
						texture = "[ReligiousOrder.GetIcon]"
					}
				}
				blockoverride "title_text" {
					raw_text = "[ReligiousOrder.GetNameWithNoTooltip]"
				}
				blockoverride "contextmenu_entries" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2
						ignoreinvisible = yes
						datamodel = "[GetReligiousOrderActions]"
						item = {
							targetted_button_regular = {
								visible = "[IsReligiousOrderActionVisible(GenericAction.Self, ReligiousOrder.Self)]"
								enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
								layoutpolicy_horizontal = expanding
								size = { -1 30 }

								action_tooltip = {
									click_type = left
									click_mode = single
									title = "[GenericAction.GetNameWithNoTooltip]"
									enabled = "[IsReligiousOrderActionEnabled(GenericAction.Self, ReligiousOrder.Self)]"
									cost = "[GetReligiousOrderActionCost(GenericAction.Self, ReligiousOrder.Self)]"
									on_action = "[PerformReligiousOrderAction(GenericAction.Self, ReligiousOrder.Self)]"
									on_action = "[ExtraTooltipInfo.CloseContextMenu]"
								}
								blockoverride "tooltip" {
									tooltipwidget = {
										ContextualTooltipType = {
											blockoverride "title_text" { text = "[GenericAction.GetNameWithNoTooltip]" }
											blockoverride "title_icon" {
												icon = {
													texture = "[GenericAction.GetIcon]"
													using = tooltip_title_icon_size
												}
											}
											blockoverride "tooltip_content" {
												TooltipFlavorTextBlock = {
													blockoverride "text" { text = "[GetReligiousOrderActionDesc(GenericAction.Self, ReligiousOrder.Self)]" }
												}
												TooltipConditionList = {
													datacontext = "[StringToConditionListOnlyPassedAndNeutral(GetReligiousOrderActionEffects(GenericAction.Self, ReligiousOrder.Self))]"
													blockoverride "block_title" { text = "game_concept_effects" }
													visible = "[ConditionList.HasItems]"
												}
												TooltipScrolledRequirementsList = {
													datacontext = "[StringToRequirementsList(GetReligiousOrderActionConditions(GenericAction.Self, ReligiousOrder.Self))]"
													blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
													blockoverride "block_title" { text = "game_concept_conditions" }
													visible = "[DataModelHasItems(RequirementsList.GetLines)]"
												}
											}
											blockoverride "tooltip_ui_action_block" {
												TooltipUIActionBlock = {
													visible = "[ExtraTooltipInfo.HasUIAction]"
													datacontext = "[ExtraTooltipInfo.GetUIAction]"
												}
											}
										}
									}
								}
								hbox = {
									parentanchor = vcenter
									layoutpolicy_horizontal = expanding
									margin = { 10 0 }
									spacing = 8
									icon = {
										size = { 22 22 }
										texture = "[GenericAction.GetIcon]"
										texture_density = 2
									}
									text_single = {
										layoutpolicy_horizontal = expanding
										align = left|nobaseline
										using = Font_Size_Small
										default_format = "#yellow_titles"
										text = "[GenericAction.GetNameWithNoTooltip]"
									}
									text_single = {
										align = right|nobaseline
										using = Font_Size_Very_Small
										default_format = "#color_white"
										raw_text = "[GetReligiousOrderActionCost(GenericAction.Self, ReligiousOrder.Self)]"
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type religious_order_card = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 2
		margin = { 5 3 }

		background = {
			using = paper_card_texture
			margin = { 1 1 }
			margin_bottom = 2
			alpha = 0.4
			visible = "[ReligiousOrder.HasPlayerPresence]"
		}
		background = {
			using = paper_card_texture
			margin = { 1 1 }
			margin_bottom = 2
			alpha = 0.4
			visible = "[Not(ReligiousOrder.HasPlayerPresence)]"
			shaderfile = "gfx/FX/pdxgui_grayscale.shader"
			effectname = "PdxGuiGrayscale"
		}
		background = {
			using = paper_card_texture
			modify_texture = {
				using = color_paper_texture
			}
			modify_texture = {
				using = overlay_paper_03
			}
			visible = "[ReligiousOrder.HasPlayerPresence]"
		}
		background = {
			using = paper_card_texture
			modify_texture = {
				using = color_paper_texture
			}
			modify_texture = {
				using = overlay_paper_03
			}
			visible = "[Not(ReligiousOrder.HasPlayerPresence)]"
			shaderfile = "gfx/FX/pdxgui_grayscale.shader"
			effectname = "PdxGuiGrayscale"
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 84 }

			hbox = {
				layoutpolicy_horizontal = expanding

				icon = {
					ignore_layout = yes
					allow_outside = yes
					parentanchor = right|top
					position = { -70 1 }
					size = { 90 36 }
					texture_density = 2
					texture = "gfx/interface/component_decoration/religious_orders/gold_decoration.dds"
					alwaystransparent = yes
				}

				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					tooltipwidget = { using = ReligiousOrder_tooltip }

					hbox = {
						parentanchor = center
						using = layoutpolicy_expanding
						alwaystransparent = yes

						vbox = {
							using = layoutpolicy_expanding
							margin_right = 72

							hbox = {
								using = layoutpolicy_expanding
								background = {
									texture = "gfx/interface/cards/religious_orders/marble_bg.dds"
									texture_density = 2
									margin_right = 130
								}
								margin_left = 5
								spacing = 6

								icon = {
									size = { 46 46 }
									texture = "[ReligiousOrder.GetIcon]"
									texture_density = 2
									alwaystransparent = no
									onmousehierarchyenter = "[ReligiousOrder.HighlightOnMap(PdxGuiWidget.AccessSelf)]"
									tooltipwidget = { using = ReligiousOrder_tooltip }
								}


								background = {
									texture = "gfx/interface/component_tiles/religious_orders/gold_frame.dds"
									texture_density = 2
									spritetype = corneredstretched
									spriteBorder = { 30 30 }
									margin_right = 130
									margin_left = 5
									margin_top = 6
									margin_bottom = 5
									visible = "[ReligiousOrder.HasPlayerPresence]"
								}
								background = {
									texture = "gfx/interface/component_tiles/religious_orders/gold_frame.dds"
									texture_density = 2
									spritetype = corneredstretched
									spriteBorder = { 30 30 }
									margin_right = 130
									margin_left = 5
									margin_top = 6
									margin_bottom = 5
									visible = "[Not(ReligiousOrder.HasPlayerPresence)]"
									shaderfile = "gfx/FX/pdxgui_grayscale.shader"
									effectname = "PdxGuiGrayscale"
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									margin_right = 130
									spacing = 1

									text_single = {
										layoutpolicy_horizontal = expanding
										size = { -1 24 }
										autoresize = no
										align = left|nobaseline
										using = Font_Size_Medium
										text = "[ReligiousOrder.GetName]"
										default_format = "#yellow_titles"
									}

									text_single = {
										layoutpolicy_horizontal = expanding
										size = { -1 20 }
										autoresize = no
										align = left|nobaseline
										using = Font_Size_Small
										datacontext = "[ReligiousOrder.GetType]"
										text = "[ReligiousOrderType.GetName]"
										default_format = "#high"
										tooltipwidget = { using = ReligiousOrderType_tooltip }
									}
								}

								header_action_button_left_uber = {
									ignore_layout = yes
									parentanchor = right|vcenter
									position = { -4 0 }
									size = { 40 40 }
									alwaystransparent = no

									blockoverride "header_button_icon_size" { size = { 40 40 } }
									blockoverride "icon_size" { size = { 80% 80% } }
									blockoverride "icon_overlay" {}
									blockoverride "icon_texture" {
										texture = "gfx/interface/icons/generic_actions/_default.dds"
									}
									blockoverride "header_button_frame_inner" { visible = no }
									blockoverride "header_button_template_minimumsize" { minimumsize = { -1 40 } }

									action_tooltip = {
										click_type = left
										click_mode = single
										title = "RELIGIOUS_ORDER_ACTIONS_BUTTON"
										description = "RELIGIOUS_ORDER_ACTIONS_BUTTON_DESC"
										on_action = "[PdxGuiWidget.ToggleContextMenu]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
									contextmenu_widget = {
										religious_order_actions_menu = {}
									}
								}
							}

							hbox = {
								using = layoutpolicy_expanding
								margin_left = 6
								margin_right = 6
								margin_top = 5
								spacing = 2
								ignoreinvisible = yes

								piechart = {
									size = { 32 32 }
									using = piechart_angles
									using = bg_circle_piechart
									pieslice = {
										texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
										value = "[ReligiousOrder.GetZeal]"
										color = { 0.85 0.65 0.2 1 }
									}
									pieslice = {
										texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
										value = "[Subtract_float('(float)100.0', FixedPointToFloat(ReligiousOrder.GetZeal))]"
										using = color_value_progress_gray
									}
									icon = {
										parentanchor = center
										size = { 18 18 }
										texture = "gfx/interface/icons/religious_orders/zeal.dds"
									}
									tooltipwidget = { using = ReligiousOrderZeal_tooltip }
								}
								divider_flavor_03 = { size = { 8 -1 } }
								hbox = {
									spacing = 2
									onmousehierarchyenter = "[ReligiousOrder.HighlightOnMap(PdxGuiWidget.AccessSelf)]"
									tooltipwidget = { using = ReligiousOrderLocations_tooltip }
									icon = {
										size = { 22 22 }
										texture = "gfx/interface/icons/religious_orders/holdings.dds"
										onmousehierarchyenter = "[ReligiousOrder.HighlightOnMap(PdxGuiWidget.AccessSelf)]"
										tooltipwidget = { using = ReligiousOrderLocations_tooltip }
									}
									text_single = {
										autoresize = yes
										align = left|nobaseline
										using = Font_Size_Small
										text = "[ReligiousOrder.GetNumLocations]"
										default_format = "#high"
										onmousehierarchyenter = "[ReligiousOrder.HighlightOnMap(PdxGuiWidget.AccessSelf)]"
										tooltipwidget = { using = ReligiousOrderLocations_tooltip }
									}
									text_single = {
										autoresize = yes
										align = left|nobaseline
										using = Font_Size_Small
										visible = "[ReligiousOrder.HasPlayerPresence]"
										raw_text = "([ReligiousOrder.GetPlayerHoldingShare|0]%)"
										default_format = "#high"
										onmousehierarchyenter = "[ReligiousOrder.HighlightOnMap(PdxGuiWidget.AccessSelf)]"
										tooltipwidget = { using = ReligiousOrderLocations_tooltip }
									}
								}
								divider_flavor_03 = { size = { 8 -1 } }
								hbox = {
									spacing = 2
									icon = {
										size = { 22 22 }
										datacontext = "[ReligiousOrder.GetCalling]"
										texture = "[Calling.GetIcon]"
										tooltipwidget = { using = Calling_tooltip }
									}
									text_single = {
										autoresize = yes
										maximumsize = { 85 28 }
										align = left|nobaseline
										using = Font_Size_Small
										datacontext = "[ReligiousOrder.GetCalling]"
										text = "[Calling.GetName]"
										default_format = "#low"
										tooltipwidget = { using = Calling_tooltip }
									}
								}
								divider_flavor_03 = {
									size = { 8 -1 }
									visible = "[ReligiousOrder.HasMultiplePlayerHoldings]"
								}
								hbox = {
									spacing = 2
									visible = "[ReligiousOrder.HasMultiplePlayerHoldings]"
									tooltipwidget = { using = ReligiousOrderStanding_tooltip }
									icon = {
										size = { 20 20 }
										texture = "gfx/interface/icons/religious_orders/power.dds"
									}
									text_single = {
										autoresize = yes
										align = left|nobaseline
										using = Font_Size_Small
										raw_text = "[ReligiousOrder.GetPlayerStanding|0]%"
										default_format = "#high"
									}
								}
							}
						}

						character_frame_small = {
							ignore_layout = yes
							parentanchor = right|vcenter
							position = { -1 0 }
							size = { 70 80 }
							allow_outside = yes
							visible = "[ReligiousOrder.HasHeadCharacter]"
							tooltipwidget = { using = Character_tooltip }
							blockoverride "portrait_datacontext" {
								datacontext = "[ReligiousOrder.GetHeadCharacterRef]"
							}
							blockoverride "portrait_size" { size = { 85% 90% } }
							blockoverride "estate_icon" { visible = no }
							blockoverride "religious_order_icon" { visible = no }
							blockoverride "dynasty_shield" {}
							blockoverride "character_frame_estate_visible" { visible = no }
							blockoverride "character_portrait_visible" { visible = yes }
							blockoverride "character_portrait_ani_visible" { visible = no }
						}
					}
				}

			}
		}
	}

	type religious_orders_list = vbox {
		margin = { 2 5 }

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 2 2 }
			margin_bottom = 4
			spacing = 6
			minimumsize = { -1 45 }

			#header_action_button_left_uber = {
			#	datacontext = "[GetGenericAction('found_religious_order')]"
			#	tooltipwidget = { using = generic_action_tooltip }
