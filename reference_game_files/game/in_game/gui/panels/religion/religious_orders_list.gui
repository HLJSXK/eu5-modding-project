# Tooltip templates — defined at file scope (not inside `types ReligionOverview`)
# so the cooltip.gui `container = { name = "X" using = Y_tooltip }` lookup can
# resolve them globally.  Mirrors how Cardinal_tooltip lives in shared/io_tooltips.gui.

template ReligiousOrder_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[ReligiousOrder.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[ReligiousOrder.GetIcon]"
			}
		}

		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[ReligiousOrder.GetDebugText]"
				}
			}

			TooltipListBase = {
				TooltipListRowContent = {
					TooltipManualTableField = {
						datacontext = "[ReligiousOrder.GetReligionRef]"
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								tagtooltip_enabled = yes
								text = "[religion|E]"
							}
							icon = {
								size = { 24 24 }
								texture = "[GetReligionIcon(Religion.Self)]"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								tagtooltip_enabled = yes
								default_format = "#subtle_name"
								raw_text = "[Religion.GetName]"
							}
						}
					}

					TooltipManualTableField = {
						datacontext = "[ReligiousOrder.GetType]"
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								tagtooltip_enabled = yes
								text = "[religious_order|E]"
							}
							icon = {
								size = { 24 24 }
								texture = "[ReligiousOrderType.GetIcon]"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								tagtooltip_enabled = yes
								default_format = "#subtle_name"
								raw_text = "[ReligiousOrderType.GetName]"
							}
						}
					}

					TooltipManualTableField = {
						datacontext = "[ReligiousOrder.GetCalling]"
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								tagtooltip_enabled = yes
								text = "[calling|E]"
							}
							icon = {
								size = { 24 24 }
								texture = "[Calling.GetIcon]"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								tagtooltip_enabled = yes
								default_format = "#subtle_name"
								raw_text = "[Calling.GetName]"
							}
						}
					}

					TooltipManualTableField = {
						tooltipwidget = { using = ReligiousOrderZeal_tooltip }
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								tagtooltip_enabled = yes
								text = "[zeal|E]"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								raw_text = "[ReligiousOrder.GetZeal|0]%"
							}
						}
					}

					TooltipManualTableField = {
						tooltipwidget = { using = ReligiousOrderLocations_tooltip }
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								tagtooltip_enabled = yes
								text = "[holdings|E]"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								default_format = "#high"
								raw_text = "[ReligiousOrder.GetNumLocations]"
							}
						}
					}

					TooltipManualTableField = {
						visible = "[ReligiousOrder.HasHeadCharacter]"
						datacontext = "[ReligiousOrder.GetHeadCharacterRef]"
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								text = "RELIGIOUS_ORDER_TOOLTIP_HEAD"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								tagtooltip_enabled = yes
								default_format = "#subtle_name"
								raw_text = "[Character.GetNameToFit('(int32)20', '(bool)no')]"
							}
						}
					}

					TooltipManualTableField = {
						visible = "[ReligiousOrder.HasMembers]"
						tooltipwidget = { using = ReligiousOrderMembers_tooltip }
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = left|nobaseline
								text = "RELIGIOUS_ORDER_TOOLTIP_CHARACTERS"
							}
							text_single = {
								autoresize = yes
								align = right|nobaseline
								default_format = "#high"
								raw_text = "[ReligiousOrder.GetNumMembers]"
							}
						}
					}
				}
			}

			TooltipListBase = {
				visible = "[ReligiousOrder.GetPresenceTable.HasRows]"
				datacontext = "[ReligiousOrder.GetPresenceTable]"
				margin_top = 6
				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 400 }
					}
					blockoverride "section_content" {
						TooltipListColumnContent = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding

							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_text" { text = "RELIGIOUS_ORDER_TABLE_COUNTRY" }
								blockoverride "column_title_right" { expand = {} }
								blockoverride "field_background" {
									background = {
										visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
										using = tooltip_table_field_texture
									}
									background = {
										visible = "[ReligiousOrderPresenceRow.IsPlayerCountry]"
										using = color_gold_texture
										alpha = 0.2
									}
								}
								blockoverride "field_text" { raw_text = "[ReligiousOrderPresenceRow.GetCountryName]" }
								blockoverride "field_right" { expand = {} }
								blockoverride "column_datamodel" { datamodel = "[ReligiousOrderPresenceTable.GetRows]" }
							}

							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_text" { text = "RELIGIOUS_ORDER_TABLE_HOLDINGS" }
								blockoverride "column_title_left" { expand = {} }
								blockoverride "field_left" { expand = {} }
								blockoverride "field_background" {
									background = {
										visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
										using = tooltip_table_field_texture
									}
									background = {
										visible = "[ReligiousOrderPresenceRow.IsPlayerCountry]"
										using = color_gold_texture
										alpha = 0.2
									}
								}
								blockoverride "field_text" {
									default_format = "#high"
									raw_text = "[ReligiousOrderPresenceRow.GetNumLocations]"
									tooltipwidget = { using = ReligiousOrderHoldings_tooltip }
								}
								blockoverride "column_datamodel" { datamodel = "[ReligiousOrderPresenceTable.GetRows]" }
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerCountryEffects]"
				datacontext = "[ReligiousOrder.GetPlayerCountryEffectsCountry]"
				margin_top = 6
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_COUNTRY_EFFECTS_TITLE" }
				textcontext = "[ReligiousOrder.GetPlayerCountryEffects]"
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerPresence]"
				margin_top = 6
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_PROJECTION_TITLE" }
				textcontext = "[ReligiousOrder.GetPlayerProjectionBreakdown]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerCountryModifierText]"
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_CALLING_ZEAL_HEADER" }
				textcontext = "[ReligiousOrder.GetPlayerCountryModifierText]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerLowZealCountryModifierText]"
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_CALLING_LOW_ZEAL_HEADER" }
				textcontext = "[ReligiousOrder.GetPlayerLowZealCountryModifierText]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			vbox = {
				visible = "[ReligiousOrder.HasDescription]"
				layoutpolicy_horizontal = expanding
				margin_top = 6
				TooltipTextBlock = {
					blockoverride "text" {
						text = "RELIGIOUS_ORDER_TOOLTIP_DESC"
					}
				}
			}
		}
	}
}

template ReligiousOrderHolding_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "ORDER_HOLDING_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[ReligiousOrder.GetIcon]"
			}
		}
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[ReligiousOrder.GetDebugText]"
				}
			}

			TooltipStringPairList = {
				textcontext = "ORDER_HOLDING_ORDER"
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasHoldingLocationModifier]"
				blockoverride "block_title" { text = "ORDER_HOLDING_MODIFIER_TITLE" }
				textcontext = "[ReligiousOrder.GetHoldingLocationModifierText]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipScrolledStringPairList = {
				visible = "[ReligiousOrder.HasHoldingGoodsDemand]"
				blockoverride "block_scrollarea" { maximumsize = { -1 200 } }
				blockoverride "block_title" { text = "ORDER_HOLDING_DEMAND_TITLE" }
				textcontext = "[ReligiousOrder.GetHoldingGoodsDemandText]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}
		}
	}
}

template ReligiousOrderType_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[ReligiousOrderType.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[ReligiousOrderType.GetIcon]"
			}
		}
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[ReligiousOrderType.GetDebugText]"
				}
			}

			TooltipListBase = {
				visible = "[ReligiousOrderType.GetActiveOrders.HasOrders]"
				datacontext = "[ReligiousOrderType.GetActiveOrders]"
				blockoverride "block_title" {
					text = "RELIGIOUS_ORDER_TYPE_ACTIVE_ORDERS_TITLE"
				}
				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" { maximumsize = { -1 240 } }
					blockoverride "section_content" {
						TooltipListColumnContent = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							TooltipTableColumn = {
								blockoverride "field_left" {
									icon = {
										size = { 20 20 }
										texture = "[ReligiousOrder.GetIcon]"
									}
								}
								blockoverride "field_text" {
									tagtooltip_enabled = yes
									raw_text = "[ReligiousOrder.GetName]"
								}
								blockoverride "field_right" { expand = {} }
								blockoverride "column_datamodel" { datamodel = "[ReligiousOrderTypeOrders.GetOrders]" }
							}
						}
					}
				}
			}

			TooltipListBase = {
				visible = "[ReligiousOrderType.HasValidCallings]"
				blockoverride "block_title" {
					text = "RELIGIOUS_ORDER_TYPE_CALLINGS_TITLE"
				}
				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" { maximumsize = { -1 200 } }
					blockoverride "section_content" {
						TooltipListColumnContent = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							TooltipTableColumn = {
								blockoverride "field_left" {
									icon = {
										size = { 20 20 }
										texture = "[Calling.GetIcon]"
									}
								}
								blockoverride "field_text" {
									tagtooltip_enabled = yes
									raw_text = "[Calling.GetName]"
								}
								blockoverride "field_right" { expand = {} }
								blockoverride "column_datamodel" { datamodel = "[ReligiousOrderType.GetValidCallings]" }
							}
						}
					}
				}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[ReligiousOrderType.GetTooltip]"
				}
			}
		}
	}
}

template Calling_tooltip {
	ContextualTooltipType = {
