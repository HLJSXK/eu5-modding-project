				blockoverride "block_title" { text = "CALLING_LEADER_ABILITY_TITLE" }
				textcontext = "[Calling.GetLeaderAbilityText]"
				ontextcontextchanged = "[SetRowListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipScrolledRowList = {
				visible = "[Calling.HasActions]"
				blockoverride "block_scrollarea" { maximumsize = { -1 200 }}
				blockoverride "block_title" { text = "CALLING_ACTIONS_TITLE" }
				textcontext = "[Calling.GetActionsText]"
				ontextcontextchanged = "[SetRowListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[Calling.GetTooltip]"
				}
			}
		}
	}
}

template ReligiousOrderMembers_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "RELIGIOUS_ORDER_MEMBERS_TOOLTIP_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[ReligiousOrder.GetIcon]"
			}
		}
		blockoverride "tooltip_content" {
			TooltipScrolledContentSection = {
				blockoverride "block_scrollarea" { maximumsize = { -1 408 } }
				blockoverride "section_content" {
					vbox = {
						set_parent_dimension_to_minimum = height
						layoutpolicy_horizontal = expanding
						spacing = 1
						datamodel = "[ReligiousOrder.GetMembers]"
						item = {
							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 34 }
								background = {
									visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
									using = tooltip_table_field_texture
								}
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 6 0 }
									spacing = 6
									portrait_standard_head_framed_button = {
										size = { 28 32 }
										alwaystransparent = yes
									}
									text_single = {
										layoutpolicy_horizontal = expanding
										autoresize = no
										align = left|nobaseline
										tagtooltip_enabled = yes
										raw_text = "[Character.GetNameToFit('(int32)20', '(bool)no')]"
									}
									text_single = {
										visible = "[And(ReligiousOrder.HasHeadCharacter, ObjectsEqual(Character.Self, ReligiousOrder.GetHeadCharacterRef.Self))]"
										autoresize = yes
										align = right|nobaseline
										default_format = "#high"
										text = "RELIGIOUS_ORDER_MEMBERS_HEAD_MARKER"
									}
									text_single = {
										visible = "[Character.GetCourtCountry.IsReal]"
										datacontext = "[Character.GetCourtCountry]"
										autoresize = yes
										align = right|nobaseline
										default_format = "#subtle_name"
										raw_text = "[Country.GetName]"
									}
									widget = {
										size = { 22 14 }
										country_flag_mini = {
											visible = "[Character.GetCourtCountry.IsReal]"
											datacontext = "[Character.GetCourtCountry]"
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

template ReligiousOrderLocations_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "RELIGIOUS_ORDER_LOCATIONS_TOOLTIP_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/religious_orders/holdings.dds"
			}
		}
		blockoverride "tooltip_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 1
				datacontext = "[ReligiousOrder.GetPresenceTable]"

				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 400 }
					}
					blockoverride "section_content" {
						vbox = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							spacing = 1
							datamodel = "[ReligiousOrderPresenceTable.GetRows]"
							item = {
								widget = {
									layoutpolicy_horizontal = expanding
									visible = "[ReligiousOrderPresenceRow.HasLocations]"
									size = { -1 24 }
									background = {
										visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
										using = tooltip_table_field_texture
									}
									hbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 0 }
										spacing = 12
										text_single = {
											layoutpolicy_horizontal = expanding
											align = left|nobaseline
											text = "[ReligiousOrderPresenceRow.GetCountryName]"
										}
										widget = {
											size = { 40 22 }
											tooltipwidget = { using = ReligiousOrderHoldings_tooltip }
											text_single = {
												parentanchor = right|vcenter
												align = right|nobaseline
												default_format = "#high"
												text = "[ReligiousOrderPresenceRow.GetNumLocations]"
											}
										}
									}
								}
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				visible = "[ReligiousOrder.HasPlayerPresence]"
				margin_top = 6
				blockoverride "block_title" { text = "RELIGIOUS_ORDER_PROJECTION_TITLE" }
				textcontext = "[ReligiousOrder.GetPlayerProjectionBreakdown]"
				ontextcontextchanged = "[SetStringPairListFromTextContext(PdxGuiWidget.AccessSelf)]"
			}
		}
	}
}

