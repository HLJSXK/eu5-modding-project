			using = layoutpolicy_expanding
		}
		visible = "[Or(Not(IsDataModelEmpty(CountryReligionLateralView.GetCountry.GetSaints)), CountryReligionLateralView.HasCanonizeAction)]"

		using = bg_cabinet_card_frame

		blockoverride "bg_card_header_01_bg" {
			background = {
				texture = "gfx/interface/component_tiles/square_tile.dds"
				texture_density = 2
				spriteType = corneredtiled
				spriteborder = { 10 10 }

				modify_texture = {
					using = color_economy_texture
					blend_mode = multiply
				}

				modify_texture = {
					texture = "gfx/interface/cards/headers/header_pattern_07.dds"
					alpha = 0.7
					texture_density = 2
					spriteType = corneredtiled
					blend_mode = overlay
				}
			}

			background = {
				using = color_black_texture
				alpha = 0.6
			}
		}

		blockoverride "header_content" {
			widget = {
				size = { 100% 100% }

				datacontext = "[Player]"
				tooltipwidget = {
					using = Saints_Tooltip
				}

				hbox = {
					expand = {}

					vbox = {
						spacing = 5
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/religious_doctrines/catholic/saints.dds"
							glow = {
								name = "drop_shadow"
								glow_radius = 3
								color = {0.0 0.0 0.0 1.0}
								alpha = 0.3
							}
						}

						text_single = {
							size = { 10 10 }
							autoresize = no
							align = center
							text = "[GetDataModelSize(CountryReligionLateralView.GetCountry.GetSaints)]"
						}
					}
					expand = {}
				}
			}
		}

		# RIGHT
		blockoverride "bottom_content" {
			hbox = {
				using = bg_corner_flavor
				blockoverride "corner_flavor_texture" {
					texture = "gfx/interface/component_decoration/bg_corner_flavor_06.dds"
					texture_density = 2
					spriteType = Corneredstretched
					spriteborder = { 35 35 }
					alpha = 0.7
				}
				blockoverride "corner_flavor_color" {
					modify_texture = {
						using = color_bg_blue_texture
						blend_mode = multiply
					}
				}
				spacing = 4
				
				margin = { 10 0 }
				hbox = {
					layoutpolicy_vertical = expanding
					spacing = 4
					datamodel = "[DataModelFirst(CountryReligionLateralView.GetCountry.GetSaints, '(int32)6')]"
					item = {
						character_frame_small = {
							blockoverride "portrait_datacontext" {
								datacontext = "[Character]"
							}
							blockoverride "character_frame_size" {
								size = { 39 45 }
		
							}
							blockoverride "character_frame_texture" {
								texture = "gfx/interface/component_decoration/character_frames/character_non_stretchable_frame_2.dds"
							}
							blockoverride "character_portrait_visible" {
								visible = yes
							}
							blockoverride "character_portrait_ani_visible" {
								visible = no
							}
							blockoverride "character_frame_estate_visible" {
								visible = no
							}
							blockoverride "character_frame_dynasty_visible" {
								visible = no
							}
						}
					}
				}
				
				text_single = {
					margin = {5 5}
					using = Font_Type_Headers
					raw_text = "+[Subtract_int32(GetDataModelSize(CountryReligionLateralView.GetCountry.GetSaints), '(int32)6')]"
					align = nobaseline
					visible = "[GreaterThan_int32(GetDataModelSize(CountryReligionLateralView.GetCountry.GetSaints), '(int32)6')]"

					tooltipwidget = {
						using = Saints_Tooltip
						blockoverride "saints_tooltip_has_items" { visible = "[GreaterThan_int32(GetDataModelSize(CountryReligionLateralView.GetCountry.GetSaints), '(int32)6')]"}
						blockoverride "saints_tooltip_datamodel" { datamodel = "[DataModelSkipFirst(CountryReligionLateralView.GetCountry.GetSaints, '(int32)6')]"} 
					}
					using = bg_number_container_bckg
					blockoverride "number_container_alpha" {
						alpha = 0.5
					}
					blockoverride "number_container_color" {
						modify_texture = {
							using = color_bg_blue_texture
							blend_mode = multiply
						}
					}
				}

				expand = {}

				button_regular_icon  = {
					size = { 150 30 }
					visible = "[CountryReligionLateralView.HasCanonizeAction]"
					datacontext = "[CountryReligionLateralView.GetCanonizeAction]"
					datacontext = "[CountryReligionLateralView.GetCountry]"
					tooltipwidget = {
						using = Saints_Tooltip
					}
					
					using = button_action_provider
					hbox = {
						margin = { 5 0 }
						spacing = 3
						text_single = {
							raw_text = "[UIActionProvider.GetLeftClickTitle][UIActionProvider.GetLeftClickAndConfirmTitle]"
							autoresize = no
							align = center
							layoutpolicy_horizontal = expanding
							size = { -1 20}
						}
						text_single = {
							raw_text = "[UIActionProvider.GetLeftClickCost][UIActionProvider.GetLeftClickAndConfirmCost]"
							autoresize = no
							align = center
							layoutpolicy_horizontal = expanding
							size = { -1 20}
						}
					}
				}
			}
		}
	}

	type religious_influence_card = widget {
		size = { 65 27 }

		tooltipwidget = {
			using = religious_influence_tooltip
		}
		
		using = bg_paper_card
		using = bg_cabinet_card_frame
		
		hbox = {
			expand = {}
			spacing = 3
			text_single = {
				maximumsize = { 35 20 }
				autoresize = yes
				align = center
				text = "[Player.GetCurrencyValue('religious_influence')|W]"
			}

			icon = {
				size = { 15 15 }
				using = icon_church_power
				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}

			expand = {}
		}
	}

	type special_gods_card = widget {
		size = { 82 208 }
		allow_outside = yes
		widget = {
			size = { 100% 100% }
			parentanchor = hcenter|top
			allow_outside = yes

			widget = {
				size = { 80 208 }
				parentanchor = hcenter|top
				position = {0 -6}
				allow_outside = yes
				icon = {
					ignore_layout = yes
					size = {80 52}
					parentanchor = hcenter|bottom
					texture = "gfx/interface/icons/gods/hellenism_pillar.dds"
					texture_density = 2
				}
				widget = {
					size = { 86 176}
					parentanchor = hcenter|top
					position = {0 -4}
					icon = {
						visible = "[Not(GreaterThan_int32(Player.GetNumberOfOmensPerGod(God.Self), '(int32)0'))]"
						size = { 100% 100% }
						texture = "[GetEmptyGodIcon(God.Self)]"
						texture_density = 2
					}
					icon = {
						visible = "[GreaterThan_int32(Player.GetNumberOfOmensPerGod(God.Self), '(int32)0')]"
						size = { 100% 100% }
						texture = "[GetFullBodyGodIcon(God.Self)]"
						texture_density = 2
					}
				}
				vbox = {
					layoutpolicy_vertical = expanding
					allow_outside = yes
					expand = {
						#Added tooltip this way to let the select button tooltip work
						tooltipwidget = {
							using = God_tooltip
						}
					}
					margin_bottom = 15
					spacing = 3
	
					#Selected Omens
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GreaterThan_int32(Player.GetNumberOfOmensPerGod(God.Self), '(int32)0')]"
						spacing = -5
						bottomtotop = yes
						expand = {}
						#Name if one
						# hbox = {
						# 	visible = "[EqualTo_int32(Player.GetNumberOfOmensPerGod(God.Self), '(int32)1')]"
						# 	datamodel = "[CountryReligionLateralView.GetActiveOmens]"
						# 	item = {
						# 		vbox = {
						# 			layoutpolicy_horizontal = expanding
						# 			visible = "[ObjectsEqual(Omen.GetGod, God.Self)]"
						# 			text_single = {
						# 				size = {70 25}
						# 				using = bg_name_banner_green
						# 				blockoverride "bg_name_banner_green_visible" {
						# 					visible = yes
						# 				}
						# 				blockoverride "bg_name_banner_green_alt_visible" {
						# 					visible = no
						# 				}
						# 				blockoverride "bg_name_banner_margin" {
						# 					margin = {5 0}
						# 				}
						# 				autoresize = no
						# 				fontsize = 12
						# 				align = center
						# 				text = "[Omen.GetName]"
						# 			}
						# 		}
						# 	}
						# }
	
						#Progress
						hbox = {
							datamodel = "[CountryReligionLateralView.GetActiveOmens]"
							item = {
								vbox = {
									layoutpolicy_horizontal = expanding
									visible = "[ObjectsEqual(Omen.GetGod, God.Self)]"
									widget = {
										size = { 25 25 }
										using = bg_circle
										tagtooltip_enabled = yes
										tooltip = "[Omen.GetName]"
					
										piechart = {
											size = { 100% 100% }
											parentanchor = center
											using = piechart_angles
											icon = {
												parentanchor = center
												size = { 70% 70% }
												texture = "[GetOmenIcon(Omen.Self)]"
												texture_density = 2
											}
					
											pieslice = {
												texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
												# value = "50"
												value = "[FixedPointToFloat(Player.GetOmenTimeLeftProgress(Omen.Self))]"
												using = color_value_progress_blue
											}
					
											pieslice = {
												texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
												# value = "50"
												value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetOmenTimeLeftProgress(Omen.Self)))]"
												using = color_value_progress_gray
											}
											using = bg_circle_piechart
										}
									}
								}
							}
						}
					}
	
					#God name
					text_single = {
						size = {70 25}
						using = bg_name_banner_green
						blockoverride "bg_name_banner_green_visible" {
							visible = "[Not(Player.MakeScope.GetVariable(God.GetFavouringGodKey).IsSet)]"
						}
						blockoverride "bg_name_banner_green_alt_visible" {
							visible = "[Player.MakeScope.GetVariable(God.GetFavouringGodKey).IsSet]"
						}
						blockoverride "bg_name_banner_margin" {
							margin = {5 0}
						}
						autoresize = no
						fontsize = 12
						align = center
						text = "[God.GetName]"
					}
	
					#God Omens Effects
					widget = {
						size = { 70 60 }
						scrollarea = {
							position = {0 -5}
							layoutpolicy_horizontal = expanding
							minimumsize = { 75 60 }
							maximumsize = { 75 60 }
							scrollbarpolicy_horizontal = always_off
							autoresizescrollarea = yes
		
							scrollbar_vertical = {
								using = Scrollbar_Vertical
							}
		
							tooltipwidget = {
								using = God_tooltip
							}
		
							scrollwidget = {
								vbox = {
									datamodel = "[CountryReligionLateralView.GetActiveOmens]"
									item = {
										vbox = {
											using = bg_scroll_card
		
											layoutpolicy_horizontal = expanding
											visible = "[ObjectsEqual(Omen.GetGod, God.Self)]"
											ModifiersList = {
												layoutpolicy_horizontal = expanding
												margin = { 9 0 }
												blockoverride "datamodel" {
													datamodel = "[StringToRowList(Omen.GetIconEffects).GetRows]"
												}
		
												blockoverride "modifiers_list_bg" {
													# using = bg_scroll_card
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			#Select Omen button
			widget = {
				size = { 32 32 }
				allow_outside = yes
				parentanchor = hcenter|bottom

				action_button_regular = {
					blockoverride "button_texture" {
						using = bg_button_light_alt_round
						texture = "gfx/interface/component_tiles/circle_outline_tile_thick.dds"
						texture_density = 2
						modify_texture = {
							using = color_new_gold_texture
							blend_mode = multiply
						}
						modify_texture = {
							using = color_white_texture
							blend_mode = overlay
							alpha = 0.2
						}
						modify_texture = {
							using = overlay_window_texture
							blend_mode = overlay
							alpha = 0.7
						}
					}
					size = { 30 30 }
					title = "select_omen_god"
					actor = "[Player]"
					parameter = {
						parameter_name = "target"
						parameter_value = "[God.MakeScope]"
					}
					parameter = {
						parameter_name = "recipient"
						parameter_value = "[CountryReligionLateralView.GetReligion]"
					}
					left_click_and_hold_action = { action_name = "select_omen_god" }

					tooltipwidget = {
						using = action_tooltip_pop_out

						blockoverride "title_icon_texture" {
							texture = "[GetConceptTexture('omen')]"
						}
					}

					icon = {
						size = { 25 25 }
						position = { 1 1 }
						parentanchor = center
						texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
						texture_density = 2
						alwaystransparent = yes

						modify_texture = {
							using = color_new_gold_texture
							blend_mode = add
						}

						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.8
						}
					}
				}
			}
		}
	}

