template PentarchModifier_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetReligionIcon(CountryReligionLateralView.GetReligion)]"
		}

		blockoverride "title_text" {
			text = "PENTARCHY_CITY_BONUSES_TITLE"
		}

		blockoverride "tooltip_content" {
			TooltipBlockList = {
				block "pentarch_modifier_text" {
					textcontext = "[Select_CString(Location.GetOwner.HasAllPentarchy,ShowModifierEffect('pentarch_constantinople_upgraded'),ShowModifierEffect('pentarch_constantinople'))]"
				}
			}
		}
	}
}

types ReligionOverview {
	type pentarch_character = widget {
		block "pentarch_character_datacontext" {
			datacontext = "[GetReligionByKey('orthodox').MakeScope.GetVariableFromVariableMap('pentarchy', GetLocationByKey('constantinople').MakeScope).GetCharacter]"
		}
		datacontext = "[GetLocationByKey('constantinople')]"
		size = { 139 113 }
		background = {
			texture = "gfx/interface/component_tiles/pentarchy/bg_pentarchy_character.dds"
			texture_density = 2
			frame_grid = { 2 1 }
			frame = 1
			visible = "[Character.IsValid]"
		}
		background = {
			texture = "gfx/interface/component_tiles/pentarchy/bg_pentarchy_character.dds"
			texture_density = 2
			frame_grid = { 2 1 }
			frame = 2
			visible = "[Not(Character.IsValid)]"
		}
		
		vbox = {
			margin = { 7 7 }
			margin_top = 2
			# block "pentarch_character_direction" {}
			# Portrait
			
			character_frame_small = {
				size = { 50 59 }
				blockoverride "portrait_datacontext" {
					datacontext = "[Character]"
				}
				blockoverride "character_frame_size" {
					size = { 50 59 }

				}
				blockoverride "character_frame_texture" {
					texture = "gfx/interface/component_decoration/character_frames/character_non_stretchable_frame_2.dds"
				}
				blockoverride "character_portrait_visible" {
					visible = yes
				}
				blockoverride "character_portrait_ani_visible" {
					visible = no
				}
				blockoverride "character_frame_estate_visible" {
					visible = no
				}
				# text = "[SelectLocalization(Character.IsValid,'PENTARCH_NAME_AGE','PENTARCH_NOT_VALID')]"
			}
			
			# Location with effect
			vbox = {
				using = layoutpolicy_expanding
				expand = {}
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 25 }
					background = {
						texture = "gfx/interface/component_tiles/pentarchy/bg_pentarchy_name.dds"
						texture_density = 2
					}
					background = {
						texture = "gfx/interface/component_tiles/pentarchy/bg_pentarchy_name_dark.dds"
						texture_density = 2
						visible = "[Not(Character.IsValid)]"
					}

					background = {
						visible = "[ObjectsEqual(Location.GetOwner.Self, Player.Self)]"
						using = color_society_texture
						alpha = 0.5
					}
	
					hbox = {
						spacing = 2
						# block "pentarch_character_direction" {}
						country_flag_small = {
							datacontext = "[Location.GetOwner]"
							tooltipwidget = {
								using = CountryTooltip
							}
						}
	
						text_single = {
							# block "pentarchy_location_alignment"{
								align = left
							# }
							size = {-1 25}
							layoutpolicy_horizontal = expanding
							autoresize = no
							raw_text = "[Location.GetDialectName(Player.GetLiturgicalDialect)]"
						}
					}
				}
				hbox = {
					# block "pentarch_character_direction" {}
					minimumsize = { 0 20 }
					block "pentarch_modifier_tooltip" {
						tooltipwidget = {
							using = PentarchModifier_tooltip
						}
					}
					background = {
						texture = "gfx/interface/component_tiles/pentarchy/bg_pentarchy_name.dds"
						texture_density = 2
					}
					background = {
						texture = "gfx/interface/component_tiles/pentarchy/bg_pentarchy_name_dark.dds"
						texture_density = 2
						visible = "[Not(Character.IsValid)]"
					}
					text_single = {
						autoresize = no
						size = { 70 15 }
						align = center
						fontsize = 10
						block "pentarch_modifier_name" {
							text = "[Select_CString(Location.GetOwner.HasAllPentarchy,ShowOnlyIconModifierEffect('pentarch_constantinople'),ShowOnlyIconModifierEffect('pentarch_constantinople'))]"
						}
					}
				}
				expand = {}
			}
			expand = {}
		}
	}
