situation_panel = {

	##################################### TOP HEADER #####################################
	# blockoverride "situation_header_extra"{ visible = no }
	# To show the start date properly, we may want to reactivate this in the future, in case 
	# we want to move the start date of each situation elsewhere

	blockoverride "situation_header_left" {
		icon = {
			size = {32 32}
			texture = "gfx/interface/icons/modifier_types/religious_turmoil_actions_price_cost_modifier.dds"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				#layoutpolicy_horizontal = expanding
				fontsize = 15
				text = "HERETICS_KILLED"
				default_format = "#subtle_name"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('heretics_eradicated_variable').GetValue|0]"
			}

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "HERETICS_KILLED"
					}
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[SituationView.GetActiveSituation.GetIcon]"										
						}
					}
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "loc_key_desc_tribunal"
							}
						}							
					}
				}
			}
		}
		expand = {}
	}

	blockoverride "situation_header_right" {

		expand = {}

		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				#layoutpolicy_horizontal = expanding
				fontsize = 15
				text = "HERETICS_CONVERTED"
				align = right|nobaseline
				default_format = "#subtle_name"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				align = right|nobaseline
				text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('heretics_converted_variable').GetValue|0]"
			}

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "HERETICS_CONVERTED"
					}
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[SituationView.GetActiveSituation.GetIcon]"										
						}
					}
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "loc_key_desc_tribunal"
							}
						}							
					}
				}
			}
		}

		icon = {
			size = {32 32}
			texture = "gfx/interface/icons/modifier_types/religious_turmoil_actions_price_cost_modifier.dds"
		}
	}

	##################################### MAIN IMAGE #####################################

	blockoverride "situation_panel_image" {
		using = two_countries_header_template
	
		blockoverride "FirstCountryContext" {
			datacontext = "[GetCountry('BOH')]"
		}

		blockoverride "SecondCountryContext" {
			datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('hussite_wars_catholic_leader').GetCountry]"
		}

		# blockoverride "history_button_anchor" {}

		blockoverride "first_character_portrait_anchor" {
			parentanchor = bottom|left
		}

		blockoverride "second_character_portrait_anchor" {
			parentanchor = bottom|right
		}

		blockoverride "character_religion_visibility" {
			visible = no
		}

		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}

		blockoverride "country_header_extra" {
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 10 10 }
				spacing = 8

				expand = {}
			}
		}
	}

	##################################### TAB NAME #####################################

	

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################
	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_hussite_wars')]"
		}
	}

	blockoverride "situation_panel_main_content" {


		situation_fancy_two_line_card = {
			block "card_datacontext" { }	#We need two countries here, not one, so we will have to define both individually
			
			#Left - Bohemia the infirm
			blockoverride "left_flag_properties" {
				datacontext = "[GetCountry('BOH')]"
				visible = "[Country.IsValid]"
			}
			blockoverride "left_bottom_flag" { }
			blockoverride "left_top_text" {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				visible = "[GetCountry('BOH').IsValid]"
				text = "[GetCountry('BOH').GetName]"
			}
			blockoverride "left_bottom_text" {
				text = "BOH_STR_TT"
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_icon" {
							country_flag_small = {
								datacontext = "[GetCountry('BOH')]"
							}
						}
						blockoverride "title_text" {
							text = "RELATIVE_MILITARY_STRENGTH_BOH_TT_TITLE"
						}
						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								blockoverride "block_title" {
									visible = no
								}
								textcontext = "RELATIVE_MILITARY_STRENGTH_BOH_TT_ARMY_STRENGTH"
							}							
						}						
					}
				}
			}
			
			#Right - Opposers' Strongest Country
			blockoverride "right_flag_properties" {
				datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('hussite_wars_catholic_leader').GetCountry]"
				visible = "[Country.IsValid]"
			}
			blockoverride "right_bottom_flag" {	}
			blockoverride "right_top_text" {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('hussite_wars_catholic_leader').GetCountry.IsValid]"
				text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('hussite_wars_catholic_leader').GetCountry.GetName]"
			}
			blockoverride "right_bottom_text" {
				visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('hussite_wars_catholic_leader').GetCountry.IsValid]"
				text = "EMPEROR_STR_TT"
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_icon" {
							country_flag_small = {
								datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('hussite_wars_catholic_leader').GetCountry]"
							}
						}
						blockoverride "title_text" {
							text = "RELATIVE_MILITARY_STRENGTH_EMPEROR_TT_TITLE"
						}
						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								blockoverride "block_title" {
									visible = no
								}
								textcontext = "RELATIVE_MILITARY_STRENGTH_EMPEROR_TT_ARMY_STRENGTH"
							}
						}
					}
				}
			}
        }
	}

	blockoverride "situation_panel_main_content_bottom" {
		situation_side_cards = {

			#Bohemian side
			blockoverride "left_header_content" {
				icon = {
					blockoverride "left_header_icon" { }
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center|nobaseline
					text = "DEFENDERS_HUSSITISM"
					blockoverride "left_header_text" { }
				}
				expand = {}
			}
			blockoverride "left_bottom_content" {
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center|nobaseline
					margin = { 0 20 }
					text = "HUSSITE_WARS_NO_SUPPORTERS"
					default_format = "#subtle_name"
					visible = "[Not(DataModelHasItems(GetGlobalList('hussite_wars_hussite_side_list')))]"
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					size = { -1 190 }
					visible = "[DataModelHasItems(GetGlobalList('hussite_wars_hussite_side_list'))]"
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}
					
					scrollwidget = {
						dynamicgridbox = {
							layoutpolicy_horizontal = expanding
							position = {0 10}
							flipdirection = yes
							datamodel_wrap = 6
							maxhorizontalslots = 6
							datamodel = "[GetGlobalList('hussite_wars_hussite_side_list')]"
							item = {
								country_flag_small = {
									datacontext = "[Scope.GetCountry]"
									tooltipwidget = {
										using = CountryTooltip
									}
								}
							}
						}
					}
				}
			}

			#Imperial side
			blockoverride "right_header_content" {
				icon = {
					blockoverride "right_header_icon" { }
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center|nobaseline
					text = "DEFENDERS_CATHOLICISM"
					blockoverride "right_header_text" { }
				}
				expand = {}
			}
			blockoverride "right_bottom_content" {
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center|nobaseline
					margin = { 0 20 }
					text = "HUSSITE_WARS_NO_SUPPORTERS"
					default_format = "#subtle_name"
					visible = "[Not(DataModelHasItems(GetGlobalList('hussite_wars_catholic_side_list')))]"
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					size = { -1 190 }
					visible = "[DataModelHasItems(GetGlobalList('hussite_wars_catholic_side_list'))]"
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}
					
					scrollwidget = {
						dynamicgridbox = {
							layoutpolicy_horizontal = expanding
							position = {0 10}
							flipdirection = yes
							datamodel_wrap = 6
							maxhorizontalslots = 6
							datamodel = "[GetGlobalList('hussite_wars_catholic_side_list')]"
							item = {
								country_flag_small = {
									datacontext = "[Scope.GetCountry]"
									tooltipwidget = {
										using = CountryTooltip
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
