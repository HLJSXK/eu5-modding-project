
situation_panel = {

	##################################### TOP HEADER #####################################
	# Religion country-count bar — Catholic always visible, Protestant faiths appear when enabled
	blockoverride "situation_top_subheader_content" {
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 45 }
			using = bg_paper_card
			using = bg_cabinet_card_frame
			ignoreinvisible = yes

			datamodel = "[SituationView.GetReformationReligionItems]"
			item = {
				hbox = {
					spacing = 3
					using = layoutpolicy_expanding
					using = bg_text_mask_container_brown
					blockoverride "text_mask_extra" {
						alpha = "[ReformationReligionItem.GetMaskAlpha]"
					}

					expand = {}

					icon = {
						size = { 30 30 }
						texture = "[GetReligionIcon(ReformationReligionItem.GetReligion.Self)]"
					}
					text_single = {
						text = "[ReformationReligionItem.GetReligion.GetNumCountries]"
					}
					icon = {
						size = { 16 16 }
						texture = "gfx/interface/icons/flat_icons/country.dds"
					}
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "[GetReligionIcon(ReformationReligionItem.GetReligion.Self)]"
								}
							}
							blockoverride "title_text" {
								text = "[ReformationReligionItem.GetReligion.GetNameWithNoTooltip]"
							}
							blockoverride "concept_link" {
								text = [religion|E]
							}
							blockoverride "tooltip_content" {
								TooltipScrolledRowList = {
									blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
									blockoverride "block_title" {
										visible = yes
										raw_text = "[ReformationReligionItem.GetReligion.GetNumCountries] [Localize('REFORMATION_MAIN_RELIGION')]"
									}
									blockoverride "rowlist_datamodel_is_empty" {
										visible = "[IsDataModelEmpty(ReformationReligionItem.GetReligion.GetCountries)]"
									}
									blockoverride "rowlist_datamodel_has_items" {
										visible = "[DataModelHasItems(ReformationReligionItem.GetReligion.GetCountries)]"
									}
									blockoverride "rowlist_datamodel" {
										datamodel = "[ReformationReligionItem.GetReligion.GetCountries]"
									}
									blockoverride "rowlist_item" {
										text = "[Country.GetLongNameWithFlag]"
									}
								}
							}
						}
					}

					expand = {}
				}
			}
		}
	}

	##################################### MAIN IMAGE #####################################
	
	blockoverride "situation_panel_image" {
		using = one_country_header_template
		blockoverride "one_country_character_visible" {}
		blockoverride "one_country_ruler_title_visible" { visible = no }
		blockoverride "CountryContext" {}

		blockoverride "one_country_header_character" {
			datacontext = "[GetCharacter('martin_luther')]"
		}
		# blockoverride "history_button_anchor" {}
		blockoverride "character_portrait_anchor" {
			parentanchor = bottom|left
		}
		blockoverride "character_religion_visibility" {
			visible = no
		}
		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}
		blockoverride "country_header_extra" {}
    }

	##################################### TAB NAME #####################################

	blockoverride "situation_extra_tabs_content" {
		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			blockoverride "tab_text" { text = "REFORMATION_REFORMERS_TAB" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'situation_members' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'situation_members' )]"
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/location_icons/new/population.dds"
					}
					blockoverride "title_text" { text = "REFORMATION_REFORMERS_TAB" }
					blockoverride "concept_link" { text = "[situation|e]" }
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "REFORMATION_REFORMERS_TAB_TT"
							}
						}
					}
				}
			}
		}
		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			blockoverride "tab_text" { text = "REFORMATION_COUNTRIES_TAB" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'reformation_countries' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'reformation_countries' )]"
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/international_organizations/special_statuses/members.dds"
					}
					blockoverride "title_text" { text = "REFORMATION_COUNTRIES_TAB" }
					blockoverride "concept_link" { text = "[situation|e]" }
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "REFORMATION_COUNTRIES_TAB_TT"
							}
						}
					}
				}
			}
		}
	}

	##################################### SUBHEADER #####################################
	blockoverride "situation_subheader_content"{}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content_bottom" {

		vbox = {
			layoutpolicy_horizontal = expanding
			using = bg_paper_card
			using = bg_cabinet_card_frame

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 36 }
				using = bg_card_header_01_production
				using = bg_cabinet_card_frame

				text_single = {
					parentanchor = center|vcenter
					text = "game_concept_buildings"
					default_format = "#T"
					fontsize = 16
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes
				spacing = 6
				margin = { 10 10 }
				
				expand = {}

				card_header_button_04 = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 55 }
					maximumsize = { 150 65 }

					action_tooltip = {
						click_type = left
						click_mode = single
						title = "REFORMATION_BUILD_LUTHERAN_PREACHERS"
						on_action = "[SelectLocationToBuildByKey('lutheran_preachers')]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }

					background = {
						using = bg_round_corners_alt_texture
						modify_texture = {
							color = { 0 0 0.698 1 }
							alpha = 0.8
						}
						modify_texture = {
							using = overlay_cloth_texture
							blend_mode = overlay
							alpha = 0.3
						}
					}

					vbox = {
						parentanchor = center
						margin = { 0 4 }

						widget = {
							size = { 34 34 }
							using = bg_circle_tile_shadow
							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_background.dds"
								texture_density = 2
								modify_texture = {
									using = color_dark_blue_texture
									blend_mode = multiply
								}
							}
							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_frame.dds"
								modify_texture = {
									using = color_new_gold_texture
								}
							}
							icon = {
								size = { 28 28 }
								parentanchor = center
								texture = "gfx/interface/icons/buildings/lutheran_preachers.dds"
							}
						}
						text_single = {
							align = center
							maximumsize = { 140 21 }
							raw_text = "[ShowBuildingTypeName('lutheran_preachers')] ([SituationView.GetPlayer.GetTotalBuildingLevelsIncudingUnderConstruction('lutheran_preachers')])"
						}
					}
				}

				card_header_button_04 = {
					visible = "[GetReligionByKey('calvinist').IsEnabled]"
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 55 }
					maximumsize = { 150 65 }

					action_tooltip = {
						click_type = left
						click_mode = single
						title = "REFORMATION_BUILD_CALVINIST_PREACHERS"
						on_action = "[SelectLocationToBuildByKey('calvinist_preachers')]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }

					background = {
						using = bg_round_corners_alt_texture
						modify_texture = {
							color = { 0.298 0.298 0.898 1 }
							alpha = 0.8
						}
						modify_texture = {
							using = overlay_cloth_texture
							blend_mode = overlay
							alpha = 0.3
						}
					}

					vbox = {
						parentanchor = center
						margin = { 0 4 }

						widget = {
							size = { 34 34 }
							using = bg_circle_tile_shadow
							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_background.dds"
								texture_density = 2
								modify_texture = {
									using = color_dark_blue_texture
									blend_mode = multiply
								}
							}
							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_frame.dds"
								modify_texture = {
									using = color_new_gold_texture
								}
							}
							icon = {
								size = { 28 28 }
								parentanchor = center
								texture = "gfx/interface/icons/buildings/calvinist_preachers.dds"
							}
						}
						text_single = {
							align = center
							maximumsize = { 140 21 }
							raw_text = "[ShowBuildingTypeName('calvinist_preachers')] ([SituationView.GetPlayer.GetTotalBuildingLevelsIncudingUnderConstruction('calvinist_preachers')])"
						}
					}
				}

				card_header_button_04 = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 55 }
					maximumsize = { 150 65 }

					action_tooltip = {
						click_type = left
						click_mode = single
						title = "REFORMATION_BUILD_JESUIT_COLLEGE"
						on_action = "[SelectLocationToBuildByKey('jesuit_college')]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }

					background = {
						using = bg_round_corners_alt_texture
						modify_texture = {
							color = { 0.698 0.498 0 1 }
							alpha = 0.8
						}
						modify_texture = {
							using = overlay_cloth_texture
							blend_mode = overlay
							alpha = 0.3
						}
					}

					vbox = {
						parentanchor = center
						margin = { 0 4 }

						widget = {
							size = { 34 34 }
							using = bg_circle_tile_shadow
							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_background.dds"
								texture_density = 2
								modify_texture = {
									using = color_dark_blue_texture
									blend_mode = multiply
								}
							}
							background = {
								texture = "gfx/interface/component_tiles/hud_corners/circle_frame.dds"
								modify_texture = {
									using = color_new_gold_texture
								}
							}
							icon = {
								size = { 28 28 }
								parentanchor = center
								texture = "gfx/interface/icons/buildings/jesuit_college.dds"
							}
						}
						text_single = {
							align = center
							maximumsize = { 140 21 }
							raw_text = "[ShowBuildingTypeName('jesuit_college')] ([SituationView.GetPlayer.GetTotalBuildingLevelsIncudingUnderConstruction('jesuit_college')])"
						}
					}
				}
				expand = {}
			}
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 160 }
			using = bg_dark_paper_card
			using = bg_cabinet_card_frame

			icon_pie = {
				margin = { 5 5 }
				blockoverride "item_bg_color" {
					using = color_light_paper_texture
					alpha = 0.1
				}
				blockoverride "population_culture_tooltip_bg" {}
				blockoverride "PieSize" { size = { 112 112 } }
				blockoverride "pie_datamodel" { datamodel = "[SituationView.GetReformationPieSlices]" }

				blockoverride "SliceTooltip" { 
					datacontext = "[ReformationPieSliceItem.GetReligion]" 
					onmousehierarchyenter = "[PdxGuiWidget.SetHighlightReligion(Religion.Self)]"
					onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('location_religion')]"
					tooltip = "[ReformationPieSliceItem.GetReligion.GetName]" 
				}
				blockoverride "SliceValue" { value = "[ReformationPieSliceItem.GetPercentage]" }
				blockoverride "SliceColor" { color = "[ReformationPieSliceItem.GetColor]" }
				blockoverride "Icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }

				blockoverride "datamodel" { datamodel = "[SituationView.GetReformationPieSlices]" }
				blockoverride "color" { color = "[ReformationPieSliceItem.GetColor]" }
				blockoverride "leftside_info" { text = "[ReformationPieSliceItem.GetReligion.GetName]" }
				blockoverride "rightside_info" { raw_text = "[ReformationPieSliceItem.GetPercentage|%2] ([ReformationPieSliceItem.GetDisplayPopCount])" }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[DataModelHasItems(SituationView.GetReformationMovementItems)]"
			spacing = 2
			using = bg_dark_paper_card
			using = bg_cabinet_card_frame
			margin_bottom = 6

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 36 }
				using = bg_card_header_01_production
				using = bg_cabinet_card_frame

				hbox = {
					spacing = 4
					expand = {}
					text_single = {
						text = "REFORMATION_MOVEMENTS_HEADER"
						default_format = "#T"
						fontsize = 16
					}
					mapmode_tooltip_button = {
						size = { 26 26 }
						datacontext = "[GetMapMode('movements')]"
					}
					expand = {}
				}
			}

			datamodel = "[SituationView.GetReformationMovementItems]"
			item = {
				widget = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 500 40 }
					maximumsize = { 500 40 }
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 6 0 }
						using = bg_paper_card
	
						icon = {
							size = { 36 36 }
							texture = "[GetMovementDefinitionIcon(ReformationMovementItem.GetDefinition)]"
							texture_density = 2
						}
	
						text_single = {
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							text = "[ReformationMovementItem.GetName]"
						}
	
						text_single = {
							align = right|nobaseline
							raw_text = "[ReformationMovementItem.GetNumAffectedCountries]"
						}
	
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon_texture" {
									texture = "[GetMovementDefinitionIcon(ReformationMovementItem.GetDefinition)]"
								}
								blockoverride "title_text" { text = "[ReformationMovementItem.GetName]" }
								blockoverride "concept_link" { text = "[movement|E]" }
								blockoverride "tooltip_content" {
									TooltipScrolledRowList = {
										blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
										blockoverride "block_title" {
											raw_text = "[ReformationMovementItem.GetNumAffectedCountries] [Localize('REFORMATION_MOVEMENTS_COUNTRIES_TT')]"
										}
										blockoverride "rowlist_datamodel_is_empty" {
											visible = "[IsDataModelEmpty(ReformationMovementItem.GetAffectedCountryItems)]"
										}
										blockoverride "rowlist_datamodel_has_items" {
											visible = "[DataModelHasItems(ReformationMovementItem.GetAffectedCountryItems)]"
										}
										blockoverride "rowlist_datamodel" {
											datamodel = "[ReformationMovementItem.GetAffectedCountryItems]"
										}
										blockoverride "rowlist_content" {
											hbox = {
												using = layoutpolicy_expanding
												margin = { 5 3 }

												text_single = {
													layoutpolicy_horizontal = expanding
													text = "[ReformationMovementCountryItem.GetCountry.GetLongNameWithFlag]"
												}

												text_single = {
													autoresize = yes
													alwaystransparent = no
													text = "[ReformationMovementCountryItem.GetAffectedCountryLocationsInfo]"
													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "title_icon_texture" {
																texture = "gfx/interface/icons/country_types/location.dds"
															}
															blockoverride "title_text" {
																raw_text = "[Localize('REFORMATION_LOCATIONS_AFFETED_IN')] [ReformationMovementCountryItem.GetCountry.GetNameWithNoTooltip]"
															}
															blockoverride "concept_link" { text = "[location|E]" }
															blockoverride "tooltip_content" {
																TooltipScrolledRowList = {
																	blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
																	blockoverride "block_title" {
																		visible = yes
																		raw_text = "[ReformationMovementCountryItem.GetNumAffectedLocations] [Localize('REFORMATION_MOVEMENT_LOCATIONS_TT')]"
																	}
																	blockoverride "rowlist_datamodel_is_empty" {
																		visible = "[IsDataModelEmpty(ReformationMovementCountryItem.GetAffectedLocationNames)]"
																	}
																	blockoverride "rowlist_datamodel_has_items" {
																		visible = "[DataModelHasItems(ReformationMovementCountryItem.GetAffectedLocationNames)]"
																	}
																	blockoverride "rowlist_datamodel" {
																		datamodel = "[ReformationMovementCountryItem.GetAffectedLocationNames]"
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[And(DataModelHasItems(SituationView.GetReformationMovementItems), GetPlayer.IsValid)]"
			spacing = 6
			using = bg_dark_paper_card
			using = bg_cabinet_card_frame
			margin_bottom = 6

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 36 }
				using = bg_card_header_01_production
				using = bg_cabinet_card_frame

				hbox = {
					spacing = 4
					datacontext = "[SituationView.GetPlayer]"
					expand = {}
					country_flag_small = {
						tooltipwidget = { using = CountryTooltip }
					}
					text_single = {
						text = "RELIGIOUS_DIVERSITY_COUNTRY"
						default_format = "#T"
						fontsize = 16
					}
					expand = {}
				}
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 8 }
				spacing = 4

				datamodel = "[SituationView.GetReformationPopTypePies]"
				item = {
					icon_pie_left = {
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[ReformationPopTypePie.GetIconTexture]"
									}
								}

								blockoverride "title_text" {
									text = "[ReformationPopTypePie.GetName]"		
								}

								blockoverride "concept_link" {
									text = [pop_type|E]
								}

								blockoverride "tooltip_content" {
									icon_pie = {
										blockoverride "PieSize" { size = { 120 120 } }
										blockoverride "pie_datamodel" { datamodel = "[ReformationPopTypePie.GetSlices]" }
										blockoverride "SliceValue" { value = "[ReformationPopReligionSlice.GetPercentage]" }
										blockoverride "SliceColor" { color = "[ReformationPopReligionSlice.GetColor]" }
										blockoverride "Icon" { texture = "[ReformationPopTypePie.GetIconTexture]" }
										blockoverride "datamodel" { datamodel = "[ReformationPopTypePie.GetSlices]" }
										blockoverride "color" { color = "[ReformationPopReligionSlice.GetColor]" }
										blockoverride "leftside_info" { text = "[ReformationPopReligionSlice.GetReligion.GetNameWithNoTooltip]" }
										blockoverride "rightside_info" { raw_text = "[ReformationPopReligionSlice.GetPercentage|%2] ([ReformationPopReligionSlice.GetDisplayPopCount])" }
									}
								}
							}
						}
						blockoverride "PieSize" { size = { 50 50 } }
						blockoverride "pie_datamodel" { datamodel = "[ReformationPopTypePie.GetSlices]" }
						blockoverride "Icon" { texture = "[ReformationPopTypePie.GetIconTexture]" }
						blockoverride "pieslice_item" {
							pieslice_no_highlight = {
								texture = "gfx/interface/pie_charts/piechart_alpha.dds"
								texture_density = 2
								tooltip_enabled = no
								value = "[ReformationPopReligionSlice.GetPercentage]"
								color = "[ReformationPopReligionSlice.GetColor]"
								alpha = 0.99
								alwaystransparent = yes
							}
						}
					}
				}
			}
		}

	}

	##################################### REFORMERS TAB #####################################

	blockoverride "situation_extra_tab_panels" {
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'situation_members' )]"
			using = bg_secondary_inner_alt
			margin = { 10 10 }
			spacing = 4

			filtered_sorted_list = {
				datacontext = "[SituationView.GetReformationReformersSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(SituationView.GetReformationReformerItems)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MEMBERS_SCROLL_LIST_EMPTY"
				}

				blockoverride "scroll_list_layout" {
					fixedgridbox = {
						addcolumn = 100%
						addrow = 82
						
						datamodel = "[SituationView.GetReformationReformerItems]"
						item = {
							widget = {
								size = { 100% 82 }
								vbox = {
									margin_right = 10
									layoutpolicy_horizontal = expanding
									situation_character_card = {
									}
								}
							}
						}

						expand = {}
					}
				}
			}

			expand = {}
		}

		##################################### COUNTRIES TAB #####################################

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'reformation_countries' )]"
			using = bg_secondary_inner_alt
			margin = { 10 10 }
			spacing = 4

			blockoverride "searchbar_extra_pre_content" {
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin_top = 4

					datamodel = "[SituationView.GetReformationReligionItems]"
					item = {
						card_header_button_04 = {
							allow_outside = yes
							layoutpolicy_horizontal = expanding
							minimumsize = { -1 30 }

							action_tooltip = {
								title = "TOGGLE_FILTER"
								on_action = "[SituationView.ToggleReformationReligionFilter( ReformationReligionItem.GetKey )]"
							}
							down = "[SituationView.IsReformationReligionFilterEnabled( ReformationReligionItem.GetKey )]"

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[GetReligionIcon(ReformationReligionItem.GetReligion.Self)]"
										}
									}
									blockoverride "title_text" { text = "[ReformationReligionItem.GetReligion.GetNameWithNoTooltip]" }
									blockoverride "concept_link" { text = "[religion|E]" }
								}
							}

							background = {
								using = bg_round_corners_alt_texture
								modify_texture = {
									color = "[ReformationReligionItem.GetColor]"
								}
							}

							hbox = {
								using = layoutpolicy_expanding
								expand = {}
								icon = {
									size = { 22 22 }
									texture = "[GetReligionIcon(ReformationReligionItem.GetReligion.Self)]"
								}
								text_single = {
									text = "[ReformationReligionItem.GetReligion.GetNumCountries]"
								}
								expand = {}
							}
						}
					}
				}
			}

			filtered_sorted_list = {
				datacontext = "[SituationView.GetReformationCountriesSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(SituationView.GetReformationCountryItems)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MEMBERS_SCROLL_LIST_EMPTY"
				}

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "name"
						layoutpolicy_vertical = expanding
						size = { 190 -1 }
					}
					sort_by_key_button = {
						name = "gp"
						layoutpolicy_vertical = expanding
						size = { 50 -1 }
					}
					sort_by_key_button = {
						name = "opinion"
						layoutpolicy_vertical = expanding
						size = { 70 -1 }
					}
					sort_by_key_button = {
						name = "religion"
						layoutpolicy_vertical = expanding
						size = { 200 -1 }
					}
					expand = {}
				}

				blockoverride "scroll_list_layout" {
					fixedgridbox = {
						addcolumn = 100%
						addrow = 35

						datamodel = "[SituationView.GetReformationCountryItems]"
						item = {
							widget = {
								size = { 100% 35 }
								situation_member_country_row = {
									blockoverride "situation_member_leader_bg" {}

									blockoverride "situation_member_country_row_rank" {}

									blockoverride "situation_member_country_datacontext" {
										datacontext = "[ReformationCountryItem.GetCountry]"
									}
									blockoverride "situation_member_extra_columns" {
										divider_flavor_01 = { size = {8 -1} }
										hbox = {
											icon = {
												size = { 26 26 }
												texture = "[GetReligionIcon(ReformationCountryItem.GetReligion.Self)]"
												texture_density = 2
											}
	
											text_single = {
												align = right|nobaseline
												maximumsize = { 140 -1 }
												text = "[ReformationCountryItem.GetReligion.GetNameWithNoTooltip]"
											}
										}
									}
								}
							}
						}

						expand = {}
					}
				}
			}

			expand = {}
		}
	}
}
