	}

	##################################### MEMBERS TAB ######################################

	blockoverride "situation_extra_tab_panels" {
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'situation_members' )]"
			using = bg_secondary_inner_alt
			margin = { 10 10 }
			spacing = 4

			blockoverride "searchbar_extra_pre_content" {
				# League filter buttons
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin_top = 4
	
					datamodel = "[SituationView.GetItalianWarsLeagueItems]"
					item = {

						header_button_left = {
							layoutpolicy_horizontal = expanding
							size = { -1 34 }
							blockoverride "button_icon_stretch_sprite" {}
							blockoverride "header_button_frame_inner" { visible = no }
							blockoverride "header_button_text_layout" {}
							blockoverride "icon_overlay" {}
							blockoverride "icon_texture" {
								# size = { 100% 100% }
								# parentanchor = center
								# texture = "gfx/interface/icons/flat_icons/balance/foreign_loan.dds"
							}

							hbox = {
								using = layoutpolicy_expanding
								spacing = 4
								expand = {}
								icon = {
									size = { 28 28 }
									texture = "[ItalianWarsLeagueItem.GetIcon]"
								}
								text_single = {
									text = "[ItalianWarsLeagueItem.GetCount]"
								}
								expand = {}
							}
							
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[ItalianWarsLeagueItem.GetIcon]"
										}
									}
									blockoverride "title_text" { text = "[ItalianWarsLeagueItem.GetTitle]" }
									blockoverride "concept_link" { text = "[international_organization|e]" }
								}
							}
	
							action_tooltip = {
								title = "TOGGLE_FILTER"
								on_action = "[SituationView.ToggleItalianWarsLeagueFilter( ItalianWarsLeagueItem.GetKey )]"
							}
							down = "[SituationView.IsItalianWarsLeagueFilterEnabled( ItalianWarsLeagueItem.GetKey )]"
						}
					}
				}
			}

			# Sorted + searchable member list
			filtered_sorted_list = {
				datacontext = "[SituationView.GetItalianWarsMembersSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(SituationView.GetItalianWarsMemberItems)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MEMBERS_SCROLL_LIST_EMPTY"
				}

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "rank"
						layoutpolicy_vertical = expanding
						size = { 38 -1 }
					}
					sort_by_key_button = {
						name = "name"
						layoutpolicy_vertical = expanding
						size = { 190 -1 }
					}
					expand = {}
					sort_by_key_button = {
						name = "dip"
						layoutpolicy_vertical = expanding
						size = { 146 -1 }
					}
					sort_by_key_button = {
						name = "location"
						layoutpolicy_vertical = expanding
						size = { 64 -1 }
					}
				}

				blockoverride "scroll_list_layout" {
					vbox = {
						using = layoutpolicy_expanding
						margin_bottom = 20
						bottomtotop = yes

						datamodel = "[SituationView.GetItalianWarsMemberItems]"
						item = {
							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 35 }
								italian_wars_member_country_row = {}
							}
						}

						expand = {}
					}
				}
			}

			expand = {}
		}
	}

	# blockoverride "action_group_header" { using = bg_war_situation_main_header }
}

