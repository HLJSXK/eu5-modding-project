types GagTypes
{
	type gag_faction_barchart_widget = widget {
		using = bg_cabinet_card_frame
		layoutpolicy_horizontal = expanding
		size = { -1 19 }
		barchart = {
			layoutpolicy_horizontal = expanding
			parentanchor = center
			size = { 180 14 }
			block "bar_direction" {}
			block "bar_datamodel" {
				datamodel = "[GetUniqueInternationalOrganization('guelphs_io').GetMembers]"
			}
			item = {
				barslice = {
					texture = "gfx/interface/progressbars/progress_bar_whiteish.dds"
					color = "[Country.GetMapColor]"
					block "bar_slice_value" {
						value = "[Country.GetCountryGuelphsProgress]"
					}
				}
			}
			barslice_no_highlight = {
				texture = "gfx/interface/progressbars/progress_bar_whiteish.dds"
				color = { 0 0 0 1 }
				block "bar_remainder_value" {
					value = "[Subtract_float('(float)1.0', FixedPointToFloat(GetUniqueInternationalOrganization('guelphs_io').GetVariable('guelphs_progress')))]"
				}
			}
		}
	}

	type gag_faction_member_row = widget {
		layoutpolicy_horizontal = expanding
		size = { 98% 32 }
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 4
			margin = { 4 0 }
			margin_top = 2
			using = bg_paper_card
			background = {
				visible = "[Or(GetUniqueInternationalOrganization('ghibellines_io').IsIOLeaderCountry(GagCountryItem.GetCountry), GetUniqueInternationalOrganization('guelphs_io').IsIOLeaderCountry(GagCountryItem.GetCountry))]"
				using = color_purple_texture
				margin = { 1 1 }
				margin_bottom = 2
				alpha = 0.4
			}
			using = bg_cabinet_card_frame

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				datacontext = "[GagCountryItem.GetCountry]"

				country_flag_small = {
					tooltipwidget = {
						using = CountryTooltip
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					maximumsize = { 120 -1 }
					text = "[Country.GetName]"
				}
			}

			divider_flavor_01 = { size = {6 -1} }

			text_single = {
				minimumsize = { 40 -1 }
				maximumsize = { 40 -1 }
				align = center
				raw_text = "+[GagCountryItem.GetCountryProgressMonthly|G3%]"
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_MONTHLY_TT_TITLE" }
						blockoverride "title_icon_texture" {
							texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
						}
						blockoverride "tooltip_content" {
							TooltipTextBlock = {
								blockoverride "text" {
									text = "GAG_COUNTRY_PROGRESS_MONTHLY_TT"
								}
							}
						}
					}
				}
			}

			divider_flavor_01 = { size = {6 -1} }

			text_single = {
				minimumsize = { 40 -1 }
				maximumsize = { 40 -1 }
				align = center
				text = "[GagCountryItem.GetCountryProgress|V3%]"
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_TT_TITLE" }
						blockoverride "title_icon_texture" {
							texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
						}
						blockoverride "tooltip_content" {
							TooltipTextBlock = {
								blockoverride "text" {
									text = "GAG_COUNTRY_PROGRESS_TT"
								}
							}
						}
					}
				}
			}

			expand = {}
		}
	}
}

situation_panel = {

	##################################### TOP HEADER #####################################

	# GUELPHS LEADER - replaces piechart
	blockoverride "situation_header_left" {
		datacontext = "[GetUniqueInternationalOrganization('guelphs_io')]"

		hbox = {
			spacing = 4

			icon = {
				size = { 40 40 }
				texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
				texture_density = 2
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" { text = "GAG_GUELPHS_TITLE" }
						blockoverride "title_icon_texture" {
							texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
						}
						blockoverride "tooltip_content" {
							TooltipTextBlock = {
								blockoverride "text" {
									text = "GUELPHS_PROGRESS_TOOLTIP_TEXT"
								}
							}
							TooltipTextBlock = {
								blockoverride "text" {
									text = "GUELPHS_PROGRESS_TOOLTIP_CONTEXT"
								}
							}
						}
					}
				}
			}
			
			vbox = {
				layoutpolicy_horizontal = expanding
				
				text_single = {
					align = left
					minimumsize = { 110 -1 }
					maximumsize = { 110 18 }
					text = "GAG_GUELPH_LEADER"
					default_format = "#subtle_name"
				}
				
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					datacontext = "[InternationalOrganization.GetLeaderCountry]"
					visible = "[Country.IsValid]"
					country_flag_very_small = {}
					text_single = {
						autoresize = yes
						align = right
						maximumsize = { 110 18 }
						text = "[Country.GetName]"
					}
					expand = {}
				}
			}
		}
	}

	blockoverride "situation_header_center" {
		icon = {
			size = { 40 40 }
			texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
			texture_density = 2
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" { text = "GAG_VICTORY_CONDITIONS_TITLE" }
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
					}
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "GAG_GUELPHS_VICTORY_TT"
							}
						}
						TooltipTextBlock = {
							blockoverride "text" {
								text = "GAG_GHIBELLINES_VICTORY_TT"
							}
						}
						TooltipTextBlock = {
							blockoverride "text" {
								text = "GAG_STALEMATE_TT"
							}
						}
					}
				}
			}
		}
	}

	# GHIBELLINES LEADER - replaces piechart
	blockoverride "situation_header_right" {
		datacontext = "[GetUniqueInternationalOrganization('ghibellines_io')]"

		hbox = {
			spacing = 4
			
			vbox = {
				layoutpolicy_horizontal = expanding
				
				text_single = {
					align = right
					minimumsize = { 110 -1 }
					maximumsize = { 110 18 }
					text = "GAG_GHIBELLINES_LEADER"
					default_format = "#subtle_name"
				}
				
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					datacontext = "[InternationalOrganization.GetLeaderCountry]"
					visible = "[Country.IsValid]"
					expand = {}
					text_single = {
						autoresize = yes
						align = right
						maximumsize = { 110 18 }
						text = "[Country.GetName]"
					}
					country_flag_very_small = {}
				}
			}

			icon = {
				size = { 40 40 }
				texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
				texture_density = 2
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" { text = "GAG_GHIBELLINES_TITLE" }
						blockoverride "title_icon_texture" {
							texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
						}
						blockoverride "tooltip_content" {
							TooltipTextBlock = {
								blockoverride "text" {
									text = "GHIBELLINES_PROGRESS_TOOLTIP_TEXT"
								}
							}
							TooltipTextBlock = {
								blockoverride "text" {
									text = "GHIBELLINES_PROGRESS_TOOLTIP_CONTEXT"
								}
							}
						}
					}
				}
			}
		}
	}

	##################################### MAIN IMAGE #####################################

	blockoverride "situation_panel_image" {
		using = two_countries_header_template

		blockoverride "FirstCountryContext" {
			datacontext = "[GetCountry('PAP')]"
		}

		blockoverride "SecondCountryContext" {
			datacontext = "[GetUniqueInternationalOrganization('hre').GetLeaderCountry]"
		}

		blockoverride "first_character_portrait_anchor" {
			parentanchor = bottom|left
		}

		blockoverride "second_character_portrait_anchor" {
			parentanchor = bottom|right
		}

		blockoverride "character_role" {
			datacontext = "[Character.GetRuledCountry]"
			country_flag_small = {}
		}

		blockoverride "character_religion_visibility" {
			visible = no
		}

		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}

		blockoverride "country_header_extra" {
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 10 10 }
				spacing = 8

				expand = {}
			}
		}
	}

	##################################### SUBHEADER #####################################
	blockoverride "situation_subheader_content"{}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_maximumsize" {
		minimumsize = { -1 325 }
	}

	blockoverride "situation_panel_main_content" {

		# Progress Race Bar — first building block
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 80 }
				background = {
					texture = "gfx/interface/component_decoration/situation/white_banner.dds"
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					maximumsize = { 195 70 }
					margin = { 5 8 }
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						icon = {
							size = { 32 32 }
							texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
							texture_density = 2
						}
						vbox = {
							text_single = {
								fontsize = 13
								text = "[GetUniqueInternationalOrganization('guelphs_io').GetNameWithNoTooltip]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								fontsize = 13
								text = "[GetUniqueInternationalOrganization('guelphs_io').GetVariable('guelphs_progress')|%2V]"
							}
						}
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" { text = "GAG_GUELPHS_TITLE" }
								blockoverride "title_icon_texture" {
									texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" {
											text = "GUELPHS_PROGRESS_TOOLTIP_TEXT"
										}
									}
									TooltipTextBlock = {
										blockoverride "text" {
											text = "GUELPHS_PROGRESS_TOOLTIP_CONTEXT"
										}
									}
								}
							}
						}
						expand = {}
					}
					gag_faction_barchart_widget = {
						blockoverride "bar_direction" {
							righttoleft = yes
						}
						tooltipwidget = {
							using = gag_progress_bar_tooltip
						}
					}
				}
			}
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 80 }
				background = {
					texture = "gfx/interface/component_decoration/situation/red_banner.dds"
					mirror = horizontal
				}
				vbox = {
					parentanchor = right
					margin = { 5 8 }
					layoutpolicy_horizontal = expanding
					maximumsize = { 195 70 }
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						expand = {}
						vbox = {
							text_single = {
								fontsize = 13
								text = "[GetUniqueInternationalOrganization('ghibellines_io').GetNameWithNoTooltip]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								align = right
								fontsize = 13
								text = "[GetUniqueInternationalOrganization('ghibellines_io').GetVariable('ghibellines_progress')|%2V]"
							}
						}
						icon = {
							size = { 32 32 }
							texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
							texture_density = 2
						}
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" { text = "GAG_GHIBELLINES_TITLE" }
								blockoverride "title_icon_texture" {
									texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" {
											text = "GHIBELLINES_PROGRESS_TOOLTIP_TEXT"
										}
									}
									TooltipTextBlock = {
										blockoverride "text" {
											text = "GHIBELLINES_PROGRESS_TOOLTIP_CONTEXT"
										}
									}
								}
							}
						}
					}
					gag_faction_barchart_widget = {
						blockoverride "bar_datamodel" {
							datamodel = "[GetUniqueInternationalOrganization('ghibellines_io').GetMembers]"
						}
						blockoverride "bar_slice_value" {
							value = "[Country.GetCountryGhibellinesProgress]"
						}
						blockoverride "bar_remainder_value" {
							value = "[Subtract_float('(float)1.0', FixedPointToFloat(GetUniqueInternationalOrganization('ghibellines_io').GetVariable('ghibellines_progress')))]"
						}
						blockoverride "bar_progress_text" {
							text = "[Country.GetCountryGhibellinesProgress|V1%]"
						}
						tooltipwidget = {
							using = gag_progress_bar_tooltip
							blockoverride "bar_tooltip_title" {
								text = "GAG_GHIBELLINES_TITLE"
							}
							blockoverride "bar_tooltip_icon" {
								texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
							}
							blockoverride "tooltip_bar_datamodel" {
								datamodel = "[GetUniqueInternationalOrganization('ghibellines_io').GetMembers]"
							}
							blockoverride "bar_slice_value" {
								value = "[Country.GetCountryGhibellinesProgress]"
							}
							blockoverride "bar_progress_text" {
								text = "[Country.GetCountryGhibellinesProgress|V3%]"
							}
							blockoverride "bar_remainder_value" {
								value = "[Subtract_float('(float)1.0', FixedPointToFloat(GetUniqueInternationalOrganization('ghibellines_io').GetVariable('ghibellines_progress')))]"
							}
						}
					}
				}
			}
		}
	}

	##################################### MEMBERS TAB BUTTON #####################################

	blockoverride "situation_extra_tabs_content" {
		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			blockoverride "tab_text" { text = "SITUATION_MEMBERS" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'situation_members' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'situation_members' )]"
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/international_organizations/special_statuses/members.dds"
					}
					blockoverride "title_text" { text = "SITUATION_MEMBERS" }
					blockoverride "concept_link" { text = "[situation|e]" }
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "SITUATION_MEMBERS_TT_TEXT"
							}
						}
					}
				}
			}
		}
	}

	##################################### MEMBERS TAB CONTENT #####################################

	blockoverride "situation_extra_tab_panels" {
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'situation_members' )]"
			using = bg_secondary_inner_alt
			margin = { 10 10 }
			spacing = 4

			blockoverride "searchbar_extra_pre_content" {
				# Faction filter buttons
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin_top = 4

					datamodel = "[SituationView.GetGagFactionItems]"
					item = {
						card_header_button_04 = {
							allow_outside = yes
							size = { 250 30 }

							# background = {
							# 	texture = "gfx/interface/buttons/bg_navigational_header_button.dds"
							# 	texture_density = 2
							# 	spriteType = corneredstretched
							# 	spriteborder = { 42 20 }
							# 	mirror = horizontal
							# }

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[GagFactionItem.GetIcon]"
										}
									}
									blockoverride "title_text" { text = "[GagFactionItem.GetTitle]" }
									blockoverride "concept_link" { text = "[international_organization|e]" }
								}
							}

							action_tooltip = {
								title = "TOGGLE_FILTER"
								on_action = "[SituationView.ToggleGagFactionFilter( GagFactionItem.GetKey )]"
							}
							down = "[SituationView.IsGagFactionFilterEnabled( GagFactionItem.GetKey )]"

							hbox = {
								using = layoutpolicy_expanding
								icon = {
									size = { 28 28 }
									texture = "[GagFactionItem.GetIcon]"
								}
								text_single = {
									text = "[GagFactionItem.GetTitle]"
								}
								text_single = {
									text = "[GagFactionItem.GetCount]"
								}
							}
						}
					}
				}
			}

			# Sorted + searchable member list
			filtered_sorted_list = {
				datacontext = "[SituationView.GetGagMembersSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(SituationView.GetGagMemberItems)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MEMBERS_SCROLL_LIST_EMPTY"
				}

				blockoverride "searchbar_top_extra" {
					header_button_right = {
						visible = "[Not(SituationView.Vars.Exists( 'gag_situation_members_view_toggle' ))]"
						size = { 30 30 }
						blockoverride "button_icon_stretch_sprite" {}
						blockoverride "header_button_frame_inner" { visible = no }
						blockoverride "header_button_icon_size" { size = { 30 30 } }
						blockoverride "header_button_text_layout" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/flat_icons/menu_icon_square.dds"
							texture_density = 2
						}
						action_tooltip = {
							title = "HRE_MEMBERS_VIEW_FLAGS"
							on_action = "[SituationView.Vars.Toggle( 'gag_situation_members_view_toggle' )]"
						}
						tooltipwidget = { BasicFunctionalTooltip = {} }
					}
					header_button_right = {
						visible = "[SituationView.Vars.Exists( 'gag_situation_members_view_toggle' )]"
						size = { 30 30 }
						blockoverride "button_icon_stretch_sprite" {}
						blockoverride "header_button_frame_inner" { visible = no }
						blockoverride "header_button_icon_size" { size = { 30 30 } }
						blockoverride "header_button_text_layout" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/flat_icons/menu_icon.dds"
							texture_density = 2
						}
						action_tooltip = {
							title = "HRE_MEMBERS_VIEW_LIST"
							on_action = "[SituationView.Vars.Toggle( 'gag_situation_members_view_toggle' )]"
						}
						tooltipwidget = { BasicFunctionalTooltip = {} }
					}
				}

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "rank"
						layoutpolicy_vertical = expanding
						size = { 38 -1 }
					}
					sort_by_key_button = {
						name = "name"
						layoutpolicy_vertical = expanding
						size = { 194 -1 }
					}
					sort_by_key_button = {
						name = "gp"
						layoutpolicy_vertical = expanding
						size = { 45 -1 }
					}
					sort_by_key_button = {
						name = "opinion"
						layoutpolicy_vertical = expanding
						size = { 74 -1 }
					}
					sort_by_key_button = {
						name = "tax_base"
						layoutpolicy_vertical = expanding
						size = { 78 -1 }
					}
					sort_by_key_button = {
						name = "experience"
						layoutpolicy_vertical = expanding
						size = { 76 -1 }
					}
					expand = {}
				}

				blockoverride "scroll_list_layout" {
					vbox = {
						using = layoutpolicy_expanding
						using = bg_secondary_inner_alt
						margin_bottom = 20
						spacing = 10

						special_card_header_button = {
							visible = "[SituationView.Vars.Exists( 'gag_situation_members_view_toggle' )]"
							blockoverride "special_card_button_color" {
								using = bg_card_header_01_diplomacy
							}
							blockoverride "card_header_button_icon_texture" {
								texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
								texture_density = 2
							}
							blockoverride "card_header_button_raw_text" {
								raw_text = "GAG_GUELPHS_TITLE_NO_TOOLTIP"
							}
							blockoverride "card_header_button_header_extra_content" {}
							blockoverride "bottom_content" {
								block "members_item_content" {
									hbox = {
										layoutpolicy_horizontal = expanding
										margin = { 0 10 }
										dynamicgridbox = {
											flipdirection = yes
											datamodel_wrap = 14
											datamodel = "[GetUniqueInternationalOrganization('guelphs_io').GetMembers]"
											item = {
												country_flag_small = {}
											}
										}
									}
								}
							}
						}

						special_card_header_button = {
							visible = "[SituationView.Vars.Exists( 'gag_situation_members_view_toggle' )]"
							blockoverride "special_card_button_color" {
								using = bg_card_header_01_diplomacy
							}
							blockoverride "card_header_button_icon_texture" {
								texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
								texture_density = 2
							}
							blockoverride "card_header_button_raw_text" {
								raw_text = "GAG_GHIBELLINES_TITLE_NO_TOOLTIP"
							}
							blockoverride "card_header_button_header_extra_content" {}
							blockoverride "bottom_content" {
								block "members_item_content" {
									hbox = {
										layoutpolicy_horizontal = expanding
										margin = { 0 10 }
										dynamicgridbox = {
											flipdirection = yes
											datamodel_wrap = 14
											datamodel = "[GetUniqueInternationalOrganization('ghibellines_io').GetMembers]"
											item = {
												country_flag_small = {}
											}
										}
									}
								}
							}
						}

						vbox = {
							visible = "[Not(SituationView.Vars.Exists( 'gag_situation_members_view_toggle' ))]"
							layoutpolicy_horizontal = expanding
							datamodel = "[SituationView.GetGagMemberItems]"
							item = {
								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 35 }
									situation_member_country_row = {
										blockoverride "situation_member_gp" {}
										blockoverride "situation_member_opinion" {}
										blockoverride "situation_member_extra_columns" {
											divider_flavor_01 = { size = { 8 -1 } }
											action_button_regular = {
												visible = yes
												size = { 60 25 }
												fontsize = 13
												text = "IW_INVITE_SHORT"
												actor = "[SituationView.GetPlayer]"
												left_action = {
													action_name = "invite_to_international_organization"
													action_direction = "offer"
													parameter = {
														parameter_name = "international_organization"
														parameter_value = "[SituationView.GetGagPlayerFactionIO]"
													}
													parameter = {
														parameter_name = "recipient"
														parameter_value = "[GagCountryItem.GetCountry]"
													}
												}
												enabled = "[And(SituationView.IsPlayerGagFactionLeader, UIAction.IsEnabled)]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" { text = "GAG_INVITE_TO_FACTION_TITLE" }
														blockoverride "concept_link" { text = "[action|E]" }
														blockoverride "title_icon_texture" {
															texture = "gfx/interface/icons/location_icons/diplomacy.dds"
														}
														blockoverride "tooltip_content" {
															TooltipFlavorTextBlock = {
																visible = "[And(SituationView.IsPlayerGagFactionLeader, UIAction.IsVisible)]"
																blockoverride "text" { text = "[UIAction.GetDescription]" }
															}
															TooltipRowList = {
																visible = "[And(SituationView.IsPlayerGagFactionLeader, And(UIAction.IsVisible, Not(StringIsEmpty(UIAction.GetEffects))))]"
																textcontext = "[UIAction.GetEffects]"
															}
															TooltipRowList = {
																visible = "[And(SituationView.IsPlayerGagFactionLeader, And(UIAction.IsVisible, Not(StringIsEmpty(UIAction.GetConditions))))]"
																textcontext = "[UIAction.GetConditions]"
															}
															TooltipTextBlock = {
																visible = "[And(SituationView.IsPlayerGagFactionLeader, Not(UIAction.IsVisible))]"
																blockoverride "text" { text = "GAG_INVITE_TARGET_IN_FACTION_TT" }
															}
															TooltipTextBlock = {
																visible = "[And(SituationView.IsPlayerInGagFaction, Not(SituationView.IsPlayerGagFactionLeader))]"
																blockoverride "text" { text = "GAG_INVITE_NOT_FACTION_LEADER_TT" }
															}
															TooltipTextBlock = {
																visible = "[Not(SituationView.IsPlayerInGagFaction)]"
																blockoverride "text" { text = "GAG_INVITE_NOT_IN_FACTION_TT" }
															}
														}
													}
												}
											}
											divider_flavor_01 = { size = { 8 -1 } }
											hbox = {
												minimumsize = { 55 -1 }
												maximumsize = { 55 -1 }
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" { text = "GAG_INVITE_ACCEPTANCE_TITLE" }
														blockoverride "title_icon_texture" {
															texture = "gfx/interface/icons/location_icons/diplomacy.dds"
														}
														blockoverride "tooltip_content" {
															TooltipTextBlock = {
																visible = "[GagCountryItem.IsInSameFactionAsPlayer]"
																blockoverride "text" { text = "GAG_INVITE_TARGET_IN_FACTION_TT" }
															}
															TooltipTextBlock = {
																visible = "[And(SituationView.IsPlayerInGagFaction, Not(SituationView.IsPlayerGagFactionLeader))]"
																blockoverride "text" { text = "GAG_INVITE_NOT_FACTION_LEADER_TT" }
															}
															TooltipTextBlock = {
																visible = "[Not(SituationView.IsPlayerInGagFaction)]"
																blockoverride "text" { text = "GAG_INVITE_NOT_IN_FACTION_TT" }
															}
															TooltipScrolledStringPairList = {
																ontextcontextchanged = "[SetStringPairListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
																visible = "[Not(StringIsEmpty(GagCountryItem.GetInviteAcceptanceTooltip))]"
																blockoverride "block_scrollarea" { maximumsize = { -1 200 } }
																textcontext = "[GagCountryItem.GetInviteAcceptanceTooltip]"
															}
														}
													}
												}
												text_single = {
													visible = "[And(SituationView.IsPlayerGagFactionLeader, Not(GagCountryItem.IsInSameFactionAsPlayer))]"
													align = center
													text = "[GagCountryItem.GetInviteAcceptanceScore|+=2]"
												}
												text_single = {
													visible = "[Not(And(SituationView.IsPlayerGagFactionLeader, Not(GagCountryItem.IsInSameFactionAsPlayer)))]"
													align = center
													text = "-"
												}
											}

											divider_flavor_01 = { size = {8 -1} }
				
											text_single = {
												minimumsize = { 60 -1 }
												maximumsize = { 60 -1 }
												align = center
												default_format = "#G"
												raw_text = "+[GagCountryItem.GetCountryProgressMonthly|G3%]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_MONTHLY_TT_TITLE" }
														blockoverride "title_icon_texture" {
															texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
														}
														blockoverride "tooltip_content" {
															TooltipTextBlock = {
																blockoverride "text" {
																	text = "GAG_COUNTRY_PROGRESS_MONTHLY_TT"
																}
															}
														}
													}
												}
											}
											divider_flavor_01 = { size = {8 -1} }
											
											text_single = {
												minimumsize = { 60 -1 }
												maximumsize = { 60 -1 }
												align = center
												text = "[GagCountryItem.GetCountryProgress|V3%]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_TT_TITLE" }
														blockoverride "title_icon_texture" {
															texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
														}
														blockoverride "tooltip_content" {
															TooltipTextBlock = {
																blockoverride "text" {
																	text = "GAG_COUNTRY_PROGRESS_TT"
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}

						expand = {}
					}
				}
			}

			expand = {}
		}
	}

	blockoverride "situation_main_content_extra" {
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			layoutstretchfactor_vertical = 1000
			spacing = 8

			# Guelphs column
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				layoutstretchfactor_horizontal = 1
				minimumsize = { -1 90 }

				using = bg_paper_card_fancy

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 40 }

					using = bg_generic_shadow
					using = bg_card_header_01
					using = bg_card_header_texture
					using = bg_generic_side_mask

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						header_button_left = {
							layoutpolicy_horizontal = expanding
							size = { -1 40 }
							datacontext = "[GetUniqueInternationalOrganization('guelphs_io')]"

							action_tooltip = {
								click_type = left
								title = "OPEN_IO"
								using = snd_UI_alert_openAndCycle
								on_action = "[OpenInternationalOrganizationView(InternationalOrganization.Self)]"
							}

							tooltipwidget = { BasicFunctionalTooltip = {} }

							blockoverride "header_button_icon_obj" {
								icon = {
									size = { 40 40 }
									texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
									texture_density = 2
									position = { 4 -1 }
								}
							}
							blockoverride "header_button_frame_inner" { visible = no }

							blockoverride "header_button_text_layout" {
								background = {
									texture = "gfx/interface/component_decoration/situation/white_bckg.dds"
									margin = { -2 -2 }
								}
								hbox = {
									layoutpolicy_horizontal = expanding
									minimumsize = { -1 40 }
									margin = { 4 0 }
									margin_right = 16


									text_single = {
										fontsize = 15
										minimumsize = { -1 20 }
										autoresize = yes
										align = left
										text = "GAG_GUELPHS_TITLE_NO_TOOLTIP"
									}

									expand = {}

									text_single = {
										fontsize = 15
										autoresize = yes
										align = left
										text = "[GetUniqueInternationalOrganization('guelphs_io').GetVariable('guelphs_progress')|%2V]"
									}

								}
							}
						}
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 4 6 }

					filtered_sorted_list = {
						datacontext = "[SituationView.GetGagGuelphsMembersSortSearch]"

						blockoverride "searchbar_visible" { visible = no }

						blockoverride "sort_buttons_filtered_list" {
							sort_by_key_button = {
								name = "name"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
							}
							sort_by_key_button = {
								name = "tax_base"
								layoutpolicy_vertical = expanding
								size = { 52 -1 }
							}
							sort_by_key_button = {
								name = "experience"
								layoutpolicy_vertical = expanding
								size = { 52 -1 }
							}
						}

						blockoverride "scroll_list_layout" {
							fixedgridbox = {
								addcolumn = 100%
								addrow = 34
								maxhorizontalslots = 1

								datamodel = "[SituationView.GetGagGuelphsMemberItems]"
								item = {
									gag_faction_member_row = {}
								}
							}
						}
					}
				}
			}

			# Ghibellines column
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				layoutstretchfactor_horizontal = 1
				minimumsize = { -1 90 }

				using = bg_paper_card_fancy

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 40 }

					using = bg_generic_shadow
					using = bg_card_header_01
					using = bg_card_header_texture
					using = bg_generic_side_mask

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						header_button_left = {
							layoutpolicy_horizontal = expanding
							size = { -1 40 }
							datacontext = "[GetUniqueInternationalOrganization('ghibellines_io')]"

							action_tooltip = {
								click_type = left
								title = "OPEN_IO"
								using = snd_UI_alert_openAndCycle
								on_action = "[OpenInternationalOrganizationView(InternationalOrganization.Self)]"
							}

							tooltipwidget = { BasicFunctionalTooltip = {} }

							blockoverride "header_button_icon_obj" {
								icon = {
									size = { 40 40 }
									texture = "gfx/interface/icons/international_organizations/ghibellines_io.dds"
									texture_density = 2
									position = { 4 -1 }
								}
							}
							blockoverride "header_button_frame_inner" { visible = no }

							blockoverride "header_button_text_layout" {
								background = {
									texture = "gfx/interface/component_decoration/situation/red_bckg.dds"
									margin = { -2 -2 }
								}
								hbox = {
									layoutpolicy_horizontal = expanding
									minimumsize = { -1 40 }
									margin = { 4 0 }
									margin_right = 16

									text_single = {
										fontsize = 15
										minimumsize = { -1 20 }
										autoresize = yes
										align = left
										text = "GAG_GHIBELLINES_TITLE_NO_TOOLTIP"
									}

									expand = {}

									text_single = {
										fontsize = 15
										autoresize = yes
										align = left
										text = "[GetUniqueInternationalOrganization('ghibellines_io').GetVariable('ghibellines_progress')|%2V]"
									}

								}
							}
						}
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 4 6 }

					filtered_sorted_list = {
						datacontext = "[SituationView.GetGagGhibellinesMembersSortSearch]"

						blockoverride "searchbar_visible" { visible = no }

						blockoverride "sort_buttons_filtered_list" {
							sort_by_key_button = {
								name = "name"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
							}
							sort_by_key_button = {
								name = "tax_base"
								layoutpolicy_vertical = expanding
								size = { 52 -1 }
							}
							sort_by_key_button = {
								name = "experience"
								layoutpolicy_vertical = expanding
								size = { 52 -1 }
							}
						}

						blockoverride "scroll_list_layout" {
							fixedgridbox = {
								addcolumn = 100%
								addrow = 34
								maxhorizontalslots = 1

								datamodel = "[SituationView.GetGagGhibellinesMemberItems]"
								item = {
									gag_faction_member_row = {}
								}
							}
						}
					}
				}
			}
		}
	}
}

template gag_progress_bar_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			block "bar_tooltip_title" {
				text = "GAG_GUELPHS_TITLE"
			}
		}
		blockoverride "title_icon_texture" {
			block "bar_tooltip_icon" {
				texture = "gfx/interface/icons/international_organizations/guelphs_io.dds"
			}
		}
		blockoverride "tooltip_content" {
			widget = {
				using = bg_cabinet_card_frame
				layoutpolicy_horizontal = expanding
				size = { -1 25 }
				barchart = {
					layoutpolicy_horizontal = expanding
					size = { 402 20 }
					parentanchor = center
					righttoleft = yes
					block "tooltip_bar_datamodel" {
						datamodel = "[GetUniqueInternationalOrganization('guelphs_io').GetMembers]"
					}
					item = {
						barslice = {
							texture = "gfx/interface/progressbars/progress_bar_whiteish.dds"
							color = "[Country.GetMapColor]"
							block "bar_slice_value" {
								value = "[Country.GetCountryGuelphsProgress]"
							}
							tooltipwidget = {
								using = CountryTooltip
							}
						}
					}
					barslice_no_highlight = {
						texture = "gfx/interface/progressbars/progress_bar_whiteish.dds"
						color = { 0 0 0 1 }
						block "bar_remainder_value" {
							value = "[Subtract_float('(float)1.0', FixedPointToFloat(GetUniqueInternationalOrganization('guelphs_io').GetVariable('guelphs_progress')))]"
						}
					}
				}
			}
			vbox = {
				layoutpolicy_vertical = expanding
				size = { -1 200 }
				margin = { 5 0 }
				background = {
					using = tile_background_squared_texture
					modify_texture = {
						using = color_black_texture
					}
					alpha = 0.1
				}
				scrollarea = {
					size = { 400 200 }
					scrollbarpolicy_horizontal = always_off
					autoresizeviewport = yes
					viewportwidget = {
						widget = {
							scissor = yes
						}
					}
					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}
					scrollwidget = {
						fixedgridbox = {
							addrow = 35
							addcolumn = 100%
							block "tooltip_bar_datamodel" {
								datamodel = "[GetUniqueInternationalOrganization('guelphs_io').GetMembers]"
							}
							item = {
								widget = {
									size = { 98% 30 }
									hbox = {
										margin = { 10 5 }
										spacing = 5
										background = {
											visible = "[IsEven_int32(PdxGuiWidget.GetIndexInDataModel)]"
											using = color_whiteish_texture
											alpha = 0.2
										}
										icon = {
											size = { 20 20 }
											texture = "gfx/interface/component_tiles/bookmark_white.dds"
											modify_texture = {
												using = overlay_cloth_texture
												blend_mode = overlay
												alpha = 0.3
											}
											color = "[Country.GetMapColor]"
											glow = {
												name = "drop_shadow"
												glow_radius = 3
												color = { 0.0 0.0 0.0 1.0 }
												alpha = 0.2
											}
										}
										country_flag_very_small = {}
										text_single = {
											using = layoutpolicy_expanding
											align = left|nobaseline
											text = "[Country.GetName]"
										}
										text_single = {
											autoresize = yes
											align = right|nobaseline
											block "bar_progress_text" {
												text = "[Country.GetCountryGuelphsProgress|V3%]"
											}
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" { text = "GAG_COUNTRY_PROGRESS_TT_TITLE" }
													blockoverride "title_icon_texture" {
														texture = "gfx/interface/icons/situations/guelphs_and_ghibellines.dds"
													}
													blockoverride "tooltip_content" {
														TooltipTextBlock = {
															blockoverride "text" {
																text = "GAG_COUNTRY_PROGRESS_TT"
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
