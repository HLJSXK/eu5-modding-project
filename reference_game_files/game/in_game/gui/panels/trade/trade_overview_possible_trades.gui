					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(TradeOverview.GetPossibleTrades)]"
					}
	
					blockoverride "scroll_list_is_empty_text" {
						text = "TRADE_OVERVIEW_CURRENT_TRADES_LIST_EMPTY"
					}
				}
			}
		}
