types PossibleTrades {
	type ExistingTradeProfitPerCapacityTooltip = ContextualTooltipType {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				size = { 48 48 }
				texture = "gfx/interface/icons/resources/gold.dds"
			}
		}

		blockoverride "title_text" {
			datacontext = "[Trade]"
			text = "PROFIT_EXISTING_TRADE_TT"
		}

		blockoverride "concept_link" {
			text = [trade_profit|e]
		}
		blockoverride "tooltip_content" {
			datacontext = "[Trade]"

			using = TradeProfitSummary
			using = TradeProfitDetails

			widget = {
				visible = "[Not(Trade.HasTradeHappened)]"
			
				size = { 440 28 }
				
				text_single = {
					text = "TRADE_NOT_YET_ACTIVE"
				}
			}	
		}
	}

	type ExistingTradeCard = widget {
		size = { 100% 100% }
		layoutpolicy_horizontal = expanding

		card_list_button = {
			modify_texture = {
				visible = "[Not(ObjectsEqual(Trade.GetOwner, Player.Self))]"
				using = color_grey_texture
				blend_mode = overlay
				alpha = 1
			}

			size = { 100% 100% }

			block "trade_ui_actions" {}

			onmousehierarchyenter = "[PdxGuiWidget.SetTradeLinesTrade(Trade.Self)]"

			tooltipwidget = {
				ContextualTooltipType = {
					datacontext = "[Trade.GetGoods]"
					blockoverride "title_icon" {
						button = {
							using = tooltip_title_icon_size
							size = { 48 48 }
							texture = "[GetGoodsIcon(Goods.Self)]"
							onclick = "[ShowGoods(Goods.Self)]"
							tooltipwidget = { using = Goods_tooltip	}
						}
					}
					
					blockoverride "title_text" {
						text = "[Goods.GetNameWithNoTooltip]"
					}
			
					blockoverride "concept_link" {
						text = [trade|E]
					}
					
					blockoverride "tooltip_content" {			
						using = trade_details
					}
				}
			}
		}

		hbox = {
			using = layoutpolicy_expanding
			margin = { 5 5 }
			margin_right = 5
			spacing = 8

			widget = {
				size = { 30 20 }
				block "sort_by_highlight_country_name" {}
				icon = {
					parentanchor = center
					size = { 20 20 }
					visible = "[And(ObjectsEqual(Trade.GetOwner, Player.Self), Trade.IsFromTradeOrder)]"
					texture = "gfx/interface/icons/flat_icons/trade_market/trade_order_cog.dds"
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "[GetConceptTexture('trade_order')]"
								}
							}

							blockoverride "concept_link" {
								text = "[trade|e]"
							}
							blockoverride "title_text" {
								text = "[trade_order]"
							}

							blockoverride "tooltip_content" {
								TooltipTextBlock = {
									blockoverride "text" {
										text = "TRADE_ORIGIN_TRADE_ORDER_TT"
									}
								}
							}
						}
					}
				}
				icon = {
					parentanchor = center
					size = { 20 20 }
					visible = "[And3(ObjectsEqual(Trade.GetOwner, Player.Self), Not(Trade.IsFromTradeOrder), Not(Trade.IsLocked))]"
					texture = "gfx/interface/buttons/checkbox_auto.dds"
					frame_grid = { 2 1 }
					frame = 2
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/buttons/checkbox_auto.dds"
									frame_grid = { 2 1 }
									frame = 2
								}
							}

							blockoverride "concept_link" {
								text = "[trade|e]"
							}
							blockoverride "title_text" {
								text = "MARKET_AUTOMATION"
							}

							blockoverride "tooltip_content" {
								TooltipTextBlock = {
									blockoverride "text" {
										text = "TRADE_ORIGIN_AUTOMATED_TT"
									}
								}
							}
						}
					}
				}
				icon = {
					parentanchor = center
					size = { 20 20 }
					visible = "[And3(ObjectsEqual(Trade.GetOwner, Player.Self), Trade.IsLocked, Not(Trade.IsFromTradeOrder))]"
					texture = "gfx/interface/icons/flat_icons/lock.dds"
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/flat_icons/lock.dds"
								}
							}

							blockoverride "concept_link" {
								text = "[trade|e]"
							}
							blockoverride "title_text" {
								text = "TRADE_PROTECTED_TITLE"
							}

							blockoverride "tooltip_content" {
								TooltipTextBlock = {
									blockoverride "text" {
										text = "TRADE_ORIGIN_PROTECTED_TT"
									}
								}
							}
						}
					}
				}
				country_flag_very_small = {
					visible = "[Not(ObjectsEqual(Trade.GetOwner, Player.Self))]"
					datacontext = "[Trade.GetOwner]"
				}
			}
	
			hbox = {
				margin_left = 2

				using = bg_number_container_bckg
				blockoverride "number_container_extra" {
					alpha = 0.4
					margin = {1 5}
				}
				
				button = {
					size = { 22 22 }
					texture = "[GetGoodsIcon(Trade.GetGoods)]"
					datacontext = "[Trade.GetGoods]"
					datacontext = "[GetPlayer]"
					
					tooltipwidget = {
						using = SpecificGoodsMarketTwoWay_tooltip
					}

					action_tooltip = {
						click_type = left
						click_mode = single
						title = "OPEN_GOOD_PANEL"
						on_action = "[ShowGoods(Trade.GetGoods)]"
					}

					action_tooltip = {
						click_type = right
						click_mode = single
						title = "GOODS_MARKET_CTXMENU_OPEN"
						on_action = "[PdxGuiWidget.ToggleContextMenu]"
					}

					contextmenu_widget = {
						GoodsMarketContextMenu = {}
					}
	
					block "sort_by_highlight_trade_good" {}	
				}
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				using = bg_number_container_bckg
				blockoverride "number_container_extra" {
					alpha = 0.4
					margin = {1 5}
				}

				widget = {
					size = {15 22}
					datacontext = "[Trade.GetFromMarket]"
					datacontext = "[Trade.GetFromMarket.GetMarketEntry(Trade.GetGoods)]"
					progressbar_framed = {
						parentanchor = center
						size = { 5 22 }
						using = progress_bar_green_alt
						min = 0
						max = "[FixedPointToFloat(Trade.GetFromMarket.GetCenterLocation.GetModifierValueFixed('maximum_stockpile_capacity'))]"
						value = "[FixedPointToFloat(GoodsMarketEntry.GetStockpile)]"
						direction = vertical
					}
					tooltipwidget = {
						using = GoodsMarketEntry_template
					}
	
					block "sort_by_highlight_stockpile" {}
				}

				block "trade_market_names" {
					text_single = { #IMPORTS (from the point of view of the Market you are looking at)
						visible = "[EqualTo_string(Market.GetNameWithNoTooltip, Trade.GetToMarket.GetNameWithNoTooltip)]"
						autoresize = no
						using = Font_Size_Small
						layoutpolicy_horizontal = expanding
						size = { -1 20 }
						default_format = "#subtle_name"
						text = "[Select_CString(Trade.IsExport, Localize('EXTERNAL_TC_IMPORT'), Localize('LOCAL_TC_IMPORT'))]"
		
						block "sort_by_highlight_markets" {}
					}
		
					text_single = { #EXPORTS (from the point of view of the Market you are looking at)
						visible = "[Not(EqualTo_string(Market.GetNameWithNoTooltip, Trade.GetToMarket.GetNameWithNoTooltip))]"
						autoresize = no
						using = Font_Size_Small
						layoutpolicy_horizontal = expanding
						size = { -1 20 }
						text = "[Select_CString(Trade.IsExport, Localize('LOCAL_TC_EXPORT'), Localize('EXTERNAL_TC_EXPORT'))]"
						default_format = "#subtle_name"
		
						block "sort_by_highlight_markets" {}
					}
				}
				widget = {
					size = {15 22}
					datacontext = "[Trade.GetToMarket]"
					datacontext = "[Trade.GetToMarket.GetMarketEntry(Trade.GetGoods)]"
					progressbar_framed = {
						parentanchor = center
						size = { 5 22 }
						using = progress_bar_green_alt
						min = 0
						max = "[FixedPointToFloat(Trade.GetToMarket.GetCenterLocation.GetModifierValueFixed('maximum_stockpile_capacity'))]"
						value = "[FixedPointToFloat(GoodsMarketEntry.GetStockpile)]"
						direction = vertical
					}
					tooltipwidget = {
						using = GoodsMarketEntry_template
					}
				}
			}


			widget = {
				# spacing = 3
				size = { 60 20 }
				text_single = {
					size = { 60 20 }
					autoresize = no
					align = center|nobaseline
					using = Font_Size_Small
					visible = "[Trade.HasTradeHappened]"
					raw_text = "[Trade.GetProfitPerMerchantCapacity|+=2]@profit_trade!"

					tooltipwidget = {
						ExistingTradeProfitPerCapacityTooltip = {}
					}

					block "sort_by_highlight_profit" {}
				}
				text_single = {
					size = { 60 20 }
					autoresize = no
					align = center|nobaseline
					using = Font_Size_Small
					visible = "[Not(Trade.HasTradeHappened)]"
					raw_text = "[Trade.GetProfitPerMerchantCapacity|+=2]@profit_trade!"

					tooltipwidget = {
						ExistingTradeProfitPerCapacityTooltip = {}
					}

					block "sort_by_highlight_profit_predicted" {}
				}
			}

			# GOODS MOVED
			widget = {
				block "sort_by_highlight_quantity_goods_bigger" {}
				size = { 80 24 }
				datacontext = "[Trade.GetGoods]"
				background = {	
					using = bg_round_corners_dark_blue_texture
					alpha = 0.4
				}

				icon = {
					parentanchor = left|vcenter
					position = { 5 0 }
					size = { 14 14 }
					visible = "[LessThan_CFixedPoint(Trade.GetTariffValue,'(CFixedPoint)0')]"
					texture = "gfx/interface/icons/flat_icons/trade_market/tariff_small.dds"
					tooltipwidget = {
						using = trade_tariff_tooltip
					}
				}



				icon = {
					parentanchor = left|vcenter
					position = { 5 0 }
					size = { 14 14 }
					visible = "[GreaterThan_CFixedPoint(Trade.GetTariffValue,'(CFixedPoint)0')]"
					texture = "gfx/interface/icons/flat_icons/trade_market/subvention_small.dds"
					tooltipwidget = {
						using = trade_tariff_tooltip
					}
				}
	
				hbox = {
					margin_right = 5
					spacing = -1
					widget = {
						size = { 15 15 }
						# icon = {
						# 	visible = "[And(Trade.HasTradeHappened, Trade.IsTradeInefficient)]"
						# 	size = { 15 15 }
						# 	using = warning_icon_texture
						# 	tooltipwidget = {
						# 		container = {
						# 			alwaystransparent = no
						# 			container = {						
						# 				visible = "[And(Trade.HasTradeHappened, Trade.IsTradeInefficient)]"
						# 				ContextualTooltipType = {
						# 					blockoverride "title_text" {
						# 						datacontext = "[Trade]"
						# 						text = "TRADE_INEFFICIENT_HEADER"
						# 					}
						# 					blockoverride "title_icon" {
						# 						icon = {
						# 							using = tooltip_title_icon_size
						# 							texture = "gfx/interface/icons/flat_icons/trade_maintenance.dds"
						# 						}
						# 					}
						# 					blockoverride "concept_link" {
						# 						text = [merchant_maintenance|E]
						# 					}
						# 					blockoverride "tooltip_content" {
						# 						TooltipTextBlock = {							
						# 							blockoverride "text" {
						# 								datacontext = "[Trade]"
						# 								text = "TRADE_INEFFICIENT_TT_TEXT"
						# 							}
						# 						}
						# 					}
						# 				}
						# 			}
						# 		}
						# 	}	
						# }			
					}
					text_single = {
						datacontext = "[Trade.GetFromMarket]"
						datacontext = "[Trade.GetFromMarket.GetMarketEntry(Trade.GetGoods)]"
						size = { 61 20}
						autoresize = no
						fontsize = 15
						align = right|nobaseline

						raw_text = "[Trade.GetQuantityOfGoodsActuallyMovedOrDesired|V2] @good!"

						#BALANCE OF THE EXPORTING MARKET. NOT AS USEFUL WITH TRADE ORDERS:
						# raw_text = "[Subtract_CFixedPoint(Add_CFixedPoint(Trade.GetFromMarket.GetSupply(GoodsMarketEntry.GetGoods), Trade.GetFromMarket.GetExtraTradeSupplyFromStockpile(Trade.GetGoods)), Trade.GetFromMarket.GetDemand(GoodsMarketEntry.GetGoods))|+=2] @balance!"
						# tooltipwidget = { 
						# 	using = goods_market_balance_tooltip
						# }
					}
				}
			}
	
			# MERCHANT CAPACITY
			widget = {
				size = { 80 24 }
		
				hbox = {		
					using = bg_number_container_bckg
					blockoverride "number_container_extra" {
						alpha = 0.4
						margin = {2 4}
					}
		
					expand = {}

					text_single = {
						size = {45 20}
						autoresize = no
						using = Font_Size_Small
						raw_text = "[Trade.GetAssignedMerchantCapacity|2Y]@trade_capacity!"
						tooltipwidget = {
							SimpleContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/trade_capacity.dds"
									}
								}
		
								blockoverride "concept_link" {
									text = "[merchant_capacity|e]"
								}

								lowpriotextcontext = "TRADE_CUR_CAPACITY"
							}
						}

						align = center
		
						block "sort_by_highlight_capacity_desired" {}
					}

					expand = {}
				}
			}
		}
	}

}

types TradeOverview {
	type trade_overview_possible_trades = vbox {
		name = "possible_trades_content_root"
		using = layoutpolicy_expanding

		margin_top = 10
		spacing = 5
		
		# MARKET FILTERED
		widget = {
			visible = "[TradeOverview.IsMarketFilterEnabled]"
			layoutpolicy_horizontal = expanding
			size = { -1 70 }

			hbox = {
				datacontext = "[TradeOverview.GetSelectedMarket]"

				using = bg_market_card
				using = bg_cabinet_card_frame

				market_card = {
					blockoverride "market_card_margins" {
						margin = {5 5}
						margin_right = 0
					}
				}

				market_card_right_buttons = {
					blockoverride "market_filter_buttons" {
						vbox = {
							layoutpolicy_vertical = expanding
							spacing = 3

							filter_button_alt = {
								size = { 23 23 }
								blockoverride "filter_button_action" {
									action_tooltip = {
										click_type = left
										click_mode = single
										title = "TOGGLE_MARKET_SELECTION"
										on_action = "[TradeOverview.TogglePossibleTradesSelectMarket(PdxGuiWidget.FindParent('possible_trades_content_root').Self)]"
									}

									action_tooltip = {
										click_type = right
										click_mode = single
										title = "SCROLL_CAPITAL_MARKET_FILTER"
										on_action = "[SelectDefaultFocusMarket]"
									}
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
										
								blockoverride "glow_visible" {
									visible = "[TradeOverview.IsPossibleTradesSelectMarketOpened(PdxGuiWidget.FindParent('possible_trades_content_root').Self)]"
								}
							}
						}
					}
				}
			}				
		}

		datacontext = "[TradeOverview.GetSelectedMarket]"

		# MARKET NOT FILTERED
		widget = {
			visible = "[Not(TradeOverview.IsMarketFilterEnabled)]"
			layoutpolicy_horizontal = expanding
			size = { -1 50 }

			button_regular = {
				layoutpolicy_horizontal = expanding
				size = { 100% 50 }

				action_tooltip = {
					click_type = left
					click_mode = single
					title = "TOGGLE_MARKET_SELECTION"
					on_action = "[TradeOverview.TogglePossibleTradesSelectMarket(PdxGuiWidget.FindParent('possible_trades_content_root').Self)]"
				}

				action_tooltip = {
					click_type = right
					click_mode = single
					title = "SCROLL_CAPITAL_MARKET_FILTER"
					on_action = "[SelectDefaultFocusMarket]"
				}

				tooltipwidget = { BasicFunctionalTooltip = {} }

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5

					margin_left = 8
					margin_right = 5

					text_single = {
						align = center|nobaseline
						layoutpolicy_horizontal = expanding
						autoresize = no
						fontsize_min = 12
						text = "NOT_FILTERED_BY_MARKET"
					}
				}

				filter_button_alt = {
					size = { 25 25 }
					parentanchor = right|vcenter
					position = {-10 0}
					blockoverride "filter_button_action" {
						action_tooltip = {
							click_type = left
							click_mode = single
							title = "TOGGLE_MARKET_SELECTION"
							on_action = "[TradeOverview.TogglePossibleTradesSelectMarket(PdxGuiWidget.FindParent('possible_trades_content_root').Self)]"
						}

						action_tooltip = {
							click_type = right
							click_mode = single
							title = "SCROLL_CAPITAL_MARKET_FILTER"
							on_action = "[SelectDefaultFocusMarket]"
						}
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }
					
					blockoverride "glow_visible" {
						visible = "[TradeOverview.IsPossibleTradesSelectMarketOpened(PdxGuiWidget.FindParent('possible_trades_content_root').Self)]"
					}
				}
			}
		}

		#Trade orders
		widget = {
			visible = "[And(TradeOverview.IsMarketFilterEnabled, Or(TradeOverview.Vars.HasValue( 'trade', 'trade_orders' ), TradeOverview.Vars.NotExistOrHasValue( 'trade', 'both' )))]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			layoutstretchfactor_vertical = 5

			vbox = {
				using = layoutpolicy_expanding
				margin = { 0 1 }
				margin_bottom = 4
				spacing = 5
				datacontext = "[GetQuickTradeOrders(TradeOverview.GetSelectedMarket)]"

				using = wood_square_tile
				blockoverride "wood_texture_extra" {
					modify_texture = {
						using = color_black_texture
						alpha = 0.2
						blend_mode = multiply
					}
				}
				using = bg_loans_card_frame

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					visible = "[Or( Not( EqualTo_int32( GetDataModelSize( QuickTradeOrders.GetQuickImportSuggestions ), '(int32)0' ) ), Not( EqualTo_int32( GetDataModelSize( QuickTradeOrders.GetQuickExportSuggestions ), '(int32)0' ) ) )]"

					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 47 }
						using = bg_loans_card_texture
						using = bg_loans_card_frame
						
						hbox = {
							using = layoutpolicy_expanding
							spacing = 5
							margin = { 5 5 }
							margin_right = 7

							widget = {
								visible = "[TradeOverview.IsMarketFilterEnabled]"
								size = { 24 24 }
								allow_outside = yes

								ui_direction_button_holder_left = {}
					
								button_minimize = {
									visible = "[TradeOverview.Vars.NotExistOrHasValue( 'trade', 'both' )]"
									parentanchor = right|vcenter
									enabled = "[Not(IsObserving)]"

									blockoverride "button_texture" {
										using = max_button_alt_texture
									}
					
									action_tooltip = {
										title = "TRADE_OVERVIEW_SHOW_TRADE_ORDERS"
										on_action = "[TradeOverview.Vars.Set( 'trade', 'trade_orders' )]"
										enabled = "[Not(IsObserving)]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
								}
					
								button_minimize = {
									visible = "[TradeOverview.Vars.HasValue( 'trade', 'trade_orders' )]"
									parentanchor = right|vcenter

									enabled = "[Not(IsObserving)]"
					
									action_tooltip = {
										title = "TRADE_OVERVIEW_SHOW_BOTH"
										on_action = "[TradeOverview.Vars.Set( 'trade', 'both' )]"
										enabled = "[Not(IsObserving)]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
								}
							}

							widget = {
								size = { 24 24}
								icon = {
									texture = "[GetConceptTexture('trade_order')]"
									size = { 24 24}
									glow = {
										name = "drop_shadow"
										glow_radius = 3
										color = {0.0 0.0 0.0 1.0}
										alpha = 0.3
									}
								}
								tooltip = "[trade_order]"
								tagtooltip_enabled = yes
							}
							
							text_single = {
								size = { 140 15 }
								autoresize = no
								align = left|nobaseline
								text = "[trade_orders|e]"
								# text = "NEW_TRADE_ORDERS"
								# tooltip = "[trade_orders]"
								# tagtooltip_enabled = yes
							}
	
							expand = {}
	
							# CREATE NEW TRADE ORDER
							header_button_left = {
								size = { 145 30 }
								blockoverride "header_button_template_push_properties" { using = button_tab_toggle_properties_template }
								blockoverride "header_button_template_texture" { using = pressed_button_texture_light }
								blockoverride "button_icon_stretch_sprite" {}
								blockoverride "header_button_frame_inner" {visible = no}
								blockoverride "header_button_icon_size" { size = { 30 30 } }
								blockoverride "icon_overlay" {}
								blockoverride "header_button_text_margins" { margin_left = 5 margin_right = 5 }
								enabled = "[QuickTradeOrders.HasMerchantCapacity]"
								blockoverride "icon_texture" {
									texture = "gfx/interface/icons/flat_icons/trade_market/create_custom_trade_order.dds"
									texture_density = 2
								}
								blockoverride "header_button_template_minimumsize"{
									minimumsize = { -1 30 }
								}
								blockoverride "text_top" {
									autoresize = no
									layoutpolicy_horizontal = expanding
									size = { -1 15 }
									align = left|nobaseline
									text = "TRADE_ORDER_CREATE_NEW_BUTTON"
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TRADE_ORDER_CREATE_NEW"
									description = "TRADE_ORDER_CREATE_NEW_TT"
									enabled = "[QuickTradeOrders.HasMerchantCapacity]"
									conditions = "[MakeItFailIfLoc(Not(QuickTradeOrders.HasMerchantCapacity), 'TRADE_ORDER_NO_TC_IN_MARKET_TT')]"
									on_action = "[QuickTradeOrders.OpenBlankTradeOrder]"
								}
							}
	
							header_button_left = {
								size = { 145 30 }
								down = "[TradeOverview.IsPossibleTradesSelectGoodOpened(PdxGuiWidget.Self)]"
								blockoverride "header_button_template_push_properties" { using = button_tab_toggle_properties_template }
								blockoverride "header_button_template_texture" { using = pressed_button_texture_light }
								blockoverride "button_icon_stretch_sprite" {}
								blockoverride "header_button_frame_inner" {visible = no}
								blockoverride "header_button_icon_size" { size = { 30 30 } }
								blockoverride "icon_overlay" {}
								blockoverride "header_button_text_margins" { margin_left = 5 margin_right = 5 }
								enabled = "[QuickTradeOrders.HasMerchantCapacity]"
								blockoverride "icon_texture" {
									texture = "gfx/interface/icons/flat_icons/trade_market/order_preset.dds"
									texture_density = 2
								}
								blockoverride "header_button_template_minimumsize"{
									minimumsize = { -1 30 }
								}
								blockoverride "text_top" {
									autoresize = no
									layoutpolicy_horizontal = expanding
									size = { -1 15 }
									align = left|nobaseline
									text = "TRADE_ORDER_PRESETS"
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TRADE_ORDER_PRESETS_BUTTON"
									enabled = "[QuickTradeOrders.HasMerchantCapacity]"
									conditions = "[MakeItFailIfLoc(Not(QuickTradeOrders.HasMerchantCapacity), 'TRADE_ORDER_NO_TC_IN_MARKET_TT')]"
									on_action = "[TradeOverview.OpenGoodsPanel]"
									on_action = "[TradeOverview.TogglePossibleTradesSelectGood(PdxGuiWidget.Self)]"
								}
							}
						}
					}
				}

				hbox = {
					using = layoutpolicy_expanding
					margin = { 5 0 }
					scroll_list = {
						blockoverride "scroll_list_layout" {
							vbox = {
								fixedgridbox = {
									addcolumn = 100%
									addrow = 45
									datamodel = "[QuickTradeOrders.GetTradeOrders]"
	
									item = {
										widget = {
											size = { 99% 43 }
											parentanchor = hcenter
											TradeOrderCard = {}
										}
									}
								}
	
								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 45 }
									datacontext = "[QuickTradeOrders.GetAutomationItem]"
									AutomationTradeCard = {
										parentanchor = hcenter
										size = { 99% 43 }
									}
								}
	
								expand = {}
							}
						}
						blockoverride "scroll_list_is_empty" {
							visible = "[IsDataModelEmpty(QuickTradeOrders.GetTradeOrders)]"
						}
	
						blockoverride "scroll_list_is_empty_text" {
							text = "TRADE_ORDERS_SCROLL_LIST_EMPTY"
						}
					}
				}
			}
		}

		#Current trades
		vbox = {
			using = layoutpolicy_expanding
			margin = { 0 2 }
			layoutstretchfactor_vertical = 6
			visible = "[Or(TradeOverview.Vars.HasValue( 'trade', 'current_trades' ), TradeOverview.Vars.NotExistOrHasValue( 'trade', 'both' ))]"

			using = wood_square_tile
			blockoverride "wood_texture_extra" {
				modify_texture = {
					using = color_black_texture
					alpha = 0.2
					blend_mode = multiply
				}
			}
			using = bg_loans_card_frame

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 47 }
					

					using = bg_loans_card_texture
					using = bg_loans_card_frame

					hbox = {
						using = layoutpolicy_expanding
						margin = { 5 5 }

						spacing = 5

						widget = {
							visible = "[TradeOverview.IsMarketFilterEnabled]"
							size = { 24 24 }
							allow_outside = yes

							ui_direction_button_holder_left = {}
				
							button_minimize = {
								visible = "[TradeOverview.Vars.NotExistOrHasValue( 'trade', 'both' )]"
								parentanchor = right|vcenter
								enabled = "[Not(IsObserving)]"

								blockoverride "button_texture" {
									using = max_button_alt_texture
								}
				
								action_tooltip = {
									title = "TRADE_OVERVIEW_SHOW_TRADES"
									on_action = "[TradeOverview.Vars.Set( 'trade', 'current_trades' )]"
									enabled = "[Not(IsObserving)]"
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
							}
				
							button_minimize = {
								visible = "[TradeOverview.Vars.HasValue( 'trade', 'current_trades' )]"
								parentanchor = right|vcenter

								enabled = "[Not(IsObserving)]"
				
								action_tooltip = {
									title = "TRADE_OVERVIEW_SHOW_BOTH"
									on_action = "[TradeOverview.Vars.Set( 'trade', 'both' )]"
									enabled = "[Not(IsObserving)]"
								}
								tooltipwidget = { BasicFunctionalTooltip = {} }
							}
						}

						widget = {
							size = { 24 24}
							icon = {
								texture = "[GetConceptTexture('trade')]"
								size = { 24 24}
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.3
								}
							}
							tooltip = "[trade]"
							tagtooltip_enabled = yes
						}

						text_single = {
							size = { 150 15 }
							autoresize = no
							align = left|nobaseline
							text = "[trades|e]"
						}
						expand = {}
					}
				}
			}

			hbox = {
				using = layoutpolicy_expanding
				margin = { 5 0 }
				spacing = 5
				filtered_sorted_list = {
					datacontext = "[TradeOverview.GetPossibleTradesSortSearch]"
					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "trade_origin"
							layoutpolicy_vertical = expanding
							size = { 40 -1 }

							blockoverride "sort_by_key_button_texture" {
								texture = "gfx/interface/icons/sort/origin.dds"
							}
						}

						sort_by_key_button = {
							name = "trade_good"
							layoutpolicy_vertical = expanding
							size = { 40 -1 }
						}

						sort_by_key_button = {
							name = "from_market"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "to_market"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "merchant_capacity_profit"
							layoutpolicy_vertical = expanding
							size = { 72 -1 }

							blockoverride "sort_by_key_button_texture" {
								texture = "gfx/interface/icons/sort/profit.dds"
							}
						}

						sort_by_key_button = {
							name = "quantity_of_goods_moved"
							layoutpolicy_vertical = expanding
							size = { 88 -1 }
						}

						sort_by_key_button = {
							name = "merchant_capacity_desired"
							layoutpolicy_vertical = expanding
							size = { 100 -1 }
						}
					}

	
					# blockoverride "subheader_upper_divider" {
