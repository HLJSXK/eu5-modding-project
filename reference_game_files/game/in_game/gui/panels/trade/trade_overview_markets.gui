																}

																hbox = {
																	using = layoutpolicy_expanding
																	margin = { 10 0 }
																	spacing = 10

																	country_flag_small = {
																		datacontext = "[Country]"
																	}

																	text_single = {
																		align = nobaseline
																		text = "[Country.GetLongName]"											
																	}

																	expand = {}					
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				# Merchant Fraction
				vbox = {
