types TradeOverview {
	type trade_overview_markets = vbox {
		using = layoutpolicy_expanding

		widget = {
			layoutpolicy_horizontal = expanding
			size = {-1 76 }

			hbox = {
				layoutpolicy_horizontal = expanding
				parentanchor = vcenter
				margin = { 1 0 }
				margin_top = 10
				spacing = 2

				# Embargo
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = -8
					bottomtotop = yes
					using = bg_market_card_action

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 3 0 }

						widget = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							
							overlappingitembox = {
								position = { 0 -8 }
								parentanchor = bottom
								# autoresize = yes

								size = { 100% 24 }
								datamodel = "[TradeOverview.GetEmbargoedCountries]"
								spacing = 2
								margin = { 8 0 }
								item = {
									country_flag_small = {
										datacontext = "[Country]"
									}
								}
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 2 4 }
						targetted_header_button_regular = {
							layoutpolicy_horizontal = expanding
							size = { -1 29 }
							maximumsize = { 124 29 }
							blockoverride "button_text_properties" {
								default_format = "#color_white"
								fontsize = 12
							}
							text = "TRADE_OVERVIEW_BTN_EMBARGO"
							icon = {
								size = { 18 18 }
								parentanchor = left|vcenter
								position = { 6 0 }
								texture = "[GetConceptTexture('embargo')]"
							}

							visible = "[PdxGuiWidget.IsUberButtonVisible]"
							enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

							scripted_action_tooltip = {
								click_type = left
								click_mode = single
								action_name = "scripted_relation"
								actor = "[Player]"
								parameter = {
									parameter_name = "scripted_relation_type"
									parameter_value = "[GetScriptedRelationType('embargo_nation')]"
								}
							}

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											texture = "[GetConceptTexture('embargo')]"
											using = tooltip_title_icon_size
										}
									}
									blockoverride "title_text" {
										text = "offer_embargo_nation"
									}
									blockoverride "concept_link" {
										text = "[embargo|e]"
									}
									blockoverride "tooltip_content" {
										using = action_tooltip_inner_content
										TooltipListBase = {
											visible = "[GreaterThan_int32(GetDataModelSize(TradeOverview.GetEmbargoedCountries), '(int32)0')]"
											blockoverride "block_title" {
												text = "TRADE_OVERVIEW_BTN_EMBARGO_TT_LIST_TITLE"
											}
											TooltipListScrollArea = {
												blockoverride "scrollarea_content" {
													fixedgridbox = {
														addcolumn = 420
														addrow = 30
														setitemsizefromcell = yes

														datamodel = "[TradeOverview.GetEmbargoedCountries]"
														item = {
															widget = {
																background = {
																	visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
																	using = tooltip_table_field_texture
																}

																hbox = {
																	using = layoutpolicy_expanding
																	margin = { 10 0 }
																	spacing = 10

																	country_flag_small = {
																		datacontext = "[Country]"
																	}

																	text_single = {
																		align = nobaseline
																		text = "[Country.GetLongName]"
																	}

																	expand = {}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				# Tariff Exemption
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = -8
					bottomtotop = yes
					using = bg_market_card_action

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 3 0 }

						widget = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							overlappingitembox = {
								position = { 0 -8 }
								parentanchor = bottom
								# autoresize = yes

								size = { 100% 24 }
								datamodel = "[TradeOverview.GetTariffExemptCountries]"
								spacing = 2
								margin = { 8 0 }
								item = {
									country_flag_small = {
										datacontext = "[Country]"
									}
								}
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 2 4 }
						targetted_header_button_regular = {
							layoutpolicy_horizontal = expanding
							size = { -1 29 }
							maximumsize = { 124 29 }
							blockoverride "button_text_properties" {
								default_format = "#color_white"
								fontsize = 12
							}
							text = "TRADE_OVERVIEW_BTN_LIFT_TARIFFS"
							icon = {
								size = { 18 18 }
								parentanchor = left|vcenter
								position = { 6 0 }
								texture = "[GetConceptTexture('tariff_exemption')]"
							}

							visible = "[PdxGuiWidget.IsUberButtonVisible]"
							enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

							scripted_action_tooltip = {
								click_type = left
								click_mode = single
								action_name = "scripted_relation"
								actor = "[Player]"
								parameter = {
									parameter_name = "scripted_relation_type"
									parameter_value = "[GetScriptedRelationType('tariff_exemption')]"
								}
							}

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											texture = "[GetConceptTexture('tariff_exemption')]"
											using = tooltip_title_icon_size
										}
									}
									blockoverride "title_text" {
										text = "offer_tariff_exemption"
									}
									blockoverride "concept_link" {
										text = "[tariff_exemption|e]"
									}
									blockoverride "tooltip_content" {
										using = action_tooltip_inner_content
										TooltipListBase = {
											visible = "[GreaterThan_int32(GetDataModelSize(TradeOverview.GetTariffExemptCountries), '(int32)0')]"
											blockoverride "block_title" {
												text = "TRADE_OVERVIEW_BTN_LIFT_TARIFFS_TT_LIST_TITLE"
											}
											TooltipListScrollArea = {
												blockoverride "scrollarea_content" {
													fixedgridbox = {
														addcolumn = 420
														addrow = 30
														setitemsizefromcell = yes

														datamodel = "[TradeOverview.GetTariffExemptCountries]"
														item = {
															widget = {
																background = {
																	visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
																	using = tooltip_table_field_texture
																}

																hbox = {
																	using = layoutpolicy_expanding
																	margin = { 10 0 }
																	spacing = 10

																	country_flag_small = {
																		datacontext = "[Country]"
																	}

																	text_single = {
																		align = nobaseline
																		text = "[Country.GetLongName]"
																	}

																	expand = {}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				# Trade Pact
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = -8
					bottomtotop = yes
					using = bg_market_card_action

					hbox = {
