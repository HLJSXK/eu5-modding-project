lateralview_full = {
	name = "military_ledger"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "LEDGER_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			header_main_tabs = {
				blockoverride "content" {
					using = ledger_tabs_template
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt

				filtered_sorted_list = {
					margin_top = 10
					datacontext = "[MilitaryLedger.GetMilitarySortSearch]"

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							size = { 260 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "regulars"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "manpower"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "levies"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "levy_combat_efficiency"
							using = layoutpolicy_expanding
							# size = { 120 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "army_tradition"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "discipline"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "morale"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "tactics"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "fort_limit"
							using = layoutpolicy_expanding
							# size = { 120 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "siege_ability"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "fort_defense"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "navy_regulars"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "navy_levies"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "sailors"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "navy_tradition"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "naval_damage_done"
							using = layoutpolicy_expanding
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "naval_damage_taken"
							size = { 130 1 }
							layoutpolicy_vertical = expanding
						}
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 50
						setitemsizefromcell = yes

						datamodel = "[MilitaryLedger.GetMilitaryCountriesListView]"
						item = {
							using = ledger_item_template
							blockoverride "ledger_item_content" {
								widget = {
									using = layoutpolicy_expanding
									hbox = {
										margin = { 10 0 }
										spacing = 10
										datacontext = "[MilitaryLedgerItem.GetCountry]"

										hbox = {
											margin_left = 10
											margin_right = 10
											size = { 240 -1 }
											spacing = 10

											country_flag_small = {
												datacontext = "[MilitaryLedgerItem.GetCountry]"
											}

											text_single = {
												size = { 170 -1 }
												autoresize = no
												align = left|nobaseline

												text = "[MilitaryLedgerItem.GetCountry.GetLongNameWithNoTooltip]"
												default_format = "#yellow_titles"
											}
											tooltipwidget = {
												using = CountryTooltip
											}
											sort_by_highlight = {
												name = "name"
											}
										}

										hbox = { #REGULARS
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetRegularArmySize|L]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('regulars')]"
											}
											tooltipwidget = {
												using = ArmyOverview_tooltip
											}
											sort_by_highlight = {
												name = "regulars"
											}
										}

										hbox = { #MANPOWER
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetCurrencyValue('manpower')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('manpower')]"
											}
											tooltip = "[manpower]"
											tagtooltip_enabled = yes
											sort_by_highlight = {
												name = "manpower"
											}
										}

										hbox = { #LEVIES
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetRaisedAndPotentialLevyStrength|L]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('levies')]"
											}
											tooltipwidget = {
												using = ArmyOverview_tooltip
											}
											sort_by_highlight = {
												name = "levies"
											}
										}

										hbox = { # LEVY COMBAT EFFICIENCY
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetModifierValueNoFormat('levy_combat_efficiency_modifier')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('levy_combat_efficiency')]"
											}
											
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "MODIFIER_TYPE_NAME_levy_combat_efficiency_modifier"
													}
												
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "[GetConceptTexture('levy_combat_efficiency')]"
														}
													}
				
													blockoverride "concept_link" {
														text = [modifier|e]
													}
				
													blockoverride "tooltip_content" {
														TooltipStringPairList = {
															blockoverride "block_title" {
																text = "LIST_TITLE_SOURCES"
															}
															textcontext = "[Country.GetDescriptionFor('levy_combat_efficiency_modifier')]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "levy_combat_efficiency"
											}
										}

										hbox = { # ARMY TRADITION
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[MilitaryLedgerItem.GetCountry.GetCurrencyValue('army_tradition')]%"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('army_tradition')]"
											}
											tooltipwidget = {
												using = ArmyTraditionTooltip
											}
											sort_by_highlight = {
												name = "army_tradition"
											}
										}

										hbox = { # DISCIPLINE
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetModifierValueNoFormat('discipline')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('discipline')]"
											}
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "MODIFIER_TYPE_NAME_discipline"
													}
												
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "[GetConceptTexture('discipline')]"
														}
													}
				
													blockoverride "concept_link" {
														text = [modifier|e]
													}
				
													blockoverride "tooltip_content" {
														TooltipStringPairList = {
															blockoverride "block_title" {
																text = "LIST_TITLE_SOURCES"
															}
															textcontext = "[Country.GetDescriptionFor('discipline')]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "discipline"
											}
										}

										hbox = { # MORALE
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetDefaultLandMorale|+=2]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('morale')]"
											}
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "TT_ARMYMORALE_TITLE_COUNTRY"
													}
													
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "gfx/interface/icons/military_army/army_morale.dds"
														}
													}
													
													blockoverride "concept_link" {
														text = [army_morale|e]
													}
													
													blockoverride "tooltip_content" {
														
														TooltipTextBlock = {
															blockoverride "text" {
																text = "TT_ARMYMORALE_TEXT_COUNTRY"
															}
														}
														
														TooltipStringPairList = {
															blockoverride "block_title" {
																text = "LIST_TITLE_SOURCES"
															}
															textcontext = "[Country.GetDefaultLandMoraleTooltip]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "morale"
											}
										}

										# TACTICS
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[Country.GetModifierValueNoFormat('military_tactics')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('military_tactics')]"
											}
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "MODIFIER_TYPE_NAME_military_tactics"
													}
												
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "[GetConceptTexture('military_tactics')]"
														}
													}
				
													blockoverride "concept_link" {
														text = [modifier|e]
													}
				
													blockoverride "tooltip_content" {
														TooltipStringPairList = {
															blockoverride "block_title" {
																text = "LIST_TITLE_SOURCES"
															}
															textcontext = "[Country.GetDescriptionFor('military_tactics')]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "tactics"
											}
										}

										# FORT LIMIT
										hbox = {
											margin_left = 5
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[MilitaryLedgerItem.GetCountry.GetCurrentFortsAmount|2W]#medium /[MilitaryLedgerItem.GetCountry.GetFortLimit|2]#!"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('fort_limit')]"
											}
											tooltipwidget = {
												using = FortLimitTooltip
											}
											sort_by_highlight = {
												name = "fort_limit"
											}
										}

										# SIEGE ABILITY
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[Country.GetModifierValueNoFormat('siege_ability')]"
											}
											icon = {
												size = { 16 16 }
												texture = "gfx/interface/icons/modifier_types/siege_ability.dds"
											}
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "MODIFIER_TYPE_NAME_siege_ability"
													}
												
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "gfx/interface/icons/modifier_types/siege_ability.dds"
														}
													}
				
													blockoverride "concept_link" {
														text = [modifier|e]
													}
				
													blockoverride "tooltip_content" {
														TooltipStringPairList = {
															blockoverride "block_title" {
																text = "LIST_TITLE_SOURCES"
															}
															textcontext = "[Country.GetDescriptionFor('siege_ability')]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "siege_ability"
											}
										}

										# FORT DEFENSE
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[Country.GetModifierValueNoFormat('global_defensive')]"
											}
											icon = {
												size = { 16 16 }
												texture = "gfx/interface/icons/military_army/fort_defense.dds"
											}
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "MODIFIER_TYPE_NAME_global_defensive"
													}
												
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "gfx/interface/icons/military_army/fort_defense.dds"
														}
													}
				
													blockoverride "concept_link" {
														text = [modifier|e]
													}
				
													blockoverride "tooltip_content" {
														TooltipStringPairList = {
															blockoverride "block_title" {
																text = "LIST_TITLE_SOURCES"
															}
															textcontext = "[Country.GetDescriptionFor('global_defensive')]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "fort_defense"
											}
										}

										# NAVY REGULARS
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetNavySizeValue]"
											}
											icon = {
												size = { 16 16 }
												texture = "gfx/interface/icons/unit_category/regulars_navy.dds"
											}
											tooltipwidget = {
												using = NavyOverview_tooltip
											}
											sort_by_highlight = {
												name = "navy_regulars"
											}
										}

										# NAVY LEVIES
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetNavyLevyPower|L]"
											}
											icon = {
												size = { 16 16 }
												texture = "gfx/interface/icons/unit_category/navy_levies.dds"
											}
											tooltipwidget = {
												using = Country_navy_levies_tooltip
											}
											sort_by_highlight = {
												name = "navy_levies"
											}
										}

										# SAILORS
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetCurrencyValue('sailors')|0]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('sailors')]"
											}
											tooltip = "[sailors]"
											tagtooltip_enabled = yes
											sort_by_highlight = {
												name = "sailors"
											}
										}

										# NAVY TRADITION
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[Country.GetCurrencyValue('navy_tradition')|%2]%"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('navy_tradition')]"
											}
											tooltipwidget = {
												using = NavyTraditionTooltip
											}
											sort_by_highlight = {
												name = "navy_tradition"
											}
										}

										# NAVAL DAMAGE DONE / TAKEN
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[Country.GetModifierValueNoFormat('naval_damage_done')]"
											}
											icon = {
												size = { 16 16 }
												texture = "gfx/interface/icons/modifier_types/naval_damage_done.dds"
											}
											tooltipwidget = {
												using = NavalDamageCountryTooltip
											}
											sort_by_highlight = {
												name = "naval_damage_done"
											}
										}
										hbox = {
											margin_right = 5
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												raw_text = "[Country.GetModifierValueNoFormat('naval_damage_taken')]"
											}
											icon = {
												size = { 16 16 }
												texture = "gfx/interface/icons/modifier_types/naval_damage_taken.dds"
											}
											tooltipwidget = {
												using = NavalDamageCountryTooltip
												blockoverride "naval_damage_icon_texture" {
													texture = "gfx/interface/icons/flat_icons/military/naval_damage_taken.dds"
												}
												blockoverride "naval_damage_text_key" {
													text = "TT_NAVALDAMAGETAKEN_TEXT_COUNTRY"
												}
												blockoverride "naval_damage_textcontext" {
													textcontext = "[Country.GetDescriptionFor('naval_damage_taken')]"
												}
											}
											sort_by_highlight = {
												name = "naval_damage_taken"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
