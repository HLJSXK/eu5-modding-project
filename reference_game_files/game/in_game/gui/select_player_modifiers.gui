select_menu_left = {
	blockoverride "menu_setup" {
		name = "select_player_modifiers"
	}

	blockoverride "close_on_action" { on_action = "[SelectPlayerModifiers.OnClose]" }

	blockoverride "select_header_text" {
		text = "PLAYER_MODIFIERS_HEADER"
	}

	blockoverride "select_content" {
		widget = {
			size = { 360 800 }

			filtered_sorted_list = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				datacontext = "[SelectPlayerModifiers.GetModifiersSortSearch]"

				blockoverride "scroll_list_is_empty" {
					visible = "[IsDataModelEmpty(SelectPlayerModifiers.GetModifiers)]"
				}

				blockoverride "scroll_list_is_empty_text" {
					text = "MODIFIERS_SCROLL_LIST_EMPTY"
				}

				blockoverride "scroll_list_content" {
					addcolumn = 100%
					addrow = 36
					setitemsizefromcell = yes

					datamodel = "[SelectPlayerModifiers.GetModifiers]"
					item = {
						modifier_item = {
							blockoverride "modifier_item_margin" { margin = { 0 1 } }
							blockoverride "modifier_item_fontsize" { using = Font_Size_Very_Small }
						}
					}
				}
			}
		}
	}
}
