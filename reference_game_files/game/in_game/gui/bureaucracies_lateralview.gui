template bureaucracy_card_background
{
	texture = "gfx/interface/component_tiles/bureaucracy/bureaucracy_background.dds"
	texture_density = 2
}

template bureaucracy_currency_background
{
	background = {
		texture = "gfx/interface/component_tiles/bureaucracy/currency_background.dds"
		texture_density = 2
		spriteType = corneredstretched
		spriteborder = {20 0}
	}
}

