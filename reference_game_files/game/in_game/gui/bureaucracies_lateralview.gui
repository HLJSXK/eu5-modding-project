lateralview = {
	name = "bureaucracies_lateralview"
	widgetid = "bureaucracies_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text_object" {
				hbox = {
					header_title = {
						text = "GOV_TAB"
					}
				}
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = { #
			blockoverride "content" {
				using = government_main_tabs
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = bg_main_inner_image_alt
			using = window_main_tabs_margin_alt

			vbox = {
				using = layoutpolicy_expanding
				margin_top = 5
				spacing = 5

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 50 }
					using = bg_paper_card
					using = bg_cabinet_card_frame
					hbox = {
						margin = { 2 5 }
						expand = {}
						subheader_unified_icon = {
							datacontext = "[Player]"
							using = bg_text_mask_container_brown
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "MODIFIER_TYPE_NAME_global_max_bureaucracy_slots"
									}
								
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											datacontext = "[Player.GetModifierTooltipContext('global_max_bureaucracy_slots')]"
											texture = "[CountryModifierWrap.GetIcon]"
										}
									}
	
									blockoverride "concept_link" {
										text = [bureaucracy|e]
									}
	
									blockoverride "tooltip_content" {
										TooltipStringPairList = {
											blockoverride "block_title" {
												text = "LIST_TITLE_SOURCES"
											}
											textcontext = "[Country.GetDescriptionFor('global_max_bureaucracy_slots')]"
										}
									}
								}
							}
							blockoverride "subheader_unified_icon_texture" {
								datacontext = "[Player.GetModifierTooltipContext('global_max_bureaucracy_slots')]"
								texture = "[CountryModifierWrap.GetIcon]"
							}
							blockoverride "subheader_unified_icon_horizontal_expanding" {
								layoutpolicy_horizontal = expanding
							}
							blockoverride "subheader_unified_bottom_text" {
								layoutpolicy_horizontal = expanding
								size = { -1 20 }
								autoresize = no
								raw_text = "[BureaucraciesLateralView.GetImplementedBureaucraciesAmount]/[Player.GetModifierRawValue('global_max_bureaucracy_slots')]"
								align = left|nobaseline
								fontsize = 15		
							}
						}

						subheader_unified_icon = {
							datacontext = "[Player]"
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "MODIFIER_TYPE_NAME_global_bureaucracy_entrenchment_speed_modifier"
									}
								
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											datacontext = "[Player.GetModifierTooltipContext('global_bureaucracy_entrenchment_speed_modifier')]"
											texture = "[CountryModifierWrap.GetIcon]"
										}
									}
	
									blockoverride "concept_link" {
										text = [bureaucracy|e]
									}
	
									blockoverride "tooltip_content" {
										TooltipStringPairList = {
											blockoverride "block_title" {
												text = "LIST_TITLE_SOURCES"
											}
											textcontext = "[Country.GetDescriptionFor('global_bureaucracy_entrenchment_speed_modifier')]"
										}
									}
								}
							}
							blockoverride "subheader_unified_icon_texture" {
								datacontext = "[Player.GetModifierTooltipContext('global_bureaucracy_entrenchment_speed_modifier')]"
								texture = "[CountryModifierWrap.GetIcon]"
							}
							blockoverride "subheader_unified_icon_horizontal_expanding" {
								layoutpolicy_horizontal = expanding
							}
							blockoverride "subheader_unified_bottom_text" {
								layoutpolicy_horizontal = expanding
								size = { -1 20 }
								autoresize = no
								text = "[Player.GetModifierValue('global_bureaucracy_entrenchment_speed_modifier')]"
								align = left|nobaseline
								fontsize = 15
							}
						}

						subheader_unified_icon = {
							datacontext = "[Player]"
							using = bg_text_mask_container_brown
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "MODIFIER_TYPE_NAME_maintain_bureaucracy_price_cost_modifier"
									}
								
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											datacontext = "[Player.GetModifierTooltipContext('maintain_bureaucracy_price_cost_modifier')]"
											texture = "[CountryModifierWrap.GetIcon]"
										}
									}
	
									blockoverride "concept_link" {
										text = [bureaucracy|e]
									}
	
									blockoverride "tooltip_content" {
										TooltipStringPairList = {
											blockoverride "block_title" {
												text = "LIST_TITLE_SOURCES"
											}
											textcontext = "[Country.GetDescriptionFor('maintain_bureaucracy_price_cost_modifier')]"
										}
									}
								}
							}
							blockoverride "subheader_unified_icon_texture" {
								datacontext = "[Player.GetModifierTooltipContext('maintain_bureaucracy_price_cost_modifier')]"
								texture = "[CountryModifierWrap.GetIcon]"
							}
							blockoverride "subheader_unified_icon_horizontal_expanding" {
								layoutpolicy_horizontal = expanding
							}
							blockoverride "subheader_unified_bottom_text" {
								layoutpolicy_horizontal = expanding
								size = { -1 20 }
								autoresize = no
								text = "[Player.GetModifierValue('maintain_bureaucracy_price_cost_modifier')]"
								align = left|nobaseline
								fontsize = 15
							}
						}
					}
				}

				scrollarea = {
					using = layoutpolicy_expanding
					scrollbarpolicy_horizontal = always_off

					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}

					
					scrollwidget = {
						vbox = {
							using = layoutpolicy_expanding
							fixedgridbox = {
								datamodel = "[BureaucraciesLateralView.GetBureaucracies]"
								addcolumn = 100%
								addrow = 195
								# datamodel_wrap = 3
								# maxhorizontalslots = 3
								# flipdirection = yes
								item = {
									bureaucracy_item_card = {}
								}
							}
							expand = {}
						}
					}
				}
			}
		}
	}
}

Types BureaucracyTypes {

	# type piechart_line_slice = pieslice_no_highlight {
	# 	alwaystransparent = yes
	# 	texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
	# 	value = "0.02"
	# 	using = color_value_progress_brown
	# }

	type bureaucracy_column = icon {
		layoutpolicy_vertical = expanding
		size = { 20 -1 }
		texture = "gfx/interface/component_tiles/bureaucracy/column.dds"
		texture_density = 2
		spriteType = corneredstretched
		spriteborder = {0 10}
	}

	type bureaucracy_card = widget {
		size = { 100% 100% }

		# Background Frame
		hbox = {
			margin = { 10 0 }
			margin_top = 8
			margin_bottom = 3
			widget = {
				using = layoutpolicy_expanding
				widget = {
					parentanchor = bottom|hcenter
					size = { 95% 90% }
					position = {0 -4}
					background = {
						using = bureaucracy_card_background
					}
				}
				icon = {
					texture = "gfx/interface/component_tiles/bureaucracy/bureaucracy_background_frame.dds"
					texture_density = 2
					size = { 100% 100% }
					alwaystransparent = yes
					spriteType = corneredstretched
					spriteborder = {100 150}
				}
			}
		}
		
		# Inner content
		vbox = {
			margin_top = 17

			#bureaucracy implemented/entrenchment
			hbox = {
				margin = { 19 0 }
				margin_left = 80
				layoutpolicy_horizontal = expanding
				size = {-1 30}
				#bureaucracy name
				card_header_action_button_01 = {
					name = "bureaucracy_header_button"
					layoutpolicy_horizontal = expanding
					size = {-1 30}
					using = bg_card_header_01_government
					blockoverride "main_bg_card_header_01"{
						background = {
							using = color_government_texture
							alpha = 0.4

							modify_texture = {
								texture = "[GetGraphicalCultureTexture('header_pattern')]"
								texture_density = 2.5
								spriteType = corneredtiled
								blend_mode = overlay
							}
							modify_texture = {
								texture = "gfx/interface/component_overlay/cloth_texture.dds"
								texture_density = 2
								spriteType = Corneredtiled
								spriteborder = { 0 0 }
								blend_mode = overlay
								alpha = 0.2
							}
						}
					}
			
					text_single = {
						text = "[BureaucracyItem.GetBureaucracy.GetNameWithNoTooltip]"
						autoresize = no
						parentanchor = center
						align = left|nobaseline
						size = { 92% 25 }
					}
					right_click_and_hold_action = {
						action_name = "remove_bureaucracy_action"
					}
					actor = "[Player]"
					parameter = {
						parameter_name = "target_bureaucracy"
						parameter_value = "[BureaucracyItem.GetBureaucracy]"
					}

					datacontext = "[BureaucracyItem.GetMaintenanceSetting]"
					tooltipwidget = {
						using = ExpenseSettingTooltip
					}
				}

				# entrentchment & entrentchment change
				widget = {
					size = { 115 30 }
					using = bureaucracy_currency_background
					hbox = {
						spacing = 2
						margin = { 5 0 }
						
						text_single = {
							visible = "[And(BureaucracyItem.GetBureaucracy.IsImplemented, BureaucracyItem.HasMaintenanceSetting)]"
							datacontext = "[BureaucracyItem.GetMaintenanceSetting]"
							autoresize = no
							align = right
							layoutpolicy_horizontal = expanding
							size = { -1 20 }
							tooltipwidget = {
								using = ExpenseSettingTooltip
							}
							raw_text = "[BureaucracyItem.GetBureaucracy.GetEntrenchment|0%/]"
						}

						text_single = {
							visible = "[BureaucracyItem.GetBureaucracy.IsImplemented]"
							autoresize = no
							align = left
							size = { 50 20 }
							raw_text = "([BureaucracyItem.GetBureaucracy.GetEntrenchmentChange|+=3%/])"
							fontsize = 12

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[GetBureaucracyIcon(BureaucracyItem.GetBureaucracy.GetType.Self)]"
										}
									}
									blockoverride "title_text" {
										text = "BUREAUCRACY_ENTRENCHMENT_CHANGE"
									}
		
									blockoverride "concept_link" {
										text = "[bureaucracy|E]"
									}

									blockoverride "tooltip_content" {
										TooltipStringPairList = {
											textcontext = "[BureaucracyItem.GetBureaucracy.GetEntrenchmentChangeDesc]"
										}
									}
								}
							}
						}

						icon = {
							size = { 20 20 }
							texture = "[GetConceptTexture('entrenchment')]"
							texture_density = 2
						}
					}
				}
			}

			#maintenance slider & expense
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 25 }
				hbox = {
					margin = { 19 0 }
					margin_bottom = 1
					hbox = {
						using = layoutpolicy_expanding
						using = bureaucracy_currency_background
						margin_left = 61
						widget = {
							layoutpolicy_horizontal = expanding
							size = { -1 20 }
							visible = "[BureaucracyItem.HasMaintenanceSetting]"
							datacontext = "[BureaucracyItem.GetMaintenanceSetting]"
							allow_outside = yes
							economy_slider = {
								parentanchor = center
								size = { 100% 10 }
								min = 0
								max = 1
								value = "[MaintenanceSetting.GetDefault]"
								mincap = "[MaintenanceSetting.GetMin]"
								maxcap = "[MaintenanceSetting.GetMax]"
			
								onvaluechanged = "[MaintenanceSetting.OnChanged]"
								onchangefinish = "[MaintenanceSetting.Post]"
								enabled = "[And(MaintenanceSetting.IsEnabled,Not(IsPlayerAIEnabled('finances')))]"
								alpha = "[TransparentIfFalse(Not(IsPlayerAIEnabled('finances')))]"
								blockoverride "economy_slider_inc_button_config"{
									enabled = "[MaintenanceSetting.IsIncEnabled]"
								}
								blockoverride "economy_slider_dec_button_config"{
									enabled = "[MaintenanceSetting.IsDecEnabled]"
								}
			
							}
							widget = {
								size = { 100% 100% }
								#visible = "[Or3(MaintenanceSetting.IsArmy, MaintenanceSetting.IsNavy, MaintenanceSetting.IsFort)]"
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "[MaintenanceSetting.GetIcon]"
											}
										}
			
										blockoverride "title_text" {
											text = "[MaintenanceSetting.GetNameWithNoTooltip]"
										}
			
										blockoverride "concept_link" {
											text = "[maintenance|E]"
										}
										blockoverride "tooltip_content" {
											TooltipTextBlock = {
												blockoverride "text" {
													text = "EXPENSE_MAINT_TT_TEXT_LONG_ALT"
												}
											}
			
											TooltipStringPairList = {
												textcontext = "MAINTENANCE_INVESTMENT_MIN_MAX"
											}
										}
									}
								}
							}
						}

						widget = {
							size = { 115 20 }
							visible = "[BureaucracyItem.HasMaintenanceSetting]"
							datacontext = "[BureaucracyItem.GetMaintenanceSetting]"
							text_single = {
								size = { 95% 20 }
								align = right|nobaseline
								autoresize = no
								raw_text = "[MaintenanceSetting.GetExpense|2+=]@expense!"
							}
							tooltipwidget = {
								using = ExpenseSettingTooltip
							}
						}
					}
				}
			}

			expand = {}

			widget = {
				layoutpolicy_horizontal = expanding
				size = {-1 105 }
				hbox = {
					margin = { 20 0 }
					margin_left = 22
					margin_bottom = 15
					layoutpolicy_horizontal = expanding
					allow_outside = yes
	
					# Negative modifiers
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 90 }
						allow_outside = yes
	
						vbox = {
							visible = "[Not(StringIsEmpty(BureaucracyItem.GetEntrenchmentNegativeModifiers))]"
							layoutpolicy_horizontal = expanding
							margin = { 18 0 }

							scrollarea = {
								layoutpolicy_horizontal = expanding
								size = { -1 87 }
								scrollbarpolicy_horizontal = always_off
			
								scrollbar_vertical = {
									using = Scrollbar_Vertical
								}
			
								scrollwidget = {
									ModifiersList = {
										blockoverride "modifiers_list_size"{
											size = { -1 33 }
											margin_top = 3
											margin_bottom = 3
										}
										blockoverride "datamodel" {
											datamodel = "[StringToRowList(BureaucracyItem.GetEntrenchmentNegativeModifiers).GetRows]"
										}
										blockoverride "modifiers_list_bg" {
											using = bureaucracies_color_texture
											blockoverride "bureaucracies_color" {
												modify_texture = {
													blend_mode = overlay
													alpha = 0.7
													using = color_red_texture				
												}
											}
										}
									}
								}
							}
						}
						text_single = {
							visible = "[StringIsEmpty(BureaucracyItem.GetEntrenchmentNegativeModifiers)]"
							size = { 85% 20 }
							align = center
							parentanchor = center
							autoresize = no
							text = "NO_NEGATIVE_ENTRENCHMENT_MODIFIERS"
						}
						widget = {
							size = { 25 25 }
							parentanchor = bottom|hcenter
							position = {0 15}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/component_tiles/bureaucracy/bureaucracies_circle_side_icon.dds"
								texture_density = 2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/flat_icons/culture/culture_relation_negative.dds"
								texture_density = 2
								position = {0 -1}
							}
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "NEGATIVE_ENTRENCHMENT_MODIFIERS"
									}
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "gfx/interface/icons/flat_icons/culture/culture_relation_negative.dds"
										}
									}
									blockoverride "concept_link" {
										text = "[modifiers|E]"
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												text = "NEGATIVE_ENTRENCHMENT_MODIFIERS_DESC"
											}
											blockoverride "textblock_background_tint"  {
												modify_texture = {
													using = color_red_texture
												}
											}
										}
									}
								}
							}
						} 
					}
	
					# Constant modifiers
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 90 }
						allow_outside = yes
	
						vbox = {
							visible = "[Not(StringIsEmpty(BureaucracyItem.GetEntrenchmentNeutralModifiers))]"
							layoutpolicy_horizontal = expanding
							margin = { 18 0 }

							scrollarea = {
								layoutpolicy_horizontal = expanding
								size = { -1 87 }
								scrollbarpolicy_horizontal = always_off
			
								scrollbar_vertical = {
									using = Scrollbar_Vertical
								}
			
								scrollwidget = {
									ModifiersList = {
										blockoverride "modifiers_list_size"{
											size = { -1 33 }
											margin_top = 3
											margin_bottom = 3
										}
										blockoverride "datamodel" {
											datamodel = "[StringToRowList(BureaucracyItem.GetEntrenchmentNeutralModifiers).GetRows]"
										}
										blockoverride "modifiers_list_bg" {
											using = bureaucracies_color_texture
											blockoverride "bureaucracies_color" {
												modify_texture = {
													blend_mode = overlay
													alpha = 0.5
													using = color_yellow_texture
												}
											}
										}
									}
								}
							}
						}
						text_single = {
							visible = "[StringIsEmpty(BureaucracyItem.GetEntrenchmentNeutralModifiers)]"
							size = { 100% 20 }
							align = center
							parentanchor = center
							autoresize = no
							text = "NO_NEUTRAL_ENTRENCHMENT_MODIFIERS"
						}
						widget = {
							size = { 25 25 }
							parentanchor = bottom|hcenter
							position = {0 15}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/component_tiles/bureaucracy/bureaucracies_circle_side_icon.dds"
								texture_density = 2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/flat_icons/culture/culture_relation_neutral.dds"
								texture_density = 2
								position = {0 -1}
							}
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "NEUTRAL_ENTRENCHMENT_MODIFIERS"
									}
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "gfx/interface/icons/flat_icons/culture/culture_relation_neutral.dds"
										}
									}
									blockoverride "concept_link" {
										text = "[modifiers|E]"
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												text = "NEUTRAL_ENTRENCHMENT_MODIFIERS_DESC"
											}
											blockoverride "textblock_background_tint"  {
												modify_texture = {
													using = color_yellow_texture
												}
											}
										}
									}
								}
							}
						} 
					}

					# Positive modifiers
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 90 }
						allow_outside = yes
						vbox = {
							visible = "[Not(StringIsEmpty(BureaucracyItem.GetEntrenchmentPositiveModifiers))]"
							layoutpolicy_horizontal = expanding
							margin = { 18 0 }
							scrollarea = {
								layoutpolicy_horizontal = expanding
								size = { -1 87 }
								scrollbarpolicy_horizontal = always_off
								autoresizeviewport = yes
			
								scrollbar_vertical = {
									using = Scrollbar_Vertical
								}
			
								scrollwidget = {
									vbox = {
										ModifiersList = {
											layoutpolicy_horizontal = expanding
											blockoverride "modifiers_list_size"{
												size = { -1 33 }
												margin_top = 3
												margin_bottom = 3
											}
											blockoverride "datamodel" {
												datamodel = "[StringToRowList(BureaucracyItem.GetEntrenchmentPositiveModifiers).GetRows]"
											}
											blockoverride "modifiers_list_bg" {
												using = bureaucracies_color_texture
												blockoverride "bureaucracies_color" {
													modify_texture = {
														blend_mode = overlay
														alpha = 0.4
														using = color_light_green_texture
													}
												}
											}
										}
									}
								}
							}
						}
						text_single = {
							visible = "[StringIsEmpty(BureaucracyItem.GetEntrenchmentPositiveModifiers)]"
							size = { 100% 20 }
							align = center
							parentanchor = center
							autoresize = no
							text = "NO_POSITIVE_ENTRENCHMENT_MODIFIERS"
						}
						widget = { 
							size = { 25 25 }
							parentanchor = bottom|hcenter
							position = {0 15}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/component_tiles/bureaucracy/bureaucracies_circle_side_icon.dds"
								texture_density = 2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/flat_icons/culture/culture_relation_positive.dds"
								texture_density = 2
							}
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "POSITIVE_ENTRENCHMENT_MODIFIERS"
									}
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "gfx/interface/icons/flat_icons/culture/culture_relation_positive.dds"
										}
									}
									blockoverride "concept_link" {
										text = "[modifiers|E]"
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												text = "POSITIVE_ENTRENCHMENT_MODIFIERS_DESC"
											}
											blockoverride "textblock_background_tint"  {
												modify_texture = {
													using = color_light_green_texture
												}
											}
										}
									}
								}
							}
						} 
					}
				} 
				hbox = {
					margin = { 10 0 }
					margin_bottom = 3
					layoutpolicy_horizontal = expanding
					allow_outside = yes
	
					bureaucracy_column = {}
	
					expand = {}
	
					bureaucracy_column = {}
	
					expand = {}
	
					bureaucracy_column = {}
	
					expand = {}
	
					bureaucracy_column = {}
				}
			}
		}

		#Main Icon and implementation progress
		widget = {
			size = { 86 86 }
			parentanchor = top|left

			#Implementing
			piechart = {
				visible = "[And(Not(BureaucracyItem.GetBureaucracy.IsImplemented), BureaucracyItem.HasMaintenanceSetting)]"
				size = { 70% 70%}
				parentanchor = center
				position = {0 -12}
				
				datacontext = "[BureaucracyItem.GetMaintenanceSetting]"
				tooltipwidget = {
					using = ExpenseSettingTooltip
				}

				using = piechart_angles
				
				pieslice = {
					texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
					value = "[FixedPointToFloat(BureaucracyItem.GetBureaucracy.GetImplementationProgress)]"
					using = color_value_progress_blue
				}

				pieslice = {
					texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
					value = "[Subtract_float('(float)100.0', FixedPointToFloat(BureaucracyItem.GetBureaucracy.GetImplementationProgress))]"
					using = color_value_progress_gray
				}
			}

			#Already Implemented
			widget = {
				visible = "[And(BureaucracyItem.GetBureaucracy.IsImplemented, BureaucracyItem.HasMaintenanceSetting)]"
				size = { 75 75 }
				parentanchor = left|vcenter
				datacontext = "[BureaucracyItem.GetMaintenanceSetting]"
				tooltipwidget = {
					using = ExpenseSettingTooltip
				}
				
				icon = {
					parentanchor = center
					size = { 99% 99% }
					texture = "gfx/interface/component_tiles/bureaucracy/bureaucracy_circle.dds"
					# using = bg_circle_piechart
					# blockoverride "inside_color" {
					# 	modify_texture = {
					# 		using = color_dark_brown_texture
					# 		blend_mode = multiply
					# 	}
					# }
				}
				icon = {
					size = { 55 55 }
					parentanchor = center
					texture = "[GetBureaucracyIcon(BureaucracyItem.GetBureaucracy.GetType.Self)]"
				}
			}	
		}
	}

	type empty_bureaucracy_card = widget {
		size = { 100% 100% }
		widget = {
			size = { 98% 100% }
			parentanchor = right|vcenter
			action_button = {
				size = { 100% 100% }
				parentanchor = center
				using = bureaucracy_card_background
				left_action = { action_name = "add_bureaucracy_action" }
				actor = "[Player]"
				tooltipwidget = {
					using = action_tooltip_pop_out

					blockoverride "title_icon_texture" {
						texture = "[GetConceptTexture('bureaucracy')]"
					}
				}
			}

			text_single = {
				size = { 100% 20 }
				align = center
				parentanchor = center
				autoresize = no
				text = "ADD_BUREAUCRACY"
			}

			widget = {
				size = { 100% 100% }
				using = bg_cabinet_card_frame
			}
		}
	}

	type bureaucracy_item_card = widget {
		size = { 100% 185 }
		bureaucracy_card = {
			visible = "[BureaucracyItem.HasBureaucracy]"
		}
		empty_bureaucracy_card = {
			visible = "[Not(BureaucracyItem.HasBureaucracy)]"
		}
	}
}