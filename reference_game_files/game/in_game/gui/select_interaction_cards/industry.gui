# Tooltip for an industry type (name + icon + the location/country effects it grants).
template IndustryType_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				texture = "[IndustryType.GetIcon]"
				using = tooltip_title_icon_size
			}
		}
		blockoverride "title_text" {
			text = "[IndustryType.GetNameWithNoTooltip]"
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[IndustryType.GetTooltip]"
			}
		}
	}
}

template IndustryStatBuildings_tooltip {
	ContextualTooltipType = {
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					block "industry_stat_text" {
						text = "INDUSTRY_STAT_BUILDINGS_TT_TEXT"
					}
				}
			}
			TooltipListBase = {
				visible = "[DataModelHasItems(QuickIndustryBuildings.GetIndustryBuildings)]"

				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 240 }
					}

					blockoverride "section_content" {
						TooltipListColumnContent = {
							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_text" {
									text = "[building_type|e]"
								}
								blockoverride "column_title_right" {
									expand = {}
								}
								blockoverride "field_left" {
									icon = {
										size = { 25 25 }
										texture = "[GetBuildingIcon(Building.GetType.Self)]"
									}
								}
								blockoverride "field_text" {
									align = left|nobaseline
									raw_text = "[Building.GetLevel|0] [Building.GetType.GetName] in [Building.GetLocation.GetName]"
								}
								blockoverride "field_right" {
									expand = {}
								}
							}

							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_left" {
									expand = {}
								}
								blockoverride "column_title_text" { text = "[tax_base|e]" }
								blockoverride "field_left" {
									expand = {}
								}
								blockoverride "field_text" {
									raw_text = "[Building.GetTaxBaseValue|+=2]@tax_base!"
								}
							}

							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_left" {
									expand = {}
								}
								blockoverride "column_title_text" { text = "[income|e]" }
								blockoverride "field_left" {
									expand = {}
								}
								blockoverride "field_text" {
									raw_text = "[Building.GetIncomeToOwner|+=2]@income!"
								}
							}

							blockoverride "column_datamodel" { datamodel = "[QuickIndustryBuildings.GetIndustryBuildings]" }
						}
					}
				}
			}
		}
	}
}

types SelectInteractionIndustryCards {
	# Recap of the industry chosen in stage 1; its header button steps back to that stage.
	type selected_industry_header = clickable_header_card {
		datacontext = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('target').GetIndustryType]"

		blockoverride "layout_setup" {
			using = flexible_interaction_target_entry_setup
		}

		blockoverride "header_size" {
			size = { -1 48 }
		}

		blockoverride "header_color" {
			using = color_government_texture
		}

		blockoverride "header_content" {
			tooltipwidget = {
				using = IndustryType_tooltip
			}

			action_tooltip = {
				click_type = left
				click_mode = single
				title = "CHANGE_SELECTED_INDUSTRY"
				enabled = "[LateralView.CanGoBack]"
				on_action = "[LateralView.GoBack]"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 0 }
				spacing = 8

				icon = {
					size = { 38 38 }
					texture = "[IndustryType.GetIcon]"
					texture_density = 2
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					using = Font_Type_Headers
					text = "[IndustryType.GetName]"
					align = nobaseline
				}

				text_single = {
					autoresize = yes
					align = right|nobaseline
					default_format = "#explanation_link"
					text = "CHANGE_SELECTED_INDUSTRY"
				}
			}
		}

		blockoverride "bottom_content_layout" {
			vbox = {
				using = bg_paper_card
				using = layoutpolicy_expanding
				spacing = 5
				margin = { 5 5 }

				card_block_list = {
					textcontext = "[IndustryType.GetTooltip]"
					blockoverride "field_highlight" {}
				}
			}
		}
	}
}
