types SelectInteractionContentCards {
	type ambition_name_desc = clickable_header_card {
		blockoverride "layout_setup" {
			using = flexible_interaction_target_entry_setup
		}
		datacontext = "[InteractionTarget.GetAmbitionDefinition]"

		blockoverride "header_button" {
			card_header_button_01 = {
				size = { 100% 100% }
				using = select_interaction_target_action_provider
				using = bg_card_header_01
				tooltipwidget = {
					using = AmbitionDefinition_tooltip
				}

				icon = {
					size = { 6 100% }
					parentanchor = vcenter|left
					texture = "[GetAmbitionRankColor(AmbitionDefinition.Self)]"
				}

				hbox = {
					margin = { 12 0 }
					spacing = 8

					icon = {
						size = { 32 32 }
						texture = "[GetAmbitionDefinitionIcon(AmbitionDefinition.Self)]"
					}

					text_single = {
						using = layoutpolicy_expanding
						using = Font_Size_Medium
						default_format = "#yellow_titles"
						autoresize = no
						align = nobaseline
						text = "[AmbitionDefinition.GetNameWithNoTooltip]"
					}
				}
			}
		}

		blockoverride "bottom_content" {
			vbox = {
				spacing = 10
				margin = { 5 5 }

				using = flexible_interaction_target_entry_setup

				RequirementsList = {
					visible = "[Not(StringIsEmpty(GetAmbitionEnabledRequirements(AmbitionDefinition.Self)))]"
					textcontext = "[GetAmbitionEnabledRequirements(AmbitionDefinition.Self)]"
					blockoverride "requirementslist_datamodel_is_empty" {
						visible = no
					}
				}
			}
		}
	}

	type ambition_contest_name_desc = clickable_header_card {
		blockoverride "layout_setup" {
			using = flexible_interaction_target_entry_setup
		}
		datacontext = "[InteractionTarget.GetAmbition]"

		blockoverride "header_button" {
			card_header_button_01 = {
				size = { 100% 100% }
				using = select_interaction_target_action_provider
				using = bg_card_header_01
				tooltipwidget = {
					using = Ambition_tooltip
				}

				icon = {
					size = { 6 100% }
					parentanchor = vcenter|left
					texture = "[GetAmbitionRankColor(Ambition.GetAmbitionDefinition)]"
				}

				hbox = {
					margin = { 12 0 }
					spacing = 8

					icon = {
						size = { 32 32 }
						texture = "[GetAmbitionDefinitionIcon(Ambition.GetAmbitionDefinition)]"
					}

					text_single = {
						using = layoutpolicy_expanding
						using = Font_Size_Medium
						default_format = "#yellow_titles"
						autoresize = no
						align = nobaseline
						text = "[Ambition.GetNameWithNoTooltip]"
					}
				}
			}
		}

		blockoverride "bottom_content" {
			vbox = {
				margin = { 5 5 }

				using = flexible_interaction_target_entry_setup

				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					text = "[Ambition.GetTooltip]"
				}
			}
		}
	}
}
