types BattleSimulatorViewTypes
{
	type editor_button_no_tooltip = editor_button {
		tooltip_enabled = no
	}
}

window = {
	name = "battle_simulator_view"
	parentanchor = top|left
	size = { 900 900 }
	position = { 5 205 }
	widgetanchor = top|left
	movable = yes
	using = editor_window

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 10 10 }
		spacing = 5

		### HEADER ###
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			editor_textbox = { raw_text = "BATTLE SIMULATOR" autoresize = yes fontsize = 18 }
			expand = {}
			editor_button_no_tooltip = { raw_text = "[BattleSimulatorView.GetCombatTypeText]" size = { 200 30 } onclick = "[BattleSimulatorView.ToggleCombatType]" }
		}

		### SHARED SEARCH BOX ###
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			editor_textbox = { raw_text = "Search:" autoresize = yes }
			editor_editbox = { name = "search_box" text = "[BattleSimulatorView.GetSearchText]" ontextedited = "[BattleSimulatorView.OnSearchTextChanged(PdxGuiWidget.Self)]" size = { 380 25 } focuspolicy = all multiline = no }
			expand = {}
		}

		### DEFENDER COUNTRY PICKER ###
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Defender Country:" autoresize = yes }
				editor_button_no_tooltip = { raw_text = "[BattleSimulatorView.GetDefenderCountryText]" size = { 280 25 } onclick = "[BattleSimulatorView.ToggleCountryPicker]" }
				expand = {}
			}
			scrollarea = {
				visible = "[BattleSimulatorView.IsCountryPickerVisible]"
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 120 }
				maximumsize = { -1 180 }
				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = { using = Scrollbar_Vertical }
				scrollwidget = {
					vbox = {
						spacing = 1
						layoutpolicy_horizontal = expanding
						datamodel = "[BattleSimulatorView.GetCountryEntries]"
						item = {
							editor_button_no_tooltip = { raw_text = "[BattleSimCountryEntry.GetName]" layoutpolicy_horizontal = expanding size = { 0 22 } onclick = "[BattleSimCountryEntry.Select]" }
						}
					}
				}
			}
		}

		### LOCATION PICKERS ###
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 3
				editor_textbox = { raw_text = "Attacker Location:" autoresize = yes }
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 3
					editor_button_no_tooltip = { raw_text = "[BattleSimulatorView.GetAttackerLocationText]" layoutpolicy_horizontal = expanding size = { 0 25 } onclick = "[BattleSimulatorView.ToggleAttackerLocationPicker]" }
					editor_button_no_tooltip = { raw_text = "[SelectLocalization( BattleSimulatorView.IsPickingAttackerFromMap, 'Click map...', 'Pick on map' )]" size = { 100 25 } onclick = "[BattleSimulatorView.StartPickAttackerOnMap]" }
				}
				scrollarea = {
					visible = "[BattleSimulatorView.IsAttackerLocationPickerVisible]"
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 100 }
					maximumsize = { -1 160 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							spacing = 1
							layoutpolicy_horizontal = expanding
							datamodel = "[BattleSimulatorView.GetAttackerLocationEntries]"
							item = {
								editor_button_no_tooltip = { raw_text = "[BattleSimLocationEntry.GetName]" layoutpolicy_horizontal = expanding size = { 0 22 } onclick = "[BattleSimLocationEntry.Select]" }
							}
						}
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 3
				editor_textbox = { raw_text = "Defender Location:" autoresize = yes }
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 3
					editor_button_no_tooltip = { raw_text = "[BattleSimulatorView.GetDefenderLocationText]" layoutpolicy_horizontal = expanding size = { 0 25 } onclick = "[BattleSimulatorView.ToggleDefenderLocationPicker]" }
					editor_button_no_tooltip = { raw_text = "[SelectLocalization( BattleSimulatorView.IsPickingDefenderFromMap, 'Click map...', 'Pick on map' )]" size = { 100 25 } onclick = "[BattleSimulatorView.StartPickDefenderOnMap]" }
				}
				scrollarea = {
					visible = "[BattleSimulatorView.IsDefenderLocationPickerVisible]"
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 100 }
					maximumsize = { -1 160 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							spacing = 1
							layoutpolicy_horizontal = expanding
							datamodel = "[BattleSimulatorView.GetDefenderLocationEntries]"
							item = {
								editor_button_no_tooltip = { raw_text = "[BattleSimLocationEntry.GetName]" layoutpolicy_horizontal = expanding size = { 0 22 } onclick = "[BattleSimLocationEntry.Select]" }
							}
						}
					}
				}
			}
		}

		### SHARED DEFINITION PICKER (visible when any of the 4 list pickers is open) ###
		scrollarea = {
			visible = "[Or( Or( BattleSimulatorView.IsAttackerLevyPickerVisible, BattleSimulatorView.IsAttackerRegularPickerVisible ), Or( BattleSimulatorView.IsDefenderLevyPickerVisible, BattleSimulatorView.IsDefenderRegularPickerVisible ) )]"
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 100 }
			maximumsize = { -1 160 }
			scrollbarpolicy_horizontal = always_off
			scrollbar_vertical = { using = Scrollbar_Vertical }
			scrollwidget = {
				vbox = {
					spacing = 1
					layoutpolicy_horizontal = expanding
					datamodel = "[BattleSimulatorView.GetCurrentDefinitionEntries]"
					item = {
						editor_button_no_tooltip = { raw_text = "[BattleSimDefEntry.GetName]" layoutpolicy_horizontal = expanding size = { 0 22 } onclick = "[BattleSimDefEntry.Select]" }
					}
				}
			}
		}

		### TWO COLUMN LAYOUT: ATTACKER / DEFENDER ###
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 10

			### ATTACKER ###
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 400 0 }
				spacing = 3

				editor_textbox = { raw_text = "ATTACKER (Player)" autoresize = yes fontsize = 14 fontcolor = { 0.9 0.3 0.3 1.0 } }

				editor_textbox = { raw_text = "Levy:" autoresize = yes }
				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 80 }
					maximumsize = { -1 120 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							spacing = 2
							layoutpolicy_horizontal = expanding
							datamodel = "[BattleSimulatorView.GetAttackerLevyUnits]"
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 3
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetDisplayText]" autoresize = yes }
									expand = {}
									editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimUnitRow.DecrementCount]" }
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetCountText]" autoresize = yes minimumsize = { 30 0 } align = center }
									editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimUnitRow.IncrementCount]" }
									editor_button_no_tooltip = { raw_text = "X" size = { 25 25 } onclick = "[BattleSimUnitRow.Remove]" }
								}
							}
						}
					}
				}
				editor_button_no_tooltip = { raw_text = "Add Levy Unit" size = { 180 26 } onclick = "[BattleSimulatorView.ShowAttackerLevyPicker]" }

				editor_textbox = { raw_text = "Regular:" autoresize = yes }
				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 80 }
					maximumsize = { -1 120 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							spacing = 2
							layoutpolicy_horizontal = expanding
							datamodel = "[BattleSimulatorView.GetAttackerRegularUnits]"
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 3
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetDisplayText]" autoresize = yes }
									expand = {}
									editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimUnitRow.DecrementCount]" }
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetCountText]" autoresize = yes minimumsize = { 30 0 } align = center }
									editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimUnitRow.IncrementCount]" }
									editor_button_no_tooltip = { raw_text = "X" size = { 25 25 } onclick = "[BattleSimUnitRow.Remove]" }
								}
							}
						}
					}
				}
				editor_button_no_tooltip = { raw_text = "Add Regular Unit" size = { 180 26 } onclick = "[BattleSimulatorView.ShowAttackerRegularPicker]" }
			}

			### DEFENDER ###
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 400 0 }
				spacing = 3

				editor_textbox = { raw_text = "DEFENDER" autoresize = yes fontsize = 14 fontcolor = { 0.3 0.3 0.9 1.0 } }

				editor_textbox = { raw_text = "Levy:" autoresize = yes }
				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 80 }
					maximumsize = { -1 120 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							spacing = 2
							layoutpolicy_horizontal = expanding
							datamodel = "[BattleSimulatorView.GetDefenderLevyUnits]"
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 3
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetDisplayText]" autoresize = yes }
									expand = {}
									editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimUnitRow.DecrementCount]" }
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetCountText]" autoresize = yes minimumsize = { 30 0 } align = center }
									editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimUnitRow.IncrementCount]" }
									editor_button_no_tooltip = { raw_text = "X" size = { 25 25 } onclick = "[BattleSimUnitRow.Remove]" }
								}
							}
						}
					}
				}
				editor_button_no_tooltip = { raw_text = "Add Levy Unit" size = { 180 26 } onclick = "[BattleSimulatorView.ShowDefenderLevyPicker]" }

				editor_textbox = { raw_text = "Regular:" autoresize = yes }
				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 80 }
					maximumsize = { -1 120 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							spacing = 2
							layoutpolicy_horizontal = expanding
							datamodel = "[BattleSimulatorView.GetDefenderRegularUnits]"
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 3
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetDisplayText]" autoresize = yes }
									expand = {}
									editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimUnitRow.DecrementCount]" }
									editor_textbox = { raw_text = "[BattleSimUnitRow.GetCountText]" autoresize = yes minimumsize = { 30 0 } align = center }
									editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimUnitRow.IncrementCount]" }
									editor_button_no_tooltip = { raw_text = "X" size = { 25 25 } onclick = "[BattleSimUnitRow.Remove]" }
								}
							}
						}
					}
				}
				editor_button_no_tooltip = { raw_text = "Add Regular Unit" size = { 180 26 } onclick = "[BattleSimulatorView.ShowDefenderRegularPicker]" }
			}
		}

		### DICE RIG ###
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			editor_textbox = { raw_text = "DICE RIG (applies to ALL combats until cleared)" autoresize = yes fontsize = 14 }

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Attacker:" autoresize = yes }
				editor_button_no_tooltip = { raw_text = "[SelectLocalization( BattleSimulatorView.IsAttackerDiceRandom, 'Random', 'Fixed' )]" size = { 80 25 } onclick = "[BattleSimulatorView.ToggleAttackerDiceRandom]" }
				editor_button_no_tooltip = { visible = "[Not( BattleSimulatorView.IsAttackerDiceRandom )]" raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerDice]" }
				editor_textbox = { visible = "[Not( BattleSimulatorView.IsAttackerDiceRandom )]" raw_text = "[BattleSimulatorView.GetAttackerFixedDice]" autoresize = yes minimumsize = { 25 0 } align = center }
				editor_button_no_tooltip = { visible = "[Not( BattleSimulatorView.IsAttackerDiceRandom )]" raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerDice]" }

				editor_textbox = { raw_text = "Defender:" autoresize = yes }
				editor_button_no_tooltip = { raw_text = "[SelectLocalization( BattleSimulatorView.IsDefenderDiceRandom, 'Random', 'Fixed' )]" size = { 80 25 } onclick = "[BattleSimulatorView.ToggleDefenderDiceRandom]" }
				editor_button_no_tooltip = { visible = "[Not( BattleSimulatorView.IsDefenderDiceRandom )]" raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderDice]" }
				editor_textbox = { visible = "[Not( BattleSimulatorView.IsDefenderDiceRandom )]" raw_text = "[BattleSimulatorView.GetDefenderFixedDice]" autoresize = yes minimumsize = { 25 0 } align = center }
				editor_button_no_tooltip = { visible = "[Not( BattleSimulatorView.IsDefenderDiceRandom )]" raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderDice]" }

				expand = {}
				editor_button_no_tooltip = { visible = "[BattleSimulatorView.IsDiceRigEnabled]" raw_text = "Clear Dice Rig" size = { 130 25 } onclick = "[BattleSimulatorView.ClearDiceRig]" }
			}
		}

		### STAT OVERRIDES ###
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			editor_textbox = { raw_text = "STAT OVERRIDES (applies to ALL combats until cleared)" autoresize = yes fontsize = 14 }

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Attacker:" autoresize = yes minimumsize = { 70 0 } }
				editor_textbox = { raw_text = "Defender:" autoresize = yes minimumsize = { 70 0 } }
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Max Morale:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerMoraleOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerMoraleOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerMoraleOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderMoraleOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderMoraleOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderMoraleOverride]" }
			}

			hbox = {
				visible = "[BattleSimulatorView.IsLandCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Mil. Tactics:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerTacticsOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerTacticsOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerTacticsOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderTacticsOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderTacticsOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderTacticsOverride]" }
			}

			hbox = {
				visible = "[BattleSimulatorView.IsLandCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Discipline:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerDisciplineOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerDisciplineOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerDisciplineOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderDisciplineOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderDisciplineOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderDisciplineOverride]" }
			}

			hbox = {
				visible = "[BattleSimulatorView.IsLandCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Combined Arms:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerCombinedArmsOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerCombinedArmsOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerCombinedArmsOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderCombinedArmsOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderCombinedArmsOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderCombinedArmsOverride]" }
			}

			### NAVAL STAT OVERRIDES ###
			hbox = {
				visible = "[BattleSimulatorView.IsNavalCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Naval Dmg Done:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerNavalDamageDoneOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerNavalDamageDoneOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerNavalDamageDoneOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderNavalDamageDoneOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderNavalDamageDoneOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderNavalDamageDoneOverride]" }
			}

			hbox = {
				visible = "[BattleSimulatorView.IsNavalCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Naval Dmg Taken:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerNavalDamageTakenOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerNavalDamageTakenOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerNavalDamageTakenOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderNavalDamageTakenOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderNavalDamageTakenOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderNavalDamageTakenOverride]" }
			}

			hbox = {
				visible = "[BattleSimulatorView.IsNavalCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Naval Morale:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerNavalMoraleModifierOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerNavalMoraleModifierOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerNavalMoraleModifierOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderNavalMoraleModifierOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderNavalMoraleModifierOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderNavalMoraleModifierOverride]" }
			}

			hbox = {
				visible = "[BattleSimulatorView.IsNavalCombat]"
				layoutpolicy_horizontal = expanding
				spacing = 5
				editor_textbox = { raw_text = "Ship Capture %:" autoresize = yes minimumsize = { 85 0 } }
				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementAttackerShipCaptureChanceOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetAttackerShipCaptureChanceOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementAttackerShipCaptureChanceOverride]" }

				editor_button_no_tooltip = { raw_text = "-" size = { 25 25 } onclick = "[BattleSimulatorView.DecrementDefenderShipCaptureChanceOverride]" }
				editor_textbox = { raw_text = "[BattleSimulatorView.GetDefenderShipCaptureChanceOverrideText]" autoresize = yes minimumsize = { 40 0 } align = center }
				editor_button_no_tooltip = { raw_text = "+" size = { 25 25 } onclick = "[BattleSimulatorView.IncrementDefenderShipCaptureChanceOverride]" }
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				expand = {}
				editor_button_no_tooltip = { visible = "[BattleSimulatorView.IsStatOverrideEnabled]" raw_text = "Clear Stat Overrides" size = { 160 25 } onclick = "[BattleSimulatorView.ClearStatOverrides]" }
			}
		}

		### SPAWN ###
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			editor_textbox = { raw_text = "[BattleSimulatorView.GetSpawnInfo]" autoresize = yes }
			expand = {}
			editor_button_no_tooltip = { raw_text = "[SelectLocalization( BattleSimulatorView.GetDefenderAttacks, 'Defender Attacks: ON', 'Defender Attacks: OFF' )]" size = { 180 30 } onclick = "[BattleSimulatorView.ToggleDefenderAttacks]" }
			editor_button_no_tooltip = { raw_text = "SPAWN ARMIES" size = { 200 35 } onclick = "[BattleSimulatorView.SpawnArmies]" }
		}
	}
}
