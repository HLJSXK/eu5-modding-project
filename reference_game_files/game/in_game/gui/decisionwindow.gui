basic_priority_dialog = {
	name = "decision_window"

	visible = "[Not(IsPauseMenuShown)]"

	blockoverride "bg_dialog_extra" {
		background = {
			texture = "gfx/interface/component_decoration/decisions/decisions_outer_bg.dds"
			texture_density = 2
			spriteType = corneredstretched
			spriteBorder = { 6 6 }

			margin = {3 0}
			margin_bottom = 1

			using = color_dark_blue

			using = overlay_window
			using = overlay_leather

			modify_texture = {
				texture = "gfx/interface/component_decoration/decisions/chester_pattern.dds"
				texture_density = 2
				spriteType = corneredtiled
				spriteborder = { 0 0 }
				color = { 0.25 0.35 0.60 1.0 }
				blend_mode = normal
				alpha = 0.35
			}
		}
	}

	blockoverride "dialog_top_decoration_left" {}
	blockoverride "dialog_top_decoration_right" {}

	blockoverride "dialog_bg" {
		using = bg_age_event_inner
	}

	blockoverride "header_text" {
		text = "[DecisionWindow.GetTitle]"
	}

	blockoverride "block_scrollarea" {
		maximumsize = { -1 -1 }
	}

	blockoverride "dialog_content_bckg" {
		background = {
			texture = "gfx/interface/component_decoration/decisions/decisions_inner_bg.dds"
			texture_density = 2
			spriteType = corneredstretched
			spriteBorder = { 6 6 }
			alpha = 0.5
		}
		background = {
			texture = "gfx/interface/component_decoration/decisions/decisions_inner_frame.dds"
			texture_density = 2
			spriteType = corneredstretched
			spriteBorder = { 6 6 }
		}
	}

	widget = {
		ignore_layout = yes
		parentanchor = center
		using = layoutpolicy_expanding
		size = { 100% 100% }
		background = {
			texture = "gfx/interface/component_decoration/decisions/decisions_outer_frame.dds"
			texture_density = 2
			spriteType = corneredstretched
			spriteBorder = { 6 6 }
			margin = { 4 4 }
		}
	}

	blockoverride "content" {
		flowcontainer = {
			direction = vertical
			spacing = 10
			margin = { 20 10 }
			ignoreinvisible = yes

			# Image at the top of the window. Priority:
			#   1) Explicit `image = path/to.dds` from the decision — flat texture override.
			#   2) Otherwise, ecs_scene_viewer renders via DecisionWindow.GenerateSceneDesc.
			#      That call returns:
			#        - The tag-matched illustration's scene (illustration_tags + scope) when one matches.
			#        - Else a LocationScene anchored to a saved location/character target or capital.
			#      Same path event windows use; handles location-dependent scene-data (terrain, etc.).
			widget = {
				size = { 500 220 }
				visible = "[DecisionWindow.HasUniqueImage]"
				icon = {
					parentanchor = center
					size = { 500 220 }
					texture = "[DecisionWindow.GetUniqueImage]"
				}

				widget = {
					ignore_layout = yes
					size = { 100% 100% }
					using = bg_expeditions_illustration_frame
				}
			}
			widget = {
				size = { 500 220 }
				visible = "[Not(DecisionWindow.HasUniqueImage)]"
				ecs_scene_viewer_widget = {
					size = { 500 220 }
					name = "decision_window_scene_viewer"
					scene = "[DecisionWindow.GenerateSceneDesc]"
				}

				widget = {
					ignore_layout = yes
					size = { 100% 100% }
					using = bg_expeditions_illustration_frame
				}
			}


			scrollarea = {
				layoutpolicy_horizontal = expanding
				maximumsize = { -1 235 }

				autoresizescrollarea = yes
				autoresizeviewport = yes
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {
					widget = {
						minimumsize = { 510 -1 }

						text_multi = {
							parentanchor = left
							maximumsize = { 498 -1 }
							minimumsize = { 498 -1 }
							autoresize = yes
							resizeparent = yes
							align = center
							text = "[DecisionWindow.GetDescription]"
						}
					}
				}
			}

			scrollarea = {
				layoutpolicy_horizontal = expanding
				maximumsize = { -1 140 }
				visible = "[Not(StringIsEmpty(DecisionWindow.GetHistoricalInfo))]"

				autoresizescrollarea = yes
				autoresizeviewport = yes
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {
					vbox = {
						set_parent_dimension_to_minimum = height
						margin = { 5 10 }

						using = bg_square_tile
						blockoverride "square_extras" {
							alpha = 0.7
							modify_texture = {
								using = overlay_striped_texture
								blend_mode = overlay
								alpha = 0.5
							}
						}

						background = {
							using = tile_frame_squared_texture
							using = color_bg_brown
							modify_texture = {
								using = overlay_cloth_texture
								blend_mode = overlay
								alpha = 0.3
							}
						}
						using = bg_corner_flavor
						blockoverride "corner_flavor_texture" {
							texture = "gfx/interface/component_decoration/bg_corner_flavor_06.dds"
							texture_density = 2
							spriteType = Corneredstretched
							spriteborder = { 35 35 }
							margin = {-2 -2}
						}
						blockoverride "corner_flavor_color" {
							modify_texture = {
								using = color_bg_brown_texture
								blend_mode = multiply
							}
							modify_texture = {
								using = overlay_cloth_texture
								blend_mode = overlay
								alpha = 0.3
							}
						}

						spacing = 10

						text_multi = {
							name = "Historical_Info"

							minimumsize = { 500 -1 }
							maximumsize = { 500 -1 }
							autoresize = yes
							fontsize = 13
							margin = { 10 10 }

							using = Font_Type_Flavor
							default_format = "#flavor"
							text = "[DecisionWindow.GetHistoricalInfo]"
						}
					}
				}
			}

			dynamicgridbox = {
				layoutpolicy_horizontal = expanding
				datamodel_reuse_widgets = yes
				resizetofit = yes
				datamodel = "[DecisionWindow.GetOptions]"

				item = {
					widget = {
						size = { 500 34 }

						button_regular = {
							size = { 500 30 }
							parentanchor = center

							text = "[DecisionOptionItem.GetName]"
							enabled = "[DecisionOptionItem.IsEnabled]"
							onclick = "[DecisionOptionItem.OnClick]"

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "[DecisionOptionItem.GetName]"
									}
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "[GetConceptTexture('event_option')]"
										}
									}
									blockoverride "concept_link" {
										text = [event_option|e]
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												text = "[DecisionOptionItem.GetTooltip]"
											}
										}
									}
								}
							}
						}

						# Historical-option marker. Hidden on single-option decisions
						# (mirrors EventWindow.IsSingleOptionEvent / eventwindow.gui).
						widget = {
							position = { 7 0 }
							parentanchor = left|vcenter
							visible = "[And(DecisionOptionItem.IsHistorical, Not(DecisionWindow.IsSingleOptionDecision))]"
							size = { 26 26 }
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/events/history.dds"
							}
							tagtooltip_enabled = yes
							tooltip = "[historical_option|e]"
						}
					}
				}
			}
		}
	}

	blockoverride "bottom_buttons" {
	}
}
