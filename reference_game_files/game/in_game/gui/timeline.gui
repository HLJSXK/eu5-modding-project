			widget = {
				size = { 0 40 }
				allow_outside = yes
				alwaystransparent = yes

				widget = {
					size = { 160 40 }
					position = { -303 0 }

					icon = {
						texture = "[GetGraphicalCultureTexture('bg_speed_button')]"
						size = { 100% 100% }
						texture_density = 2
						spriteType = corneredstretched
						spriteborder = { 10 10 }
					}

					text_single = {
						parentanchor = center
						align = center|nobaseline
						default_format = "#T"
						fontsize = 15
						text = "TIMELINE_SPEED_SELECTOR"
						maximumsize = { 148 -1 }
						alwaystransparent = yes
					}
				}
			}
		}
