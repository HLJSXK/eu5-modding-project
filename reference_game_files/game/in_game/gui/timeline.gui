						}
					}
				}

				blockoverride "segment_lit_playing" {
					visible = "[And(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)200'), TimelinePlaybackPanel.IsPlaying)]"
				}

				blockoverride "segment_lit_paused" {
					visible = "[And(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)200'), Not(TimelinePlaybackPanel.IsPlaying))]"
				}

				blockoverride "segment_unlit" {
					visible = "[Not(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)200'))]"
				}
