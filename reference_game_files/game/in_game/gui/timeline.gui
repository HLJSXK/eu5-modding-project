template timeline_button_actions {
	visible = "[IsInmersionModeDisabled]"
	enabled = "[CanToggleTimelineMode]"
	action_tooltip = {
		title = "TOGGLE_TIMELINE_MODE"
		description = "TOGGLE_TIMELINE_MODE_DESC"
		on_action = "[ToggleTimelineMode]"
		enabled = "[CanToggleTimelineMode]"
	}
	tooltipwidget = { BasicFunctionalTooltip = {} }
}

template timeline_playback_button_bg {
	texture = "gfx/interface/buttons/square_button_texture.dds"
	texture_density = 2
	spriteType = corneredstretched
	spriteborder = { 4 4 }
	modify_texture = {
		using = color_intense_brown_texture
		blend_mode = add
	}
	modify_texture = {
		using = color_super_dark_brown_texture
		blend_mode = multiply
		alpha = 0.6
	}
	background = {
		texture = "gfx/interface/buttons/square_button_texture_bg.dds"
		texture_density = 2
		modify_texture = {
			using = color_intense_brown_texture
			blend_mode = add
		}
		modify_texture = {
			using = color_super_dark_brown_texture
			blend_mode = multiply
			alpha = 0.6
		}
	}
}

template timeline_playback_glyph {
	alwaystransparent = yes
	parentanchor = center
}

types TimelineTypes {
	type TimelineCountryFlag = widget {
		size = { 72 48 }

		country_flag_mid = {
			size = { 100% 100% }
			visible = "[And(Not(TimelineCountry.IsExtinct), Not(TimelineCountry.HasHistoricalIdentity))]"
			datacontext = "[TimelineCountry.GetLiveCountry]"
			blockoverride "tooltip" {}
		}

		country_flag = {
			visible = "[And(Or(TimelineCountry.IsExtinct, TimelineCountry.HasHistoricalIdentity), TimelineCountry.HasCoatOfArms)]"
			size = { 100% 100% }

			blockoverride "flag" {
				datacontext = "[TimelineCountry.GetCoatOfArms]"
				texture = "[CoatOfArmsWrapper.GetTexture('(int32)144','(int32)96')]"
				frame = "[CoatOfArmsWrapper.GetFrame('(int32)144','(int32)96')]"
				framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)144','(int32)96','(float)0.5')]"
				texture_density = 2
			}
			blockoverride "flag_frame_texture" {
				texture = "gfx/interface/component_decoration/flag_frames/frame_2.dds"
			}

			blockoverride "tooltip" {}
			blockoverride "contextmenu" {}
			blockoverride "click" {}
			blockoverride "rightclick" {}
			blockoverride "hover" {}
		}

		country_flag = {
			visible = "[Not(TimelineCountry.HasCoatOfArms)]"
			size = { 100% 100% }

			blockoverride "flag" {
				texture = "gfx/interface/coat_of_arms/flag_texture.dds"
				texture_density = 2
			}
			blockoverride "flag_frame_texture" {
				texture = "gfx/interface/component_decoration/flag_frames/frame_2.dds"
			}

			blockoverride "tooltip" {}
			blockoverride "contextmenu" {}
			blockoverride "click" {}
			blockoverride "rightclick" {}
			blockoverride "hover" {}
		}
	}

	type TimelineWorldPopulationTooltip = ContextualTooltipType {
		blockoverride "title_icon" {
			icon = {
				size = { 28 28 }
				texture = "gfx/interface/icons/situations/_default.dds"
			}
		}
		blockoverride "title_text" {
			text = "[TimelinePlaybackPanel.GetWorldPopulationYearLabel(PlotLine.GetSnappedIndexNearMouse)]"
		}

		blockoverride "concept_link" {
			text = "[TimelinePlaybackPanel.GetWorldPopulationValueLabel(PlotLine.GetSnappedIndexNearMouse)|L]"
		}

		blockoverride "tooltip_content" {
			hbox = {
				spacing = 10
				TimelineStats = {
					blockoverride "timeline_stats_title_icon" {
						icon = {
							size = { 24 24 }
							texture = "gfx/interface/icons/location_icons/population.dds"
						}
					}
					blockoverride "timeline_stats_header" {
						text = "TIMELINE_STATS_POPULATION"
					}
					blockoverride "timeline_stats_datamodel" {
						datamodel = "[TimelinePlaybackPanel.GetTopNPopulationForPlotIndex(PlotLine.GetInterpolatedIndexNearMouse)]"
					}
					blockoverride "timeline_stats_value" {
						text_single = {
							autoresize = yes
							default_format = "#color_white"
							raw_text = "[TimelineCountry.GetDisplayValue]"
						}
					}
					blockoverride "timeline_stats_tooltip" {
						tooltipwidget = {
							using = PopulationTimelineTooltip
						}
					}
				}

				TimelineStats = {
					blockoverride "timeline_stats_title_icon" {
						icon = {
							size = { 24 24 }
							texture = "[GetConceptTexture('economical_base')]"
						}
					}
					blockoverride "timeline_stats_header" {
						text = "TIMELINE_STATS_ECONOMICAL_BASE"
					}
					blockoverride "timeline_stats_datamodel" {
						datamodel = "[TimelinePlaybackPanel.GetTopNEconomicalBaseForPlotIndex(PlotLine.GetInterpolatedIndexNearMouse)]"
					}
				}

				TimelineStats = {
					blockoverride "timeline_stats_title_icon" {
						icon = {
							size = { 24 24 }
							texture = "[GetConceptTexture('tax_base')]"
						}
					}
					blockoverride "timeline_stats_header" {
						text = "TIMELINE_STATS_TAX_BASE"
					}
					blockoverride "timeline_stats_datamodel" {
						datamodel = "[TimelinePlaybackPanel.GetTopNTaxBaseForPlotIndex(PlotLine.GetInterpolatedIndexNearMouse)]"
					}
					blockoverride "timeline_stats_value" {
						hbox = {
							spacing = 2

							text_single = {
								autoresize = yes
								default_format = "#color_white"
								raw_text = "[TimelineCountry.GetValue|2]"
							}

							icon = {
								size = { 18 18 }
								texture = "[GetConceptTexture('tax_base')]"
							}
						}
					}
					blockoverride "timeline_stats_tooltip" {
						tooltipwidget = {
							using = TaxBaseTimelineTooltip
						}
					}
				}
			}
		}
	}
	type TimelineNoteDateRows = TooltipListBase {
		TooltipManualTableField = {
			visible = "[TimelineNotePlot.HasStartDate]"

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				text = "TIMELINE_NOTE_START_DATE"
			}

			text_single = {
				autoresize = yes
				align = right
				text = "[TimelineNotePlot.GetStartDateText]"
			}
		}

		TooltipManualTableField = {
			visible = "[TimelineNotePlot.HasEndDate]"

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				text = "TIMELINE_NOTE_END_DATE"
			}

			text_single = {
				autoresize = yes
				align = right
				text = "[TimelineNotePlot.GetEndDateText]"
			}
		}
	}

	type TimelineSpeedSegment = button {
		size = { 21 40 }
		texture_density = 2
		tooltip_enabled = no

		icon = {
			alwaystransparent = yes
			parentanchor = center
			size = { 100% 100% }
			texture_density = 2
			texture = "gfx/interface/component_tiles/hud_corners/speed_bar/speed_on.dds"
			block "segment_lit_playing" {}
		}

		icon = {
			alwaystransparent = yes
			parentanchor = center
			size = { 100% 100% }
			texture_density = 2
			texture = "gfx/interface/component_tiles/hud_corners/speed_bar/speed_paused.dds"
			block "segment_lit_paused" {}
		}

		icon = {
			alwaystransparent = yes
			parentanchor = center
			size = { 100% 100% }
			texture_density = 2
			texture = "gfx/interface/component_tiles/hud_corners/speed_bar/speed_disabled.dds"
			block "segment_unlit" {}
		}

		button = {
			parentanchor = center
			size = { 100% 100% }
			texture_density = 2
			texture = "gfx/interface/graphical_cultures/european_gfx/speed_button.dds"

			block "segment_action" {}
			block "segment_tooltip" {}
		}
	}

	type TimelineButton = button_regular {
		using = timeline_button_actions

		button = {
			alwaystransparent = yes
			size = { 75% 75% }
			parentanchor = center
			texture = "[GetConceptTexture('known_world')]"
		}
	}

	type TimelineMPToggle = button_regular {
		size = { 30 30 }
		enabled = "[GameIsMultiplayer]"

		action_tooltip = {
			title = "TIMELINE_TOGGLE_SHOW_ALL_PLAYERS"
			on_action = "[TimelinePlaybackPanel.ToggleShowAllPlayers]"
			enabled = "[GameIsMultiplayer]"
			conditions = "[MakeItFailIfLoc(Not(GameIsMultiplayer), 'TIMELINE_SHOW_ALL_PLAYERS_MP_ONLY')]"
		}
		tooltipwidget = { BasicFunctionalTooltip = {} }

		modify_texture = {
			visible = "[TimelinePlaybackPanel.IsAllPlayersShown]"
			using = color_white_texture
			alpha = 0.2
		}

		button = {
			alwaystransparent = yes
			size = { 66% 66% }
			parentanchor = center

			texture = "gfx/interface/icons/players.dds"
			modify_texture = {
				using = color_new_gold_texture
				alpha = 0.8
				blend_mode = overlay
			}
			modify_texture = {
				using = color_new_gold_texture
				alpha = 0.6
			}
			texture_density = 2

			using = button_panel_tab_icon_effect
			blockoverride "icon_effect_visible" { visible = no }
		}
	}

	type TimelineEconomyToggle = button_regular {
		size = { 30 30 }

		action_tooltip = {
			title = "TIMELINE_TOGGLE_ECONOMY_CHARTS"
			on_action = "[TimelinePlaybackPanel.ToggleEconomyChart]"
		}
		tooltipwidget = { BasicFunctionalTooltip = {} }

		modify_texture = {
			visible = "[TimelinePlaybackPanel.IsEconomyChartHidden]"
			using = color_white_texture
			alpha = 0.2
		}

		button = {
			alwaystransparent = yes
			size = { 80% 80% }
			parentanchor = center
			block "timeline_economy_toggle_icon" {
				texture = "[GetConceptTexture('economical_base')]"
			}
		}
	}

	type TimelinePieToggle = button_regular {
		size = { 30 30 }

		action_tooltip = {
			title = "[SelectLocalization(TimelinePlaybackPanel.ArePieChartsHidden, 'TIMELINE_TOGGLE_PIE_CHARTS', 'TIMELINE_TOGGLE_RANKING_LIST')]"
			on_action = "[TimelinePlaybackPanel.TogglePieCharts]"
		}
		tooltipwidget = { BasicFunctionalTooltip = {} }

		button = {
			alwaystransparent = yes
			visible = "[TimelinePlaybackPanel.ArePieChartsHidden]"
			size = { 66% 66% }
			parentanchor = center
			texture = "gfx/interface/icons/flat_icons/tabicons/demography_2.dds"
		}

		button = {
			alwaystransparent = yes
			visible = "[Not(TimelinePlaybackPanel.ArePieChartsHidden)]"
			size = { 66% 66% }
			parentanchor = center
			texture = "gfx/interface/icons/flat_icons/tabicons/info_flat_icon.dds"
		}
	}

	type TimelinePodiumSlot = widget {
		size = { 92 46 }

		widget = {
			parentanchor = bottom
			size = { 92 33 }

			using = bg_dark_paper_card
			using = bg_cabinet_card_frame

			hbox = {
				size = { 100% 100% }
				margin = { 5 3 }
				spacing = 4

				bookmark_02 = {
					blockoverride "bookmark_size" {
						size = { 8 100% }
					}
					blockoverride "bookmark_color" {
						tintcolor = "[TimelineCountry.GetMapColor]"
					}
				}

				country_flag_very_small = {
					visible = "[And(Not(TimelineCountry.IsExtinct), Not(TimelineCountry.HasHistoricalIdentity))]"
					datacontext = "[TimelineCountry.GetLiveCountry]"
					size = { 34 23 }
				}

				country_flag = {
					visible = "[And(Or(TimelineCountry.IsExtinct, TimelineCountry.HasHistoricalIdentity), TimelineCountry.HasCoatOfArms)]"
					size = { 34 23 }

					blockoverride "flag" {
						datacontext = "[TimelineCountry.GetCoatOfArms]"
						texture = "[CoatOfArmsWrapper.GetTexture('(int32)72','(int32)48')]"
						frame = "[CoatOfArmsWrapper.GetFrame('(int32)72','(int32)48')]"
						framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)72','(int32)48','(float)0.5')]"
						texture_density = 2
					}

					blockoverride "tooltip" {}
					blockoverride "contextmenu" {}
					blockoverride "click" {}
					blockoverride "rightclick" {}
					blockoverride "hover" {}
				}

				country_flag = {
					visible = "[Not(TimelineCountry.HasCoatOfArms)]"
					size = { 34 23 }

					blockoverride "flag" {
						texture = "gfx/interface/coat_of_arms/flag_texture.dds"
						texture_density = 2
					}

					blockoverride "tooltip" {}
					blockoverride "contextmenu" {}
					blockoverride "click" {}
					blockoverride "rightclick" {}
					blockoverride "hover" {}
				}

				text_single = {
					autoresize = yes
					block "podium_rank_text" {
						raw_text = "2"
					}
					using = Font_Type_Headers
					using = Font_Size_Medium
					default_format = "#color_white"
				}

				expand = {}
			}
		}
	}

