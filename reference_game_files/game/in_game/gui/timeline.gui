					}
				}

				blockoverride "segment_tooltip" {
					tooltipwidget = {
						LeftClickButtonTooltip = {
							blockoverride "onclick_text" {
								text = "TIMELINE_REPLAY_SPEED_1000"
							}
						}
					}
				}

				blockoverride "segment_lit_playing" {
					visible = "[And(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)1000'), TimelinePlaybackPanel.IsPlaying)]"
