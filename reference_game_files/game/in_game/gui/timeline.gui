	# DATE DISPLAY
	widget = {
		parentanchor = bottom|hcenter

		position = { 0 0 }
		state = {
			name = IsNotBottomPanelShown
			trigger_when = "[TimelinePlaybackPanel.IsBottomPanelHidden]"
			duration = 0.1
			using = Animation_Curve_EaseIn
			alpha = 1
			position = { 0 0 }
		}

		state = {
			name = IsBottomPanelShown
			trigger_when = "[Not(TimelinePlaybackPanel.IsBottomPanelHidden)]"
			duration = 0.1
			using = Animation_Curve_EaseIn
			alpha = 1
			position = { 0 @[-timeline_bottom_height] }
		}

		hbox = {
			set_parent_size_to_minimum = yes
			minimumsize = { -1 40 }
			using = bg_mapmenu_tab

			icon = {
				using = left_decoration_icon
			}

			hbox = {
				using = layoutpolicy_expanding

				button = {
					size = { 30 30 }
					using = timeline_playback_button_bg

					action_tooltip = {
						title = "TIMELINE_TOGGLE_BOTTOM_PANEL"
						on_action = "[TimelinePlaybackPanel.ToggleBottomPanel]"
					}

					tooltipwidget = { BasicFunctionalTooltip = {} }

					widget = {
						parentanchor = center
						size = { 66% 66% }

						button = {
							visible = "[Not(TimelinePlaybackPanel.IsBottomPanelHidden)]"
							size = { 100% 100% }
							alwaystransparent = yes
							texture = "gfx/interface/buttons/flats/button_simple_down.dds"
							using = color_gold
							modify_texture = {
								using = overlay_window_texture
								blend_mode = overlay
								alpha = 1
							}
						}

						button = {
							visible = "[TimelinePlaybackPanel.IsBottomPanelHidden]"
							size = { 100% 100% }
							alwaystransparent = yes
							mirror = vertical
							texture = "gfx/interface/buttons/flats/button_simple_down.dds"
							using = color_gold
							modify_texture = {
								using = overlay_window_texture
								blend_mode = overlay
								alpha = 1
							}
						}
					}
				}
			}

			icon = {
				using = right_decoration_icon
			}
		}
	}

	# BOTTOM PANEL
	widget = {
		visible = "[Not(TimelinePlaybackPanel.IsBottomPanelHidden)]"
		visible_at_creation = no
		size = { 100% @timeline_bottom_height }
		parentanchor = bottom|hcenter
		alwaystransparent = no
		using = bg_paper_card
		using = bg_age_event_frame

		position = { 0 @timeline_bottom_height }
		state = {
			name = _hide
			duration = 0.1
			using = Animation_Curve_EaseIn
			alpha = 0
			position = { 0 @timeline_bottom_height }
		}

		state = {
			name = _show
			duration = 0.1
			using = Animation_Curve_EaseIn
			alpha = 1
			position = { 0 0 }
		}

		hbox = {
			margin = { 10 0 }
			spacing = 10

			hbox = {
				spacing = 10

				widget = {
					visible = "[Not(TimelinePlaybackPanel.ArePieChartsHidden)]"
					minimumsize = { 300 295 }
					maximumsize = { 300 295 }

					vbox = {
						size = { 100% 100% }
						margin = { 5 1 }
						margin_bottom = 13
						spacing = 2
						using = bg_dark_paper_card

						TimelineStatsHeader = {
							blockoverride "timeline_stats_toggle_left" {
								TimelinePieToggle = {}
							}
							blockoverride "timeline_stats_title_icon" {
								icon = {
									size = { 24 24 }
									texture = "gfx/interface/icons/location_icons/population.dds"
								}
							}
							blockoverride "timeline_stats_header" {
								text = "TIMELINE_STATS_POPULATION"
							}
							blockoverride "timeline_stats_toggle_right" {
								TimelineMPToggle = {}
							}
						}
						icon_pie_left = {
							using = bg_circle_piechart_big
							blockoverride "PieSize" {
								size = { 170 170 }
							}
							blockoverride "pie_datamodel" {
								datamodel = "[TimelinePlaybackPanel.GetTopNPopulation]"
							}
							blockoverride "Icon" {
								texture = "gfx/interface/icons/location_icons/population.dds"
							}
							blockoverride "SliceValue" {
								value = "[FixedPointToFloat(TimelineCountry.GetValue)]"
							}
							blockoverride "SliceColor" {
								color = "[TimelineCountry.GetMapColor]"
							}
							blockoverride "SliceTooltip" {
								tooltipwidget = {
									using = PopulationTimelineTooltip
								}
							}
						}
						vbox = {
							spacing = 4
							margin = { 0 0 }

							hbox = {
								spacing = 4

								TimelinePodiumSlot = {
									visible = "[TimelinePlaybackPanel.HasPodiumRowPopulation('(int32)1')]"
									datacontext = "[TimelinePlaybackPanel.GetPodiumRowPopulation('(int32)1')]"
									blockoverride "podium_rank_text" {
										raw_text = "2"
									}
								}

								TimelinePodiumSlotFirst = {
									visible = "[TimelinePlaybackPanel.HasPodiumRowPopulation('(int32)0')]"
									datacontext = "[TimelinePlaybackPanel.GetPodiumRowPopulation('(int32)0')]"
									blockoverride "podium_rank_text" {
										raw_text = "1"
									}
								}

								TimelinePodiumSlotSmall = {
									visible = "[TimelinePlaybackPanel.HasPodiumRowPopulation('(int32)2')]"
									datacontext = "[TimelinePlaybackPanel.GetPodiumRowPopulation('(int32)2')]"
									blockoverride "podium_rank_text" {
										raw_text = "3"
									}
								}
							}
						}
					}

					widget = {
						size = { 100% 100% }
						using = bg_cabinet_card_frame
						blockoverride "cabinet_card_shadow" {
							alpha = 0
						}
					}
				}

				TimelineStats = {
					visible = "[TimelinePlaybackPanel.ArePieChartsHidden]"
					blockoverride "timeline_stats_size" {
						set_parent_size_to_minimum = yes
						minimumsize = { 300 295 }
					}
					blockoverride "timeline_stats_title_icon" {
						icon = {
							size = { 24 24 }
							texture = "gfx/interface/icons/location_icons/population.dds"
						}
					}
					blockoverride "timeline_stats_toggle_left" {
						TimelinePieToggle = {}
					}
					blockoverride "timeline_stats_toggle_right" {
						TimelineMPToggle = {}
					}
					blockoverride "timeline_stats_header" {
						text = "TIMELINE_STATS_POPULATION"
					}
					blockoverride "timeline_stats_datamodel" {
						datamodel = "[TimelinePlaybackPanel.GetTopNPopulation]"
					}
					blockoverride "timeline_stats_value" {
						text_single = {
							autoresize = yes
							default_format = "#color_white"
							raw_text = "[TimelineCountry.GetDisplayValue]"
						}
					}
					blockoverride "timeline_stats_tooltip" {
						tooltipwidget = {
							using = PopulationTimelineTooltip
						}
					}
				}
			}

			# Historic Population
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 295 }
				onmousehierarchyleave = "[TimelinePlaybackPanel.ClearWorldPopulationHover]"

				vbox = {
					margin = { 5 5 }

					# header
					TooltipTableHeader = {
						layoutpolicy_horizontal = expanding
						blockoverride "tooltip_minimumsize" {}
						blockoverride "tooltip_text_color" {}
						minimumsize = { -1 40 }
						using = bg_generic_shadow
						block "bg_expandable_color" {
							using = bg_card_header_01_diplomacy
						}
						using = bg_card_header_texture
						using = bg_generic_side_mask

						blockoverride "tableheader_text" {
							align = center
							fontsize = 17
							raw_text = "World Population"
							using = Font_Type_Headers
							using = Font_Size_Medium
							default_format = "#color_white"
						}
					}

					
					widget = {
						using = layoutpolicy_expanding

						vbox = {
							using = layoutpolicy_expanding
							margin_left = 10
							margin_right = 20
							margin_bottom = 10
							margin_top = 20
							allow_outside = yes
		
							hbox = {
								using = layoutpolicy_expanding
								allow_outside = yes

								# Y axis
								vbox = {
									visible = "[TimelinePlaybackPanel.HasWorldPopulationHistory]"
									layoutpolicy_vertical = expanding
									bottomtotop = yes
									allow_outside = yes

									widget = {
										size = { 75 1 }

										icon = {
											parentanchor = right
											size = { 5 100% }
											using = color_white_texture
										}

										text_single = {
											parentanchor = vcenter|right
											margin_right = 10
											using = Font_Size_Small
											default_format = "#t"
											text = "[TimelinePlaybackPanel.GetWorldPopulationMinLabel]"
										}
									}

									datamodel = "[DataModelRepeatedItem('(int32)4')]"
									item = {
										widget = {
											layoutpolicy_vertical = expanding
											size = { 75 -1 }
											allow_outside = yes

											widget = {
												size = { 100% 1 }
												allow_outside = yes

												icon = {
													parentanchor = right
													size = { 5 100% }
													using = color_white_texture
												}

												text_single = {
													parentanchor = vcenter|right
													margin_right = 10
													using = Font_Size_Small
													default_format = "#t"
													text = "[TimelinePlaybackPanel.GetWorldPopulationAxisStepLabel('(int32)4', Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'))]"
												}
											}
										}
									}
								}

								# left border
								icon = {
									layoutpolicy_vertical = expanding
									size = { 1 -1 }
									using = color_bone_texture
								}
								
								# graph
								widget = {
									using = layoutpolicy_expanding
									allow_outside = yes

									using = bg_text_mask_container_dark_brown
									background = {
										using = plotchart_grid_texture

										modify_texture = {
											using = color_super_dark_brown_texture
											blend_mode = add
											alpha = 0.7
										}
										modify_texture = {
											using = color_super_dark_brown_texture
											blend_mode = overlay
										}
									}

									plotline = {
										size = { 100% 100% }
										using = plot_line
										width = 3

										color = { .9 .9 .9 1.0 }

										using = tooltip_se
										tooltipwidget = { TimelineWorldPopulationTooltip = {} }

										visible = "[TimelinePlaybackPanel.HasWorldPopulationHistory]"
										plotpoints = "[TimelinePlaybackPanel.GetWorldPopulationPlotPoints]"
									}

									plotline = {
										visible = "[TimelinePlaybackPanel.HasWorldPopulationHistory]"
										size = { 100% 100% }
										using = plot_line
										width = 2
										color = { 1.0 0.85 0.2 0.9 }
										plotpoints = "[TimelinePlaybackPanel.GetPlaybackMarkerPlotPoints]"
									}

									widget = {
										size = { 100% 80% }
										parentanchor = center
										allow_outside = yes
										datamodel = "[TimelinePlaybackPanel.GetTimelineNotesForPopGraph]"
										item = {
											widget = {
												size = { 32 32 }
												widgetanchor = center
												allow_outside = yes
												alwaystransparent = yes
												position = "[PdxGuiWidget.AccessParent.GetPercentPositionFrom(TimelineNotePlot.GetPlotX, TimelineNotePlot.GetPlotY)]"

												using = bg_circle_piechart

												icon = {
													visible = "[TimelineNotePlot.HasSituation]"
													datacontext = "[TimelineNotePlot.GetSituation]"
													size = { 30 30 }
													parentanchor = center
													texture = "[Situation.GetIcon]"
													tooltipwidget = {
														using = Situation_tooltip
														blockoverride "situation_tooltip_end_requirements" {}
														blockoverride "situation_tooltip_extra" {
															TimelineNoteDateRows = {}
														}
													}
												}

												icon = {
													visible = "[TimelineNotePlot.HasDisasterType]"
													datacontext = "[TimelineNotePlot.GetDisasterType]"
													size = { 30 30 }
													parentanchor = center
													texture = "[DisasterType.GetIcon]"
													tooltipwidget = {
														using = DisasterType_tooltip
														blockoverride "disaster_type_tooltip_requirements" {}
														blockoverride "disaster_type_tooltip_extra" {
															TimelineNoteDateRows = {}
														}
													}
												}

												icon = {
													visible = "[Not(TimelineNotePlot.HasSourceContent)]"
													size = { 26 26 }
													parentanchor = center
													texture = "gfx/interface/icons/situations/_default.dds"
													tooltipwidget = {
														BasicFunctionalTooltip = {
															blockoverride "tooltip_content" {
																TooltipTextBlock = {
																	blockoverride "text" {
																		text = "[TimelineNotePlot.GetNoteText]"
																	}
																}
																TimelineNoteDateRows = {}
															}
														}
													}
												}

												hbox = {
													parentanchor = bottom|hcenter
													widgetanchor = top|hcenter
													position = { 0 -2 }
													allow_outside = yes
													alwaystransparent = yes
													margin = { 7 0 }
													maximumsize = { -1 13 }

													using = bg_paper_card

													text_single = {
														autoresize = yes
														align = center
														fontsize = 10
														text = "[SelectLocalization(TimelineNotePlot.IsEndNote, 'TIMELINE_NOTE_END', 'TIMELINE_NOTE_START')]"
													}
												}
											}
										}
									}
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								allow_outside = yes

								# padding
								widget = {
									visible = "[TimelinePlaybackPanel.HasWorldPopulationHistory]"
									size = { 75 30 }
								}

								vbox = {
									using = layoutpolicy_expanding

									# bottom border
									icon = {
										layoutpolicy_horizontal = expanding
										size = { -1 1 }
										using = color_bone_texture
									}

									# X axis
									hbox = {
										visible = "[TimelinePlaybackPanel.HasWorldPopulationHistory]"
										using = layoutpolicy_expanding
										allow_outside = yes

										widget = {
											size = { 1 30 }
											allow_outside = yes

											icon = {
												size = { 100% 5 }
												using = color_white_texture
											}

											text_single = {
												parentanchor = hcenter|top
												margin_top = 10
												using = Font_Size_Small
												default_format = "#t"
												text = "[TimelinePlaybackPanel.GetWorldPopulationStartYear]"
											}
										}

										datamodel = "[DataModelRepeatedItem(GetAxisStepCount(TimelinePlaybackPanel.GetWorldPopulationStartYear, TimelinePlaybackPanel.GetWorldPopulationEndYear, '(int32)10'))]"
										item = {
											widget = {
												layoutpolicy_horizontal = expanding
												size = { -1 30 }
												allow_outside = yes

												widget = {
													parentanchor = right
													size = { 1 100% }
													allow_outside = yes

													icon = {
														size = { 100% 5 }
														using = color_white_texture
													}

													text_single = {
														parentanchor = hcenter|top
														margin_top = 10
														using = Font_Size_Small
														default_format = "#t"
														text = "[GetAxisStepYear(TimelinePlaybackPanel.GetWorldPopulationStartYear, TimelinePlaybackPanel.GetWorldPopulationEndYear, '(int32)10', Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'))]"
													}
												}
											}
										}
									}
								
									expand = { visible = "[Not(TimelinePlaybackPanel.HasWorldPopulationHistory)]" }
								}
							}
						}
					}
				}

				widget = {
					size = { 100% 100% }
					using = bg_cabinet_card_frame
					ignore_layout = yes
				}
			}

