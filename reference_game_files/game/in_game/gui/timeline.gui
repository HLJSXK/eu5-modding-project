						}
					}

					widget = {
						size = { 100% 100% }
						using = bg_cabinet_card_frame
						blockoverride "cabinet_card_shadow" {
							alpha = 0
						}
					}
				}
			}

			hbox = {
				visible = "[TimelinePlaybackPanel.IsEconomyChartHidden]"
				spacing = 10

				TimelineStats = {
					visible = "[TimelinePlaybackPanel.ArePieChartsHidden]"
					blockoverride "timeline_stats_size" {
						set_parent_size_to_minimum = yes
						minimumsize = { 300 295 }
					}
					blockoverride "timeline_stats_title_icon" {
						TimelineEconomyToggle = {
							blockoverride "timeline_economy_toggle_icon" {
								texture = "[GetConceptTexture('tax_base')]"
							}
						}
					}
					blockoverride "timeline_stats_header" {
						text = "TIMELINE_STATS_TAX_BASE"
					}
					blockoverride "timeline_stats_datamodel" {
						datamodel = "[TimelinePlaybackPanel.GetTopNTaxBase]"
					}
					blockoverride "timeline_stats_value" {
						hbox = {
							spacing = 2

							text_single = {
								autoresize = yes
								default_format = "#color_white"
								raw_text = "[TimelineCountry.GetValue|2]"
							}

							icon = {
								size = { 18 18 }
								texture = "[GetConceptTexture('tax_base')]"
							}
						}
					}
					blockoverride "timeline_stats_tooltip" {
						tooltipwidget = {
							using = TaxBaseTimelineTooltip
						}
					}
					blockoverride "timeline_stats_toggle_left" {
						TimelineMPToggle = {}
					}
					blockoverride "timeline_stats_toggle_right" {
						TimelinePieToggle = {}
					}
				}

				widget = {
					visible = "[Not(TimelinePlaybackPanel.ArePieChartsHidden)]"
					minimumsize = { 300 295 }
					maximumsize = { 300 295 }

					vbox = {
						size = { 100% 100% }
						margin = { 5 1 }
						margin_bottom = 13
						spacing = 2
						using = bg_dark_paper_card

						TimelineStatsHeader = {
							blockoverride "timeline_stats_toggle_left" {
								TimelineMPToggle = {}
							}
							blockoverride "timeline_stats_title_icon" {
								TimelineEconomyToggle = {
									blockoverride "timeline_economy_toggle_icon" {
										texture = "[GetConceptTexture('tax_base')]"
									}
								}
							}
							blockoverride "timeline_stats_header" {
								text = "TIMELINE_STATS_TAX_BASE"
							}
							blockoverride "timeline_stats_toggle_right" {
								TimelinePieToggle = {}
							}
						}
						icon_pie_left = {
							using = bg_circle_piechart_big
							blockoverride "PieSize" {
								size = { 170 170 }
							}
							blockoverride "pie_datamodel" {
								datamodel = "[TimelinePlaybackPanel.GetTopNTaxBase]"
							}
							blockoverride "Icon" {
								texture = "[GetConceptTexture('tax_base')]"
							}
							blockoverride "SliceValue" {
								value = "[FixedPointToFloat(TimelineCountry.GetValue)]"
							}
							blockoverride "SliceColor" {
								color = "[TimelineCountry.GetMapColor]"
							}
							blockoverride "SliceTooltip" {
								tooltipwidget = {
									using = TaxBaseTimelineTooltip
								}
							}
						}
						vbox = {
							spacing = 4
							margin = { 0 0 }

							hbox = {
								spacing = 4

								TimelinePodiumSlot = {
									visible = "[TimelinePlaybackPanel.HasPodiumRowTaxBase('(int32)1')]"
									datacontext = "[TimelinePlaybackPanel.GetPodiumRowTaxBase('(int32)1')]"
									blockoverride "podium_rank_text" {
										raw_text = "2"
									}
								}

								TimelinePodiumSlotFirst = {
									visible = "[TimelinePlaybackPanel.HasPodiumRowTaxBase('(int32)0')]"
									datacontext = "[TimelinePlaybackPanel.GetPodiumRowTaxBase('(int32)0')]"
									blockoverride "podium_rank_text" {
										raw_text = "1"
									}
								}

								TimelinePodiumSlotSmall = {
									visible = "[TimelinePlaybackPanel.HasPodiumRowTaxBase('(int32)2')]"
									datacontext = "[TimelinePlaybackPanel.GetPodiumRowTaxBase('(int32)2')]"
									blockoverride "podium_rank_text" {
										raw_text = "3"
									}
								}
							}
						}
					}

					widget = {
						size = { 100% 100% }
						using = bg_cabinet_card_frame
						blockoverride "cabinet_card_shadow" {
							alpha = 0
						}
					}
				}
			}

			blockoverride "PieSize" { size = { 150 150 } }
		}
	}
}
