	type TimelineStatsHeader = widget {
		layoutpolicy_horizontal = expanding
		size = { -1 40 }

		using = bg_generic_shadow
		block "bg_expandable_color" {
			using = bg_card_header_01_diplomacy
		}
		using = bg_card_header_texture
		using = bg_generic_side_mask

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 5
			margin = { 6 0 }

			block "timeline_stats_toggle_left" {}

			expand = {}

			block "timeline_stats_title_icon" {
				icon = {
					size = { 24 24 }
					texture = "[GetConceptTexture('economical_base')]"
				}
			}

			text_single = {
				autoresize = yes

				block "timeline_stats_header" {
					text = "TIMELINE_STATS_ECONOMICAL_BASE"
				}
				align = center|nobaseline
				using = Font_Type_Headers
				using = Font_Size_Medium
				default_format = "#color_white"
			}

			expand = {}

			block "timeline_stats_toggle_right" {}
		}
	}

	type TimelineStats = widget {
		vbox = {
			block "timeline_stats_size" {
				set_parent_size_to_minimum = yes
				minimumsize =  { 300 -1 }
			}
			margin = { 5 5 }
			margin_top = 5
			using = bg_listbase_template

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 40 }

				using = bg_generic_shadow
				block "bg_expandable_color" {
					using = bg_card_header_01_diplomacy
				}
				using = bg_card_header_texture
				using = bg_generic_side_mask

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 5
					margin = { 6 0 }

					block "timeline_stats_toggle_left" {}

					expand = {}

					block "timeline_stats_title_icon" {
						icon = {
							size = { 24 24 }
							texture = "[GetConceptTexture('economical_base')]"
						}
					}

					text_single = {
						autoresize = yes

						block "timeline_stats_header" {
							text = "TIMELINE_STATS_ECONOMICAL_BASE"
						}
						align = center|nobaseline
						using = Font_Type_Headers
						using = Font_Size_Medium
						default_format = "#color_white"
					}

					expand = {}

					block "timeline_stats_toggle_right" {}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				block "timeline_stats_datamodel" {
					datamodel = "[TimelinePlaybackPanel.GetTopNEconomicalBase]"
				}
				item = {
					widget = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						minimumsize = { -1 24 }

						hbox = {
							layoutpolicy_horizontal = expanding

							bookmark_02 = {
								blockoverride "bookmark_size" {
									size = { 12 100% }
								}
								blockoverride "bookmark_color" {
									tintcolor = "[TimelineCountry.GetMapColor]"
								}
							}

							widget = {
								using = layoutpolicy_expanding

								background = {
									visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
									using = tooltip_table_field_texture
								}

								background = {
									visible = "[TimelineCountry.IsPlayer]"
									using = color_light_green_texture
									alpha = 0.2
								}

								background = {
									visible = "[And(Not(TimelineCountry.IsPlayer), TimelineCountry.HasHumanController)]"
									using = color_progress_blue_texture
									alpha = 0.2
								}

								progressbar = {
									size = { 100% 23 }
									parentanchor = center
									using = progress_bar_goldish
									direction = horizontal
									min = 0
									max = 1
									value = "[FixedPointToFloat(TimelineCountry.GetValueFraction)]"
									alpha = 0.7
									alwaystransparent = yes
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 5 0 }
									spacing = 5

									text_single = {
										size = { 22 22 }
										autoresize = no
										default_format = "#color_white"
										raw_text = "[TimelineCountry.GetRank]"
										using = Font_Size_Medium
									}

									country_flag_very_small = {
										visible = "[And(Not(TimelineCountry.IsExtinct), Not(TimelineCountry.HasHistoricalIdentity))]"
										datacontext = "[TimelineCountry.GetLiveCountry]"
									}

									country_flag = {
										visible = "[And(Or(TimelineCountry.IsExtinct, TimelineCountry.HasHistoricalIdentity), TimelineCountry.HasCoatOfArms)]"
										size = { 30 20 }

										blockoverride "flag" {
											datacontext = "[TimelineCountry.GetCoatOfArms]"
											texture = "[CoatOfArmsWrapper.GetTexture('(int32)72','(int32)48')]"
											frame = "[CoatOfArmsWrapper.GetFrame('(int32)72','(int32)48')]"
											framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)72','(int32)48','(float)0.5')]"
											texture_density = 2
										}

										blockoverride "tooltip" {}
										blockoverride "contextmenu" {}
										blockoverride "click" {}
										blockoverride "rightclick" {}
										blockoverride "hover" {}
									}

									country_flag = {
										visible = "[Not(TimelineCountry.HasCoatOfArms)]"
										size = { 30 20 }

										blockoverride "flag" {
											texture = "gfx/interface/coat_of_arms/flag_texture.dds"
											texture_density = 2
										}

										blockoverride "tooltip" {}
										blockoverride "contextmenu" {}
										blockoverride "click" {}
										blockoverride "rightclick" {}
										blockoverride "hover" {}
									}

									text_single = {
										visible = "[Or(Not(TimelineCountry.HasHumanController), Not(TimelinePlaybackPanel.IsAllPlayersShown))]"
										layoutpolicy_horizontal = expanding
										size = { -1 22 }
										default_format = "#yellow_titles"
										align = left
										raw_text = "[TimelineCountry.GetNameWithNoTooltip]"
									}

									text_single = {
										visible = "[And(TimelineCountry.HasHumanController, TimelinePlaybackPanel.IsAllPlayersShown)]"
										layoutpolicy_horizontal = expanding
										size = { -1 22 }
										default_format = "#yellow_titles"
										align = left
										raw_text = "[TimelineCountry.GetPlayerName]"
									}

									block "timeline_stats_value" {
										hbox = {
											spacing = 2

											text_single = {
												autoresize = yes
												default_format = "#color_white"
												raw_text = "[TimelineCountry.GetValue|2]"
											}

											icon = {
												size = { 18 18 }
												texture = "[GetConceptTexture('economical_base')]"
											}
										}
									}
								}
							}
						}
						tooltip_enabled = yes
						datacontext = "[TimelineCountry.GetLiveCountry]"
						block "timeline_stats_tooltip" {
							tooltipwidget = {
								using = EconomicalBaseTimelineTooltip
							}
						}
					}
				}
			}
		}

		widget = {
			size = { 100% 100% }
			using = bg_cabinet_card_frame
		}
	}

}

@timeline_topbar_height = 40
@timeline_bottom_height = 300

widget = {
	name = "timeline_view"
	size = { 100% 100% }
	layer = middle

	vbox = {
		widget = {
			using = layoutpolicy_expanding
			size = { -1 -1 }

			vignette = {
				visible = "[Not(TimelinePlaybackPanel.IsPlaying)]"
				blockoverride "vignette_background_margins" {
					margin_top = @[-timeline_topbar_height]
				}

				blockoverride "vignette_ui_hide_animation" {}
			}
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 0 }

			alwaystransparent = yes
			allow_outside = yes

			error_platypus = {
				visible_at_creation = no
				visible = "[HasErrors]"
				parentanchor = top|right
				widgetanchor = bottom|hcenter
				position = { -500 0 }
			}

			state = {
				name = IsNotBottomPanelShown
				trigger_when = "[TimelinePlaybackPanel.IsBottomPanelHidden]"
				duration = 0.1
				using = Animation_Curve_EaseIn
				size = { -1 0 }
			}

			state = {
				name = IsBottomPanelShown
				trigger_when = "[Not(TimelinePlaybackPanel.IsBottomPanelHidden)]"
				duration = 0.1
				using = Animation_Curve_EaseIn
				size = { -1 @timeline_bottom_height }
			}
		}
	}

	# DATE DISPLAY
	widget = {
		parentanchor = top|hcenter
		position = { 0 @[timeline_topbar_height -2] }

		hbox = {
			set_parent_size_to_minimum = yes
			minimumsize = { -1 40 }
			using = bg_mapmenu_tab


			icon = {
				using = left_decoration_icon
				mirror = vertical
			}

			hbox = {
				using = layoutpolicy_expanding

				text_single = {
					size = { 350 32 }
					using = Font_Type_Headers
					using = Font_Size_Medium
					align = center
					default_format = "#color_white"
					autoresize = no
					text = "[TimelinePlaybackPanel.GetCursorDateString]"
				}
			}

			icon = {
				using = right_decoration_icon
				mirror = horizontal|vertical
			}

			blockoverride "bg_mapmenu_texture_setup" { mirror = vertical }
		}
	}

	# TOP BAR
	widget = {
		size = { 100% @timeline_topbar_height }
		parentanchor = top|hcenter
		alwaystransparent = no
		using = top_bar_bg
		filter_mouse = right|left

		using = Animation_Show_Hide_UI_Lobby

		hbox = {
			using = layoutpolicy_expanding
			expand = {}

			button = {
				size = { 32 32 }
				using = timeline_playback_button_bg
				input_action = "timeline_jump_to_start"
				action_tooltip = {
					title = "TIMELINE_JUMP_TO_START"
					description = "TIMELINE_JUMP_TO_START_DESC"
					on_action = "[TimelinePlaybackPanel.OnJumpToStart]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }

				button = {
					using = timeline_playback_glyph
					size = { 66% 66% }
					texture = "gfx/interface/icons/messages_settings/jump_to_the_end.dds"
					mirror = horizontal
				}
			}

			button = {
				size = { 48 32 }
				using = timeline_playback_button_bg
				action_tooltip = {
					title = "TIMELINE_STEP_BACKWARD_FIFTY_YEARS"
					description = "TIMELINE_STEP_BACKWARD_FIFTY_YEARS_DESC"
					on_action = "[TimelinePlaybackPanel.OnStepYears('(int32)-50')]"
