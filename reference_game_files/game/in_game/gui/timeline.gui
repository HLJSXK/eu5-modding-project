					visible = "[And(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)100'), Not(TimelinePlaybackPanel.IsPlaying))]"
				}

				blockoverride "segment_unlit" {
					visible = "[Not(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)100'))]"
				}
			}

			TimelineSpeedSegment = {
