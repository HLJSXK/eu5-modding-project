				blockoverride "segment_lit_paused" {
					visible = "[And(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)500'), Not(TimelinePlaybackPanel.IsPlaying))]"
				}

				blockoverride "segment_unlit" {
					visible = "[Not(TimelinePlaybackPanel.IsSpeedAtLeast('(int32)500'))]"
