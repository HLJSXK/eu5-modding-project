		blockoverride "header_content" {
			hbox = {
				margin = { 10 0 }
				spacing = 8

				# Automation state indicator (cog icon), left side
				widget = {
					size = { 22 22 }
					widget = {
						size = { 100% 100% }
						background = {
							texture = "gfx/interface/buttons/checkbox_auto_bg.dds"
							texture_density = 2
							using = color_dark_blue
							margin = { 1 1 }
							shaderfile = "gfx/FX/pdxgui_default.shader"
						}
						icon = {
							size = { 100% 100% }
							using = checkbox_auto_texture
							frame = 1
						}
						icon = {
							size = { 100% 100% }
							using = checkbox_auto_texture
							frame = 2
							visible = "[AutomatedSystemsItem.IsEnabled]"
