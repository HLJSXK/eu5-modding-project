										parentanchor = center
										ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/diplomacy.dds" texture_density = 2 }
									}
								}
							}

							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 30 }
								background = {
									using = bg_card_header_01_default
									blockoverride "header_color" { using = color_military_texture }
								}
								card_header_button_04 = {
									size = { 100% 100% }
									action_tooltip = {
										title = "AUTOMATION_FILTER_MILITARY_NAME"
										on_action = "[SearchBar.ToggleFilterByKey('automation_filter_military')]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
									widget = {
										size = { 22 22 }
										parentanchor = center
										ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/military.dds" texture_density = 2 }
									}
								}
							}

							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 30 }
								background = {
									using = bg_card_header_01_default
									blockoverride "header_color" { using = color_geopolitics_texture }
								}
								card_header_button_04 = {
									size = { 100% 100% }
									action_tooltip = {
										title = "AUTOMATION_FILTER_EXPANSION_NAME"
										on_action = "[SearchBar.ToggleFilterByKey('automation_filter_expansion')]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
									widget = {
										size = { 22 22 }
										parentanchor = center
										ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/geography_flat_icon.dds" texture_density = 2 }
									}
								}
							}

							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 30 }
								background = {
									using = bg_card_header_01_default
									blockoverride "header_color" { using = color_advances_texture }
								}
								card_header_button_04 = {
									size = { 100% 100% }
									action_tooltip = {
										title = "AUTOMATION_FILTER_ADVANCES_NAME"
										on_action = "[SearchBar.ToggleFilterByKey('automation_filter_advances')]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
									widget = {
										size = { 22 22 }
										parentanchor = center
										ConceptIcon = { texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds" texture_density = 2 }
									}
								}
							}
						}
					}
					blockoverride "scroll_list_layout" {
						vbox = {
							using = layoutpolicy_expanding
							spacing = 10

							vbox = {
								visible = "[Not(AutomationLateralView.IsSearchActive)]"
								layoutpolicy_horizontal = expanding
								margin = { 8 10 }
								spacing = 10

								datamodel = "[AutomationLateralView.GetAutomatedSystems]"
								item = {
									AutomationSystemStandardCard = {}
								}
							}

							vbox = {
								visible = "[AutomationLateralView.IsSearchActive]"
								layoutpolicy_horizontal = expanding
								margin = { 8 10 }
								spacing = 10

								datamodel = "[AutomationLateralView.GetFilteredSystems]"
								ignoreinvisible = yes
								item = {
									AutomationSystemStandardCard = {}
								}
							}

							expand = {}
						}
					}
				}
			}
		}
	}
}

