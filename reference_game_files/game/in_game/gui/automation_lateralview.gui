								}
								card_header_button_04 = {
									size = { 100% 100% }
									action_tooltip = {
										title = "AUTOMATION_FILTER_DIPLOMACY_NAME"
										on_action = "[SearchBar.ToggleFilterByKey('automation_filter_diplomacy')]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
