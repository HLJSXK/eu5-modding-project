template checkbox_auto_texture {
	texture = "gfx/interface/buttons/checkbox_auto.dds"
	texture_density = 2
	frame_grid = { 2 1 }
}

template minimum_gold_tt {
	tooltipwidget = {
		BasicFunctionalTooltip = {
			blockoverride "tooltip_content" {
				TooltipTextBlock = {
					textcontext = "MINIMUM_GOLD_TT"
				}
			}
		}
	}
}

template allow_special_currency_spend_tt {
	tooltipwidget = {
		BasicFunctionalTooltip = {
			blockoverride "tooltip_content" {
				TooltipTextBlock = {
					textcontext = "ALLOW_SPECIAL_CURRENCY_SPEND_TT"
				}
			}
		}
	}
}

types AutomationTypes
{
	type AutomatedSection = widget {
		ignore_layout = yes
		size = { 100% 100% }
		alwaystransparent = yes
		scissor = yes
		
		widget = {
			block "glow_anim_automation_visible" {}
			size = { 100% 100% }
			alwaystransparent = yes
			state = {
				name = _show
				duration = 0.5
				alpha = 1
				bezier = { 1.0 0.0 1.0 0.0 }
			}
			state = {
				name = _hide
				duration = 0.5
				alpha = 0
			}
			icon = {
				ignore_layout = yes
				size = { 100% 100% }
				alwaystransparent = yes
				texture = "gfx/interface/component_decoration/automation/automation_fourth_frame.dds"
				texture_density = 2
				
				alpha = 0.3
		
				modify_texture = {
					using = color_progress_blue_texture
					blend_mode = multiply
				}
				modify_texture = {
					texture = "gfx/interface/component_decoration/automation/automation_fifth_frame.dds"
					blend_mode = alphamultiply
					alpha = 1
				}
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_sides.dds"
					blend_mode = alphamultiply
				}
			}
	
			icon = {
				ignore_layout = yes
				size = { 100% 100% }
				alwaystransparent = yes
				texture = "gfx/interface/component_decoration/automation/automation_third_frame.dds"
				texture_density = 2
				
				alpha = 0.2
		
				modify_texture = {
					using = color_blue_texture
					blend_mode = multiply
				}
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_sides.dds"
					blend_mode = alphamultiply
				}
			}
	
			icon = {
				ignore_layout = yes
				size = { 100% 100% }
				alwaystransparent = yes
				texture = "gfx/interface/component_decoration/automation/automation_second_frame.dds"
				texture_density = 2
				
				modify_texture = {
					using = color_dark_blue_texture
				}
				modify_texture = {
					using = color_dark_blue_texture
					blend_mode = overlay
				}
				modify_texture = {
					using = overlay_paper_03
					blend_mode = overlay
					alpha = 0.5
				}
				
				modify_texture = {
					using = overlay_cloth_texture
					blend_mode = overlay
					alpha = 0.1
				}
			}
		}

		widget = {
			block "glow_anim_automation_visible" {}
			size = { 100% 100% }
			alwaystransparent = yes

			state = {
				name = _show
				duration = 0.5
				alpha = 1
				bezier = { 1.0 0.0 1.0 0.0 }
			}
			state = {
				name = _hide
				duration = 0.5
				alpha = 0
				bezier = { 1.0 0.0 1.0 0.0 }
			}

			icon = {
				ignore_layout = yes
				size = { 100% 100% }
				alwaystransparent = yes
				block "automated_tab" {
					texture = "gfx/interface/component_decoration/automation/automation_frame.dds"
					texture_density = 2
					spriteType = corneredstretched
					spriteBorder = {70 70}
				}
				
				alpha = 1
		
				modify_texture = {
					using = color_bronze_texture
				}
				modify_texture = {
					using = color_black_texture
					blend_mode = multiply
					alpha = 0
				}
				modify_texture = {
					using = overlay_window_texture
					blend_mode = overlay
					alpha = 0.2
				}
				modify_texture = {
					using = overlay_stone_texture
					blend_mode = overlay
					alpha = 0.4
				}
			}
		}

		# icon = {
		# 	visible = "[AutomatedSystemsItem.IsEnabled]"
		# 	ignore_layout = yes
		# 	size = { 100% 10 }
		# 	alwaystransparent = yes
		# 	parentanchor = hcenter|top
		# 	scissor = yes
		# 	texture = "gfx/interface/component_decoration/automation/automation_frame.dds"
		# 	modify_texture = {
		# 		using = color_red_texture
		# 	}
		# }
	}

	type AutomationCheckbox = button {
		size = { 22 22 }
		using = checkbox_auto_texture
		using = snd_UI_checkbutton_automation

		gfxtype = togglepushbuttongfx

		upframe = 1
		uphoverframe = 1
		uppressedframe = 1
		downframe = 2
		downhoverframe = 2
		downpressedframe = 2
		disableframe = 2

		background = {
			texture = "gfx/interface/buttons/checkbox_auto_bg.dds"
			texture_density = 2
			using = color_dark_blue
			margin = { 1 1 }
			shaderfile = "gfx/FX/pdxgui_default.shader"
		}
	}

	type ConceptIcon = icon {
		size = { 100% 100% }
		glow = {
			name = "drop_shadow"
			glow_radius = 3
			color = { 0.0 0.0 0.0 1.0 }
			alpha = 0.3
		}
	}

	type AutomationCard = vbox {
		layoutpolicy_horizontal = expanding
		using = bg_paper_card

		vbox = {
			layoutpolicy_horizontal = expanding

			widget = {
				layoutpolicy_horizontal = expanding
				block "header_size" { size = { -1 35 } }

				using = bg_card_header_01

				block "bg_card_header_01_bg" {}

				card_header_button_01 = {
					size = { 100% 100% }

					block "header_button" {}
				}

				block "header_content" {}
			}

			block "footer_content" {}
		}
	}

	type AutomatedTabBase = hbox {
		margin = { 10 0 }
		margin_top = 4
		
		text_single = {
			using = Font_Type_Headers
			using = layoutpolicy_expanding
			align = center|nobaseline
			autoresize = no
			block "text" { visible = no }
		}
		
		widget = {
			block "checkbox_visible" {} # Necessary because animation states in the actual child widget do funky stuff.
			widget = {
				ignore_layout = yes
				parentanchor = right|vcenter
				position = { -5 2 }
				
				block "checkbox_visible" {}
				size = { 22 22 }
		
				state = {
					name = _show
					duration = 0.2
					alpha = 1
					bezier = { 1.0 0.0 1.0 0.0 }
					size = { 22 22 }
				}
		
				state = {
					name = _hide
					duration = 0.2
					alpha = 0.1
					bezier = { 0.0 1.0 0.0 0.0 }
					size = { 22 22 }
				}
		
				icon = {
					size = { 100% 100% }
					using = checkbox_auto_texture
					frame = 1
				}
		
				widget = {
					block "checkbox_enabled" {}
					size = { 100% 100% }
					
					icon = {
						block "checkbox_enabled" {}
						size = { 100% 100% }
						using = checkbox_auto_texture
						frame = 2
						
						state = {
							name = _show
							duration = 0.3
							alpha = 1
							bezier = { 1.0 0.0 1.0 0.0 }
						}
				
						state = {
							name = _hide
							duration = 0.2
							alpha = 0.1
							bezier = { 0.0 1.0 0.0 0.0 }
						}
					}
				}
			}
		}
	}
	type AutomationSystemStandardCard = AutomationCard {
		blockoverride "header_size" {
			size = { -1 35 }
		}

		blockoverride "card_color" {
			modify_texture = {
				using = color_paper_texture
			}
		}

		blockoverride "bg_card_header_01_bg" {
			# Government
			background = {
				visible = "[AutomatedSystemsItem.IsName('laws')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('bureaucracy')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('governmentreforms')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('cabinetmembers')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('cabinet')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('parliament')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('estates')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			# Economy
			background = {
				visible = "[AutomatedSystemsItem.IsName('finances')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_economy_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('credit')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_economy_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('trade')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_economy_texture }
			}
			# Production
			background = {
				visible = "[AutomatedSystemsItem.IsName('buildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('closebuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('subsidizebuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('expandbuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('destroybuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('destroyestatebuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('productionmethods')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('rgo')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('expandrgo')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			# Society
			background = {
				visible = "[AutomatedSystemsItem.IsName('cultureacceptance')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_society_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('religiousdoctrines')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_society_texture }
			}
			# Diplomacy
			background = {
				visible = "[AutomatedSystemsItem.IsName('diplomacy')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_diplomacy_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('rivals')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_diplomacy_texture }
			}
			# Military
			background = {
				visible = "[AutomatedSystemsItem.IsName('armybuilder')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('navybuilder')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('replacegenerals')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('replaceadmirals')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('privateers')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			# Expansion
			background = {
				visible = "[AutomatedSystemsItem.IsName('exploration')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_geopolitics_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('colonies')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_geopolitics_texture }
			}
			# Advances
			background = {
				visible = "[AutomatedSystemsItem.IsName('research')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_advances_texture }
			}
		}

		blockoverride "header_button" {
			action_tooltip = {
				click_type = left
				title = "[AutomatedSystemsItem.GetActionTooltipName]"
				visible = "[Not(AutomatedSystemsItem.IsEnabled)]"
				using = snd_UI_checkbutton_automation
				on_action = "[AutomatedSystemsItem.Toggle]"
				on_action = "[PlayAudioEffect('UI_action_automate_enable')]"
			}

			action_tooltip = {
				click_type = left
				title = "[AutomatedSystemsItem.GetActionTooltipName]"
				visible = "[AutomatedSystemsItem.IsEnabled]"
				using = snd_UI_checkbutton_automation
				on_action = "[AutomatedSystemsItem.Toggle]"
				on_action = "[PlayAudioEffect('UI_action_automate_disable')]"
			}

			# Right-click opens the relevant panel
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('finances')]"
				on_action = "[OpenLateralView('economy')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('credit')]"
				on_action = "[OpenLateralView('credit')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('research')]"
				on_action = "[OpenLateralView('advances')]"
			}
			action_tooltip = {
				click_type = left
				enabled = "[Not(AutomatedSystemsItem.IsEnabled)]"
				title = "AUTOMATE_ALL_MARKETS"
				conditions = "AUTOMATE_ALL_MARKETS_DISABLED"
				on_action = "[AutomatedSystemsItem.Toggle]"
				visible = "[AutomatedSystemsItem.IsName('trade')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('trade')]"
				on_action = "[OpenLateralViewWithParams('trade', 'subtab = markets')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('productionmethods')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('laws')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = politics')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[And(AutomatedSystemsItem.IsName('bureaucracy'), PlayerHasBureaucracies)]"
				on_action = "[OpenLateralView('bureaucracies')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('cabinetmembers')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = cabinet')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('cabinet')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = cabinet')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('governmentreforms')]"
				on_action = "[OpenLateralView('government_reforms')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('parliament')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = parliament')]"
			}
			action_tooltip = {
				click_type = right
