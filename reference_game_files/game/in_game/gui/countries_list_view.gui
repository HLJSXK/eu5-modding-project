lateralview_full = {	
	name = "countries_list_view"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "LEDGER_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
		}
	}

	blockoverride "panel_content" {
		vbox = { 
			header_main_tabs = { #
				blockoverride "content" {
					using = ledger_tabs_template
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt
				
				filtered_sorted_list = {
					margin_top = 10
					datacontext = "[CountriesListView.GetCountriesSortSearch]"
					
					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "gp"
							layoutpolicy_vertical = expanding
							size = { 60 -1 }
							# using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "name"
							size = { 270 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "government_type"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "type"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
						}
						sort_by_key_button = {
							name = "country_rank"
							size = { 60 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							name = "pop"
							# size = { 120 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "wealth"
							# size = { 120 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "tax_base"
							# size = { 120 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}
						
						sort_by_key_button = {
							name = "income"
							# size = { 140 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "gdp"
							# size = { 140 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "locations"
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "diplo_rep"
							# size = { 100 -1 }
							# layoutpolicy_vertical = expanding
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "religion"
							layoutpolicy_vertical = expanding
							size = { 50 -1 }
							# using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "culture"
							# layoutpolicy_vertical = expanding
							# size = { 140 -1 }
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "art"
							# layoutpolicy_vertical = expanding
							# size = { 120 -1 }
							using = layoutpolicy_expanding
						}
						sort_by_key_button = {
							name = "prestige"
							layoutpolicy_vertical = expanding
							size = { 170 -1 }
							# using = layoutpolicy_expanding
						}
					
						# sort_by_key_button = {
						# 	name = "gp"
						# 	layoutpolicy_vertical = expanding
						# 	size = { 100 -1 }
						# 	# using = layoutpolicy_expanding
						# }
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 50
						setitemsizefromcell = yes

						datamodel = "[CountriesListView.GetCountriesListView]"
						item = {
							using = ledger_item_template
							blockoverride "ledger_item_content"{
								widget = {
									using = layoutpolicy_expanding
									hbox = {
										margin = { 10 0 }
										spacing = 10

										datacontext = "[CountriesListViewItem.GetCountry]"

										widget = {
											size = { 40 32 }
											hbox = {
												country_rank_banner = {}
											}
											sort_by_highlight = {
												name = "gp"
											}
										}

										hbox = {
											size = { 230 -1 }
											spacing = 10

											country_flag_small = {
												datacontext = "[CountriesListViewItem.GetCountry]"
											}
		
											text_single = {
												size = { 200 -1 }
												autoresize = no
												align = left|nobaseline
	
												text = "[CountriesListViewItem.GetCountry.GetLongNameWithNoTooltip]"
												default_format = "#yellow_titles"
											}
											datacontext = "[CountriesListViewItem.GetCountry]"
											tooltipwidget = {
												using = CountryTooltip
											}
											sort_by_highlight = {
												name = "name"
											}
										}

										widget = { #GovernmentType
											size = { 50 -1 }
											layoutpolicy_vertical = expanding
											icon = { 
												parentanchor = center
												texture = "[GetGovernmentTypeIcon(Country.GetGovernment.GetGovernmentType)]"
												size = { 28 28 }

												datacontext = "[Country.GetGovernment.GetGovernmentType]"
												tooltipwidget = {
													using = GovernmentType_tooltip
												}
											}
											sort_by_highlight = {
												name = "government_type"
											}
										}

										widget = { #Country Type
											size = { 50 -1 }
											layoutpolicy_vertical = expanding
											icon = { 
												parentanchor = center
												texture = "[GetCountryTypeIcon(Country.Self)]"
												size = { 28 28 }

												tooltipwidget = {
													using = CountryType_tooltip
												}
											}
											sort_by_highlight = {
												name = "type"
											}
										}

										widget = { #Country Rank
											size = { 50 -1 }
											layoutpolicy_vertical = expanding
											icon = { 
												parentanchor = center
												texture = "[GetCountryRankIcon(Country.GetRank)]"
												size = { 28 28 }

												datacontext = "[Country.GetRank]"
												tooltipwidget = {
													using = CountryRank_tooltip
												}
											}
											sort_by_highlight = {
												name = "country_rank"
											}
										}

										hbox = { #population
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetTotalPopulation]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('population')]"
											}
											tooltip = "[Country.GetTotalPopulation]"
											tagtooltip_enabled = yes
											sort_by_highlight = {
												name = "pop"
											}
										}

										hbox = { #wealth
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetTotalWealth|2L]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('wealth')]"
											}
											tooltipwidget = {
												using = TotalWealthTooltip
											}
											sort_by_highlight = {
												name = "wealth"
											}
										}

										hbox = { #tax_base
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetTotalTaxBase]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('tax_base')]"
											}
											tooltipwidget = {
												using = TaxBaseTooltip
											}
											sort_by_highlight = {
												name = "tax_base"
											}
										}

										hbox = { #income
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetEstimatedMonthlyIncome|+=2]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('income')]"
											}
											tooltip = "[income]"
											tagtooltip_enabled = yes
											sort_by_highlight = {
												name = "income"
											}
										}

										hbox = { #GDP per capita
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
												raw_text = "#G [Country.GetGDP|4]#!@gold!"
											}
											tooltip = "[gdp_per_capita]"
											tagtooltip_enabled = yes
											sort_by_highlight = {
												name = "gdp"
											}
										}

										hbox = { #Locations
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetOwnedLocationCount|L]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('location')]"
											}
											tooltipwidget = {
												using = towns_or_cities_tooltip
											}
											sort_by_highlight = {
												name = "locations"
											}
										}

										hbox = { #Diplo Rep
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetModifierValueNoFormat('diplomatic_reputation')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('diplomatic_reputation')]"
											}
											tooltipwidget = {
												using = diplomatic_reputation_tooltip
											}
											sort_by_highlight = {
												name = "diplo_rep"
											}
										}

										widget = { #religion
											size = { 50 -1 }
											layoutpolicy_vertical = expanding
											icon = { 
												parentanchor = center
												texture = "[GetReligionIcon(Country.GetReligion)]"
												size = { 28 28 }
												datacontext = "[Country.GetReligion]"
												tooltipwidget = { using = religion_tooltip	}
											}
											sort_by_highlight = {
												name = "religion"
											}
										}

										text_single = { #culture
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = center|nobaseline

											text = "[Country.GetCulture.GetNameWithNoTooltip|L]"
											
											datacontext = "[Country.GetCulture]"
											tooltipwidget = {
												using = culture_tooltip
											}
											sort_by_highlight = {
												name = "culture"
											}
										}

										hbox = { #art
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetNumWorksOfArt|L]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('work_of_art')]"
											}
											tooltipwidget ={
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "ART_TAB"
													}
													blockoverride "title_icon" {
														icon = {
															texture = "[GetConceptTexture('work_of_art')]"
															using = tooltip_title_icon_size
														}
													}
													blockoverride "concept_link" {
														text = "[work_of_art|e]"
													}
													
													blockoverride "tooltip_content" {
														TooltipStringPairList = { 
															textcontext = "[CountriesListViewItem.GetCountry.GetArtTooltip]"
														}
													}
												}
											}
											sort_by_highlight = {
												name = "art"
											}
										}

										hbox = { #prestige
											layoutpolicy_horizontal = expanding
											spacing = 2
											margin_right = 5
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												align = right|nobaseline
	
												text = "[Country.GetCurrencyValue('prestige')]"
											}
											icon = {
												size = { 16 16 }
												texture = "[GetConceptTexture('prestige')]"
											}
											tooltipwidget = {
												using = PrestigeResourceTooltip
												blockoverride "content_datacontext" {
													datacontext = "[Country.GetEconomy]"
												}
											}
											sort_by_highlight = {
												name = "prestige"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
