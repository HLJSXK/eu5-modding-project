	type create_colonial_charter_tooltip = ContextualTooltipType {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/geopolitics/current_explorers.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "CREATE_COLONIAL_CHARTER_TT_LOC"
		}

		blockoverride "concept_link" {
			text = "[colonial_charter|e]"
		}

		blockoverride "tooltip_content"	{
			TooltipStringPairList = {
				textcontext = "[ProvinceDefinition.GetUITooltip]"
			}

			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 120 }}
				textcontext = "[ProvinceDefinition.GetMembersInfo]"
			}

			TooltipStringPairList = {
				tooltipmeta = {
					texture = "gfx/interface/icons/modifier_types/colonial_maintenance_cost.dds"
					game_concept = "[cost|e]"
					title = "COLONIAL_MAINT_FROM_GOODS_TITLE"
				}
				textcontext = "[GetMonthlyMaintenanceInfoForCountry(Player.Self, ProvinceDefinition.Self, Player.GetCapital)]"
			}

			TooltipConditionList = {
				blockoverride "block_title" {
					text = "game_concept_conditions"
				}
				visible = "[ConditionList.HasItems]"
				datacontext = "[StringToConditionListOnlyPassedAndNeutralIfNot(UIAction.IsLeftClickAndConfirmVisible, UIAction.GetConditions)]"
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "create_colonial_charter_desc_t"
				}
			}
		}
	}

	type possible_colony_item = colonies_card_list_button {
		using = layoutpolicy_expanding

		name = "create colonial charter button"
		datacontext = "[ColonialCharterItem.GetProvinceDefinition]"
		action_tooltip = {
			click_type = left
			click_mode = single
			title = "[ColonialCharterItem.GetCreateColonialCharterTitle]"
			visible = "[ColonialCharterItem.IsCreateColonialCharterVisible]"
			enabled = "[ColonialCharterItem.CanCreateColonialCharter]"
			conditions = "[ColonialCharterItem.GetCreateColonialCharterConditions]"
			cost = "[ColonialCharterItem.GetCreateColonialCharterCost]"
			on_action = "[ColonialCharterItem.CreateColonialCharter]"
		}
		action_tooltip = {
			click_type = right
			click_mode = single
			title = "CLICK_ACTION_SELECT_PROVINCE_DEF_RIGHT"
			visible = "[ColonialCharterItem.IsCreateColonialCharterVisible]"
			on_action = "[PanToLocation(ProvinceDefinition.GetFirstPassableLocation)]"
		}
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

		tooltipwidget = {
			create_colonial_charter_tooltip = {}
		}

		hbox = {
			spacing = 10
			datacontext = "[ColonialCharterItem.GetProvinceDefinition]"

			widget = {
				ignore_layout = yes
				parentanchor = vcenter
				size = { 45 45 }
				position = { 10 0 }

				using = bg_circle_piechart_colonies

				icon = {
					parentanchor = center
					size = { 32 32 }
					texture = "gfx/interface/icons/flat_icons/geopolitics/current_explorers.dds"
				}
			}

			vbox = {
				margin = { 10 0 }
				margin_left = 65
				spacing = 5

				layoutpolicy_horizontal = expanding
				text_multi = {
					layoutpolicy_horizontal = expanding
					datacontext = "[ColonialCharterItem.GetProvinceDefinition]"
					default_format = "#yellow_titles"
					using = Font_Size_Medium
					block "charter_name" {
						text = "CREATE_COLONIAL_CHARTER"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/flat_icons/geopolitics/colonial_range.dds"
					}

					text_single = {
						text = "[ColonialCharterItem.GetRangeInfo]"
					}

					expand = {}
				}
			}

			vbox = {
				margin_right = 10
				spacing = 5

				hbox = {
					layoutpolicy_horizontal = expanding
					expand = {}
					text_single = {
						using = Font_Size_Medium
						align = right|nobaseline
						text = "[ColonialCharterItem.GetCreateColonialCharterCost]"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					expand = {}
					text_single = {
						align = right|nobaseline
						raw_text = "[ColonialCharterItem.GetMaintenanceCost|2]@expense!"
					}
				}
			}
		}
		
		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvinceDefinition(ColonialCharterItem.GetProvinceDefinition)]"
	}

	type colonial_charter_item = widget {
		alwaystransparent = no
		using = layoutpolicy_expanding

		background = {
			texture = "gfx/interface/colonies/colonial_wooden_background.dds"
			texture_density = 2
			spriteType = corneredstretched
			spriteborder = { 100 100 }
		}
		
		vbox = {
			using = bg_cabinet_card_frame
			colonies_card_list_button = {
				size = { -1 40 }
				default_format = "#color_white"
				layoutpolicy_horizontal = expanding
				name = "abandon charter button"	

				button_tooltip_override = {
					title = "ABANDON_BUTTON"
				}

				scripted_action_tooltip = {
					click_type = right
					click_mode = confirm
					action_name = "abandon_colonial_charter"
					actor = "[Player]"
					parameter = {
						parameter_name = "target"
						parameter_value = "[ColonialCharterItem.GetColonialCharter]"
					}
				}

				block "colonial_charter_item_left_click" {
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "GO_TO_COLONY"
						on_action = "[ShowProvinceDefinition(ColonialCharterItem.GetProvinceDefinition)]"
					}
				}

				datacontext = "[ColonialCharterItem.GetColonialCharter]"
				tooltipwidget = {
					using = ColonialCharter_tooltip
				}

				hbox = {
					datacontext = "[ColonialCharterItem.GetColonialCharter]"

					hbox = {
						using = layoutpolicy_expanding
						margin = { 10 0 }
						spacing = 5

						block "highlight_name" {
							sort_by_highlight = {
								name = "name"
							}
						}

						country_flag_small = {
							datacontext = "[ColonialCharterItem.GetColonialCharter.GetOwner]"
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							text = "[ColonialCharterItem.GetColonialCharter.GetNameWithNoTooltip]"
							default_format = "#yellow_titles"
						}
					}

					text_single = {
						layoutpolicy_vertical = expanding
						margin = { 10 0 }
						autoresize = yes
						raw_text = "[ColonialCharterItem.GetColonialCharter.GetMonthlyMaintenance|2]@expense!"

						tooltipwidget = {
							using = colonial_charter_maintenance_tooltip
						}

						block "highlight_cost" {
							sort_by_highlight = {
								name = "cost"
							}
						}
					}

					hbox = {
						layoutpolicy_vertical = expanding
						margin = { 10 0 }
						spacing = 10

						tooltipwidget = {
							using = colonial_charter_progress_tooltip
						}

						block "highlight_progress" {
							sort_by_small_highlight = {
								name = "charter_progress"
							}
						}

						text_single = {
							size = { 50 20 }
							autoresize = no
							align = right|nobaseline
							raw_text = "[ColonialCharterItem.GetProgress|2]%"
						}

						piechart = {
							size = { 26 26 }
							using = piechart_angles

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
								value = "[ColonialCharterItem.GetProgress]"
								color = { 1 1 1 1 }
							}

							pieslice = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
								value = "[Subtract_float('(float)100.0', ColonialCharterItem.GetProgress)]"
								color = { 1 1 1 1 }
							}

							icon = {
								size = { 60% 60% }
								parentanchor = center
								texture = "gfx/interface/icons/flat_icons/geopolitics/available_colonies.dds"
							}
							using = bg_circle_piechart
						}
					}
				}
			}

			hbox = {
				using = layoutpolicy_expanding
				margin = { 6 0 }
				margin_right = 5

				widget = {
					visible = "[ColonialCharterItem.IsPlayer]"
					layoutpolicy_horizontal = expanding
					size = { -1 25 }
					hbox = {
						margin_left = 10
						button_regular = {
							size = { 195 25 }
							hbox = {
								margin = { 18 0 }
								spacing = 4

								widget = {
									visible = "[ColonialCharterItem.GetColonialCharter.IsGoalSet]"
									size = { 16 16 }
									icon = {
										position = { 0 -1 }
										size = { 16 16 }
										texture = "[ColonialCharterItem.GetColonialCharter.GetGoalIcon]"
									}
								}


								text_single = {
									using = layoutpolicy_expanding
									autoresize = yes
									maximumsize = { 140 -1 }
									align = left|nobaseline
									fontsize = 11
									text = "[ColonialCharterItem.GetColonialCharter.GetGoalDisplayName]"
									default_format = "#color_white"
								}
							}
							
							scripted_action_tooltip = {
								click_type = left
								click_mode = single
								action_name = "set_colonial_charter_goal"
								actor = "[Player]"
								parameter = {
									parameter_name = "target"
									parameter_value = "[ColonialCharterItem.GetColonialCharter]"
								}
							}

							tooltipwidget = { BasicFunctionalTooltip = {} }
						}
						expand = {}
					}
					button_checkbox_auto = {
						size = { 25 25 }
						enabled = "[ColonialCharterItem.IsPlayer]"
						down = "[Not(ColonialCharterItem.GetColonialCharter.IsGoalManuallySet)]"
						action_tooltip = {
							title = "colonial_charter_goal_lock_tt_toggle"
							on_action = "[ColonialCharterItem.GetColonialCharter.ToggleGoalLock]"
						}
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" {
											text = "[SelectLocalization( ColonialCharterItem.GetColonialCharter.IsGoalManuallySet, 'colonial_charter_goal_locked', 'colonial_charter_goal_unlocked' )]"
										}
									}
								}

								blockoverride "title_icon" {
									icon = {
										visible = "[Not(ColonialCharterItem.GetColonialCharter.IsGoalManuallySet)]"
										using = tooltip_title_icon_size
										texture = "gfx/interface/buttons/checkbox_auto.dds"
										frame_grid = { 2 1 }
										frame = 2
									}
									icon = {
										visible = "[ColonialCharterItem.GetColonialCharter.IsGoalManuallySet]"
										using = tooltip_title_icon_size
										texture = "gfx/interface/buttons/checkbox_auto.dds"
										frame_grid = { 2 1 }
										frame = 1
									}
								}

								blockoverride "title_text" {
									text = "colonial_charter_goal_lock_tt_title"
								}
							}
						}
					}
				}

				expand = {}

				divider_flavor_01 = { 
					datacontext = "[ColonialCharterItem.GetColonialCharter]"
					size = { 9 -1 } 
					visible = "[And(ColonialCharterItem.IsPlayer, Not(StringIsEmpty(ColonialCharter.GetBottleneckLabel)))]"
				}

				hbox = {
					layoutpolicy_vertical = expanding

					datacontext = "[ColonialCharterItem.GetColonialCharter]"
					visible = "[And(ColonialCharterItem.IsPlayer, Not(StringIsEmpty(ColonialCharter.GetBottleneckLabel)))]"
					margin = { 4 0 }

					button_regular = {
						enabled = "[ColonialCharterItem.IsPlayer]"
						hbox = {
							set_parent_size_to_minimum = yes
							minimumsize = { -1 25 }
							margin = { 10 0 }
							spacing = 4

							text_single = {
								using = layoutpolicy_expanding
								autoresize = yes
								maximumsize = { 240 -1 }
								align = left|nobaseline
								fontsize = 12
								text = "[ColonialCharter.GetBottleneckLabel]"
								default_format = "#color_white"
							}
						}

						action_tooltip = {
							click_type = left
							click_mode = single
							title = "COLONY_HELPFUL_ACTIONS_TITLE"
							description = "COLONY_HELPFUL_ACTIONS_CHARTER_DESC"
							on_action = "[OpenHelpfulCabinetActions('charter')]"
						}

						tooltipwidget = {
							SimpleContextualTooltipType = {
								lowpriotextcontext = "[ColonialCharter.GetBottleneckTooltip]"
							}
						}
					}
				}

				divider_flavor_01 = { size = { 9 -1 }}

				hbox = {
					margin = { 4 0 }
					layoutpolicy_vertical = expanding
					datacontext = "[ColonialCharterItem.GetColonialCharter]"
					
					spacing = 5
					
					tooltipwidget = {
						using = colonial_charter_migration_tooltip
					}

					text_single = {
						autoresize = no
						size = { 60 20 }
						using = Font_Size_Very_Small
						align = center|nobaseline
						text = "[ColonialCharter.GetForecastETALineShort]"

						tooltipwidget = {
							SimpleContextualTooltipType = {
								lowpriotextcontext = "[ColonialCharter.GetForecastETALine]"
							}
						}
					}
				}

				divider_flavor_01 = { size = { 9 -1 } }

				hbox = {
					margin = { 4 0 }
					layoutpolicy_vertical = expanding
					spacing = 4

					datacontext = "[ColonialCharterItem.GetColonialCharter]"
					tooltipwidget = {
						using = colonial_charter_migration_tooltip
					}

					text_single = {
						autoresize = no
						size = { 40 20 }
						text = "[ColonialCharterItem.GetColonialCharter.GetMonthlyMigration]"
						align = right|nobaseline

						block "highlight_migration" {
							sort_by_highlight = {
								name = "monthly_migration"
							}
						}
					}

					icon = {
						texture_density = 2
						size = { 20 20 }
						
						block "icon_texture" {
							texture = "gfx/interface/icons/resources/total_population.dds"
						}
					}
				}
			}
		}

		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvinceDefinition(ColonialCharterItem.GetProvinceDefinition)]"
		tooltip_enabled = no
	}

