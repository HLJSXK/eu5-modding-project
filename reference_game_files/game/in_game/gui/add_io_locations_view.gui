lateralview = {
	name = "add_io_locations_view"

	blockoverride "panel_header" {
		window_header_alt = {
			using = bg_main_inner_alt
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}

			blockoverride "header_text" {
				text = "ADD_IO_LOCATIONS_TITLE"
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt

			vbox = {
				using = layoutpolicy_expanding
				margin = { 10 0 }
				margin_bottom = 10
				spacing = 10

				filtered_sorted_list = {
					datacontext = "[AddIoLocationsView.GetLocationsSortSearch]"

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(AddIoLocationsView.GetPossibleLocations)]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "LOCATIONS_SCROLL_LIST_EMPTY"
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							name = "population"
							layoutpolicy_vertical = expanding
							size = { 105 -1 }
						}
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 37

						datamodel = "[AddIoLocationsView.GetPossibleLocations]"
						item = {
							card_list_button = {
								minimumsize = {510 37}
								maximumsize = {510 37}
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TOGGLE_SELECTION"
									on_action = "[AddIoLocationsView.ToggleLocation(Location.Self)]"
								}

								using = layoutpolicy_expanding
								using = bg_card_header_01

								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_text" {
											text = "TOGGLE_SELECTION"
										}
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/map_subdivisons/location.dds"
											}
										}
										blockoverride "concept_link" {
											text = "[location|E]"
										}
										blockoverride "tooltip_content" {}
									}
								}

								hbox = {
									margin = {10 0}
									spacing = 5

									button_checkbox_alt = {
										size = { 20 20 }
										down = "[AddIoLocationsView.IsSelected(Location.Self)]"
										action_tooltip = {
											title = "TOGGLE_SELECTION"
											on_action = "[AddIoLocationsView.ToggleLocation(Location.Self)]"
										}
										tooltipwidget = { BasicFunctionalTooltip = {} }
										allow_outside = yes
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 25

										hbox = {
											minimumsize = { 200 32 }
											margin = { 5 0 }
											spacing = 10

											icon = {
												size = { 18 18 }
												texture = "[Location.GetRankIcon]"
												datacontext = "[Location.GetRank]"
												tooltipwidget = { using = LocationRankTag_tooltip }
											}

											text_single = {
												size = { 180 20 }
												autoresize = no
												text = "[Location.GetNameWithNoTooltip]"
												default_format = "#yellow_titles"

												sort_by_highlight = {
													size = { 100% 100% }
													name = "name"
												}
											}
										}

										hbox = {
											size = { 100 32 }
											margin = { 5 0 }
											spacing = 10

											tooltipwidget = {
												using = population_location_tooltip
											}

											icon = {
												size = { 20 20 }
												layoutpolicy_vertical = fixed
												layoutpolicy_horizontal = fixed
												texture = "gfx/interface/icons/map_modes/population.dds"
												glow = {
													name = "drop_shadow"
													glow_radius = 3
													color = {0.0 0.0 0.0 1.0}
													alpha = 0.3
												}
											}

											text_single = {
												size = { 42 20 }
												autoresize = no
												text = "[Location.GetTotalPopulation]"
											}
										}
									}
								}
							}
						}
					}
				}

				hbox = {
					using = bg_number_container_bckg
					margin = { 5 10 }
					layoutpolicy_horizontal = expanding
					spacing = 10

					button_regular = {
						visible = "[AddIoLocationsView.CanSelectAll]"
						layoutpolicy_horizontal = expanding
						size = { -1 30 }

						text_single = {
							parentanchor = center
							text = "ADD_IO_LOCATIONS_SELECT_ALL"
						}

						tooltipwidget = { BasicFunctionalTooltip = {} }
						action_tooltip = {
							click_type = left
							click_mode = single
							title = "ADD_IO_LOCATIONS_SELECT_ALL"
							enabled = "[AddIoLocationsView.CanSelectAll]"
							on_action = "[AddIoLocationsView.SelectAll]"
						}
					}

					button_regular = {
						visible = "[Not(AddIoLocationsView.CanSelectAll)]"
						layoutpolicy_horizontal = expanding
						size = { -1 30 }

						text_single = {
							parentanchor = center
							text = "ADD_IO_LOCATIONS_CLEAR"
						}

						tooltipwidget = { BasicFunctionalTooltip = {} }
						action_tooltip = {
							click_type = left
							click_mode = single
							title = "ADD_IO_LOCATIONS_CLEAR"
							enabled = "[AddIoLocationsView.CanClearSelection]"
							on_action = "[AddIoLocationsView.ClearSelection]"
						}
					}

					button_regular = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }

						text_single = {
							parentanchor = center
							raw_text = "[Localize('ADD_IO_LOCATIONS_CONFIRM')] ([AddIoLocationsView.GetSelectedCount])"
						}

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "ADD_IO_LOCATIONS_CONFIRM"
								}
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/international_organizations/land_ownership_rule.dds"
									}
								}
								blockoverride "concept_link" {
									text = "[international_organization|E]"
								}
								blockoverride "tooltip_content" {
									TooltipTextBlock = {
										blockoverride "text" { text = "[AddIoLocationsView.GetConfirmMessage]" }
									}
								}
							}
						}
						action_tooltip = {
							click_type = left
							click_mode = confirm
							title = "ADD_IO_LOCATIONS_CONFIRM"
							description = "[AddIoLocationsView.GetConfirmMessage]"
							enabled = "[AddIoLocationsView.CanSend]"
							on_action = "[AddIoLocationsView.OnSend]"
						}
					}
				}
			}
		}
	}
}
