# All new songs added on wwise, should be added by their event key, and optionally add a composer, performer, soloist and language.

# Also, remember to add the localization on music_player_l_english.yml.

# Example:
#  MusicPlayer_01_Overture_I_Genesis = {
#  	 composer = Mattias_Henndlund
#	 performer = Mattias_Henndlund
#	 soloist = Mattias_Henndlund
#	 language = { MusicPlayer_language_Old_Castilian }
#	 # or multiple, comma-joined in the tooltip:
#	 # language = { MusicPlayer_language_German MusicPlayer_language_English }
#  }

# with loc:
#  MusicPlayer_01_Overture_I_Genesis: "Overture I Genesis"
#  MusicPlayer_01_Overture_I_Genesis_flavour: "This song is..."
#  Mattias_Henndlund: "Mattias Henndlund"
#  MusicPlayer_language_Old_Castilian: "Old Castilian"
