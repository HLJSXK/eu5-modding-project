widget = {
	name = "mainmenu_load"
	size = { 100% 100% }
	visible_at_creation = no
	
	FrontEndBackground = {}
	FrontEndPreloadingWidget = 
	{ 
		visible = "[IsGamePreloading]"
	}

	FrontEndMenu = {
		blockoverride "frontend_menu_middle_section_layout" {
			name = "load_window_container"
		}

		blockoverride "frontend_menu_bottom_layout" {
			widget = {
				size = { 300 165 }
				vbox = {
					margin_bottom = 40
					button_regular = {
						using = FrontEndBottomSectionButton

						name = "back_button"
						text = "BACK"
						enabled = "[Not(IsShowingDialog)]"

						input_action = "close_window"
						action_tooltip = {
							title = "BACK_TOOLTIP_LEFT"
							on_action = "[FrontEndLoadView.OnBack]"
						}
						tooltipwidget = { BasicFunctionalTooltip = {} }
					}
				}
			}
		}
	}
}

widget = {
	name = "mainmenu_load_window"
	size = { 100% 100% }
	enabled = "[SaveListWindow.IsWindowEnabled]"

	# inside content SP
	scroll_list = {
		visible = "[And(Not(FrontEndLoadView.IsMultiplayer), Not(SaveListWindow.IsPendingToReadSaveFiles))]"
		size = { 100% 100% }

		blockoverride "scroll_list_layout" {
			loadgame_grid = {
				using = layoutpolicy_expanding
				margin_top = 40
				blockoverride "slot_button_SP_left_action_playtroughitem" {
					on_action = "[FrontEndLoadView.SetInitSettings('(bool)no', '(bool)no')]"
				}

				blockoverride "slot_button_SP_right_action_playtroughitem" {
					on_action = "[FrontEndLoadView.SetInitSettings('(bool)yes', '(bool)no')]"
				}

				blockoverride "save_game_item_visible" {
					visible = "[Not(And(FrontEndLoadView.IsHidingOutdated, PlaythroughItem.IsIncompatible))]"
				}

				blockoverride "slot_button_MP_left_action_playtroughitem" {
					on_action = "[FrontEndLoadView.SetInitSettings('(bool)yes', '(bool)yes')]"
				}

				blockoverride "slot_button_MP_right_action_playtroughitem" {
					on_action = "[FrontEndLoadView.SetInitSettings('(bool)yes', '(bool)no')]"
				}
			}
		}
		blockoverride "save_game_datamodel" {
			datamodel = "[SaveListWindow.GetPlaythroughs]"
		}
	}
	
	# inside content MP
	scroll_list = {
		visible = "[And(FrontEndLoadView.IsMultiplayer, Not(SaveListWindow.IsPendingToReadSaveFiles))]"
		size = { 100% 100% }

		blockoverride "scroll_list_layout" {
			loadgame_grid = {
				using = layoutpolicy_expanding
				margin_top = 40
				blockoverride "load_slot_buttons" {
					using = mp_load_slot_buttons
				}

				blockoverride "save_game_item_visible" {
					visible = "[Not(And(FrontEndLoadView.IsHidingOutdated, PlaythroughItem.IsIncompatible))]"
				}
			}
		}
		blockoverride "save_game_datamodel" {
			datamodel = "[SaveListWindow.GetPlaythroughs]"
		}
	}

	widget = {
		ignore_layout = yes
		position = { 5 5 }
		size = { 30 30 }

		button = {
			gfxtype = togglecheckbuttongfx
			texture = "gfx/interface/buttons/checkbox_visibility.dds"
			texture_density = 2
			frame_grid = { 2 1 }
			upframe = 1
			downframe = 2
			size = { 30 30 }
			down = "[Not(FrontEndLoadView.IsHidingOutdated)]"
			onclick = "[FrontEndLoadView.ToggleHideOutdated]"
			tooltipwidget = {
				SimpleContextualTooltipType = {
					lowpriotextcontext = "[SelectLocalization(FrontEndLoadView.IsHidingOutdated, 'HIDE_OUTDATED_SAVES_IS_ON', 'HIDE_OUTDATED_SAVES_IS_OFF')]"
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "gfx/interface/icons/flat_icons/wrong_version_flat.dds"
						}
					}
				}
			}
		}
	}

	save_load_menu_loading_indicator = {
		parentanchor = center
	}

	state = {
		name = _show
		start_sound = { soundeffect = "UI_button_gameLoad" }
	}
}
