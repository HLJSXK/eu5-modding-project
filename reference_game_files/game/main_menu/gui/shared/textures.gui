	spriteborder = { 0 80 }
}

### COMPOSITES ###

template overlay_gold {
	modify_texture = {
		using = overlay_gold_texture
		blend_mode = overlay
		alpha = 0.7
	}
}

template overlay_leather {
	modify_texture = {
		using = overlay_leather_texture
		blend_mode = overlay
	}
}

template ui_direction_button_detail {
	modify_texture = {
		using = overlay_window_texture
		blend_mode = overlay
		alpha = 0.5
	}

	modify_texture = {
		using = mask_scratches_texture
		blend_mode = alphamultiply
		alpha = 0.4
	}

	glow = {
		glow_radius = 5
		color = { 1.0 0.85 0.55 1.0 }
		alpha = 0.6

		block "glow_visible" {
			visible = no
		}
	}
}

template ui_direction_button_overlay {
	using = color_gold
	using = ui_direction_button_detail
}
