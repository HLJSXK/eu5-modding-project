template advance_icon_base {
	icon =  {
		parentanchor = center
		size = { 97% 97% }
		visible = "[Not(AdvanceDefinition.HasSubunitUnlocks)]"
		texture = "[GetAdvanceIcon(AdvanceDefinition.Self)]"

		modify_texture = {
			texture = "gfx/interface/component_masks/advance_icon_mask.dds"
			blend_mode = alphamultiply
		}
	}

	widget = {
		parentanchor = center
		size = { 100% 100% }
		visible = "[And(AdvanceDefinition.HasSubunitUnlocks, Not(AdvanceDefinition.HasNavyUnlocks))]"
		
		background = {
			texture = "[GetSubunitTypeIllustration(AdvanceDefinition.GetFirstSubunitUnlock, Country.GetCulture)]"
			fittype = centercrop
			frame_grid = { 2 1 }
			frame = 1

			modify_texture = {
				texture = "gfx/interface/component_masks/advance_unit_unlock_mask_square.dds"
				blend_mode = alphamultiply
			}
		}
	}

	widget = {
		parentanchor = center
		size = { 100% 100% }
		visible = "[And(AdvanceDefinition.HasSubunitUnlocks, AdvanceDefinition.HasNavyUnlocks)]"
		
		background = {
			texture = "[GetSubunitTypeIllustration(AdvanceDefinition.GetFirstSubunitUnlock, Country.GetCulture)]"
			fittype = centercrop
			modify_texture = {
				texture = "gfx/interface/component_masks/advance_unit_unlock_mask_square.dds"
				blend_mode = alphamultiply
			}
		}
	}
}

template advance_icon {
	# round bckg
	widget = {
		parentanchor = center
		size = { 105% 105% }
		background = {
			texture = "gfx/interface/advance/backgrounds/green.dds"
			texture_density = 2
		}
	}

	# round bckg
	widget = {
		parentanchor = center
		size = { 105% 105% }
		
		using = background_advance
	}

	widget = {
		parentanchor = center
		size = { 100% 100% }
		using = advance_icon_base
	}
}
