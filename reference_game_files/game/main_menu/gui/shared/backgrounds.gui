		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('production_group')]"
		}
		using = color_production_texture
	}

	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('production_group')]"
		}
		using = color_production_texture

		modify_texture = {
			using = bg_mask_fadehorizontal_middle_thick_texture
			blend_mode = alphamultiply
		}
	}

	# SOCIETY
	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('society_group')]"
		}
		using = color_society_texture
	}

	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('society_group')]"
		}
		using = color_society_texture

		modify_texture = {
			using = bg_mask_fadehorizontal_middle_thick_texture
			blend_mode = alphamultiply
		}
	}

	# DIPLOMACY
	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('diplomacy_group')]"
		}
		using = color_diplomacy_texture
	}

	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('diplomacy_group')]"
		}
		using = color_diplomacy_texture

		modify_texture = {
			using = bg_mask_fadehorizontal_middle_thick_texture
			blend_mode = alphamultiply
		}
	}

	# MILITARY
	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('military_group')]"
		}
		using = color_military_texture
	}

	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('military_group')]"
		}
		using = color_military_texture

		modify_texture = {
			using = bg_mask_fadehorizontal_middle_thick_texture
			blend_mode = alphamultiply
		}
	}

	# GEOPOLITICS
	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('geography_group')]"
		}
