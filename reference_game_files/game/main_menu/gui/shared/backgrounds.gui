template bg_text_mask_container_fade_red {
	background = {
		using = text_mask_container_texture

		block "text_mask_color" {
			modify_texture = {
				using = color_red_texture
				blend_mode = add
				alpha = 0.7
			}
			modify_texture = {
				using = color_red_texture
				blend_mode = overlay
			}
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_horizontal_left.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
			
		}
		block "text_mask_extra" {
			alpha = 0.5
		}
	}
}

template bg_contextual_tooltip {

	background = {
		using = bg_tooltip_shadow_texture
		alpha = 0.3

		margin = { 8 8 }
		margin_top = 1

		shaderfile = "gfx/FX/pdxgui_default.shader"
	}

	background = {
		using = bg_round_corners_alt_texture
		block "bg_tooltip_alpha" {
			alpha = 1.0
		}

		block "tooltip_bg_color" {
			tintcolor = "[ExtraTooltipInfo.GetTintColor]"
		}

		modify_texture = {
			using = color_tool_blue_texture
		}

		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.2
		}
		modify_texture = {
			using = overlay_watercolor_texture
			blend_mode = multiply
			alpha = 0.4
		}

		modify_texture = {
			visible = "[PdxGuiWidget.IsTooltipLocked]"
			using = color_white_texture
			blend_mode = overlay
			alpha = 0.3
		}

		shaderfile = "gfx/FX/pdxgui_default.shader"
	}

	background = {
		using = bg_rough_tile_edge_texture
		alpha = 0.2

		modify_texture = {
			using = color_black_texture
		}
		modify_texture = {
			using = bg_round_corners_alt_texture
			blend_mode = alphamultiply
		}
	}
}

template bg_tooltip_frame {
	size = { 100% 100% }

	background = {
		block "tooltip_locked_visible" {
			visible = "[PdxGuiWidget.IsTooltipLocked]"
		}
		texture = "gfx/interface/component_tiles/bg_round_corners_frame.dds"
		texture_density = 2
		spriteType = Corneredstretched
		spriteborder = { 10 10 }

		modify_texture = {
			using = color_new_gold_texture
			alpha = 1.0
		}
		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.6
		}
		modify_texture = {
			using = overlay_window_texture
			blend_mode = overlay
			alpha = 0.6
		}

		block "tooltip_bg_color" {
			tintcolor = "[ExtraTooltipInfo.GetTintColor]"
		}
	}

	background = {
		block "tooltip_locked_visible" {
			visible = "[PdxGuiWidget.IsTooltipLocked]"
		}
		texture = "gfx/interface/component_decoration/bg_corner_flavor_08.dds"
		texture_density = 2
		spriteType = Corneredstretched
		spriteborder = { 35 35 }
		margin = {-1 -1}

		block "tooltip_bg_color" {
			tintcolor = "[ExtraTooltipInfo.GetTintColor]"
		}
		shaderfile = "gfx/FX/pdxgui_default.shader"

		modify_texture = {
			using = color_new_gold_texture
		}

		modify_texture = {
			using = overlay_window_texture
			blend_mode = overlay
			alpha = 0.6
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.6
		}
	}
	using = bg_corner_flavor
	blockoverride "corner_flavor_texture" {
		texture = "gfx/interface/component_decoration/bg_corner_flavor_06.dds"
		texture_density = 2
		spriteType = Corneredstretched
		spriteborder = { 35 35 }
		margin = {-2 -2}
	}
	blockoverride "corner_flavor_color" {
		modify_texture = {
			using = color_bg_brown_texture
			blend_mode = multiply
		}
		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.3
		}
	}
}

