			texture = "gfx/interface/component_decoration/ios/hre/wooden_frame_hre.dds"
		}
		texture_density = 2
		spritetype = corneredstretched
		spriteBorder = {40 0}
	}

	background = {
		block "wooden_frame_hre_card_shadow"{
		texture = "gfx/interface/component_decoration/ios/hre/wooden_frame_hre_shadow.dds"
		}
		texture_density = 2
		spritetype = corneredstretched
		spriteBorder = {40 0}
	}
}

