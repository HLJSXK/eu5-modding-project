template bg_square_tile_shadow {
	background = {
		texture = "gfx/interface/component_tiles/navigational_square_tile.dds"
		spriteType = Corneredstretched
		spriteborder = { 20 20 }
		texture_density = 2
		alpha = 0.5
		margin_bottom = 1
	}
}

template bg_square_shadow {
	background = {
		using = bg_tooltip_shadow_texture
		alpha = 0.3

		margin = { 8 8 }
		margin_top = 1
	}
}

## TOOLTIPS
###############################################################################

template bg_tooltip_debug {
	using = bg_round_corners_texture
	alpha = 0.2

	modify_texture = {
		using = color_white_texture
		color = { 1.0 0.0 1.0 1.0 }
		alpha = 1.0
	}
}

template text_mask_container_texture {
	texture = "gfx/interface/component_masks/text_mask_frame.dds"
	texture_density = 2
	alpha = 0.8
	spriteType = corneredstretched
	spriteBorder = { 12 12 }
}

template text_mask_container_crusade_texture {
	texture = "gfx/interface/component_decoration/ios/crusade/crusade_number_bg.dds"
	texture_density = 2
	alpha = 0.8
	spriteType = corneredstretched
	spriteBorder = { 0 0 }
}

template bg_text_mask_container_grey {
	background = {
		using = text_mask_container_texture

		block "text_mask_color" {
			modify_texture = {
				using = color_grey_texture
				blend_mode = add
				alpha = 0.7
			}
			modify_texture = {
				using = color_grey_texture
				blend_mode = overlay
			}
		}
	}
}

template bg_text_mask_container_dark_brown {
	background = {
		using = text_mask_container_texture

		block "text_mask_color" {
			modify_texture = {
				using = color_super_dark_brown_texture
				blend_mode = add
				alpha = 0.7
			}
			modify_texture = {
				using = color_super_dark_brown_texture
				blend_mode = overlay
			}
		}
		block "text_mask_extra" {}
	}
}

template bg_text_mask_container_brown {
	background = {
		using = text_mask_container_texture

		block "text_mask_color" {
			modify_texture = {
				using = color_bg_brown_texture
				blend_mode = add
				alpha = 0.7
			}
			modify_texture = {
				using = color_bg_brown_texture
				blend_mode = overlay
			}
		}
		block "text_mask_extra" {
			alpha = 0.5
		}
	}
}

template bg_text_mask_crusade_container {
	background = {
		using = text_mask_container_crusade_texture
		
		block "crusade_container_mirror" {
			mirror = horizontal
		}

		modify_texture = {
			using = color_bg_brown_texture
			blend_mode = add
			alpha = 0.7
		}
		modify_texture = {
			using = color_bg_brown_texture
			blend_mode = overlay
		}
		alpha = 0.5
	}
}

