### CONTAINER TEMPLATES

template bg_grunge_dark_brown {
	background = {
		using = bg_grunge_texture
		alpha = 0.1

		modify_texture = {
			using = color_dark_brown_texture
			alpha = 0.3
		}
	}
}

template bg_unit_selection_shield_shadow {
	background = {
		using = bg_unit_selection_shield_texture
		margin = {1 1}
		alpha = 0.6
	}
}

template bg_circle_hud_dark_blue {
	background = {
		using = bg_circle_hud_background_texture

		modify_texture = {
			using = color_dark_blue_texture
		}
	}
}

template bg_circle_hud_frame_mid_blue {
	background = {
		using = bg_circle_hud_background_texture
		alpha = 1

		modify_texture = {
			using = color_mid_blue_texture
		}

		modify_texture = {
			texture = "gfx/interface/component_overlay/gold_overlay_circle.dds"
			texture_density = 2
			spriteType = stretched
			spriteborder = { 250 250 }
			blend_mode = overlay
			alpha = 0.7
		}
	}

	background = {
		texture = "gfx/interface/component_tiles/hud_corners/circle_shadow.dds"
		texture_density = 2
		margin = { 1 1 }
		alpha = 1
	}

	background = {
		texture = "gfx/interface/component_tiles/hud_corners/circle_frame.dds"
		texture_density = 2
		alpha = 1

		modify_texture = {
			using = color_gold_texture
		}

		using = overlay_gold
	}
}

template bg_circle # circle buttons bg
{
	background = {
		margin = { 2.5 2.5 }
		using = bg_flat_bg_button_texture
		alpha = 1
		using = color_dark_blue
	}
}

template bg_circle_alt # circle buttons bg
{
	background = {
		margin = { 1 1 }
		using = bg_flat_bg_button_texture
		alpha = 1
		using = color_dark_blue
	}
}

template bg_circle_alt_brown # circle buttons bg
{
	background = {
		using = bg_flat_bg_button_texture
		alpha = 0.8
		block "color" {
			using = color_dark_brown
		}

		block "bg_circle_alt_margin" {
			margin = { 0 0 }
		}
	}
}

template bg_circle_alt_purple_02 # circle buttons bg
{
	background = {
		using = bg_flat_bg_button_texture
		alpha = 0.8
		block "bg_circle_alt_margin" {
			margin = { 1 1 }
		}

		modify_texture = {
			using = color_purple_02_texture
		}
	}
}

template bg_circle_light_alt # circle buttons bg
{
	background = {
		margin = { 1 1 }
		texture = "gfx/interface/buttons/bg_button_light.dds"
		spriteType = corneredstretched
		spriteborder = { 19 19 }
		texture_density = 2
		alpha = 1
		using = color_dark_blue
	}
}

template bg_button_light_alt_round # circle buttons bg round
{
	background = {
		margin = { 1 1 }
		texture = "gfx/interface/buttons/bg_button_light_round.dds"
		texture_density = 2
		alpha = 1
		using = color_dark_blue
	}
}

template bg_button_flavor_1 {
	icon = {
		size = {100% 99%}
		using = bg_button_flavor_1_texture

		modify_texture = {
			using = color_new_gold_texture
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.4
		}

		background = {
			using = bg_button_flavor_1_texture
			margin_bottom = 1
		}
	}
}

template bg_button_flavor_2 {
	icon = {
		size = {100% 100%}
		using = bg_button_flavor_2_texture

		modify_texture = {
			using = color_new_gold_texture
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.4
		}

		background = {
			using = bg_button_flavor_2_texture

			modify_texture = {
				using = bg_fade_vertical_up_mask_texture
				blend_mode = alphamultiply
				alpha = 1
			}
		}
	}
}

template bg_button_flavor_3 {
	icon = {
		size = {100% 100%}
		using = bg_button_flavor_3_texture

		modify_texture = {
			using = color_new_gold_texture
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.4
		}

		background = {
			using = bg_button_flavor_3_texture
			margin_bottom = 2

			modify_texture = {
				using = bg_fade_vertical_down_mask_texture
				blend_mode = alphamultiply
				alpha = 1
			}
		}
	}
}

template bg_button_flavor_4 {
