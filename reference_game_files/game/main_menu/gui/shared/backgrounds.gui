}

template bg_banner_02_cloth_texture {
	block "button_texture" {texture = "gfx/interface/buttons/button_banner_02.dds"} 
	texture_density = 2
	alpha = 1
	spriteType = corneredstretched
	spriteborder = { 40 0 }
	frame_grid = {4 1}

	modify_texture = {
		using = overlay_cloth_texture
		blend_mode = overlay
		alpha = 0.1
	}
}

