# Fade overlay for ecs_scene_viewer_widget: dark fade on left and right edges.
# Override `scene_fade_alpha` at the call site to tune intensity per panel.
template scene_fade_horizontal {
	icon = {
		size = { 100% 100% }
		using = color_black_texture
		block "scene_fade_alpha" {
			alpha = 0.5
		}
		mirror = horizontal
		modify_texture = {
			using = bg_mask_fade_horizontal_texture
			blend_mode = alphamultiply
		}
	}

	icon = {
		size = { 100% 100% }
		using = color_black_texture
		block "scene_fade_alpha" {
			alpha = 0.5
		}
		modify_texture = {
			using = bg_mask_fade_horizontal_texture
			blend_mode = alphamultiply
		}
	}
}

# Fade overlay for ecs_scene_viewer_widget: dark fade from bottom up.
# Uses background so the template is safe inside hbox/vbox parents
# (e.g. one_country_header_template pasted into an hbox in disasters_common.gui).
template scene_fade_vertical_up {
	background = {
		using = color_black_texture
		block "scene_fade_alpha" {
			alpha = 0.5
		}
		modify_texture = {
			using = bg_fade_vertical_up_mask_texture
			blend_mode = alphamultiply
		}
	}
}

