template events_mask_texture {
	background = {
		using = bg_mask_events_texture_full_texture
		alpha = 0.8

		modify_texture = {
			using = color_paper_texture
		}

		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.9
		}
	}
}

template bg_scroll_card_header {
	block "card_header_shadow" {
		background = {
			using = bg_tile_card_shadow_texture
			margin = { 10 10 }
			margin_top = 6
			alpha = 0.6
		}
	}

	background = {
		using = scroll_card_texture
		margin = { 5 3 }
		margin_top = 2
		margin_bottom = 3
		alpha = 0.4
	}

	background = {
		using = scroll_card_texture
		margin = {4 1}

		modify_texture = {
			using = color_paper_texture
		}

		modify_texture = {
			using = overlay_paper_03
			alpha = 0.3
		}
		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.1
		}
	}

	block "card_header_pattern" {
		background = {
			using = bg_card_header_01_default
			margin = {-5 0}
			blockoverride "header_color" {
				block "header_color_scroll_bg" {
					using = color_diplomacy_texture
				}
			}
			blockoverride "header_pattern" {
				using = bg_cloth_overlay_texture
				blend_mode = overlay
			}
			using = graphical_culture_pattern
			modify_texture = {
				block "uiaction_gov" {
					visible = no
				}
				using = color_greyish_texture
				alpha = 1
				blend_mode = normal
			}
		}
	}

	background = {
		using = bg_mask_events_texture_full_texture
		alpha = 0.4
		margin = {-5 0}

		modify_texture = {
			using = color_paper_texture
		}

		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.9
		}
	}

	background = {
		using = bg_mask_fade_horizontal_sides_texture
		alpha = 0.2
		margin = {-5 0}

		modify_texture = {
			using = color_black_texture
			blend_mode = multiply
		}

		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.9
		}
	}

	background = {
		using = scroll_card_outline_texture
		margin = { 5 3 }
		alpha = 0.4
		modify_texture = {
			using = color_default_brown_texture
			blend_mode = multiply
		}
	}
}

