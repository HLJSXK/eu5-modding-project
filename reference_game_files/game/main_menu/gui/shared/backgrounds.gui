template bg_window_default_expandable_template {
	texture = "gfx/interface/component_tiles/tile_background_center.dds"
	texture_density = 2
	spriteType = corneredstretched
	spriteBorder = { 20 20 }
	alpha = 0.93

	modify_texture = {
		using = color_dark_blue_texture
	}

	modify_texture = {
		using = overlay_window_texture
		blend_mode = overlay
	}

	modify_texture = {
		using = overlay_stone_texture
		blend_mode = overlay
		alpha = 0.8
	}
}

template bg_window_default_frame_template {
	margin = { -5 -5 }
	texture = "gfx/interface/component_tiles/tile_frame_center.dds"
	texture_density = 2
	spriteType = corneredtiled
	spriteBorder = { 20 20 }
	alpha = 0.9

	modify_texture = {
		using = color_gold_texture
	}

	modify_texture = {
		texture = "gfx/interface/component_tiles/tile_frame_center_bevel.dds"
		texture_density = 2
		spriteType = corneredtiled
		spriteBorder = { 20 20 }
		alpha = 0.1
	}

	modify_texture = {
		using = overlay_window_texture
		alpha = 0.2
	}

	modify_texture = {
		using = overlay_stone_texture
		blend_mode = overlay
		alpha = 1
	}
}

@lateralview_bg_margin = 5
template bg_lateralview {
	background = {
		texture = "gfx/interface/component_tiles/tile_shadow_squared_dark.dds"
		spriteType = corneredstretched
		texture_density = 2
		frame_grid = { 1 2 }
		frame = 2

		spriteborder_left = @lateralview_bg_margin
		spriteborder_right = @lateralview_bg_margin
		spriteborder_bottom = 2

		margin_left = @lateralview_bg_margin
		margin_right = @lateralview_bg_margin
		margin_bottom = @lateralview_bg_margin

		using = color_black_texture
	}

	background = {
		using = color_black_texture
		alpha = 0.93

		using = color_dark_blue
		using = overlay_window
	}

	background = {
		using = tile_frame_squared_texture
		alpha = 0.9

		margin = { 0 0 }

		using = color_new_gold

		modify_texture = {
