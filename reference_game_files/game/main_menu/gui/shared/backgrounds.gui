## WINDOWS
###############################################################################

template bg_panel_bar {
	background = {
		texture = "gfx/interface/component_tiles/bg_age_title.dds"
		texture_density = 2
		spriteType = corneredstretched
		spriteBorder = { 40 50 }
		margin = {0 -2}

		using = color_bg_blue
		using = overlay_window

		modify_texture = {
			using = overlay_leather_texture
			blend_mode = multiply
			alpha = 0.5
		}

		modify_texture = {
			block "bg_panel_bar_graphical_texture" {
				texture = "[GetGraphicalCultureTexture('panel_bar_corner_bg')]"
			}
			texture_density = 1.5
			spriteType = corneredtiled
			spriteborder = { 0 0 }
			blend_mode = add
			alpha = 0.2
		}
	}
}

template bg_panel_tabs {
	background = {
		block "bg_panel_tabs_color" {
			visible = no
			using = color_intense_bg_blue_texture
		}
	}

	background = {
		block "bg_panel_tabs_gradient_color" {
			visible = no
			using = color_mid_purple_texture
		}

		modify_texture = {
			using = bg_mask_fadehorizontal_middle_thick_texture
			blend_mode = alphamultiply
		}
	}

	# GOVERNMENT
	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('government_group')]"
		}
		using = color_government_texture
	}

	background = {
		block "bg_panel_group_tabs_color" {
			visible = "[IsLateralGroupOpened('government_group')]"
		}
		using = color_government_texture

		modify_texture = {
