template bg_townrights_card {
	background = {
		texture = "gfx/interface/component_tiles/square_wood_background.dds"
		texture_density = 2
		spriteType = corneredstretched
		spriteborder = { 10 10 }
		spriteborder_top = 50

		modify_texture = {
			texture = "gfx/interface/component_tiles/wood_texture_town_right.dds"
			alpha = 0.7
			texture_density = 2
			blend_mode = overlay
		}
	}
	
}
template bg_paper_card {
	background = {
		using = paper_card_texture
		margin = { 1 1 }
		margin_bottom = 2
		alpha = 0.4
		block "card_shadow_margin" {}
	}

	background = {
		using = paper_card_texture
		block "card_margin" {}

		block "card_color" {
			modify_texture = {
				using = color_paper_texture
			}
		}

		modify_texture = {
			using = overlay_paper_03
		}

		block "card_texture_extra" {}
	}
}

template bg_paper_card_situations {
	background = {
		using = bg_paper_card_fancy_01_texture
		margin = { 1 1 }
		margin_bottom = 2
		alpha = 0.4
	}

	background = {
		using = bg_paper_card_fancy_01_texture
		block "card_margin" {}

		block "card_color" {
			modify_texture = {
				using = color_paper_texture
			}
			modify_texture = {
				using = color_black_texture
				alpha = 0.3
			}
		}

		modify_texture = {
			using = overlay_paper_03
		}
		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.2
		}

		block "card_texture_extra" {}
	}
}

template bg_card_header_situation {
	background = {
		block "header_color" {
			using = color_purple_02_texture
		}
		texture_density = 2
		margin_top = 1
		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.3
		}
	}

	background = {
		using = color_dark_blue_texture
		alpha = 0.3
		margin_top = 1
		modify_texture = {
			using = mask_fade_horizontal_middle_texture
			blend_mode = alphamultiply
		}
	}
	background = {
		using = tile_frame_squared_texture
		alpha = 0.5
		modify_texture = {
			using = color_black_texture
		}
		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.3
		}
	}

}

template bg_card_header_geo_situation {
	background = {
		texture = "gfx/interface/cards/headers/situations/geo_header_decor.dds"
		texture_density = 2
		spriteType = Corneredstretched
		spriteborder = { 100 0 }
		alpha = 0.5
		modify_texture = {
			using = color_black_texture
		}
		modify_texture = {
			using = overlay_cloth_texture
			blend_mode = overlay
			alpha = 0.3
		}
	}
}

template bg_situation_striped_frame {
	background = {
		using = bg_frame_striped_situation_texture
		alpha = 0.5
		margin_bottom = 2
		margin_top = -2
		modify_texture = {
			using = color_black_texture
		}
	}
	background = {
		using = bg_frame_striped_situation_texture
		modify_texture = {
			using = color_new_gold_texture
		}
		modify_texture = {
			using = color_black_texture
			blend_mode = overlay
			alpha = 0.3
