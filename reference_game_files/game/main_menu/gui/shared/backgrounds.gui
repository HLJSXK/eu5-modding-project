		}

		modify_texture = {
			using = color_black_texture
			blend_mode = multiply
		}
	}

	background = {
		using = bg_button_flat_texture
		block "container_margin" {
			margin = {0 0}
		}

		block "inside_color" {
			modify_texture = {
				using = color_progress_blue_texture
				blend_mode = multiply
			}
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.6
		}
	}

	background = {
		block "frame_size" {
			using = bg_circle_frame_alt_texture
		}

		modify_texture = {
			using = bg_mask_fade_vertical_up_texture
			alpha = 0.2
		}

		block "frame_color" {
			modify_texture = {
				using = color_new_gold_texture
				blend_mode = multiply
			}
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 0.6
		}
	}
}

