# If you update these values then also check whether any texticon below still needs them literal.
@font_icon_default_fontsize = 16
@font_icon_default_size = 20
@font_icon_default_offset = 4

@font_icon_compact_size = @[font_icon_default_size * 0.9]
@font_icon_compact_offset = 3

####################################
# Important Concepts
####################################

texticon = {
	icon = power
	iconsize = {
		texture = "gfx/interface/icons/foreign_country/power.dds"
		size = { @[font_icon_default_size * 0.85] @[font_icon_default_size * 0.85] }
		offset = { 0 2 }
		fontsize = @font_icon_default_fontsize
	}
}

