## Sans Serif font data
## Declares StandardGameFont_SansSerifSetting, HeadersFont_SansSerifSetting, and
## FlavorFont_SansSerifSetting — unique names so these never conflict with the base font families.
## The fontfiles blocks (NotoSans-SemiBold etc.) live in loading_screen_fonts.font so they are
## only registered once regardless of how many font contexts are initialised.
## PostLoadInit in loading_screen.cpp reads these via FontRegister when sans_serif is active.

font = {
	name = "StandardGameFont_SansSerifSetting"

	fontstyle = {
		style = regular
		fontfiles = "NotoSans-Regular"
	}

	fontstyle = {
		style = bold
		fontfiles = "NotoSans-Medium"
	}

	fontstyle = {
		style = italic
		fontfiles = "NotoSans-Italic"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "NotoSans-MediumItalic"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}

font = {
	name = "HeadersFont_SansSerifSetting"

	fontstyle = {
		style = regular
		fontfiles = "NotoSansGame-SemiBold"
	}

	fontstyle = {
		style = italic
		fontfiles = "NotoSansGame-SemiBoldItalic"
	}

	fontstyle = {
		style = bold
		fontfiles = "NotoSansGame-Bold"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "NotoSansGame-BoldItalic"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}

# FlavorFont styles are inverted (regular = italic feel, italic = upright) — keep the same pattern but in NotoSans

font = {
	name = "FlavorFont_SansSerifSetting"

	fontstyle = {
		style = regular
		fontfiles = "NotoSans-Italic"
	}

	fontstyle = {
		style = bold
		fontfiles = "NotoSansGame-SemiBoldItalic"
	}

	fontstyle = {
		style = italic
		fontfiles = "NotoSans-Regular"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "NotoSansGame-SemiBold"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}
