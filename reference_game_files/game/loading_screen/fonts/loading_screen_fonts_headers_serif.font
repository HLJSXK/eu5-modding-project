## Headers Only (Serif) font data
## Declares StandardGameFont_HeadersSerifSetting and FlavorFont_HeadersSerifSetting — unique names
## so these never conflict with the base font families.  HeadersFont is intentionally omitted so it
## keeps the default NotoSerif.  The fontfiles blocks used here are from loading_screen_fonts.font.
## PostLoadInit in loading_screen.cpp reads these via FontRegister when headers_serif is active.

font = {
	name = "StandardGameFont_HeadersSerifSetting"

	fontstyle = {
		style = regular
		fontfiles = "NotoSans-Regular"
	}

	fontstyle = {
		style = bold
		fontfiles = "NotoSans-Medium"
	}

	fontstyle = {
		style = italic
		fontfiles = "NotoSans-Italic"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "NotoSans-MediumItalic"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}

font = {
	name = "FlavorFont_HeadersSerifSetting"

	fontstyle = {
		style = regular
		fontfiles = "NotoSans-Italic"
	}

	fontstyle = {
		style = bold
		fontfiles = "NotoSans-MediumItalic"
	}

	fontstyle = {
		style = italic
		fontfiles = "NotoSans-Regular"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "NotoSans-Medium"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}
