### Unique Events Tab - standalone type for left_panel compatibility.
### Other mods only need to add: button_panel_tab_uniqueevents = {}
### inside the tab hbox in their left_panel.gui.

template TabCountryEventsTooltip {
	ConceptTooltipType = {
		blockoverride "title_icon" {
			icon = {
				texture = "gfx/interface/icons/flat_icons/tabicons/content_flat_icon.dds"
				using = tooltip_concept_title_icon_size
			}
		}

		blockoverride "title_text" {
			text = "TAB_TOOLTIP_COUNTRY_EVENTS_TITLE"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "TAB_TOOLTIP_COUNTRY_EVENTS_TEXT"
				}
			}

			TooltipFunctionalBlock = {
				using = tooltip_left_click_template

				blockoverride "action_left_text" {
					text = "TAB_TOOLTIP_COUNTRY_EVENTS_LEFT_CLICK"
				}
			}
		}
	}
}

types UniqueEventsTabTypes
{
	type button_panel_tab_uniqueevents = button_panel_tab_alt {
		visible = "[IsPlayerValid]"

		widget = {
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			visible = yes

			state = {
				name = _show
				on_start = "[ExecuteConsoleCommand('gui.ClearWidgets country_events_window')]"
				on_start = "[GetVariableSystem.Clear('ce_window_open')]"
				on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_start = "[GetVariableSystem.Clear('ce_window_reload_section')]"
				on_start = "[GetVariableSystem.Clear('ce_open_tag')]"
				on_start = "[GetVariableSystem.Clear('ce_display_tag')]"
				on_start = "[GetVariableSystem.Clear('ce_active_sec')]"
				on_start = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
			}
		}

		onclick = "[LeftView.Close]"
		onclick = "[GetVariableSystem.Set('ce_active_sec', '0')]"
		onclick = "[GetVariableSystem.Set('ce_filter_mode', 'all')]"
		onclick = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
		onclick = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
		onclick = "[GetVariableSystem.Clear('ce_window_reload_section')]"
		onclick = "[GetVariableSystem.Set('ce_open_tag', Player.GetTag)]"
		onclick = "[GetVariableSystem.Clear('ce_display_tag')]"
		onclick = "[GetVariableSystem.Set('ce_window_pending_open', '1')]"
		onclick = "[ExecuteConsoleCommand( Select_CString( GetVariableSystem.Exists('ce_window_open'), 'gui.ClearWidgets country_events_window', Select_CString( EqualTo_string(Localize(Concatenate('CE_HAS_', Player.GetTag)), '1'), Concatenate('gui.CreateWidget gui/country_events_windows/country_events_window_', Concatenate(Player.GetTag, '.gui country_events_window')), 'gui.CreateWidget gui/country_events_lateralview.gui country_events_window' ) ) )]"
		onclick = "[GetVariableSystem.Toggle('ce_window_open')]"
		down = "[And(GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'))]"
		onmousehierarchyenter = "[ResetHighlightedTab]"

		widget = {
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			visible = "[And(IsPlayerValid, And3(GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'), Not(EqualTo_string(Player.GetTag, GetVariableSystem.Get('ce_open_tag')))))]"

			state = {
				name = _show
				on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_start = "[GetVariableSystem.Clear('ce_window_reload_section')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
				on_start = "[GetVariableSystem.Clear('ce_display_tag')]"
				on_start = "[GetVariableSystem.Set('ce_open_tag', Player.GetTag)]"
				on_start = "[GetVariableSystem.Set('ce_active_sec', '0')]"
				on_start = "[GetVariableSystem.Set('ce_filter_mode', 'all')]"
				on_start = "[ExecuteConsoleCommand('gui.ClearWidgets country_events_window')]"
				on_start = "[ExecuteConsoleCommand(Select_CString(EqualTo_string(Localize(Concatenate('CE_HAS_', Player.GetTag)), '1'), Concatenate('gui.CreateWidget gui/country_events_windows/country_events_window_', Concatenate(Player.GetTag, '.gui country_events_window')), 'gui.CreateWidget gui/country_events_lateralview.gui country_events_window'))]"
			}
		}

		tooltipwidget = {
			using = TabCountryEventsTooltip
		}

		using = layoutpolicy_expanding

		panel_tab_highlight = {
			visible = no
		}

		icon = {
			size = { 26 26 }
			parentanchor = center
			texture = "gfx/interface/icons/flat_icons/tabicons/content_flat_icon.dds"
			texture_density = 2

			using = button_panel_tab_icon_effect
			blockoverride "icon_effect_visible" { visible = "[And(GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'))]" }
			blockoverride "icon_effect_color" { color = { 0.85 0.65 0.20 1.0 } }
		}
	}
}
