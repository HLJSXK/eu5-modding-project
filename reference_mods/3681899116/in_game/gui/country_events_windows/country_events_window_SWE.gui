window = {
	name = "country_events_window"
	datacontext = "[GetVariableSystem]"
	using = lateralview_left_setup
	movable = no

	vbox = {
		size = { 100% 100% }
		using = lateralview_margins

		widget = {
			visible = "[GetVariableSystem.Exists('ce_window_pending_open')]"
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			widget = {
				visible = "[Not(Or(LeftView.IsShown, LeftView.IsSideAttached))]"
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				state = {
					name = _show
					on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				}
			}
		}

		widget = {
			visible = "[And3(GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'), Not(GetVariableSystem.Exists('ce_window_pending_open')))]"
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			widget = {
				visible = "[Or(LeftView.IsShown, LeftView.IsSideAttached)]"
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				state = {
					name = _show
					on_start = "[GetVariableSystem.Clear('ce_window_open')]"
					on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
					on_start = "[GetVariableSystem.Clear('ce_open_tag')]"
					on_start = "[GetVariableSystem.Clear('ce_active_sec')]"
					on_start = "[GetVariableSystem.Clear('ce_filter_mode')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_has_option_effects')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_immediate_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_0_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_0_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_1_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_1_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
				}
			}
		}

		widget = {
			visible = "[Not(IsPlayerValid)]"
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			state = {
				name = _show
				on_start = "[GetVariableSystem.Clear('ce_window_open')]"
				on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_start = "[GetVariableSystem.Clear('ce_open_tag')]"
				on_start = "[GetVariableSystem.Clear('ce_active_sec')]"
				on_start = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_has_option_effects')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_immediate_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_0_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_0_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_1_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_1_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}
		}

		widget = {
			visible = "[And3(IsPlayerValid, GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'))]"
			datacontext = "[GetPlayer]"
			size = { 100% 100% }
			using = layoutpolicy_expanding
			alwaystransparent = no
			allow_outside = yes

			button = {
				visible = yes
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				parentanchor = left|top
				tooltip_enabled = no
				input_action = "close_window"
				use_global_input_instance = yes
				on_input_action_shortcut = "[ExecuteConsoleCommand('gui.ClearWidgets country_events_window')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_window_open')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_open_tag')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_display_tag')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_active_sec')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
