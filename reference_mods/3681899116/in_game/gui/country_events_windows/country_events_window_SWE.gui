		vbox = {
			using = layoutpolicy_expanding
			layoutpolicy_vertical = expanding
			using = bg_paper_card

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 48 }
				using = bg_card_header_01_geopolitics

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 12 0 }
					spacing = 8

					icon = {
						size = { 32 32 }
						texture = "[Select_CString(GetVariableSystem.Exists('ce_selected_event_age_icon'), GetVariableSystem.Get('ce_selected_event_age_icon'), 'gfx/interface/icons/flat_icons/tabicons/content_flat_icon.dds')]"
						texture_density = 2
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 1

						text_single = {
							visible = "[Not(GetVariableSystem.Exists('ce_selected_event_slug'))]"
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							using = Font_Type_Headers
							default_format = "#yellow_titles"
							text = "COUNTRY_EVENTS_SELECT_EVENT_TITLE"
						}

						text_single = {
							visible = "[GetVariableSystem.Exists('ce_selected_event_slug')]"
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							using = Font_Type_Headers
							default_format = "#yellow_titles"
							text = "[Localize(Concatenate(Concatenate('COUNTRY_EVENTS_AUTO_', GetVariableSystem.Get('ce_selected_event_slug')), '_TITLE'))]"
						}

						text_single = {
							visible = "[GetVariableSystem.Exists('ce_selected_event_slug')]"
							layoutpolicy_horizontal = expanding
							align = left|nobaseline
							fontsize = 12
							default_format = "#subtle_name"
							text = "[Localize(Concatenate(Concatenate('COUNTRY_EVENTS_AUTO_', GetVariableSystem.Get('ce_selected_event_slug')), '_SUBTITLE'))]"
						}
					}
				}
			}

			scrollarea = {
				using = layoutpolicy_expanding
				scrollbarpolicy_vertical = as_needed
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical_Small
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						ignoreinvisible = yes
						margin = { 10 10 }

						vbox = {
							visible = "[Not(GetVariableSystem.Exists('ce_selected_event_slug'))]"
							layoutpolicy_horizontal = expanding
							using = bg_paper_card_fancy
							margin = { 12 10 }
							spacing = 6

							text_multi = {
								layoutpolicy_horizontal = expanding
								text = "COUNTRY_EVENTS_SELECT_EVENT_DESC"
								multiline = yes
								autoresize = yes
								default_format = "#color_light_gray"
							}
						}

						vbox = {
							visible = "[GetVariableSystem.Exists('ce_selected_event_slug')]"
