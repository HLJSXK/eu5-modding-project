							using = bg_paper_card_fancy
							margin = { 12 10 }
							spacing = 6

							text_multi = {
								layoutpolicy_horizontal = expanding
								text = "COUNTRY_EVENTS_SELECT_EVENT_DESC"
								multiline = yes
								autoresize = yes
								default_format = "#color_light_gray"
							}
						}

						vbox = {
							visible = "[GetVariableSystem.Exists('ce_selected_event_slug')]"
