								autoresize = yes
								default_format = "#color_light_gray"
							}
						}

						vbox = {
							visible = "[GetVariableSystem.Exists('ce_selected_event_slug')]"
							layoutpolicy_horizontal = expanding
							spacing = 8

							vbox = {
								layoutpolicy_horizontal = expanding
								using = bg_paper_card_fancy
								margin = { 12 10 }
								spacing = 6

								text_multi = {
									layoutpolicy_horizontal = expanding
									text = "[Localize(Concatenate(Concatenate('COUNTRY_EVENTS_AUTO_', GetVariableSystem.Get('ce_selected_event_slug')), '_DESC'))]"
									multiline = yes
