																texture_density = 2
															}
														}
														blockoverride "concept_link" {
															text = [effect|e]
														}
														blockoverride "tooltip_content" {
															TooltipScrolledConditionList = {
																blockoverride "block_scrollarea" { maximumsize = { -1 360 } }
																textcontext = "[ShowScriptedEffect(GetVariableSystem.Get('ce_selected_event_option_4_effect'),PlayerScope.Self)]"
															}
														}
													}
												}
											}

											button_regular_diamond = {
												visible = "[GetVariableSystem.Exists('ce_selected_event_option_5_effect')]"
												layoutpolicy_horizontal = expanding
												size = { -1 36 }
												fontsize = 12
												using = snd_UI_event_option_generic
												text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_5_title_loc'))]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_5_title_loc'))]"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/flat_icons/effect.dds"
																texture_density = 2
															}
														}
														blockoverride "concept_link" {
															text = [effect|e]
														}
														blockoverride "tooltip_content" {
															TooltipScrolledConditionList = {
																blockoverride "block_scrollarea" { maximumsize = { -1 360 } }
																textcontext = "[ShowScriptedEffect(GetVariableSystem.Get('ce_selected_event_option_5_effect'),PlayerScope.Self)]"
															}
														}
													}
												}
											}

											button_regular_diamond = {
												visible = "[GetVariableSystem.Exists('ce_selected_event_option_6_effect')]"
												layoutpolicy_horizontal = expanding
												size = { -1 36 }
												fontsize = 12
												using = snd_UI_event_option_generic
												text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_6_title_loc'))]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_6_title_loc'))]"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/flat_icons/effect.dds"
																texture_density = 2
															}
														}
														blockoverride "concept_link" {
															text = [effect|e]
														}
														blockoverride "tooltip_content" {
															TooltipScrolledConditionList = {
																blockoverride "block_scrollarea" { maximumsize = { -1 360 } }
																textcontext = "[ShowScriptedEffect(GetVariableSystem.Get('ce_selected_event_option_6_effect'),PlayerScope.Self)]"
															}
														}
													}
												}
											}

											button_regular_diamond = {
												visible = "[GetVariableSystem.Exists('ce_selected_event_option_7_effect')]"
												layoutpolicy_horizontal = expanding
												size = { -1 36 }
												fontsize = 12
												using = snd_UI_event_option_generic
												text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_7_title_loc'))]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_7_title_loc'))]"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/flat_icons/effect.dds"
																texture_density = 2
															}
														}
														blockoverride "concept_link" {
															text = [effect|e]
														}
														blockoverride "tooltip_content" {
															TooltipScrolledConditionList = {
																blockoverride "block_scrollarea" { maximumsize = { -1 360 } }
																textcontext = "[ShowScriptedEffect(GetVariableSystem.Get('ce_selected_event_option_7_effect'),PlayerScope.Self)]"
															}
														}
													}
												}
											}
										}

										text_single = {
											visible = "[Not(GetVariableSystem.Exists('ce_selected_event_has_option_effects'))]"
											layoutpolicy_horizontal = expanding
											text = "NONE"
											default_format = "#color_light_gray"
										}
									}
								}
							}

							vbox = {
								visible = "[Not(GetVariableSystem.Exists('ce_selected_event_native_effects'))]"
								layoutpolicy_horizontal = expanding
								vbox = {
									layoutpolicy_horizontal = expanding
									using = bg_paper_card_fancy
									spacing = 0

									widget = {
										layoutpolicy_horizontal = expanding
										size = { -1 34 }
										using = bg_card_header_01_geopolitics

										hbox = {
											layoutpolicy_horizontal = expanding
											margin = { 10 0 }
											spacing = 6

											icon = {
												size = { 20 20 }
												texture = "gfx/interface/icons/flat_icons/effect.dds"
												texture_density = 2
											}

											text_single = {
												layoutpolicy_horizontal = expanding
												using = Font_Type_Headers
												fontsize = 13
												default_format = "#yellow_titles"
												text = "COUNTRY_EVENTS_OUTCOMES_LABEL"
											}
										}
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 12 10 }
										spacing = 6
										text_multi = {
											layoutpolicy_horizontal = expanding
											text = "[Localize(Concatenate(Concatenate('COUNTRY_EVENTS_AUTO_', GetVariableSystem.Get('ce_selected_event_slug')), '_OUTCOMES'))]"
											multiline = yes
											autoresize = yes
											default_format = "#color_light_gray"
										}
									}
								}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								using = bg_paper_card_fancy
								spacing = 0

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 34 }
									using = bg_card_header_01_geopolitics

									hbox = {
										layoutpolicy_horizontal = expanding
										margin = { 10 0 }
										spacing = 6

										icon = {
											size = { 20 20 }
											texture = "gfx/interface/icons/text_icons/trigger_yes.dds"
											texture_density = 2
										}

										text_single = {
											layoutpolicy_horizontal = expanding
											using = Font_Type_Headers
											fontsize = 13
											default_format = "#yellow_titles"
											text = "COUNTRY_EVENTS_REQUIREMENTS_LABEL"
										}
									}
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									margin = { 12 10 }
									spacing = 6
									TooltipRequirementsList = {
										visible = "[And(GetVariableSystem.Exists('ce_selected_event_slug'), GetVariableSystem.Exists('ce_selected_event_viewer'))]"
										layoutpolicy_horizontal = expanding
										textcontext = "[ShowTriggerConditions(GetVariableSystem.Get('ce_selected_event_viewer'),PlayerScope.Self)]"
									}
									text_multi = {
										visible = "[And(GetVariableSystem.Exists('ce_selected_event_slug'), Not(GetVariableSystem.Exists('ce_selected_event_viewer')))]"
										layoutpolicy_horizontal = expanding
										text = "[Localize(Concatenate(Concatenate('COUNTRY_EVENTS_AUTO_', GetVariableSystem.Get('ce_selected_event_slug')), '_REQUIREMENTS'))]"
										multiline = yes
										autoresize = yes
										default_format = "#color_light_gray"
									}
								}
							}
						}
					}
				}
			}
		}

	}
}

window = {
	name = "country_events_window"
	datacontext = "[GetVariableSystem]"
	using = lateralview_left_setup
	movable = no

	vbox = {
		size = { 100% 100% }
		using = lateralview_margins

		widget = {
			visible = "[GetVariableSystem.Exists('ce_window_pending_open')]"
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			widget = {
				visible = "[Not(Or(LeftView.IsShown, LeftView.IsSideAttached))]"
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				state = {
					name = _show
					on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				}
			}
		}

		widget = {
			visible = "[And3(GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'), Not(GetVariableSystem.Exists('ce_window_pending_open')))]"
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			widget = {
				visible = "[Or(LeftView.IsShown, LeftView.IsSideAttached)]"
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				state = {
					name = _show
					on_start = "[GetVariableSystem.Clear('ce_window_open')]"
					on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
					on_start = "[GetVariableSystem.Clear('ce_open_tag')]"
					on_start = "[GetVariableSystem.Clear('ce_active_sec')]"
					on_start = "[GetVariableSystem.Clear('ce_filter_mode')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
