					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}
		}

		widget = {
			visible = "[And3(IsPlayerValid, GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'))]"
			datacontext = "[GetPlayer]"
			size = { 100% 100% }
			using = layoutpolicy_expanding
			alwaystransparent = no
			allow_outside = yes

			button = {
				visible = yes
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				parentanchor = left|top
				tooltip_enabled = no
				input_action = "close_window"
				use_global_input_instance = yes
				on_input_action_shortcut = "[ExecuteConsoleCommand('gui.ClearWidgets country_events_window')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_window_open')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_open_tag')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_display_tag')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_active_sec')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
