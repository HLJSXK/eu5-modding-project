												visible = "[GetVariableSystem.Exists('ce_selected_event_option_4_effect')]"
												layoutpolicy_horizontal = expanding
												size = { -1 36 }
												fontsize = 12
												using = snd_UI_event_option_generic
												text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_4_title_loc'))]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_4_title_loc'))]"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/flat_icons/effect.dds"
																texture_density = 2
															}
														}
														blockoverride "concept_link" {
															text = [effect|e]
														}
														blockoverride "tooltip_content" {
															TooltipScrolledConditionList = {
																blockoverride "block_scrollarea" { maximumsize = { -1 360 } }
																textcontext = "[ShowScriptedEffect(GetVariableSystem.Get('ce_selected_event_option_4_effect'),PlayerScope.Self)]"
															}
														}
													}
												}
											}

											button_regular_diamond = {
												visible = "[GetVariableSystem.Exists('ce_selected_event_option_5_effect')]"
												layoutpolicy_horizontal = expanding
												size = { -1 36 }
												fontsize = 12
												using = snd_UI_event_option_generic
												text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_5_title_loc'))]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_5_title_loc'))]"
														}
														blockoverride "title_icon" {
