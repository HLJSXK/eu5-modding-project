												visible = "[GetVariableSystem.Exists('ce_selected_event_option_7_effect')]"
												layoutpolicy_horizontal = expanding
												size = { -1 36 }
												fontsize = 12
												using = snd_UI_event_option_generic
												text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_7_title_loc'))]"
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[Localize(GetVariableSystem.Get('ce_selected_event_option_7_title_loc'))]"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/flat_icons/effect.dds"
																texture_density = 2
															}
														}
