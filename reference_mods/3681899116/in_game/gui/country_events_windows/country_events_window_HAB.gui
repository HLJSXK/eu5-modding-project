					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}
		}

		widget = {
			visible = "[And3(IsPlayerValid, GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'))]"
			datacontext = "[GetPlayer]"
			size = { 100% 100% }
			using = layoutpolicy_expanding
			alwaystransparent = no
			allow_outside = yes

			button = {
				visible = yes
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				parentanchor = left|top
				tooltip_enabled = no
				input_action = "close_window"
				use_global_input_instance = yes
				on_input_action_shortcut = "[ExecuteConsoleCommand('gui.ClearWidgets country_events_window')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_window_open')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_open_tag')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_display_tag')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_active_sec')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_has_option_effects')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_immediate_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_0_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_0_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_1_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_1_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}

			widget = {
				visible = "[Not(GetVariableSystem.Exists('ce_filter_mode'))]"
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
				size = { 1 1 }
				state = {
					name = _show
					on_start = "[GetVariableSystem.Set('ce_filter_mode', 'all')]"
				}
			}

			using = bg_lateralview

			vbox = {
				size = { 100% 100% }
				window_header_alt = {
					blockoverride "header_text" {
						text = "COUNTRY_EVENTS_HEADER"
					}
					blockoverride "window_header_alt_color_texture" {
						using = color_geopolitics_texture
					}
				}

				hbox = {
					using = layoutpolicy_expanding

					widget = {
						using = layoutpolicy_expanding

						vbox = {
							using = layoutpolicy_expanding
							country_events_body_HAB = {}
						}

						window_bottom_paper_template = {}
					}

				}
			}

			widget = {
				size = { 100% 40 }

				widget = {
					parentanchor = right
					size = { 40 40 }

					ui_direction_button_holder_right = {}

					button_close_alt = {
						blockoverride "close_onclick" {
							onclick = "[ExecuteConsoleCommand('gui.ClearWidgets country_events_window')]"
							onclick = "[GetVariableSystem.Clear('ce_window_open')]"
							onclick = "[GetVariableSystem.Clear('ce_window_pending_open')]"
							onclick = "[GetVariableSystem.Clear('ce_open_tag')]"
							onclick = "[GetVariableSystem.Clear('ce_display_tag')]"
							onclick = "[GetVariableSystem.Clear('ce_active_sec')]"
							onclick = "[GetVariableSystem.Clear('ce_filter_mode')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_has_option_effects')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_immediate_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_0_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_0_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_1_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_1_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
						}

						blockoverride "close_inputaction" {
							input_action = "close_window"
							use_global_input_instance = yes
						}
					}
				}
			}

			window_bottom_paper_template = {}
		}
	}
