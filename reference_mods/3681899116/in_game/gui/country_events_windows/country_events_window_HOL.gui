							onclick = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_has_option_effects')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_immediate_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_0_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_0_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_1_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_1_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
							onclick = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
						}

						blockoverride "close_inputaction" {
							input_action = "close_window"
							use_global_input_instance = yes
						}
					}
				}
			}

			window_bottom_paper_template = {}
		}
	}
}
