					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
				}
			}
		}

		widget = {
			visible = "[Not(IsPlayerValid)]"
			visible_at_creation = no
			ignore_layout = yes
			alwaystransparent = yes
			size = { 1 1 }
			state = {
				name = _show
				on_start = "[GetVariableSystem.Clear('ce_window_open')]"
				on_start = "[GetVariableSystem.Clear('ce_window_pending_open')]"
				on_start = "[GetVariableSystem.Clear('ce_open_tag')]"
				on_start = "[GetVariableSystem.Clear('ce_active_sec')]"
				on_start = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_has_option_effects')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_immediate_effect')]"
