				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_1_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_1_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_2_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_2_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_3_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_3_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_4_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_4_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_5_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_5_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}

			widget = {
				visible = "[Not(GetVariableSystem.Exists('ce_filter_mode'))]"
				visible_at_creation = no
				ignore_layout = yes
				alwaystransparent = yes
