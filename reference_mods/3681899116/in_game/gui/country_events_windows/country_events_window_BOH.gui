				on_start = "[GetVariableSystem.Clear('ce_filter_mode')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_slug')]"
				on_start = "[GetVariableSystem.Clear('ce_selected_event_viewer')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_age_icon')]"
					on_start = "[GetVariableSystem.Clear('ce_selected_event_native_effects')]"
