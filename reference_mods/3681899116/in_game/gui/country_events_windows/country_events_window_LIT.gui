				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_6_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_6_title_loc')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_7_effect')]"
				on_input_action_shortcut = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}

			widget = {
