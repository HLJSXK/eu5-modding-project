					on_start = "[GetVariableSystem.Clear('ce_selected_event_option_7_title_loc')]"
			}
		}

		widget = {
			visible = "[And3(IsPlayerValid, GetVariableSystem.Exists('ce_window_open'), GetVariableSystem.Exists('ce_open_tag'))]"
