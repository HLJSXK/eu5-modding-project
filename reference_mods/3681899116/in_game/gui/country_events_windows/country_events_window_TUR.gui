									onclick = "[GetVariableSystem.Set('ce_selected_event_age_icon', 'gfx/interface/icons/age/age_6_revolutions.dds')]"
									onclick = "[GetVariableSystem.Set('ce_selected_event_native_effects', '1')]"
									onclick = "[GetVariableSystem.Set('ce_selected_event_immediate_effect', 'ce_flavor_tur_181_immediate')]"
									onclick = "[GetVariableSystem.Set('ce_selected_event_has_option_effects', '1')]"
									onclick = "[GetVariableSystem.Set('ce_selected_event_option_0_title_loc', 'COUNTRY_EVENTS_AUTO_FLAVOR_TUR_181_OPTION_0_TITLE')]"
