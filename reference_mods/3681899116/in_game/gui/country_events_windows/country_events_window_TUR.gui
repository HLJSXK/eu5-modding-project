									onclick = "[GetVariableSystem.Set('ce_selected_event_option_1_effect', 'ce_flavor_tur_181_option_1')]"
									down = "[GetVariableSystem.HasValue('ce_selected_event_slug', 'FLAVOR_TUR_181')]"
