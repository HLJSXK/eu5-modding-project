					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 4
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						widget = { size = { 34 30 } tooltip = "amber" text_single = { size = { 100% 100% } align = center raw_text = "@amber!" } text_single = { size = { 100% 100% } align = center raw_text = "@trigger_no!" fontsize = 23 visible = "[Not(GreaterThan_CFixedPoint(GetVariableFromGlobalVariableMap('sol_market_consumes_amber', Location.GetMarket.MakeScope).GetValue,'(CFixedPoint)0'))]" } }
