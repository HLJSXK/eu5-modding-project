						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_savings')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_savings')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_savings')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_savings')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_tribesmen_savings')|+0]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "GLS_TT_ROW_TARGET" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_savings_target')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_savings_target')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_savings_target')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_savings_target')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_tribesmen_savings_target')|+0]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "SOL_GUI_ROW_TOTAL_SAVINGS_TARGET" }
						text_single = { min_width = 360 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_total_savings_target')|+0]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "SOL_GUI_ROW_TOTAL_SAVINGS" }
						text_single = { min_width = 360 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_total_savings')|+0]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "SOL_GUI_ROW_SAVINGS_PRESSURE" }
						text_single = { min_width = 360 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_savings_pressure_adjustment')|+=1%]" }
					}
