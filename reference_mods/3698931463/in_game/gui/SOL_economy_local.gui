template StandardofLiving_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = { name = "sol_living_standard" using = tooltip_title_icon_size texture = "gfx/interface/icons/sol/sol_living_standard.dds" texture_density = 2 }
		}
		blockoverride "title_text" { datacontext = "[Location]" text = "LOCATION_SOL_GUI_TITLE" }
		blockoverride "tooltip_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				TooltipTextBlock = { blockoverride "text" { text = "LOCATION_SOL_GUI_SUMMARY" } }

				TooltipTextBlock = { blockoverride "text" { text = "SOL_GUI_SECTION_INCOME" } }
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 2
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 raw_text = " " }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_NOBLES" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_CLERGY" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_BURGHERS" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_COMMONERS" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_TRIBESMEN" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "GLS_TT_ROW_POP" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_noble_pop_display')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_pop_display')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_pop_display')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_pop_display')|+0]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_tribesmen_pop_display')|+0]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "GLS_TT_ROW_SHARE" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_tax_share')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_tax_share')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_tax_share')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_tax_share')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_tribesmen_tax_share')|+2]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 raw_text = " " }
						text_single = { min_width = 72 align = hcenter raw_text = "+[Location.MakeScope.ScriptValue('local_commoner_share_transferred_to_nobles')|+2]" }
						text_single = { min_width = 144 align = hcenter text = "GLS_TT_OPPRESSION" }
						text_single = { min_width = 72 align = hcenter raw_text = "#R -[Location.MakeScope.ScriptValue('local_commoner_share_lost_to_nobles')|+2]#!" }
						text_single = { min_width = 72 align = hcenter raw_text = " " }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "GLS_TT_ROW_TAX_RATE" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_tax_rate')|+=1%]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_tax_rate')|+=1%]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_tax_rate')|+=1%]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_tax_rate')|+=1%]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_tribesmen_tax_rate')|+=1%]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "SOL_GUI_ROW_STRATUM_INCOME" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_nobles_income_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_clergy_income_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_burghers_income_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_commoners_income_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_tribesmen_income_display')|+2]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "SOL_GUI_ROW_BUILDING_MAINTENANCE" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_nobles_building_maintenance_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_clergy_building_maintenance_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_burghers_building_maintenance_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_commoners_building_maintenance_display')|+2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_tribesmen_building_maintenance_display')|+2]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 text = "SOL_GUI_ROW_TOTAL_INCOME" }
						text_single = { min_width = 360 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_total_income')|+2]" }
					}
				}

				TooltipTextBlock = { blockoverride "text" { text = "SOL_GUI_SECTION_SAVINGS" } }
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 2
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { min_width = 150 raw_text = " " }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_NOBLES" }
