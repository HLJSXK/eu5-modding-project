# ═══════════════════════════════════════════════════════════════════════════════
# STABILITY INVESTMENT TOOLTIP OVERRIDE
# ═══════════════════════════════════════════════════════════════════════════════
# Replaces StabilityExpenseSettingParentTooltip to append demand breakdown.
# The stability slider is NOT a MaintenanceSetting — it has its own
# dedicated template and GUI accessors (CEconomy.GetStability*).
#
# File prefixed aaa_ to win first-definition-wins template precedence.
#
# MAINTENANCE NOTE: Full copy of base game StabilityExpenseSettingParentTooltip.
# When the base game updates that template, this file must be re-synced.
# Mod additions are marked with "DMSD ADDITION" comment blocks.
#
# Data context: CEconomy (set by caller via datacontext = "[Player.GetEconomy]")
# Country scope for script values: GetPlayer.MakeScope.ScriptValue(...)

template StabilityExpenseSettingParentTooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			block "content_datacontext" {}
			text = "STABILITY_INVESTMENT_TOOLTIP_T"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				using = icon_stability
			}
		}

		blockoverride "concept_link" {
			text = [stability|E]
		}
		blockoverride "tooltip_content" {

			# ─── BEGIN BASE GAME CONTENT (unchanged) ─────────────────────────

			TooltipTextBlock = {
				block "content_datacontext" {}
				blockoverride "text" {
					text = "STABILITY_INVESTMENT_TT_TEXT"
				}
			}
			TooltipStringPairList = {
				block "content_datacontext" {}
				blockoverride "block_title" {
					text = "STABILITY_INVESTMENT_TOOLTIP"
				}
				textcontext = "[CEconomy.GetStabilityInvestmentExpenseInfo]"
			}

			# ─── END BASE GAME CONTENT ───────────────────────────────────────

			# ═════════════════════════════════════════════════════════════════
			# DMSD ADDITION: Concise demand with hover drill-downs
			# ═════════════════════════════════════════════════════════════════
			# Uses CEconomy GUI accessor for the actual slider value.
			# Hover efficiency % → per-slider breakdown sub-tooltip
			# Hover effective demand → dmsd_stab_goods_tooltip

			TooltipListBase = {
				visible = "[HasGameRuleFlag('dmsd_demand_active')]"
				block "content_datacontext" {}
				blockoverride "block_title" { raw_text = "#T Stability Investment Goods Demand#!" }

				# Uses the actual expense from the GUI — already accounts for
				# slider position, spending efficiency, and benefit capping.
				TooltipManualTableField = {
					text_single = { layoutpolicy_horizontal = expanding raw_text = "Gold Spent" }
					expand = { }
					text_single = { raw_text = "[Multiply_CFixedPoint(CEconomy.GetStabilityInvestmentExpense, '(CFixedPoint)-1')|2]@gold!" }
				}
				TooltipManualTableField = {
					text_single = { layoutpolicy_horizontal = expanding raw_text = "× Spending Efficiency" }
					expand = { }
					text_single = {
						raw_text = "[GetPlayer.MakeScope.ScriptValue('dmsd_tt_stab_efficiency_pct')|1]%"
						using = dmsd_stab_efficiency_tooltip
					}
				}
				TooltipManualTableField = {
					text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold = Effective Goods Demand#!" }
					expand = { }
					text_single = {
						raw_text = "#bold [Multiply_CFixedPoint(Multiply_CFixedPoint(CEconomy.GetStabilityInvestmentExpense, '(CFixedPoint)-1'), GetPlayer.MakeScope.ScriptValue('dmsd_tt_stab_efficiency'))|2]@gold!#!"
					}
				}
			}

			# ─── STABILITY PROXIMITY SOURCES ───
			TooltipListBase = {
				visible = "[HasGameRuleFlag('dmsd_demand_active')]"
				block "content_datacontext" {}
				blockoverride "block_title" { raw_text = "#T Demand by Proximity Source Last Month#!" }
				TooltipListScrollArea = {
					blockoverride "block_scrollarea" { maximumsize = { -1 200 } minimumsize = { -1 30 } }
					blockoverride "scrollarea_content" {
						vbox = {
							using = layoutpolicy_expanding
							datamodel = "[GetPlayer.MakeScope.GetMapKeys('dmsd_prox_stab_gold')]"
					item = {
						TooltipManualTableField = {
							datacontext = "[Scope.GetLocation]"
							icon = { size = { 20 20 } texture = "[Location.GetRankIcon]" }
							text_single = { layoutpolicy_horizontal = expanding margin_left = 3 raw_text = "[Location.GetName]" }
							expand = { }
							text_single = {
								min_width = 60
								align = right
								raw_text = "[GetPlayer.MakeScope.GetVariableFromVariableMap('dmsd_prox_stab_gold', Location.MakeScope).GetValue|2]@gold!"
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "tooltip_title" { }
										blockoverride "tooltip_content" {
											TooltipListBase = {
												blockoverride "block_title" { raw_text = "#T [Location.GetSubContinent.GetName] Stability Goods#!" }
												vbox = {
													using = layoutpolicy_expanding
													datamodel = "[GetPlayer.MakeScope.GetVariableFromVariableMap('dmsd_prox_stab_io', Location.MakeScope).GetInternationalOrganization.MakeScope.GetMapKeys('dmsd_weights')]"
													item = {
														TooltipManualTableField = {
															datacontext = "[Scope.GetGoods]"
															icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
															text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
															expand = { }
															text_single = { min_width = 40 align = right raw_text = "[Multiply_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('dmsd_prox_stab_io', Location.MakeScope).GetInternationalOrganization.MakeScope.GetVariableFromVariableMap('dmsd_weights', Goods.MakeScope).GetValue, GetPlayer.MakeScope.GetVariableFromVariableMap('dmsd_prox_stab_scale', Location.MakeScope).GetValue)|2]" }
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
					}
				}
				}
			}

			# ═════════════════════════════════════════════════════════════════
			# END DMSD ADDITION
			# ═════════════════════════════════════════════════════════════════

		}
	}
}
