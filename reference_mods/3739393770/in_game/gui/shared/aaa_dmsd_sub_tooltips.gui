# ─── Court goods breakdown ───
# Shows regional and religious goods in separate sections

# Court goods — reads IO reference from country variable set during Phase 1.
# The IO holds dmsd_weights map with the goods for the active regional variant.
# Country variable dmsd_disp_court_reg_io and dmsd_disp_court_rel_io are
# updated monthly based on capital subcontinent and religion.

template dmsd_court_goods_tooltip {
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "tooltip_title" { }
			blockoverride "tooltip_content" {
				vbox = {
					set_parent_dimension_to_minimum = height
					layoutpolicy_horizontal = expanding
					spacing = 5

					TooltipListBase = {
						blockoverride "block_title" { raw_text = "#T [GetPlayer.GetCapital.GetSubContinent.GetName] Court Goods#!" }
						vbox = {
							using = layoutpolicy_expanding
							datamodel = "[GetPlayer.MakeScope.GetVariable('dmsd_disp_court_reg_io').GetInternationalOrganization.MakeScope.GetMapKeys('dmsd_weights')]"
							item = {
								TooltipManualTableField = {
									datacontext = "[Scope.GetGoods]"
									icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
									text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
									expand = { }
									text_single = { min_width = 40 align = right raw_text = "[GetPlayer.MakeScope.GetVariable('dmsd_disp_court_reg_io').GetInternationalOrganization.MakeScope.GetVariableFromVariableMap('dmsd_weights', Scope.GetGoods.MakeScope).GetValue|2]" }
								}
							}
						}
					}

					TooltipListBase = {
						blockoverride "block_title" { raw_text = "#T [GetPlayer.GetReligion.GetGroup.GetName] Court Goods#!" }
						vbox = {
							using = layoutpolicy_expanding
							datamodel = "[GetPlayer.MakeScope.GetVariable('dmsd_disp_court_rel_io').GetInternationalOrganization.MakeScope.GetMapKeys('dmsd_weights')]"
							item = {
								TooltipManualTableField = {
									datacontext = "[Scope.GetGoods]"
									icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
									text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
									expand = { }
									text_single = { min_width = 40 align = right raw_text = "[GetPlayer.MakeScope.GetVariable('dmsd_disp_court_rel_io').GetInternationalOrganization.MakeScope.GetVariableFromVariableMap('dmsd_weights', Scope.GetGoods.MakeScope).GetValue|2]" }
								}
							}
						}
					}
				}
			}
		}
	}
}

