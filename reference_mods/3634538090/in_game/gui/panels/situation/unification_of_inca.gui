situation_panel = {

	##################################### TOP HEADER #####################################

	##################################### MAIN IMAGE #####################################

	blockoverride "situation_panel_image" {
		using = one_country_header_template
	
		blockoverride "CountryContext" {
			datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry]"
		}
		# blockoverride "history_button_anchor" {}
		blockoverride "character_portrait_anchor" {
    		parentanchor = center
		}
		blockoverride "character_religion_visibility" {
			visible = no
		}
		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}
		blockoverride "country_header_extra" {
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 10 10 }
				spacing = 8
				expand = {}
			}
		}
	}

	##################################### TAB NAME #####################################


	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content"{}

	##################################### MAIN CONTENT #####################################

	# blockoverride "action_group_header" { using = bg_geodiplo_situation_header }

	blockoverride "situation_panel_main_content" {
		# End Requirements
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "onaction_hint" {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_unification_of_inca')]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
		
		# strongest power tooltip
		situation_card_expandable = {
			blockoverride "header_icon" {
				datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry]"

				country_flag_small_plus = {
					size = { 50 30 }
				}
			}
			blockoverride "header_text" {
				margin_left = 25
				align = nobaseline
				text = "UOI_LEADER_COUNTRY"

				tooltipwidget = {
					ContextualTooltipType = {
						datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry]"
						blockoverride "title_icon" {
							country_flag_small = {
							}
						}
						blockoverride "title_text" {
							text = "UOI_LEADER_COUNTRY_SCORE_TITLE_TT"
						}
						blockoverride "concept_link" {
							text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry.GetName]"
						}
						
						blockoverride "tooltip_content" {
							datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry]"
							# TooltipStringPairList = {
							
							# 	blockoverride "block_title" {
							# 		text = "UOI_GRAPH_TITLE_TT"
							# 	}
								
							# 	textcontext = "UOI_LEADER_COUNTRY_SCORE_TT"
								
							# }
							TooltipFlavorTextBlock = {
								blockoverride "text" {
									text = "UOI_LEADER_COUNTRY_SCORE_FLAVOR_TT"
								}
							}
						}
						blockoverride "tooltip_ui_action_block" {
							TooltipUIActionBlock = {
								visible = no
								datacontext = "[ExtraTooltipInfo.GetUIAction]"
							}
						}
					}
				}
			}
			blockoverride "bottom_content" {
				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 8
					margin_right = 8

					text_single = {
						minimumsize = { 70 20 }
						align = left|nobaseline
						using = Font_Type_Headers
						autoresize = yes
						fontsize = 14
						text = "[military_strength|e]"
					}

					expand = {}

					text_single = {
						minimumsize = { 70 20 }
						align = right|nobaseline
						using = Font_Type_Headers
						autoresize = yes
						fontsize = 14
						text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry.GetMilitaryStrength|2]"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 8
					margin_right = 8

					text_single = {
						minimumsize = { 70 20 }
						align = left|nobaseline
						using = Font_Type_Headers
						autoresize = yes
						fontsize = 14
						text = "[monthly_income_trade_and_tax|e]"
					}

					expand = {}

					text_single = {
						minimumsize = { 70 20 }
						align = right|nobaseline
						using = Font_Type_Headers
						autoresize = yes
						fontsize = 14
						text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('strongest_incan').GetCountry.GetEstimatedMonthlyIncomeTradeAndTax|2]"
					}
				}
			}
		}
	}
}
