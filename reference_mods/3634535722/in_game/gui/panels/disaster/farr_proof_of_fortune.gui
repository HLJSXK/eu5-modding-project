# ============================================================
# Farr Proof of Fortune — disaster panel
#
# The four apparatus buttons (claim_sikka, claim_khutba,
# proclaim_hunt_and_nawruz, assume_padishah) render automatically
# in the base template's disaster_card_actions slot — they are
# defined in common/generic_actions/farr_proof_actions.txt and
# the engine picks them up via DisasterView.GetActions.
#
# This file's custom content is the three sustained-zone progress
# readouts that drive the resolution poll:
#
#   farr_high_months    out of 60   → Vindicated
#   farr_low_months     out of 60   → Broken-lapse
#   farr_disaster_months out of 300 → Endured
#
# Pattern cribbed from decline_of_majapahit.gui (which surfaces
# demak_progress / demak_progress_growth via the same MakeScope.
# GetVariable.GetValue path).
# ============================================================

disaster_panel = {

	##################################### TOP HEADER #####################################

	##################################### MAIN IMAGE #####################################

	##################################### TAB NAME #####################################

	blockoverride "disaster_secondary_tab" {
		margin_top = 10
		spacing = 5
		disaster_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[DisasterView.GetDisaster.GetType.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
	}

	##################################### SUBHEADER #####################################

	blockoverride "disaster_main_content_subheader" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "main_content" {

		# ---- Vindication track: high_months / 60 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "FARR_PROOF_VINDICATION_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('farr_high_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 60
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('farr_high_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 60"
					}
				}
			}
		}

		# ---- Lapse track: low_months / 60 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/rebels/fist.dds"
			}
			blockoverride "common_header_text" {
				text = "FARR_PROOF_LAPSE_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('farr_low_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 60
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('farr_low_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 60"
					}
				}
			}
		}

		# ---- Endurance track: disaster_months / 300 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "FARR_PROOF_ENDURANCE_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('farr_disaster_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 300
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('farr_disaster_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 300"
					}
				}
			}
		}
	}
}
