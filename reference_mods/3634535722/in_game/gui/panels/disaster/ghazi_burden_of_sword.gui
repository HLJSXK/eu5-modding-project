# ============================================================
# Ghazi: Burden of the Sword — disaster panel
#
# The four apparatus buttons (claim_jihad_within, claim_ribat_network,
# claim_caliphal_investiture, claim_sultan_of_ghazis) render
# automatically in the base template's disaster_card_actions slot —
# they are defined in common/generic_actions/ghazi_burden_actions.txt
# and the engine picks them up via DisasterView.GetActions.
#
# This file's custom content is the sustained-zone progress
# readouts that drive the resolution poll:
#
#   ghazi_high_months         out of 60   → Sword of Islam
#   ghazi_tier3_wins          out of 2    → Sword of Islam co-req
#   ghazi_low_months          out of 60   → Lapse / Rising
#   ghazi_designation_failures out of 2   → Rising co-req
#   ghazi_burden_months       out of 300  → Guardian
# ============================================================

disaster_panel = {

	blockoverride "disaster_secondary_tab" {
		margin_top = 10
		spacing = 5
		disaster_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[DisasterView.GetDisaster.GetType.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
	}

	blockoverride "disaster_main_content_subheader" {}

	blockoverride "main_content" {

		# ---- Sword of Islam track: high_months / 60 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "GHAZI_BURDEN_SWORD_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_high_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 60
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_high_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 60"
					}
				}
			}
		}

		# ---- Tier-3 wins co-requirement: tier3_wins / 2 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "GHAZI_BURDEN_TIER3_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_tier3_wins').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 2
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_tier3_wins').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 2"
					}
				}
			}
		}

		# ---- Lapse / Rising track: low_months / 60 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/rebels/fist.dds"
			}
			blockoverride "common_header_text" {
				text = "GHAZI_BURDEN_LAPSE_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_low_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 60
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_low_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 60"
					}
				}
			}
		}

		# ---- Rising co-requirement: designation_failures / 2 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/rebels/fist.dds"
			}
			blockoverride "common_header_text" {
				text = "GHAZI_BURDEN_FAILURES_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_designation_failures').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 2
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_designation_failures').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 2"
					}
				}
			}
		}

		# ---- Guardian track: burden_months / 300 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "GHAZI_BURDEN_GUARDIAN_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_burden_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 300
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('ghazi_burden_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 300"
					}
				}
			}
		}
	}
}
