# ============================================================
# The Two Pirs — disaster panel
#
# The five ladder actions (send_forth_the_khalifas, plant_the_seed,
# proclaim_the_mystery, spread_sayyid_genealogy, claim_of_the_age)
# render automatically in the base template's actions slot — they are
# type = disaster actions in tariqa_network_actions.txt, picked up
# via DisasterView.GetActions.
#
# This file's custom content is the passage's progress readouts,
# mirrored into country variables by the disaster's on_monthly:
#
#   two_pirs_chapters        out of 20    → the chapter census
#   two_pirs_province_share  out of 0.50  → shrine-seat province (midpoint)
#   two_pirs_area_share      out of 0.15  → the wider area (completion)
#
# The aspect pair, Known Murshid, and the legitimacy >= 50 gate show
# through the END_REQUIREMENTS expandable (GetEndConditions pulls the
# can_end custom_tooltips).
# ============================================================

disaster_panel = {

	blockoverride "disaster_secondary_tab" {
		margin_top = 10
		spacing = 5
		disaster_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[DisasterView.GetDisaster.GetType.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
	}

	blockoverride "disaster_main_content_subheader" {}

	blockoverride "main_content" {

		# ---- The chapter census: chapters / 20 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "TWO_PIRS_CHAPTERS_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						tooltip = "TWO_PIRS_CHAPTERS_TT"
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('two_pirs_chapters').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 20
						tooltip = "TWO_PIRS_CHAPTERS_TT"
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('two_pirs_chapters').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 20"
					}
				}
			}
		}

		# ---- The shrine-seat province recites: share / 0.50 (midpoint) ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "TWO_PIRS_PROVINCE_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						tooltip = "TWO_PIRS_PROVINCE_TT"
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('two_pirs_province_share').GetValue|%0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 0.5
						tooltip = "TWO_PIRS_PROVINCE_TT"
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('two_pirs_province_share').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 50%"
					}
				}
			}
		}

		# ---- The wider area recites: share / 0.15 (completion) ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "TWO_PIRS_AREA_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						tooltip = "TWO_PIRS_AREA_TT"
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('two_pirs_area_share').GetValue|%0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 0.15
						tooltip = "TWO_PIRS_AREA_TT"
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('two_pirs_area_share').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 15%"
					}
				}
			}
		}
	}
}
