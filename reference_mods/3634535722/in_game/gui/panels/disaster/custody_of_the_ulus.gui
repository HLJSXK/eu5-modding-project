# ============================================================
# The Custody of the Ulus — disaster panel
#
# Apparatus buttons render automatically via disaster_card_actions
# (common/generic_actions/custody_actions.txt).
#
# Tracks:
#   custody_rivals       — rival custodies standing (target: 0)
#   custody_sole_months  / 24  — the Kuriltai gate
#   charade_counter      / 4   — successions survived (rock bottom at 4)
# ============================================================

disaster_panel = {

	blockoverride "disaster_secondary_tab" {
		margin_top = 10
		spacing = 5
		disaster_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[DisasterView.GetDisaster.GetType.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
	}

	blockoverride "disaster_main_content_subheader" {}

	blockoverride "main_content" {

		# ---- Rival custodies standing ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/rebels/fist.dds"
			}
			blockoverride "common_header_text" {
				text = "CUSTODY_RIVALS_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('custody_rivals').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 8
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('custody_rivals').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "→ 0"
					}
				}
			}
		}

		# ---- Sole custody: months at zero rivals / 24 ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "common_header_text" {
				text = "CUSTODY_SOLE_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('custody_sole_months').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 24
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('custody_sole_months').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 24"
					}
				}
			}
		}

		# ---- The charade: successions survived / 4 (rock bottom) ----
		disaster_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/rebels/fist.dds"
			}
			blockoverride "common_header_text" {
				text = "CUSTODY_CHARADE_TRACK"
			}
			blockoverride "common_bottom_content" {
				hbox = {
					maximumsize = { -1 150 }
					margin = { 10 0 }
					spacing = 10
					layoutpolicy_horizontal = expanding

					text_single = {
						size = { 60 30 }
						autoresize = yes
						align = left|nobaseline
						text = "[DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('charade_counter').GetValue|V0]"
					}

					divider_flavor_03 = { size = { 8 -1 } }

					progressbar = {
						visible = yes
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_red_alt
						min = 0
						max = 4
						value = "[FixedPointToFloat(DisasterView.GetDisaster.GetOwner.MakeScope.GetVariable('charade_counter').GetValue)]"
						direction = horizontal
					}

					divider_flavor_03 = { size = { 8 -1 } }

					text_single = {
						size = { 40 30 }
						autoresize = yes
						align = right|nobaseline
						raw_text = "/ 4"
					}
				}
			}
		}
	}
}
