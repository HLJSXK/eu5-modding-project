# Situation panel for nd_mandate_crisis (the Mandate Crisis / dynastic cycle).
#
# Centred on the Emperor (the middle_kingdom IO leader). The situation is
# visible to the Emperor, neighbours, East-Asian countries and mandate
# challengers, so the panel keeps to neutral, perspective-agnostic content.
#
# Patterns borrowed from:
#   - the_revolution.gui (one_country_header_template anchored on a focal country)
#   - nd_dnm_reaction_of_the_reich.gui (header counters, expandable cards,
#     TooltipRequirementsList end-requirements card)
situation_panel = {

	##################################### TOP HEADER #####################################
	# Left: dynastic-cycle phase (1 = unrest, 2 = fragmentation), out of 2.
	# Right: number of breakaway warlord states released so far.

	blockoverride "situation_header_left" {
		icon = {
			size = { 32 32 }
			texture = "gfx/interface/icons/disasters/decline_of_empire.dds"
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				text = "nd_mc_phase_header"
				default_format = "#subtle_name"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				raw_text = "[GetUniqueInternationalOrganization('middle_kingdom').GetLeaderCountry.MakeScope.GetVariable('nd_mc_phase').GetValue|1] / 2"
			}
		}
		expand = {}
	}

	blockoverride "situation_header_right" {
		expand = {}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				align = right|nobaseline
				text = "nd_mc_provinces_header"
				default_format = "#subtle_name"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				align = right|nobaseline
				raw_text = "[GetUniqueInternationalOrganization('middle_kingdom').GetLeaderCountry.MakeScope.GetVariable('nd_mc_tags_released').GetValue|0]"
			}
		}
		icon = {
			size = { 32 32 }
			texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
		}
	}

	##################################### MAIN IMAGE #####################################
	# One-country header anchored on the Emperor (middle_kingdom IO leader).

	blockoverride "situation_panel_image" {
		using = one_country_header_template

		blockoverride "CountryContext" {
			datacontext = "[GetUniqueInternationalOrganization('middle_kingdom').GetLeaderCountry]"
		}
		blockoverride "character_portrait_anchor" {
			parentanchor = bottom|left
		}
		blockoverride "character_religion_visibility" {
			visible = no
		}
		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}
		blockoverride "country_header_extra" {
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 10 10 }
				spacing = 8
				expand = {}
			}
		}
	}

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {

		# CARD 1: Description (always visible).
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'mc_desc_toggled' )]"
			}
			blockoverride "header_text" {
				text = "nd_mandate_crisis"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/decline_of_empire.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					autoresize = no
					multiline = yes
					size = { 400 200 }
					text = "nd_mandate_crisis_desc"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'mc_desc_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'mc_desc_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'mc_desc_toggled' ))]"
			}
		}

		# CARD 2: The dynastic cycle -- phases and resolution paths.
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'mc_paths_toggled' )]"
			}
			blockoverride "header_text" {
				text = "nd_mc_panel_paths_header"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/decline_of_empire.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					autoresize = no
					multiline = yes
					size = { 400 260 }
					text = "nd_mc_panel_paths_body"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'mc_paths_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'mc_paths_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'mc_paths_toggled' ))]"
			}
		}

		# CARD 3: End Requirements (always visible).
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'mc_req_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'mc_req_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'mc_req_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'mc_req_toggled' ))]"
			}
		}
	}

}
