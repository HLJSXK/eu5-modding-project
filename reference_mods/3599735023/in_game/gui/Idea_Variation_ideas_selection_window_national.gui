					{										
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_nat_ideas_list_adm_4')]"
							item = {
								iv2_nat_shell_adm_4 = {}
							}
						}
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close	
			
			# Adm Sub Widget 5
			widget = {
				using = layoutpolicy_expanding			
				allow_outside = no
				using = bg_lateralview		
				visible = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat5_adm' )]"	
				
				scrollbox = {
					size = { 100% 99% }
