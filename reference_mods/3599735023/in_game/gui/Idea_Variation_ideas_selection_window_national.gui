					{										
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_nat_ideas_list_adm_5')]"
							item = {
								iv2_nat_shell_adm_5 = {}
							}	
						}	
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close	
			
			# Adm Sub Widget 6
			widget = {
				using = layoutpolicy_expanding			
				allow_outside = no
				using = bg_lateralview		
				visible = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat6_adm' )]"	
				
				scrollbox = {
					size = { 100% 99% }
					position = { 0 2 } 
					
					blockoverride "scrollbox_content"
					{										
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_nat_ideas_list_adm_6')]"
							item = {
								iv2_nat_shell_adm_6 = {}
							}	
						}	
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close	
			
		} #vbox close
		


