					blockoverride "scrollbox_content"
					{										
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_nat_ideas_list_adm_2')]"
							item = {
								iv2_nat_shell_adm_2 = {}
							}
							
						}
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close

			# Adm Sub Widget 3
			widget = {
				using = layoutpolicy_expanding			
				allow_outside = no
