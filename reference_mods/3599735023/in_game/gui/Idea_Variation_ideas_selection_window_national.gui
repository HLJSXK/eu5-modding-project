						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_nat_ideas_list_adm_3')]"
							item = {
								iv2_nat_shell_adm_3 = {}
							}
						}
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close

			# Adm Sub Widget 4
			widget = {
				using = layoutpolicy_expanding			
