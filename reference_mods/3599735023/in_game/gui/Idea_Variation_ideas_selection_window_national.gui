				using = bg_lateralview		
				visible = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat4_adm' )]"	
				
				scrollbox = {
					size = { 100% 99% }
					position = { 0 2 } 
					
