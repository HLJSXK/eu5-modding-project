##########################################################################################################################
##########################################################################################################################
####### Remove Idea Group Tooltip Templates (IV 2 Ideagroup Templates 1)
##########################################################################################################################
##########################################################################################################################

###################################################
###### Army Idea Start
###################################################

template iv_2_tooltip_template_idea_remove_army_1 {
	
	
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icon_idea_army.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}
		
		blockoverride "title_text" {
			text = "iv2_ideagroup_title_army_1"
		}
		
		blockoverride "concept_link" {
			text = "[iv2_gc_idea_groups_army|e]"
		}
	}
}

