				type iv2_ig_stats_army_19 = widget {
		datacontext = "[GetScriptedGui('iv2_gui_stat_name_army_19')]"
		visible = "[And(EqualTo_string(Scope.GetFlagName, 'iv2_stat_army_19'), GetScriptedGui('iv2_gui_stat_name_army_19').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			size = { 490 400 }
			using = layoutpolicy_expanding			
			allow_outside = no
			using = bg_lateralview
			vbox = {
				spacing = 6
				
				layoutpolicy_horizontal = expanding
				
