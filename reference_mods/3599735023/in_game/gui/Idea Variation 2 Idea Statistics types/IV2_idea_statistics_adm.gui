			size = { 490 400 }
			using = layoutpolicy_expanding			
			allow_outside = no
			using = bg_lateralview
			vbox = {
				spacing = 6
				
				layoutpolicy_horizontal = expanding
				
				hbox = {										
					
					spacing = 5
					
						text_single = {
							text = "iv2_ideagroup_title_adm_39"
							default_format = "#overview_text"
							
