##########################################################################################################################
##########################################################################################################################
####### Navy Idea Selection Window by flogi
##########################################################################################################################
##########################################################################################################################

window = {


    name = "ideas_selection_window_historic"
	
	datacontext = "[GetPlayer]"
	datacontext = "[GetVariableSystem]"
	parentanchor = center
	size = { 1350 95% } # first 1144
	alwaystransparent = yes
	
	oncreate = "[GetVariableSystem.Set( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_adm' )]"
	
###################################################
###################################################
###### Background art
###################################################
###################################################
	
	vbox = {
			using = lateralview_full_margins
	
			widget = {
                layoutpolicy_horizontal = expanding
                size = { 0 40 }
                using = bg_lateralview
				allow_outside = yes
		
				vbox = {
					block "panel_header" {}

					hbox = {
						using = layoutpolicy_expanding

						widget = {
							using = layoutpolicy_expanding
							block "panel_content" {}
						}

					}
				}
				
                # Close button
                button_close_alt = {
                    parentanchor = right|vcenter
                    position = { -10 0 }
					onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets ideas_selection_window_historic')]"
                }
            }

	
	
	
	
###################################################
###################################################
###### Panel Name
###################################################
###################################################
	
    blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text"
			{
				text = "IV2_INTERFACE_IDEAS_HISTORIC_HEADER"
			}
		}
	}
	
	header_main_tabs = {
				size = { -1 40 }
				background = {
					using = button_secondary_tab_alt_color
					using = button_main_tab_icon_texture
				}
				blockoverride "content" {
					button_secondary_tab_alt = {
						using = layoutpolicy_expanding
						text = "IV2_INTERFACE_NAT_ADM_HEADER"
						onclick = "[GetVariableSystem.Set( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_adm' )]"
						down = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_adm' )]"
						tooltipwidget = {
							using = iv2_historic_idea_tab_adm_tt
						}
					}
					button_secondary_tab_alt = {
						using = layoutpolicy_expanding
						text = "IV2_INTERFACE_NAT_DIP_HEADER"
						onclick = "[GetVariableSystem.Set( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_dip' )]"
						down = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_dip' )]"
						onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_historic_idea_dip', 'iv2_tabs_historic_idea_cat1_dip' )]"
						tooltipwidget = {
							using = iv2_historic_idea_tab_dip_tt
						}
					}

					button_secondary_tab_alt = {
						using = layoutpolicy_expanding
						text = "IV2_INTERFACE_NAT_ARMY_HEADER"
						onclick = "[GetVariableSystem.Set( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_army' )]"
						down = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_army' )]"
						tooltipwidget = {
							using = iv2_historic_idea_tab_army_tt
						}
					}
					button_secondary_tab_alt = {
						using = layoutpolicy_expanding
						text = "IV2_INTERFACE_NAT_NAVY_HEADER"
						onclick = "[GetVariableSystem.Set( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_navy' )]"
						down = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_navy' )]"
						tooltipwidget = {
							using = iv2_historic_idea_tab_navy_tt
						}
					}
				}
			}
		


###################################################
###################################################
###### Adm Idea Area Start
###################################################
###################################################
			
           
        vbox = {
			layoutpolicy_horizontal = expanding
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			visible = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_adm' )]"
							
				# Modifier Bar Adm
				iv2_mod_bar_adm = { }
				
				# Search
				iv2_search_historic_box_adm = { }
								
			widget = {
				using = layoutpolicy_expanding			
				allow_outside = no
				using = bg_lateralview		
				
				scrollbox = {
					size = { 100% 99% }
					position = { 0 2 } 
					
					blockoverride "scrollbox_content"
					{										
						
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_historic_ideas_list_adm')]"
							item = {
								iv2_historic_shell_adm = {}
							}
						}											
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close
		} #vbox close
		
###################################################
###################################################
###### Dip Idea Area Start
###################################################
###################################################
			
           
	vbox = {
		layoutpolicy_horizontal = expanding
		using = layoutpolicy_expanding
		using = bg_main_inner_alt
		visible = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_dip' )]"
								
				# Dip Modifier Bar
				iv2_mod_bar_dip = { }
				
				# Search
				iv2_search_historic_box_dip = { }								
			
			# Dip Widget 1
			widget = {
				using = layoutpolicy_expanding			
				allow_outside = no
				using = bg_lateralview		
				
				scrollbox = {
					size = { 100% 99% }
					position = { 0 2 } 
					
					blockoverride "scrollbox_content"
					{										
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_historic_ideas_list_dip')]"
							item = {
								iv2_historic_shell_dip = {}
							}
						}											
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close
			
		} #vbox close
		
###################################################
###################################################
###### Army Idea Area Start
###################################################
###################################################
			
           
	vbox = {
		layoutpolicy_horizontal = expanding
		using = layoutpolicy_expanding
		using = bg_main_inner_alt
		visible = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_army' )]"
		
		# Army Stat Bar
		iv2_mod_bar_army = { }
		
		# Search
		iv2_search_historic_box_army = { }
				
		widget = {
				using = layoutpolicy_expanding			
				allow_outside = no
				using = bg_lateralview		
				
				scrollbox = {
					size = { 100% 99% }
					position = { 0 2 } 
					
					blockoverride "scrollbox_content"
					{										
						
						fixedgridbox = {
							flipdirection = yes
							datamodel_wrap = 4
							maxhorizontalslots = 4
							addcolumn = 335 #286
							addrow = 88 #78
							setitemsizefromcell = yes
							datamodel = "[Player.MakeScope.GetList('iv2_historic_ideas_list_army')]"
							item = {
								iv2_historic_shell_army = {}
							}
							
						}											
					} # Scrollbox Content							
				} # Scrollbox
			} # widget close		
	}
		
###################################################
###################################################
###### Navy Idea Area Start
###################################################
###################################################
			
           
	vbox = {
		layoutpolicy_horizontal = expanding
		using = layoutpolicy_expanding
		using = bg_main_inner_alt
		visible = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_navy' )]"
		
		# Navy Stat Bar
		iv2_mod_bar_navy = { }
		
		# Search
		iv2_search_historic_box_navy = { }
		
		
		widget = {
			using = layoutpolicy_expanding			
			allow_outside = no
			using = bg_lateralview		
			
			scrollbox = {
				size = { 100% 99% }
				position = { 0 2 } 
				
				blockoverride "scrollbox_content"
				{										
					
					fixedgridbox = {
						flipdirection = yes
						datamodel_wrap = 4
						maxhorizontalslots = 4
						addcolumn = 335 #286
						addrow = 88 #78
						setitemsizefromcell = yes
						datamodel = "[Player.MakeScope.GetList('iv2_historic_ideas_list_navy')]"
						item = {
							iv2_historic_shell_navy = {}
						}
						
					}											
				} # Scrollbox Content							
			} # Scrollbox
		} # widget close		
	}
	

	}	# Vbox	close
	
} # window close


