##########################################################################################################################
##########################################################################################################################
####### Ideagroup Select Buttons by flogi
##########################################################################################################################
##########################################################################################################################

types iv2_select_ig_buttons { 
	type iv2_select_adm_ig_button = container { 
		button = {
				size = { 390 120 } #400
				position = { 20 0 }
				#margin_left = 20
				
				onclick = "[ExecuteConsoleCommand('GUI.CreateWidget gui/Idea_Variation_ideas_selection_window_adm.gui ideas_selection_window_adm')]" 
				
				tooltip = "IV2_PICK_NEW_IDEAGROUP_TOOLTIP"
				
				icon = {
					size = { 395 120 }
					parentanchor = center
					texture = "gfx/interface/ideaView_free_slot_button.dds"
					texture_density = 2
				}
			}
		icon = {
			size = { 45 45 }
			
			position = { 10 0 }
			parentanchor = center
			texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
			
			texture_density = 2

			modify_texture = {
				using = color_new_gold_texture
				blend_mode = add
			}

			glow = {
				name = "drop_shadow"
				glow_radius = 3
				color = {0.0 0.0 0.0 1.0}
				alpha = 0.8
			}
		}
	}
	
	type iv2_select_dip_ig_button = container { 
