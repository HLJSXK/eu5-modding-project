	type iv2_ig_adm_54 = container { 	
		visible = "[EqualTo_string(Scope.GetFlagName, 'iv2_adm_54')]"

		# Background Template
		icon = {
			size = { 390 120 }
			position = { 10 0 }
			parentanchor = center
			texture = "gfx/interface/iv2_idea_group_template_with_scrollbar.dds"
		}
						
		# Idea Group Name		
		text_single = {
			text = "iv2_ideagroup_title_adm_54"
			position = { 170 14 }
			minimumsize = { 115 20 }
			maximumsize = { 150 20 }
			default_format = "#overview_text"
			align = left|nobaseline
			
			tooltipwidget = {
						using = iv2_ideagroup_tt_adm_54
			}
			
		}		
				
		# Idea Group Icon		
		icon = {
			size = { 52 52 }
			position = { -135 -5 }
			parentanchor = center
			texture = "gfx/interface/icons/ideagroups/ig_icon_adm_54.dds"

			tooltipwidget = {
				using = iv2_ideagroup_tt_adm_54
			}
		}	

		icon = {
			name = "frame"
			datacontext = "[GetScriptedGui('iv2_gui_ideagroup_adm_54_no_scrollbar')]"
			visible = "[GetScriptedGui('iv2_gui_ideagroup_adm_54_no_scrollbar').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					
			size = { 282 16 }	
			texture = "gfx/interface/progressbar_frame_iv2_3.dds"
			spriteType = Corneredstretched
			parentanchor = center
			position = { 44 30 }
			
			using = button_panel_tab_icon_effect
			
			tooltipwidget = {
				using = iv_scrollbar_adm_ideagroup_tooltip_template
			}
					 
		 }
							
		progressbar = {
			datacontext = "[GetScriptedGui('iv2_gui_ideagroup_adm_54_no_scrollbar')]"
			visible = "[GetScriptedGui('iv2_gui_ideagroup_adm_54_no_scrollbar').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			
			size = { 275 10 }
			position = { 105 86 }
			using = progress_bar_blue_grey_alt
			min = 0
			max = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_idea_cost_adm').GetValue)]"
			value = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_innovation_points_adm').GetValue)]"
			noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
			block "progress_setup" {}
			
			tooltipwidget = {
				using = iv_scrollbar_adm_ideagroup_tooltip_template
				}							
		}
									
		# Remove Idea Group Icon
		card_header_action_button_04 = {
			size = { 25 25 }
