				parameter_name = "target"
				parameter_value = "[Country]"
			}
			
			
			left_click_and_hold_action = { action_name = "iv2_ga_deselect_ideagroup_adm_54" }
			
			tooltipwidget = {
					using = iv_2_tooltip_template_idea_remove_adm_54
			}
			
			icon = {
				size = { 25 25 }
				parentanchor = center
				texture = "gfx/interface/buttons/flats/close_button.dds"
				texture_density = 2

				using = button_panel_tab_icon_effect
				
				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			
			}
		}				
		
