											noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
											block "progress_setup" {}
										}
									}
									icon = {
										size = { 24 24 }
										texture = "gfx/interface/icon_innovation_points_max_dip.dds"
										texture_density = 2
									}
									expand = {}
								}
								
								stat_player = {
									name = "iv2_stat_innovation_army"
									using = layoutpolicy_expanding
