									}
									
									vbox = {
										hbox = {
											margin = { 5 0 }
											text_single = {
												text = "IV2_IDEA_STATBAR_PROGRESS_ADM"
											}
										}
										progressbar = {
											size = { 100 8 }
											using = progress_bar_goldish
											min = 0
											max = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_progress_points_limit').GetValue)]"
										   
