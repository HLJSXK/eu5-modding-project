###################################################
###### Reload GUI
###################################################
###################################################
								
								widget = {
									size = { 50 50 }
									hbox = {									
										OneOrSeveralTimedModifiers = {
											datacontext = "[Player.GetTimedModifierOwner]"
										}

									}
								}
								
								button_default = {							
									datacontext = "[GetScriptedGui('iv2_get_debug_event')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer .MakeScope ).End )]"
									visible = "[InDebugMode]"
									
									size = { 30 40 }
									
									tooltipwidget = {
										using = iv2_debug_button_tt
									}
									
									hbox = {
										text_single = {
											name = "event_debug_button"
											text = "IV_DEBUG_GUI_TEXT"
										}
									}
								}
								
								button_default = {							
									datacontext = "[GetScriptedGui('iv2_gui_reload_gui_all')]"
									
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer .MakeScope ).End )]"
									
									onrightclick = "[ExecuteConsoleCommand('debug_mode')]"
									size = { 90 40 }
									
									tooltipwidget = {
										using = iv2_reload_gui_tt
									}
									
									hbox = {
