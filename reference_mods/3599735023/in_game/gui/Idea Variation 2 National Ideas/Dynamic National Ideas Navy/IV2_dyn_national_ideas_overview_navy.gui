##########################################################################################################################
##########################################################################################################################
####### Admin National Idea by flogi
##########################################################################################################################
##########################################################################################################################

types iv2_nat_ideas_navy_all { 
	
	type iv2_nat_idea_navy_1 = widget {
        visible = "[EqualTo_string(Scope.GetFlagName, 'iv2_nat_navy_1')]"
	    position = { 5 5 }
		size = { 335 78 }
		
		icon = {			
			texture = "gfx/interface/iv2_glow_frame.dds"
            size = { 350 96 }
			position = { -12 -7 }
			texture_density = 2
			alpha = 0.8
			visible = "[And3(GetVariableSystem.Exists('iv2_search_nat_idea_navy'), Not(StringIsEmpty(GetVariableSystem.Get('iv2_search_nat_idea_navy'))), StringContains(GetModifier('national_idea_modifier_navy_1').GetDesc, GetVariableSystem.Get('iv2_search_nat_idea_navy')))]"
        }
		
		card_header_action_button_04 = {
		size = { 325 78 }
				position = { 0 0 }
				actor = "[Player]"
				parameter = {
					parameter_name = "target"
					parameter_value = "[Country]"
				}						
				left_click_and_hold_action = { action_name = "iv2_ga_select_national_idea_navy_1" }
				
				tooltipwidget = {
						using = iv_2_tooltip_template_nat_idea_navy_1
				}
				
				icon = {
					size = { 335 86 }
					parentanchor = center
					texture = "gfx/interface/national_idea_selection_button.dds"
				}
				
				scrollarea = {
				size = { 325 65 }
				using = agenda_scrollarea_setup
				
				scrollwidget = {
					vbox = {
						hbox = {
							text_single = {
								using = layoutpolicy_expanding
								autoresize = yes
								fontsize = 13
								maximumsize = { 309 30 }
								default_format = "#explanation_link_overview"
								text = "[GetModifier('national_idea_modifier_navy_1').GetName]"
							}	
						}
						text_single = {
							using = layoutpolicy_expanding
							autoresize = yes
							fontsize = 13
							maximumsize = { 309 -1 }
							default_format = "#overview_text"
							text = "[GetModifier('national_idea_modifier_navy_1').GetDesc]"
						}					
					}
				}
			}		
		}						
	}
 
