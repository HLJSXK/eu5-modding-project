##########################################################################################################################
##########################################################################################################################
####### Basic Setup National Idea by flogi
##########################################################################################################################
##########################################################################################################################

types iv2_historic_ideas_setup { 
	
	type iv2_historic_idea_setup_add_idea = button { 	
		datacontext = "[GetScriptedGui('iv2_sgui_open_historic_national_ideas')]"		
		size = { 400 120 }
		parentanchor = bottom|hcenter
		visible = "[GetScriptedGui('iv2_sgui_open_historic_national_ideas').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		onclick = "[ExecuteConsoleCommand('GUI.CreateWidget gui/Idea_Variation_ideas_selection_window_national_historic.gui ideas_selection_window_historic')]" 
		
		onclick = "[GetVariableSystem.Set( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_adm' )]"
		
		down = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_historic', 'iv2_tabs_historic_idea_adm' )]"		
		
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer .MakeScope ).End )]"
		
		tooltip = "IV2_PICK_NEW_HISTORIC_NAT_IDEA_TOOLTIP"
		
		icon = {
			size = { 400 120 }
			parentanchor = center
			texture = "gfx/interface/ideaView_free_slot_button.dds"
			texture_density = 2
		}
			icon = {
				size = { 55 55 }
				
				position = { -30 5 }
				parentanchor = center
				texture = "gfx/interface/icons/national_ideas/icon_national_ideas.dds"
				
				texture_density = 2

				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			}
			
			icon = {
				size = { 55 55 }
				position = { 30 0 }
				parentanchor = center
				texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
				
				texture_density = 2

				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			}
	}
	
###################################################
###### Modifier Bar Adm
###################################################
	
	type iv2_mod_bar_historic_adm = hbox { 
		layoutpolicy_horizontal = expanding
		maximumsize = { -1 -1 }

		widget = {
			size = { 50 50 }
			
			background = {
				using = color_dark_blue_texture
				
			}
			layoutpolicy_horizontal = expanding
			
			hbox = {
				background = {
					using = color_dark_blue_texture
				}	
				
				stat_player = {
					name = "iv2_stat_innovation_adm"
					using = layoutpolicy_expanding
					margin = { 5 0 }
					maximumsize = { 100 -1 }
					
					tooltipwidget = {
					using = iv_scrollbar_adm_tooltip_template
					}

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icon_innovation_points_adm.dds"
						texture_density = 2
					}
					
					
					vbox = {
						hbox = {
							margin = { 5 0 }
							text_single = {
								name = "iv2_text"
								text = "IV2_IDEA_STATBAR_INNOVATION_ADM"
							}
						}
						progressbar = {
							size = { 120 8 }
							using = progress_bar_blue_grey_alt
							min = 0
							max = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_innovation_points_limit_adm').GetValue)]"
						   
							value = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_innovation_points_adm').GetValue)]"
							noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
							block "progress_setup" {}											
						}
					}
					
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icon_innovation_points_max_adm.dds"
						texture_density = 2
					}
					
					
					expand = {}
				}
				
				stat_player = {
					name = "iv2_stat_progress_adm"
					using = layoutpolicy_expanding
					margin = { 5 0 }
					maximumsize = { 90 -1 }
					
					tooltipwidget = {
					using = iv_stat_progress_adm_tooltip_template
					}
					
					
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/modifier_types/icon_progress_adm.dds"
						texture_density = 2
					}
					
					vbox = {
						hbox = {
							margin = { 5 0 }
							text_single = {
								text = "IV2_IDEA_STATBAR_PROGRESS_ADM"
							}
						}
						progressbar = {
							size = { 90 8 }
							using = progress_bar_goldish
							min = 0
							max = 1000
						   
							value = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_progress_points_adm').GetValue)]"
							noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
							block "progress_setup" {}																				
						}
					}
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/modifier_types/icon_progress_adm.dds"
						texture_density = 2
					}
					expand = {}
				}
				
				stat_player = {
					name = "iv2_stat_historic_cost_adm"
					using = layoutpolicy_expanding
					margin = { 15 0 }
					maximumsize = { 40 -1 }
					
					tooltipwidget = {
					using = iv2_national_ideas_adm_stat_bar_tt
					}

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/national_ideas/icon_national_ideas_adm.dds"
						texture_density = 2
					}
					
					hbox = {
						margin = { 5 0 }
						text_single = {
							name = "iv2_text"
							text = "IV2_IDEA_STATBAR_NAT_ADM"
						}
					}								
					expand = {}
				}							
				
				stat_player = {
					name = "iv2_stat_historic_cost_adm_2"
					using = layoutpolicy_expanding
					margin = { 15 0 }
					maximumsize = { 40 -1 }
					
					tooltipwidget = {
					using = iv2_national_ideas_adm_stat_2_bar_tt
					}

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icon_innovation_points_adm.dds"
						texture_density = 2
					}
					
					hbox = {
						margin = { 5 0 }
						text_single = {
							name = "iv2_text"
							text = "IV2_IDEA_STATBAR_2_NAT_ADM"
						}
					}								
					expand = {}
				}								
				
				expand = {}
			
			}				
		}
	}
	
