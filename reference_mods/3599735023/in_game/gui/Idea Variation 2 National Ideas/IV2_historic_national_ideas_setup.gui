	type iv2_search_historic_box_adm = hbox { 
		layoutpolicy_horizontal = expanding
		margin = { 6 4 }

		editbox_single = {
			name = "iv2_historic_search_nat_adm_editbox"
			layoutpolicy_horizontal = expanding
			focuspolicy = all
			alwaystransparent = no
			multiline = no
			text = ""
			blockoverride "editbox_properties" {
				ontextchanged = "[GetVariableSystem.Set('iv2_search_historic_idea_adm', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
				ontextedited = "[GetVariableSystem.Set('iv2_search_historic_idea_adm', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
			}
			blockoverride "editbox_label" {
				text = "IV2_SEARCH_PLACEHOLDER"
			}
		}
	}	

	
