						texture = "gfx/interface/icon_innovation_points_army.dds"
						texture_density = 2
					}
					
					hbox = {
						margin = { 5 0 }
						text_single = {
							name = "iv2_text"
							text = "IV2_IDEA_STATBAR_2_NAT_ARMY"
						}
					}								
					expand = {}
				}									
				expand = {}
			}				
		}
	}

###################################################
###### Modifier Bar Navy
###################################################
	
	type iv2_mod_bar_navy = hbox { 
		layoutpolicy_horizontal = expanding
		maximumsize = { -1 -1 }

		widget = {
			size = { 50 50 }
			
			background = {
				using = color_dark_blue_texture
				
			}
			layoutpolicy_horizontal = expanding
			
			hbox = {
				background = {
					using = color_dark_blue_texture
				}	
				
				stat_player = {
					name = "iv2_stat_innovation_navy"
					using = layoutpolicy_expanding
					margin = { 5 0 }
					maximumsize = { 100 -1 }
					
					tooltipwidget = {
					using = iv_scrollbar_navy_tooltip_template
					}

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icon_innovation_points_navy.dds"
						texture_density = 2
					}
					
					
					vbox = {
						hbox = {
							margin = { 5 0 }
							text_single = {
								name = "iv2_text"
								text = "IV2_IDEA_STATBAR_INNOVATION_NAVY"
							}
						}
						progressbar = {
							size = { 120 8 }
							using = progress_bar_blue_grey_alt
							min = 0
							max = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_innovation_points_limit_navy').GetValue)]"
						   
							value = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_innovation_points_navy').GetValue)]"
							noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
							block "progress_setup" {}											
						}
					}
					
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icon_innovation_points_max_navy.dds"
						texture_density = 2
					}
					
					
					expand = {}
				}
				
				stat_player = {
					name = "iv2_stat_progress_navy"
					using = layoutpolicy_expanding
					margin = { 5 0 }
					maximumsize = { 90 -1 }
					
					tooltipwidget = {
					using = iv_stat_progress_navy_tooltip_template
					}
					
					
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/modifier_types/icon_progress_navy.dds"
						texture_density = 2
					}
					
					vbox = {
						hbox = {
							margin = { 5 0 }
							text_single = {
								text = "IV2_IDEA_STATBAR_PROGRESS_NAVY"
							}
						}
						progressbar = {
							size = { 90 8 }
							using = progress_bar_goldish
							min = 0
							max = 1000
						   
							value = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_progress_points_navy').GetValue)]"
							noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
							block "progress_setup" {}																				
						}
					}
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/modifier_types/icon_progress_navy.dds"
						texture_density = 2
					}
					expand = {}
				}
				
				stat_player = {
					name = "iv2_stat_nat_cost_navy"
					using = layoutpolicy_expanding
					margin = { 15 0 }
					maximumsize = { 40 -1 }
					
					tooltipwidget = {
					using = iv2_national_ideas_navy_stat_bar_tt
					}

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/national_ideas/icon_national_ideas_navy.dds"
						texture_density = 2
					}
					
					hbox = {
						margin = { 5 0 }
						text_single = {
							name = "iv2_text"
							text = "IV2_IDEA_STATBAR_NAT_NAVY"
						}
					}								
					expand = {}
				}							
				
				stat_player = {
					name = "iv2_stat_nat_cost_navy_2"
					using = layoutpolicy_expanding
					margin = { 15 0 }
					maximumsize = { 40 -1 }
					
					tooltipwidget = {
					using = iv2_national_ideas_navy_stat_2_bar_tt
					}

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icon_innovation_points_navy.dds"
						texture_density = 2
					}
					
					hbox = {
						margin = { 5 0 }
						text_single = {
							name = "iv2_text"
							text = "IV2_IDEA_STATBAR_2_NAT_NAVY"
						}
					}								
					expand = {}
				}									
				expand = {}
			}				
		}
	}	
	
	type iv2_search_box_adm = hbox { 
		layoutpolicy_horizontal = expanding
		margin = { 6 4 }

		editbox_single = {
			name = "iv2_dynamic_search_nat_adm_editbox"
			layoutpolicy_horizontal = expanding
			focuspolicy = all
			alwaystransparent = no
			multiline = no
			text = ""
			blockoverride "editbox_properties" {
				ontextchanged = "[GetVariableSystem.Set('iv2_search_nat_idea_adm', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
				ontextedited = "[GetVariableSystem.Set('iv2_search_nat_idea_adm', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
			}
			blockoverride "editbox_label" {
				text = "IV2_SEARCH_PLACEHOLDER"
			}
		}
	}	

	
