##########################################################################################################################
##########################################################################################################################
####### Basic Setup National Idea by flogi
##########################################################################################################################
##########################################################################################################################

types iv2_nat_ideas_setup { 
	
	type iv2_nat_idea_setup_add_idea = button { 	
		datacontext = "[GetScriptedGui('iv2_sgui_open_dynamic_national_ideas')]"		
		size = { 400 120 }
		parentanchor = bottom|hcenter
		visible = "[GetScriptedGui('iv2_sgui_open_dynamic_national_ideas').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		onclick = "[ExecuteConsoleCommand('GUI.CreateWidget gui/Idea_Variation_ideas_selection_window_national.gui ideas_selection_window_national')]" 
		
		onclick = "[GetVariableSystem.Set( 'iv2_var_system_tabs_nat', 'iv2_tabs_nat_idea_adm' )]"
		onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat1_adm' )]"
		
		down = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_nat', 'iv2_tabs_nat_idea_adm' )]"		
		
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer .MakeScope ).End )]"
		
		tooltip = "IV2_PICK_NEW_DYN_NAT_IDEA_TOOLTIP"
		
		icon = {
			size = { 400 120 }
			parentanchor = center
			texture = "gfx/interface/ideaView_free_slot_button.dds"
			texture_density = 2
		}
			icon = {
				size = { 55 55 }
				
				position = { -30 5 }
				parentanchor = center
				texture = "gfx/interface/icons/national_ideas/icon_national_ideas_dynamic.dds"
				
				texture_density = 2

				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			}
			
			icon = {
				size = { 55 55 }
				position = { 30 0 }
				parentanchor = center
				texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
				
				texture_density = 2

				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			}
	}
	
	type iv2_nat_idea_new_idea = card_header_action_button_04 {
		size = { 120 120 }
		parentanchor = top|right
		
		actor = "[Player]"
		parameter = {
			parameter_name = "target"
			parameter_value = "[Country]"
		}
		
		left_click_and_hold_action = { action_name = "iv2_ga_add_national_idea_slot" }											
		
		tooltipwidget = {
			using = iv_2_tooltip_template_add_national_idea
			blockoverride "tooltip_content" {
				using = action_tooltip_inner_content
			}
		}
		
		hbox = {
			position = { -5 1 }
			margin = { 20 0 }
			icon = {
				size = { 28 28 }
				texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
				texture_density = 2

				using = button_panel_tab_icon_effect

				modify_texture = {
				using = color_new_gold_texture
				blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			
			}
			
			icon = {
				size = { 28 28 }
				texture = "gfx/interface/icons/national_ideas/icon_national_ideas_limit.dds"
				texture_density = 2
				using = button_panel_tab_icon_effect
			}
		}
	}
	
	type iv2_nat_idea_secondary_cat_adm = header_secondary_tabs {
		visible = "[GetVariableSystem.HasValue( 'iv2_var_system_tabs_nat', 'iv2_tabs_nat_idea_adm' )]"
	
		size = { -1 40 }
		background = {
			using = button_secondary_tab_alt_color
			using = button_main_tab_icon_texture
		}
		blockoverride "content" {
			button_secondary_tab_alt = {
				using = layoutpolicy_expanding
				text = "IV2_INTERFACE_NAT_CAT1_ADM_HEADER"
				onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat1_adm' )]"
				down = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat1_adm' )]"
				tooltipwidget = {
					using = iv2_nat_idea_subtab_adm_1
				}
			}
			button_secondary_tab_alt = {
				using = layoutpolicy_expanding
				text = "IV2_INTERFACE_NAT_CAT2_ADM_HEADER"
				onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat2_adm' )]"
				down = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat2_adm' )]"
				tooltipwidget = {
					using = iv2_nat_idea_subtab_adm_2
				}
			}

			button_secondary_tab_alt = {
				using = layoutpolicy_expanding
				text = "IV2_INTERFACE_NAT_CAT3_ADM_HEADER"
				onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat3_adm' )]"
				down = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat3_adm' )]"
				tooltipwidget = {
					using = iv2_nat_idea_subtab_adm_3
				}
			}
			button_secondary_tab_alt = {
				using = layoutpolicy_expanding
				text = "IV2_INTERFACE_NAT_CAT4_ADM_HEADER"
				onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat4_adm' )]"
				down = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat4_adm' )]"
				tooltipwidget = {
					using = iv2_nat_idea_subtab_adm_4
				}
			}
			button_secondary_tab_alt = {
				using = layoutpolicy_expanding
				text = "IV2_INTERFACE_NAT_CAT5_ADM_HEADER"
				onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat5_adm' )]"
				down = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat5_adm' )]"
				tooltipwidget = {
					using = iv2_nat_idea_subtab_adm_5
				}
			}
			button_secondary_tab_alt = {
				using = layoutpolicy_expanding
				text = "IV2_INTERFACE_NAT_CAT6_ADM_HEADER"
				onclick = "[GetVariableSystem.Set( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat6_adm' )]"
				down = "[GetVariableSystem.HasValue( 'iv2_tabs_sub_nat_idea_adm', 'iv2_tabs_nat_idea_cat6_adm' )]"
				tooltipwidget = {
					using = iv2_nat_idea_subtab_adm_6
				}
			}
		}
	}
	
	type iv2_nat_idea_secondary_cat_dip = header_secondary_tabs {
			
