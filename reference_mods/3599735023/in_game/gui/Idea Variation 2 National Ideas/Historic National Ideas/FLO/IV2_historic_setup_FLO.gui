####### FLOtille National Ideas Setup by flogi
##########################################################################################################################
##########################################################################################################################

template iv2_FLO_flag_tt {
	
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
			size = { 48 36 }
			texture = "gfx/interface/coa/FLO.dds"
			}
		}
		
		blockoverride "title_text" {
			text = "iv2_hist_idea_flag_tt_title_FLO"
		}
		
		blockoverride "concept_link" {
			text = "[iv2_gc_national_ideas|e]"
		}
		
		blockoverride "tooltip_content" {
			
			TooltipTextBlock = {
			name = "DescriptionTest"
				blockoverride "text" {
					text = "iv2_hist_idea_flag_tt_desc_FLO"
				}
			}
		}
	}
}
