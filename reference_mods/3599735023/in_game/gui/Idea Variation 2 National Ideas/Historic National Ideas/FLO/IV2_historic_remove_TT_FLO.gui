##########################################################################################################################
##########################################################################################################################
####### FLOtille National Ideas Remove TT by flogi
##########################################################################################################################
##########################################################################################################################

##########################################
##########################################
####### Adm Part
##########################################
##########################################

template iv2_historic_idea_remove_FLO_1 {
	
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetModifier('national_idea_modifier_FLO_1').GetIcon]"
			}
		}

		blockoverride "title_text" {
			text = "iv2_ga_deselect_historic_FLO_1"
		}

		blockoverride "tooltip_content" {
			
			TooltipTextBlock = {
			name = "DescriptionTest"
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_FLO_1').GetDesc))]"
				blockoverride "text" {
					text = "iv2_tt_give_up_nat_idea_adm"
				}
			}					
		}	
	}
}

