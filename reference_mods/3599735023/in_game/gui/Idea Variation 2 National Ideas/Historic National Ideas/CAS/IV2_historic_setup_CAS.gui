####### Castille National Ideas Setup by flogi
##########################################################################################################################
##########################################################################################################################

template iv2_CAS_flag_tt {
	
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
			size = { 48 36 }
			texture = "gfx/interface/coa/CAS.dds"
			texture_density = 2
			}
		}
		
		blockoverride "title_text" {
			text = "iv2_hist_idea_flag_tt_title_CAS"
		}
		
		blockoverride "concept_link" {
			text = "[iv2_gc_national_ideas|e]"
		}
		
		blockoverride "tooltip_content" {
			
			TooltipTextBlock = {
			name = "DescriptionTest"
				blockoverride "text" {
					text = "iv2_hist_idea_flag_tt_desc_CAS"
				}
			}
		}
	}
}
