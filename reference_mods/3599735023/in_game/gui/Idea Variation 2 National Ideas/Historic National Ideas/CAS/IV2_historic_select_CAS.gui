####### Adm Castille National Ideas by flogi
##########################################################################################################################
##########################################################################################################################

types iv2_historic_idea_CAS_select_adm { 
	
	type iv2_historic_idea_select_CAS_1 = widget {
        visible = "[EqualTo_string(Scope.GetFlagName, 'iv2_nat_CAS_1')]"
	    position = { 5 5 }
		size = { 335 78 }
		
		icon = {			
			texture = "gfx/interface/iv2_glow_frame.dds"
            size = { 350 96 }
			position = { -12 -7 }
			texture_density = 2
			alpha = 0.8
			visible = "[And3(GetVariableSystem.Exists('iv2_search_historic_idea_adm'), Not(StringIsEmpty(GetVariableSystem.Get('iv2_search_historic_idea_adm'))), StringContains(GetModifier('national_idea_modifier_CAS_1').GetDesc, GetVariableSystem.Get('iv2_search_historic_idea_adm')))]"
        }
		
		
		card_header_action_button_04 = {
		size = { 325 78 }
				position = { 0 0 }
				actor = "[Player]"
				parameter = {
					parameter_name = "target"
					parameter_value = "[Country]"
				}						
				left_click_and_hold_action = { action_name = "iv2_ga_select_historic_CAS_1" }
				
				tooltipwidget = {
						using = iv_2_historic_idea_select_tt_CAS_1
				}
				
				icon = {
					size = { 335 86 }
					parentanchor = center
					texture = "gfx/interface/national_idea_selection_button.dds"
				}
				
				scrollarea = {
				size = { 325 65 }
				using = agenda_scrollarea_setup
				
				scrollwidget = {
					vbox = {
						hbox = {
							text_single = {
								using = layoutpolicy_expanding
								autoresize = yes
								fontsize = 13
								maximumsize = { 309 30 }
								default_format = "#explanation_link_overview"
								text = "[GetModifier('national_idea_modifier_CAS_1').GetName]"
							}	
						}
						text_single = {
							using = layoutpolicy_expanding
							autoresize = yes
							fontsize = 13
							maximumsize = { 309 -1 }
							default_format = "#overview_text"
							text = "[GetModifier('national_idea_modifier_CAS_1').GetDesc]"
						}					
					}
				}
			}		
		}
		
		icon = {
			size = { 36 24 }
			parentanchor = right
			position = { -12 0 }
			texture = "gfx/interface/coa/CAS.dds"
			texture_density = 2
			tooltipwidget = {
				using = iv2_CAS_flag_tt
			}
		}
		icon = {
			size = { 36 24 }
			parentanchor = right
			position = { -12 0 }
			texture = "gfx/interface/component_decoration/flag_frames/frame_180x120.dds"
			texture_density = 2
		}
	}
	
