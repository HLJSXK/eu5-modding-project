template iv_2_historic_idea_select_tt_BYZ_1 {
	
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
			size = { 48 48 }
			texture = "gfx/interface/icon_idea_adm.dds"
			}
		}
		
		blockoverride "title_text" {
			text = "STATIC_MODIFIER_NAME_national_idea_modifier_BYZ_1"
		}
		
		blockoverride "concept_link" {
			text = "[iv2_gc_national_ideas|e]"
		}
		
		blockoverride "tooltip_content" {
			
			TooltipTextBlock = {
			name = "DescriptionTest"
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_BYZ_1').GetDesc))]"
				blockoverride "text" {
					text = "iv2_ga_select_historic_BYZ_1_desc"
				}
			}
			
			TooltipFlavorTextBlock = {
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_BYZ_1').GetDesc))]"
				blockoverride "text" {
					text = "[GetModifier('national_idea_modifier_BYZ_1').GetDesc]"
				}
			}
		}
	}
}

