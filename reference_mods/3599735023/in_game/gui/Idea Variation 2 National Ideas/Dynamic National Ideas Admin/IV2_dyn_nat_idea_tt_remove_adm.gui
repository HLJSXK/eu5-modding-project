##########################################################################################################################
##########################################################################################################################
####### National Idea remove tooltip Template flogi 
##########################################################################################################################
##########################################################################################################################

template iv2_individual_nat_idea_remove_adm_1 {
	
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetModifier('national_idea_modifier_adm_1').GetIcon]"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "iv2_ga_deselect_nat_idea_adm_1"
		}

		blockoverride "tooltip_content" {
			
			TooltipTextBlock = {
			name = "DescriptionTest"
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_adm_1').GetDesc))]"
				blockoverride "text" {
					text = "iv2_tt_give_up_nat_idea_adm"
				}
			}					
		}	
	}
}

