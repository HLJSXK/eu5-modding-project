			TooltipTextBlock = {
			name = "DescriptionTest"
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_adm_197').GetDesc))]"
				blockoverride "text" {
					text = "iv2_ga_select_national_idea_adm_197_desc"
				}
			}
			
			TooltipFlavorTextBlock = {
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_adm_197').GetDesc))]"
				blockoverride "text" {
					text = "[GetModifier('national_idea_modifier_adm_197').GetDesc]"
				}
			}
			
		}
	}
}
