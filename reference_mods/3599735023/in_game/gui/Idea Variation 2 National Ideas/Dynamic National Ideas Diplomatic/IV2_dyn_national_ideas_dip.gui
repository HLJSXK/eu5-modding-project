types iv2_nat_ideas_see_dip { 
	
	type iv2_nat_idea_see_dip_1 = widget { 	
		visible = "[EqualTo_string(Scope.GetFlagName, 'iv2_picked_nat_idea_dip_1')]"
		size = { 200 250 }
		position = { 0 0 }
		
		icon = {
			position = { 2 0 }
			size = { 200 200 }
			parentanchor = top|hcenter
			texture = "gfx/interface/iv2_national_idea_frame_2.dds"
		}
		
		icon = {
			position = { 0 195 }
			size = { 188 50 }
			parentanchor = top|hcenter
			texture = "gfx/interface/iv2_national_idea_down_frame.dds"
		}
		
		# Remove button
		card_header_action_button_04 = {
			size = { 25 25 }
			position = { 160 208 }
			
