template government_topbuttons_extra {
	widget = {
		parentanchor = vcenter
		size = { 40 40 }
		position = { 30 0 }

		button_automation_shortcut = {
			parentanchor = vcenter
			size = { 25 25 }

			action_tooltip = {
				title = "OPEN_AUTOMATION_PANEL_FILTER"
				on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_government')]"
			}

			tooltipwidget = { BasicFunctionalTooltip = {} }
		}
	}

	#EVENTS
	widget = {
		parentanchor = vcenter
		size = { 40 40 }
		position = { 60 0 }

		button_round_shortcut = {
			parentanchor = vcenter
			size = { 25 25 }

			visible = "[IsInmersionModeDisabled]"
			enabled = "[HasDHEEvents(Player.Self)]"

			blockoverride "button_texture" {
				texture = "gfx/interface/buttons/flats/rulinghistory.dds"
				texture_density = 2
			}

			action_tooltip = {
				enabled = "[HasDHEEvents(Player.Self)]"
				title = "DHE_HISTORICAL_EVENTS_BUTTON"
				on_action = "[ShowDHEHistoryForCountry(Player.Self)]"
			}
		}
	}

	#RULING HISTORY
	widget = {
		parentanchor = vcenter
		size = { 40 40 }
		position = { 90 0 }

		button_round_shortcut = {
			parentanchor = vcenter
			size = { 25 25 }

			blockoverride "button_texture" {
				texture = "gfx/interface/buttons/flats/historical_events.dds"
				texture_density = 2
			}

			action_tooltip = {
				title = "RULING_HISTORY"
				on_action = "[ShowRulingHistoryForCountry(Player.Self)]"
			}
		}
	}
}
