template bg_circle_piechart {
	background = {
		using = bg_round_button_alt_texture
		margin = {2 2}
		margin_bottom = 3
		modify_texture = {
			using = color_dark_blue_texture
			blend_mode = multiply
		}
		block "bg_circle_piechart_shadow" {}
	}

	background = {
		using = bg_round_button_alt_texture
		margin = {2 2}
		block "frame_color" {
			modify_texture = {
				using = color_bronze_texture
				blend_mode = multiply
			}
			modify_texture = {
				using = color_gold_texture
				alpha = 0.3
			}
		}
	}

	background = {
		using = bg_button_flat_texture
		margin = {1 1}
		block "inside_color" {
			modify_texture = {
				using = color_bg_blue_texture
				blend_mode = multiply
			}
		}

		modify_texture = {
			using = overlay_paper_03
		}
	}
}
