template societal_values {
	widget = {
		size = { 100% 100% }

		onmousehierarchyenter = "[SetSelectedSocietalValue(SocietalValueItem.GetType.Self)]"
		onmousehierarchyleave = "[ClearSelectedSocietalValue]"
		onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('societal_value')]"

		tooltipwidget = {
			using = SocietalValueItem_tooltip
		}

		vbox = {
			alwaystransparent = no
			layoutpolicy_horizontal = expanding

			# TOP WIDGETS
			widget = {
				size = { 470 45 }
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				# SOCIETAL ILLUSTRATIONS
				vbox = {

					hbox = {
						margin_left = 10
						margin_right = 10
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						# LEFT ILLUSTRATION

						widget = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							icon = {
								size = { 100% 100% }
								using = color_black_texture

								modify_texture = {
									using = color_white_texture
									alpha = 0.1
								}
							}

							icon = {
								size = { 100% 100% }
								texture = "[SocietalValueItem.GetType.GetLeftIllustration]"
								alpha = 0.4
								enabled = "[Not(GreaterThan_float(SocietalValueItem.GetPosition, '(float)0'))]"
							}
							icon = {
								size = { 100% 100% }
								texture = "[SocietalValueItem.GetType.GetLeftIllustration]"
								visible = "[Not(GreaterThan_float(SocietalValueItem.GetPosition, '(float)0'))]"
								alpha = 0.5

								modify_texture = {
									texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
									blend_mode = alphamultiply
								}
							}
						}

						widget = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							icon = {
								size = { 100% 100% }
								using = color_black_texture

								modify_texture = {
									using = color_white_texture
									alpha = 0.1
								}
							}

							icon = {
								size = { 100% 100% }
								texture = "[SocietalValueItem.GetType.GetRightIllustration]"
								alpha = 0.4
								enabled = "[GreaterThan_float(SocietalValueItem.GetPosition, '(float)0')]"
							}
							icon = {
								size = { 100% 100% }
								texture = "[SocietalValueItem.GetType.GetRightIllustration]"
								visible = "[GreaterThan_float(SocietalValueItem.GetPosition, '(float)0')]"
								alpha = 0.5

								modify_texture = {
									mirror = horizontal
									texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
									blend_mode = alphamultiply
								}
							}
						}
					}
				}

				widget = {
					size = { 100% 100% }
					layoutpolicy_vertical = expanding

					using = bg_cabinet_card_frame
					blockoverride "cabinet_card_frame_extra" {
						margin = {-8 2}
						margin_bottom = 4
					}
					blockoverride "cabinet_card_shadow" {
						alpha = 0
					}
				}

				# FRONT WIDGETS
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin_bottom = -7
					expand = {}

					hbox = {
						layoutpolicy_horizontal = expanding

						hbox = {
							button_societal_flag = {
								visible = "[And(SocietalValueItem.GetCountry.IsPlayer, Not(GreaterThan_float(SocietalValueItem.GetPosition, '(float)0')))]"
								blockoverride "extra_on_click" { onclick = "[SocietalValuesLateralView.SetClickedSocietalValueItem(SocietalValueItem.Self, '(bool)yes')]" }
								blockoverride "round_button" {
									modify_texture = {
										using = color_progress_blue_texture
										alpha = 0.75
									}
								}
								blockoverride "encourage_enabled" { enabled = "[SocietalValueItem.IsEncourageLeftEnabled]" }
								blockoverride "encourage_title" { title = "[SocietalValueItem.GetEncourageLeftTitle]" }
								blockoverride "encourage_description" { description = "[SocietalValueItem.GetEncourageLeftDescription]" }
								blockoverride "encourage_on_action" { on_action_with_params = "[SocietalValueItem.OnEncourageLeft]" }
							}

							button_societal_flag = {
								blockoverride "enabled" {}
								visible = "[And(SocietalValueItem.GetCountry.IsPlayer, GreaterThan_float(SocietalValueItem.GetPosition, '(float)0'))]"

								blockoverride "texture" {
									texture = "gfx/interface/component_tiles/society_values/society_values_banner_idle2.dds"
								}
								blockoverride "alpha" {
									alpha = 0.6
								}
								blockoverride "extra_on_click" { onclick = "[SocietalValuesLateralView.SetClickedSocietalValueItem(SocietalValueItem.Self, '(bool)yes')]" }
								blockoverride "encourage_enabled" { enabled = "[SocietalValueItem.IsEncourageLeftEnabled]" }
								blockoverride "encourage_title" { title = "[SocietalValueItem.GetEncourageLeftTitle]" }
								blockoverride "encourage_description" { description = "[SocietalValueItem.GetEncourageLeftDescription]" }
								blockoverride "encourage_on_action" { on_action_with_params = "[SocietalValueItem.OnEncourageLeft]" }
							}
						}

						expand = {}

						hbox = {
							blockoverride "left" {
								righttoleft = yes
							}
							blockoverride "align" {
								align = right|nobaseline
							}
							blockoverride "text" {
								text = "[SocietalValueItem.GetType.GetRightLabelWithNoTooltip]"
							}
							blockoverride "icon" {
								texture = "[SocietalValueItem.GetType.GetRightIcon]"
							}

							button_societal_flag = {
								visible = "[And(SocietalValueItem.GetCountry.IsPlayer, GreaterThan_float(SocietalValueItem.GetPosition, '(float)0'))]"

								blockoverride "texture" {
									texture = "gfx/interface/component_tiles/society_values/society_values_banner_right.dds"
								}
								blockoverride "tooltip" {
									tooltipwidget = {
										using = SocietalValueItemRight_tooltip
									}
								}
								blockoverride "icon_tooltip" {
									tooltipwidget = {
										using = SocietalValueItemRight_tooltip
									}
								}
								blockoverride "extra_on_click" { onclick = "[SocietalValuesLateralView.SetClickedSocietalValueItem(SocietalValueItem.Self, '(bool)no')]" }
								blockoverride "round_button" {
									modify_texture = {
										using = color_progress_blue_texture
										alpha = 0.75
									}
								}
								blockoverride "encourage_enabled" { enabled = "[SocietalValueItem.IsEncourageRightEnabled]" }
								blockoverride "encourage_title" { title = "[SocietalValueItem.GetEncourageRightTitle]" }
								blockoverride "encourage_description" { description = "[SocietalValueItem.GetEncourageRightDescription]" }
								blockoverride "encourage_on_action" { on_action_with_params = "[SocietalValueItem.OnEncourageRight]" }
							}

							button_societal_flag = {
								blockoverride "enabled" {}
								visible = "[And(SocietalValueItem.GetCountry.IsPlayer, Not(GreaterThan_float(SocietalValueItem.GetPosition, '(float)0')))]"

								blockoverride "texture" {
									texture = "gfx/interface/component_tiles/society_values/society_values_banner_idle2_right.dds"
								}
								blockoverride "alpha" {
									alpha = 0.6
								}
								blockoverride "tooltip" {
									tooltipwidget = {
										using = SocietalValueItemRight_tooltip
									}
								}
								blockoverride "icon_tooltip" {
									tooltipwidget = {
										using = SocietalValueItemRight_tooltip
									}
								}
								blockoverride "extra_on_click" { onclick = "[SocietalValuesLateralView.SetClickedSocietalValueItem(SocietalValueItem.Self, '(bool)no')]" }
								blockoverride "encourage_enabled" { enabled = "[SocietalValueItem.IsEncourageRightEnabled]" }
								blockoverride "encourage_title" { title = "[SocietalValueItem.GetEncourageRightTitle]" }
								blockoverride "encourage_description" { description = "[SocietalValueItem.GetEncourageRightDescription]" }
								blockoverride "encourage_on_action" { on_action_with_params = "[SocietalValueItem.OnEncourageRight]" }
							}
						}
					}
				}
			}

			# BOTTOM WIDGETS
			widget = {
				layoutpolicy_horizontal = expanding
				size = { 0 4 }
				allow_outside = yes
				# visible = no

				# PROGRESS BAR
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 53 0 }

					expand = {}

					hbox = {
						layoutpolicy_horizontal = expanding
						using = bg_cabinet_card_frame
						blockoverride "cabinet_card_frame_extra" {
							margin = {2 2}
						}
						blockoverride "cabinet_card_shadow" {
							alpha = 0
						}
						# LEFT HALF
						widget = {
							layoutpolicy_horizontal = expanding
							size = { 0 6 }

							progressbar_framed = {
								visible = "[LessThan_float(SocietalValueItem.GetInertiaCap, '(float)0')]"
								size = { 100% 100% }
								using = progressbar_bar_small
								progresstexture = "gfx/interface/progressbars/progress_bar_purple.dds"
								noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
								value = "[SocietalValueItem.GetInertiaCapWeight]"
								invertprogress = yes
							}

							progressbar_framed = {
								size = { 100% 100% }
								using = progressbar_bar_small
								using = progress_bar_blue_alt_left
								noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
								spriteborder = { 12 0 }
								value = "[Abs_float(Min_float(SocietalValueItem.GetPosition, '(float)0'))]"
								invertprogress = yes
							}


							hbox = {
								layoutpolicy_horizontal = expanding
								size = { 100% 100% }
								visible = "[LessThan_float(SocietalValueItem.GetInertiaCap, '(float)0')]"

								widget = {
									layoutpolicy_horizontal = expanding
									layoutstretchfactor_horizontal = "[SocietalValueItem.GetInertiaCapRemainderWeight]"
								}
								widget = {
									size = { 0 6 }
									layoutpolicy_vertical = expanding
									progressbar_center_divider = {
										parentanchor = center
										ignore_layout = yes
										modify_texture = {
											visible = "[Not(GreaterThan_float(Abs_float(Min_float(SocietalValueItem.GetPosition, '(float)0')), Abs_float(Min_float(SocietalValueItem.GetInertiaCap, '(float)0'))))]"
											using = color_white_texture
											blend_mode = overlay
											alpha = 0.6
										}
									}
								}
								widget = {
									layoutpolicy_horizontal = expanding
									layoutstretchfactor_horizontal = "[SocietalValueItem.GetInertiaCapWeight]"
								}
							}

						}

						widget = {
							size = {50 6}
						}

						# RIGHT HALF
						widget = {
							layoutpolicy_horizontal = expanding
							size = { 0 6 }

							progressbar_framed = {
								visible = "[Not(LessThan_float(SocietalValueItem.GetInertiaCap, '(float)0'))]"
								size = { 100% 100% }
								using = progressbar_bar_small
								progresstexture = "gfx/interface/progressbars/progress_bar_purple.dds"
								noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
								value = "[SocietalValueItem.GetInertiaCapWeight]"
							}

							progressbar_framed = {
								size = { 100% 100% }
								using = progressbar_bar_small
								using = progress_bar_blue_alt
								noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
								spriteborder = { 12 0 }
								value = "[Abs_float(Max_float(SocietalValueItem.GetPosition, '(float)0'))]"
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								size = { 100% 100% }
								visible = "[Not(LessThan_float(SocietalValueItem.GetInertiaCap, '(float)0'))]"

								widget = {
									layoutpolicy_horizontal = expanding
									layoutstretchfactor_horizontal = "[SocietalValueItem.GetInertiaCapWeight]"
								}
								widget = {
									size = { 0 6 }
									layoutpolicy_vertical = expanding
									progressbar_center_divider = {
										parentanchor = center
										ignore_layout = yes
										modify_texture = {
											visible = "[Not(GreaterThan_float(Abs_float(Max_float(SocietalValueItem.GetPosition, '(float)0')), Abs_float(Max_float(SocietalValueItem.GetInertiaCap, '(float)0'))))]"
											using = color_white_texture
											blend_mode = overlay
											alpha = 0.6
										}
									}
								}
								widget = {
									layoutpolicy_horizontal = expanding
									layoutstretchfactor_horizontal = "[SocietalValueItem.GetInertiaCapRemainderWeight]"
								}
							}

						}
					}

					expand = {}
				}

				widget = {
					size = { 60 20 }
					position = {0 -7 }
					parentanchor = hcenter

					background = {
						texture = "gfx/interface/component_tiles/society_values/middle_detail.dds"

						modify_texture = {
							using = color_wood_brown_texture
							blend_mode = multiply
						}
						modify_texture = {
							using = overlay_wood_texture
							blend_mode = overlay
						}
					}

					hbox = {
						margin_left = 4
						margin_right = 4
						spacing = 1

						icon = {
							visible = "[LessThan_float(SocietalValueItem.GetEncouragedDirection, '(float)0')]"
							size = { 10 10 }

							texture = "gfx/interface/icons/government_society/progress_arrow_flavor.dds"
							spriteType = stretched
							spriteborder = { 0 0 }
							framesize = { 32 32 }
							texture_density = 2

							mirror = horizontal

							modify_texture = {
								using = color_light_green_texture
								alpha = 1
							}
						}

						progress_arrow_flavor = {
							visible = "[Not(LessThan_float(SocietalValueItem.GetEncouragedDirection, '(float)0'))]"
							name = "left"
							size = { 12 12 }

							down = "[And(LessThan_float(SocietalValueItem.GetInertiaCap, SocietalValueItem.GetPosition), LessThan_float(SocietalValueItem.GetDirection, '(float)0'))]"
							mirror = horizontal

							modify_texture = {
								visible = "[And(LessThan_float(SocietalValueItem.GetPosition, SocietalValueItem.GetInertiaCap), LessThan_float(SocietalValueItem.GetDirection, '(float)0'))]"
								using = color_black_texture
								alpha = 1
								blend_mode = multiply
							}

							modify_texture = {
								visible = "[And(LessThan_float(SocietalValueItem.GetPosition, SocietalValueItem.GetInertiaCap), LessThan_float(SocietalValueItem.GetDirection, '(float)0'))]"
								using = color_progress_blue_texture
								alpha = 1
								blend_mode = add
							}
						}

						text_single = {
							autoresize = yes
							# size = { 40 -1 }
							fontsize = 12
							align = center|nobaseline
							text = "[Abs_float(SocietalValueItem.GetDirection)|2]"

						}

						icon = {
							visible = "[GreaterThan_float(SocietalValueItem.GetEncouragedDirection, '(float)0')]"
							size = { 10 10 }

							texture = "gfx/interface/icons/government_society/progress_arrow_flavor.dds"
							spriteType = stretched
							spriteborder = { 0 0 }
							framesize = { 32 32 }
							texture_density = 2

							modify_texture = {
								using = color_light_green_texture
								alpha = 1
							}
						}

						progress_arrow_flavor = {
							visible = "[Not(GreaterThan_float(SocietalValueItem.GetEncouragedDirection, '(float)0'))]"
							name = "right"
							size = { 12 12 }

							down = "[And(GreaterThan_float(SocietalValueItem.GetInertiaCap, SocietalValueItem.GetPosition), GreaterThan_float(SocietalValueItem.GetDirection, '(float)0'))]"

							modify_texture = {
								visible = "[And(GreaterThan_float(SocietalValueItem.GetPosition, SocietalValueItem.GetInertiaCap), GreaterThan_float(SocietalValueItem.GetDirection, '(float)0'))]"
								using = color_black_texture
								alpha = 1
								blend_mode = multiply
							}

							modify_texture = {
								visible = "[And(GreaterThan_float(SocietalValueItem.GetPosition, SocietalValueItem.GetInertiaCap), GreaterThan_float(SocietalValueItem.GetDirection, '(float)0'))]"
								using = color_progress_blue_texture
								alpha = 1
								blend_mode = add
							}
						}
					}
				}
			}
		}
	}
}
