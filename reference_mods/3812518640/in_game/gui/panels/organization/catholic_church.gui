	blockoverride "io_decoration" {
		allow_outside = yes
		alwaystransparent = yes
		icon = {
			size = {570 264}
			alwaystransparent = yes
			texture = "gfx/interface/component_decoration/ios/catholic_church/catholic_church_overview_decor.dds"
			texture_density = 2
			spriteType = corneredstretched
			parentanchor = hcenter|top
			position = {0 -40}
		}
