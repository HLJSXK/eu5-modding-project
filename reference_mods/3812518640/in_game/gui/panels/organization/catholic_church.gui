																		parameter_value_bool = no
																	}
																}

																button_tooltip_override = {
																	description = "[ResolutionGlue.GetEnactResolution.GetBasicTooltip]"
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "[Select_CString(PdxGuiWidget.HasTooltipMetaTitle, PdxGuiWidget.GetTooltipMetaTitle, UIAction.GetTitle)]"
																		}

																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				name = "DescriptionTest"
																				visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
																				blockoverride "text" { text = "[UIAction.GetDescription]" }
																			}
																			TooltipTextBlock = {
																				blockoverride "text" {
																					text = "vote_in_election_no"
																				}
																				blockoverride "textblock_background_tint"  {
																					modify_texture = {
																						using = color_red_texture
																					}
																				}
																			}
																		}
																	}
																}
															}

															background = {
																visible = "[ResolutionGlue.HasCountryForSecondPossible(Player.Self)]"
																using = color_mid_red_texture
																alpha = 0.5
															}
														}

														tooltipmeta = {
															texture = "gfx/interface/icons/alerts_icons/active_io_resolution.dds"
														}
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														minimumsize = { 280 40 }
														maximumsize = { 280 40 }
														margin = {7 5}
														spacing = 5
														visible = "[And(Or3(EqualTo_string(Localize('excommunicate_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip),
														EqualTo_string(Localize('call_crusade'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip),
														EqualTo_string(Localize('western_schism_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip)),
														Not(ResolutionGlue.EnactResolutionIsActive))]"

														button_regular_diamond = {
															layoutpolicy_horizontal = expanding
															size = { -1 30 }

															text = "target_vote_in_election"

															name = "resolution activate button"

															visible = "[PdxGuiWidget.IsUberButtonVisible]"
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipmeta = {
																title = "[ResolutionGlue.GetEnactResolution.GetName]"
															}

															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
																proposer = "[ResolutionGlue.GetProposer]"
																actor = "[InternationalOrganizationsView.GetPlayer]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
																}
																parameter = {
