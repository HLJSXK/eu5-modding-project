organization_religious_theme = {
	blockoverride "ios_variable_tooltip" {
		tooltipwidget = {
			using = PapalAuthorityVariableTooltip
		}
	}

	blockoverride "ios_information_header_order" {
		hbox = {
			margin_left = 8
			using = organization_piechart_template
			blockoverride "organization_piechart_size" { size = { 25 25 } }
			blockoverride "organization_piechart_value"
			{
				value = "[Subtract_float(FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(MonthlySavedVariable.GetTag)),FixedPointToFloat(MonthlySavedVariable.GetMin))]"
			}
			blockoverride "organization_piechart_max_value"
			{
				value = "[Subtract_float(FixedPointToFloat(MonthlySavedVariable.GetMax), FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(MonthlySavedVariable.GetTag)))]"
			}
			blockoverride "organization_piechart_icon"
			{
				texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableIcon(MonthlySavedVariable.Self)]"
			}
		}
		text_single = {
			autoresize = yes
			align = left
			margin_left = 8
			text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText(MonthlySavedVariable.Self)]"
		}
	}

	blockoverride "io_decoration_behind_character" {
		allow_outside = yes
		widget = {
			allow_outside = yes
			ignore_layout = yes
			position = { 252 74 }

			visible = "[GreaterThan_int32(GetDataModelSize(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables), '(int32)0' )]"

			using = layoutpolicy_expanding
			datamodel = "[DataModelFirst(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables, '(int32)1')]"
			item = {
				vbox = {
					block "ios_info_header_left_item_visible" {}
					using = layoutpolicy_expanding
					tooltipwidget = {
						using = IOVariableTooltip
					}
					background = {
						margin_top = 12
						margin_right = 5
						margin_left = 5
						margin_bottom = 4
						mirror = vertical
						texture = "gfx/interface/component_decoration/ios/hre/bg_icon_vertical.dds"
						texture_density = 2
						spriteType = stretched
					}

					text_single = {
						autoresize = yes
						minimumsize = { 35 21 }
						maximumsize = { 35 21 }
						align = center
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText(MonthlySavedVariable.Self)]"
					}
					hbox = {
						using = organization_piechart_template
						blockoverride "organization_piechart_size" { size = { 28 28 } }
						blockoverride "organization_piechart_value"
						{
							value = "[Subtract_float(FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(MonthlySavedVariable.GetTag)),FixedPointToFloat(MonthlySavedVariable.GetMin))]"
						}
						blockoverride "organization_piechart_max_value"
						{
							value = "[Subtract_float(FixedPointToFloat(MonthlySavedVariable.GetMax), FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(MonthlySavedVariable.GetTag)))]"
						}
						blockoverride "organization_piechart_icon"
						{
							texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableIcon(MonthlySavedVariable.Self)]"
						}
					}

				}
			}
		}
	}

	blockoverride "country_header_margin"{
		margin = { 12 5 }
	}
	blockoverride "ruler_name_font_size" {
		fontsize = 15
	}
	blockoverride "extra_titles_flag_overview" {}
	blockoverride "character_label_name_extra" {
		widget = {
			size = {38 32}
			country_flag_small = {
				parentanchor = right|vcenter
				datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
			}
		}
	}
	blockoverride "ruling_history_button" {}

	blockoverride "character_widget" {
		widget = {
			position = { 50 -10 }
			allow_outside = yes

			size = { 170 180 }
			parentanchor = bottom

			portrait_standard_full_body_center_hre_button = {
				visible = yes
				parentanchor = bottom

				size = { 170 180 }
				datacontext = "[Country.GetGovernment.GetRulerOrRegent]"
			}
		}
	}

	blockoverride "ios_information_header_visible" {
		visible = no
	}

	blockoverride "organization_overview_tab_text" {
		text = "CATHOLIC_CHURCH_CURIA_TAB"
	}

	blockoverride "organization_laws_tab_text" {
		text = "DOCTRINES"
	}

	blockoverride "organization_resolutions_tab_text" {
		text = "game_concept_papal_bulls"
	}

	blockoverride "organization_resolutions_tooltip" {
		tooltipwidget = {
			ConceptTooltipType = {
				blockoverride "title_icon" {
					icon = {
						texture = "gfx/interface/icons/diplomatic_actions/papal_actions.dds"
						using = tooltip_concept_title_icon_size
					}
				}
				blockoverride "title_text" {
					block "title" {
						text = "game_concept_papal_bulls"
					}
				}
				blockoverride "tooltip_content" {
					block "tooltip" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "SUBTAB_IO_RESOLUTIONS_CATHOLIC_CHURCH_TT_TEXT"
							}
						}
					}
					# block "flavor_tooltip" {
					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "game_concept_papal_bull_desc"
						}
					}
					# }
					TooltipTextBlock = {
						visible = "[Not(InternationalOrganizationsView.HasResolutions)]"
						blockoverride "text" {
							text = "SUBTAB_IO_RESOLUTIONS_CATHOLIC_CHURCH_BLOCKED_TT_TEXT"
						}
					}
				}
			}
		}
	}

	blockoverride "organization_cardinals_tab_visible" {
		visible = no
	}

	blockoverride "organization_resolutions_tab_visible" {
		visible = yes
		enabled = "[InternationalOrganizationsView.HasResolutions]"
	}

	blockoverride "organization_resolutions_content" {
		# list of resolutions
		vbox = {
			visible = "[InternationalOrganizationsView.HasResolutions]"
			using = layoutpolicy_expanding
			margin = {0 10}

			card_actions = {
				blockoverride "card_header_text" {
					text = "CURRENT_DEBATES"
				}
				blockoverride "card_header_icon" {
					block "io_main_actions_icon" {
						texture = "[InternationalOrganization.GetIcon]"
					}
				}
				blockoverride "header_button_icon_size" { size = { 30 30 } }

				blockoverride "actions_override" {
					vbox = {
						spacing = 2
						layoutpolicy_horizontal = expanding
						scrollarea = {
							maximumsize = { 482 530 }
							scrollbarpolicy_horizontal = always_off

							autoresizescrollarea = yes

							scrollbar_vertical = {
								using = Scrollbar_Vertical
							}

							scrollwidget = {
								dynamicgridbox = {
									datamodel = "[InternationalOrganizationsView.GetResolutions]"
									item = {
										widget = {
											size = { 482 50 }
											vbox = {
												size = { 460 45 }
												hbox = {
													layoutpolicy_horizontal = expanding
													maximumsize = { 460 45}
													using = bg_paper_card
													using = bg_corner_flavor
													using = bg_cabinet_card_frame
													blockoverride "corner_flavor_texture" {
														texture = "gfx/interface/component_decoration/bg_corner_flavor_06.dds"
														texture_density = 2
														spriteType = Corneredstretched
														spriteborder = { 35 35 }
														margin = { -2 -2 }
														alpha = 0.7
													}
													blockoverride "corner_flavor_color" {
														modify_texture = {
															using = color_bg_blue_texture
															blend_mode = multiply
														}
													}

													text_single = {
														tooltipmeta = {
															texture = "[InternationalOrganization.GetIcon]"
														}
														layoutpolicy_horizontal = expanding
														margin_left = 8
														minimumsize = { 180 45 }
														maximumsize = { 180 45 }
														text = "[ResolutionGlue.GetEnactResolution.GetName]"
													}

													expand = {}
													hbox = {
														visible = "[And(And3(Not( EqualTo_string(Localize('excommunicate_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip) ),
															Not( EqualTo_string(Localize('call_crusade'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip) ),
															Not( EqualTo_string(Localize('western_schism_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip) )),
															Not(ResolutionGlue.EnactResolutionIsActive))]"
														size = { 70 -1 }
														spacing = 5
														margin_right = 7
														header_action_button_left_uber = {
															size = { 30 30 }
															blockoverride "button_icon_stretch_sprite" {}
															blockoverride "header_button_frame_inner" {visible = no}
															blockoverride "header_button_text_layout" {}

															blockoverride "icon_replace" {
																icon = {
																	size = { 22 22 }
																	position = { 4 2 }
																	texture =  "gfx/interface/icons/international_organizations/law_voting.dds"
																	texture_density = 2
																}
															}

															name = "resolution activate button"

															visible = "[PdxGuiWidget.IsUberButtonVisible]"
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

															tooltipmeta = {
																title = "[ResolutionGlue.GetEnactResolution.GetName]"
															}

															scripted_action_tooltip = {
																click_type = left
																click_mode = confirm
																action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
																proposer = "[ResolutionGlue.GetProposer]"
																actor = "[InternationalOrganizationsView.GetPlayer]"
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
																}
																parameter = {
																	parameter_name = "vote"
																	parameter_value_bool = yes
																}
															}

															button_tooltip_override = {
																description = "[ResolutionGlue.GetEnactResolution.GetBasicTooltip]"
															}

															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_text" {
																		text = "[Select_CString(PdxGuiWidget.HasTooltipMetaTitle, PdxGuiWidget.GetTooltipMetaTitle, UIAction.GetTitle)]"
																	}

																	blockoverride "tooltip_content" {
																		TooltipTextBlock = {
																			name = "DescriptionTest"
																			visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
																			blockoverride "text" { text = "[UIAction.GetDescription]" }
																		}
																		TooltipTextBlock = {
																			blockoverride "text" {
																				text = "start_vote_in_election_yes"
																			}
																			blockoverride "textblock_background_tint"  {
																				modify_texture = {
																					using = color_light_green_texture
																				}
																			}
																		}
																		# GlorpUI: Add Papal Bull Effect
																		TooltipConditionList = {
																			visible = "[Not(StringIsEmpty(ResolutionGlue.GetEnactResolution.GetSuccessEffect))]"
																			textcontext = "[ShowModifierEffect(ResolutionGlue.GetEnactResolution.GetKey)]"
																		}
																	}

																}
															}
														}
														tooltipmeta = {
															texture = "gfx/interface/icons/alerts_icons/active_io_resolution.dds"
														}
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														minimumsize = { 68 40 }
														maximumsize = { 68 40 }
														visible = "[And(EqualTo_string(Localize('excommunicate_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip),
															ResolutionGlue.EnactResolutionIsActive)]"

														character_frame_small = {
															blockoverride "character_frame_size" {
																size = { 30 35 }
															}
															blockoverride "portrait_datacontext" {
																datacontext = "[ResolutionGlue.GetTargetCountry.GetGovernment.GetRulerOrRegent]"
															}
															blockoverride "portrait_position" {position = { 0 0 }}
															blockoverride "character_portrait_visible" {
																visible = yes
															}
															blockoverride "character_portrait_ani_visible" {
																visible = no
															}
															blockoverride "character_frame_dynasty_visible" {
																visible = no
															}
															blockoverride "character_frame_estate_visible" {
																visible = no
															}
														}

														country_flag_small = {
															datacontext = "[ResolutionGlue.GetTargetCountry]"
															tooltipwidget = {
																using = CountryTooltip
															}
														}

													}

													hbox = {
														layoutpolicy_horizontal = expanding
														minimumsize = { 150 40 }
														maximumsize = { 150 40 }
														spacing = 5
														visible = "[And(Or3(EqualTo_string(Localize('excommunicate_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip),
															EqualTo_string(Localize('call_crusade'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip),
															EqualTo_string(Localize('western_schism_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip)),
															ResolutionGlue.EnactResolutionIsActive)]"

														hbox = {
															layoutpolicy_horizontal = expanding
															margin = {7 2}
															spacing = 5

															header_action_button_left_uber = {
																size = { 30 30 }
																blockoverride "button_icon_stretch_sprite" {}
																blockoverride "header_button_frame_inner" {visible = no}
																blockoverride "header_button_text_layout" {}

																blockoverride "icon_replace" {
																	icon = {
																		size = { 22 22 }
																		position = { 4 2 }
																		texture =  "gfx/interface/icons/international_organizations/law_voting_yes.dds"
																		texture_density = 2
																	}
																}

																name = "resolution activate button"

																visible = "[PdxGuiWidget.IsUberButtonVisible]"
																enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

																tooltipmeta = {
																	title = "[ResolutionGlue.GetEnactResolution.GetName]"
																}

																scripted_action_tooltip = {
																	click_type = left
																	click_mode = confirm
																	action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
																	proposer = "[ResolutionGlue.GetProposer]"
																	actor = "[InternationalOrganizationsView.GetPlayer]"
																	parameter = {
																		parameter_name = "recipient"
																		parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
																	}
																	parameter = {
																		parameter_name = "target"
																		parameter_value = "[ResolutionGlue.GetTargetCountry]"
																	}
																	parameter = {
																		parameter_name = "vote"
																		parameter_value_bool = yes
																	}
																}

																button_tooltip_override = {
																	description = "[ResolutionGlue.GetEnactResolution.GetBasicTooltip]"
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "[Select_CString(PdxGuiWidget.HasTooltipMetaTitle, PdxGuiWidget.GetTooltipMetaTitle, UIAction.GetTitle)]"
																		}

																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				name = "DescriptionTest"
																				visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
																				blockoverride "text" { text = "[UIAction.GetDescription]" }
																			}
																			TooltipTextBlock = {
																				blockoverride "text" {
																					text = "vote_in_election_yes"
																				}
																				blockoverride "textblock_background_tint"  {
																					modify_texture = {
																						using = color_light_green_texture
																					}
																				}
																			}
																		}
																	}
																}
															}

															text_single = {
																size = { 20 30 }
																autoresize = no
																text = "[ResolutionGlue.GetFirstPossibleVoteNum]"
																using = Font_Size_Medium
															}
														}

														widget = {
															allow_outside = yes
															size = { 30 30 }

															piechart = {

																size = { 30 30 }
																using = piechart_angles
																using = bg_circle_piechart

																pieslice_no_highlight = {
																	texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																	value = "[FixedPointToFloat(ResolutionGlue.GetProgressToDeadline)]"
																	color = { 0.01 0.6 0.9 1 }
																	alwaystransparent = yes
																}

																pieslice_no_highlight = {
																	texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																	value = "[Subtract_float('(float)100.0', FixedPointToFloat(ResolutionGlue.GetProgressToDeadline))]"
																	color = { 0.0 0.1 0.1 1 }
																	alwaystransparent = yes
																}

																icon = {
																	size = { 80% 80% }
																	texture = "gfx/interface/icons/text_icons/time.dds"
																	parentanchor= center
																}

																datacontext = "[ResolutionGlue.GetVoteToEnactAction]"
																tooltipwidget = {
																	using = international_organization_resolution_voting_tooltip
																}
															}
														}

														hbox = {
															layoutpolicy_horizontal = expanding
															margin = {7 2}
															spacing = 5

															text_single = {
																margin_right = 5
																size = { 20 30 }
																autoresize = no
																text = "[ResolutionGlue.GetSecondPossibleVoteNum]"
																using = Font_Size_Medium
															}

															header_action_button_left_uber = {
																size = { 30 30 }
																blockoverride "button_icon_stretch_sprite" {}
																blockoverride "header_button_frame_inner" {visible = no}
																blockoverride "header_button_text_layout" {}

																blockoverride "icon_replace" {
																	icon = {
																		size = { 22 22 }
																		position = { 4 2 }
																		texture =  "gfx/interface/icons/international_organizations/law_voting_no.dds"
																		texture_density = 2
																	}
																}

																name = "resolution activate button"

																visible = "[PdxGuiWidget.IsUberButtonVisible]"
																enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

																tooltipmeta = {
																	title = "[ResolutionGlue.GetEnactResolution.GetName]"
																}

																scripted_action_tooltip = {
																	click_type = left
																	click_mode = confirm
																	action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
																	proposer = "[ResolutionGlue.GetProposer]"
																	actor = "[InternationalOrganizationsView.GetPlayer]"
																	parameter = {
																		parameter_name = "recipient"
																		parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
																	}
																	parameter = {
																		parameter_name = "target"
																		parameter_value = "[ResolutionGlue.GetTargetCountry]"
																	}
																	parameter = {
																		parameter_name = "vote"
																		parameter_value_bool = no
																	}
																}

																button_tooltip_override = {
																	description = "[ResolutionGlue.GetEnactResolution.GetBasicTooltip]"
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "[Select_CString(PdxGuiWidget.HasTooltipMetaTitle, PdxGuiWidget.GetTooltipMetaTitle, UIAction.GetTitle)]"
																		}

																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				name = "DescriptionTest"
																				visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
																				blockoverride "text" { text = "[UIAction.GetDescription]" }
																			}
																			TooltipTextBlock = {
																				blockoverride "text" {
																					text = "vote_in_election_no"
																				}
																				blockoverride "textblock_background_tint"  {
																					modify_texture = {
																						using = color_red_texture
																					}
																				}
																			}
																		}
																	}
																}
															}
														}
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														minimumsize = { 150 40 }
														maximumsize = { 150 40 }
														spacing = 5
														visible = "[And(And3(Not( EqualTo_string(Localize('excommunicate_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip) ),
															Not( EqualTo_string(Localize('call_crusade'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip) ),
															Not( EqualTo_string(Localize('western_schism_resolution'), ResolutionGlue.GetEnactResolution.GetNameWithNoTooltip) )),
															ResolutionGlue.EnactResolutionIsActive)]"

														hbox = {
															layoutpolicy_horizontal = expanding
															margin = { 7 2 }
															spacing = 5

															header_action_button_left_uber = {
																size = { 30 30 }
																blockoverride "button_icon_stretch_sprite" {}
																blockoverride "header_button_frame_inner" {visible = no}
																blockoverride "header_button_text_layout" {}

																blockoverride "icon_replace" {
																	icon = {
																		size = { 22 22 }
																		position = { 4 2 }
																		texture =  "gfx/interface/icons/international_organizations/law_voting_yes.dds"
																		texture_density = 2
																	}
																}

																name = "resolution activate button"

																visible = "[PdxGuiWidget.IsUberButtonVisible]"
																enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

																tooltipmeta = {
																	title = "[ResolutionGlue.GetEnactResolution.GetName]"
																}

																scripted_action_tooltip = {
																	click_type = left
																	click_mode = confirm
																	action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
																	proposer = "[ResolutionGlue.GetProposer]"
																	actor = "[InternationalOrganizationsView.GetPlayer]"
																	parameter = {
																		parameter_name = "recipient"
																		parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
																	}
																	parameter = {
																		parameter_name = "vote"
																		parameter_value_bool = yes
																	}
																}

																button_tooltip_override = {
																	description = "[ResolutionGlue.GetEnactResolution.GetBasicTooltip]"
																}

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_text" {
																			text = "[Select_CString(PdxGuiWidget.HasTooltipMetaTitle, PdxGuiWidget.GetTooltipMetaTitle, UIAction.GetTitle)]"
																		}

																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				name = "DescriptionTest"
																				visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
																				blockoverride "text" { text = "[UIAction.GetDescription]" }
																			}
																			TooltipTextBlock = {
																				blockoverride "text" {
																					text = "vote_in_election_yes"
																				}
																				blockoverride "textblock_background_tint"  {
																					modify_texture = {
																						using = color_light_green_texture
																					}
																				}
																			}
																		}
																	}
																}
															}

															text_single = {
																autoresize = yes
																text = "[ResolutionGlue.GetFirstPossibleVoteNum]"
																using = Font_Size_Medium
															}

															expand = {}

															background = {
																visible = "[ResolutionGlue.HasCountryForFirstPossible(Player.Self)]"
																using = color_mid_green_texture
																alpha = 0.5
															}
														}

														widget = {
