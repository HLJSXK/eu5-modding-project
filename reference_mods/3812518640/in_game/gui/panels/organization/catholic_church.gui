														texture = "gfx/interface/icons/international_organizations/cardinals.dds"
													}
												}
											}
										}
										extra_list_vertical = {
											visible = "[GreaterThan_int32(GetDataModelSize(Country.GetCardinals), '(int32)6')]"
											blockoverride "extra_list_text_content" {
												maximumsize = {16 25}
												raw_text = "+[Subtract_int32(GetDataModelSize(Country.GetCardinals), '(int32)6')]"
											}
											blockoverride "extra_list_size"{
												size = {20 42}
											}
											tooltipwidget = {
												SimpleContextualRowTooltipType = {
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "gfx/interface/icons/international_organizations/cardinals.dds"
														}
													}
													blockoverride "concept_link" {
														text = "[cardinals|e]"
													}
													lowpriotextcontext = "[GetCardinalsTooltipGeneric(Country.Self)]"
												}
											}
										}
									}
								}
							}
						}
					}
					expand = {}
				}
			}
		}
	}
