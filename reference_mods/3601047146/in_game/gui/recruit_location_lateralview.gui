				# 			tooltipwidget = {
				# 				using = RecruitmentMethod_tooltip
				# 			}
				# 		}
				# 	}
				# }

				blockoverride "checkbox" {
					down = "[Player.AutoRaiseNavyLeviesAtWar]"
					action_tooltip = {
						title = "[SelectLocalization( Player.AutoRaiseNavyLeviesAtWar, 'TOGGLE_AUTO_RAISE_NAVY_LEVIES_AT_WAR_TOOLTIP_IS_ON', 'TOGGLE_AUTO_RAISE_NAVY_LEVIES_AT_WAR_TOOLTIP_IS_OFF' )]"
						on_action = "[ToggleAutoRaiseNavyLeviesAtWar]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }
				}

				blockoverride "header_center_checkbox_visible" {
					visible = "[RecruitInLocationLateralView.IsLevy]"
				}

				# Right Data
				blockoverride "right_widget_visible"{}

				blockoverride "right_widget_setup"{
					size = {200 40}
					parentanchor = vcenter|right
				}

				blockoverride "right_widget"{
					header_button_right = {
						visible = "[RecruitInLocationLateralView.IsLevy]"
						size = {100% 40}

						blockoverride "icon_overlay" {}

						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/unit_actions/navy_levies_rally_point.dds"
						}

						blockoverride "text_top" {
							autoresize = yes
							maximumsize = { 140 15 }
							text = "RAISE_ALL_LEVIES"
							fontsize = 13
						}

						blockoverride "text_bottom" {
							autoresize = yes
							maximumsize = { 140 15 }
							raw_text = "[RecruitInLocationLateralView.GetLeviesStrength] #G +[RecruitInLocationLateralView.GetLeviesInProgress]#! / [Player.GetNavyLevyPower]"
						}

						action_tooltip = {
							click_type = left
							click_mode = confirm
							title = "[SelectLocalization( Player.GetCapital.IsCoastal, 'RAISE_ALL_LEVIES_CAPITAL', 'RAISE_ALL_LEVIES_COAST_CAPITAL')]"
							on_action = "[RecruitInLocationLateralView.RaiseAllNavyLevies]"
							description = "[RecruitInLocationLateralView.CanRaiseAllLeviesInfo]"
							enabled = "[RecruitInLocationLateralView.CanRaiseAllLevies]"
						}

						action_tooltip = {
							click_type = right
							click_mode = single
							title = "RAISE_ALL_LEVIES_SELECT_RALLY_POINT"
							on_action = "[SelectLocationToRaiseAllNavyLevies]"
							description = "[RecruitInLocationLateralView.CanRaiseAllLeviesInfo]"
							enabled = "[RecruitInLocationLateralView.CanRaiseAllLevies]"
						}

						enabled = "[RecruitInLocationLateralView.CanRaiseAllLevies]"

						tooltipwidget = {
							BasicFunctionalTooltip = {}
						}
					}
				}
				blockoverride "right_icon_visible" {
					visible = "[Not(RecruitInLocationLateralView.IsLevy)]"
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/unit_category/regulars_navy.dds"
								}
							}

							blockoverride "concept_link" {
								raw_text = "[navy|e]"
							}

							lowpriotextcontext = "RECRUITMENT_IN_PROGRESS_NAVY_SIMPLE"

						}
					}
				}
				blockoverride "right_icon_gfx" {
					texture = "gfx/interface/icons/unit_category/regulars_navy.dds"
					texture_density = 2

					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.5
					}
				}
				blockoverride "right_2liner_text_1" {
					margin_top = 4
					text = "HIRES_IN_PROGRESS"
				}
				blockoverride "right_2liner_text_1_visible" {
					visible = "[Not(RecruitInLocationLateralView.IsLevy)]"
				}
				blockoverride "right_2liner_text_2" {
					raw_text = "[RecruitInLocationLateralView.GetNumRecruitmentInProgress|+0=]"
				}
				blockoverride "right_2liner_text_2_visible" {
					visible = "[Not(RecruitInLocationLateralView.IsLevy)]"
				}
				blockoverride "right_2liner_tooltip_for_container" {
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/unit_category/regulars_navy.dds"
								}
							}

							blockoverride "concept_link" {
								raw_text = "[navy|e]"
							}

							lowpriotextcontext = "RECRUITMENT_IN_PROGRESS_NAVY_SIMPLE"

						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				visible = "[RecruitInLocationLateralView.IsUnitTemplate]"
				datacontext = "[RecruitInLocationLateralView.GetUnitTemplate]"
				widget = {
					size = {26 74}
					header_button_left = {
						size = { 100% 100% }
						blockoverride "button_icon_stretch_sprite" {}
						blockoverride "header_button_frame_inner" {visible = no}
						blockoverride "header_button_icon_size" { size = { 26 30 } }
						blockoverride "header_button_text_layout" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/buttons/flats/button_simple_right.dds"
							texture_density = 2
							mirror = horizontal
						}

						enabled = "[RecruitInLocationLateralView.CanSelectAnotherUnitTemplate]"

						action_tooltip = {
							click_type = left
							click_mode = single
							title = "RECRUIT_IN_LOCATION_SELECT_PREV_UNIT_TEMPLATE"
							enabled = "[RecruitInLocationLateralView.CanSelectAnotherUnitTemplate]"
							conditions = "[MakeItFail(Localize('RECRUIT_IN_LOCATION_NO_MORE_UNIT_TEMPLATES'))]"
							on_action = "[RecruitInLocationLateralView.SelectPrevUnitTemplate]"
						}

						tooltipwidget = {
							BasicFunctionalTooltip = {
							}
						}
					}
				}
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 85 }
					UnitTemplateCard = {
						blockoverride "unit_template_total_cost_visible" { visible = no }
						blockoverride "unit_template_build_button" {}
					}
				}

				widget = {
					size = {26 74}
					header_button_left = {
						size = { 100% 100% }
						blockoverride "button_icon_stretch_sprite" {}
						blockoverride "header_button_frame_inner" {visible = no}
						blockoverride "header_button_icon_size" { size = { 26 30 } }
						blockoverride "header_button_text_layout" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/buttons/flats/button_simple_right.dds"
							texture_density = 2
						}

						enabled = "[RecruitInLocationLateralView.CanSelectAnotherUnitTemplate]"

						action_tooltip = {
							click_type = left
							click_mode = single
							title = "RECRUIT_IN_LOCATION_SELECT_NEXT_UNIT_TEMPLATE"
							conditions = "[MakeItFail(Localize('RECRUIT_IN_LOCATION_NO_MORE_UNIT_TEMPLATES'))]"
							enabled = "[RecruitInLocationLateralView.CanSelectAnotherUnitTemplate]"
							on_action = "[RecruitInLocationLateralView.SelectNextUnitTemplate]"
						}

						tooltipwidget = {
							BasicFunctionalTooltip = {
							}
						}
					}
				}
			}

