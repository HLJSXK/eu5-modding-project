			# Levy category icons â€” shows all levy unit categories this country can raise, with available strength
			hbox = {
				visible = "[RecruitInLocationLateralView.IsLevy]"
				layoutpolicy_horizontal = expanding
				margin = { 8 4 }

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6
					margin = { 8 6 }

					using = bg_paper_card
					using = bg_cabinet_card_frame

					text_single = {
						autoresize = yes
						using = Font_Size_Medium
						text = "LEVY_POSSIBLE_UNIT_TYPES"
					}

					expand = {}

					# Army levy categories
					flowcontainer = {
						visible = "[RecruitInLocationLateralView.IsArmy]"
						spacing = 4
						datamodel = "[RecruitInLocationLateralView.GetValidArmyLevyCategories]"
						item = {
							widget = {
								size = { 28 28 }
								using = bg_text_mask_container_brown
								icon = {
									parentanchor = center
									size = { 22 22 }
									texture = "[GetSubUnitCategoryIcon(SubUnitCategory.Self)]"
									tooltipwidget = {
										using = levy_possible_category_tt
									}
								}
							}
						}
					}

					# Navy levy categories
					flowcontainer = {
						visible = "[RecruitInLocationLateralView.IsNavy]"
						spacing = 4
						datamodel = "[RecruitInLocationLateralView.GetValidNavyLevyCategories]"
						item = {
							widget = {
								size = { 28 28 }
								using = bg_text_mask_container_brown
								icon = {
									parentanchor = center
									size = { 22 22 }
									texture = "[GetSubUnitCategoryIcon(SubUnitCategory.Self)]"
									tooltipwidget = {
										using = levy_possible_category_tt
									}
								}
							}
						}
					}
				}
			}

			vbox = {
				using = layoutpolicy_expanding

				# GlorpUI: Mass Recruiting
				widget = {
					visible = "[RecruitInLocationLateralView.IsUnitTemplate]"
					size = { 30 30 }
					using = bg_number_container_bckg
					blockoverride "number_container_extra" {
						margin = { 0 0 }
					}

				}

				filtered_sorted_list = {
					datacontext = "[RecruitInLocationLateralView.GetRecruitSortSearch]"

					blockoverride "subheader_upper_divider" { # GlorpUI: Mass Recruiting button
						hbox = {
							visible = "[And(Not(RecruitInLocationLateralView.IsUnitTemplate), Not(RecruitInLocationLateralView.IsLevy))]"
							layoutpolicy_horizontal = expanding
							margin_top = 5

							expand = {}
							header_button_right = {
								blockoverride "adjust_to_content" {
									minimumsize = { 240 40 }
									set_parent_size_to_minimum = yes
								}
								onclick = "[GetScriptedGui('EnableMassRecruiting').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								tooltip = "RECRUIT_BEST_IN_LOCATION_ACTION_BUTTON"
								blockoverride "icon_overlay" { }
								blockoverride "icon_texture" { texture = "[GetUnitIcon(RecruitInLocationLateralView.GetUnitType)]" }
								blockoverride "header_button_text_layout" {
									hbox = {
										using = layoutpolicy_expanding
										margin = { 5 0 }
										margin_left = 10

										icon = {
											size = { 25 25 }
											texture = "gfx/interface/icons/flat_icons/mass_construct.dds"
										}

										text_single = {
											fontsize = 13
											layoutpolicy_horizontal = expanding
											autoresize = no
											align = center
											size = { -1 20 }
											text = "RECRUIT_BEST_IN_LOCATION_ACTION_BUTTON"
											# visible = "[Player.MakeScope.GetVariable('massRecruiting').IsSet]"
											# text = "[Player.MakeScope.GetVariable('massRecruiting').GetValue]"
										}
									}
								}
							}
							expand = {}
							vbox = {
								# Mass Recruiter
								size = { 0 0 }
								datamodel = "[RecruitInLocationLateralView.GetItems]"
								item = {
									widget = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										# size = { -1 13 }
										visible_at_creation = no

										# first, in locations without army constructions
										visible = "[LessThan_int32(GetDataModelSize(LocationToRecruitItem.GetLocation.GetArmyConstructions), '(int32)1')]"

										# Up to the massRecruit amount
										text_single = {
											visible = "[GreaterThan_int32(FixedPointToInt(Player.MakeScope.GetVariable('massRecruiting').GetValue), PdxGuiWidget.AccessParent.GetIndexInParent)]"
											fontsize = 13
											layoutpolicy_vertical = expanding
											size = { 13 13 }

											text = "[PdxGuiWidget.GetIndexInParent]"
											using = Font_Type_Flavor
											datacontext = "[LocationToRecruitItem.GetLocation]"
											state = {
												name = _show
												on_start = "[GetScriptedGui('UpdateMassRecruiting').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												on_start = "[LocationToRecruitItem.Recruit]"
												# todo: set hasRecruited flag, if we don't set this.. we re-recruit after iterating armyconstructions counter
											}
										}

										# TODO: When all locations have unit building, we want to allow them too
									}
								}
								# Remove any unused MassRecruiting Value
								widget = {
									visible_at_creation = no
									datacontext = "[Player]"
									visible = "[Player.MakeScope.GetVariable('massRecruiting').IsSet]"
									state = {
										name = _show
										on_start = "[GetScriptedGui('ClearMassRecruiting').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
								}
							}
						}
					}

					blockoverride "sort_buttons_filtered_list" {

						sort_by_key_button = {
							name = "name"
							using = layoutpolicy_expanding
						}

						sort_by_key_button = {
							visible = "[Not(RecruitInLocationLateralView.IsUnitTemplate)]"
							name = "strength"
							size = { 100 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							visible = "[Not(RecruitInLocationLateralView.IsLevy)]"
							name = "gold"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							visible = "[And(Not(RecruitInLocationLateralView.IsLevy), Not(RecruitInLocationLateralView.IsUnitTemplate))]"
							name = "size"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							visible = "[And(RecruitInLocationLateralView.IsArmy, RecruitInLocationLateralView.IsUnitTemplate)]"
							name = "regiment_training"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							visible = "[Not(RecruitInLocationLateralView.IsArmy)]"
							name = "ships"
							size = { 70 -1 }
							layoutpolicy_vertical = expanding
						}

						sort_by_key_button = {
							visible = "[Not(RecruitInLocationLateralView.IsUnitTemplate)]"
							name = "needs"
							size = { 130 -1 }
							layoutpolicy_vertical = expanding
						}
					}

					blockoverride "scroll_list_is_empty" {
						visible = "[IsDataModelEmpty(RecruitInLocationLateralView.GetItems)]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "[RecruitInLocationLateralView.GetRecruitEmptyInfo]"
					}

					blockoverride "empty_scroll_list_layout"{
						parentanchor = hcenter
						position = { 0 130 }
						size = { 530 357 }
					}

					blockoverride "list_for_scroll_list_empty_layout" {
						fixedgridbox = {
							parentanchor = left
							size = { 100% 357 }
							addcolumn = 100%
							addrow = 45
							setitemsizefromcell = yes
							datamodel = "[RecruitInLocationLateralView.GetRecruitEmptyItems]"

							item = {
								widget = {
									size = { 470 40 }

									hbox = {
										margin = {2 1}
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										using = bg_paper_card
										using = bg_cabinet_card_frame

										widget = {
											size = { -1 40 }
											layoutpolicy_horizontal = expanding

											card_header_button_04 = {
												size = { 100% 40 }
												parentanchor = center

												action_tooltip = {
													click_type = left
													click_mode = single
													title = "BUILD_BUILDING_GENERIC"
													on_action = "[RecruitInLocationLateralView.SelectLocationToBuild(BuildingType.Self)]"
												}

												tooltipwidget = { BasicFunctionalTooltip = {}}

												background = {
													using = color_grey_texture
													margin = {-2 -1}
													alpha = 0.7
													modify_texture = {
														texture = "gfx/interface/cards/headers/header_pattern_01.dds"
														texture_density = 2
														spriteType = corneredtiled
														blend_mode = overlay
														alpha = 0.2
													}
													modify_texture = {
														color = "[BuildingType.GetPopType.GetColor]"
														blend_mode = overlay
														alpha = 0.7
													}
													modify_texture = {
														texture = "gfx/interface/component_overlay/cloth_texture.dds"
														texture_density = 2
														spriteType = Corneredtiled
														spriteborder = { 0 0 }
														blend_mode = overlay
														alpha = 0.2
													}
												}

												hbox = {
													layoutpolicy_horizontal = expanding
													ignoreinvisible = yes
													spacing = 5
													margin_left = 5
													margin_right = 5

													icon = {
														size = { 34 34 }
														texture = "[GetBuildingIcon(BuildingType.Self)]"
													}

													text_single = {
														layoutpolicy_horizontal = expanding
														autoresize = no
														size = {150 18}
														align = left|nobaseline
														text = "[BuildingType.GetName]"
													}

													ui_direction_button_alt = {
														size = {25 25}
														texture = "gfx/interface/icons/flat_icons/building_panel/build_button.dds"

														action_tooltip = {
															click_type = left
															click_mode = single
															title = "BUILD_BUILDING_GENERIC"
															on_action = "[RecruitInLocationLateralView.SelectLocationToBuild(BuildingType.Self)]"
														}

														tooltipwidget = { BasicFunctionalTooltip = {} }

														# icon = {
														# 	parentanchor = center
														# 	texture = "gfx/interface/icons/flat_icons/building_panel/build_button.dds"
														# 	size = { 85% 85% }
														# 	using = color_gold
														# }
													}
												}
											}
										}
									}
								}
							}
						}
					}

					blockoverride "scroll_list_content" {
						addcolumn = 100%
						addrow = 40
						datamodel = "[RecruitInLocationLateralView.GetItems]"
						setitemsizefromcell = yes
						datamodel_reuse_widgets = yes

						item = {
							widget = {
								widget = {
									parentanchor = center
									size = { 99% 40 }
									using = recruit_location_entry
								}
							}
						}
					}
				}
			}
		}
	}
