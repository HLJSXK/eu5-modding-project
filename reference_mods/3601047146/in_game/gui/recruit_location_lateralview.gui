				# 		button_checkbox_round_intense = {
				# 			visible = "[And(Not(RecruitInLocationLateralView.IsLevy), Not(RecruitInLocationLateralView.IsMercenary))]"
				# 			size = { 23 23 }
				# 			texture = "[GetRecruitMethodIcon(RecruitmentMethod.Self)]"
