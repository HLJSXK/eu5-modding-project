lateralview = {
	name = "country_dhe_lateralview"

	# blockoverride "panel_header" {
	# 	window_header_alt = {
	# 		blockoverride "header_text" {
	# 			max_width = 500
	# 			text = "[CountryDHEView.GetTitle]"
	# 			autoresize = yes
	# 		}
	# 	}

	# 	header_main_tabs = {
	# 		blockoverride "content" {
	# 			using = government_main_tabs
	# 		}
	# 	}
	# }

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }
			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }
				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_government')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "GOV_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_government_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = government_main_tabs
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 5
			margin_top = 2

			filtered_sorted_list = {
				datacontext = "[CountryDHEView.GetEntriesSortSearch]"

				blockoverride "sort_buttons_filtered_list" {
					sort_by_key_button = {
						name = "age"
						size = { 75 -1 }
						layoutpolicy_vertical = expanding
					}

					sort_by_key_button = {
						name = "name"
						using = layoutpolicy_expanding
					}

					sort_by_key_button = {
						name = "date"
						using = layoutpolicy_expanding
					}

					sort_by_key_button = {
						name = "status"
						size = { 90 -1 }
						layoutpolicy_vertical = expanding
					}
				}

				blockoverride "scroll_list_vbox" { # GlorpUI: added
					# margin = { 10 0 }
					using = layoutpolicy_expanding
					using = bg_secondary_inner_notabs_alt
				}

				blockoverride "scroll_list_content" {
					using = layoutpolicy_expanding # GlorpUI: added

					addcolumn = 100%
					addrow = 55 # GlorpUI: 82->55
					setitemsizefromcell = yes

					datamodel = "[CountryDHEView.GetEntries]"
					item = {
						widget = {
							hbox = {
								margin = { 0 5 }
								margin_left = 6
								margin_right = 4

								vbox = {
									using = layoutpolicy_expanding
									# GlorpUI: removed bg_paper_card

									widget = {
										using = bg_age_event_frame # GlorpUI: added
										size = { -1 40 } # GlorpUI: 36->40
										layoutpolicy_horizontal = expanding

										# Dark shadow strip at bottom of header
										background = {
											texture = "gfx/interface/colors/black.dds"
											margin = { 1 1 }
											margin_bottom = 2
											texture_density = 2
											alpha = 0.4
										}

										# Color overlay: green=happened, grey=expired, pink=pending
										background = {
											texture = "gfx/interface/colors/mid_green.dds" # GlorpUI: mid_yellow->mid_green
											# alpha = 0.45 # GlorpUI: disabled
											visible = "[DHEEventEntry.IsStatusHasHappened]"
											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay
												alpha = 0.35
											}
											modify_texture = {
												texture = "gfx/interface/component_overlay/cloth_texture.dds"
												texture_density = 2
												spriteType = Corneredtiled
												spriteborder = { 0 0 }
												blend_mode = overlay
												alpha = 0.2
											}
										}

										background = {
											texture = "gfx/interface/colors/greyish.dds"
											# alpha = 0.45 # GlorpUI: disabled
											visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay
												alpha = 0.35
											}
											modify_texture = {
												texture = "gfx/interface/component_overlay/cloth_texture.dds"
												texture_density = 2
												spriteType = Corneredtiled
												spriteborder = { 0 0 }
												blend_mode = overlay
												alpha = 0.2
											}
										}

										background = { # GlorpUI: added
											visible = "[DHEEventEntry.IsStatusNotYet]"
											texture = "gfx/interface/colors/black.dds"
											margin = { 1 1 }
											margin_bottom = 2
											texture_density = 2
											alpha = 0.4
										}
										background = {
											using = color_geopolitics_texture # GlorpUI: light_red->geopolitics color
											alpha = 0.6 # GlorpUI: 0.45->0.6
											visible = "[DHEEventEntry.IsStatusNotYet]"
											modify_texture = {
												texture = "[GetGraphicalCultureTexture('header_pattern')]"
												texture_density = 2
												spriteType = corneredtiled
												blend_mode = overlay # GlorpUI: removed alpha 0.35
											}
											modify_texture = {
												texture = "gfx/interface/component_overlay/cloth_texture.dds"
												texture_density = 2
												spriteType = Corneredtiled
												spriteborder = { 0 0 }
												blend_mode = overlay
												alpha = 0.2
											}
										}

										hbox = {
											size = { 100% 100% }
											margin = { 6 0 }
											margin_left = 64
											spacing = 5

											# Title text
											vbox = { # GlorpUI: date row merged into subtitle
												layoutpolicy_horizontal = expanding
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left|nobaseline
													using = Font_Type_Headers
													default_format = "#yellow_titles"
													text = "[DHEEventEntry.GetTitle]"
												}
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left|nobaseline
													fontsize = 12
													default_format = "#subtle_name"
													text = "[Localize('FROM_MARKET')] [DHEEventEntry.GetDateRange] | [Localize('DHE_MONTHLY_CHANCE')]"
												}
											}

											# Status icon
											icon = {
												size = { 30 30 } # GlorpUI: 25->30
												texture = "gfx/interface/icons/text_icons/dhe_status_has_happened.dds"
												visible = "[DHEEventEntry.IsStatusHasHappened]"
											}
											icon = {
												size = { 30 30 } # GlorpUI: 25->30
												texture = "gfx/interface/icons/text_icons/dhe_status_has_not_happened_yet.dds"
												visible = "[DHEEventEntry.IsStatusNotYet]"
											}
											icon = {
												size = { 30 30 } # GlorpUI: 25->30
												texture = "gfx/interface/icons/text_icons/dhe_status_time_has_passed.dds"
												visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
											}

											# Trigger result icon
											icon = {
												size = { 30 30 } # GlorpUI: 25->30
												texture = "gfx/interface/icons/text_icons/trigger_yes.dds"
												visible = "[And(DHEEventEntry.IsTriggerTrue, Not(Or(DHEEventEntry.IsStatusTimeHasPassed, DHEEventEntry.IsStatusHasHappened)))]" # GlorpUI: only while pending
											}
											icon = {
												size = { 30 30 } # GlorpUI: 25->30
												texture = "gfx/interface/icons/text_icons/trigger_no.dds"
												visible = "[And(Not(DHEEventEntry.IsTriggerTrue), Not(Or(DHEEventEntry.IsStatusTimeHasPassed, DHEEventEntry.IsStatusHasHappened)))]" # GlorpUI: only while pending
											}
										}
									}

									tooltipwidget = {
										using = DHEEvent_tooltip
									}
								}
							}

							# Age icon
							icon = {
								ignore_layout = yes
								size = { 48 48 }
								position = { 15 0 }
								parentanchor = vcenter
								texture = "[GetAgeIcon(DHEEventEntry.GetAge)]"
								visible = "[DHEEventEntry.HasAge]"
								datacontext = "[DHEEventEntry.GetAge]"
								sort_by_highlight = { name = "age" }
								tooltipwidget = {
									using = Age_tooltip
								}
							}
						}
					}
				}
			}
		}
	}
}
