						}
					}

					button_panel_tab_alt = { ### geography tab

						widget = {
							visible = "[Not(IsLateralGroupOpened('geography_group'))]"
							size = { 100% 100% }
							name = geopolitics_tab_button
							background = {
								# GlorpUI: coloured tab background
								block "colourTexture" {
									visible = "[Not(Player.MakeScope.GetVariable('useDefaultIconsBGLeftPanel').IsSet)]"
									texture = "gfx/interface/buttons/panel_tabs_geopolitics.dds"
								}
								texture_density = 2
