							on_action = "[ToggleLateralGroup('geography_group')]"
						}
						onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets ideas_window')]" # GlorpUI: Idea Variation 2
						onclick = "[GetVariableSystem.Clear('ideas_window_open')]" # GlorpUI: Idea Variation 2

						input_action = "top_left_7"
						use_global_input_instance = yes

						using = layoutpolicy_expanding

						panel_tab_highlight = {
							visible = "[IsLateralGroupHighlighted('geography_group')]"
						}

						icon = {
							visible = "[Player.MakeScope.GetVariable('useDefaultIconsLeftPanel').IsSet]" # GlorpUI: settings toggle
							size = { 26 26 }
							parentanchor = center
							texture = "gfx/interface/icons/flat_icons/tabicons/geography_flat_icon.dds"
							texture_density = 2

							using = button_panel_tab_icon_effect
							blockoverride "icon_effect_visible" { visible = "[IsLateralGroupOpened('geography_group')]" }
							blockoverride "icon_effect_color" { color = { 0.45 0.55 0.90 1.0 } }
						}
						icon = {
							# GlorpUI: coloured tab icon
							visible = "[Not(Player.MakeScope.GetVariable('useDefaultIconsLeftPanel').IsSet)]"
							size = { 26 26 }
							parentanchor = center
							texture = "gfx/interface/icons/flat_icons/tabicons/geography_flat_icon_c.dds"
							texture_density = 2

							using = button_panel_tab_icon_effect
							blockoverride "icon_effect_visible" { visible = "[IsLateralGroupOpened('geography_group')]" }
							blockoverride "icon_effect_color" { color = { 0.45 0.55 0.90 1.0 } }
						}
					}

					button_panel_tab_alt = { ### advances tab

						widget = {
							visible = "[Not(IsLateralGroupOpened('advances_group'))]"
							size = { 100% 100% }
							name = advances_tab_button
							background = {
								# GlorpUI: coloured tab background
								block "colourTexture" {
									visible = "[Not(Player.MakeScope.GetVariable('useDefaultIconsBGLeftPanel').IsSet)]"
									texture = "gfx/interface/buttons/panel_tabs_advances.dds"
								}
								texture_density = 2
								spriteType = stretched
								spriteBorder = { 0 0 }
								frame_grid = { 4 1 }
							}
						}
						down = "[IsLateralGroupOpened('advances_group')]"
						onmousehierarchyenter = "[ResetHighlightedTab]"

						tooltipwidget = {
							using = TabAdvancesTooltip
						}

						action_tooltip = {
							title = "TAB_TOOLTIP_ADVANCES_LEFT_CLICK"
							on_action = "[ToggleLateralGroup('advances_group')]"
						}
						onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets ideas_window')]" # GlorpUI: Idea Variation 2
						onclick = "[GetVariableSystem.Clear('ideas_window_open')]" # GlorpUI: Idea Variation 2

						input_action = "top_left_8"
						use_global_input_instance = yes

						using = layoutpolicy_expanding

						panel_tab_highlight = {
							visible = "[IsLateralGroupHighlighted('advances_group')]"
						}

						icon = {
							visible = "[Player.MakeScope.GetVariable('useDefaultIconsLeftPanel').IsSet]" # GlorpUI: settings toggle
							size = { 26 26 }
							parentanchor = center
							texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds"
							texture_density = 2

							using = button_panel_tab_icon_effect
							blockoverride "icon_effect_visible" { visible = "[IsLateralGroupOpened('advances_group')]" }
							blockoverride "icon_effect_color" { color = { 0.10 0.70 0.35 1.0 } }
						}
						icon = {
							# GlorpUI: coloured tab icon
							visible = "[Not(Player.MakeScope.GetVariable('useDefaultIconsLeftPanel').IsSet)]"
							size = { 26 26 }
							parentanchor = center
							texture = "gfx/interface/icons/flat_icons/tabicons/advances_c.dds"
							texture_density = 2

							using = button_panel_tab_icon_effect
							blockoverride "icon_effect_visible" { visible = "[IsLateralGroupOpened('advances_group')]" }
							blockoverride "icon_effect_color" { color = { 0.10 0.70 0.35 1.0 } }
						}
					}

					button_panel_tab_ideas = { } # GlorpUI: Idea Variation 2
					button_panel_tab_uniqueevents = { } # GlorpUI: Unique Events Tab
				}
			}

			hbox = {
				visible = "[IsObservingWithoutSelectedCountry]"
				spacing = 10

				expand = { }

				icon = {
					size = { 36 36 }
					texture = "gfx/interface/icons/messages_settings/map.dds"
				}

				text_single = {
					text = "OBSERVER_MODE"
					autoresize = yes
					using = Font_Size_Medium
					using = Font_Type_Headers
					default_format = "#color_white"
				}

				expand = { }
			}
		}
	}

	type left_panel = widget {
		allow_outside = yes
		layer = bottom

		widget = {
			# GlorpUI: Stats Bar
			allow_outside = yes
			visible = "[Not(Player.MakeScope.GetVariable('disableLeftPanelStatsBar').IsSet)]"
			left_panel_info_bar = { }
			left_panel_info_toggle = {
				blockoverride "toggle_visible" {
					visible = "[Not(Player.MakeScope.GetVariable('toggleLeftPanelStatsBar').IsSet)]"
				}
				blockoverride "toggle_pos" {
					position = { 20 123 }
				}
				blockoverride "toggle_state" {
					state = {
						name = _show
						duration = 0.2
						bezier = { 0.0 1.0 0.0 1.0 }
						position = { 20 123 }
					}
					state = {
						name = _hide
						duration = 0.2
						bezier = { 0.0 1.0 0.0 1.0 }
						position = { 20 213 }
					}
				}
			}
			left_panel_info_toggle = { }
		}

		# Closed panel
		widget = {
			visible = "[Not(TutorialHasVar('intro_hide_ui_2'))]"
			allow_outside = yes
			name = "intro_highlight_1"

			vbox = {
				visible = "[Not(And(LeftView.IsSideAttached, Not(IsLateralViewFullScreen)))]"

				allow_outside = yes
				using = layoutpolicy_expanding
				using = left_panel_maxmin_width
				using = bg_lateralview
				set_parent_size_to_minimum = yes

				left_panel_bar = {
					layoutpolicy_horizontal = expanding
				}
			}
		}

		# Opened panel
		vbox = {
			visible = "[And(LeftView.IsSideAttached, Not(IsLateralViewFullScreen))]"

			allow_outside = yes
			alwaystransparent = no
			using = layoutpolicy_expanding
			using = left_panel_maxmin_width
			using = panels_margin_bottom
			using = snd_UI_lateralview

			vbox = {
				using = layoutpolicy_expanding
				using = bg_lateralview

				left_panel_bar = {
					layoutpolicy_horizontal = expanding
				}

				widget = {
					using = layoutpolicy_expanding
					allow_outside = yes
				}
			}
		}

		# flag and decorations - vanilla ui
		widget = {
			position = { 5 -55 }
			size = { 60 100 }
			allow_outside = yes
			visible = "[Player.MakeScope.GetVariable('useVanillaPortrait').IsSet]" # GlorpUI: settings toggle

			flag_3d_animated = {
				visible = "[And3(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2')), Not(Player.MakeScope.GetVariable('useStaticFlag').IsSet))]" # GlorpUI: added static flag condition
				size = { 114 76 }
				parentanchor = center
				position = { 78 0 }
				datacontext = "[InGameTopbar.GetPlayer]"

				blockoverride "click_properties" {
					on_input_action_shortcut = "[PanToCountry(Country.Self)]"
					input_action = "go_to_capital"
					use_global_input_instance = yes
				}

				blockoverride "click_action" {
					title = "OPEN_COUNTRY_PANEL"
					on_action = "[ShowForeignCountry(Country.Self)]"
				}
			}
			country_flag_big = {
				# GlorpUI: Static Flag
				visible = "[And4(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2')), Player.MakeScope.GetVariable('useStaticFlag').IsSet, Not(Player.MakeScope.GetVariable('useFramedStaticFlag').IsSet))]"
				size = { 80 62 }
				parentanchor = center
				position = { 79 -4 }
				datacontext = "[InGameTopbar.GetPlayer]"
			}
			country_flag = {
				# GlorpUI: Big Static Flag
				visible = "[And4(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2')), Player.MakeScope.GetVariable('useStaticFlag').IsSet, Player.MakeScope.GetVariable('useFramedStaticFlag').IsSet)]"
				size = { 90 70 }
				parentanchor = center
				position = { 79 -4 }
				datacontext = "[InGameTopbar.GetPlayer]"
				blockoverride "flag" {
					datacontext = "[GetCountryCoatOfArms(Country.Self)]"
					texture = "[CoatOfArmsWrapper.GetTexture('(int32)192','(int32)128')]"
					frame = "[CoatOfArmsWrapper.GetFrame('(int32)192','(int32)128')]"
					framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)192','(int32)128','(float)0.5')]"
					texture_density = 2
				}
				blockoverride "flag_frame_texture" { }
			}
		}

		# portrait and all associated surroundings
		widget = {
			visible = "[And(And(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2'))), Player.MakeScope.GetVariable('useVanillaPortrait').IsSet)]"
			parentanchor = left
			widgetanchor = vcenter|left
			size = { 78 78 }
			allow_outside = yes

			background = {
				texture = "gfx/interface/component_tiles/hud_corners/circle_background.dds"
				texture_density = 2

				modify_texture = {
					using = color_dark_blue_texture
				}
			}

			character_frame_medium = {
				parentanchor = center
				position = { 0 7 }
				blockoverride "character_frame_size" {
					size = { 80 98 }
				}
				blockoverride "portrait_position" { position = { 0 0 } }
				blockoverride "portrait_size" { size = { 85% 90% } }

				datacontext = "[InGameTopbar.GetPlayer.GetGovernment.GetRulerOrRegent]"
				blockoverride "character_frame_texture" {
					texture = "gfx/interface/component_decoration/character_frames/character_non_stretchable_frame_2.dds"
				}
				blockoverride "character_portrait_visible" {
					visible = no
				}

				blockoverride "character_portrait_ani_visible" {
					visible = yes
				}
				blockoverride "character_portrait_ani_size" {
					size = { 65 98 }
				}
				blockoverride "character_ribbon" {
					character_ribbon_1 = {
						visible = "[Character.HasRebel]"
						blockoverride "stretchable" { }
						blockoverride "ribbon color" {
							modify_texture = {
								using = color_black_texture
								blend_mode = overlay
							}
						}
					}
					character_ribbon_3 = {
						visible = "[And(Character.IsCivilWarRuler, Not(Character.HasRebel))]"
						blockoverride "stretchable" { }
						blockoverride "ribbon color" {
							modify_texture = {
								using = color_black_texture
								blend_mode = overlay
							}
						}
					}
					character_ribbon_3 = {
						visible = "[And3(Character.IsRuler, Not(Character.HasRebel), Not(Character.IsCivilWarRuler))]"
						blockoverride "stretchable" { }
					}
				}

				widget = {
					parentanchor = bottom|left
					visible = "[GetPlayer.GetGovernment.HasActiveRegent]"
					size = { 26 28 }
					allow_outside = yes
					datacontext = "[GetPlayer.GetGovernment]"

					header_button_left = {
						size = { 26 26 }
						blockoverride "button_icon_stretch_sprite" { }
						blockoverride "header_button_frame_inner" { visible = no }
						blockoverride "header_button_icon_size" { size = { 24 24 } }
						blockoverride "icon_replace" { }
						blockoverride "header_button_text_layout" { }
						tooltip_enabled = no
					}

					piechart = {
						size = { 26 26 }
						parentanchor = hcenter
						using = piechart_angles

						icon = {
							texture = "gfx/interface/pie_charts/pie_chart_white.dds"
							size = { 100% 100% }
							parentanchor = center
							color = { 0.35 0.35 0.35 1 }
						}

						pieslice_no_highlight = {
							texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
							value = "[GetPlayer.GetGovernment.GetRegencyProgress]"
							color = { 1 1 1 1 }
						}

						pieslice_no_highlight = {
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
							value = "[Subtract_float('(float)100.0', GetPlayer.GetGovernment.GetRegencyProgress)]"
							color = { 1 1 1 0 }
						}
					}

					button = {
						parentanchor = top|hcenter
						enabled = "[Player.CanExtendRegency]"
						position = { 0 3 }
						size = { 18 18 }
						texture = "gfx/interface/icons/character_roles/regent.dds"

						texture_density = 2
						mirror = horizontal

						visible = "[GetPlayer.GetGovernment.HasActiveRegent]"
						tooltipwidget = {
							using = CurrentRegencyTooltip
						}

						action_tooltip = {
							click_type = left
							click_mode = confirm
							conditions = "[MakeItFailIf(Not(Player.CanExtendRegency), Player.GetExtendRegencyInfo)]"
							title = "[Select_CString(Player.CanExtendRegency, Player.GetExtendRegencyInfo, Localize('CANNOT_EXTEND_REGENCY'))]"
							on_action = "[ExtendRegency(Player.Self)]"
							enabled = "[Player.CanExtendRegency]"
						}
					}
				}
			}

			datacontext = "[Player]"

			country_rank_banner = {
				position = { 80 60 }
			}
		}

		# GlorpUI: flag and decorations
		widget = {
			position = { 5 10 }
			allow_outside = yes
			visible = "[Not(Player.MakeScope.GetVariable('useVanillaPortrait').IsSet)]"

			icon = {
				position = { -4 -47 }
				parentanchor = right
				widgetanchor = left
				using = panel_decor_size
				mirror = horizontal
				texture = "[GetGraphicalCultureTexture('panel_bar_corner_shadow')]"
				# texture = "gfx/interface/graphical_cultures/european_gfx/panel_bar_corner_shadow.dds"
				texture_density = 2

				using = color_black_texture
			}
			icon = {
				position = { -4 -47 }
				parentanchor = right
				widgetanchor = left
				using = panel_decor_size
				mirror = horizontal
				texture = "[GetGraphicalCultureTexture('panel_bar_corner')]"
				# texture = "gfx/interface/graphical_cultures/european_gfx/fancy_flag_cloth.dds"
				texture_density = 2

				using = non_clickable_color_gold_texture
			}

			flag_3d_animated = {
				visible = "[And3(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2')), Not(Player.MakeScope.GetVariable('useStaticFlag').IsSet))]"
				size = { 185 123 }
				parentanchor = center
				position = { 70 -1 }
				datacontext = "[InGameTopbar.GetPlayer]"

				blockoverride "click_properties" {
					on_input_action_shortcut = "[PanToCountry(Country.Self)]"
					input_action = "go_to_capital"
					use_global_input_instance = yes
				}

				blockoverride "click_action" {
					title = "TAB_TOOLTIP_GOVERNMENT_LEFT_CLICK"
					on_action = "[OpenLateralView('government')]"
				}
			}
			country_flag_big = {
				# GlorpUI: Static Flag
				visible = "[And4(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2')), Player.MakeScope.GetVariable('useStaticFlag').IsSet, Not(Player.MakeScope.GetVariable('useFramedStaticFlag').IsSet))]"
				size = { 125 97 }
				parentanchor = center
				position = { 55 -1 }
				datacontext = "[InGameTopbar.GetPlayer]"
			}
			country_flag = {
				# GlorpUI: Big Static Flag
				visible = "[And4(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2')), Player.MakeScope.GetVariable('useStaticFlag').IsSet, Player.MakeScope.GetVariable('useFramedStaticFlag').IsSet)]"
				size = { 147 114 }
				parentanchor = center
				position = { 55 -1 }
				datacontext = "[InGameTopbar.GetPlayer]"
				blockoverride "flag" {
					datacontext = "[GetCountryCoatOfArms(Country.Self)]"
					texture = "[CoatOfArmsWrapper.GetTexture('(int32)192','(int32)128')]"
					frame = "[CoatOfArmsWrapper.GetFrame('(int32)192','(int32)128')]"
					framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)192','(int32)128','(float)0.5')]"
					texture_density = 2
				}
				blockoverride "flag_frame_texture" { }
			}
		}

		# GlorpUI: portrait and all associated surroundings
		widget = {
			visible = "[And(And(IsPlayerValid, Not(TutorialHasVar('intro_hide_ui_2'))), Not(Player.MakeScope.GetVariable('useVanillaPortrait').IsSet))]"

			parentanchor = left
			widgetanchor = vcenter|left
			size = { 78 78 }
			allow_outside = yes

			datacontext = "[Player]"

			country_rank_banner = {
				position = { 540 40 }
			}
		}
	}
}
