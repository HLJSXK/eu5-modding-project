							blockoverride "icon_effect_color" { color = { 0.40 0.68 0.73 1.0 } }
						}
					}

					button_panel_tab_alt = { ### military tab

						widget = {
							visible = "[Not(IsLateralGroupOpened('military_group'))]"
							size = { 100% 100% }
							name = military_tab_button
							background = {
