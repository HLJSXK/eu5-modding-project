template CountryTooltip_DiplomacyStatBars {
	visible = "[And3(Not(IsLobbyOpen), IsPlayerValid, Not(Country.IsPlayer))]"

	TooltipStatsBar = {
		blockoverride "items" {
			TooltipStatBarIconTextItem = { # THEIR OPINION
				blockoverride "item_icon_coa" { # GlorpUI: added
					datacontext = "[Country]"
				}
				blockoverride "item_icon" {
					size = { 20 20 }
					texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
				}

				blockoverride "item_text" {
					text = "[Country.GetDiplomacy.GetOpinionOf(GetPlayer)|+=]"
					layoutpolicy_horizontal = expanding
					size = { -1 18}
					autoresize = no
					align = center
				}

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
							}
						}

						blockoverride "concept_link" {
							text = "[opinion|e]"
						}

						tooltipmeta = {
							texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
							game_concept = "[opinion|E]"
						}

						textcontext = "[Country.GetDiplomacy.GetOpinionDescription(GetPlayer)]"
					}
				}
			}
			TooltipStatBarIconTextItem = { # OUR OPINION
				blockoverride "item_icon_coa" {
					datacontext = "[Player]"
				}
				blockoverride "item_icon" {
					size = { 20 20 }
					texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
				}

				blockoverride "item_text" {
					text = "[GetPlayer.GetDiplomacy.GetOpinionOf(Country.GetDiplomacy.GetCountry)|+=]"
					layoutpolicy_horizontal = expanding
					size = { -1 18}
					autoresize = no
					align = center
				}

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
							}
						}

						blockoverride "concept_link" {
							text = "[opinion|e]"
						}

						tooltipmeta = {
							texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
							game_concept = "[opinion|E]"
						}

						textcontext = "[GetPlayer.GetDiplomacy.GetOpinionDescription(Country.GetDiplomacy.GetCountry)]"
					}
				}
			}
		}
	}

	# even more country stats icons
	TooltipStatsBar = {
		visible = "[And3(Not(IsLobbyOpen), IsPlayerValid, Not(Country.IsPlayer))]"
		blockoverride "items" {
			TooltipStatBarIconTextItem = { # TRUST
				blockoverride "item_icon" {
					size = { 20 20 }
					texture = "gfx/interface/icons/flat_icons/foreigncountry/trust.dds"
				}

				blockoverride "item_text" {
					raw_text = "[Country.GetDiplomacy.GetTrustTowardsString(GetPlayer)]"
					layoutpolicy_horizontal = expanding
					size = { -1 18}
					autoresize = no
					align = center
				}

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/flat_icons/foreigncountry/trust.dds"
							}
						}

						blockoverride "concept_link" {
							text = "[trust|e]"
						}

						textcontext = "[Country.GetDiplomacy.GetTrustDescription(GetPlayer)]"
					}
				}
			}

			TooltipStatBarIconTextItem = { # FAVORS
				blockoverride "item_icon" {
					size = { 20 20 }
					texture = "gfx/interface/icons/flat_icons/foreigncountry/favors.dds"
				}

				blockoverride "item_text" {
					text = "[Country.GetDiplomaticCurrency('favors')]"
					layoutpolicy_horizontal = expanding
					size = { -1 18}
					autoresize = no
					align = center
				}

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/flat_icons/foreigncountry/favors.dds"
							}
						}
						blockoverride "concept_link" {
							text = "[favors|e]"
						}
						textcontext = "[Country.GetDiplomaticCurrencyDesc('favors')]"
					}
				}
			}

			TooltipStatBarIconTextItem = { # SPY
				blockoverride "item_icon" {
					size = { 20 20 }
					texture = "gfx/interface/icons/outliner/categories/spynetwork.dds"
				}

				blockoverride "item_text" {
					text = "[Country.GetDiplomaticCurrency('spy_network')]"
					layoutpolicy_horizontal = expanding
					size = { -1 18}
					autoresize = no
					align = center
				}

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/outliner/categories/spynetwork.dds"
							}
						}
						blockoverride "concept_link" {
							text = "[spy_network|e]"
						}
						textcontext = "[Country.GetDiplomaticCurrencyDesc('spy_network')]"
					}
				}
			}

			TooltipStatBarIconTextItem = { # ANTAGONISM
				blockoverride "item_icon" {
					size = { 20 20 }
					texture = "gfx/interface/icons/flat_icons/declare_war/antagonism.dds"
				}

				blockoverride "item_text" {
					raw_text = "[Country.GetDiplomacy.GetAntagonismTowards(GetPlayer)|-=0]"
					layoutpolicy_horizontal = expanding
					size = { -1 18}
					autoresize = no
					align = center
				}

				tooltipwidget = {
					using = AntagonismTooltip
					blockoverride "antagonism_datacontext" {
						textcontext = "[Country.GetDiplomacy.GetAntagonismDescription(GetPlayer)]"
					}
				}
			}
		}
	}
}

template CountryMapModeDiplomacyTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetConceptTexture('diplomacy')]"
		}

		blockoverride "title_text" {
			text = "DIPLOMACY_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = "[diplomacy|e]"
		}

		blockoverride "tooltip_content" {
			TooltipStatsBar = {
				visible = "[And(Not(IsLobbyOpen), Not(EqualTo_string(Country.GetTag, GetSelectedCountryOrByLocation.GetTag)))]"
				blockoverride "items" {
					TooltipStatBarIconTextItem = { # THEIR OPINION
						blockoverride "item_icon_coa" { # GlorpUI: added
							datacontext = "[Country]"
						}
						blockoverride "item_icon" {
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
						}

						blockoverride "item_text" {
							text = "[Country.GetDiplomacy.GetOpinionOf(GetSelectedCountryOrByLocation)|+=]"
							layoutpolicy_horizontal = expanding
							size = { -1 18}
							autoresize = no
							align = center
						}

						tooltipwidget = {
							SimpleContextualStringPairTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
									}
								}

								blockoverride "concept_link" {
									text = "[opinion|e]"
								}

								tooltipmeta = {
									texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
									game_concept = "[opinion|E]"
								}

								textcontext = "[Country.GetDiplomacy.GetOpinionDescription(GetSelectedCountryOrByLocation)]"
							}
						}
					}
					TooltipStatBarIconTextItem = { # SELECTED COUNTRY OPINION
						blockoverride "item_icon_coa" {
							datacontext = "[GetSelectedCountryOrByLocation]"
						}
						blockoverride "item_icon" {
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
						}

						blockoverride "item_text" {
							text = "[GetSelectedCountryOrByLocation.GetDiplomacy.GetOpinionOf(Country.GetDiplomacy.GetCountry)|+=]"
							layoutpolicy_horizontal = expanding
							size = { -1 18}
							autoresize = no
							align = center
						}

						tooltipwidget = {
							SimpleContextualStringPairTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
									}
								}

								blockoverride "concept_link" {
									text = "[opinion|e]"
								}

								tooltipmeta = {
									texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
									game_concept = "[opinion|E]"
								}

								textcontext = "[GetSelectedCountryOrByLocation.GetDiplomacy.GetOpinionDescription(Country.GetDiplomacy.GetCountry)]"
							}
						}
					}
				}
			}

			TooltipStatsBar = {
				visible = "[And(Not(IsLobbyOpen), Not(EqualTo_string(Country.GetTag, GetSelectedCountryOrByLocation.GetTag)))]"
				blockoverride "items" {
					TooltipStatBarIconTextItem = { # TRUST
						blockoverride "item_icon" {
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/foreigncountry/trust.dds"
						}

						blockoverride "item_text" {
							raw_text = "[Country.GetDiplomacy.GetTrustTowardsString(GetSelectedCountryOrByLocation)]"
							layoutpolicy_horizontal = expanding
							size = { -1 18}
							autoresize = no
							align = center
						}

						tooltipwidget = {
							SimpleContextualStringPairTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/flat_icons/foreigncountry/trust.dds"
									}
								}

								blockoverride "concept_link" {
									text = "[trust|e]"
								}

								textcontext = "[Country.GetDiplomacy.GetTrustDescription(GetSelectedCountryOrByLocation)]"
							}
						}
					}

					TooltipStatBarIconTextItem = { # ANTAGONISM
						blockoverride "item_icon" {
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/declare_war/antagonism.dds"
						}

						blockoverride "item_text" {
							raw_text = "[Country.GetDiplomacy.GetAntagonismTowards(GetSelectedCountryOrByLocation)|-=0]"
							layoutpolicy_horizontal = expanding
							size = { -1 18}
							autoresize = no
							align = center
						}

						tooltipwidget = {
							using = AntagonismTooltip
							blockoverride "antagonism_datacontext" {
								textcontext = "[Country.GetDiplomacy.GetAntagonismDescription(GetSelectedCountryOrByLocation)]"
							}
						}
					}
				}
			}

			TooltipBlockList = {
				blockoverride "set_textcontext" {
					ontextcontextchanged = "[SetBlockListFromTextContext(PdxGuiWidget.AccessSelf)]"
				}

				textcontext = "[Country.GetSelectedCountryDiplomacyInfo]"
			}
		}
	}
}
