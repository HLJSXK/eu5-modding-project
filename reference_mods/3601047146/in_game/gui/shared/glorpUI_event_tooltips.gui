template DHEEvent_tooltip { # GlorpUI: rebuilt on the DHETooltip types

	DHETooltip = {
		using = bg_age_event_frame
		using = bg_age_event_inner
		using = bg_age_event_frame
		using = bg_secondary_inner_alt

		blockoverride "title_text" {
			text = "[DHEEventEntry.GetTitle]"
		}
		blockoverride "subtitle_text" {
			text = "[Localize('FROM_MARKET')] [DHEEventEntry.GetDateRange] | [Localize('DHE_MONTHLY_CHANCE')]"
		}

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetAgeIcon(DHEEventEntry.GetAge)]"
				datacontext = "[DHEEventEntry.GetAge]"
				tooltipwidget = {
					using = Age_tooltip
				}
			}
		}

		blockoverride "concept_link" {
			text = "[dynamic_historical_event|e]"
		}

		blockoverride "tooltip_content" {

			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[DHEEventEntry.GetDebugInfo]"
				}
			}

			# DHEFlavorTextBlock = {
			# 	visible = "[Not(StringIsEmpty(DHEEventEntry.GetDescription))]"
			# 	blockoverride "text" {
			# 		text = "[DHEEventEntry.GetDescription]"
			# 	}
			# }

			DHETooltipEntry = {
				blockoverride "content" {
					TooltipListBase = {
						TooltipManualTableField = {
							background = {
								visible = "[DHEEventEntry.IsStatusHasHappened]"
								using = color_mid_green_texture
								# alpha = 0.2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/text_icons/dhe_status_has_happened.dds"
								visible = "[DHEEventEntry.IsStatusHasHappened]"
							}

							background = {
								visible = "[DHEEventEntry.IsStatusNotYet]"
								texture = "gfx/interface/colors/black.dds"
								margin = { 1 1 }
								margin_bottom = 2
								texture_density = 2
								alpha = 0.4
							}
							background = {
								using = color_geopolitics_texture
								alpha = 0.6
								visible = "[DHEEventEntry.IsStatusNotYet]"
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/text_icons/dhe_status_has_not_happened_yet.dds"
								visible = "[DHEEventEntry.IsStatusNotYet]"
							}

							background = {
								visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
								using = color_greyish_texture
								# alpha = 0.2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/text_icons/dhe_status_time_has_passed.dds"
								visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "[DHEEventEntry.GetStatusLabel]"
							}
						}
					}
					TooltipManualTableField = {
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							raw_text = "[DHEEventEntry.GetDateRange]"
						}
						text_single = {
							autoresize = yes
							text = "DHE_MONTHLY_CHANCE"
						}
					}
				}
				blockoverride "subtitle_text" { text = "LIST_TITLE_CHRONOLOGY" }
				blockoverride "subtitle_icon" { texture = "gfx/interface/icons/work_of_art/chronicle.dds" }

			}

			DHEOptionsList = {
				textcontext = "[DHEEventEntry.GetEffects]"

				tooltipmeta = {
					texture = "[GetConceptTexture('event_option')]"
					game_concept = "[event_option|e]"
				}

				# blockoverride "block_title" {
				# 	text = "EVENT_POSSIBLE_OPTIONS"
				# }
			}

			DHETooltipEntry = {
				blockoverride "content" {
					TooltipScrolledRequirementsList = {
						textcontext = "[DHEEventEntry.GetTrigger]"

						blockoverride "block_title" {
							text = "[SelectLocalization(DHEEventEntry.IsTriggerTrue, 'REQUIREMENT_ARE_MET', 'REQUIREMENT_ARE_NOT_MET')]"

							background = {
								visible = "[DHEEventEntry.IsTriggerTrue]"
								using = color_mid_light_green_texture
								alpha = 0.9
							}

							background = {
								visible = "[Not(DHEEventEntry.IsTriggerTrue)]"
								using = color_mid_red_texture
								alpha = 0.7
							}
						}

						blockoverride "block_scrollarea" { maximumsize = { -1 350 }}
					}
				}
				blockoverride "subtitle_text" { text = "LIST_TITLE_REQUIREMENTS" }
				blockoverride "subtitle_icon" { texture = "gfx/interface/icons/flat_icons/trigger.dds" }

			}

			DHEFlavorTextBlock = {
				visible = "[DHEEventEntry.HasHistoricalInfo]"
				blockoverride "text" {
					text = "[DHEEventEntry.GetHistoricalInfo]"
				}
			}
		}
	}
}

types GlorpUIEventTypes {
	type DHETooltipBase = tooltip_widget {
		alwaystransparent = no
		filter_mouse = all

		# using = bg_contextual_tooltip
		using = snd_UI_tooltip_handling
	}

	type DHETooltip = DHETooltipBase {
		TooltipHotkeyHeader = {
			blockoverride "hotkey_background" {
				using = bg_contextual_hotkey
			}
		}

		vbox = {
			set_parent_size_to_minimum = yes
			layoutpolicy_horizontal = shrinking
			layoutpolicy_vertical = shrinking

			block "tooltip_title_pre" {}

			block "tooltip_title" {
				DHETooltipHeader = {}
				# TooltipLockProgress = {}
			}

			TooltipContentSection = {
				block "tooltip_content_margin" {
					margin = { 10 10 }
				}

				block "tooltip_content" {}
				block "extra_tooltip_content" {}
				block "tooltip_ui_action_block" {
					TooltipUIActionBlock = {
						visible = "[ExtraTooltipInfo.HasUIAction]"
						datacontext = "[ExtraTooltipInfo.GetUIAction]"
					}
				}
			}
		}

		using = bg_age_event_frame
	}

	type DHEFlavorTextBlock = TooltipListBase {
		using = tooltip_delayed_block

		block "set_textcontext" {
			ontextcontextchanged = "[SetCStringFromTextContext(PdxGuiWidget.AccessSelf)]"
		}

		blockoverride "bg_listbase" {
			using = message_text_box_background
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 10 }

			textbox = {
				using = tooltip_text_block_template
				default_format = "#flavor"
				block "text" {
					text = "[CString.GetString]"
				}
			}
		}
	}

	type DHEOptionsList = TooltipListBase {
		ontextcontextchanged = "[SetRowListFromTextContext(PdxGuiWidget.AccessSelf)]"

		blockoverride "block_title" {
			block "block_title" {
				visible = "[RowList.GetTitle.IsStringViewNotEmptyOrNull]"
				text = "[RowList.GetTitle]"
			}
		}

		DHETooltipEntry = {
			blockoverride "content" {
				DHEOptionsListContent = {
					block "rowlist_datamodel_has_items" {
						visible = "[DataModelHasItems(RowList.GetRows)]"
					}

					layoutpolicy_horizontal = expanding
				}
			}
			blockoverride "subtitle_text" { text = "EVENT_POSSIBLE_OPTIONS" }
			blockoverride "subtitle_icon" { texture = "gfx/interface/icons/events/event_option.dds" }
		}

		TooltipListEmptyContent = {
			block "rowlist_datamodel_is_empty" {
				visible = "[IsDataModelEmpty(RowList.GetRows)]"
			}
		}

		TooltipTableHeader = {
			block "table_header_background" {
				background = {
					using = tile_background_squared_texture
					mirror = vertical
					alpha = 0.7
					modify_texture = {
						using = color_turquoise_texture
					}
				}
			}

			blockoverride "tableheader_text" {
				# block "block_footer" {
				visible = no
				# }
			}
		}
	}

	type DHEOptionsListContent = vbox {
		block "rowlist_datamodel" {
			datamodel = "[RowList.GetRows]"
			ignoreinvisible = yes
		}

		spacing = 4
		margin = { 2 2 }
		item = {
			button_regular = {
				using = layoutpolicy_expanding
				text = "[CPdxStringView.GetStringView]"
			}
		}
	}

	type DHETooltipHeader = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 48 }
		using = bg_card_header_01_geopolitics

		margin = { 12 6 }
		spacing = 8
		icon = {
			size = { 42 42 }
			block "title_icon" { }
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				align = left|nobaseline
				using = Font_Type_Headers
				default_format = "#yellow_titles"
				block "title_text" { raw_text = "Placeholder" }
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				align = left|nobaseline
				fontsize = 12
				default_format = "#subtle_name"
				block "subtitle_text" { raw_text = "Placeholder Subtitle" }
			}
		}
	}

	type DHETooltipEntry = vbox {
		layoutpolicy_horizontal = expanding
		bottomtotop = yes
		#Content
		vbox = {
			using = layoutpolicy_expanding
			using = bg_paper_card_fancy
			margin = { 6 6 }
			spacing = 6
			block "content" { }
		}
		# Title
		DHETooltipEntryTitle = { }
	}

	type DHETooltipEntryTitle = hbox {
		using = layoutpolicy_expanding
		using = bg_card_header_01_geopolitics
		using = bg_cabinet_card_frame
		size = { -1 35 }
		margin = { 5 5 }
		spacing = 5
		icon = {
			size = { 24 24 }
			block "subtitle_icon" {
				texture = "gfx/interface/icons/flat_icons/star.dds"
			}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			using = Font_Type_Headers
			fontsize = 15
			default_format = "#yellow_titles"
			block "subtitle_text" {
				text = "Placeholder Subtitle"
			}
		}
	}
}
