template market_banner {
	size = { 21 30 }
	texture = "gfx/interface/buttons/banner_button_vertical.dds"
	texture_density = 2
	spriteType = corneredstretched
	spriteborder = { 44 50 }

	block "market_banner_color" {
		modify_texture = {
			using = color_yellow_texture
			alpha = 0.6
		}
	}

	icon = {
		size = { 16 16 }
		parentanchor = center
		shaderfile = "gfx/FX/pdxgui_default.shader"
		glow = {
			name = "drop_shadow"
			glow_radius = 2
			color = {0.0 0.0 0.0 1.0}
			alpha = 0.6
		}

		block "market_banner_icon" {
			texture = "gfx/interface/icons/alerts_icons/pops_wanting_stuff.dds"
		}
	}

	background = {
		texture = "gfx/interface/buttons/banner_button_vertical.dds"
		texture_density = 2
		spriteType = corneredstretched
		spriteborder = { 44 50 }
		margin_right = 1
		alpha = 0.5

		modify_texture = {
			using = color_black_texture
		}
	}
}
