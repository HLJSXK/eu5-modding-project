	type mapmodes_spacer = widget {

		visible_at_creation = no
		visible = "[Player.MakeScope.GetVariable('vanillaMapmodeWidth').IsSet]"
		layoutpolicy_vertical = expanding
		size = { 0 -1 }
		state = {
			name = _show
			duration = 0.25
			bezier = { 0.0 1.0 0.0 1.0 }
			size = { 117 -1 }
		}
		state = {
			name = _hide
			duration = 0.25
			bezier = { 0.0 1.0 0.0 1.0 }
			size = { 0 -1 }
		}
	}

	type mapmodes_spacer_height = widget {
		visible = "[Not(Player.MakeScope.GetVariable('vanillaMapmodeHeight').IsSet)]"
		layoutpolicy_horizontal = expanding
		size = { -1 0 }
		visible_at_creation = no
		state = {
			name = _show
			duration = 0.25
			bezier = { 0.0 1.0 0.0 1.0 }
			size = { -1 20 }
		}
		state = {
			name = _hide
			duration = 0.25
			bezier = { 0.0 1.0 0.0 1.0 }
			size = { -1 0 }
		}
	}

	type glorp_mapmode_button = widget {
		block "size" {
			size = { 40 40 }
		}
		datacontext = "[ActiveMapModeForSlot(PdxGuiWidget.GetIndexInDataModel)]"
		onmousehierarchyenter = "[MapModeSelectorVars.Clear('slot_highlight')]"

		background = {
			visible = "[MapModeSelectorVars.HasValue('slot_highlight', ToString_int32(MapModeSlot.GetSlotIndex))]"
			using = color_white_texture
			alpha = 0.3
		}

		icon = {
			size = { 100% 100% }
			visible = "[IsDataModelEmpty(MapModeSlot.GetMapModes)]"
			texture = "gfx/interface/buttons/map_modes/map_texture_square.dds"

			modify_texture = {
				using = color_white_texture
				alpha = 0.6
			}

			text_single = {
				parentanchor = center
				using = Font_Size_Big
				text = "[SlotFromIndex(PdxGuiWidget.GetIndexInDataModel)]"
			}

			tooltip_type = widget
			tooltip_parentanchor = top|hcenter
			tooltip_widgetanchor = bottom|hcenter

			tooltipwidget = {
				using = mapmode_slot_tooltip
			}
		}

		button_mapmode = {
			size = { 100% 100% }
			visible = "[DataModelHasItems(MapModeSlot.GetMapModes)]"

			blockoverride "button_mapmode_actions"
			{
				visible = "[CanChangeMapMode]"
				input_action = "[MapModeSlot.GetInputAction]"
				use_global_input_instance = yes

				action_tooltip = {
					click_type = left
					click_mode = single
					title = "MAPMODE_SLOT_CYCLE"
					on_action = "[CycleSlot(PdxGuiWidget.GetIndexInDataModel)]"
					block "button_mapmode_actions_left" { }
				}

				modify_texture = {
					visible = "[MapMode.IsSet]"
					using = color_white_texture
					alpha = 0.2
				}

				modify_texture = {
					visible = "[MapModeSelectorVars.HasValue('slot_highlight', ToString_int32(MapModeSlot.GetSlotIndex))]"
					using = color_red_texture
					alpha = 0.7
				}

				action_tooltip = {
					click_type = right
					on_action = "[PdxGuiWidget.ToggleContextMenu]"
					title = "MAPMODE_SLOT_EDIT_MENU"
				}

				tooltip_type = widget
				tooltip_parentanchor = top|hcenter
				tooltip_widgetanchor = bottom|hcenter

				tooltipwidget = {
					using = mapmode_slot_tooltip
				}

				contextmenu_widget = {
					using = mapmode_slot_edit_menu
				}
			}
		}
	}
}
