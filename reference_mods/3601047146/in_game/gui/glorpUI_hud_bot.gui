					bottomtotop = yes
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					allow_outside = yes

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						layoutstretchfactor_vertical = 60

						using = bg_mapmode_menu
