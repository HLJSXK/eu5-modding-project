[
 {
  "scene": "S01",
  "line": "各位观众朋友们，大家好。",
  "visual": "T00",
  "start": 3.5,
  "end": 5.93,
  "seconds": 2.42,
  "source": "U01.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "今天给大家介绍 Standard of Living 模组的一次大版本更新。",
  "visual": "T00",
  "start": 5.93,
  "end": 10.53,
  "seconds": 4.6,
  "source": "U01.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "老观众可能还记得，早在欧陆风云5的1.1版本，",
  "visual": "P01a",
  "start": 10.53,
  "end": 15.13,
  "seconds": 4.6,
  "source": "slides/P01a_timeline.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "我就已经实现了替代组和恩格尔曲线。",
  "visual": "P01a",
  "start": 15.13,
  "end": 18.87,
  "seconds": 3.73,
  "source": "slides/P01a_timeline.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "结果随后，Johan的大手一挥，",
  "visual": "P01b",
  "start": 18.87,
  "end": 21.3,
  "seconds": 2.42,
  "source": "slides/P01b_timeline.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "1.2版本直接摧毁了接口，替代组当场去世。",
  "visual": "P01b",
  "start": 21.3,
  "end": 25.47,
  "seconds": 4.16,
  "source": "slides/P01b_timeline.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "而今天，替代组功能从地狱中回来了。",
  "visual": "P01c",
  "start": 25.47,
  "end": 28.97,
  "seconds": 3.51,
  "source": "slides/P01c_timeline.png",
  "in": null
 },
 {
  "scene": "S01",
  "line": "(hold)",
  "visual": "P01c",
  "start": 28.97,
  "end": 29.77,
  "seconds": 0.8,
  "source": "slides/P01c_timeline.png",
  "in": null
 },
 {
  "scene": "S02",
  "line": "这次更新主要做了三件事：",
  "visual": "P02",
  "start": 29.77,
  "end": 32.4,
  "seconds": 2.64,
  "source": "slides/P02_three_things.png",
  "in": null
 },
 {
  "scene": "S02",
  "line": "第一，替代组回归；第二，生活水平加入了建筑修正；",
  "visual": "P02",
  "start": 32.4,
  "end": 37.0,
  "seconds": 4.6,
  "source": "slides/P02_three_things.png",
  "in": null
 },
 {
  "scene": "S02",
  "line": "第三，整个界面完全重做。",
  "visual": "P02",
  "start": 37.0,
  "end": 39.44,
  "seconds": 2.42,
  "source": "slides/P02_three_things.png",
  "in": null
 },
 {
  "scene": "S03",
  "line": "先说替代组。原版里，所有商品都不能互相替代。",
  "visual": "P03a",
  "start": 39.44,
  "end": 43.8,
  "seconds": 4.38,
  "source": "slides/P03a_bubble_wheat.png",
  "in": null
 },
 {
  "scene": "S03",
  "line": "小麦堆积如山，照样有人喊饿；",
  "visual": "P03a",
  "start": 43.8,
  "end": 46.67,
  "seconds": 2.86,
  "source": "slides/P03a_bubble_wheat.png",
  "in": null
 },
 {
  "scene": "S03",
  "line": "某种粮食涨价了，人们也只能硬着头皮照买。",
  "visual": "P03a",
  "start": 46.67,
  "end": 50.84,
  "seconds": 4.16,
  "source": "slides/P03a_bubble_wheat.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "现在，模组会让他们换着买。",
  "visual": "P03b",
  "start": 50.84,
  "end": 53.47,
  "seconds": 2.64,
  "source": "slides/P03b_bubble_wheat.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "我把56种商品分进了20个替代组，",
  "visual": "P04",
  "start": 53.47,
  "end": 56.77,
  "seconds": 3.29,
  "source": "slides/P04_groups.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "比如主粮、蛋白质、衣物、取暖、酒与烟草，还有各种奢侈品。",
  "visual": "P04",
  "start": 56.77,
  "end": 61.81,
  "seconds": 5.03,
  "source": "slides/P04_groups.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "每个阶层按整组消费：农民需要的是“主粮”这一类东西，",
  "visual": "P04",
  "start": 61.81,
  "end": 66.84,
  "seconds": 5.03,
  "source": "slides/P04_groups.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "而不一定非得是小麦。",
  "visual": "P04",
  "start": 66.84,
  "end": 69.04,
  "seconds": 2.21,
  "source": "slides/P04_groups.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "组内按价格分成七档：越便宜越受欢迎，",
  "visual": "P05",
  "start": 69.04,
  "end": 72.77,
  "seconds": 3.73,
  "source": "slides/P05_price_tiers.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "最便宜的偏好翻倍，最贵的只剩四分之一。",
  "visual": "P05",
  "start": 72.77,
  "end": 76.71,
  "seconds": 3.95,
  "source": "slides/P05_price_tiers.png",
  "in": null
 },
 {
  "scene": "S04",
  "line": "所以哪种粮食便宜，大家就多吃哪种。",
  "visual": "P05",
  "start": 76.71,
  "end": 80.21,
  "seconds": 3.51,
  "source": "slides/P05_price_tiers.png",
  "in": null
 },
 {
  "scene": "S05",
  "line": "计算按国家进行，结果会直接显示为“商品替代（小麦）”这样的国家修正。",
  "visual": "U04",
  "start": 80.21,
  "end": 86.54,
  "seconds": 6.34,
  "source": "U04.png",
  "in": null
 },
 {
  "scene": "S05",
  "line": "在游戏里把鼠标放在任意商品上，",
  "visual": "U03",
  "start": 86.54,
  "end": 89.84,
  "seconds": 3.29,
  "source": "U03.mkv",
  "in": 1.0
 },
 {
  "scene": "S05",
  "line": "就能看到它属于哪些替代组，以及现在处在第几档价格。",
  "visual": "U03",
  "start": 89.84,
  "end": 95.11,
  "seconds": 5.25,
  "source": "U03.mkv",
  "in": 1.0
 },
 {
  "scene": "S05",
  "line": "和1.1那版不同，这次复杂的计算全部放在定期结算里，",
  "visual": "U05",
  "start": 95.11,
  "end": 100.38,
  "seconds": 5.25,
  "source": "U05.png",
  "in": null
 },
 {
  "scene": "S05",
  "line": "AI默认一年只算一次，对后期性能非常友好。",
  "visual": "U07",
  "start": 100.38,
  "end": 104.54,
  "seconds": 4.16,
  "source": "U07-2.png",
  "in": null
 },
 {
  "scene": "S05",
  "line": "如果不喜欢，也可以在CMF里单独关掉。",
  "visual": "U07",
  "start": 104.54,
  "end": 108.08,
  "seconds": 3.51,
  "source": "U07-2.png",
  "in": null
 },
 {
  "scene": "S05",
  "line": "(hold)",
  "visual": "U07",
  "start": 108.08,
  "end": 108.88,
  "seconds": 0.8,
  "source": "U07-2.png",
  "in": null
 },
 {
  "scene": "S06",
  "line": "第二件事是生活水平。",
  "visual": "P06",
  "start": 108.88,
  "end": 111.08,
  "seconds": 2.21,
  "source": "slides/P06_pp_vs_sol.png",
  "in": null
 },
 {
  "scene": "S06",
  "line": "以前，生活水平其实就是购买力，也就是手里的钱够买多少东西。",
  "visual": "P06",
  "start": 111.08,
  "end": 116.98,
  "seconds": 5.9,
  "source": "slides/P06_pp_vs_sol.png",
  "in": null
 },
 {
  "scene": "S06",
  "line": "现在我把它们拆开了：购买力仍然决定大家买多少东西；",
  "visual": "P06",
  "start": 116.98,
  "end": 122.24,
  "seconds": 5.25,
  "source": "slides/P06_pp_vs_sol.png",
  "in": null
 },
 {
  "scene": "S06",
  "line": "而生活水平，是钱，再加上钱买不到的东西。",
  "visual": "P06",
  "start": 122.24,
  "end": 126.18,
  "seconds": 3.95,
  "source": "slides/P06_pp_vs_sol.png",
  "in": null
 },
 {
  "scene": "S07",
  "line": "比如，医院、隔离所和引水渠让人活得更健康，直接提高生活水平；",
  "visual": "P07",
  "start": 126.18,
  "end": 132.08,
  "seconds": 5.9,
  "source": "slides/P07_buildings.png",
  "in": null
 },
 {
  "scene": "S07",
  "line": "制革厂、腐化处理厂和钢铁厂带来污染，会降低生活水平；",
  "visual": "P07",
  "start": 132.08,
  "end": 137.34,
  "seconds": 5.25,
  "source": "slides/P07_buildings.png",
  "in": null
 },
 {
  "scene": "S07",
  "line": "剧院、歌剧院和图书馆则按比例提高生活水平，",
  "visual": "U08",
  "start": 137.34,
  "end": 141.74,
  "seconds": 4.38,
  "source": "U08-1.png",
  "in": null
 },
 {
  "scene": "S07",
  "line": "越富裕的地方，加成越明显。",
  "visual": "U08",
  "start": 141.74,
  "end": 144.41,
  "seconds": 2.64,
  "source": "U08-1.png",
  "in": null
 },
 {
  "scene": "S08",
  "line": "生活水平也不再只是一个好看的数字。",
  "visual": "P08",
  "start": 144.41,
  "end": 148.15,
  "seconds": 3.73,
  "source": "slides/P08_bubble_migration.png",
  "in": null
 },
 {
  "scene": "S08",
  "line": "生活水平越高的地方，越能吸引移民；",
  "visual": "P08",
  "start": 148.15,
  "end": 151.65,
  "seconds": 3.51,
  "source": "slides/P08_bubble_migration.png",
  "in": null
 },
 {
  "scene": "S08",
  "line": "生活水平太低，人口增长会变慢，足够高则会加快。",
  "visual": "U09",
  "start": 151.65,
  "end": 156.25,
  "seconds": 4.6,
  "source": "U09.png",
  "in": null
 },
 {
  "scene": "S08",
  "line": "(hold)",
  "visual": "U09",
  "start": 156.25,
  "end": 157.05,
  "seconds": 0.8,
  "source": "U09.png",
  "in": null
 },
 {
  "scene": "S09",
  "line": "第三件事是界面。",
  "visual": "P10",
  "start": 157.05,
  "end": 158.81,
  "seconds": 1.77,
  "source": "slides/P10_topbar_schema.png",
  "in": null
 },
 {
  "scene": "S09",
  "line": "原来的生活水平局势被我整个拿掉了，",
  "visual": "P10",
  "start": 158.81,
  "end": 162.55,
  "seconds": 3.73,
  "source": "slides/P10_topbar_schema.png",
  "in": null
 },
 {
  "scene": "S09",
  "line": "取而代之的，是国家按钮下方的这一条四格信息栏。",
  "visual": "U10",
  "start": 162.55,
  "end": 167.38,
  "seconds": 4.82,
  "source": "U10.mkv",
  "in": 1.0
 },
 {
  "scene": "S09",
  "line": "第一格是生活水平：徽章表示你在世界上处于低、中还是高，",
  "visual": "U10",
  "start": 167.38,
  "end": 172.88,
  "seconds": 5.47,
  "source": "U10.mkv",
  "in": 1.0
 },
 {
  "scene": "S09",
  "line": "旁边是和去年同月相比的变化。",
  "visual": "U10",
  "start": 172.88,
  "end": 175.98,
  "seconds": 3.08,
  "source": "U10.mkv",
  "in": 1.0
 },
 {
  "scene": "S09",
  "line": "第二格是购买力，悬停能看到每个阶层的钱够不够花。",
  "visual": "U10",
  "start": 175.98,
  "end": 181.01,
  "seconds": 5.03,
  "source": "U10.mkv",
  "in": 1.0
 },
 {
  "scene": "S09",
  "line": "第三格是商品替代，所有替代组的供应情况一目了然。",
  "visual": "U10",
  "start": 181.01,
  "end": 186.05,
  "seconds": 5.03,
  "source": "U10.mkv",
  "in": 1.0
 },
 {
  "scene": "S09",
  "line": "第四格是全球排名，不光国家要排，",
  "visual": "U12",
  "start": 186.05,
  "end": 189.35,
  "seconds": 3.29,
  "source": "U12.mkv",
  "in": 2.0
 },
 {
  "scene": "S09",
  "line": "各个阶层也会和全世界的同阶层比一比。",
  "visual": "U12",
  "start": 189.35,
  "end": 193.32,
  "seconds": 3.95,
  "source": "U12.mkv",
  "in": 2.0
 },
 {
  "scene": "S10",
  "line": "鼠标悬停任意一格，地图会直接预览对应的地图模式，点击就能切换过去。",
  "visual": "U10b",
  "start": 193.32,
  "end": 200.12,
  "seconds": 6.77,
  "source": "U10b.mkv",
  "in": 0.3
 },
 {
  "scene": "S10",
  "line": "生活水平、购买力、商品替代和排行榜，一共四个地图模式。",
  "visual": "U11",
  "start": 200.12,
  "end": 205.38,
  "seconds": 5.25,
  "source": "U11.mkv",
  "in": 1.5
 },
 {
  "scene": "S10",
  "line": "另外，图标也全部重新画了，就是这一碗面包和水果。",
  "visual": "P11",
  "start": 205.38,
  "end": 210.18,
  "seconds": 4.82,
  "source": "slides/P11_icons.png",
  "in": null
 },
 {
  "scene": "S11",
  "line": "此外，我还按1340年各国的中位数，重新校准了各阶层的基础消费。",
  "visual": "P12",
  "start": 210.18,
  "end": 216.08,
  "seconds": 5.9,
  "source": "slides/P12_misc.png",
  "in": null
 },
 {
  "scene": "S11",
  "line": "SOL独立版，以及PP、M&T和Just Goods的兼容子模组也都同步更新了。",
  "visual": "P12",
  "start": 216.08,
  "end": 221.55,
  "seconds": 5.47,
  "source": "slides/P12_misc.png",
  "in": null
 },
 {
  "scene": "S11",
  "line": "因为改动比较大，强烈建议开新档游玩。",
  "visual": "P12",
  "start": 221.55,
  "end": 225.28,
  "seconds": 3.73,
  "source": "slides/P12_misc.png",
  "in": null
 },
 {
  "scene": "S12",
  "line": "模组已经在创意工坊更新，欢迎大家订阅尝试。",
  "visual": "U14",
  "start": 225.28,
  "end": 229.68,
  "seconds": 4.38,
  "source": "U14-2.mkv",
  "in": 1.6
 },
 {
  "scene": "S12",
  "line": "如果有任何建议，或者在游玩中遇到了问题，",
  "visual": "P13",
  "start": 229.68,
  "end": 233.85,
  "seconds": 4.16,
  "source": "slides/P13_ending.png",
  "in": null
 },
 {
  "scene": "S12",
  "line": "欢迎在评论区、创意工坊留言，或者加群反馈。谢谢大家。",
  "visual": "P13",
  "start": 233.85,
  "end": 238.89,
  "seconds": 5.03,
  "source": "slides/P13_ending.png",
  "in": null
 },
 {
  "scene": "S12",
  "line": "(hold)",
  "visual": "P13",
  "start": 238.89,
  "end": 240.89,
  "seconds": 2.0,
  "source": "slides/P13_ending.png",
  "in": null
 }
]