types sol14_location_tooltip_types
{
    type sol14_location_tooltip_button = navigational_button_alt {
        size = { 38 38 }
        datacontext = "[LocationView.GetLocation]"
        visible = "[HasPopBreakdownIntelOn(Location.Self)]"

        blockoverride "icon_size" {
            size = { 70% 70% }
        }

        blockoverride "icon_texture" {
            texture = "gfx/interface/icons/sol/sol_living_standard.dds"
            texture_density = 2
            visible = yes
            using = bg_circle_piechart
        }

        tooltipwidget = {
            using = StandardofLiving_tooltip
        }
    }
}
