# SOL standalone after-lobby GLS cache refresh.

widget = {
	name = "sol_gls_init_caller"
	size = { 0 0 }
	datacontext = "[GetPlayer]"
	visible = "[And(Country.IsValid, Not(IsLobbyOpen))]"

	state = {
		name = sol_gls_init_caller
		trigger_on_create = yes
		on_start = "[GetScriptedGui('sol_gls_init_caller').Execute(GuiScope.End)]"
	}
}
