									progressbar = { name = "sol_balance_negative" size = { 114 12 } min = 0 max = 1 value = "[FixedPointToFloat(Select_CFixedPoint(GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_base_spending_display'), '(CFixedPoint)0'), Subtract_CFixedPoint('(CFixedPoint)1', Multiply_CFixedPoint(Min_CFixedPoint(Max_CFixedPoint(Divide_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_liquid_funds_display'), Max_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_base_spending_display'), '(CFixedPoint)0.0001')), '(CFixedPoint)0'), '(CFixedPoint)1'), Min_CFixedPoint(Max_CFixedPoint(Divide_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_liquid_funds_display'), Max_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_base_spending_display'), '(CFixedPoint)0.0001')), '(CFixedPoint)0'), '(CFixedPoint)1'))), '(CFixedPoint)0'))]" invertprogress = yes progresstexture = "gfx/interface/sol_proto/bar_red.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
