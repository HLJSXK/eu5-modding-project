template SOL_LSHUD4_tooltip_2 {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "gfx/interface/sol_proto/icon_funds.dds" texture_density = 2 } }
		blockoverride "title_text" { text = "SOL_LSHUD4_T2_TITLE" }
		blockoverride "concept_link" { text = "SOL_LSHUD4_T2_SUB" }
		blockoverride "tooltip_content" {
			# SOL_UI_SECTION overall_balance
			vbox = { layoutpolicy_horizontal = expanding spacing = 3
				widget = { name = "sol_balance_total_row" size = { 500 64 }
					background = { using = tooltip_table_field_texture alpha = 0.3 }
					background = { using = color_gold_texture alpha = 0.06 }
					widget = { size = { 500 1 } position = { 0 0 } background = { using = color_gold_texture alpha = 0.6 } }
					widget = { size = { 500 1 } position = { 0 63 } background = { using = color_gold_texture alpha = 0.6 } }
					widget = { size = { 1 62 } position = { 0 1 } background = { using = color_gold_texture alpha = 0.6 } }
					widget = { size = { 1 62 } position = { 499 1 } background = { using = color_gold_texture alpha = 0.6 } }
					text_single = { name = "sol_balance_label" size = { 110 28 } position = { 8 8 } autoresize = no fontsize = 14 align = left|nobaseline text = "SOL_C_BALANCE_TITLE" tooltip = "SOL_C_BALANCE_TOOLTIP" alwaystransparent = no }
					widget = { size = { 228 16 } position = { 128 14 }
						widget = { name = "sol_balance_track" size = { 228 16 }
