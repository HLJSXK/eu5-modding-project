					progressbar = { size = { 160 8 } min = 0 max = 1 value = "[FixedPointToFloat(Divide_CFixedPoint(Country.MakeScope.GetVariable('sol_ls_pci').GetValue, Max_CFixedPoint(GetGlobalVariable('sol_ls_top_pci').GetValue, '(CFixedPoint)0.01')))]" progresstexture = "gfx/interface/sol_proto/bar_gold.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
					expand = {}
					text_single = { size = { 60 24 } autoresize = no align = right|nobaseline raw_text = "[Country.MakeScope.GetVariable('sol_ls_pci').GetValue|2] @gold!" }
					widget = { size = { 4 1 } }
				}
				hbox = { name = "sol_lshud4_below_1" size = { 460 24 } visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_below_1').IsSet]" spacing = 6 datacontext = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_below_1').GetCountry]"
					
					text_single = { size = { 34 24 } autoresize = no align = right|nobaseline default_format = "#weak" raw_text = "[Country.MakeScope.GetVariable('sol_ls_rank').GetValue|0]" }
