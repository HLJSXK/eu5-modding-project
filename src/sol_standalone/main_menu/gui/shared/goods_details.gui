template good_sources_tooltip {
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				visible = "[Goods.IsRawMaterial]"
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('raw_material')]"
			}
			icon = {
				visible = "[Not(Goods.IsRawMaterial)]"
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('produced_good')]"
			}
		}
		blockoverride "concept_link" {
			text = "[SelectLocalization(Goods.IsRawMaterial, 'RAW_MATERIAL_LOC', 'PRODUCED_GOOD_LOC')]"
		}
		textcontext = "[Goods.GetSources]"
	}
}

template good_demands_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "game_concept_goods_demands"
		}		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('demand')]"
				texture_density = 2
			}
		}
		blockoverride "concept_link" {
			text = "[goods|e]"
		}
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[Goods.GetDemandsInfo]"
				}
			}
			TooltipScrolledStringPairList = {
				visible = "[Not(StringIsEmpty(Goods.GetDemandsForBuildings))]"
				blockoverride "block_scrollarea" { maximumsize = { -1 300 }}
				textcontext	= "[Goods.GetDemandsForBuildings]"
			}
		}		
	}
}

template good_transport_cost_tooltip {
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/transport_cost.dds"
			}
		}
		blockoverride "concept_link" {
			text = "[merchant_capacity|e]"
		}
		textcontext = "GOODS_TRANSPORT_WEIGHT"
	}
}

template good_food_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('food')]"
			}
		}
		
		blockoverride "title_text" {
			text = "FOOD_POP_PROVIDE_TT_TITLE"
		}
		blockoverride "concept_link" {
			text = "[food|e]"
		}
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "FOOD_POP_PROVIDE"
				}
			}
		}
	}
}

template SOL_goods_price_tiers {
	vbox = { visible = "[Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(Or(EqualTo_string(Goods.GetKey, 'amber'), EqualTo_string(Goods.GetKey, 'beer')), EqualTo_string(Goods.GetKey, 'beeswax')), EqualTo_string(Goods.GetKey, 'books')), EqualTo_string(Goods.GetKey, 'camels')), EqualTo_string(Goods.GetKey, 'chili')), EqualTo_string(Goods.GetKey, 'cloth')), EqualTo_string(Goods.GetKey, 'cloves')), EqualTo_string(Goods.GetKey, 'coal')), EqualTo_string(Goods.GetKey, 'cocoa')), EqualTo_string(Goods.GetKey, 'coffee')), EqualTo_string(Goods.GetKey, 'elephants')), EqualTo_string(Goods.GetKey, 'fine_cloth')), EqualTo_string(Goods.GetKey, 'firearms')), EqualTo_string(Goods.GetKey, 'fish')), EqualTo_string(Goods.GetKey, 'fruit')), EqualTo_string(Goods.GetKey, 'fur')), EqualTo_string(Goods.GetKey, 'furniture')), EqualTo_string(Goods.GetKey, 'gems')), EqualTo_string(Goods.GetKey, 'glass')), EqualTo_string(Goods.GetKey, 'goods_gold')), EqualTo_string(Goods.GetKey, 'horses')), EqualTo_string(Goods.GetKey, 'incense')), EqualTo_string(Goods.GetKey, 'ivory')), EqualTo_string(Goods.GetKey, 'jewelry')), EqualTo_string(Goods.GetKey, 'lacquerware')), EqualTo_string(Goods.GetKey, 'leather')), EqualTo_string(Goods.GetKey, 'legumes')), EqualTo_string(Goods.GetKey, 'liquor')), EqualTo_string(Goods.GetKey, 'livestock')), EqualTo_string(Goods.GetKey, 'lumber')), EqualTo_string(Goods.GetKey, 'maize')), EqualTo_string(Goods.GetKey, 'marble')), EqualTo_string(Goods.GetKey, 'masonry')), EqualTo_string(Goods.GetKey, 'medicaments')), EqualTo_string(Goods.GetKey, 'mercury')), EqualTo_string(Goods.GetKey, 'millet')), EqualTo_string(Goods.GetKey, 'olives')), EqualTo_string(Goods.GetKey, 'paper')), EqualTo_string(Goods.GetKey, 'pearls')), EqualTo_string(Goods.GetKey, 'pepper')), EqualTo_string(Goods.GetKey, 'porcelain')), EqualTo_string(Goods.GetKey, 'potato')), EqualTo_string(Goods.GetKey, 'pottery')), EqualTo_string(Goods.GetKey, 'rice')), EqualTo_string(Goods.GetKey, 'saffron')), EqualTo_string(Goods.GetKey, 'salt')), EqualTo_string(Goods.GetKey, 'silver')), EqualTo_string(Goods.GetKey, 'sugar')), EqualTo_string(Goods.GetKey, 'tea')), EqualTo_string(Goods.GetKey, 'tobacco')), EqualTo_string(Goods.GetKey, 'tools')), EqualTo_string(Goods.GetKey, 'weaponry')), EqualTo_string(Goods.GetKey, 'wheat')), EqualTo_string(Goods.GetKey, 'wild_game')), EqualTo_string(Goods.GetKey, 'wine'))]" layoutpolicy_horizontal = expanding spacing = 4
		text_single = { size = { 420 23 } autoresize = no text = "SOL_GOOD_PRICE_TIERS" fontsize = 15 align = left|nobaseline }
		divider_center_gold = {}
		hbox = { layoutpolicy_horizontal = expanding spacing = 2
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_0"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#G ×2#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = "<0.40" }
			}
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_1"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#G ×1.5#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = "<0.65" }
			}
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_2"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#G ×1.25#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = "<0.85" }
			}
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_3"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#E ×1#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = "0.85–1.30" }
			}
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_4"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#R ×0.75#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = ">1.30" }
			}
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_5"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#R ×0.5#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = ">1.70" }
			}
			vbox = { size = { 58 40 } layoutpolicy_horizontal = fixed spacing = 2 using = bg_number_container_bckg tooltip = "SOL_GOOD_PRICE_TIER_6"
				text_single = { size = { 58 19 } autoresize = no align = center fontsize = 13 raw_text = "#R ×0.25#!" }
				text_single = { size = { 58 17 } autoresize = no align = center fontsize = 11 raw_text = ">2.30" }
			}
		}
	}
