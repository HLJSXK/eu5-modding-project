									icon = { size = { 100% 100% } parentanchor = center texture = "gfx/interface/icons/trade_goods/icon_goods_books.dds" }
									icon = { size = { 100% 100% } parentanchor = center alpha = "0.3" visible = "[Not(GreaterThan_CFixedPoint(GetVariableFromGlobalVariableMap('sol_market_consumes_books', Location.GetMarket.MakeScope).GetValue,'(CFixedPoint)0'))]" texture = "gfx/interface/icons/trade_goods/icon_goods_books.dds" }
								}
							}
						}
						expand = {}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						sol_group_row = {
							blockoverride "sol_group_label" { text = "SOL_SUBGROUP_UNGROUPED" }
							blockoverride "sol_group_icons" {
								widget = {
									size = { 20 24 }
									blockoverride "sol_good_tooltip" { tooltip = "victuals" }
									icon = { size = { 100% 100% } parentanchor = center texture = "gfx/interface/icons/trade_goods/icon_goods_victuals.dds" }
									icon = { size = { 100% 100% } parentanchor = center alpha = "0.3" visible = "[Not(GreaterThan_CFixedPoint(GetVariableFromGlobalVariableMap('sol_market_consumes_victuals', Location.GetMarket.MakeScope).GetValue,'(CFixedPoint)0'))]" texture = "gfx/interface/icons/trade_goods/icon_goods_victuals.dds" }
								}
							}
						}
						expand = {}
					}
				}
			}
		}
	}
}
