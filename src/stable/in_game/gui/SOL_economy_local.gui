					# Row: protein demand ±%
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_PROTEIN_TITLE" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_protein_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_protein_demand_scale_offset')|+=0%]" }
