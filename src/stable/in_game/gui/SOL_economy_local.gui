					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_INTOXICANTS_TITLE" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_intoxicants_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_intoxicants_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_intoxicants_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoners_intoxicants_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "-" }
