template StandardofLiving_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = { name = "gold" using = tooltip_title_icon_size texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
		}
		blockoverride "title_text" { datacontext = "[Location]" text = "LOCATION_SOL_GUI_TITLE" }
		blockoverride "tooltip_content" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				TooltipTextBlock = { blockoverride "text" { text = "SOL_GUI_SECTION_INCOME" } }
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 2
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding raw_text = " " }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_NOBLES" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_CLERGY" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_BURGHERS" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_COMMONERS" }
						text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_TRIBESMEN" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_GUI_ROW_STRATUM_INCOME" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_noble_gdp_display')|2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_gdp_display')|2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_gdp_display')|2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_gdp_display')|2]" }
						text_single = { min_width = 72 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_tribesmen_gdp_display')|2]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_GUI_ROW_TOTAL_INCOME" }
						text_single = { min_width = 360 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_sol_total_income')|2]" }
					}
				}
				TooltipTextBlock = { blockoverride "text" { text = "SOL_GUI_SECTION_SAVINGS" } }
