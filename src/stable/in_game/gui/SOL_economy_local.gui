					# Row: luxury_drinks demand ±%
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_LUXURY_DRINKS_TITLE" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_luxury_drinks_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_luxury_drinks_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_luxury_drinks_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoners_luxury_drinks_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "-" }
					}

					# Row: luxury_food demand ±%
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_LUXURY_FOOD_TITLE" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_luxury_food_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_luxury_food_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_luxury_food_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoners_luxury_food_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "-" }
					}

					# Row: luxury_goods demand ±%
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_LUXURY_GOODS_TITLE" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_luxury_goods_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_luxury_goods_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_luxury_goods_demand_scale_offset')|+=0%]" }
						text_single = { min_width = 68 align = hcenter raw_text = "-" }
