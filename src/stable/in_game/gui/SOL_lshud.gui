					widget = { size = { 500 1 } position = { 0 63 } background = { using = color_gold_texture alpha = 0.6 } }
					widget = { size = { 1 62 } position = { 0 1 } background = { using = color_gold_texture alpha = 0.6 } }
					widget = { size = { 1 62 } position = { 499 1 } background = { using = color_gold_texture alpha = 0.6 } }
					text_single = { name = "sol_balance_label" size = { 110 28 } position = { 8 8 } autoresize = no fontsize = 14 align = left|nobaseline text = "SOL_C_BALANCE_TITLE" tooltip = "SOL_C_BALANCE_TOOLTIP" alwaystransparent = no }
					widget = { size = { 244 16 } position = { 128 14 }
						widget = { name = "sol_balance_track" size = { 244 16 }
