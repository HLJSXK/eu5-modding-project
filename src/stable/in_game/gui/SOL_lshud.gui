template SOL_LSHUD4_tooltip_3 {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/flat_icons/trade_market/our_needs.dds" texture_density = 2 } }
		blockoverride "title_text" { text = "SOL_LSHUD4_T3_TITLE" }
		blockoverride "concept_link_obj" {
            text_multi = { layoutpolicy_horizontal = expanding max_width = 408 autoresize = yes
                fontsize = 13 default_format = "#weak" text = "SOL_LSHUD4_T3_SUB" }
        }
		blockoverride "tooltip_content" {
			hbox = { layoutpolicy_horizontal = expanding
				text_single = { autoresize = yes fontsize = 14 text = "SOL_GUI_SECTION_COUNTRY_GOODS" }
				expand = {}
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 0 2 }
				spacing = 4
				hbox = { size = { -1 16 } layoutpolicy_horizontal = expanding spacing = 5 margin = { 0 1 }
					icon = { size = { 16 16 } texture = "gfx/interface/sol_proto/tier_need.dds" texture_density = 2 }
					text_single = { autoresize = yes fontsize = 11 align = left|nobaseline text = "SOL_SUBTIER_REQUIRED" }
					expand = {}
				}
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					sol_group_row = {
						size = { 122 66 }
						layoutpolicy_horizontal = fixed
						blockoverride "sol_group_header" { size = { 114 17 } layoutpolicy_horizontal = fixed }
						blockoverride "sol_group_label" { size = { 84 17 } text = "SOL_SUBGROUP_STAPLE" tooltip = "SOL_SUBGROUP_STAPLE" }
						blockoverride "sol_group_count" { raw_text = "[Add_int32(Add_int32(Add_int32(Add_int32(Add_int32(Add_int32('(int32)0', Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_rice', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_rice', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_millet', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_millet', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_maize', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_maize', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_potato', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_potato', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_legumes', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_legumes', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0'))]/6" }
						blockoverride "sol_group_progress" { size = { 114 3 } max = 6 value = "[Add_int32(Add_int32(Add_int32(Add_int32(Add_int32(Add_int32('(int32)0', Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_rice', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_rice', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_millet', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_millet', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_maize', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_maize', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_potato', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_potato', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0')), Select_int32(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_legumes', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_legumes', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'), '(int32)1', '(int32)0'))]" }
						blockoverride "sol_group_icons" {
							hbox = { size = { 113 36 } layoutpolicy_horizontal = fixed spacing = 1
								widget = {
									size = { 18 36 }
									tooltip = "@wheat! [Localize('wheat')][Localize('NEWLINE_BREAK')][Localize('SOL_GOOD_SUB_wheat')][Localize('NEWLINE_BREAK')][Localize('SOL_SUB_MULTIPLIER')] [Player.MakeScope.ScriptValue('sol_substitute_wheat_display')|2][Localize('NEWLINE_BREAK')][SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), 'SOL_SUB_ACTIVE', SelectLocalization(GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)0'), 'SOL_SUB_PENDING', 'SOL_SUB_DISABLED'))]"
									icon = { size = { 18 18 } visible = "[GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0')]" texture = "gfx/interface/icons/trade_goods/icon_goods_wheat.dds" }
									icon = { size = { 18 18 } alpha = "0.3" visible = "[Not(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_wheat', Player.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'))]" texture = "gfx/interface/icons/trade_goods/icon_goods_wheat.dds" }
									text_single = { size = { 18 18 } autoresize = no fontsize = 14 position = { 0 18 } align = center|nobaseline raw_text = "@arrow_malus_tier_3!" visible = "[And(GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), LessThan_CFixedPoint(Player.MakeScope.ScriptValue('sol_substitute_wheat_display'), '(CFixedPoint)0.5'))]" }
