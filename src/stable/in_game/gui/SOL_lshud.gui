									progressbar = { name = "sol_balance_positive" size = { 122 12 } min = 0 max = 1 value = "[FixedPointToFloat(Select_CFixedPoint(GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_base_spending_display'), '(CFixedPoint)0'), Divide_CFixedPoint(Min_CFixedPoint(Max_CFixedPoint(Subtract_CFixedPoint(Divide_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_liquid_funds_display'), Max_CFixedPoint(Player.MakeScope.ScriptValue('gls_country_base_spending_display'), '(CFixedPoint)0.0001')), '(CFixedPoint)1'), '(CFixedPoint)0'), '(CFixedPoint)2'), '(CFixedPoint)2'), '(CFixedPoint)0'))]" progresstexture = "gfx/interface/sol_proto/bar_green.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
