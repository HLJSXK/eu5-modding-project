situation_panel = {
	blockoverride "situation_subheader_content" {}

	blockoverride "situation_panel_image" {
		background = {
			texture = "gfx/interface/illustrations/situation/columbian_exchange.dds"
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_horizontal_middle.dds"
				texture_density = 2
				spriteType = stretched
				spriteborder = { 250 250 }
				blend_mode = alphamultiply
				alpha = 0.4
			}
		}
		background = {
			using = color_dark_blue_texture
			alpha = 1
			margin_top = -140
			modify_texture = {
				using = bg_fade_vertical_up_mask_texture
				blend_mode = alphamultiply
				alpha = 1
			}
		}
	}

	blockoverride "situation_panel_main_content" {

		# Section 0: System note
		situation_card_common = {
			blockoverride "header_size" { size = { -1 0 } }
			blockoverride "header_decor_templates" {}
			blockoverride "common_header_icon_texture" {}
			blockoverride "common_header_text_full" {}
			blockoverride "common_bottom_content" {
				text_multi = {
					margin = { 15 0 }
					layoutpolicy_horizontal = expanding
					max_width = 720
					autoresize = yes
					text = "GLS_PANEL_INFO_BODY"
				}
			}
		}

		# Section 1: National SOL Overview
		situation_card_common = {
			blockoverride "header_size" { size = { -1 0 } }
			blockoverride "header_decor_templates" {}
			blockoverride "common_header_icon_texture" {}
			blockoverride "common_header_text_full" {}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6
					margin = { 8 6 }

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_ALL" }
						text_single = { text = "[Player.MakeScope.GetVariable('gls_country_sol_all').GetValue|2]" }
					}

					# Row: estate icon + name
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = " " }

						vbox = {
							min_width = 72
							visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]"
							text_single = {
								max_width = 72
								align = hcenter
								text = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').GetName]"
							}
						}

						vbox = {
							min_width = 72
							visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]"
							text_single = {
								max_width = 72
								align = hcenter
								text = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').GetName]"
							}
						}

						vbox = {
							min_width = 72
							visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]"
							text_single = {
								max_width = 72
								align = hcenter
								text = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').GetName]"
							}
						}

						vbox = {
							min_width = 72
							visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]"
							text_single = {
								max_width = 72
								align = hcenter
								text = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').GetName]"
							}
						}

						vbox = {
							min_width = 72
							visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]"
							text_single = {
								max_width = 72
								align = hcenter
								text = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').GetName]"
							}
						}
					}

					# Row: power piechart + percentage
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_ESTATE_POWER" }

						hbox = {
							min_width = 72
							spacing = 4
							visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]"
							expand = {}
							piechart = {
								datacontext = "[Player.GetGovernment.GetEstateFromKey('nobles_estate')]"
								size = { 24 24 }
								using = piechart_angles
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
									value = "[FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('nobles_estate').GetRelativePower)]"
									color = { 1 1 1 1 }
								}
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
									value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('nobles_estate').GetRelativePower))]"
									color = { 1 1 1 1 }
								}
								icon = {
									parentanchor = center
									size = { 12 12 }
									texture = "gfx/interface/icons/sort/power_white.dds"
									texture_density = 2
								}
								using = bg_circle_piechart
								tooltipwidget = { using = estate_relative_power_tooltip }
							}
							text_single = {
								raw_text = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').GetRelativePower|0%]"
							}
							expand = {}
						}

						hbox = {
							min_width = 72
							spacing = 4
							visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]"
							expand = {}
							piechart = {
								datacontext = "[Player.GetGovernment.GetEstateFromKey('clergy_estate')]"
								size = { 24 24 }
								using = piechart_angles
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
									value = "[FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('clergy_estate').GetRelativePower)]"
									color = { 1 1 1 1 }
								}
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
									value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('clergy_estate').GetRelativePower))]"
									color = { 1 1 1 1 }
								}
								icon = {
									parentanchor = center
									size = { 12 12 }
									texture = "gfx/interface/icons/sort/power_white.dds"
									texture_density = 2
								}
								using = bg_circle_piechart
								tooltipwidget = { using = estate_relative_power_tooltip }
							}
							text_single = {
								raw_text = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').GetRelativePower|0%]"
							}
							expand = {}
						}

						hbox = {
							min_width = 72
							spacing = 4
							visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]"
							expand = {}
							piechart = {
								datacontext = "[Player.GetGovernment.GetEstateFromKey('burghers_estate')]"
								size = { 24 24 }
								using = piechart_angles
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
									value = "[FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('burghers_estate').GetRelativePower)]"
									color = { 1 1 1 1 }
								}
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
									value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('burghers_estate').GetRelativePower))]"
									color = { 1 1 1 1 }
								}
								icon = {
									parentanchor = center
									size = { 12 12 }
									texture = "gfx/interface/icons/sort/power_white.dds"
									texture_density = 2
								}
								using = bg_circle_piechart
								tooltipwidget = { using = estate_relative_power_tooltip }
							}
							text_single = {
								raw_text = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').GetRelativePower|0%]"
							}
							expand = {}
						}

						hbox = {
							min_width = 72
							spacing = 4
							visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]"
							expand = {}
							piechart = {
								datacontext = "[Player.GetGovernment.GetEstateFromKey('peasants_estate')]"
								size = { 24 24 }
								using = piechart_angles
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
									value = "[FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('peasants_estate').GetRelativePower)]"
									color = { 1 1 1 1 }
								}
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
									value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('peasants_estate').GetRelativePower))]"
									color = { 1 1 1 1 }
								}
								icon = {
									parentanchor = center
									size = { 12 12 }
									texture = "gfx/interface/icons/sort/power_white.dds"
									texture_density = 2
								}
								using = bg_circle_piechart
								tooltipwidget = { using = estate_relative_power_tooltip }
							}
							text_single = {
								raw_text = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').GetRelativePower|0%]"
							}
							expand = {}
						}

						hbox = {
							min_width = 72
							spacing = 4
							visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]"
							expand = {}
							piechart = {
								datacontext = "[Player.GetGovernment.GetEstateFromKey('tribes_estate')]"
								size = { 24 24 }
								using = piechart_angles
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
									value = "[FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('tribes_estate').GetRelativePower)]"
									color = { 1 1 1 1 }
								}
								pieslice_no_highlight = {
									texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
									value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetEstateFromKey('tribes_estate').GetRelativePower))]"
									color = { 1 1 1 1 }
								}
								icon = {
									parentanchor = center
									size = { 12 12 }
									texture = "gfx/interface/icons/sort/power_white.dds"
									texture_density = 2
								}
								using = bg_circle_piechart
								tooltipwidget = { using = estate_relative_power_tooltip }
							}
							text_single = {
								raw_text = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').GetRelativePower|0%]"
							}
							expand = {}
						}
					}

					# Row: population
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_POP_COUNT" }
						hbox = {
							min_width = 72
							spacing = 3
							visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]"
							expand = {}
							icon = { texture = "gfx/interface/icons/pops/nobles.dds" size = { 18 18 } texture_density = 2 }
							text_single = { text = "[Player.MakeScope.GetVariable('gls_pop_nobles').GetValue|1]" }
							text_single = { raw_text = "K" }
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 3
							visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]"
							expand = {}
							icon = { texture = "gfx/interface/icons/pops/clergy.dds" size = { 18 18 } texture_density = 2 }
							text_single = { text = "[Player.MakeScope.GetVariable('gls_pop_clergy').GetValue|1]" }
							text_single = { raw_text = "K" }
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 3
							visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]"
							expand = {}
							icon = { texture = "gfx/interface/icons/pops/burghers.dds" size = { 18 18 } texture_density = 2 }
							text_single = { text = "[Player.MakeScope.GetVariable('gls_pop_burghers').GetValue|1]" }
							text_single = { raw_text = "K" }
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 3
							visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]"
							expand = {}
							icon = { texture = "gfx/interface/icons/pops/peasants.dds" size = { 18 18 } texture_density = 2 }
							text_single = { text = "[Player.MakeScope.GetVariable('gls_pop_commoners').GetValue|1]" }
							text_single = { raw_text = "K" }
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 3
							visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]"
							expand = {}
							icon = { texture = "gfx/interface/icons/pops/tribesmen.dds" size = { 18 18 } texture_density = 2 }
							text_single = { text = "[Player.MakeScope.GetVariable('gls_pop_tribesmen').GetValue|1]" }
							text_single = { raw_text = "K" }
							expand = {}
						}
					}

					# Row: SOL per estate
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_SOL_PER_ESTATE" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_country_sol_nobles').GetValue|2]" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_country_sol_clergy').GetValue|2]" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_country_sol_burghers').GetValue|2]" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_country_sol_commoners').GetValue|2]" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_country_sol_tribesmen').GetValue|2]" }
					}
				}
			}
		}

		# Section 2: First modifier — income / wealth
		situation_card_common = {
			blockoverride "header_size" { size = { -1 0 } }
			blockoverride "header_decor_templates" {}
			blockoverride "common_header_icon_texture" {}
			blockoverride "common_header_text_full" {}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6
					margin = { 8 6 }

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_COUNTRY_WEALTH" }
						text_single = { text = "[Player.MakeScope.GetVariable('gls_country_wealth').GetValue|2]" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_AVG_CONTROL" }
						text_single = { text = "[Player.MakeScope.GetVariable('gls_avg_control').GetValue|%1]" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = " " }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_NOBLES" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_CLERGY" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_BURGHERS" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_COMMONERS" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_TRIBESMEN" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_TAX_SHARE" }
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_nobles_tax_pct').GetValue|%1]" }
							widget = {
								size = { 14 14 }
								icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
								widget = {
									parentanchor = top|right
									position = { -4 -2 }
									icon = {
										size = { 7 7 }
										texture = "gfx/interface/icons/flat_icons/arrow.dds"
										modify_texture = { using = color_light_green_texture }
									}
								}
							}
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_clergy_tax_pct').GetValue|%1]" }
							widget = {
								size = { 14 14 }
								icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
								widget = {
									parentanchor = top|right
									position = { -4 -2 }
									icon = {
										size = { 7 7 }
										texture = "gfx/interface/icons/flat_icons/arrow.dds"
										modify_texture = { using = color_light_green_texture }
									}
								}
							}
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_burghers_tax_pct').GetValue|%1]" }
							widget = {
								size = { 14 14 }
								icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
								widget = {
									parentanchor = top|right
									position = { -4 -2 }
									icon = {
										size = { 7 7 }
										texture = "gfx/interface/icons/flat_icons/arrow.dds"
										modify_texture = { using = color_light_green_texture }
									}
								}
							}
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_commoner_tax_pct').GetValue|%1]" }
							widget = {
								size = { 14 14 }
								icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
								widget = {
									parentanchor = top|right
									position = { -4 -2 }
									icon = {
										size = { 7 7 }
										texture = "gfx/interface/icons/flat_icons/arrow.dds"
										modify_texture = { using = color_light_green_texture }
									}
								}
							}
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_tribesmen_tax_pct').GetValue|%1]" }
							widget = {
								size = { 14 14 }
								icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
								widget = {
									parentanchor = top|right
									position = { -4 -2 }
									icon = {
										size = { 7 7 }
										texture = "gfx/interface/icons/flat_icons/arrow.dds"
										modify_texture = { using = color_light_green_texture }
									}
								}
							}
							expand = {}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_WEALTH_ANCHOR" }
						hbox = {
							spacing = 2
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_country_wealth_anchor_cached').GetValue|2]" }
							icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
							expand = {}
						}
					}
				}
			}
		}

		# Section 3: Second modifier — savings
		situation_card_common = {
			blockoverride "header_size" { size = { -1 0 } }
			blockoverride "header_decor_templates" {}
			blockoverride "common_header_icon_texture" {}
			blockoverride "common_header_text_full" {}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6
					margin = { 8 6 }

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = " " }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_NOBLES" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_CLERGY" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_BURGHERS" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_COMMONERS" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_TRIBESMEN" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_SAVINGS" }
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_nobles_gold').GetValue|0]" }
							icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 2
							visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]"
							expand = {}
							text_single = { text = "[Player.MakeScope.GetVariable('gls_clergy_gold').GetValue|0]" }
							icon = { size = { 14 14 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
							expand = {}
						}
						hbox = {
							min_width = 72
							spacing = 2
