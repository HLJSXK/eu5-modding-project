									}
									widget = {
										size = { 20 24 }
										blockoverride "sol_good_tooltip" { tooltip = "elephants" }
										icon = { size = { 100% 100% } parentanchor = center texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" }
										icon = { size = { 100% 100% } parentanchor = center alpha = "0.3" visible = "[Not(GreaterThan_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_elephants', Player.MakeScope).GetValue,'(CFixedPoint)0'))]" texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" }
									}
								}
							}
							sol_group_row = {
								blockoverride "sol_group_label" { text = "SOL_SUBGROUP_KNOWLEDGE" }
								blockoverride "sol_group_icons" {
									widget = {
										size = { 20 24 }
										blockoverride "sol_good_tooltip" { tooltip = "books" }
										icon = { size = { 100% 100% } parentanchor = center texture = "gfx/interface/icons/trade_goods/icon_goods_books.dds" }
										icon = { size = { 100% 100% } parentanchor = center alpha = "0.3" visible = "[Not(GreaterThan_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_books', Player.MakeScope).GetValue,'(CFixedPoint)0'))]" texture = "gfx/interface/icons/trade_goods/icon_goods_books.dds" }
									}
								}
							}
							expand = {}
						}
					}
				}
			}
		}
	}
}
