situation_panel = {
	blockoverride "situation_subheader_content" {}

	blockoverride "situation_panel_image" {
		background = { texture = "gfx/interface/illustrations/situation/columbian_exchange.dds" modify_texture = { texture = "gfx/interface/component_masks/mask_fade_horizontal_middle.dds" texture_density = 2 spriteType = stretched spriteborder = { 250 250 } blend_mode = alphamultiply alpha = 0.4 } }
		background = { using = color_dark_blue_texture alpha = 1 margin_top = -140 modify_texture = { using = bg_fade_vertical_up_mask_texture blend_mode = alphamultiply alpha = 1 } }
	}

	blockoverride "situation_panel_main_content" {
		situation_card_common = {
			blockoverride "header_size" { size = { -1 0 } }
			blockoverride "header_decor_templates" {}
			blockoverride "common_header_icon_texture" {}
			blockoverride "common_header_text_full" {}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6
					margin = { 8 6 }
					text_single = { layoutpolicy_horizontal = expanding align = hcenter text = "SOL_GUI_SECTION_INCOME" }
					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 4 }
						spacing = 2
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = { layoutpolicy_horizontal = expanding raw_text = " " }
							text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_NOBLES" }
							text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_CLERGY" }
							text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_BURGHERS" }
							text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_COMMONERS" }
							text_single = { min_width = 72 align = hcenter text = "GLS_UI_ESTATE_TRIBESMEN" }
						}
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = { layoutpolicy_horizontal = expanding text = "SOL_GUI_ROW_STRATUM_INCOME" }
							text_single = { min_width = 72 align = hcenter raw_text = "[Player.MakeScope.GetVariable('gls_income_nobles').GetValue|2]" }
							text_single = { min_width = 72 align = hcenter raw_text = "[Player.MakeScope.GetVariable('gls_income_clergy').GetValue|2]" }
							text_single = { min_width = 72 align = hcenter raw_text = "[Player.MakeScope.GetVariable('gls_income_burghers').GetValue|2]" }
							text_single = { min_width = 72 align = hcenter raw_text = "[Player.MakeScope.GetVariable('gls_income_commoners').GetValue|2]" }
							text_single = { min_width = 72 align = hcenter raw_text = "[Player.MakeScope.GetVariable('gls_income_tribesmen').GetValue|2]" }
						}
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = { layoutpolicy_horizontal = expanding text = "SOL_GUI_ROW_TOTAL_INCOME" }
							text_single = { min_width = 360 align = hcenter raw_text = "[Player.MakeScope.GetVariable('gls_total_income').GetValue|2]" }
						}
					}
				}
			}
		}

		situation_card_common = {
			blockoverride "header_size" { size = { -1 0 } }
			blockoverride "header_decor_templates" {}
