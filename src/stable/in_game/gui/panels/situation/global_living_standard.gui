						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]" text = "GLS_UI_ESTATE_TRIBESMEN" }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "GLS_UI_LINE_ESTIMATED_DEMAND" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_demand_nobles').GetValue|%+=1]" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('clergy_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_demand_clergy').GetValue|%+=1]" }
						text_single = { min_width = 72 align = hcenter visible = "[Player.GetGovernment.GetEstateFromKey('burghers_estate').ExistsForCountry]" text = "[Player.MakeScope.GetVariable('gls_demand_burghers').GetValue|%+=1]" }
