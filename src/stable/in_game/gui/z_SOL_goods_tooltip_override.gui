		layoutpolicy_horizontal = expanding
		spacing = 3
		margin = { 4 4 }
		using = bg_listbase_template
		text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_STANDARD_CLOTHING_TITLE" }
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			hbox = {
				text_single = { text = "SOL_SUBST_FROM_cloth" }
				icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_cloth.dds" }
			}
			hbox = {
				text_single = { text = "SOL_SUBST_RATIO_cloth_fine_cloth" }
				icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_fine_cloth.dds" }
			}
		}
	}
}

