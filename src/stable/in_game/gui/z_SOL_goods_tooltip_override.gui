# ============================================================
#  Per-good static ratio templates (SOL_subst_ratios_{good})
#  Each shows only the outgoing ratios for that specific good.
#  Scope-agnostic: static text + icons, no ScriptValue calls.
#  AUTO-GENERATED by scripts/gen_scarcity.py — do not edit by hand.
# ============================================================

template SOL_subst_ratios_cloth {
	vbox = {
		layoutpolicy_horizontal = expanding
		spacing = 3
		margin = { 4 4 }
		using = bg_listbase_template
		text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_BASIC_CLOTHING_TITLE" }
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			hbox = {
				text_single = { text = "SOL_SUBST_FROM_cloth" }
				icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_cloth.dds" }
			}
			hbox = {
				text_single = { text = "SOL_SUBST_RATIO_cloth_leather" }
				icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_leather.dds" }
			}
		}
	}
}

