                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_fish_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_fish_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
