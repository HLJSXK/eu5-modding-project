                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_victuals_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_victuals_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
