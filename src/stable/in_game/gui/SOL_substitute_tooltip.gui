# ============================================================
#  GROUP: Medicine  (medicaments, mercury)
# ============================================================
template SOL_medicine_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_medicaments.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_MEDICINE_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_MEDICINE_DESC" }
