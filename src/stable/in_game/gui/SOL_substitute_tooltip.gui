# ============================================================
#  GROUP: Luxury Food  (wild_game, victuals, fruit)
# ============================================================
template SOL_luxury_food_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_wild_game.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_LUXURY_FOOD_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_LUXURY_FOOD_DESC" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    # Header
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LIST_HEADER" }
                        text_single = { min_width = 55 align = hcenter text = "SOL_TT_STATUS_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_WEIGHT_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_DEMAND_HEADER" }
                    }
                    # Row: wild_game
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_wild_game.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_WILD_GAME" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_scarcity_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_scarcity_tier'), '(CFixedPoint)1')))]"     text = "SOL_TT_STATUS_MILD" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_surplus_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_surplus_tier'), '(CFixedPoint)2')))]"    text = "SOL_TT_STATUS_CHEAP" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_wild_game_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
