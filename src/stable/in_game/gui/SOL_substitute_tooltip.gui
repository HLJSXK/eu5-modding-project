# ============================================================
#  GROUP: Mounts  (horses, elephants)
# ============================================================
template SOL_mounts_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_horses.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_MOUNTS_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_MOUNTS_DESC" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    # Header
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LIST_HEADER" }
                        text_single = { min_width = 55 align = hcenter text = "SOL_TT_STATUS_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_WEIGHT_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_DEMAND_HEADER" }
                    }
                    # Row: horses
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_horses.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_HORSES" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)1')))]"     text = "SOL_TT_STATUS_MILD" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)2')))]"    text = "SOL_TT_STATUS_CHEAP" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_horses')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_horses')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_horses')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_horses')|0]%#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_horses')|0]%" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_horses_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_horses')|0]%#!" }
                    }
                    # Row: elephants
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_ELEPHANTS" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)1')))]"     text = "SOL_TT_STATUS_MILD" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)2')))]"    text = "SOL_TT_STATUS_CHEAP" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_elephants')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_elephants')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_elephants')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_elephants')|0]%#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_elephants')|0]%" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_elephants_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_elephants')|0]%#!" }
                    }
                }
                # ── Income & Demand Correction ─────────────────────────────────
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_SOL_HEADER" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding raw_text = " " }
                        text_single = { min_width = 68 align = hcenter text = "GLS_TT_ROW_GDP_PC" }
                        text_single = { min_width = 68 align = hcenter text = "GLS_TT_ROW_SAV_DEMAND" }
                        text_single = { min_width = 68 align = hcenter text = "SOL_TT_ROW_DEMAND_CORRECTION" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('nobles'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_noble_gdp_per_capita_display')|+2]" }
