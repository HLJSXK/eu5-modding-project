
# ============================================================
# SOL Substitute Goods Scarcity Tooltips
# ============================================================
# One ContextualTooltipType template per substitute group.
# Replaces the simple tooltip = "SOL_ICON_*_SCARCE_TT" on the
# population-tab icons in location_window.gui.
#
# Each template shows:
#   - Group title + icon
#   - Short description
#   - Per-good table: icon | name | SCARCE/OK | demand impact
#
# Demand share column (weight-based, 0–100%):
#   - SCARCE good:  #R X%#!  (share reduced; weight -= 0.5 via SOL_WEIGHT_SCARCE)
#   - OK good:      X%       (baseline or elevated share)
#   - victuals row only visible when compat is active (share > 0)
#
# Script values used: SOL_substitute_good_indicators.txt
# Localization keys:  SOL_substitute_goods_l_english.yml
# ============================================================

# Shorthand macros for the per-good row visibility expressions.
# SCARCE:   GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_X_scarce'), '(CFixedPoint)0')
# NOT-SCARCE: Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_X_scarce'), '(CFixedPoint)0'))
# (Inlined directly to avoid needing template support in Jomini)

# ──────────────────────────────────────────────────────────────
#  Helper template — one goods row
#  Not used directly; pattern is replicated per row below
#  because good name and variable names must be hardcoded.
# ──────────────────────────────────────────────────────────────

# @GEN_BEGIN:templates
# ============================================================
#  GROUP: Basic Clothing  (cloth, leather)
# ============================================================
template SOL_basic_clothing_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_leather.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_BASIC_CLOTHING_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_BASIC_CLOTHING_DESC" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    # Header
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LIST_HEADER" }
                        text_single = { min_width = 55 align = hcenter text = "SOL_TT_STATUS_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_WEIGHT_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_DEMAND_HEADER" }
                    }
                    # Row: cloth
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_cloth.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_CLOTH" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)1')))]"     text = "SOL_TT_STATUS_MILD" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)2')))]"    text = "SOL_TT_STATUS_CHEAP" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_cloth')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_cloth')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_cloth')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_cloth')|0]%#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_cloth')|0]%" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_cloth_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_cloth')|0]%#!" }
                    }
                    # Row: leather
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_leather.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LEATHER" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)1')))]"     text = "SOL_TT_STATUS_MILD" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)2')))]"    text = "SOL_TT_STATUS_CHEAP" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_leather')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_leather')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_leather')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_leather')|0]%#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_leather')|0]%" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_leather_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_leather')|0]%#!" }
                    }
                }
                # ── Income & Demand Correction ─────────────────────────────────
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_SOL_HEADER" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding raw_text = " " }
                        text_single = { min_width = 68 align = hcenter text = "GLS_TT_ROW_GDP_PC" }
                        text_single = { min_width = 68 align = hcenter text = "GLS_TT_ROW_SAV_DEMAND" }
                        text_single = { min_width = 68 align = hcenter text = "SOL_TT_ROW_DEMAND_CORRECTION" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('nobles'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_noble_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_basic_clothing_demand_scale_offset')|+=0%]" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('clergy'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_clergy_basic_clothing_demand_scale_offset')|+=0%]" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('burghers'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_basic_clothing_demand_scale_offset')|+=0%]" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('laborers'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoners_basic_clothing_demand_scale_offset')|+=0%]" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('peasants'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoner_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_commoners_basic_clothing_demand_scale_offset')|+=0%]" }
                    }
                }
            }
        }
    }
}


# ============================================================
#  GROUP: Crude Goods  (lumber, masonry, tools, pottery)
# ============================================================
template SOL_crude_goods_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_tools.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_CRUDE_GOODS_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_CRUDE_GOODS_DESC" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    # Header
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LIST_HEADER" }
                        text_single = { min_width = 55 align = hcenter text = "SOL_TT_STATUS_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_WEIGHT_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_DEMAND_HEADER" }
                    }
                    # Row: lumber
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_lumber.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LUMBER" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)1')))]"     text = "SOL_TT_STATUS_MILD" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)0')))]"   text = "SOL_TT_STATUS_OK" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)0'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)1')))]"   text = "SOL_TT_STATUS_AFFORDABLE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)2')))]"    text = "SOL_TT_STATUS_CHEAP" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_lumber')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_lumber')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_lumber')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_lumber')|0]%#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_lumber')|0]%" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_lumber_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_lumber')|0]%#!" }
                    }
                    # Row: masonry
