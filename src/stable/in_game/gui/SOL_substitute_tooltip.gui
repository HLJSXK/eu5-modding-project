                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_ivory')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_ivory')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_ivory')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_offset_ivory')|+=0%]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_offset_ivory')|+=0%]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_ivory_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_offset_ivory')|+=0%]#!" }
                    }
                    # Row: pearls
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_pearls.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_PEARLS" }
