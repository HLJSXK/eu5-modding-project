                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_tobacco_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_tobacco')|2]#!" }
