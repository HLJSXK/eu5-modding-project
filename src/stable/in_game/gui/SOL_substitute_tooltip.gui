# ============================================================
template SOL_luxury_drinks_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_tea.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_LUXURY_DRINKS_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_LUXURY_DRINKS_DESC" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    # Header
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LIST_HEADER" }
                        text_single = { min_width = 55 align = hcenter text = "SOL_TT_STATUS_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_WEIGHT_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_DEMAND_HEADER" }
                    }
                    # Row: tea
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_tea.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_TEA" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_tea_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
