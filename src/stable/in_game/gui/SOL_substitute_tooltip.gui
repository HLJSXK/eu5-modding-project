                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_surplus_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_VCHEAP" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_weight_indicator_glass')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_weight_indicator_glass')|2]" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_weight_indicator_glass')|2]#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_scarcity_tier'), '(CFixedPoint)0')]"
                            raw_text = "#R [Location.MakeScope.ScriptValue('sol_demand_share_glass')|0]%#!" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[And(Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_scarcity_tier'), '(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_surplus_tier'), '(CFixedPoint)0')))]"
                            raw_text = "[Location.MakeScope.ScriptValue('sol_demand_share_glass')|0]%" }
                        text_single = { min_width = 50 align = hcenter
                            visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_glass_surplus_tier'), '(CFixedPoint)0')]"
                            raw_text = "#G [Location.MakeScope.ScriptValue('sol_demand_share_glass')|0]%#!" }
                    }
                }
                # ── Income & Demand Correction ─────────────────────────────────
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_SOL_HEADER" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding raw_text = " " }
                        text_single = { min_width = 68 align = hcenter text = "GLS_TT_ROW_GDP_PC" }
                        text_single = { min_width = 68 align = hcenter text = "GLS_TT_ROW_SAV_DEMAND" }
                        text_single = { min_width = 68 align = hcenter text = "SOL_TT_ROW_DEMAND_CORRECTION" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('nobles'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_noble_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_nobles_luxury_goods_demand_scale_offset')|+=0%]" }
                    }
                    hbox = {
                        visible = "[ObjectsEqual(GetPopTypeByName('burghers'), PopType.Self)]"
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_CURRENT_CLASS" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_gdp_per_capita_display')|+2]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_savings_pressure')|+=0%]" }
                        text_single = { min_width = 68 align = hcenter raw_text = "[Location.MakeScope.ScriptValue('local_burghers_luxury_goods_demand_scale_offset')|+=0%]" }
                    }
                }
            }
        }
    }
}


# ============================================================
#  GROUP: Protein Food  (fish, wild_game, livestock)
# ============================================================
template SOL_protein_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_fish.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_PROTEIN_TITLE" }
        blockoverride "tooltip_content" {
            vbox = {
                layoutpolicy_horizontal = expanding
                TooltipTextBlock = {
                    blockoverride "text" { text = "SOL_TT_PROTEIN_DESC" }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 4 }
                    spacing = 2
                    # Header
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_LIST_HEADER" }
                        text_single = { min_width = 55 align = hcenter text = "SOL_TT_STATUS_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_WEIGHT_HEADER" }
                        text_single = { min_width = 50 align = hcenter text = "SOL_TT_DEMAND_HEADER" }
                    }
                    # Row: fish
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 4
                        icon = { size = { 20 20 } texture = "gfx/interface/icons/trade_goods/icon_goods_fish.dds" }
                        text_single = { layoutpolicy_horizontal = expanding text = "SOL_TT_GOODS_FISH" }
                        text_single = { min_width = 55 align = hcenter visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_fish_scarcity_tier'), '(CFixedPoint)2')]"   text = "SOL_TT_STATUS_SEVERE" }
                        text_single = { min_width = 55 align = hcenter visible = "[And(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_fish_scarcity_tier'), '(CFixedPoint)1'), Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sol_good_fish_scarcity_tier'), '(CFixedPoint)2')))]" text = "SOL_TT_STATUS_MODERATE" }
