template SOL_luxury_goods_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_porcelain.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_LUXURY_GOODS_TITLE" }
        blockoverride "tooltip_content" {
