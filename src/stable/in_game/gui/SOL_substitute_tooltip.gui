# ============================================================
#  GROUP: Knowledge  (paper, books)
# ============================================================
template SOL_knowledge_scarce_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = { using = tooltip_title_icon_size
                     texture = "gfx/interface/icons/trade_goods/icon_goods_books.dds" }
        }
        blockoverride "title_text" { text = "SOL_TT_KNOWLEDGE_TITLE" }
