						text_single = { autoresize = yes fontsize = 11 align = right|nobaseline default_format = "#weak" raw_text = "[GetGlobalVariable('sol_ls_top_1_burghers').GetCountry.GetName] [GetGlobalVariable('sol_ls_top_sol_burghers').GetValue|1] @sol_living_standard!" }
					}
				}
				hbox = { name = "sol_lshud4_rank_commoners" size = { 460 26 } visible = "[Scope.GetCountry.GetGovernment.GetEstateFromKey('peasants_estate').ExistsForCountry]" spacing = 4
					
					widget = { size = { 2 1 } }
					text_single = { size = { 72 26 } autoresize = no fontsize = 13 align = left|nobaseline datacontext = "[Scope.GetCountry.GetGovernment.GetEstateFromKey('peasants_estate')]" tooltipwidget = { using = Estate_tooltip } alwaystransparent = no text = "SOL_ESTATE_COMMONERS" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#high" visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_commoners').IsSet]" raw_text = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_commoners').GetValue|1] @sol_living_standard!" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_commoners').IsSet)]" text = "SOL_LSHUD4_DASH" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline visible = "[And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_commoners').IsSet, GetGlobalVariable('sol_ls_rank_count_commoners').IsSet)]" text = "SOL_LSHUD4_ESTATE_RANK_COMMONERS_MAP" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_commoners').IsSet, GetGlobalVariable('sol_ls_rank_count_commoners').IsSet))]" text = "SOL_LSHUD4_DASH" }
					widget = { size = { 84 26 } widget = { size = { 76 8 } position = { 4 9 } progressbar = { size = { 76 8 } min = 0 max = 1 value = "[FixedPointToFloat(Scope.GetCountry.MakeScope.GetVariable('sol_ls_percentile_commoners').GetValue)]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } } } }
					hbox = { size = { 136 26 } spacing = 3 visible = "[GetGlobalVariable('sol_ls_top_1_commoners').IsSet]"
						expand = {}
						country_flag_mini = { datacontext = "[GetGlobalVariable('sol_ls_top_1_commoners').GetCountry]" }
						text_single = { autoresize = yes fontsize = 11 align = right|nobaseline default_format = "#weak" raw_text = "[GetGlobalVariable('sol_ls_top_1_commoners').GetCountry.GetName] [GetGlobalVariable('sol_ls_top_sol_commoners').GetValue|1] @sol_living_standard!" }
					}
				}
				hbox = { name = "sol_lshud4_rank_tribesmen" size = { 460 26 } visible = "[Scope.GetCountry.GetGovernment.GetEstateFromKey('tribes_estate').ExistsForCountry]" spacing = 4
					widget = { ignore_layout = yes size = { 460 26 } background = { using = tooltip_table_field_texture alpha = 0.5 } }
					widget = { size = { 2 1 } }
					text_single = { size = { 72 26 } autoresize = no fontsize = 13 align = left|nobaseline datacontext = "[Scope.GetCountry.GetGovernment.GetEstateFromKey('tribes_estate')]" tooltipwidget = { using = Estate_tooltip } alwaystransparent = no text = "SOL_ESTATE_TRIBESMEN" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#high" visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_tribesmen').IsSet]" raw_text = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_tribesmen').GetValue|1] @sol_living_standard!" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_tribesmen').IsSet)]" text = "SOL_LSHUD4_DASH" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline visible = "[And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_tribesmen').IsSet, GetGlobalVariable('sol_ls_rank_count_tribesmen').IsSet)]" text = "SOL_LSHUD4_ESTATE_RANK_TRIBESMEN_MAP" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_tribesmen').IsSet, GetGlobalVariable('sol_ls_rank_count_tribesmen').IsSet))]" text = "SOL_LSHUD4_DASH" }
					widget = { size = { 84 26 } widget = { size = { 76 8 } position = { 4 9 } progressbar = { size = { 76 8 } min = 0 max = 1 value = "[FixedPointToFloat(Scope.GetCountry.MakeScope.GetVariable('sol_ls_percentile_tribesmen').GetValue)]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } } } }
					hbox = { size = { 136 26 } spacing = 3 visible = "[GetGlobalVariable('sol_ls_top_1_tribesmen').IsSet]"
						expand = {}
						country_flag_mini = { datacontext = "[GetGlobalVariable('sol_ls_top_1_tribesmen').GetCountry]" }
