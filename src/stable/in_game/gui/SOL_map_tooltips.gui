					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#high" visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_clergy').IsSet]" raw_text = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_clergy').GetValue|1] @sol_living_standard!" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_clergy').IsSet)]" text = "SOL_LSHUD4_DASH" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline visible = "[And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_clergy').IsSet, GetGlobalVariable('sol_ls_rank_count_clergy').IsSet)]" text = "SOL_LSHUD4_ESTATE_RANK_CLERGY_MAP" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_clergy').IsSet, GetGlobalVariable('sol_ls_rank_count_clergy').IsSet))]" text = "SOL_LSHUD4_DASH" }
					widget = { size = { 84 26 } widget = { size = { 76 8 } position = { 4 9 } progressbar = { size = { 76 8 } min = 0 max = 1 value = "[FixedPointToFloat(Scope.GetCountry.MakeScope.GetVariable('sol_ls_percentile_clergy').GetValue)]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } } } }
