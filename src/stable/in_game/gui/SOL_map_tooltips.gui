container = {
	name = "CountryMapTooltip_sol_substitution"
	alwaystransparent = no
	container = {
		visible = "[Country.IsValid]"
		datacontext = "[Country.MakeScope]"
		using = SOL_MAP_tooltip_3
	}
}

template SOL_MAP_tooltip_4 {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "gfx/interface/great_powers/banner_rank.dds" texture_density = 2 } }
		blockoverride "title_text" { text = "SOL_MAP_COUNTRY_T4_TITLE" }
		blockoverride "concept_link_obj" {
            text_multi = { layoutpolicy_horizontal = expanding max_width = 408 autoresize = yes
                fontsize = 13 default_format = "#weak" text = "SOL_LSHUD4_T4_SUB" }
        }
		blockoverride "tooltip_content" {
			vbox = { name = "sol_lshud4_rank_unranked" visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_unranked').IsSet]"
				text_multi = { max_width = 460 autoresize = yes text = "SOL_LSHUD4_T4_UNRANKED" }
			}
			vbox = { name = "sol_lshud4_rank_pending" visible = "[And(Not(And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol').IsSet, And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank').IsSet, GetGlobalVariable('sol_ls_rank_count').IsSet))), Not(Scope.GetCountry.MakeScope.GetVariable('sol_ls_unranked').IsSet))]"
				text_multi = { max_width = 460 autoresize = yes text = "SOL_LSHUD_RANK_PENDING" }
			}
			vbox = { name = "sol_lshud4_rank_body" visible = "[And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol').IsSet, And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank').IsSet, GetGlobalVariable('sol_ls_rank_count').IsSet))]" spacing = 2
				hbox = { size = { 460 22 } text_single = { autoresize = yes using = Font_Type_Headers align = left|nobaseline default_format = "#S" text = "SOL_LSHUD4_T4_NATION" } expand = {} }
				widget = { size = { 460 1 } background = { using = color_gold_texture alpha = 0.45 } }

				hbox = { name = "sol_lshud4_top_1" size = { 460 24 } visible = "[And(GetGlobalVariable('sol_ls_top_1').IsSet, GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank').GetValue, '(CFixedPoint)2'))]" spacing = 6 datacontext = "[GetGlobalVariable('sol_ls_top_1').GetCountry]"
					
					text_single = { size = { 34 24 } autoresize = no align = right|nobaseline default_format = "#weak" raw_text = "[Country.MakeScope.GetVariable('sol_ls_rank').GetValue|0]" }
					country_flag_very_small = { datacontext = "[Country]" }
					text_single = { size = { 136 24 } autoresize = no align = left|nobaseline raw_text = "[Country.GetName]" }
					progressbar = { size = { 140 8 } min = 0 max = 1 value = "[FixedPointToFloat(Divide_CFixedPoint(Country.MakeScope.GetVariable('sol_ls_sol').GetValue, Max_CFixedPoint(GetGlobalVariable('sol_ls_top_sol').GetValue, '(CFixedPoint)0.01')))]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
					expand = {}
					text_single = { size = { 60 24 } autoresize = no align = right|nobaseline raw_text = "[Country.MakeScope.GetVariable('sol_ls_sol').GetValue|1] @sol_living_standard!" }
					widget = { size = { 4 1 } }
				}
				hbox = { size = { 460 12 } visible = "[GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank').GetValue, '(CFixedPoint)3')]" text_single = { size = { 34 12 } autoresize = no align = right|nobaseline default_format = "#weak" text = "SOL_LSHUD_ELLIPSIS" } expand = {} }
				hbox = { name = "sol_lshud4_above_1" size = { 460 24 } visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_above_1').IsSet]" spacing = 6 datacontext = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_above_1').GetCountry]"
					
					text_single = { size = { 34 24 } autoresize = no align = right|nobaseline default_format = "#weak" raw_text = "[Country.MakeScope.GetVariable('sol_ls_rank').GetValue|0]" }
					country_flag_very_small = { datacontext = "[Country]" }
					text_single = { size = { 136 24 } autoresize = no align = left|nobaseline raw_text = "[Country.GetName]" }
					progressbar = { size = { 140 8 } min = 0 max = 1 value = "[FixedPointToFloat(Divide_CFixedPoint(Country.MakeScope.GetVariable('sol_ls_sol').GetValue, Max_CFixedPoint(GetGlobalVariable('sol_ls_top_sol').GetValue, '(CFixedPoint)0.01')))]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
					expand = {}
					text_single = { size = { 60 24 } autoresize = no align = right|nobaseline raw_text = "[Country.MakeScope.GetVariable('sol_ls_sol').GetValue|1] @sol_living_standard!" }
					widget = { size = { 4 1 } }
				}
				hbox = { name = "sol_lshud4_self" size = { 460 24 } visible = "yes" spacing = 6 datacontext = "[Scope.GetCountry]"
					widget = { ignore_layout = yes size = { 460 24 } background = { using = color_gold_texture alpha = 0.08 } widget = { size = { 460 1 } position = { 0 0 } background = { using = color_gold_texture alpha = 0.6 } } widget = { size = { 460 1 } position = { 0 23 } background = { using = color_gold_texture alpha = 0.6 } } widget = { size = { 1 24 } position = { 0 0 } background = { using = color_gold_texture alpha = 0.6 } } widget = { size = { 1 24 } position = { 459 0 } background = { using = color_gold_texture alpha = 0.6 } } }
					text_single = { size = { 34 24 } autoresize = no align = right|nobaseline default_format = "#weak" raw_text = "[Country.MakeScope.GetVariable('sol_ls_rank').GetValue|0]" }
					country_flag_very_small = { datacontext = "[Country]" }
					text_single = { size = { 136 24 } autoresize = no align = left|nobaseline default_format = "#high" raw_text = "[Country.GetName]" }
					progressbar = { size = { 140 8 } min = 0 max = 1 value = "[FixedPointToFloat(Divide_CFixedPoint(Country.MakeScope.GetVariable('sol_ls_sol').GetValue, Max_CFixedPoint(GetGlobalVariable('sol_ls_top_sol').GetValue, '(CFixedPoint)0.01')))]" progresstexture = "gfx/interface/sol_proto/bar_gold.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
					expand = {}
					text_single = { size = { 60 24 } autoresize = no align = right|nobaseline raw_text = "[Country.MakeScope.GetVariable('sol_ls_sol').GetValue|1] @sol_living_standard!" }
					widget = { size = { 4 1 } }
				}
				hbox = { name = "sol_lshud4_below_1" size = { 460 24 } visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_below_1').IsSet]" spacing = 6 datacontext = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_below_1').GetCountry]"
					
					text_single = { size = { 34 24 } autoresize = no align = right|nobaseline default_format = "#weak" raw_text = "[Country.MakeScope.GetVariable('sol_ls_rank').GetValue|0]" }
					country_flag_very_small = { datacontext = "[Country]" }
					text_single = { size = { 136 24 } autoresize = no align = left|nobaseline raw_text = "[Country.GetName]" }
					progressbar = { size = { 140 8 } min = 0 max = 1 value = "[FixedPointToFloat(Divide_CFixedPoint(Country.MakeScope.GetVariable('sol_ls_sol').GetValue, Max_CFixedPoint(GetGlobalVariable('sol_ls_top_sol').GetValue, '(CFixedPoint)0.01')))]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } }
					expand = {}
					text_single = { size = { 60 24 } autoresize = no align = right|nobaseline raw_text = "[Country.MakeScope.GetVariable('sol_ls_sol').GetValue|1] @sol_living_standard!" }
					widget = { size = { 4 1 } }
				}
				widget = { size = { 1 8 } }
				hbox = { size = { 460 22 } text_single = { autoresize = yes using = Font_Type_Headers align = left|nobaseline default_format = "#S" text = "SOL_LSHUD4_T4_ESTATES" } expand = {} }
				widget = { size = { 460 1 } background = { using = color_gold_texture alpha = 0.45 } }
				hbox = { size = { 460 18 } spacing = 4 widget = { size = { 2 1 } } text_single = { size = { 72 18 } autoresize = no fontsize = 11 align = left|nobaseline default_format = "#weak" text = "SOL_LSHUD4_COL_ESTATE" } text_single = { size = { 82 18 } autoresize = no fontsize = 11 align = right|nobaseline default_format = "#weak" text = "SOL_LSHUD4_COL_SOL" } text_single = { size = { 66 18 } autoresize = no fontsize = 11 align = right|nobaseline default_format = "#weak" text = "SOL_LSHUD4_COL_RANK" } text_single = { size = { 84 18 } autoresize = no fontsize = 11 align = center|nobaseline default_format = "#weak" text = "SOL_LSHUD4_COL_PERCENTILE" } text_single = { size = { 136 18 } autoresize = no fontsize = 11 align = right|nobaseline default_format = "#weak" text = "SOL_LSHUD4_COL_BEST" } }

				hbox = { name = "sol_lshud4_rank_nobles" size = { 460 26 } visible = "[Scope.GetCountry.GetGovernment.GetEstateFromKey('nobles_estate').ExistsForCountry]" spacing = 4
					widget = { ignore_layout = yes size = { 460 26 } background = { using = tooltip_table_field_texture alpha = 0.5 } }
					widget = { size = { 2 1 } }
					text_single = { size = { 72 26 } autoresize = no fontsize = 13 align = left|nobaseline datacontext = "[Scope.GetCountry.GetGovernment.GetEstateFromKey('nobles_estate')]" tooltipwidget = { using = Estate_tooltip } alwaystransparent = no text = "SOL_ESTATE_NOBLES" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#high" visible = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_nobles').IsSet]" raw_text = "[Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_nobles').GetValue|1] @sol_living_standard!" }
					text_single = { size = { 82 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(Scope.GetCountry.MakeScope.GetVariable('sol_ls_sol_nobles').IsSet)]" text = "SOL_LSHUD4_DASH" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline visible = "[And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_nobles').IsSet, GetGlobalVariable('sol_ls_rank_count_nobles').IsSet)]" text = "SOL_LSHUD4_ESTATE_RANK_NOBLES_MAP" }
					text_single = { size = { 66 26 } autoresize = no fontsize = 13 align = right|nobaseline default_format = "#weak" visible = "[Not(And(Scope.GetCountry.MakeScope.GetVariable('sol_ls_rank_nobles').IsSet, GetGlobalVariable('sol_ls_rank_count_nobles').IsSet))]" text = "SOL_LSHUD4_DASH" }
					widget = { size = { 84 26 } widget = { size = { 76 8 } position = { 4 9 } progressbar = { size = { 76 8 } min = 0 max = 1 value = "[FixedPointToFloat(Scope.GetCountry.MakeScope.GetVariable('sol_ls_percentile_nobles').GetValue)]" progresstexture = "gfx/interface/sol_proto/bar_steel.dds" noprogresstexture = "gfx/interface/sol_proto/bar_track.dds" texture_density = 2 spriteType = Corneredstretched spriteborder = { 12 0 } } } }
					hbox = { size = { 136 26 } spacing = 3 visible = "[GetGlobalVariable('sol_ls_top_1_nobles').IsSet]"
