									icon = { size = { 18 18 } visible = "[GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_elephants', Scope.GetCountry.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_elephants', Scope.GetCountry.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0')]" texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" }
									icon = { size = { 18 18 } alpha = "0.3" visible = "[Not(GreaterThan_CFixedPoint(Select_CFixedPoint(GetVariableFromGlobalVariableMap('gls_country_consumes_elephants', Scope.GetCountry.MakeScope).IsSet, GetVariableFromGlobalVariableMap('gls_country_consumes_elephants', Scope.GetCountry.MakeScope).GetValue, '(CFixedPoint)0'), '(CFixedPoint)0'))]" texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" }
									text_single = { size = { 18 18 } autoresize = no fontsize = 14 position = { 0 18 } align = center|nobaseline raw_text = "@arrow_malus_tier_3!" visible = "[And(GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), LessThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)0.5'))]" }
									text_single = { size = { 18 18 } autoresize = no fontsize = 14 position = { 0 18 } align = center|nobaseline raw_text = "@arrow_malus_tier_2!" visible = "[And(GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), And(GreaterThanOrEqualTo_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)0.5'), LessThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)0.75')))]" }
									text_single = { size = { 18 18 } autoresize = no fontsize = 14 position = { 0 18 } align = center|nobaseline raw_text = "@arrow_malus_tier_1!" visible = "[And(GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), And(GreaterThanOrEqualTo_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)0.75'), LessThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)1')))]" }
									text_single = { size = { 18 18 } autoresize = no fontsize = 14 position = { 0 18 } align = center|nobaseline raw_text = "@price_stable!" visible = "[And(GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), EqualTo_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)1'))]" }
