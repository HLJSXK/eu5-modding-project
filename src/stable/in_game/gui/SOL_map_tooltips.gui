									text_single = { size = { 18 18 } autoresize = no fontsize = 14 position = { 0 18 } align = center|nobaseline raw_text = "@arrow_bonus_tier_2!" visible = "[And(GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_status_display'), '(CFixedPoint)1'), And(GreaterThan_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)1.25'), LessThanOrEqualTo_CFixedPoint(Scope.GetCountry.MakeScope.ScriptValue('sol_substitute_elephants_display'), '(CFixedPoint)1.5')))]" }
