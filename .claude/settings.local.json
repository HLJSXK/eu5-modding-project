{
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(xargs grep*)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(python scripts/validate.py*)",
      "Bash(python scripts/gen_brief.py)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/validate.py --changed 2>&1 | head -20"
          }
        ]
      }
    ]
  }
}
